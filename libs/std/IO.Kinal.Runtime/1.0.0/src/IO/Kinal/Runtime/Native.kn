Unit IO.Kinal.Runtime.Native;

// This unit is the single declaration boundary between the Kinal runtime and
// irreducible host services. Runtime policy, object layouts, GC, collections,
// exceptions, and async state machines remain implemented in Kinal.

[LinkName("kn_native_runtime_thread_storage")]
Extern Unsafe Function byte* ThreadStorage() By C;

[LinkName("kn_native_heap_allocate")]
Extern Unsafe Function byte* HeapAllocate(usize size) By C;

[LinkName("kn_native_heap_free")]
Extern Unsafe Function void HeapFree(byte* memory) By C;

[LinkName("kn_native_memory_copy")]
Extern Unsafe Function void MemoryCopy(byte* destination, byte* source,
                                       usize count) By C;

[LinkName("kn_native_memory_set")]
Extern Unsafe Function void MemoryFill(byte* destination, byte value,
                                       usize count) By C;

[LinkName("kn_native_memory_compare")]
Extern Unsafe Function i32 MemoryCompare(byte* left, byte* right,
                                         usize count) By C;

[LinkName("kn_native_file_read_all_bytes")]
Extern Unsafe Function byte* FileReadAllBytes(string path,
                                               u64* outLength) By C;

[LinkName("kn_native_file_write_all_bytes")]
Extern Unsafe Function i32 FileWriteAllBytes(string path, byte* data,
                                              u64 length) By C;

[LinkName("kn_native_spin_lock")]
Extern Unsafe Function void SpinLock(i32* lock) By C;

[LinkName("kn_native_spin_unlock")]
Extern Unsafe Function void SpinUnlock(i32* lock) By C;

[LinkName("kn_native_async_live_task_count")]
Extern Unsafe Function i32 AsyncLiveTaskCount() By C;

[LinkName("kn_native_console_write")]
Extern Unsafe Function void ConsoleWrite(string text) By C;

[LinkName("kn_native_console_read_line")]
Extern Unsafe Function char* ConsoleReadLine() By C;

[LinkName("kn_native_format_f64")]
Extern Unsafe Function char* FormatFloat64(f64 value) By C;

[LinkName("kn_native_parse_f32")]
Extern Unsafe Function f32 ParseFloat32(string text) By C;

[LinkName("kn_native_parse_f64")]
Extern Unsafe Function f64 ParseFloat64(string text) By C;

[LinkName("kn_native_executable_path")]
Extern Unsafe Function char* ExecutablePath() By C;

[LinkName("kn_native_process_run")]
Extern Unsafe Function int ProcessRun(string executable,
                                      string[] arguments,
                                      int argumentCount) By C;

[LinkName("kn_native_system_get_symbol")]
Extern Unsafe Function byte* ResolveSymbol(byte* library, string name) By C;

[LinkName("kn_native_task_sleep_ms")]
Extern Unsafe Function void SleepMilliseconds(int milliseconds) By C;

[LinkName("kn_native_task_spawn")]
Extern Unsafe Function i32 TaskSpawn(byte* entry, byte* environment,
                                     byte* task) By C;

[LinkName("kn_native_atomic_compare_exchange_i32")]
Extern Unsafe Function i32 AtomicCompareExchangeI32(i32* address,
                                                     i32 expected,
                                                     i32 desired) By C;

[LinkName("kn_native_atomic_load_i32")]
Extern Unsafe Function i32 AtomicLoadI32(i32* address) By C;

[LinkName("kn_native_atomic_store_i32")]
Extern Unsafe Function void AtomicStoreI32(i32* address, i32 value) By C;

[LinkName("kn_native_task_wait_idle")]
Extern Unsafe Function void TaskWaitIdle() By C;

[LinkName("kn_native_task_yield_now")]
Extern Unsafe Function void TaskYield() By C;

[LinkName("kn_native_process_spawn")]
Extern Unsafe Function byte* ProcessSpawn(string commandLine) By C;

[LinkName("kn_native_process_is_completed")]
Extern Unsafe Function i32 ProcessIsCompleted(byte* handle) By C;

[LinkName("kn_native_process_wait")]
Extern Unsafe Function i32 ProcessWait(byte* handle,
                                       i64 timeoutMilliseconds) By C;

[LinkName("kn_native_process_exit_code")]
Extern Unsafe Function i32 ProcessExitCode(byte* handle) By C;

[LinkName("kn_native_process_close")]
Extern Unsafe Function i32 ProcessClose(byte* handle) By C;

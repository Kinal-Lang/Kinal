Unit IO.Kinal.Runtime.Async;

Get IO.Kinal.Runtime;
Get IO.Kinal.Runtime.Exception;

// Threads, atomics, sleeps, and process handles are platform mechanisms.  The
// task layout, completion protocol, fault propagation, and waiting policy are
// implemented below in Kinal.
[LinkName("kn_native_task_spawn")]
Extern Unsafe Function i32 NativeTaskSpawn(byte* entry,
                                             byte* environment,
                                             byte* task) By C;

[LinkName("kn_native_atomic_compare_exchange_i32")]
Extern Unsafe Function i32 NativeCompareExchange(i32* address,
                                                   i32 expected,
                                                   i32 desired) By C;

[LinkName("kn_native_atomic_load_i32")]
Extern Unsafe Function i32 NativeAtomicLoad(i32* address) By C;

[LinkName("kn_native_atomic_store_i32")]
Extern Unsafe Function void NativeAtomicStore(i32* address, i32 value) By C;

[LinkName("kn_native_task_wait_idle")]
Extern Unsafe Function void NativeTaskWaitIdle() By C;

[LinkName("kn_native_task_yield_now")]
Extern Unsafe Function void NativeTaskYieldNow() By C;

[LinkName("kn_native_process_spawn")]
Extern Unsafe Function byte* NativeProcessSpawn(string commandLine) By C;

[LinkName("kn_native_process_is_completed")]
Extern Unsafe Function i32 NativeProcessIsCompleted(byte* handle) By C;

[LinkName("kn_native_process_wait")]
Extern Unsafe Function i32 NativeProcessWait(byte* handle, i64 timeoutMilliseconds) By C;

[LinkName("kn_native_process_exit_code")]
Extern Unsafe Function i32 NativeProcessExitCode(byte* handle) By C;

[LinkName("kn_native_process_close")]
Extern Unsafe Function i32 NativeProcessClose(byte* handle) By C;

Safe Function usize TaskBytes()
{
    Return [usize](6) * [usize](8);
}

Trusted Function u64* TaskWords(byte* task)
{
    Return [u64*](task);
}

Trusted Function i32* TaskDone(byte* task)
{
    Return [i32*](task);
}

Trusted Function byte* TaskNew()
{
    byte* task = IO.Kinal.Runtime.AllocateRaw(TaskBytes());
    If (task != null) IO.Kinal.Runtime.MemoryZero(task, TaskBytes());
    Return task;
}

Trusted Function byte* TaskSpawn(byte* entry, byte* environment)
{
    byte* task = TaskNew();
    If (task == null || entry == null)
    {
        Return null;
    }
    If (NativeTaskSpawn(entry, environment, task) == [i32](0))
    {
        Return null;
    }
    Return task;
}

Trusted Function void TaskComplete(byte* task, u64 tag, u64 payload)
{
    If (task == null ||
        NativeCompareExchange(TaskDone(task), [i32](0), [i32](2)) == [i32](0))
    {
        Return;
    }
    u64* words = TaskWords(task);
    words[1] = [u64](0);
    words[2] = [u64](0);
    words[3] = tag;
    words[4] = payload;
    words[5] = [u64](0);
    NativeAtomicStore(TaskDone(task), [i32](1));
}

Trusted Function void TaskFail(byte* task, byte* error, string trace)
{
    If (task == null ||
        NativeCompareExchange(TaskDone(task), [i32](0), [i32](2)) == [i32](0))
    {
        Return;
    }
    u64* words = TaskWords(task);
    words[1] = [u64](1);
    words[2] = [u64]([usize](error));
    words[3] = [u64](0);
    words[4] = [u64](0);
    words[5] = [u64]([usize]([char*](trace == null ? "" : trace)));
    NativeAtomicStore(TaskDone(task), [i32](1));
}

Trusted Function void TaskRun(byte* task, u64* outTag, u64* outPayload)
{
    If (outTag != null) outTag[0] = [u64](0);
    If (outPayload != null) outPayload[0] = [u64](0);
    If (task == null)
    {
        Return;
    }

    While (NativeAtomicLoad(TaskDone(task)) != [i32](1))
    {
        NativeTaskWaitIdle();
    }

    u64* words = TaskWords(task);
    If (words[1] != [u64](0))
    {
        IO.Kinal.Runtime.Exception.SetWithTrace(
            [byte*]([usize](words[2])),
            [string]([char*]([usize](words[5]))));
        Return;
    }
    If (outTag != null) outTag[0] = words[3];
    If (outPayload != null) outPayload[0] = words[4];
}

Trusted Function void SleepWorker(byte* environment, byte* task)
{
    If (environment != null)
    {
        i32 milliseconds = ([i32*](environment))[0];
        If (milliseconds > [i32](0)) IO.Kinal.Runtime.NativeSleep([int](milliseconds));
    }
    TaskComplete(task, [u64](0), [u64](0));
}

Trusted Function void YieldWorker(byte* environment, byte* task)
{
    NativeTaskYieldNow();
    TaskComplete(task, [u64](0), [u64](0));
}

Trusted Function byte* TaskSleep(i32 milliseconds)
{
    byte* environment = IO.Kinal.Runtime.AllocateRaw([usize](4));
    If (environment == null) Return null;
    ([i32*](environment))[0] = milliseconds;
    Return TaskSpawn(&SleepWorker, environment);
}

Trusted Function byte* TaskYield()
{
    Return TaskSpawn(&YieldWorker, null);
}

Trusted Function byte* ProcessSpawn(string commandLine)
{
    Return NativeProcessSpawn(commandLine == null ? "" : commandLine);
}

Trusted Function i32 ProcessIsCompleted(byte* handle)
{
    Return handle == null ? [i32](1) : NativeProcessIsCompleted(handle);
}

Trusted Function i32 ProcessWait(byte* handle, i64 timeoutMilliseconds)
{
    Return handle == null ? [i32](0) : NativeProcessWait(handle, timeoutMilliseconds);
}

Trusted Function i32 ProcessExitCode(byte* handle)
{
    Return handle == null ? [i32](-1) : NativeProcessExitCode(handle);
}

Trusted Function i32 ProcessClose(byte* handle)
{
    Return handle == null ? [i32](0) : NativeProcessClose(handle);
}

    usize bytes = [usize](capacity) * CollectionWordBytes();
    u64* tags = [u64*](CollectionAllocateRaw(bytes));
    u64* payloads = [u64*](CollectionAllocateRaw(bytes));
    If (tags == null || payloads == null)
    {
        Return;

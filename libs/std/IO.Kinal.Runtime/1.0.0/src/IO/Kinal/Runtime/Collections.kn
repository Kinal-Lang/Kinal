    u64 count = header[0];
    If (count > [u64](0))
    {
        usize usedBytes = [usize](count) * CollectionWordBytes();
        CollectionMemoryCopy([byte*](tags), [byte*](ListTags(header)), usedBytes);
        CollectionMemoryCopy([byte*](payloads), [byte*](ListPayloads(header)), usedBytes);
    }

    header[1] = capacity;
    header[2] = [u64]([usize](tags));
    header[3] = [u64]([usize](payloads));

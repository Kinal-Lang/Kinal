Unit IO.Kinal.Runtime.GarbageCollector;

Get IO.Target;
Get IO.Kinal.Runtime.Native;
Get IO.Kinal.Runtime.Thread;

// These slots use loader zero-initialization, not language initializers:
// GC startup precedes user initializers and may already have populated them
// when declaration-ordered global initialization reaches this Unit.
byte* ManagedBlocks;
// Most recently returned private array buffers. The collector clears both before marking.
byte* SpareLocalArray;
byte* OlderSpareLocalArray;
byte* GlobalRoots;
int GlobalRootCount;
int GlobalRootCapacity;
u64 ManagedBytes;
u64 CollectionThreshold;
i32 CollectorLock;
bool Collecting;
byte* MainThreadStorage;

Safe Function usize PointerBytes()
{
    Return [usize](IO.Target.PointerBits / 8);
}

Safe Function usize MetadataWordBytes()
{
    Return [usize](8);
}

Trusted Function void RawZero(byte* memory, usize count)
{
    IO.Kinal.Runtime.Native.MemoryFill(memory, [byte](0), [u64](count));
}

Trusted Function void RawCopy(byte* destination, byte* source, usize count)
{
    IO.Kinal.Runtime.Native.MemoryCopy(destination, source, [u64](count));
}

Trusted Function byte* ThreadStorage()
{
    Return [byte*](IO.Kinal.Runtime.Thread.State());
}

Trusted Function byte* CurrentFrame()
{
    u64* state = [u64*](ThreadStorage());
    Return [byte*]([usize](state[0]));
}

Trusted Function void SetCurrentFrame(byte* frame)
{
    ([u64*](ThreadStorage()))[0] = [u64]([usize](frame));
}

Trusted Function usize StackBase()
{
    Return [usize](([u64*](ThreadStorage()))[1]);
}

Trusted Function void SetStackBase(usize value)
{
    ([u64*](ThreadStorage()))[1] = [u64](value);
}

Trusted Function bool IsMainThread()
{
    Return MainThreadStorage != null && ThreadStorage() == MainThreadStorage;
}

Trusted Function void Initialize()
{
    usize marker = [usize](0);
    byte* storage = ThreadStorage();
    If (MainThreadStorage == null) MainThreadStorage = storage;
    If (CollectionThreshold == [u64](0)) CollectionThreshold = [u64](8388608);
    SetStackBase([usize](&marker));
}

Trusted Function byte* BlockNext(byte* block)
{
    Return block == null ? null : [byte*]([usize](([u64*](block))[0]));
}

Trusted Function void SetBlockNext(byte* block, byte* next)
{
    ([u64*](block))[0] = [u64]([usize](next));
}

Trusted Function byte* BlockData(byte* block)
{
    Return block == null ? null : block + [usize](16);
}

// Each allocation has a 16-byte prefix: next block, then payload size and mark bit.
Trusted Function u64 BlockSize(byte* block)
{
    Return block == null ? [u64](0) : (([u64*](block))[1] & [u64](0x7fffffffffffffff));
}

Trusted Function bool BlockMarked(byte* block)
{
    Return block != null && (([u64*](block))[1] >> 63) != [u64](0);
}

Trusted Function void SetBlockMarked(byte* block, bool marked)
{
    ([u64*](block))[1] = BlockSize(block) | ([u64](marked) << 63);
}

Trusted Function byte* Allocate(usize requestedSize)
{
    usize marker = [usize](0);
    If (StackBase() == [usize](0))
    {
        SetStackBase([usize](&marker));
    }
    usize size = requestedSize == [usize](0) ? [usize](1) : requestedSize;
    usize headerSize = [usize](16);
    If (size > [usize](0x7fffffffffffffff) - headerSize) Return null;

    IO.Kinal.Runtime.Native.SpinLock(&CollectorLock);
    byte* block = IO.Kinal.Runtime.Native.HeapAllocate([u64](headerSize + size));
    If (block == null)
    {
        IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
        Return null;
    }
    byte* memory = BlockData(block);
    RawZero(memory, size);
    u64* words = [u64*](block);
    words[0] = [u64]([usize](ManagedBlocks));
    words[1] = [u64](size);
    ManagedBlocks = block;
    ManagedBytes = ManagedBytes + [u64](size);
    IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
    Return memory;
}

// The Native backend calls these only for fixed primitive arrays whose descriptor
// and element addresses remain private. Active invocations keep ordinary GC roots.
Unsafe Function byte* TakeLocalArray(byte* previous, usize size)
{
    // The same declaration can execute more than once in one activation.
    If (previous != null)
    {
        RawZero(previous, size);
        Return previous;
    }
    IO.Kinal.Runtime.Native.SpinLock(&CollectorLock);
    byte* spare = SpareLocalArray;
    If (spare != null && BlockSize(spare - 16) == [u64](size))
    {
        SpareLocalArray = OlderSpareLocalArray;
        OlderSpareLocalArray = null;
    }
    Else
    {
        spare = OlderSpareLocalArray;
        If (spare != null && BlockSize(spare - 16) == [u64](size)) OlderSpareLocalArray = null;
        Else spare = null;
    }
    If (spare != null)
    {
        RawZero(spare, size);
        IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
        Return spare;
    }
    IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
    Return Allocate(size);
}

Unsafe Function void ReturnLocalArray(byte* data)
{
    If (data == null) Return;
    IO.Kinal.Runtime.Native.SpinLock(&CollectorLock);
    OlderSpareLocalArray = SpareLocalArray;
    SpareLocalArray = data;
    IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
}

// Collection is requested only at compiler-inserted statement boundaries.
// At those boundaries every live managed value has reached a registered local,
// parameter, capture, or global root and no expression temporary is in flight.
Trusted Function void MaybeCollect()
{
    If (!Collecting &&
        ManagedBytes > CollectionThreshold &&
        IO.Kinal.Runtime.Native.AsyncLiveTaskCount() == [i32](0))
    {
        Collect();
    }
}

// Frame words: parent, count, capacity, roots, borrowed roots, owns frame.
// Generated functions supply stack storage; explicit runtime callers may
// still use heap frames. Root-table growth preserves either storage owner.
Trusted Function byte* PushFrameWithCount(byte* frame, byte* roots, usize capacity, usize count)
{
    If (frame == null) Return null;
    u64* words = [u64*](frame);
    words[0] = [u64]([usize](CurrentFrame()));
    words[1] = [u64](count);
    words[2] = [u64](capacity);
    words[3] = [u64]([usize](roots));
    words[4] = [u64]([usize](roots));
    words[5] = [u64](0);
    SetCurrentFrame(frame);
    Return frame;
}

Trusted Function byte* PushFrameStorage(byte* frame, byte* roots, usize capacity)
{
    Return PushFrameWithCount(frame, roots, capacity, [usize](0));
}

Trusted Function byte* PushPlannedFrame(byte* frame, byte* roots, usize count)
{
    Return PushFrameWithCount(frame, roots, count, count);
}

Trusted Function void SetFrameRoot(byte* table, byte* address, usize size, usize index)
{
    u64* roots = [u64*](table);
    roots[index * [usize](2)] = [u64]([usize](address));
    roots[index * [usize](2) + [usize](1)] = [u64](size);
}

Trusted Function byte* PushFrame()
{
    byte* frame = IO.Kinal.Runtime.Native.HeapAllocate(
        [u64](MetadataWordBytes() * [usize](6)));
    If (frame == null) Return null;
    PushFrameStorage(frame, null, [usize](0));
    ([u64*](frame))[5] = [u64](1);
    Return frame;
}

Trusted Function void AddRoot(byte* frame, byte* address, usize size)
{
    If (frame == null || address == null || size == [usize](0)) Return;
    u64* words = [u64*](frame);
    int count = [int](words[1]);
    int capacity = [int](words[2]);
    If (count + 1 > capacity)
    {
        int nextCapacity = capacity == 0 ? 8 : capacity * 2;
        usize bytes = [usize](nextCapacity) * MetadataWordBytes() * [usize](2);
        byte* roots = IO.Kinal.Runtime.Native.HeapAllocate([u64](bytes));
        If (roots == null) Return;
        RawZero(roots, bytes);
        If (words[3] != [u64](0) && count > 0)
        {
            RawCopy(roots, [byte*]([usize](words[3])),
                [usize](count) * MetadataWordBytes() * [usize](2));
            If (words[3] != words[4])
                IO.Kinal.Runtime.Native.HeapFree([byte*]([usize](words[3])));
        }
        words[2] = [u64](nextCapacity);
        words[3] = [u64]([usize](roots));
    }
    SetFrameRoot([byte*]([usize](words[3])), address, size, [usize](count));
    words[1] = [u64](count + 1);
}

Trusted Function void AddGlobalRoot(byte* address, usize size)
{
    If (address == null || size == [usize](0)) Return;
    IO.Kinal.Runtime.Native.SpinLock(&CollectorLock);
    If (GlobalRootCount + 1 > GlobalRootCapacity)
    {
        int nextCapacity = GlobalRootCapacity == 0 ? 16 : GlobalRootCapacity * 2;
        usize bytes = [usize](nextCapacity) * MetadataWordBytes() * [usize](2);
        byte* roots = IO.Kinal.Runtime.Native.HeapAllocate([u64](bytes));
        If (roots == null)
        {
            IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
            Return;
        }
        RawZero(roots, bytes);
        If (GlobalRoots != null && GlobalRootCount > 0)
        {
            RawCopy(roots, GlobalRoots,
                [usize](GlobalRootCount) * MetadataWordBytes() * [usize](2));
            IO.Kinal.Runtime.Native.HeapFree(GlobalRoots);
        }
        GlobalRoots = roots;
        GlobalRootCapacity = nextCapacity;
    }
    u64* rootWords = [u64*](GlobalRoots);
    rootWords[GlobalRootCount * 2] = [u64]([usize](address));
    rootWords[GlobalRootCount * 2 + 1] = [u64](size);
    GlobalRootCount = GlobalRootCount + 1;
    IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
}

Trusted Function void PopFrame(byte* frame)
{
    If (frame == null) Return;
    u64* words = [u64*](frame);
    SetCurrentFrame([byte*]([usize](words[0])));
    If (words[3] != [u64](0) && words[3] != words[4])
        IO.Kinal.Runtime.Native.HeapFree([byte*]([usize](words[3])));
    If (words[5] != [u64](0)) IO.Kinal.Runtime.Native.HeapFree(frame);
}

Trusted Function void IndexSiftDown(u64* items, int count, int root)
{
    While (true)
    {
        int child = root * 2 + 1;
        If (child >= count) Return;
        byte* childBlock = [byte*]([usize](items[child]));
        If (child + 1 < count)
        {
            byte* rightBlock = [byte*]([usize](items[child + 1]));
            If ([usize](BlockData(childBlock)) < [usize](BlockData(rightBlock)))
            {
                child = child + 1;
                childBlock = rightBlock;
            }
        }
        byte* rootBlock = [byte*]([usize](items[root]));
        If ([usize](BlockData(rootBlock)) >= [usize](BlockData(childBlock))) Return;
        u64 swap = items[root];
        items[root] = items[child];
        items[child] = swap;
        root = child;
    }
}

Trusted Function void IndexSort(u64* items, int count)
{
    If (items == null || count < 2) Return;
    int index = count / 2;
    While (index > 0)
    {
        IndexSiftDown(items, count, index - 1);
        index = index - 1;
    }
    int end = count - 1;
    While (end > 0)
    {
        u64 swap = items[0];
        items[0] = items[end];
        items[end] = swap;
        IndexSiftDown(items, end, 0);
        end = end - 1;
    }
}

// Sort addresses for conservative interior-pointer lookup. The mark stack is empty
// until the index is ready, so it can hold one radix pass without growing the heap.
Trusted Function void SortBlockIndex(u64* items, int count, u64* scratch)
{
    If (count < 1024) { IndexSort(items, count); Return; }
    u64* offsets = [u64*](IO.Kinal.Runtime.Native.HeapAllocate([u64](2048)));
    If (offsets == null) { IndexSort(items, count); Return; }
    u64 first = items[0];
    u64 varying = [u64](0);
    For (int pos = 1; pos < count; pos++) varying = varying | (items[pos] ^ first);

    u64* source = items;
    u64* output = scratch;
    int shift = 0;
    While (varying != [u64](0))
    {
        If ((varying & [u64](255)) != [u64](0))
        {
            RawZero([byte*](offsets), [usize](2048));
            For (int sample = 0; sample < count; sample++)
            {
                int bucket = [int]((source[sample] >> shift) & [u64](255));
                offsets[bucket] = offsets[bucket] + [u64](1);
            }
            u64 position = [u64](0);
            For (int bucket = 0; bucket < 256; bucket++)
            {
                u64 frequency = offsets[bucket];
                offsets[bucket] = position;
                position = position + frequency;
            }
            For (int entry = 0; entry < count; entry++)
            {
                u64 value = source[entry];
                int bucket = [int]((value >> shift) & [u64](255));
                output[[int](offsets[bucket])] = value;
                offsets[bucket] = offsets[bucket] + [u64](1);
            }
            u64* swap = source;
            source = output;
            output = swap;
        }
        varying = varying >> 8;
        shift = shift + 8;
    }
    If (source != items) RawCopy([byte*](items), [byte*](source), [usize](count) * MetadataWordBytes());
    IO.Kinal.Runtime.Native.HeapFree([byte*](offsets));
}

Trusted Function byte* FindBlock(byte* pointer, u64* index, int count)
{
    If (pointer == null || index == null || count <= 0) Return null;
    usize value = [usize](pointer);
    int low = 0;
    int high = count;
    While (low < high)
    {
        int middle = low + (high - low) / 2;
        byte* block = [byte*]([usize](index[middle]));
        If ([usize](BlockData(block)) <= value) low = middle + 1;
        Else high = middle;
    }
    If (low == 0) Return null;
    byte* candidate = [byte*]([usize](index[low - 1]));
    usize start = [usize](BlockData(candidate));
    Return value >= start && [u64](value - start) < BlockSize(candidate) ?
        candidate : null;
}

Trusted Function int MarkPointer(byte* pointer, u64* index, int indexCount,
                                 u64* stack, int stackPointer, int capacity)
{
    byte* block = FindBlock(pointer, index, indexCount);
    If (block == null || BlockMarked(block)) Return stackPointer;
    SetBlockMarked(block, true);
    If (stackPointer < capacity)
    {
        stack[stackPointer] = [u64]([usize](block));
        stackPointer = stackPointer + 1;
    }
    Return stackPointer;
}

Trusted Function int ScanRegion(byte* address, usize size,
                                u64* index, int indexCount,
                                u64* stack, int stackPointer, int capacity)
{
    usize width = PointerBytes();
    If (address == null || size < width || index == null || indexCount <= 0) Return stackPointer;
    byte* first = [byte*]([usize](index[0]));
    byte* last = [byte*]([usize](index[indexCount - 1]));
    usize minimum = [usize](BlockData(first));
    usize span = [usize](BlockData(last)) - minimum + [usize](BlockSize(last));
    usize offset = [usize](0);
    While (offset + width <= size)
    {
        // usize has i64 language storage even on x86. Scan actual pointer
        // slots so a 32-bit root is neither read past its end nor skipped.
        byte* value = ([byte**](address))[offset / width];
        // Unsigned subtraction excludes words below the first block too.
        // Interior pointers still go through the exact block lookup.
        If ([usize](value) - minimum < span)
            stackPointer = MarkPointer(value, index, indexCount,
                stack, stackPointer, capacity);
        offset = offset + width;
    }
    Return stackPointer;
}

Trusted Function int ScanNativeStack(u64* index, int indexCount,
                                     u64* stack, int stackPointer, int capacity)
{
    usize marker = [usize](0);
    usize current = [usize](&marker);
    usize base = StackBase();
    usize low = current < base ? current : base;
    usize high = current < base ? base : current;
    If (base == [usize](0) || high < low ||
        [u64](high - low) > [u64](134217728))
    {
        Return stackPointer;
    }
    Return ScanRegion([byte*](low), high - low + PointerBytes(),
        index, indexCount, stack, stackPointer, capacity);
}

Trusted Function void Collect()
{
    If (IO.Kinal.Runtime.Native.AsyncLiveTaskCount() > [i32](0)) Return;
    IO.Kinal.Runtime.Native.SpinLock(&CollectorLock);
    If (Collecting ||
        IO.Kinal.Runtime.Native.AsyncLiveTaskCount() > [i32](0))
    {
        IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
        Return;
    }
    Collecting = true;
    SpareLocalArray = null;
    OlderSpareLocalArray = null;

    int blockCount = 0;
    byte* block = ManagedBlocks;
    While (block != null)
    {
        blockCount = blockCount + 1;
        block = BlockNext(block);
    }
    If (blockCount == 0)
    {
        Collecting = false;
        IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
        Return;
    }

    usize indexBytes = [usize](blockCount) * MetadataWordBytes();
    u64* index = [u64*](IO.Kinal.Runtime.Native.HeapAllocate([u64](indexBytes)));
    u64* stack = [u64*](IO.Kinal.Runtime.Native.HeapAllocate([u64](indexBytes)));
    If (index == null || stack == null)
    {
        If (index != null) IO.Kinal.Runtime.Native.HeapFree([byte*](index));
        If (stack != null) IO.Kinal.Runtime.Native.HeapFree([byte*](stack));
        Collecting = false;
        IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
        Return;
    }

    int indexCount = 0;
    block = ManagedBlocks;
    While (block != null)
    {
        index[indexCount] = [u64]([usize](block));
        indexCount = indexCount + 1;
        SetBlockMarked(block, false);
        block = BlockNext(block);
    }
    SortBlockIndex(index, indexCount, stack);

    int stackPointer = ScanNativeStack(index, indexCount, stack, 0, blockCount);
    byte* frame = CurrentFrame();
    While (frame != null)
    {
        u64* frameWords = [u64*](frame);
        int rootCount = [int](frameWords[1]);
        u64* roots = [u64*]([usize](frameWords[3]));
        int rootIndex = 0;
        While (roots != null && rootIndex < rootCount)
        {
            stackPointer = ScanRegion(
                [byte*]([usize](roots[rootIndex * 2])),
                [usize](roots[rootIndex * 2 + 1]),
                index, indexCount, stack, stackPointer, blockCount);
            rootIndex = rootIndex + 1;
        }
        frame = [byte*]([usize](frameWords[0]));
    }

    u64* globalRootWords = [u64*](GlobalRoots);
    int globalIndex = 0;
    While (globalRootWords != null && globalIndex < GlobalRootCount)
    {
        stackPointer = ScanRegion(
            [byte*]([usize](globalRootWords[globalIndex * 2])),
            [usize](globalRootWords[globalIndex * 2 + 1]),
            index, indexCount, stack, stackPointer, blockCount);
        globalIndex = globalIndex + 1;
    }

    While (stackPointer > 0)
    {
        stackPointer = stackPointer - 1;
        byte* reachable = [byte*]([usize](stack[stackPointer]));
        stackPointer = ScanRegion(BlockData(reachable), [usize](BlockSize(reachable)),
            index, indexCount, stack, stackPointer, blockCount);
    }

    byte* previous = null;
    byte* currentBlock = ManagedBlocks;
    ManagedBytes = [u64](0);
    While (currentBlock != null)
    {
        byte* next = BlockNext(currentBlock);
        If (!BlockMarked(currentBlock))
        {
            IO.Kinal.Runtime.Native.HeapFree(currentBlock);
            If (previous == null) ManagedBlocks = next;
            Else SetBlockNext(previous, next);
        }
        Else
        {
            ManagedBytes = ManagedBytes + BlockSize(currentBlock);
            previous = currentBlock;
        }
        currentBlock = next;
    }

    IO.Kinal.Runtime.Native.HeapFree([byte*](index));
    IO.Kinal.Runtime.Native.HeapFree([byte*](stack));
    CollectionThreshold = ManagedBytes * [u64](2);
    If (CollectionThreshold < [u64](8388608))
        CollectionThreshold = [u64](8388608);
    Collecting = false;
    IO.Kinal.Runtime.Native.SpinUnlock(&CollectorLock);
}

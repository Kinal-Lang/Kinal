Unit IO.Time;

Get IO.Text;
Get IO.Kinal.Runtime;

// Calendar values and formatting policy belong to the Kinal standard library.
// The native boundary below only exposes host clock and sleep primitives.

[LinkName("__kn_time_tick")]
Extern Unsafe Function u64 __TimeTick() By C;

[LinkName("__kn_time_nano")]
Extern Unsafe Function u64 __TimeNanoTick() By C;

[LinkName("__kn_time_sleep")]
Extern Unsafe Function void __TimeSleep(i32 milliseconds) By C;

[LinkName("__kn_time_now_parts")]
Extern Unsafe Function void __TimeNowParts(
    i32* year, i32* month, i32* day,
    i32* hour, i32* minute, i32* second,
    i32* millisecond, i64* tickMilliseconds) By C;

Class DateTime
{
    Public int Ticks;
    Public int Year;
    Public int Month;
    Public int Day;
    Public int Hour;
    Public int Minute;
    Public int Second;
    Public int Millisecond;
}

[IO.Kinal.Runtime.KncIntrinsic(15)]
Trusted Function int GetTick()
{
    Return [int](__TimeTick());
}

[IO.Kinal.Runtime.KncIntrinsic(17)]
Trusted Function int GetNanoTick()
{
    Return [int](__TimeNanoTick());
}

[IO.Kinal.Runtime.KncIntrinsic(16)]
Trusted Function void Sleep(int milliseconds)
{
    __TimeSleep([i32](milliseconds));
}

[IO.Kinal.Runtime.KncIntrinsic(14)]
Trusted Function DateTime Now()
{
    i32 year = 0;
    i32 month = 0;
    i32 day = 0;
    i32 hour = 0;
    i32 minute = 0;
    i32 second = 0;
    i32 millisecond = 0;
    i64 tickMilliseconds = 0;
    __TimeNowParts(&year, &month, &day, &hour, &minute, &second,
        &millisecond, &tickMilliseconds);

    DateTime value = New DateTime();
    value.Ticks = [int](tickMilliseconds);
    value.Year = [int](year);
    value.Month = [int](month);
    value.Day = [int](day);
    value.Hour = [int](hour);
    value.Minute = [int](minute);
    value.Second = [int](second);
    value.Millisecond = [int](millisecond);
    Return value;
}

Trusted Function string __TimePad(int value, int width)
{
    string digits = [string](value);
    int length = IO.Text.Length(digits);
    If (width <= length) Return digits;
    int missing = width - length;
    While (missing > 3)
    {
        digits = "000" + digits;
        missing -= 3;
    }
    If (missing == 1) Return "0" + digits;
    If (missing == 2) Return "00" + digits;
    Return "000" + digits;
}

[IO.Kinal.Runtime.KncIntrinsic(18)]
Trusted Function string Format(DateTime value, string pattern)
{
    If (pattern == null || pattern == "") pattern = "yyyy-MM-dd HH:mm:ss";

    char* characters = [char*](pattern);
    int length = IO.Text.Length(pattern);
    int literal = 0;
    int index = 0;
    IO.Text.Builder output = null;
    While (index < length)
    {
        char first = characters[index];
        int width = 0;
        If (first == 'y') width = 4;
        ElseIf (first == 'f') width = 3;
        ElseIf (first == 'M' || first == 'd' || first == 'H' || first == 'm' || first == 's') width = 2;

        If (width == 0 || width > length - index || characters[index + 1] != first ||
            (width >= 3 && characters[index + 2] != first) || (width == 4 && characters[index + 3] != first))
        {
            index++;
            Continue;
        }

        int part = 0;
        If (value != null)
        {
            part = Switch (first)
            {
                Case ('y') { value.Year }
                Case ('M') { value.Month }
                Case ('d') { value.Day }
                Case ('H') { value.Hour }
                Case ('m') { value.Minute }
                Case ('s') { value.Second }
                Case (default) { value.Millisecond }
            };
        }
        string digits = __TimePad(part, width);
        If (width == length) Return digits;
        If (output == null) output = New IO.Text.Builder();
        If (literal < index) output.Append([string](characters + literal), index - literal);
        output.Append(digits);
        index += width;
        literal = index;
    }
    If (output == null) Return pattern;
    If (literal < length) output.Append([string](characters + literal), length - literal);
    Return output.Build();
}

Unit IO.Json;

Get IO.Char;
Get IO.Error;
Get IO.Math;
Get IO.Kinal.Runtime;
Get IO.Text;
Get Native By IO.__Json;

Trusted Function void __JsonThrow(string message)
{
    Throw New IO.Error("IO.Json", message);
}

Trusted Function string __JsonNativeError(string fallback)
{
    string detail = Native.LastError();
    If (detail == null || detail == "")
    {
        Return fallback;
    }
    Return detail;
}

Trusted Function byte* __JsonParseDocument(string text)
{
    byte* document = Native.DocumentParse(text);
    If (document == null)
    {
        __JsonThrow(__JsonNativeError("Failed to parse JSON text"));
    }
    Return document;
}

Trusted Function char __JsonHexDigit(int value)
{
    If (value < 10)
    {
        Return [char]([int]('0') + value);
    }
    Return [char]([int]('a') + (value - 10));
}

// Batch nearby escapes. Each input byte expands to at most six bytes.
Trusted Function int __JsonWriteEscapedChunk(IO.Text.Builder output, byte* data, int index)
{
    char[256] chunk;
    int used = 0;
    While (used <= 249 && data[index] != 0)
    {
        int code = [int](data[index++]);
        If (code >= 32 && code != [int]('"') && code != [int]('\\'))
        {
            chunk[used++] = [char](code);
            Continue;
        }
        chunk[used++] = '\\';
        If (code == [int]('"') || code == [int]('\\')) chunk[used++] = [char](code);
        Else If (code == 8) chunk[used++] = 'b';
        Else If (code == 12) chunk[used++] = 'f';
        Else If (code == 10) chunk[used++] = 'n';
        Else If (code == 13) chunk[used++] = 'r';
        Else If (code == 9) chunk[used++] = 't';
        Else
        {
            chunk[used++] = 'u'; chunk[used++] = '0'; chunk[used++] = '0';
            chunk[used++] = __JsonHexDigit(code >> 4);
            chunk[used++] = __JsonHexDigit(code & 15);
        }
    }
    chunk[used] = '\0';
    output.Append([string](&chunk[0]), used);
    Return index;
}

Trusted Function void __JsonWriteQuoted(IO.Text.Builder output, string text)
{
    byte* data = [byte*](text);
    output.AppendChar('"');
    int index = 0;
    While (data != null && data[index] != 0)
    {
        int start = index;
        While (data[index] >= 32 && data[index] != [byte]('"') && data[index] != [byte]('\\')) index++;
        If (index > start) output.Append([string]([char*](data + start)), index - start);
        If (data[index] != 0) index = __JsonWriteEscapedChunk(output, data, index);
    }
    output.AppendChar('"');
}

Trusted Function string __JsonFormatNumber(float value)
{
    string text = Native.FormatNumber([f64](value));
    If (text == null || text == "")
    {
        __JsonThrow(__JsonNativeError("Failed to format JSON number"));
    }
    Return text;
}

Trusted Function int __JsonBoolFlag(bool value)
{
    If (value)
    {
        Return 1;
    }
    Return 0;
}

Trusted Function bool IsDict(any value)
{
    Return !value.IsNull() && value.TypeName() == "IO.Collection.dict";
}

Trusted Function bool IsList(any value)
{
    Return !value.IsNull() && value.TypeName() == "IO.Collection.list";
}

Public Class Value
{
    Private any _Raw;

    Public Constructor(any value = null)
    {
        _Raw = value;
    }

    Public Property any Raw
    {
        Get
        {
            Return _Raw;
        }
        Set
        {
            _Raw = value;
        }
    }

    Public Trusted Property dict Dict
    {
        Get
        {
            Return AsDict(_Raw);
        }
        Set
        {
            _Raw = value;
        }
    }

    Public Trusted Property list List
    {
        Get
        {
            Return AsList(_Raw);
        }
        Set
        {
            _Raw = value;
        }
    }

    Public Property string Text
    {
        Get
        {
            Return [string](_Raw);
        }
        Set
        {
            _Raw = value;
        }
    }

    Public Property int Int
    {
        Get
        {
            Return [int](_Raw);
        }
        Set
        {
            _Raw = value;
        }
    }

    Public Property float Float
    {
        Get
        {
            Return [float](_Raw);
        }
        Set
        {
            _Raw = value;
        }
    }

    Public Property bool Bool
    {
        Get
        {
            Return [bool](_Raw);
        }
        Set
        {
            _Raw = value;
        }
    }

    Public Trusted Property bool IsNull
    {
        Get
        {
            Return _Raw.IsNull();
        }
    }

    Public Trusted Property bool IsDict
    {
        Get
        {
            Return IO.Json.IsDict(_Raw);
        }
    }

    Public Trusted Property bool IsList
    {
        Get
        {
            Return IO.Json.IsList(_Raw);
        }
    }
}

Public Class Object
{
    Private dict _Data;

    Public Constructor(dict data = null)
    {
        If (data == null)
        {
            _Data = dict.Create();
        }
        Else
        {
            _Data = data;
        }
    }

    Public Property dict Data
    {
        Get
        {
            Return _Data;
        }
        Set
        {
            If (value == null)
            {
                _Data = dict.Create();
            }
            Else
            {
                _Data = value;
            }
        }
    }

    Public Trusted Property int Count
    {
        Get
        {
            Return _Data.Count();
        }
    }

    Public Trusted Property list Keys
    {
        Get
        {
            Return _Data.Keys();
        }
    }

    Public Trusted Function IO.Json.Value Value(string key)
    {
        Return New IO.Json.Value(_Data.Fetch(key));
    }

    Public Trusted Function IO.Json.Value ValueOr(string key, any fallback)
    {
        Return New IO.Json.Value(_Data.TryFetch(key, fallback));
    }

    Public Trusted Function IO.Json.Object Put(string key, any value)
    {
        _Data.Set(key, value);
        Return This;
    }

    Public Trusted Function IO.Json.Object Remove(string key)
    {
        dict.Remove(_Data, key);
        Return This;
    }

    Public Trusted Function bool Has(string key)
    {
        Return dict.Contains(_Data, key);
    }
}

Trusted Function dict AsDict(any value)
{
    If (!IsDict(value))
    {
        __JsonThrow("JSON value is not an object");
    }
    Return IO.Type.dict(value);
}

Trusted Function list AsList(any value)
{
    If (!IsList(value))
    {
        __JsonThrow("JSON value is not an array");
    }
    Return IO.Type.list(value);
}

Trusted Function any __JsonBuildValue(byte* document, int node_id)
{
    int kind = Native.NodeKind(document, node_id);

    If (kind == 0)
    {
        Return null;
    }
    If (kind == 1)
    {
        Return Native.NodeBool(document, node_id) != 0;
    }
    If (kind == 2)
    {
        Return Native.NodeInt(document, node_id);
    }
    If (kind == 3)
    {
        Return [float](Native.NodeFloat(document, node_id));
    }
    If (kind == 4)
    {
        Return Native.NodeString(document, node_id);
    }
    If (kind == 5)
    {
        Return __JsonBuildObject(document, node_id);
    }
    If (kind == 6)
    {
        Return __JsonBuildArray(document, node_id);
    }

    __JsonThrow("Unsupported JSON node kind: " + kind.ToString());
    Return null;
}

Trusted Function dict __JsonBuildObject(byte* document, int node_id)
{
    dict result = dict.Create();
    int count = Native.ObjectCount(document, node_id);

    For (int i = 0; i < count; i++)
    {
        string key = Native.ObjectKeyAt(document, node_id, i);
        int child_id = Native.ObjectValueAt(document, node_id, i);
        result.Set(key, __JsonBuildValue(document, child_id));
    }

    Return result;
}

Trusted Function list __JsonBuildArray(byte* document, int node_id)
{
    list result = list.Create();
    int count = Native.ArrayCount(document, node_id);

    For (int i = 0; i < count; i++)
    {
        int child_id = Native.ArrayItemAt(document, node_id, i);
        result.Add(__JsonBuildValue(document, child_id));
    }

    Return result;
}

Trusted Function void __JsonIndent(IO.Text.Builder output, int depth)
{
    For (int i = 0; i < depth; i++) output.AppendChar('\t');
}

Trusted Function void __JsonWriteInt(IO.Text.Builder output, int value)
{
    If (value >= 0 && value <= 9)
    {
        output.AppendChar([char]([int]('0') + value));
        Return;
    }
    // Keep the magnitude negative so the minimum signed integer fits.
    int remaining = value > 0 ? -value : value;
    char[21] digits;
    int start = 20;
    digits[start] = '\0';
    While (remaining != 0)
    {
        start--;
        digits[start] = [char]([int]('0') - remaining % 10);
        remaining /= 10;
    }
    If (value < 0) { start--; digits[start] = '-'; }
    output.Append([string](&digits[start]), 20 - start);
}

Trusted Function void __JsonWriteValue(IO.Text.Builder output, any value, int depth, bool pretty = false)
{
    If (depth > 128) __JsonThrow("JSON structure is too deeply nested");

    If (value.IsNull()) output.Append("null");
    Else If (value.IsString() || value.IsChar()) __JsonWriteQuoted(output, [string](value));
    Else If (value.IsBool()) output.Append([bool](value) ? "true" : "false");
    Else If (value.IsInt()) __JsonWriteInt(output, [int](value));
    Else If (value.IsFloat())
    {
        float number = [float](value);
        If (IO.Math.IsNaN(number) || IO.Math.IsInf(number))
            __JsonThrow("JSON does not support NaN or Infinity");
        output.Append(__JsonFormatNumber(number));
    }
    Else
    {
        string typeName = value.TypeName();
        If (typeName == "IO.Collection.dict") __JsonWriteDict(output, AsDict(value), depth + 1, pretty);
        Else If (typeName == "IO.Collection.list") __JsonWriteList(output, AsList(value), depth + 1, pretty);
        Else __JsonThrow("Unsupported JSON value type: " + typeName);
    }
}

Trusted Function void __JsonWriteList(IO.Text.Builder output, list value, int depth, bool pretty)
{
    output.AppendChar('[');
    int count = value.Count();
    For (int i = 0; i < count; i++)
    {
        If (i > 0) { output.AppendChar(','); If (pretty) output.AppendChar(' '); }
        __JsonWriteValue(output, value.Fetch(i), depth, pretty);
    }
    output.AppendChar(']');
}

Trusted Function void __JsonWriteDict(IO.Text.Builder output, dict value, int depth, bool pretty)
{
    output.AppendChar('{');
    If (pretty) output.AppendChar('\n');
    list keys = value.Keys();
    int count = keys.Count();
    For (int i = 0; i < count; i++)
    {
        any keyValue = keys.Fetch(i);
        If (!keyValue.IsString()) __JsonThrow("JSON object keys must be strings");
        string key = [string](keyValue);
        __JsonWriteKey(output, key, i, depth, pretty);
        __JsonWriteValue(output, value.Fetch(key), depth, pretty);
    }
    __JsonEndObject(output, count, depth, pretty);
}

Trusted Function void __JsonWriteKey(IO.Text.Builder output, string key, int index, int depth, bool pretty)
{
    If (index > 0) { output.AppendChar(','); If (pretty) output.AppendChar('\n'); }
    If (pretty) __JsonIndent(output, depth);
    __JsonWriteQuoted(output, key);
    output.AppendChar(':');
    If (pretty) output.AppendChar('\t');
}

Trusted Function void __JsonEndObject(IO.Text.Builder output, int count, int depth, bool pretty)
{
    If (pretty)
    {
        If (count > 0) output.AppendChar('\n');
        __JsonIndent(output, depth - 1);
    }
    output.AppendChar('}');
}

[IO.Kinal.Runtime.KncIntrinsic(257)]
Trusted Function any ParseValue(string text)
{
    byte* document = __JsonParseDocument(text);
    any result = null;

    Try
    {
        result = __JsonBuildValue(document, Native.DocumentRoot(document));
        Native.DocumentFree(document);
        Return result;
    }
    Catch (IO.Error e)
    {
        Native.DocumentFree(document);
        Throw e;
    }
}

Trusted Function dict Parse(string text)
{
    Return AsDict(ParseValue(text));
}

Trusted Function IO.Json.Object ParseObject(string text)
{
    Return New IO.Json.Object(Parse(text));
}

Trusted Function IO.Json.Object Wrap(dict value)
{
    Return New IO.Json.Object(value);
}

[IO.Kinal.Runtime.KncIntrinsic(258)]
Trusted Function string FormatText(string text, bool pretty = true)
{
    string formatted = Native.FormatText(text, __JsonBoolFlag(pretty));
    If (formatted == null)
    {
        __JsonThrow(__JsonNativeError("Failed to format JSON text"));
    }
    Return formatted;
}

Trusted Function string Minify(string text)
{
    Return FormatText(text, false);
}

[IO.Kinal.Runtime.KncIntrinsic(259)]
Trusted Function string FormatValue(any value, bool pretty = true)
{
    IO.Text.Builder output = New IO.Text.Builder();
    __JsonWriteValue(output, value, 0, pretty);
    Return output.Build();
}

Trusted Function string Format(any value, bool pretty = true)
{
    Return FormatValue(value, pretty);
}

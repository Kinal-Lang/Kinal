Unit IO.UI;

Public Class Component
{
    Public string Name;
    Protected string _Text;
    Protected int _X;
    Protected int _Y;
    Protected int _Width;
    Protected int _Height;
    Protected Color _BackColor;
    Protected Color _ForeColor;
    Protected Font _Font;
    Private int _RadiusPlusOne;
    Private int _StrokePlusOne;
    Public Property int CornerRadius {
        Get { Return _RadiusPlusOne-1; }
        Set { _RadiusPlusOne=value<0?0:value+1;Invalidate(); }
    }
    Public Property int BorderWidth {
        Get { Return _StrokePlusOne==0?1:_StrokePlusOne-1; }
        Set { _StrokePlusOne=value<0?0:value+1;Invalidate(); }
    }
    Private Color _BorderColor;
    Public Property Color BorderColor {
        Get { Return _BorderColor; }
        Set { _BorderColor=value;Invalidate(); }
    }
    Private Color _HoverBorderColor;
    Public Property Color HoverBorderColor {
        Get { Return _HoverBorderColor; }
        Set { _HoverBorderColor=value;Invalidate(); }
    }
    Private Color _PressedBorderColor;
    Public Property Color PressedBorderColor {
        Get { Return _PressedBorderColor; }
        Set { _PressedBorderColor=value;Invalidate(); }
    }
    Private Color _HoverBackColor;
    Public Property Color HoverBackColor {
        Get { Return _HoverBackColor; }
        Set { _HoverBackColor=value;Invalidate(); }
    }
    Private Color _PressedBackColor;
    Public Property Color PressedBackColor {
        Get { Return _PressedBackColor; }
        Set { _PressedBackColor=value;Invalidate(); }
    }
    Private Color _HoverForeColor;
    Public Property Color HoverForeColor {
        Get { Return _HoverForeColor; }
        Set { _HoverForeColor=value;Invalidate(); }
    }
    Private Color _PressedForeColor;
    Public Property Color PressedForeColor {
        Get { Return _PressedForeColor; }
        Set { _PressedForeColor=value;Invalidate(); }
    }
    Public Function int StyleRadius(int normal){Return _RadiusPlusOne==0?normal:_RadiusPlusOne-1;}
    Public Function u32 StyleFill(u32 normal,u32 hover,u32 pressed){
        If(Pressed)Return __UI_Color(PressedBackColor,pressed);
        If(Hovered)Return __UI_Color(HoverBackColor,hover);
        Return __UI_Color(BackColor,normal);
    }
    Public Function u32 StyleText(u32 normal){
        u32 base=__UI_Color(EffectiveForeColor(),normal);
        If(Pressed)Return __UI_Color(PressedForeColor,base);
        If(Hovered)Return __UI_Color(HoverForeColor,base);
        Return base;
    }
    Public Function u32 StyleBorder(u32 normal){
        u32 base=__UI_Color(BorderColor,normal);
        If(Pressed)Return __UI_Color(PressedBorderColor,base);
        If(Hovered)Return __UI_Color(HoverBorderColor,base);
        Return base;
    }
    Protected Window _Owner;
    Protected Event[] _Events;

    Public Constructor(string text = "", int x = 0, int y = 0, int width = 120, int height = 24)
    {
        _Text = text;
        _X = x;
        _Y = y;
        _Width = width;
        _Height = height;
        _BackColor = default;
        _ForeColor = default;
        _Font = default;
        _Owner = default;
        _Events = {};
    }

    Public Property string Text
    {
        Get
        {
            Return _Text;
        }
        Set
        {
            _Text = value;
            Invalidate();
        }
    }

    Public Property int X
    {
        Get
        {
            Return _X;
        }
        Set
        {
            _X = value;
            InvalidateLayout();
        }
    }

    Public Property int Y
    {
        Get
        {
            Return _Y;
        }
        Set
        {
            _Y = value;
            InvalidateLayout();
        }
    }

    Public Property int Width
    {
        Get
        {
            Return _Width;
        }
        Set
        {
            _Width = value;
            InvalidateLayout();
        }
    }

    Public Property int Height
    {
        Get
        {
            Return _Height;
        }
        Set
        {
            _Height = value;
            InvalidateLayout();
        }
    }

    Public Property Color BackColor
    {
        Get
        {
            Return _BackColor;
        }
        Set
        {
            _BackColor = value;
            Invalidate();
        }
    }

    Public Property Color ForeColor
    {
        Get
        {
            Return _ForeColor;
        }
        Set
        {
            _ForeColor = value;
            Invalidate();
        }
    }

    Public Property Font Font
    {
        Get
        {
            Return _Font;
        }
        Set
        {
            _Font = value;
            Invalidate();
        }
    }





    Public Property Window Owner { Get { Return _Owner; } }
    Public Property Event[] Events { Get { Return __UI_EventSnapshot(_Events); } }
    Internal Function void BindOwner(Window window)
    {
        _Owner = window;
        If (This Is GroupBox group)
        {
            int i=0;
            While(i<group.ChildCount) { group.ChildAt(i).BindOwner(window); i++; }
        }
    }

    Private bool _FillWindow;
    Public Property bool FillWindow
    {
        Get { Return _FillWindow; }
        Set { If (_FillWindow != value) { _FillWindow = value; InvalidateLayout(); } }
    }
    Private bool _AbsolutePosition;
    Public Property bool AbsolutePosition
    {
        Get { Return _AbsolutePosition; }
        Set { If (_AbsolutePosition != value) { _AbsolutePosition = value; InvalidateLayout(); } }
    }
    Private int _Grow;
    Public Property int Grow
    {
        Get { Return _Grow; }
        Set { If (_Grow != value) { _Grow = value; InvalidateLayout(); } }
    }
    Private int _MinWidth;
    Public Property int MinWidth
    {
        Get { Return _MinWidth; }
        Set { If (_MinWidth != value) { _MinWidth = value; InvalidateLayout(); } }
    }
    Private int _MinHeight;
    Public Property int MinHeight
    {
        Get { Return _MinHeight; }
        Set { If (_MinHeight != value) { _MinHeight = value; InvalidateLayout(); } }
    }
    Private int _MaxWidth;
    Public Property int MaxWidth
    {
        Get { Return _MaxWidth; }
        Set { If (_MaxWidth != value) { _MaxWidth = value; InvalidateLayout(); } }
    }
    Private int _MaxHeight;
    Public Property int MaxHeight
    {
        Get { Return _MaxHeight; }
        Set { If (_MaxHeight != value) { _MaxHeight = value; InvalidateLayout(); } }
    }
    Private int _Margin;
    Public Property int Margin
    {
        Get { Return _Margin; }
        Set { If (_Margin != value) { _Margin = value; InvalidateLayout(); } }
    }
    Private int _Column;
    Public Property int Column
    {
        Get { Return _Column; }
        Set { If (_Column != value) { _Column = value; InvalidateLayout(); } }
    }
    Private int _Row;
    Public Property int Row
    {
        Get { Return _Row; }
        Set { If (_Row != value) { _Row = value; InvalidateLayout(); } }
    }
    Private int _ColumnSpan;
    Public Property int ColumnSpan
    {
        Get { Return _ColumnSpan; }
        Set { If (_ColumnSpan != value) { _ColumnSpan = value; InvalidateLayout(); } }
    }
    Private int _RowSpan;
    Public Property int RowSpan
    {
        Get { Return _RowSpan; }
        Set { If (_RowSpan != value) { _RowSpan = value; InvalidateLayout(); } }
    }
    Public int ActualWidth;
    Public int ActualHeight;
    Public int ActualX;
    Public int ActualY;

    Public Function void InvalidateLayout()
    {
        If (Owner != null) { Owner.RequestLayout(); }
    }

    Public Virtual Function int MeasureWidth(int available) { Return Width; }
    Public Virtual Function int MeasureHeight(int available) { Return Height; }

    Public Virtual Trusted Function void Arrange(int x, int y, int width, int height)
    {
        ActualX = x; ActualY = y;
        ActualWidth = __UI_Limit(width, MinWidth, MaxWidth);
        ActualHeight = __UI_Limit(height, MinHeight, MaxHeight);

    }

    Protected Component _Parent;
    Public Property Component Parent { Get { Return _Parent; } }
    Public Property byte* HostHandle { Get { If (Owner == null) Return null; Return Owner.Handle; } }
    Public Function void Invalidate() { If (Owner != null) Owner.Invalidate(); }
    Public Virtual Function void Draw(IO.UI.DrawingContext context) { __UI_DrawPreset(This,context); }
    Public Virtual Function void OnSurfaceEvent(IO.UI.SurfaceInput input) { __UI_PresetInput(This,input); }
    Public bool AcceptsTab;
    Public bool HasFocus;
    Public bool Hovered;
    Public bool Pressed;

    Internal Function void AttachTo(Component parent, Window window)
    {
        If (_Parent != null || Owner != null)
        {
            Throw New IO.Error("IO.UI", "A component can only belong to one container");
        }
        Component ancestor = parent;
        While (ancestor != null)
        {
            If (ancestor == This) { Throw New IO.Error("IO.UI", "Component cycle"); }
            ancestor = ancestor.Parent;
        }
        _Parent = parent;
        BindOwner(window);
    }

    Internal Trusted Function void Detach()
    {
        If (Owner != null) Owner.Forget(This);
        _Parent=default; BindOwner(null); Hovered=false; Pressed=false;
    }



    Public Safe Function bool SupportsEvent(IO.UI.EventKind kind) { Return SupportsEventCode([int](kind)); }
    Protected Virtual Safe Function bool SupportsEventCode(int code)
    {
        Return false;
    }

    Public Safe Function bool HasEvent(EventKind kind)
    {
        int i = 0;
        While (i < _Events.Length())
        {
            If (_Events[i].Kind == kind)
            {
                Return true;
            }
            i++;
        }
        Return false;
    }

    Public Virtual Safe Function string KindName()
    {
        Return "IO.UI.Component";
    }

    Public Trusted Function Color EffectiveBackColor()
    {
        If (BackColor != null)
        {
            Return BackColor;
        }
        If (Parent != null) { Return Parent.EffectiveBackColor(); }
        If (Owner != null)
        {
            Return Owner.BackColor;
        }
        Return default;
    }

    Public Trusted Function Color EffectiveForeColor()
    {
        If (ForeColor != null)
        {
            Return ForeColor;
        }
        If (Parent != null) { Return Parent.EffectiveForeColor(); }
        If (Owner != null)
        {
            Return Owner.ForeColor;
        }
        Return default;
    }

    Public Virtual Function ControlPalette EffectivePalette()
    {
        If (_Owner != null && _Owner.Palette != null) Return _Owner.Palette;
        Return __UI_DefaultPalette;
    }

    Public Trusted Function Font EffectiveFont()
    {
        If (Font != null)
        {
            Return Font;
        }
        If (Parent != null) { Return Parent.EffectiveFont(); }
        If (Owner != null)
        {
            Return Owner.Font;
        }
        Return default;
    }

    Public Trusted Function void __InternalSetText(string value)
    {
        _Text = value;
    }

    Public Function Component SetBackColor(Color color)
    {
        BackColor = color;
        Return This;
    }

    Public Function Component SetForeColor(Color color)
    {
        ForeColor = color;
        Return This;
    }

    Public Function Component SetFont(Font font)
    {
        Font = font;
        Return This;
    }

    Public Function Component AddEvent(Event event)
    {
        If (event == null)
        {
            Throw New IO.Error("IO.UI", "Event cannot be null");
        }
        If (!SupportsEvent(event.Kind))
        {
            __UI_ThrowUnsupportedEvent(KindName(), event.Kind);
        }
        _Events = _Events.Add(event);
        Return This;
    }

    Public Function Component RemoveEvent(Event event)
    {
        If (event == null)
        {
            Return This;
        }

        Event[] kept = {};
        int i = 0;
        While (i < _Events.Length())
        {
            Event current = _Events[i];
            If (current != event)
            {
                kept = kept.Add(current);
            }
            i++;
        }
        _Events = kept;
        Return This;
    }

    Public Trusted Function void TriggerEvent(EventKind kind, usize wParam = 0, isize lParam = 0)
    {
        If (_Events.Length()==0) Return;
        EventArgs args = New EventArgs(kind, wParam, lParam);
        Event[] listeners = _Events;
        int i = 0;
        While (i < listeners.Length())
        {
            Event current = listeners[i];
            If (current.Kind == kind)
            {
                current.Invoke(This, args);
            }
            i++;
        }
    }
}


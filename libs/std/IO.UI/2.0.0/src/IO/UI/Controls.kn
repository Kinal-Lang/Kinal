    }

    Public Property int Step
    {
        Get
        {
            Return _Step;
        }
        Set
        {
            _Step = value;
            Invalidate();
        }
    }

    Public Trusted Function void PerformStep()
    {
        Invalidate();
        _Value = _Value + Step;
        If (_Value > Maximum)
        {
            _Value = Maximum;
        }
    }

    Public Override Safe Function string KindName()
    {
        Return "IO.UI.ProgressBar";
    }

}

Public Class GroupBox By Component
{
    Protected Component[] _Children;

    Public Constructor(string text, int x = 0, int y = 0, int width = 300, int height = 200)
    {
        _Text = text;
        _X = x;
        _Y = y;
        _Width = width;
        _Height = height;
        _BackColor = default;
        _ForeColor = default;
        _Font = default;
        _Owner = default;
        _Events = {};
        _Children = {};
    }

    Public Override Trusted Function void Arrange(int x,int y,int width,int height)
    {
        ActualX=x;ActualY=y;ActualWidth=__UI_Limit(width,MinWidth,MaxWidth);ActualHeight=__UI_Limit(height,MinHeight,MaxHeight);
        int i=0;While(i<_Children.Length()){Component c=_Children[i];c.Arrange(c.X,c.Y,c.Width,c.Height);i++;}
    }
    Public Property int ChildCount { Get { Return _Children.Length(); } }
    Public Function Component ChildAt(int index) { Return _Children[index]; }
    Public Function bool Remove(Component child)
    {
        Component[] kept={};bool found=false;int i=0;
        While(i<_Children.Length()){If(_Children[i]==child)found=true;Else kept=kept.Add(_Children[i]);i++;}
        If(!found)Return false;
        child.Detach();_Children=kept;InvalidateLayout();Return true;
    }

    Public Property Component[] Children
    {
        Get
        {
            Return __UI_ChildSnapshot(_Children);
        }
    }


    Public Function GroupBox Add(Component child)
    {
        If (child == null)
        {
            Throw New IO.Error("IO.UI", "Child component cannot be null");
        }
        child.AttachTo(This, Owner);
        _Children = _Children.Add(child);
        InvalidateLayout();
        Return This;
    }

    Public Override Safe Function string KindName()
    {
        Return "IO.UI.GroupBox";
    }

}


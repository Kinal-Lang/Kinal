Public Class Button By Component
{
    Private int _Id;

    Public Constructor(string text, int x = 0, int y = 0, int width = 120, int height = 28)
    {
        _Text = text;
        _X = x;
        _Y = y;
        _Width = width;
        _Height = height;
        _BackColor = default;
        _ForeColor = default;
        _Font = default;
        _Owner = default;
        _Events = {};
        _Id = 0;
    }

    Public Property int Id
    {
        Get
        {
            Return _Id;
        }
        Set
        {
            _Id = value;
        }
    }

    Protected Override Safe Function bool SupportsEventCode(int code)
    {
        EventKind kind = [EventKind](code);
        Return kind == EventKind.OnClick || kind == EventKind.OnMouseDown ||
               kind == EventKind.OnMouseMove || kind == EventKind.OnMouseUp ||
               kind == EventKind.OnMouseEnter || kind == EventKind.OnMouseLeave;
    }

    Public Override Safe Function string KindName()
    {
        Return "IO.UI.Button";
    }


    Public Trusted Function void TriggerClick()
    {
        TriggerEvent(EventKind.OnClick, [usize](Id), 0);
    }
}


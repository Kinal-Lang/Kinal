Public Class RadioButton By Component
{
    Private int _Id;
    Private bool _Checked;
    Private string _GroupName;

    Public Constructor(string text, int x = 0, int y = 0, int width = 160, int height = 24)
    {
        _Text = text;
        _X = x;
        _Y = y;
        _Width = width;
        _Height = height;
        _BackColor = default;
        _ForeColor = default;
        _Font = default;
        _Owner = default;
        _Events = {};
        _Id = 0;
        _Checked = false;
        _GroupName = "";
    }

    Public Property int Id
    {
        Get
        {
            Return _Id;
        }
        Set
        {
            _Id = value;
        }
    }

    Public Property bool Checked
    {
        Get
        {
            Return _Checked;
        }
        Set
        {
            _Checked = value;
            Invalidate();
            If (value) { UpdatePeers(); }
        }
    }

    Public Property string GroupName
    {
        Get
        {
            Return _GroupName;
        }
        Set
        {
            _GroupName = value;
            If (_Checked) { UpdatePeers(); }
        }
    }

    Private Function void UpdatePeers()
    {
        Component[] peers = {};
        If (Parent Is GroupBox group) { peers = group.Children; }
        Else If (Owner != null) { peers = Owner.Components; }
        int i = 0;
        While (i < peers.Length())
        {
            If (peers[i] Is RadioButton other)
            {
                If (other != This && other.GroupName == GroupName && other.Checked)
                {
                    other.Checked = false;
                    If (other.Owner != null) { other.TriggerEvent(EventKind.OnCheckedChanged, 0, 0); }
                }
            }
            i++;
        }
    }

    Protected Override Safe Function bool SupportsEventCode(int code)
    {
        EventKind kind = [EventKind](code);
        Return kind == EventKind.OnCheckedChanged || kind == EventKind.OnClick ||
               kind == EventKind.OnFocus || kind == EventKind.OnBlur;
    }

    Public Override Safe Function string KindName()
    {
        Return "IO.UI.RadioButton";
    }

    Public Trusted Function void __InternalSetChecked(bool value)
    {
        _Checked = value;
    }

}


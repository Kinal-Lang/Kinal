Unit IO.Kinal.VM.Desktop;

Get Context By IO.Kinal.VM.Context;
Get Bytecode By IO.Kinal.VM.Bytecode;
Get IO.Kinal.VM.Stdlib;
Get Native By IO.__UI;
Get UI By IO.UI;
Get IO.Console;

// An HWND never enters guest registers. Tokens belong to one VM and expire on WM_DESTROY.
Class SurfaceBinding
{
    Public Context.ExecutionContext Context;
    Public byte* Window;
    Public int Token;
    Public int GuestRoot;
    Public int Callback;
}
SurfaceBinding[] Windows = {};

Trusted Function byte* WindowAt(Context.ExecutionContext ctx, int reg)
{
    Context.FunctionFrame frame = ctx.CurrentFrame();
    If (frame.Kinds[reg] == [int](Bytecode.ValueKind.Null)) Return null;
    int token = frame.GetPointer(reg);
    For (int i = 0; i < Windows.Length(); i++)
        If (Windows[i].Context == ctx && Windows[i].Token == token) Return Windows[i].Window;
    Throw "Unknown or closed IO.UI window handle";
}

Trusted Function isize SurfaceMessage(byte* hwnd, u32 message, usize first, isize second)
{
    For (int i = 0; i < Windows.Length(); i++)
    {
        SurfaceBinding surface = Windows[i];
        If (surface.Window != hwnd) Continue;
        Context.ExecutionContext ctx = surface.Context;
        int result = 0;
        If (!ctx.Halted)
        {
            Try
            {
                Context.VMValue[] args = {Context.VMValue.FromPointer(surface.Token), Context.VMValue.FromInt([int](message)),
                    Context.VMValue.FromInt([int](first)), Context.VMValue.FromInt([int](second))};
                IO.Type.Object.Function invoke = ctx.InvokeCallback;
                Context.VMValue value = [Context.VMValue](invoke(surface.Callback, args));
                If (value != null) result = value.IntValue;
                Else Native.QuitLoop();
            }
            Catch (IO.Error error)
            {
                IO.Console.PrintLine(error.Message);
                IO.Console.PrintLine(ctx.BuildTrace());
                ctx.ExitCode = 1; ctx.Halted = true; Native.QuitLoop();
            }
        }
        If (message == 19)
        {
            SurfaceBinding[] live = {};
            For (int j = 0; j < Windows.Length(); j++) If (Windows[j] != surface) live = live.Add(Windows[j]);
            Windows = live;
            ctx.Heap.Unpin(surface.GuestRoot);
        }
        Return [isize](result);
    }
    Return 0;
}

[IO.Kinal.VM.Stdlib.VmRangeBuiltin(180, "IO.UI.OpenSurface", 6)]
Trusted Function void OpenSurface(Context.ExecutionContext ctx, int dst, int first)
{
    Context.FunctionFrame frame = ctx.CurrentFrame();
    SurfaceBinding surface = New SurfaceBinding();
    surface.Context = ctx;
    surface.Callback = ctx.FunctionPointerTarget(frame.GetPointer(first + 5));
    surface.Token = ctx.NewHostHandle();
    surface.GuestRoot = ctx.Heap.Pin(Context.VMValue.FromPointer(surface.Token));
    Try
    {
        surface.Window = Native.OpenSurface(frame.GetNullableString(first), frame.GetInt(first+1), frame.GetInt(first+2),
            frame.GetInt(first+3), frame.GetInt(first+4), &SurfaceMessage);
    }
    Catch (IO.Error error) { ctx.Heap.Unpin(surface.GuestRoot); Throw error; }
    Windows = Windows.Add(surface);
    If (dst != 255) frame.ImportValue(dst, Context.VMValue.FromPointer(surface.Token));
}


Unit IO.Kinal.VM.Binary;

Get Memory By IO.Memory;
Get IO.Kinal.Runtime;
Get IO.Target;

Unsafe Extern Function byte* fopen(string path, string mode) By C;
Unsafe Extern Function byte* _wfopen(u16* path, u16* mode) By C;
Unsafe Extern Function i32 MultiByteToWideChar(u32 page, u32 flags, string input, i32 length,
                                               u16* output, i32 capacity) By System;
Unsafe Extern Function int fclose(byte* file) By C;
Unsafe Extern Function int fseek(byte* file, int offset, int origin) By C;
Unsafe Extern Function int ftell(byte* file) By C;
Unsafe Extern Function usize fread(byte* buffer, usize size, usize count, byte* file) By C;
Unsafe Extern Function byte* malloc(usize size) By C;
Unsafe Extern Function byte* calloc(usize count, usize size) By C;
Unsafe Extern Function void free(byte* buffer) By C;
Unsafe Extern Function string __kn_sys_executable_path() By C;

Struct ByteSpan { byte* Data; i64 Length; }
Struct ByteArray { byte[] Data; }

// Copy into an ordinary array owned by the active language heap in one allocation.
Unsafe Function byte[] CopyBytes(byte* source, int count)
{
    If (count == 0) Return {};
    ByteArray prefix;
    ByteSpan* span = [ByteSpan*](&prefix);
    span[0].Data = source;
    span[0].Length = [i64](count - 1);
    Return prefix.Data.Add(source[count - 1]);
}

Public Class BinaryFile
{
    Private Unsafe Static Function byte* OpenRead(string path)
    {
        If (IO.Target.OS == IO.Target.OS.Windows)
        {
            i32 count = MultiByteToWideChar(65001, 8, path, -1, null, 0);
            If (count <= 0) Return null;
            u16* wide = [u16*](IO.Kinal.Runtime.AllocateRaw([usize](count) * 2));
            If (wide == null || MultiByteToWideChar(65001, 8, path, -1, wide, count) != count) Return null;
            u16[] mode = {[u16](114), [u16](98), [u16](0)};
            Return _wfopen(wide, &mode[0]);
        }
        Return fopen(path, "rb");
    }

    Public Unsafe Static Function byte[] ReadAllBytes(string path)
    {
        byte* file = OpenRead(path);
        If (file == null)
        {
            Throw "Cannot open file: " + path;
        }

        If (fseek(file, 0, 2) != 0)
        {
            fclose(file);
            Throw "Cannot seek file: " + path;
        }

        int size = ftell(file);
        If (size < 0)
        {
            fclose(file);
            Throw "Cannot read file size: " + path;
        }

        If (fseek(file, 0, 0) != 0)
        {
            fclose(file);
            Throw "Cannot rewind file: " + path;
        }

        Return ReadAndClose(file, size, path);
    }

    Private Unsafe Static Function byte[] ReadAndClose(byte* file, int count, string path)
    {
        If (count == 0) { fclose(file); Return {}; }
        byte* buffer = malloc([usize](count));
        If (buffer == null)
        {
            fclose(file);
            Throw "Out of memory while reading file: " + path;
        }
        usize readCount = fread(buffer, 1, [usize](count), file);
        fclose(file);
        If ([int](readCount) != count)
        {
            free(buffer);
            Throw "Short read while reading file: " + path;
        }
        byte[] data = CopyBytes(buffer, count);
        free(buffer);
        Return data;
    }

    Public Unsafe Static Function int FileSize(string path)
    {
        byte* file = OpenRead(path);
        If (file == null)
        {
            Return -1;
        }
        If (fseek(file, 0, 2) != 0)
        {
            fclose(file);
            Return -1;
        }
        int size = ftell(file);
        fclose(file);
        Return size;
    }

    Public Unsafe Static Function byte[] ReadBytesRange(string path, int offset, int count)
    {
        If (offset < 0 || count < 0) Throw "Invalid file range: " + path;
        byte* file = OpenRead(path);
        If (file == null)
        {
            Throw "Cannot open file: " + path;
        }
        If (fseek(file, offset, 0) != 0)
        {
            fclose(file);
            Throw "Cannot seek file: " + path;
        }
        Return ReadAndClose(file, count, path);
    }

    Public Unsafe Static Function string GetExePath()
    {
        string path = __kn_sys_executable_path();
        If (path == "")
        {
            Throw "Cannot get exe path";
        }
        Return path;
    }
}

Public Class BlobReader
{
    Public byte[] Data;
    Public int Offset;

    Public Constructor(byte[] data)
    {
        This.Data = data;
        This.Offset = 0;
    }

    Public Function int Remaining()
    {
        Return This.Data.Length() - This.Offset;
    }

    Public Function void Require(int count)
    {
        If (count < 0 || This.Offset < 0 || This.Offset + count > This.Data.Length())
        {
            Throw "Invalid or truncated KNC2 payload";
        }
    }

    Public Function int ReadU8()
    {
        This.Require(1);
        int value = [int](This.Data[This.Offset]);
        This.Offset = This.Offset + 1;
        Return value;
    }

    Public Function int ReadU16()
    {
        This.Require(2);
        int value = [int](This.Data[This.Offset]) |
                    ([int](This.Data[This.Offset + 1]) << 8);
        This.Offset = This.Offset + 2;
        Return value;
    }

    Public Function int ReadU32()
    {
        This.Require(4);
        int value = [int](This.Data[This.Offset]) |
                    ([int](This.Data[This.Offset + 1]) << 8) |
                    ([int](This.Data[This.Offset + 2]) << 16) |
                    ([int](This.Data[This.Offset + 3]) << 24);
        This.Offset = This.Offset + 4;
        Return value;
    }

    Public Function int ReadI32()
    {
        int value = This.ReadU32();
        If ((value & 0x80000000) != 0)
        {
            Return value - 4294967296;
        }
        Return value;
    }

    Public Function int ReadI64()
    {
        u64 low = [u64](This.ReadU32());
        u64 high = [u64](This.ReadU32());
        Return [int](low | (high << 32));
    }

    Public Unsafe Function float ReadF64()
    {
        float value = 0.0;
        This.Require(8);
        Memory.Copy([byte*](&value), &This.Data[This.Offset], [usize](8));
        This.Offset = This.Offset + 8;
        Return value;
    }

    Public Trusted Function byte[] ReadBytes(int count)
    {
        This.Require(count);
        If (count == 0) Return {};
        byte[] data = CopyBytes(&This.Data[This.Offset], count);
        This.Offset = This.Offset + count;
        Return data;
    }

    Public Trusted Function string ReadString()
    {
        int count = This.ReadU32();
        This.Require(count);
        If (count == 0) Return "";
        char* value = IO.Kinal.Runtime.AllocateText(count);
        If (value == null) Throw "Out of memory while reading KNC text";
        // Kinal strings are NUL-terminated. Preserve the previous reader's omission of NUL bytes.
        int written = 0;
        For (int i = 0; i < count; i++)
        {
            byte part = This.Data[This.Offset + i];
            If (part != 0) { value[written] = [char](part); written++; }
        }
        value[written] = '\0';
        This.Offset = This.Offset + count;
        Return [string](value);
    }
}

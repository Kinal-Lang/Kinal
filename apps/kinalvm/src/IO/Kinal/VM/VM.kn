            Record OpLoopSumIntLeInc
            {
                int sumReg = [int](code[frame.Pc + 1]);
                int counterReg = [int](code[frame.Pc + 2]);
                int limitReg = [int](code[frame.Pc + 3]);
                int sumValue;
                int counterValue;
                int limitValue;
                If (kinds[sumReg] != [int](Bytecode.ValueKind.Int) ||
                    kinds[counterReg] != [int](Bytecode.ValueKind.Int) ||
                    kinds[limitReg] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "LoopSumIntLeInc requires int registers";
                }
                sumValue = intRegisters[sumReg];
                counterValue = intRegisters[counterReg];
                limitValue = intRegisters[limitReg];
                While (counterValue <= limitValue)
                {
                    sumValue = sumValue + counterValue;
                    counterValue = counterValue + 1;
                }
                kinds[sumReg] = [int](Bytecode.ValueKind.Int);
                intRegisters[sumReg] = sumValue;
                intRegisters[counterReg] = counterValue;
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;

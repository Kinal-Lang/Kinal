            Record OpUDivInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                int bits = [int](code[frame.Pc + 4]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                u64 lhsValue = VirtualMachine.UIntAtWidth(intRegisters[lhs], bits);
                u64 rhsValue = VirtualMachine.UIntAtWidth(intRegisters[rhs], bits);
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = [int](lhsValue / rhsValue);
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;

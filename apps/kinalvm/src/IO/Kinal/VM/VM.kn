Unit IO.Kinal.VM.VM;

Get Bytecode By IO.Kinal.VM.Bytecode;
Get Context By IO.Kinal.VM.Context;
Get Stdlib By IO.Kinal.VM.Stdlib;
Get Console By IO.Console;

Public Class VirtualMachine
{
    Private Stdlib.StdlibRegistry Registry;

    Public Constructor(Stdlib.StdlibRegistry registry)
    {
        This.Registry = registry;
    }

    Private Static Function u64 UIntAtWidth(int value, int bits)
    {
        Switch(bits)
        {
            Case(8)  { Return [u64]([u8](value)); }
            Case(16) { Return [u64]([u16](value)); }
            Case(32) { Return [u64]([u32](value)); }
            Case(64) { Return [u64](value); }
            Case(default) { Throw "Unsupported unsigned integer width: " + [string](bits); }
        }

        Throw "Unsupported unsigned integer width: " + [string](bits);
    }

    Public Unsafe Function int Execute(Bytecode.Program program, string[] arguments = {}, int firstArgument = 0)
    {
        Return This.ExecuteProgram(program, arguments, firstArgument, false);
    }

    Public Unsafe Function int ExecuteChecked(Bytecode.Program program, string[] arguments = {})
    {
        Return This.ExecuteProgram(program, arguments, 0, true);
    }

    Private Unsafe Function int ExecuteProgram(Bytecode.Program program, string[] arguments,
                                               int firstArgument, bool throwGuestErrors)
    {
        Context.ExecutionContext ctx = null;
        Try
        {
            ctx = New Context.ExecutionContext(program);
            ctx.InvokeCallback = Function Context.VMValue(int index, Context.VMValue[] arguments)
            {
                int depth = ctx.FrameCount;
                Context.FunctionFrame frame = ctx.PushCallback(index, arguments);
                This.RunFrames(ctx, depth);
                Return frame.HostResult;
            };
            ctx.PushEntry(program.EntryFunction, arguments, firstArgument);
            This.RunFrames(ctx, 0);
            If (ctx.HasUnhandledException)
            {
                string message = ctx.ExceptionMessage();
                If (ctx.CurrentTrace != "") message = message + "\n" + ctx.CurrentTrace;
                If (throwGuestErrors) Throw New IO.Error("KinalVM", message);
                Console.PrintLine(message + program.VersionNote());
            }
        }
        Catch (IO.Error error)
        {
            If (ctx != null) ctx.ReleaseArrayBuffers();
            string note = program.VersionNote();
            If (note != "") Throw New IO.Error(error.Title, error.Message + note);
            Throw error;
        }
        ctx.ReleaseArrayBuffers();
        Return ctx.ExitCode;
    }

    Private Trusted Function void RunFrames(Context.ExecutionContext ctx, int depth)
    {
        Bytecode.Program program = ctx.Program;
        int[] dispatchTargets = {};
        Stdlib.StdlibRegistry registry = This.Registry;

        Context.FunctionFrame frame;
        byte[] code;
        int codeLength;
        int[] kinds;
        int[] intRegisters;
        float[] floatRegisters;
        bool[] boolRegisters;
        string[] stringRegisters;

        Unsafe Block Dispatch
        </
            // Calls, returns and exceptions can select a different frame.
            // Host callbacks may also replace register storage before dispatch resumes.
            Record EnterFrame
            If (ctx.Halted || ctx.FrameCount <= depth)
            {
                Jump Halt;
            }

            frame = ctx.CurrentFrame();
            code = frame.FnInfo.Code;
            codeLength = code.Length();
            kinds = frame.Kinds;
            intRegisters = frame.IntRegisters;
            floatRegisters = frame.FloatRegisters;
            boolRegisters = frame.BoolRegisters;
            stringRegisters = frame.StringRegisters;
            Jump LoopStart;

            Record LoopStart

            If (frame.Pc < 0 || frame.Pc >= codeLength)
            {
                Throw "Instruction pointer out of range";
            }

            int op = [int](code[frame.Pc]);
            If (op < 0 || op >= dispatchTargets.Length())
            {
                Throw "Unknown KNC opcode: " + [string](op);
            }

            Jump dispatchTargets[op];

            Record HeapSafePoint
            ctx.Heap.Poll(ctx);
            Jump EnterFrame;

            Record OpLoadInt
            {
                frame.SetInt(
                    [int](code[frame.Pc + 1]),
                    program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 2)]
                );
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpLoadFloat
            {
                frame.SetFloat(
                    [int](code[frame.Pc + 1]),
                    program.FloatConstants[Bytecode.Program.ReadU16(code, frame.Pc + 2)]
                );
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpLoadBool
            {
                frame.SetBool([int](code[frame.Pc + 1]), [int](code[frame.Pc + 2]) != 0);
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpLoadString
            {
                frame.SetString(
                    [int](code[frame.Pc + 1]),
                    program.StringConstants[Bytecode.Program.ReadU16(code, frame.Pc + 2)]
                );
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpLoadChar
            {
                frame.SetChar(
                    [int](code[frame.Pc + 1]),
                    [char](program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 2)])
                );
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpMove
            {
                frame.CopyValue([int](code[frame.Pc + 1]), [int](code[frame.Pc + 2]));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpAddInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] + intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpSubInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] - intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpMulInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] * intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpDivInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] / intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpAddIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] + rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpSubIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] - rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpMulIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] * rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpDivIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] / rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpAddFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = floatRegisters[lhs] + floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpSubFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = floatRegisters[lhs] - floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpMulFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = floatRegisters[lhs] * floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpDivFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = floatRegisters[lhs] / floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpNegInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = -intRegisters[src];
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpNegFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = -floatRegisters[src];
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpEq
            {
                frame.SetBool([int](code[frame.Pc + 1]), frame.ValueEquals([int](code[frame.Pc + 2]), [int](code[frame.Pc + 3])));
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpNe
            {
                frame.SetBool([int](code[frame.Pc + 1]), !frame.ValueEquals([int](code[frame.Pc + 2]), [int](code[frame.Pc + 3])));
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpLtInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] < intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpLeInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] <= intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpGtInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] > intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpGeInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] >= intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpLtIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] < rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpLeIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] <= rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpGtIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] > rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpGeIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = intRegisters[lhs] >= rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpLtFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = floatRegisters[lhs] < floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpLeFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = floatRegisters[lhs] <= floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpGtFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = floatRegisters[lhs] > floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpGeFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Float) || kinds[rhs] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = floatRegisters[lhs] >= floatRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpNotBool
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Bool))
                {
                    Throw "Expected bool register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = !boolRegisters[src];
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpBitAndInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] & intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpBitOrInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] | intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpBitXorInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] ^ intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpShlInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] << intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpShrInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhs = [int](code[frame.Pc + 3]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] >> intRegisters[rhs];
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpBitAndIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] & rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpBitOrIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] | rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpBitXorIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] ^ rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpShlIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] << rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpShrIntImm
            {
                int dst = [int](code[frame.Pc + 1]);
                int lhs = [int](code[frame.Pc + 2]);
                int rhsValue = program.IntConstants[Bytecode.Program.ReadU16(code, frame.Pc + 3)];
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = intRegisters[lhs] >> rhsValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpBitNotInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = ~intRegisters[src];
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpIntToString
            {
                frame.SetString([int](code[frame.Pc + 1]), [string](frame.GetInt([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpBoolToString
            {
                    frame.SetString([int](code[frame.Pc + 1]), [string](frame.GetBool([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpCharToString
            {
                frame.SetString([int](code[frame.Pc + 1]), [string](frame.GetChar([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpStringToInt
            {
                frame.SetInt([int](code[frame.Pc + 1]), [int](frame.GetString([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpStringToBool
            {
                frame.SetBool([int](code[frame.Pc + 1]), [bool](frame.GetString([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpCharToInt
            {
                frame.SetInt([int](code[frame.Pc + 1]), [int](frame.GetChar([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpIntToChar
            {
                frame.SetChar([int](code[frame.Pc + 1]), [char](frame.GetInt([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpStringToChar
            {
                frame.SetChar([int](code[frame.Pc + 1]), [char](frame.GetString([int](code[frame.Pc + 2]))));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpJump
            {
                frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 1);
                Jump LoopStart;
            }

            Record OpJumpIfFalse
            {
                int cond = [int](code[frame.Pc + 1]);
                If (kinds[cond] != [int](Bytecode.ValueKind.Bool))
                {
                    Throw "Expected bool register";
                }
                If (!boolRegisters[cond])
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 2);
                }
                Else
                {
                    frame.Pc = frame.Pc + 4;
                }
                Jump LoopStart;
            }

            Record OpJumpIfTrue
            {
                int cond = [int](code[frame.Pc + 1]);
                If (kinds[cond] != [int](Bytecode.ValueKind.Bool))
                {
                    Throw "Expected bool register";
                }
                If (boolRegisters[cond])
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 2);
                }
                Else
                {
                    frame.Pc = frame.Pc + 4;
                }
                Jump LoopStart;
            }

            Record OpJumpIfIntLtFalse
            {
                int lhs = [int](code[frame.Pc + 1]);
                int rhs = [int](code[frame.Pc + 2]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                If (!(intRegisters[lhs] < intRegisters[rhs]))
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 3);
                }
                Else
                {
                    frame.Pc = frame.Pc + 5;
                }
                Jump LoopStart;
            }

            Record OpJumpIfIntLeFalse
            {
                int lhs = [int](code[frame.Pc + 1]);
                int rhs = [int](code[frame.Pc + 2]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                If (!(intRegisters[lhs] <= intRegisters[rhs]))
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 3);
                }
                Else
                {
                    frame.Pc = frame.Pc + 5;
                }
                Jump LoopStart;
            }

            Record OpJumpIfIntGtFalse
            {
                int lhs = [int](code[frame.Pc + 1]);
                int rhs = [int](code[frame.Pc + 2]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                If (!(intRegisters[lhs] > intRegisters[rhs]))
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 3);
                }
                Else
                {
                    frame.Pc = frame.Pc + 5;
                }
                Jump LoopStart;
            }

            Record OpJumpIfIntGeFalse
            {
                int lhs = [int](code[frame.Pc + 1]);
                int rhs = [int](code[frame.Pc + 2]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                If (!(intRegisters[lhs] >= intRegisters[rhs]))
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 3);
                }
                Else
                {
                    frame.Pc = frame.Pc + 5;
                }
                Jump LoopStart;
            }

            Record OpJumpIfIntEqFalse
            {
                int lhs = [int](code[frame.Pc + 1]);
                int rhs = [int](code[frame.Pc + 2]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                If (!(intRegisters[lhs] == intRegisters[rhs]))
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 3);
                }
                Else
                {
                    frame.Pc = frame.Pc + 5;
                }
                Jump LoopStart;
            }

            Record OpJumpIfIntNeFalse
            {
                int lhs = [int](code[frame.Pc + 1]);
                int rhs = [int](code[frame.Pc + 2]);
                If (kinds[lhs] != [int](Bytecode.ValueKind.Int) || kinds[rhs] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int registers";
                }
                If (!(intRegisters[lhs] != intRegisters[rhs]))
                {
                    frame.Pc = Bytecode.Program.ReadU16(code, frame.Pc + 3);
                }
                Else
                {
                    frame.Pc = frame.Pc + 5;
                }
                Jump LoopStart;
            }

            Record OpIncInt
            {
                int reg = [int](code[frame.Pc + 1]);
                If (kinds[reg] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                intRegisters[reg] = intRegisters[reg] + 1;
                frame.Pc = frame.Pc + 2;
                Jump LoopStart;
            }

            Record OpDecInt
            {
                int reg = [int](code[frame.Pc + 1]);
                If (kinds[reg] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                intRegisters[reg] = intRegisters[reg] - 1;
                frame.Pc = frame.Pc + 2;
                Jump LoopStart;
            }

            Record OpIntToFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = [float](intRegisters[src]);
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpUIntToFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (frame.Kinds[src] != [int](Bytecode.ValueKind.Int)) Throw "Expected int register";
                frame.FloatRegisters[dst] = [float]([u64](frame.IntRegisters[src]));
                frame.Kinds[dst] = [int](Bytecode.ValueKind.Float);
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpFloatToF32
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = [float]([f32](floatRegisters[src]));
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpIntToF32
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                int unsignedFlag = [int](code[frame.Pc + 3]);
                If (kinds[src] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                If (unsignedFlag != 0 && unsignedFlag != 1)
                {
                    Throw "Unsupported IntToF32 signedness: " + [string](unsignedFlag);
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                If (unsignedFlag == 0)
                {
                    floatRegisters[dst] = [float]([f32](intRegisters[src]));
                }
                Else
                {
                    floatRegisters[dst] = [float]([f32]([u64](intRegisters[src])));
                }
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpFloatToInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                intRegisters[dst] = [int](floatRegisters[src]);
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpFloatToString
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.String);
                stringRegisters[dst] = [string](floatRegisters[src]);
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpStringToFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.String))
                {
                    Throw "Expected string register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                floatRegisters[dst] = [float](stringRegisters[src]);
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpBoolToInt
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Bool))
                {
                    Throw "Expected bool register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Int);
                If (boolRegisters[src])
                {
                    intRegisters[dst] = 1;
                }
                Else
                {
                    intRegisters[dst] = 0;
                }
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpBoolToFloat
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Bool))
                {
                    Throw "Expected bool register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Float);
                If (boolRegisters[src])
                {
                    floatRegisters[dst] = 1.0;
                }
                Else
                {
                    floatRegisters[dst] = 0.0;
                }
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpFloatToBool
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                If (kinds[src] != [int](Bytecode.ValueKind.Float))
                {
                    Throw "Expected float register";
                }
                kinds[dst] = [int](Bytecode.ValueKind.Bool);
                boolRegisters[dst] = floatRegisters[src] != 0.0;
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpCallBuiltin
            {
                int pc = frame.Pc;
                registry.Invoke(
                    ctx,
                    Bytecode.Program.ReadU16(code, frame.Pc + 2),
                    [int](code[frame.Pc + 1]),
                    [int](code[frame.Pc + 5]),
                    [int](code[frame.Pc + 6]),
                    [int](code[frame.Pc + 7]),
                    [int](code[frame.Pc + 8])
                );
                If (frame.Pc == pc) frame.Pc = pc + 9;
                Jump HeapSafePoint;
            }

            Record OpCallRange
            {
                If (frame.Pc + 7 > code.Length()) Throw "Truncated CallRange";
                int kind = [int](code[frame.Pc + 2]);
                int target = Bytecode.Program.ReadU16(code, frame.Pc + 3);
                int dst = [int](code[frame.Pc + 1]);
                int first = [int](code[frame.Pc + 5]);
                int count = [int](code[frame.Pc + 6]);
                If (kind == 3)
                {
                    int pc = frame.Pc;
                    registry.InvokeRange(ctx, target, dst, first, count);
                    If (frame.Pc == pc) frame.Pc = pc + 7;
                }
                Else ctx.PushRangeCall(frame, kind, target, dst, first, count);
                Jump HeapSafePoint;
            }

            Record OpCallFunc
            {
                int nextPc = frame.Pc + 9;
                ctx.PushCall(
                    Bytecode.Program.ReadU16(code, frame.Pc + 2),
                    -1,
                    nextPc,
                    [int](code[frame.Pc + 1]),
                    frame,
                    [int](code[frame.Pc + 4]),
                    [int](code[frame.Pc + 5]),
                    [int](code[frame.Pc + 6]),
                    [int](code[frame.Pc + 7]),
                    [int](code[frame.Pc + 8])
                );
                Jump EnterFrame;
            }

            Record OpNewObject
            {
                int dst = [int](code[frame.Pc + 1]);
                int handle = ctx.NewObject(Bytecode.Program.ReadU16(code, frame.Pc + 2));
                kinds[dst] = [int](Bytecode.ValueKind.Object);
                intRegisters[dst] = handle;
                frame.Pc = frame.Pc + 4;
                Jump HeapSafePoint;
            }

            Record OpNewArray
            {
                int handle = ctx.NewArray(
                    frame.GetInt([int](code[frame.Pc + 2])),
                    [int](code[frame.Pc + 3])
                );
                int dst = [int](code[frame.Pc + 1]);
                kinds[dst] = [int](Bytecode.ValueKind.Array);
                intRegisters[dst] = handle;
                frame.Pc = frame.Pc + 4;
                Jump HeapSafePoint;
            }

            Record OpLoadField
            {
                int dst = [int](code[frame.Pc + 1]);
                int field = [int](code[frame.Pc + 3]) | ([int](code[frame.Pc + 4]) << 8);
                Context.VMValue value = ctx.ObjectGetValue(intRegisters[[int](code[frame.Pc + 2])], field);
                int kind = value.Kind;
                If (kind == [int](Bytecode.ValueKind.Int) || kind == [int](Bytecode.ValueKind.Object))
                {
                    kinds[dst] = kind;
                    intRegisters[dst] = value.IntValue;
                }
                Else frame.ImportValue(dst, value);
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpStoreField
            {
                int field = [int](code[frame.Pc + 3]) | ([int](code[frame.Pc + 4]) << 8);
                ctx.ObjectSetValue(intRegisters[[int](code[frame.Pc + 1])], field,
                    frame.ExportValue([int](code[frame.Pc + 2])));
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpLoadIndex
            {
                int dst = [int](code[frame.Pc + 1]);
                int recv = [int](code[frame.Pc + 2]);
                int indexReg = [int](code[frame.Pc + 3]);
                int recvKind = kinds[recv];
                int index;

                If (kinds[indexReg] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                index = intRegisters[indexReg];

                If (recvKind == [int](Bytecode.ValueKind.String))
                {
                    string text = stringRegisters[recv];
                    kinds[dst] = [int](Bytecode.ValueKind.Char);
                    intRegisters[dst] = [int](text[index]);
                }
                Else
                {
                    int handle = intRegisters[recv];
                    Context.HeapArray arr = ctx.RequireArray(handle);
                    int elementKind = arr.ElementKind;
                    If (elementKind == [int](Bytecode.ValueKind.Int) || elementKind == [int](Bytecode.ValueKind.Char))
                    {
                        If (index < 0 || index >= arr.Length) Throw "Array index out of range";
                        kinds[dst] = elementKind;
                        intRegisters[dst] = ([int*](arr.RawBuffer))[index];
                    }
                    Else
                    {
                        arr.LoadIntoFrame(index, frame, dst);
                    }
                }
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpStoreIndex
            {
                int recv = [int](code[frame.Pc + 1]);
                int indexReg = [int](code[frame.Pc + 2]);
                int src = [int](code[frame.Pc + 3]);
                int handle = intRegisters[recv];
                int index;

                If (kinds[indexReg] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "Expected int register";
                }
                index = intRegisters[indexReg];

                Context.HeapArray arr = ctx.RequireArray(handle);
                If (arr.ElementKind == [int](Bytecode.ValueKind.Int))
                {
                    If (index < 0 || index >= arr.Length)
                    {
                        Throw "Array index out of range";
                    }
                    If (kinds[src] == [int](Bytecode.RegisterKind.CaptureCell)) arr.CaptureEnvironment = true;
                    Else If (kinds[src] != [int](Bytecode.ValueKind.Int))
                    {
                        Throw "Expected int register at r" + [string](src);
                    }
                    ([int*](arr.RawBuffer))[index] = intRegisters[src];
                }
                Else If (arr.ElementKind == [int](Bytecode.ValueKind.Char))
                {
                    If (index < 0 || index >= arr.Length)
                    {
                        Throw "Array index out of range";
                    }
                    If (kinds[src] != [int](Bytecode.ValueKind.Char))
                    {
                        Throw "Expected char register at r" + [string](src);
                    }
                    ([int*](arr.RawBuffer))[index] = intRegisters[src];
                }
                Else
                {
                    arr.StoreFromFrame(index, frame, src);
                }
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpArrayLength
            {
                frame.SetInt(
                    [int](code[frame.Pc + 1]),
                    ctx.ArrayLengthOf(frame.IntRegisters[[int](code[frame.Pc + 2])])
                );
                frame.Pc = frame.Pc + 3;
                Jump LoopStart;
            }

            Record OpArrayAdd
            {
                int handle = ctx.ArrayAddFromFrame(
                    frame.IntRegisters[[int](code[frame.Pc + 2])],
                    frame,
                    [int](code[frame.Pc + 3])
                );
                frame.ImportValue([int](code[frame.Pc + 1]), Context.VMValue.FromArray(handle));
                frame.Pc = frame.Pc + 4;
                Jump HeapSafePoint;
            }

            Record OpCallVirt
            {
                int nextPc = frame.Pc + 9;
                int recv = [int](code[frame.Pc + 2]);
                int functionIndex = ctx.ResolveVirtualFunction(
                    frame.IntRegisters[recv],
                    Bytecode.Program.ReadU16(code, frame.Pc + 3)
                );
                ctx.PushCall(
                    functionIndex,
                    -1,
                    nextPc,
                    [int](code[frame.Pc + 1]),
                    frame,
                    [int](code[frame.Pc + 5]) + 1,
                    recv,
                    [int](code[frame.Pc + 6]),
                    [int](code[frame.Pc + 7]),
                    [int](code[frame.Pc + 8])
                );
                Jump EnterFrame;
            }

            Record OpIsType
            {
                int dst = [int](code[frame.Pc + 1]);
                int src = [int](code[frame.Pc + 2]);
                int targetKind = [int](code[frame.Pc + 3]);
                int targetPayload = Bytecode.Program.ReadU16(code, frame.Pc + 4);
                bool result = false;

                result = Switch(targetKind)
                {
                    Case([int](Bytecode.IsTargetKind.Bool))   { frame.Kinds[src] == [int](Bytecode.ValueKind.Bool) }
                    Case([int](Bytecode.IsTargetKind.Char))   { frame.Kinds[src] == [int](Bytecode.ValueKind.Char) }
                    Case([int](Bytecode.IsTargetKind.Int))    { frame.Kinds[src] == [int](Bytecode.ValueKind.Int) }
                    Case([int](Bytecode.IsTargetKind.Float))  { frame.Kinds[src] == [int](Bytecode.ValueKind.Float) }
                    Case([int](Bytecode.IsTargetKind.String)) { frame.Kinds[src] == [int](Bytecode.ValueKind.String) }
                    Case([int](Bytecode.IsTargetKind.Type))
                    {
                        frame.Kinds[src] == [int](Bytecode.ValueKind.Object) &&
                        ctx.ObjectIsType(frame.IntRegisters[src], targetPayload)
                    }
                    Case(default) { false }
                };

                frame.SetBool(dst, result);
                frame.Pc = frame.Pc + 6;
                Jump LoopStart;
            }

            Record OpLoadGlobal
            {
                int slot = Bytecode.Program.ReadU16(code, frame.Pc + 2);
                frame.ImportValue([int](code[frame.Pc + 1]), ctx.GetGlobalValue(slot));
                frame.Pc = frame.Pc + 4;
                Jump LoopStart;
            }

            Record OpStoreGlobal
            {
                int slot = Bytecode.Program.ReadU16(code, frame.Pc + 2);
                ctx.SetGlobalValue(slot, frame.ExportValue([int](code[frame.Pc + 1])));

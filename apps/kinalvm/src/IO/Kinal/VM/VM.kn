                        sumValue = sumValue + raw[counterValue];
                        counterValue = counterValue + 1;
                    }
                }
                Else
                {
                    While (counterValue < limitValue)
                    {
                        If (counterValue < 0 || counterValue >= arrayLength)
                        {
                            Throw "Array index out of range";
                        }
                        sumValue = sumValue + raw[counterValue];
                        counterValue = counterValue + 1;
                    }
                }
                kinds[sumReg] = [int](Bytecode.ValueKind.Int);
                intRegisters[sumReg] = sumValue;
                intRegisters[counterReg] = counterValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }

            Record OpLoopArraySumIntLeInc
            {
                int sumReg = [int](code[frame.Pc + 1]);
                int arrayReg = [int](code[frame.Pc + 2]);
                int counterReg = [int](code[frame.Pc + 3]);
                int limitReg = [int](code[frame.Pc + 4]);
                int handle;
                Context.HeapArray arr;
                int sumValue;
                int counterValue;
                int limitValue;
                int arrayLength;
                int* raw;
                If (kinds[sumReg] != [int](Bytecode.ValueKind.Int) ||
                    kinds[arrayReg] != [int](Bytecode.ValueKind.Array) ||
                    kinds[counterReg] != [int](Bytecode.ValueKind.Int) ||
                    kinds[limitReg] != [int](Bytecode.ValueKind.Int))
                {
                    Throw "LoopArraySumIntLeInc requires int/array registers";
                }
                handle = intRegisters[arrayReg];
                arr = ctx.RequireArray(handle);
                If (arr.ElementKind != [int](Bytecode.ValueKind.Int))
                {
                    Throw "LoopArraySumIntLeInc requires int arrays";
                }
                sumValue = intRegisters[sumReg];
                counterValue = intRegisters[counterReg];
                limitValue = intRegisters[limitReg];
                arrayLength = arr.Length;
                raw = [int*](arr.RawBuffer);
                If (counterValue >= 0 && limitValue < arrayLength)
                {
                    While (counterValue <= limitValue)
                    {
                        sumValue = sumValue + raw[counterValue];
                        counterValue = counterValue + 1;
                    }
                }
                Else
                {
                    While (counterValue <= limitValue)
                    {
                        If (counterValue < 0 || counterValue >= arrayLength)
                        {
                            Throw "Array index out of range";
                        }
                        sumValue = sumValue + raw[counterValue];
                        counterValue = counterValue + 1;
                    }
                }
                kinds[sumReg] = [int](Bytecode.ValueKind.Int);
                intRegisters[sumReg] = sumValue;
                intRegisters[counterReg] = counterValue;
                frame.Pc = frame.Pc + 5;
                Jump LoopStart;
            }


Static Function void SetStringList(Context.ExecutionContext ctx, int dst, list strings)
{
    int handle = ctx.NewList();
    Context.HeapList values = [Context.HeapList](ctx.ObjectAt(handle));
    int count = strings.Count();
    For (int i = 0; i < count; i++)
        values.Append(Context.VMValue.FromString([string](strings.Fetch(i))));
    ctx.Heap.RecordAllocation(count * 48);
    ctx.CurrentFrame().ImportValue(dst, Context.VMValue.FromObject(handle));
}


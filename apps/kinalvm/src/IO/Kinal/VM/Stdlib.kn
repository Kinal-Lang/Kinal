Static Function int CalendarField(Context.ExecutionContext ctx, int handle, int slot)
{
    Context.VMValue field = ctx.ObjectGetValue(handle, slot);
    If (field.Kind == [int](Bytecode.ValueKind.Null)) Return 0;
    If (field.Kind != [int](Bytecode.ValueKind.Int)) Throw "Expected integer DateTime field";
    Return field.IntValue;
}

[VmBuiltin(18, "IO.Time.Format")]
Static Function void BuiltinTimeFormat(Context.ExecutionContext ctx, int dst, int a0, int a1, int a2, int a3)
{
    Time.DateTime value = null;
    If (ctx.KindAt(a0) != [int](Bytecode.ValueKind.Null))
    {
        int handle = ctx.CurrentFrame().IntRegisters[a0];
        If (ctx.KindAt(a0) != [int](Bytecode.ValueKind.Object) || !ctx.ObjectIsType(handle, ctx.FindTypeByName("IO.Time.DateTime")))
            Throw "Expected IO.Time.DateTime";
        value = New Time.DateTime();
        value.Year = CalendarField(ctx, handle, 1);
        value.Month = CalendarField(ctx, handle, 2);
        value.Day = CalendarField(ctx, handle, 3);
        value.Hour = CalendarField(ctx, handle, 4);
        value.Minute = CalendarField(ctx, handle, 5);
        value.Second = CalendarField(ctx, handle, 6);
        value.Millisecond = CalendarField(ctx, handle, 7);
    }
    ctx.SetString(dst, Time.Format(value, ctx.CurrentFrame().GetNullableString(a1)));
}


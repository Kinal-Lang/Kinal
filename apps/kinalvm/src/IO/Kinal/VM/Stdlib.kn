[VmBuiltin(289, "IO.Text.Builder.EnsureCapacity")]
Static Trusted Function void BuiltinTextBuilderReserve(Context.ExecutionContext ctx, int dst, int a0, int a1, int a2, int a3)
{
    Text.Builder builder = ctx.TextBuilderAt(a0);
    int capacity = builder.Capacity;
    Try { builder.EnsureCapacity(ctx.GetInt(a1)); }
    Catch (IO.Error error) { ctx.RaiseHostError(error); Return; }
    If (builder.Capacity != capacity) ctx.Heap.RecordAllocation(builder.Capacity);
}


// KNC stores instance fields in declaration order (IO.Time.DateTime in IO.Core).
[VmBuiltin(14, "IO.Time.Now")]
Static Function void BuiltinTimeNow(Context.ExecutionContext ctx, int dst, int a0, int a1, int a2, int a3)
{
    Time.DateTime value = Time.Now();
    int handle = ctx.NewObject(ctx.FindTypeByName("IO.Time.DateTime"));
    ctx.ObjectSetValue(handle, 0, Context.VMValue.FromInt(value.Ticks));
    ctx.ObjectSetValue(handle, 1, Context.VMValue.FromInt(value.Year));
    ctx.ObjectSetValue(handle, 2, Context.VMValue.FromInt(value.Month));
    ctx.ObjectSetValue(handle, 3, Context.VMValue.FromInt(value.Day));
    ctx.ObjectSetValue(handle, 4, Context.VMValue.FromInt(value.Hour));
    ctx.ObjectSetValue(handle, 5, Context.VMValue.FromInt(value.Minute));
    ctx.ObjectSetValue(handle, 6, Context.VMValue.FromInt(value.Second));
    ctx.ObjectSetValue(handle, 7, Context.VMValue.FromInt(value.Millisecond));
    ctx.CurrentFrame().ImportValue(dst, Context.VMValue.FromObject(handle));
}


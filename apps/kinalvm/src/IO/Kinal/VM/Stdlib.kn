Static Function void ReadListItem(Context.ExecutionContext ctx, int dst, Context.HeapList values, int index, int fallback)
{
    Context.FunctionFrame frame = ctx.CurrentFrame();
    If (values != null && index >= 0 && index < values.Count) frame.ImportValue(dst, values.ValueAt(index));
    ElseIf (fallback >= 0) frame.CopyValue(dst, fallback);
    Else frame.SetNull(dst);
}


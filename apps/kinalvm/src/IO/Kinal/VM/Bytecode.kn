    Halt,
    MakeFunc,
    CallClosure,
    NewCell,
    LoadCell,
    StoreCell,
    LoadCapture,
    StoreCapture,
    LoadCaptureCell,
    PushTry,
    PopTry,
    ThrowOp,
    MakePtrLocal,
    MakePtrGlobal,
    MakePtrIndex,
    MakePtrField,
    MakePtrFunc,
    MakePtrCell,

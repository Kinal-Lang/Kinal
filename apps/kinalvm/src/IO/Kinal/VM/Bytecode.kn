    StorePtr,
    AddPtr,
    LoopIntLtInc,
    LoopIntLeInc,
    LoopIntGtDec,
    LoopIntGeDec,
    LoopIntEqInc,
    LoopIntNeInc,
    LoopIntEqDec,
    LoopIntNeDec,
    JumpIfIntLtFalse,
    JumpIfIntLeFalse,
    JumpIfIntGtFalse,
    JumpIfIntGeFalse,
    JumpIfIntEqFalse,
    JumpIfIntNeFalse,
    IncInt,
    DecInt,
    IntToFloat,
    FloatToInt,
    FloatToString,
    StringToFloat,
    BoolToInt,
    BoolToFloat,
    FloatToBool,
    LoopBackIntLtInc,
    LoopBackIntLeInc,
    LoopBackIntGtDec,
    LoopBackIntGeDec,
    LoopBackIntEqInc,
    LoopBackIntNeInc,
    LoopBackIntEqDec,
    LoopBackIntNeDec,
    LoopArrayFillIntLtInc,
    LoopArrayFillIntLeInc,
    LoopArraySumIntLtInc,
    LoopArraySumIntLeInc,
    LoopSumIntLtInc,
    LoopSumIntLeInc,
    AddIntImm,
    SubIntImm,
    MulIntImm,
    DivIntImm,
    LtIntImm,
    LeIntImm,
    GtIntImm,
    GeIntImm,
    BitAndIntImm,
    BitOrIntImm,
    BitXorIntImm,
    ShlIntImm,
    ShrIntImm,
    UDivInt = 130,
    URemInt = 131,
    ULtInt = 132,
    ULeInt = 133,
    UGtInt = 134,
    UGeInt = 135,
    LShrInt = 136,
    FloatToF32 = 137,
    IntToF32 = 138,
    CallRange = 139,
    UIntToFloat = 140
}

Enum ValueKind By u8
{
    Null,
    Int,
    Float,
    Bool,
    String,
    Char,
    Array,
    Object,
    Pointer
}

// Capture cells are internal register values, outside the serialized ValueKind range.
Enum RegisterKind By u8
{
    CaptureCell = 9
}

Enum PointerKind By u8
{
    FrameReg,
    Global,
    ArrayElem,
    ObjectField,
    Func,
    StringChar,
    Cell,
    HostHandle
}

Public Class TypeInfo
{
    Public int Kind;
    Public int FieldCount;
    Public int BaseType;
    Public string Name;
    Public int[] VTable;
    Public int[] InterfaceTypes;

    Public Constructor()
    {
        This.Kind = 0;
        This.FieldCount = 0;
        This.BaseType = -1;
        This.Name = "";
        This.VTable = {};
        This.InterfaceTypes = {};
    }
}

Enum IsTargetKind By u8
{
    Any,
    Bool,
    Char,
    Int,
    Float,
    String,
    Type
}


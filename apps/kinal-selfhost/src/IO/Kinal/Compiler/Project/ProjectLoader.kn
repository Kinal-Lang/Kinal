Unit IO.Kinal.Compiler.Project.ProjectLoader;

Get IO.Text;
Get IO.File;
Get IO.Path;
Get IO.Kinal.Compiler.Project.PackageManifest;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Lex.Lexer;
Get IO.Kinal.Compiler.Lex.Token;
Get IO.Kinal.Compiler.Lex.TokenKind;
Get IO.Kinal.Compiler.Project.ProjectConfig;

Class ProjectReader
{
    Public SourceFile Source;
    Public list Tokens;
    Public list Diagnostics;
    Public int Position;

    Public Safe Constructor(string manifestPath, list diagnostics)
    {
        This.Source = IO.Kinal.Compiler.Source.SourceFile.Load(manifestPath);
        This.Diagnostics = diagnostics;
        This.Tokens = IO.Kinal.Compiler.Lex.Lexer.Tokenize(This.Source, diagnostics);
        This.Position = 0;
    }

    Public Safe Function Token RawToken()
    {
        If (This.Position < 0 || This.Position >= This.Tokens.Count()) Return null;
        Return [Token](This.Tokens.Fetch(This.Position));
    }

    Public Safe Function TokenKind Kind()
    {
        Return IO.Kinal.Compiler.Lex.Token.Kind(This.RawToken());
    }

    Public Safe Function string Text()
    {
        Return IO.Kinal.Compiler.Lex.Token.Text(This.RawToken());
    }

    Public Safe Function bool AtEnd()
    {
        Return This.Kind() == TokenKind.Eof;
    }

    Public Safe Function void Advance()
    {
        If (This.Position < This.Tokens.Count()) This.Position = This.Position + 1;
    }

    Public Safe Function bool MatchKind(TokenKind kind)
    {
        If (This.Kind() != kind) Return false;
        This.Advance();
        Return true;
    }

    Public Safe Function bool MatchText(string text)
    {
        If (IO.Text.ToLower(This.Text()) != IO.Text.ToLower(text)) Return false;
        This.Advance();
        Return true;
    }

    Public Safe Function void Report(string title, string detail)
    {
        Token token = This.RawToken();
        int length = IO.Text.Length(This.Text());
        If (length < 1) length = 1;
        IO.Kinal.Compiler.Core.Diagnostics.Add(This.Diagnostics, This.Source, "Project", title, detail,
            IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token), length);
    }

    Public Safe Function bool ExpectKind(TokenKind kind, string title, string detail)
    {
        If (This.MatchKind(kind)) Return true;
        This.Report(title, detail);
        Return false;
    }

    Public Safe Function bool ExpectText(string text, string title, string detail)
    {
        If (This.MatchText(text)) Return true;
        This.Report(title, detail);
        Return false;
    }

    Public Safe Function string DecodeString(string raw)
    {
        char[] chars = raw.ToChars();
        If (chars.Length() < 2 || [int](chars[0]) != 34) Return raw;
        string result = "";
        int i = 1;
        While (i < chars.Length() - 1)
        {
            char value = chars[i];
            If ([int](value) == 92 && i + 1 < chars.Length() - 1)
            {
                i = i + 1;
                value = chars[i];
                If ([int](value) == 110) value = [char](10);
                ElseIf ([int](value) == 114) value = [char](13);
                ElseIf ([int](value) == 116) value = [char](9);
            }
            result = result + [string](value);
            i = i + 1;
        }
        Return result;
    }

    Public Safe Function string ReadScalar()
    {
        string value = This.Text();
        If (This.Kind() == TokenKind.String) value = This.DecodeString(value);
        This.Advance();
        Return value;
    }

    Public Safe Function list ReadList()
    {
        list values = list.Create();
        If (!This.ExpectKind(TokenKind.LeftBracket, "Expected '['", "list value must start with '['"))
        {
            Return values;
        }
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBracket)
        {
            values.Add(This.ReadScalar());
            If (!This.MatchKind(TokenKind.Comma)) Break;
        }
        This.ExpectKind(TokenKind.RightBracket, "Expected ']'", "list value is not closed");
        Return values;
    }

    Public Safe Function void CopyList(list destination, list source)
    {
        int i = 0;
        While (i < source.Count())
        {
            destination.Add(source.Fetch(i));
            i = i + 1;
        }
    }

    Public Safe Function string ReadScalarAssignment()
    {
        If (!This.ExpectKind(TokenKind.Assign, "Expected '='", "field requires an assignment")) Return "";
        string value = This.ReadScalar();
        This.ExpectKind(TokenKind.Semicolon, "Expected ';'", "field assignment must end with ';'");
        Return value;
    }

    Public Safe Function bool ReadBooleanAssignment(string field)
    {
        string value = IO.Text.ToLower(This.ReadScalarAssignment());
        If (value == "true") Return true;
        If (value == "false") Return false;
        This.Report("Invalid Boolean", field + " requires true or false");
        Return false;
    }

    Public Safe Function list ReadListAssignment()
    {
        If (!This.ExpectKind(TokenKind.Assign, "Expected '='", "field requires an assignment"))
        {
            Return list.Create();
        }
        list value = This.ReadList();
        This.ExpectKind(TokenKind.Semicolon, "Expected ';'", "field assignment must end with ';'");
        Return value;
    }

    Public Safe Function void SkipBlock()
    {
        If (!This.MatchKind(TokenKind.LeftBrace)) Return;
        int depth = 1;
        While (!This.AtEnd() && depth > 0)
        {
            If (This.Kind() == TokenKind.LeftBrace) depth = depth + 1;
            ElseIf (This.Kind() == TokenKind.RightBrace) depth = depth - 1;
            This.Advance();
        }
    }

    Public Safe Function void SkipUnknownField()
    {
        If (This.Kind() == TokenKind.LeftBrace)
        {
            This.SkipBlock();
            Return;
        }
        If (!This.MatchKind(TokenKind.Assign))
        {
            This.Advance();
            Return;
        }
        If (This.Kind() == TokenKind.LeftBracket)
        {
            This.ReadList();
        }
        Else
        {
            This.Advance();
        }
        This.MatchKind(TokenKind.Semicolon);
    }

    Public Safe Function void RejectUnknownField(string scope, string field)
    {
        This.Report("Unknown Field", scope + "." + field);
        This.SkipUnknownField();
    }

    Public Safe Function void ReadPackages(list roots, list officialRoots)
    {
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'",
                             "Packages body is missing")) Return;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "roots")
                This.CopyList(roots, This.ReadListAssignment());
            ElseIf (field == "officialroots")
                This.CopyList(officialRoots, This.ReadListAssignment());
            Else This.RejectUnknownField("Packages", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'",
            "Packages body is not closed");
    }

    Public Safe Function void ReadWorkspace(ProjectConfig project)
    {
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'",
                             "Workspace body is missing")) Return;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "ignore")
                This.CopyList(project.WorkspaceIgnores, This.ReadListAssignment());
            Else This.RejectUnknownField("Workspace", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'",
            "Workspace body is not closed");
    }

    Public Safe Function void ReadLsp()
    {
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'",
                             "Lsp body is missing")) Return;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "profile") This.ReadScalarAssignment();
            ElseIf (field == "extrasets") This.ReadListAssignment();
            ElseIf (field == "strictprojectscope")
                This.ReadBooleanAssignment("Lsp.StrictProjectScope");
            Else This.RejectUnknownField("Lsp", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'",
            "Lsp body is not closed");
    }

    Public Safe Function SourceSetConfig ReadSourceSet()
    {
        string name = This.ReadScalar();
        SourceSetConfig sourceSet = New SourceSetConfig(name);
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'", "SourceSet body is missing")) Return sourceSet;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "roots") This.CopyList(sourceSet.Roots, This.ReadListAssignment());
            ElseIf (field == "files") This.CopyList(sourceSet.Files, This.ReadListAssignment());
            ElseIf (field == "include") This.CopyList(sourceSet.Includes, This.ReadListAssignment());
            ElseIf (field == "exclude") This.CopyList(sourceSet.Excludes, This.ReadListAssignment());
            ElseIf (field == "requireunit")
                sourceSet.RequireUnit = This.ReadBooleanAssignment("SourceSet.RequireUnit");
            Else This.RejectUnknownField("SourceSet", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'", "SourceSet body is not closed");
        Return sourceSet;
    }

    Public Safe Function void ReadProfileSource(ProjectProfileConfig profile)
    {
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'", "Source body is missing")) Return;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "entry") profile.Entry = This.ReadScalarAssignment();
            ElseIf (field == "sets") This.CopyList(profile.Sets, This.ReadListAssignment());
            ElseIf (field == "mode") profile.Mode = This.ReadScalarAssignment();
            ElseIf (field == "autodiscovery")
                profile.AutoDiscovery = This.ReadBooleanAssignment("Source.AutoDiscovery");
            Else This.RejectUnknownField("Source", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'", "Source body is not closed");
    }

    Public Safe Function void ReadProfileBuild(ProjectProfileConfig profile)
    {
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'", "Build body is missing")) Return;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "backend")
            {
                profile.Backend = This.ReadScalarAssignment();
                profile.BackendExplicit = true;
            }
            ElseIf (field == "environment") { profile.Environment = This.ReadScalarAssignment(); profile.EnvironmentExplicit = true; }
            ElseIf (field == "runtime") { profile.Runtime = This.ReadScalarAssignment(); profile.RuntimeExplicit = true; }
            ElseIf (field == "panic") { profile.Panic = This.ReadScalarAssignment(); profile.PanicExplicit = true; }
            ElseIf (field == "target") profile.Target = This.ReadScalarAssignment();
            ElseIf (field == "output") profile.Output = This.ReadScalarAssignment();
            ElseIf (field == "entrysymbol") profile.EntrySymbol = This.ReadScalarAssignment();
            ElseIf (field == "linker") profile.Linker = IO.Text.ToLower(This.ReadScalarAssignment());
            ElseIf (field == "linkerpath") profile.LinkerPath = This.ReadScalarAssignment();
            ElseIf (field == "superloop") { profile.Superloop = This.ReadBooleanAssignment("Build.Superloop"); profile.SuperloopExplicit = true; }
            Else This.RejectUnknownField("Build", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'", "Build body is not closed");
    }

    Public Safe Function void ReadProfileLink(ProjectProfileConfig profile)
    {
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'", "Link body is missing")) Return;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "script") profile.LinkScript = This.ReadScalarAssignment();
            ElseIf (field == "nocrt")
                profile.NoCRT = This.ReadBooleanAssignment("Link.NoCRT");
            ElseIf (field == "nodefaultlibs")
                profile.NoDefaultLibs = This.ReadBooleanAssignment("Link.NoDefaultLibs");
            ElseIf (field == "libdirs") This.CopyList(profile.LibDirs, This.ReadListAssignment());
            ElseIf (field == "libs") This.CopyList(profile.Libs, This.ReadListAssignment());
            ElseIf (field == "linkfiles") This.CopyList(profile.LinkFiles, This.ReadListAssignment());
            ElseIf (field == "linkargs") This.CopyList(profile.LinkArgs, This.ReadListAssignment());
            ElseIf (field == "linkroots") This.CopyList(profile.LinkRoots, This.ReadListAssignment());
            Else This.RejectUnknownField("Link", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'", "Link body is not closed");
    }


    Public Safe Function ProjectProfileConfig ReadProfile()
    {
        ProjectProfileConfig profile = New ProjectProfileConfig(This.ReadScalar());
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'", "Profile body is missing")) Return profile;
        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string section = IO.Text.ToLower(This.Text());
            This.Advance();
            If (section == "source") This.ReadProfileSource(profile);
            ElseIf (section == "build") This.ReadProfileBuild(profile);
            ElseIf (section == "link") This.ReadProfileLink(profile);
            ElseIf (section == "packages")
                This.ReadPackages(profile.PackageRoots, profile.OfficialPackageRoots);
            Else This.RejectUnknownField("Profile", section);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'", "Profile body is not closed");
        Return profile;
    }

    Public Safe Function ProjectConfig Read()
    {
        ProjectConfig project = New ProjectConfig(This.Source.Path);
        If (IO.Kinal.Compiler.Core.Diagnostics.HasAny(This.Diagnostics)) Return project;
        If (!This.ExpectText("Project", "Expected Project", "manifest must start with Project")) Return project;
        project.Name = This.ReadScalar();
        If (!This.ExpectKind(TokenKind.LeftBrace, "Expected '{'", "Project body is missing")) Return project;

        While (!This.AtEnd() && This.Kind() != TokenKind.RightBrace)
        {
            string field = IO.Text.ToLower(This.Text());
            This.Advance();
            If (field == "defaultprofile") project.DefaultProfile = This.ReadScalarAssignment();
            ElseIf (field == "sourceset") project.AddSourceSet(This.ReadSourceSet());
            ElseIf (field == "profile") project.AddProfile(This.ReadProfile());
            ElseIf (field == "packages")
                This.ReadPackages(project.PackageRoots, project.OfficialPackageRoots);
            ElseIf (field == "workspace") This.ReadWorkspace(project);
            ElseIf (field == "lsp") This.ReadLsp();
            Else This.RejectUnknownField("Project", field);
        }
        This.ExpectKind(TokenKind.RightBrace, "Expected '}'", "Project body is not closed");
        If (!This.AtEnd()) This.Report("Unexpected token", "unexpected token after project block");
        If (project.FirstProfile == null) This.Report("Missing profile", "project file must declare at least one profile");
        ElseIf (IO.Text.IsEmpty(project.DefaultProfile)) project.DefaultProfile = project.FirstProfile.Name;
        Return project;
    }
}

Safe Function ProjectConfig Load(string manifestPath, list diagnostics)
{
    If (IO.Text.ToLower(IO.Path.Extension(manifestPath)) != "knproj")
        Return LoadLegacy(manifestPath, diagnostics);
    ProjectReader reader = New ProjectReader(manifestPath, diagnostics);
    Return reader.Read();
}

// Legacy project JSON shares the bounded JSON reader with package manifests.
Safe Function ProjectConfig LoadLegacy(string path, list diagnostics)
{
    ProjectConfig project = New ProjectConfig(path);
    project.Name = IO.Path.BaseName(path);
    project.DefaultProfile = "legacy";
    project.IsLegacy = true;
    ProjectProfileConfig profile = New ProjectProfileConfig("legacy");
    project.AddProfile(profile);
    PackageJsonReader reader = New PackageJsonReader(IO.File.ReadAllText(path));
    string kind = "";
    If (!reader.Consume('{')) reader.Fail("project manifest must contain a JSON object");
    bool closed = reader.Consume('}');
    While (!closed && !reader.AtEnd() && IO.Text.IsEmpty(reader.Error))
    {
        string key = IO.Text.ToLower(reader.ReadString());
        If (!reader.Consume(':')) { reader.Fail("expected ':' after JSON field"); Break; }
        If (key == "kind") kind = reader.ReadString();
        ElseIf (key == "name") project.Name = reader.ReadString();
        ElseIf (key == "entry") profile.Entry = reader.ReadString();
        ElseIf (key == "out") profile.Output = reader.ReadString();
        ElseIf (key == "package_roots") project.PackageRoots = reader.ReadStringList();
        Else reader.SkipValue();
        If (reader.Consume('}')) closed = true;
        ElseIf (!reader.Consume(',')) reader.Fail("expected ',' or '}' in project manifest");
    }
    reader.SkipWhitespace();
    If (!closed) reader.Fail("unterminated project manifest");
    If (!reader.AtEnd()) reader.Fail("unexpected data after project manifest");
    If (IO.Text.ToLower(kind) != "project") reader.Fail("--project expects a project manifest");
    If (!IO.Text.IsEmpty(reader.Error))
        IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics,
            IO.Kinal.Compiler.Source.SourceFile.Load(path), "Project",
            "Invalid project manifest", reader.Error, 1, 1, 1);
    // Legacy manifests discover adjacent Unit files just like direct inputs.
    SourceSetConfig sources = New SourceSetConfig("legacy");
    sources.Roots.Add(IO.Path.Directory(profile.Entry));
    sources.RequireUnit = false;
    project.AddSourceSet(sources);
    Return project;
}

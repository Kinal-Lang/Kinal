Unit IO.Kinal.Compiler.Source.SourceManager;

Get IO.Path;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Source.SourcePath;

Class SourceEntry
{
    Public string Path;
    Public SourceFile Source;
    Public SourceEntry Next;

    Public Safe Constructor(string path, SourceFile source)
    {
        This.Path = path;
        This.Source = source;
        This.Next = null;
    }
}

Class SourceManager
{
    Public SourceEntry First;
    Private SourceEntry Last;
    Private dict ByPath;

    Public Safe Constructor()
    {
        This.First = null;
        This.ByPath = dict.Create();
    }

    Public Safe Function SourceFile Load(string path)
    {
        string normalized = IO.Kinal.Compiler.Source.SourcePath.Canonical(path);
        SourceFile existing = [SourceFile](This.ByPath.TryFetch(normalized, null));
        If (existing != null) Return existing;

        Return This.Remember(IO.Kinal.Compiler.Source.SourceFile.Load(normalized));
    }

    Public Safe Function SourceFile Remember(SourceFile source)
    {
        SourceEntry entry = New SourceEntry(source.Path, source);
        If (This.First == null) This.First = entry;
        Else This.Last.Next = entry;
        This.Last = entry;
        This.ByPath.Set(source.Path, source);
        Return source;
    }

    Public Safe Function int Count()
    {
        Return This.ByPath.Count();
    }
}

Unit IO.Kinal.Compiler.Driver.CliText;

// Generated from the original CLI by infra/scripts/sync_selfhost_cli_text.py.
// Keep original wording, whitespace and final newlines; --check detects drift.
Safe Function string Help(string command)
{
    If (command == "") Return "Kinal Compiler\nUsage:\n  kinal <subcommand> [options] [args...]\n  kinal build [options] <input file> [file2 ...]\n  kinal run [options] <file.kn> [-- program-args...]\n\nSubcommands:\n  build       Compile source files to native executables, objects, assembly, or IR\n  run         Compile a source file to a temporary native executable and run it\n  fmt         Format .kn source files\n  vm          Bytecode operations (build, run, disasm, pack)\n  pkg         Package management (build, info, unpack)\n\nBuild quick reference:\nOutput:\n  -o, --output <file>  Output file path\n  --emit <bin|obj|asm|ir|check|tokens|ast>  Output kind (default: bin)\n  --kind <exe|static|shared>  Output artifact kind (link mode only)\n\nTarget:\n  --target <triple|alias>  Target triple (default: host)\n                     aliases: win86, win64, win-arm64, linux64, linux-arm64, bare64, bare-arm64\n  --freestanding    Shortcut for freestanding core mode on the host architecture\n  --env <hosted|freestanding>  Select execution environment\n  --runtime <none|alloc|gc>  Select freestanding runtime profile\n  --panic <trap|loop>  Freestanding panic behavior\n  --entry <symbol>   Override executable entry symbol (Main/KMain by default)\n\nProject:\n  --project <file|dir>  Build from kinal.knproj or a legacy project manifest\n  --profile <name>  Select a profile from kinal.knproj\n  --pkg-root <dir>  Add a local package root\n  --stdpkg-root <dir>  Add an official stdpkg root override\n\nLink:\n  --crt <auto|dynamic|static>  Hosted CRT selection (default: auto)\n  -L, --lib-dir <dir>  Add a library search directory\n  -l, --lib <name>    Link a library by name\n  --link-file <file>  Add an exact link input (.obj/.lib/.a)\n  --link-root <dir>   Expand a dependency root into target-specific search dirs\n  --link-arg <arg>    Pass one raw argument to the linker backend\n  --link-script <file>  Pass linker script to the freestanding linker\n  --no-crt          Do not link CRT startup objects\n  --no-default-libs Do not inject default platform libraries\n  --linker <lld|zig|msvc>  Select linker backend\n  --linker-path <file>  Explicit linker executable path (requires --linker)\n  --show-link      Print the final linker command\n  --show-link-search  Print expanded library search directories\n\nFrontend:\n  --no-module-discovery  Disable source/module auto-discovery\n  --keep-temps     Keep intermediate outputs generated for linking\n  --lto[=off|full|thin]  Enable link-time optimization (default: off)\n\nDiagnostics:\n  -h, --help       Show this help\n  --color <auto|always|never>  Diagnostic color mode\n  --lang <en|zh>   Diagnostic language\n  --locale-file <file>  External locale JSON map\n  --Werror         Treat warnings as errors\n  --warn-level <n> Warning level (0 disables warnings)\n\nDeveloper:\n  --dump-locale-en <file>  Export English locale template JSON\n  --trace          Print compile phase trace\n  --time           Print compile phase timing (ms)\n\nRun quick reference:\n  kinal run [options] <file.kn> [-- program-args...]\n  --no-module-discovery  Disable source/module auto-discovery\n  --project <file|dir>  Run from kinal.knproj or a legacy project manifest\n  --profile <name>  Select a profile from kinal.knproj\n  --keep-temps     Keep the temporary executable after execution\n  --pkg-root <dir>  Add a local package root\n  --stdpkg-root <dir>  Add an official stdpkg root override\n  --color <auto|always|never>  Diagnostic color mode\n  --lang <en|zh>   Diagnostic language\n  --locale-file <file>  External locale JSON map\n  --Werror         Treat warnings as errors\n  --warn-level <n> Warning level (0 disables warnings)\n  .knc files: use \"kinal vm run\" instead\n\nVM / package quick reference:\n  kinal vm build <file.kn> -o <file.knc>\n  kinal vm build --project <dir> --profile <name>\n  kinal vm run <file.kn|file.knc> [-- program-args...]\n  kinal vm disasm <file.knc>\n  kinal vm pack <file.kn|file.knc> -o <file>\n  kinal pkg build --manifest <file|dir> -o <file.klib>\n  kinal pkg info <file.klib>\n  kinal pkg unpack <file.klib> -o <dir>\n\nInput types:\n  .kn/.kinal/.fx   Full frontend compile\n  .ll/.s/.asm      Continue from intermediate and compile forward\n  .o/.obj          Continue from object and link\n  .knc             Use \"kinal vm run\", \"kinal vm disasm\", or \"kinal vm pack\"\n\nUse \"kinal <subcommand> --help\" for detailed subcommand help.\n";
    If (command == "build") Return "Usage: kinal build [options] <file.kn> [file2.kn ...]\n\nCompile source files to native executables, objects, assembly, or LLVM IR.\n\nOutput:\n  -o, --output <file>  Output file path\n  --emit <bin|obj|asm|ir|check|tokens|ast>  Output kind (default: bin)\n  --kind <exe|static|shared>  Output artifact kind (link mode only)\n\nTarget:\n  --target <triple|alias>  Target triple (default: host)\n                     aliases: win86, win64, linux64, linux-arm64, bare64, bare-arm64\n  --freestanding    Shortcut for freestanding core mode on the host architecture\n  --env <hosted|freestanding>  Select execution environment\n  --runtime <none|alloc|gc>  Select freestanding runtime profile\n  --panic <trap|loop>  Freestanding panic behavior\n  --entry <symbol>   Override executable entry symbol (Main/KMain by default)\n\nProject:\n  --project <file|dir>  Build from kinal.knproj or a legacy project manifest\n  --profile <name>  Select a profile from kinal.knproj\n  --pkg-root <dir>  Add a local package root\n  --stdpkg-root <dir>  Add an official stdpkg root override\n\nLink:\n  --crt <auto|dynamic|static>  Hosted CRT selection (default: auto)\n  -L, --lib-dir <dir>  Add a library search directory\n  -l, --lib <name>    Link a library by name\n  --link-file <file>  Add an exact link input (.obj/.lib/.a)\n  --link-root <dir>   Expand a dependency root into target-specific search dirs\n  --link-arg <arg>    Pass one raw argument to the linker backend\n  --link-script <file>  Pass linker script to the freestanding linker\n  --no-crt          Do not link CRT startup objects\n  --no-default-libs Do not inject default platform libraries\n  --linker <lld|zig|msvc>  Select linker backend\n  --linker-path <file>  Explicit linker executable path (requires --linker)\n  --show-link      Print the final linker command\n  --show-link-search  Print expanded library search directories\n\nFrontend:\n  --no-module-discovery  Disable source/module auto-discovery\n  --keep-temps     Keep intermediate outputs generated for linking\n  --lto[=off|full|thin]  Enable link-time optimization (default: off)\n\nDiagnostics:\n  --color <auto|always|never>  Diagnostic color mode\n  --lang <en|zh>   Diagnostic language\n  --locale-file <file>  External locale JSON map\n  --Werror         Treat warnings as errors\n  --warn-level <n> Warning level (0 disables warnings)\n\nDeveloper:\n  --dump-locale-en <file>  Export English locale template JSON\n  --trace          Print compile phase trace\n  --time           Print compile phase timing (ms)\n";
    If (command == "run") Return "Usage: kinal run [options] <file.kn> [-- program-args...]\n\nCompile a source file to a native executable and run it immediately.\nThe temporary executable is removed after the program exits.\n\nOptions:\n  --no-module-discovery  Disable source/module auto-discovery\n  --project <file|dir>  Run from kinal.knproj or a legacy project manifest\n  --profile <name>  Select a profile from kinal.knproj\n  --pkg-root <dir>  Add a local package root\n  --stdpkg-root <dir>  Add an official stdpkg root override\n  --keep-temps     Keep the temporary executable after execution\n  -L, --lib-dir <dir>  Add a library search directory\n  -l, --lib <name>    Link a library by name\n  --link-file <file>  Add an exact link input (.obj/.lib/.a)\n  --link-root <dir>   Expand a dependency root into target-specific search dirs\n  --link-arg <arg>    Pass one raw argument to the linker backend\n  --lang <en|zh>   Diagnostic language\n  --locale-file <file>  External locale JSON map\n  --color <auto|always|never>  Diagnostic color mode\n  --Werror         Treat warnings as errors\n  --warn-level <n> Warning level (0 disables warnings)\n\nArguments after '--' are forwarded to the compiled program.\n\nTo run bytecode via KinalVM instead, use 'kinal vm run'.\n";
    If (command == "vm") Return "Usage: kinal vm <subcommand> [options] [args...]\n\nBytecode operations.\n\nSubcommands:\n  build   Compile source files to .knc bytecode\n  run     Execute .kn source or .knc bytecode via KinalVM\n  disasm  Print a readable listing from .knc bytecode\n  pack    Bundle source or .knc into a standalone vm-exe\n\nUse \"kinal vm <subcommand> --help\" for details.\n";
    If (command == "pkg") Return "Usage: kinal pkg <subcommand> [options] [args...]\n\nPackage management.\n\nSubcommands:\n  build   Build a .klib from a package manifest\n  info    Show .klib metadata\n  unpack  Extract a .klib into a directory\n\nUse \"kinal pkg <subcommand> --help\" for details.\n";
    If (command == "vm build") Return "Usage: kinal vm build [options] <file.kn>\n\n  -o, --output <file>  Output .knc path\n  --project <file|dir>  Build from kinal.knproj or a legacy project manifest\n  --profile <name>  Select a profile from kinal.knproj\n  --superloop          Enable superloop fusion\n  --no-superloop       Disable superloop fusion\n  --listing <file>     Write a readable .knasm bytecode listing\n  --no-module-discovery  Disable auto-discovery\n  --pkg-root <dir>  Add a local package root\n  --stdpkg-root <dir>  Add an official stdpkg root override\n";
    If (command == "vm run") Return "Usage: kinal vm run [options] <file.kn|file.knc> [-- program-args...]\n\n  --project <file|dir>  Run from kinal.knproj or a legacy project manifest\n  --profile <name>  Select a profile from kinal.knproj\n  --vm-path <file>  Explicit kinalvm path\n  --superloop       Enable superloop when compiling source to .knc\n  --no-superloop    Disable superloop when compiling source to .knc\n  --no-module-discovery  Disable auto-discovery when compiling source\n  --keep-temps      Keep the temporary .knc file\n  --pkg-root <dir>  Add a local package root\n  --stdpkg-root <dir>  Add an official stdpkg root override\n";
    If (command == "vm disasm") Return "Usage: kinal vm disasm [options] <file.knc>\n\n  --vm-path <file>  Explicit KinalVM executable path\n";
    If (command == "vm pack") Return "Usage: kinal vm pack [options] <file.kn|file.knc>\n\n  -o, --output <file>  Output executable path\n  --project <file|dir>  Pack from kinal.knproj or a legacy project manifest\n  --profile <name>  Select a profile from kinal.knproj\n  --vm-path <file>     KinalVM executable path\n  --target <triple>    Target platform\n  --superloop          Enable superloop fusion\n  --no-superloop       Disable superloop fusion\n  --no-module-discovery  Disable auto-discovery\n  --pkg-root <dir>  Add a local package root\n  --stdpkg-root <dir>  Add an official stdpkg root override\n";
    If (command == "pkg build") Return "Usage: kinal pkg build --manifest <file|dir> [-o <output.klib>]\n       kinal pkg build --manifest <file|dir> --layout <dir>\n";
    If (command == "pkg info") Return "Usage: kinal pkg info <file.klib>\n";
    If (command == "pkg unpack") Return "Usage: kinal pkg unpack <file.klib> [-o <dir>]\n";
    If (command == "fmt") Return "Usage: kinal fmt [options] <files|dirs...>\n  --check             Return non-zero if formatting would change a file\n  --stdin             Read source from stdin\n  --stdout            Write formatted output to stdout\n  --stdin-filepath <path>  Virtual path for stdin input (editor integration)\n\n  When a directory is given, all .kn files in it are formatted recursively.\n";
    Return "";
}

}

Class MetricReport
{
    Public CompileSession Session;
    Public string Root;
    Public string Profile;
    Public string Mode;
    Public bool IncludeDependencies;
    Public int ExcludedFiles;
    Public list Files;
    Public list Functions;
    Public list Types;
    Public dict FileMap;
    Public dict FunctionMap;
    Public dict TypeMap;
    Public dict EdgeMap;
    Public list RecursiveComponents;
    Public int WarningCount;

    Public Safe Constructor()
    {
        This.Session = null;
        This.Root = "";
        This.Profile = "";
        This.Mode = "";
        This.IncludeDependencies = false;
        This.ExcludedFiles = 0;
        This.Files = list.Create();
        This.Functions = list.Create();
        This.Types = list.Create();
        This.FileMap = dict.Create();
        This.FunctionMap = dict.Create();
        This.TypeMap = dict.Create();
        This.EdgeMap = dict.Create();
        This.RecursiveComponents = list.Create();
        This.WarningCount = 0;
    }
}

Safe Function string SiteKey(int line, int column)
{
    Return [string](line) + ":" + [string](column);
}

Safe Function string FunctionKey(string path, int line, int column)
{
    Return path + ":" + SiteKey(line, column);
}

Safe Function bool Before(int line, int column, int endLine, int endColumn)
{
    Return line < endLine || (line == endLine && column < endColumn);
}

Safe Function bool ContainsPosition(MetricFunction function, int line, int column)
{
    Return !Before(line, column, function.StartLine, function.StartColumn) &&
        Before(line, column, function.EndLine, function.EndColumn);
}

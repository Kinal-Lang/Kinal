Unit IO.Kinal.Compiler.Metrics.Html;

Get IO.Text;

// Values enter the DOM only through textContent. Escape HTML-sensitive bytes
// before embedding JSON so a source name can never terminate the data script.
Safe Function string Render(string json)
{
    string data = IO.Text.Replace(IO.Text.Replace(IO.Text.Replace(json, "&", "\\u0026"), "<", "\\u003c"), ">", "\\u003e");
    Return "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Kinal · Project metrics</title>\n<style>\n:root{color-scheme:light dark;--bg:#f4f6fa;--surface:#fff;--ink:#172b45;--muted:#53657c;--line:#d7e0eb;--accent:#176c80;--hot:#9d3616}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 system-ui,sans-serif}main{max-width:1500px;margin:auto;padding:36px 28px 70px}h1{font-size:32px;letter-spacing:-.035em;margin:5px 0}h2{font-size:20px;margin:30px 0 12px}.eyebrow{color:var(--accent);font-weight:700;letter-spacing:.14em;font-size:12px}p{max-width:1000px}#scope,.muted,small{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:12px;margin:24px 0}.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:16px}.card strong{display:block;font-size:28px;font-variant-numeric:tabular-nums}.bar{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:14px 0}input,select,button{font:inherit;color:inherit;background:var(--surface);border:1px solid var(--line);border-radius:5px;padding:8px}input{min-width:260px}button{cursor:pointer}button:hover{border-color:var(--accent)}:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.scroll{overflow:auto;border:1px solid var(--line);border-radius:8px;background:var(--surface)}table{border-collapse:collapse;width:100%;font-size:13px}th{text-align:left;white-space:nowrap;background:var(--bg)}th button{border:0;background:none;font-weight:650;padding:5px 0}td,th{padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}td.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}td.name{min-width:270px;overflow-wrap:anywhere}tr:last-child td{border:0}tr.hot td:first-child{border-left:3px solid var(--hot)}a{color:var(--accent)}.function-button{padding:0;border:0;background:transparent;text-align:left;color:var(--accent);font-weight:600;overflow-wrap:anywhere}.location{display:block;font:11px/1.5 ui-monospace,monospace;color:var(--muted);margin-top:3px}.notice{border-left:3px solid var(--accent);padding:12px 18px;background:var(--surface)}details{margin:10px 0;background:var(--surface);border:1px solid var(--line);padding:12px 16px;border-radius:6px}summary{cursor:pointer;font-weight:600}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px}dialog{max-width:900px;width:90vw;max-height:85vh;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);padding:24px}dialog::backdrop{background:#13223c80}.close{float:right}dt{font-weight:650;margin-top:14px}dd{margin:5px 0 12px;color:var(--muted)}.empty{padding:24px;color:var(--muted)}@media(prefers-color-scheme:dark){:root{--bg:#111b28;--surface:#182638;--ink:#e4edf7;--muted:#a6b8cd;--line:#344459;--accent:#67cada;--hot:#ffa475}}@media(max-width:600px){main{padding:22px 14px}h1{font-size:25px}input{min-width:180px;width:100%}}@media print{.bar,button.close{display:none}main{padding:0}body{background:white;color:black}.scroll{overflow:visible}table{font-size:10px}details{break-inside:avoid}}\n</style><main><div class=\"eyebrow\">KINAL / SOURCE ANALYSIS</div><h1 id=\"title\">Project metrics</h1><p id=\"scope\"></p><div class=\"notice\" id=\"limits\">Metrics guide review; they do not prove correctness or predict runtime speed.</div><section class=\"cards\" id=\"cards\" aria-label=\"Project summary\"></section>\n<h2>Functions &amp; initializers</h2><p class=\"muted\">Click a name for decision counts, Halstead measures, captures and resolved calls. Default order: cognitive complexity. CC = structured cyclomatic complexity; MI = advisory maintainability index (higher is easier).</p>\n<div class=\"bar\"><label>Filter <input id=\"query\" type=\"search\" placeholder=\"Name, file, type…\"></label><label>Show <select id=\"view\"><option value=\"all\">All records</option><option value=\"body\">Bodies</option><option value=\"hot\">Review hotspots</option><option value=\"recursive\">Recursive</option><option value=\"partial\">Partial semantic data</option></select></label><span id=\"count\" aria-live=\"polite\"></span></div>\n<div class=\"scroll\"><table id=\"functions\"><thead></thead><tbody></tbody></table></div>\n<h2>Files</h2><div class=\"scroll\"><table id=\"files\"></table></div>\n<h2>Types</h2><div class=\"scroll\"><table id=\"types\"></table></div>\n<h2>Direct-call cycles</h2><div id=\"cycles\"></div>\n<details><summary>Complete project totals</summary><dl id=\"totals\"></dl></details>\n<details><summary>Definitions, formulas &amp; limitations</summary><dl id=\"definitions\"></dl></details>\n<p class=\"muted\">Self-contained report · no network requests · kinal.metrics.v1</p></main>\n<dialog id=\"detail\"><button class=\"close\" type=\"button\">Close</button><h2 id=\"detail-title\"></h2><div id=\"detail-content\"></div></dialog>\n<script type=\"application/json\" id=\"data\">" + data + "</script><script>\n\"use strict\";\nconst data=JSON.parse(document.getElementById('data').textContent), summary=data.summary;\nconst el=id=>document.getElementById(id), make=(tag,text)=>{const n=document.createElement(tag);if(text!==undefined)n.textContent=String(text);return n}, human=s=>s.replaceAll('_',' ');\nel('title').textContent=data.project+' · Project metrics';document.title=data.project+' · Kinal metrics';\nel('scope').textContent=`Profile ${data.profile} · ${data.source_mode} · ${data.include_dependencies?'Project + dependencies':'Project sources'} · ${data.excluded_dependency_files} dependency files excluded`;\nel('limits').textContent=`${summary.unbound_source_calls} source calls without bound HIR · ${summary.dynamic_calls} dynamic calls · ${summary.virtual_calls} virtual calls. Call graph and type coupling can be partial. ${data.thresholds.passed?'Configured thresholds pass.':'Configured thresholds exceeded.'} Metrics guide review; they do not prove correctness.`;\nfor(const [label,key] of [['Code lines','code_lines'],['Files','files'],['Callable bodies','bodies'],['Types','types'],['CC maximum','cyclomatic_max'],['CC p95','cyclomatic_p95'],['Cognitive maximum','cognitive_max'],['Maximum nesting','nesting_max']]){const n=make('div');n.className='card';n.append(make('span',label),make('strong',summary[key]));el('cards').append(n)}\nconst columns=[['Callable','name',f=>f.name],['CC','cyclomatic',f=>f.cyclomatic],['Cognitive','cognitive',f=>f.counts.cognitive],['Depth','depth',f=>f.counts.nesting],['Code lines','code',f=>f.code_lines],['Statements','statements',f=>f.counts.statements],['MI ↑','mi',f=>f.maintainability_index],['Parameters','parameters',f=>f.counts.parameters],['Type coupling','coupling',f=>f.coupled_types.length],['Fan in','in',f=>f.fan_in],['Fan out','out',f=>f.fan_out]];\nlet sortKey='cognitive', direction=-1;\nconst head=make('tr');for(const [label,key] of columns){const th=make('th'),button=make('button',label);button.type='button';button.onclick=()=>{direction=sortKey===key?-direction:(key==='name'?1:-1);sortKey=key;render()};th.dataset.key=key;th.append(button);head.append(th)}el('functions').querySelector('thead').append(head);\nconst hot=f=>f.cyclomatic>10||f.counts.cognitive>15||f.counts.nesting>4;\nfunction render(){const q=el('query').value.toLocaleLowerCase(),view=el('view').value,get=columns.find(c=>c[1]===sortKey)[2];let rows=data.functions.filter(f=>(f.name+' '+f.file+' '+f.owner).toLocaleLowerCase().includes(q)&&(view==='all'||view==='body'&&f.has_body||view==='hot'&&hot(f)||view==='recursive'&&f.recursive||view==='partial'&&f.has_body&&(!f.bound||f.dynamic_calls||f.virtual_calls)));\n rows.sort((a,b)=>{let x=get(a),y=get(b);return (typeof x==='string'?x.localeCompare(y):((x??-1)-(y??-1)))*direction||b.cyclomatic-a.cyclomatic||a.id.localeCompare(b.id)});\n const body=el('functions').querySelector('tbody');body.replaceChildren();const fragment=document.createDocumentFragment();for(const f of rows){const tr=make('tr');if(hot(f))tr.className='hot';for(let i=0;i<columns.length;i++){const td=make('td');td.className=i?'num':'name';if(i===0){const button=make('button',f.name);button.type='button';button.className='function-button';button.onclick=()=>detail(f);td.append(button);const loc=make('span',f.id+' · '+f.kind+(f.recursive?' · recursive':'')+(!f.bound&&f.has_body?' · partial':''));loc.className='location';td.append(loc)}else td.textContent=columns[i][2](f)??'—';tr.append(td)}fragment.append(tr)}body.append(fragment);el('count').textContent=rows.length+' / '+data.functions.length+' records';for(const th of head.children)th.setAttribute('aria-sort',th.dataset.key===sortKey?(direction===1?'ascending':'descending'):'none')}\nel('query').addEventListener('input',render);el('view').addEventListener('change',render);render();\nfunction table(id,labels,rows){const table=el(id),thead=make('thead'),tr=make('tr'),tbody=make('tbody');for(const l of labels)tr.append(make('th',l));thead.append(tr);for(const row of rows){const tr=make('tr');row.forEach((v,i)=>{const td=make('td',v??'—');td.className=i?'num':'name';tr.append(td)});tbody.append(tr)}table.append(thead,tbody);if(!rows.length){const tr=make('tr'),td=make('td','No records in this scope.');td.colSpan=labels.length;tr.append(td);tbody.append(tr)}}\ntable('files',['File','Physical','Code','Comments','Blank','Tokens','Statements','CC total','Cognitive total'],data.files.map(f=>[f.path+(f.dependency?' [dependency]':''),f.lines,f.code_lines,f.comment_lines,f.blank_lines,f.tokens,f.statements,f.cyclomatic_total,f.cognitive_total]));\ntable('types',['Type','Fields','Methods','Weighted methods','Inheritance depth','Direct descendants','Coupled types'],data.types.map(t=>[t.name,t.fields,t.methods,t.weighted_methods,t.inheritance_depth,t.direct_derived_types,t.coupled_types.length]));\nconst byId=new Map(data.functions.map(f=>[f.id,f]));for(const cycle of data.recursive_components){const box=make('details');box.append(make('summary',cycle.length+' callable'+(cycle.length===1?'':'s')));const ul=make('ul');for(const id of cycle)ul.append(make('li',(byId.get(id)?.name??id)+' · '+id));box.append(ul);el('cycles').append(box)}if(!data.recursive_components.length)el('cycles').append(make('p','No cycles found in the scoped direct-call graph. Dynamic and virtual calls are not included.'));\nfunction entries(dl,values){for(const [key,value] of Object.entries(values)){dl.append(make('dt',human(key)),make('dd',typeof value==='object'&&value!==null?JSON.stringify(value,null,2):value??'Not available'))}}entries(el('totals'),summary);entries(el('definitions'),data.definitions);\nfunction detail(f){el('detail-title').textContent=f.name;const body=el('detail-content');body.replaceChildren();body.append(make('p',f.id));const dl=make('dl');entries(dl,{...f.counts,cyclomatic:f.cyclomatic,maintainability_index:f.maintainability_index,halstead:f.halstead,coupled_types:f.coupled_types,captures:f.captures,bound_source_calls:f.bound_source_calls,dynamic_calls:f.dynamic_calls,virtual_calls:f.virtual_calls});body.append(dl,make('h3','Call targets'));if(!f.calls.length)body.append(make('p','No resolved source-call records.'));for(const c of f.calls)body.append(make('p',`${c.dispatch}: ${c.name||'(unknown)'} · ${c.line}:${c.column}`));el('detail').showModal()}\nel('detail').querySelector('.close').onclick=()=>el('detail').close();\n</script></html>";
}

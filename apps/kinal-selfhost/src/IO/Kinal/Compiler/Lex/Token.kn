Unit IO.Kinal.Compiler.Lex.Token;

Get IO.Text;
Get IO.Kinal.Compiler.Lex.TokenKind;

Safe Function string Separator()
{
    Return [string]([char](31));
}

Safe Function string Encode(int kind, string text, int line, int column)
{
    string safeText = IO.Text.Replace(text, Separator(), " ");
    Return [string](kind) + Separator() + [string](line) + Separator() +
           [string](column) + Separator() + safeText;
}

Safe Function string Part(string token, int index)
{
    list parts = IO.Text.Split(token, Separator());
    If (index < 0 || index >= parts.Count()) Return "";
    Return [string](parts.Fetch(index));
}

Safe Function int Kind(string token)
{
    string value = Part(token, 0);
    If (IO.Text.IsEmpty(value)) Return [int](TokenKind.Eof);
    Return [int](value);
}

Safe Function int Line(string token)
{
    string value = Part(token, 1);
    If (IO.Text.IsEmpty(value)) Return 0;
    Return [int](value);
}

Safe Function int Column(string token)
{
    string value = Part(token, 2);
    If (IO.Text.IsEmpty(value)) Return 0;
    Return [int](value);
}

Safe Function string Text(string token)
{
    Return Part(token, 3);
}

Safe Function string Dump(string token)
{
    string escaped = IO.Text.Replace(Text(token), [string]([char](10)), "\\n");
    escaped = IO.Text.Replace(escaped, [string]([char](13)), "\\r");
    escaped = IO.Text.Replace(escaped, [string]([char](9)), "\\t");
    Return IO.Kinal.Compiler.Lex.TokenKind.Name(Kind(token)) +
           " @" + [string](Line(token)) + ":" + [string](Column(token)) +
           " '" + escaped + "'";
}

Safe Function string HexDigit(int value)
{
    If (value == 0) Return "0";
    If (value == 1) Return "1";
    If (value == 2) Return "2";
    If (value == 3) Return "3";
    If (value == 4) Return "4";
    If (value == 5) Return "5";
    If (value == 6) Return "6";
    If (value == 7) Return "7";
    If (value == 8) Return "8";
    If (value == 9) Return "9";
    If (value == 10) Return "A";
    If (value == 11) Return "B";
    If (value == 12) Return "C";
    If (value == 13) Return "D";
    If (value == 14) Return "E";
    Return "F";
}

Safe Function string HexText(string text)
{
    char[] chars = text.ToChars();
    string result = "";
    int i = 0;
    While (i < chars.Length())
    {
        int value = [int](chars[i]);
        result = result + HexDigit((value >> 4) & 15) + HexDigit(value & 15);
        i = i + 1;
    }
    Return result;
}

Safe Function string MachineDump(string token)
{
    Return [string](Kind(token)) + [string]([char](9)) +
           [string](Line(token)) + [string]([char](9)) +
           [string](Column(token)) + [string]([char](9)) +
           HexText(Text(token));
}

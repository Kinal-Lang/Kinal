Unit IO.Kinal.Compiler.Lex.Token;

Get IO.Text;
Get IO.Kinal.Compiler.Lex.TokenKind;

Class Token
{
    Public TokenKind Kind;
    Public string Text;
    Public int Line;
    Public int Column;

    Public Safe Constructor(TokenKind kind, string text, int line, int column)
    {
        This.Kind = kind;
        This.Text = text;
        This.Line = line;
        This.Column = column;
    }
}

Safe Function Token Create(TokenKind kind, string text, int line, int column)
{
    Return New Token(kind, text, line, column);
}

Safe Function TokenKind Kind(Token token)
{
    Return token == null ? TokenKind.Eof : token.Kind;
}

Safe Function int Line(Token token)
{
    Return token == null ? 0 : token.Line;
}

Safe Function int Column(Token token)
{
    Return token == null ? 0 : token.Column;
}

Safe Function string Text(Token token)
{
    Return token == null ? "" : token.Text;
}

Safe Function string Dump(Token token)
{
    string escaped = IO.Text.Replace(Text(token), [string]([char](10)), "\\n");
    escaped = IO.Text.Replace(escaped, [string]([char](13)), "\\r");
    escaped = IO.Text.Replace(escaped, [string]([char](9)), "\\t");
    Return IO.Kinal.Compiler.Lex.TokenKind.Name(Kind(token)) +
           " @" + [string](Line(token)) + ":" + [string](Column(token)) +
           " '" + escaped + "'";
}

Safe Function string HexDigit(int value)
{
    If (value == 0) Return "0";
    If (value == 1) Return "1";
    If (value == 2) Return "2";
    If (value == 3) Return "3";
    If (value == 4) Return "4";
    If (value == 5) Return "5";
    If (value == 6) Return "6";
    If (value == 7) Return "7";
    If (value == 8) Return "8";
    If (value == 9) Return "9";
    If (value == 10) Return "A";
    If (value == 11) Return "B";
    If (value == 12) Return "C";
    If (value == 13) Return "D";
    If (value == 14) Return "E";
    Return "F";
}

Safe Function string HexText(string text)
{
    char[] chars = text.ToChars();
    string result = "";
    int i = 0;
    While (i < chars.Length())
    {
        int value = [int](chars[i]);
        result = result + HexDigit((value >> 4) & 15) + HexDigit(value & 15);
        i = i + 1;
    }
    Return result;
}

Safe Function string MachineDump(Token token)
{
    Return [string]([int](Kind(token))) + [string]([char](9)) +
           [string](Line(token)) + [string]([char](9)) +
           [string](Column(token)) + [string]([char](9)) +
           HexText(Text(token));
}

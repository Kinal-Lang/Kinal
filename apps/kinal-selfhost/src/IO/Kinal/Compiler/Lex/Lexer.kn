Unit IO.Kinal.Compiler.Lex.Lexer;

Get IO.Text;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Lex.Token;
Get IO.Kinal.Compiler.Lex.TokenKind;

Class LexerState
{
    Public SourceFile Source;
    Public char[] Chars;
    Public int Length;
    Public int Position;
    Public int Line;
    Public int Column;

    Public Safe Constructor(SourceFile source)
    {
        This.Source = source;
        This.Chars = source.Text.ToChars();
        This.Length = This.Chars.Length();
        This.Position = 0;
        This.Line = 1;
        This.Column = 1;
    }
}

Safe Function char Current(LexerState state)
{
    If (state.Position < 0 || state.Position >= state.Length) Return [char](0);
    Return state.Chars[state.Position];
}

Safe Function char Peek(LexerState state)
{
    int at = state.Position + 1;
    If (at < 0 || at >= state.Length) Return [char](0);
    Return state.Chars[at];
}

Safe Function void Advance(LexerState state)
{
    char current = Current(state);
    If ([int](current) == 0) Return;
    If ([int](current) == 10)
    {
        state.Line = state.Line + 1;
        state.Column = 1;
    }
    Else
    {
        state.Column = state.Column + 1;
    }
    state.Position = state.Position + 1;
}

Safe Function void AdvanceTwice(LexerState state)
{
    Advance(state);
    Advance(state);
}

Safe Function bool IsIdentifierStart(char value)
{
    int code = [int](value);
    Return (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95 || code >= 128;
}

Safe Function bool IsDigit(char value)
{
    int code = [int](value);
    Return code >= 48 && code <= 57;
}

Safe Function bool IsHexDigit(char value)
{
    int code = [int](value);
    Return IsDigit(value) || (code >= 97 && code <= 102) || (code >= 65 && code <= 70);
}

Safe Function bool IsWhitespace(char value)
{
    int code = [int](value);
    Return code == 32 || code == 9 || code == 10 || code == 13;
}

Safe Function bool IsCharacterEscape(char value)
{
    int code = [int](value);
    Return code == 48 || code == 98 || code == 110 || code == 114 || code == 116 ||
           code == 92 || code == 39 || code == 34;
}

Safe Function int KeywordKind(string text)
{
    If (text == "Unit") Return [int](TokenKind.KwUnit);
    If (text == "Get") Return [int](TokenKind.KwGet);
    If (text == "Set") Return [int](TokenKind.KwSet);
    If (text == "Alias") Return [int](TokenKind.KwAlias);
    If (text == "By") Return [int](TokenKind.KwBy);
    If (text == "Property") Return [int](TokenKind.KwProperty);
    If (text == "Function") Return [int](TokenKind.KwFunction);
    If (text == "Return") Return [int](TokenKind.KwReturn);
    If (text == "If") Return [int](TokenKind.KwIf);
    If (text == "Else") Return [int](TokenKind.KwElse);
    If (text == "ElseIf") Return [int](TokenKind.KwElseIf);
    If (text == "While") Return [int](TokenKind.KwWhile);
    If (text == "For") Return [int](TokenKind.KwFor);
    If (text == "Foreach") Return [int](TokenKind.KwForeach);
    If (text == "Switch") Return [int](TokenKind.KwSwitch);
    If (text == "Case") Return [int](TokenKind.KwCase);
    If (text == "Break") Return [int](TokenKind.KwBreak);
    If (text == "Continue") Return [int](TokenKind.KwContinue);
    If (text == "Try") Return [int](TokenKind.KwTry);
    If (text == "Catch") Return [int](TokenKind.KwCatch);
    If (text == "Throw") Return [int](TokenKind.KwThrow);
    If (text == "Const") Return [int](TokenKind.KwConst);
    If (text == "Var") Return [int](TokenKind.KwVar);
    If (text == "Safe") Return [int](TokenKind.KwSafe);
    If (text == "Trusted") Return [int](TokenKind.KwTrusted);
    If (text == "Unsafe") Return [int](TokenKind.KwUnsafe);
    If (text == "Async") Return [int](TokenKind.KwAsync);
    If (text == "Await") Return [int](TokenKind.KwAwait);
    If (text == "Extern") Return [int](TokenKind.KwExtern);
    If (text == "Class") Return [int](TokenKind.KwClass);
    If (text == "Interface") Return [int](TokenKind.KwInterface);
    If (text == "Struct") Return [int](TokenKind.KwStruct);
    If (text == "Enum") Return [int](TokenKind.KwEnum);
    If (text == "Public") Return [int](TokenKind.KwPublic);
    If (text == "Private") Return [int](TokenKind.KwPrivate);
    If (text == "Protected") Return [int](TokenKind.KwProtected);
    If (text == "Internal") Return [int](TokenKind.KwInternal);
    If (text == "Static") Return [int](TokenKind.KwStatic);
    If (text == "Virtual") Return [int](TokenKind.KwVirtual);
    If (text == "Override") Return [int](TokenKind.KwOverride);
    If (text == "Abstract") Return [int](TokenKind.KwAbstract);
    If (text == "Sealed") Return [int](TokenKind.KwSealed);
    If (text == "Constructor") Return [int](TokenKind.KwConstructor);
    If (text == "New") Return [int](TokenKind.KwNew);
    If (text == "This") Return [int](TokenKind.KwThis);
    If (text == "Base") Return [int](TokenKind.KwBase);
    If (text == "Block") Return [int](TokenKind.KwBlock);
    If (text == "Record") Return [int](TokenKind.KwRecord);
    If (text == "Jump") Return [int](TokenKind.KwJump);
    If (text == "Delegate") Return [int](TokenKind.KwDelegate);
    If (text == "true") Return [int](TokenKind.KwTrue);
    If (text == "false") Return [int](TokenKind.KwFalse);
    If (text == "Is") Return [int](TokenKind.KwIs);
    If (text == "In") Return [int](TokenKind.KwIn);
    If (text == "default") Return [int](TokenKind.KwDefault);
    If (text == "null") Return [int](TokenKind.KwNull);
    If (text == "void") Return [int](TokenKind.TypeVoid);
    If (text == "bool") Return [int](TokenKind.TypeBool);
    If (text == "byte") Return [int](TokenKind.TypeByte);
    If (text == "char") Return [int](TokenKind.TypeChar);
    If (text == "int") Return [int](TokenKind.TypeInt);
    If (text == "float") Return [int](TokenKind.TypeFloat);
    If (text == "f16") Return [int](TokenKind.TypeF16);
    If (text == "f32") Return [int](TokenKind.TypeF32);
    If (text == "f64") Return [int](TokenKind.TypeF64);
    If (text == "f128") Return [int](TokenKind.TypeF128);
    If (text == "i8") Return [int](TokenKind.TypeI8);
    If (text == "i16") Return [int](TokenKind.TypeI16);
    If (text == "i32") Return [int](TokenKind.TypeI32);
    If (text == "i64") Return [int](TokenKind.TypeI64);
    If (text == "u8") Return [int](TokenKind.TypeU8);
    If (text == "u16") Return [int](TokenKind.TypeU16);
    If (text == "u32") Return [int](TokenKind.TypeU32);
    If (text == "u64") Return [int](TokenKind.TypeU64);
    If (text == "isize") Return [int](TokenKind.TypeIsize);
    If (text == "usize") Return [int](TokenKind.TypeUsize);
    If (text == "string") Return [int](TokenKind.TypeString);
    If (text == "any") Return [int](TokenKind.TypeAny);
    Return [int](TokenKind.Identifier);
}

Safe Function void SkipTrivia(LexerState state)
{
    While (true)
    {
        While (IsWhitespace(Current(state))) Advance(state);
        If ([int](Current(state)) == 47 && [int](Peek(state)) == 47)
        {
            AdvanceTwice(state);
            While ([int](Current(state)) != 0 && [int](Current(state)) != 10) Advance(state);
            Continue;
        }
        If ([int](Current(state)) == 47 && [int](Peek(state)) == 42)
        {
            AdvanceTwice(state);
            While ([int](Current(state)) != 0)
            {
                If ([int](Current(state)) == 42 && [int](Peek(state)) == 47)
                {
                    AdvanceTwice(state);
                    Break;
                }
                Advance(state);
            }
            Continue;
        }
        Break;
    }
}

Safe Function string MakeToken(LexerState state, int kind, int start, int line, int column)
{
    Return IO.Kinal.Compiler.Lex.Token.Encode(kind, IO.Text.Slice(state.Source.Text, start, state.Position - start), line, column);
}

Safe Function string ReadIdentifier(LexerState state, int line, int column)
{
    int start = state.Position;
    While (IsIdentifierStart(Current(state)) || IsDigit(Current(state))) Advance(state);
    string text = IO.Text.Slice(state.Source.Text, start, state.Position - start);
    Return IO.Kinal.Compiler.Lex.Token.Encode(KeywordKind(text), text, line, column);
}

Safe Function string ReadNumber(LexerState state, int line, int column)
{
    int start = state.Position;
    If ([int](Current(state)) == 48 && ([int](Peek(state)) == 120 || [int](Peek(state)) == 88))
    {
        AdvanceTwice(state);
        While (IsHexDigit(Current(state))) Advance(state);
    }
    Else
    {
        While (IsDigit(Current(state))) Advance(state);
        If ([int](Current(state)) == 46 && IsDigit(Peek(state)))
        {
            Advance(state);
            While (IsDigit(Current(state))) Advance(state);
        }
    }
    If ([int](Current(state)) == 102 || [int](Current(state)) == 70) Advance(state);
    Return MakeToken(state, [int](TokenKind.Number), start, line, column);
}

Safe Function string ReadString(LexerState state, int line, int column)
{
    int start = state.Position;
    int scan = state.Position + 1;
    bool hasClosingQuote = false;
    bool escaped = false;
    While (scan < state.Length)
    {
        int value = [int](state.Chars[scan]);
        If (value == 10 || value == 13) Break;
        If (!escaped && value == 34)
        {
            hasClosingQuote = true;
            Break;
        }
        If (!escaped && value == 92) escaped = true; Else escaped = false;
        scan = scan + 1;
    }
    Advance(state);
    bool terminated = false;
    While ([int](Current(state)) != 0)
    {
        If (hasClosingQuote && [int](Current(state)) == 34)
        {
            Advance(state);
            terminated = true;
            Break;
        }
        If (!hasClosingQuote && ([int](Current(state)) == 10 || [int](Current(state)) == 13 ||
            [int](Current(state)) == 41 || [int](Current(state)) == 59 || [int](Current(state)) == 125)) Break;
        If ([int](Current(state)) == 10 || [int](Current(state)) == 13) Break;
        If ([int](Current(state)) == 92)
        {
            Advance(state);
            If ([int](Current(state)) != 0) Advance(state);
            Continue;
        }
        Advance(state);
    }
    Return MakeToken(state, terminated ? [int](TokenKind.String) : [int](TokenKind.BadString), start, line, column);
}

Safe Function string ReadCharacter(LexerState state, int line, int column)
{
    int start = state.Position;
    int values = 0;
    bool valid = true;
    bool closed = false;
    Advance(state);
    While ([int](Current(state)) != 0 && [int](Current(state)) != 10 && [int](Current(state)) != 13)
    {
        If ([int](Current(state)) == 39)
        {
            Advance(state);
            closed = true;
            Break;
        }
        values = values + 1;
        If ([int](Current(state)) == 92)
        {
            Advance(state);
            If (!IsCharacterEscape(Current(state))) valid = false;
        }
        Advance(state);
    }
    valid = valid && closed && values == 1;
    Return MakeToken(state, valid ? [int](TokenKind.Character) : [int](TokenKind.BadCharacter), start, line, column);
}

Safe Function string SymbolToken(LexerState state, int kind, string text, int line, int column, bool twice)
{
    If (twice) AdvanceTwice(state); Else Advance(state);
    Return IO.Kinal.Compiler.Lex.Token.Encode(kind, text, line, column);
}

Safe Function string ReadSymbol(LexerState state, int line, int column)
{
    int current = [int](Current(state));
    int next = [int](Peek(state));
    If (current == 61 && next == 61) Return SymbolToken(state, [int](TokenKind.Equal), "==", line, column, true);
    If (current == 33 && next == 61) Return SymbolToken(state, [int](TokenKind.NotEqual), "!=", line, column, true);
    If (current == 60 && next == 61) Return SymbolToken(state, [int](TokenKind.LessEqual), "<=", line, column, true);
    If (current == 62 && next == 61) Return SymbolToken(state, [int](TokenKind.GreaterEqual), ">=", line, column, true);
    If (current == 60 && next == 60) Return SymbolToken(state, [int](TokenKind.ShiftLeft), "<<", line, column, true);
    If (current == 62 && next == 62) Return SymbolToken(state, [int](TokenKind.ShiftRight), ">>", line, column, true);
    If (current == 38 && next == 38) Return SymbolToken(state, [int](TokenKind.AndAnd), "&&", line, column, true);
    If (current == 124 && next == 124) Return SymbolToken(state, [int](TokenKind.OrOr), "||", line, column, true);
    If (current == 43 && next == 43) Return SymbolToken(state, [int](TokenKind.PlusPlus), "++", line, column, true);
    If (current == 45 && next == 45) Return SymbolToken(state, [int](TokenKind.MinusMinus), "--", line, column, true);
    If (current == 43 && next == 61) Return SymbolToken(state, [int](TokenKind.PlusAssign), "+=", line, column, true);
    If (current == 45 && next == 61) Return SymbolToken(state, [int](TokenKind.MinusAssign), "-=", line, column, true);
    If (current == 42 && next == 61) Return SymbolToken(state, [int](TokenKind.StarAssign), "*=", line, column, true);
    If (current == 47 && next == 61) Return SymbolToken(state, [int](TokenKind.SlashAssign), "/=", line, column, true);
    If (current == 37 && next == 61) Return SymbolToken(state, [int](TokenKind.PercentAssign), "%=", line, column, true);

    If (current == 40) Return SymbolToken(state, [int](TokenKind.LeftParen), "(", line, column, false);
    If (current == 41) Return SymbolToken(state, [int](TokenKind.RightParen), ")", line, column, false);
    If (current == 123) Return SymbolToken(state, [int](TokenKind.LeftBrace), "{", line, column, false);
    If (current == 125) Return SymbolToken(state, [int](TokenKind.RightBrace), "}", line, column, false);
    If (current == 91) Return SymbolToken(state, [int](TokenKind.LeftBracket), "[", line, column, false);
    If (current == 93) Return SymbolToken(state, [int](TokenKind.RightBracket), "]", line, column, false);
    If (current == 44) Return SymbolToken(state, [int](TokenKind.Comma), ",", line, column, false);
    If (current == 59) Return SymbolToken(state, [int](TokenKind.Semicolon), ";", line, column, false);
    If (current == 46) Return SymbolToken(state, [int](TokenKind.Dot), ".", line, column, false);
    If (current == 58) Return SymbolToken(state, [int](TokenKind.Colon), ":", line, column, false);
    If (current == 63) Return SymbolToken(state, [int](TokenKind.Question), "?", line, column, false);
    If (current == 64) Return SymbolToken(state, [int](TokenKind.At), "@", line, column, false);
    If (current == 43) Return SymbolToken(state, [int](TokenKind.Plus), "+", line, column, false);
    If (current == 45) Return SymbolToken(state, [int](TokenKind.Minus), "-", line, column, false);
    If (current == 42) Return SymbolToken(state, [int](TokenKind.Star), "*", line, column, false);
    If (current == 47) Return SymbolToken(state, [int](TokenKind.Slash), "/", line, column, false);
    If (current == 37) Return SymbolToken(state, [int](TokenKind.Percent), "%", line, column, false);
    If (current == 61) Return SymbolToken(state, [int](TokenKind.Assign), "=", line, column, false);
    If (current == 60) Return SymbolToken(state, [int](TokenKind.Less), "<", line, column, false);
    If (current == 62) Return SymbolToken(state, [int](TokenKind.Greater), ">", line, column, false);
    If (current == 33) Return SymbolToken(state, [int](TokenKind.Not), "!", line, column, false);
    If (current == 38) Return SymbolToken(state, [int](TokenKind.Ampersand), "&", line, column, false);
    If (current == 124) Return SymbolToken(state, [int](TokenKind.BitOr), "|", line, column, false);
    If (current == 94) Return SymbolToken(state, [int](TokenKind.Xor), "^", line, column, false);
    If (current == 126) Return SymbolToken(state, [int](TokenKind.Tilde), "~", line, column, false);

    string unknown = [string](Current(state));
    Advance(state);
    Return IO.Kinal.Compiler.Lex.Token.Encode([int](TokenKind.Eof), unknown, line, column);
}

Safe Function list Tokenize(SourceFile source, list diagnostics)
{
    list tokens = list.Create();
    LexerState state = New LexerState(source);
    While (true)
    {
        SkipTrivia(state);
        int line = state.Line;
        int column = state.Column;
        char current = Current(state);
        string token = "";
        If ([int](current) == 0)
        {
            token = IO.Kinal.Compiler.Lex.Token.Encode([int](TokenKind.Eof), "", line, column);
        }
        ElseIf (IsIdentifierStart(current))
        {
            token = ReadIdentifier(state, line, column);
        }
        ElseIf (IsDigit(current))
        {
            token = ReadNumber(state, line, column);
        }
        ElseIf ([int](current) == 34)
        {
            token = ReadString(state, line, column);
        }
        ElseIf ([int](current) == 39)
        {
            token = ReadCharacter(state, line, column);
        }
        Else
        {
            token = ReadSymbol(state, line, column);
        }
        tokens.Add(token);
        If (IO.Kinal.Compiler.Lex.Token.Kind(token) == [int](TokenKind.BadString))
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Lexer", "Unterminated string",
                IO.Kinal.Compiler.Lex.Token.Text(token), IO.Kinal.Compiler.Lex.Token.Line(token),
                IO.Kinal.Compiler.Lex.Token.Column(token), 1);
        }
        ElseIf (IO.Kinal.Compiler.Lex.Token.Kind(token) == [int](TokenKind.BadCharacter))
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Lexer", "Invalid character literal",
                IO.Kinal.Compiler.Lex.Token.Text(token), IO.Kinal.Compiler.Lex.Token.Line(token),
                IO.Kinal.Compiler.Lex.Token.Column(token), 1);
        }
        If (IO.Kinal.Compiler.Lex.Token.Kind(token) == [int](TokenKind.Eof)) Break;
    }
    Return tokens;
}

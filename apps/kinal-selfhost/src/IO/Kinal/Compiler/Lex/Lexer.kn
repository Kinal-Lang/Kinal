Unit IO.Kinal.Compiler.Lex.Lexer;

Get IO.Text;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Lex.Token;
Get IO.Kinal.Compiler.Lex.TokenKind;

Class LexerState
{
    Public SourceFile Source;
    Public char[] Chars;
    Public int Length;
    Public int Position;
    Public int Line;
    Public int Column;

    Public Safe Constructor(SourceFile source)
    {
        This.Source = source;
        This.Chars = source.Text.ToChars();
        This.Length = This.Chars.Length();
        This.Position = 0;
        This.Line = 1;
        This.Column = 1;
    }
}

Safe Function char Current(LexerState state)
{
    If (state.Position < 0 || state.Position >= state.Length) Return [char](0);
    Return state.Chars[state.Position];
}

Safe Function char Peek(LexerState state)
{
    int at = state.Position + 1;
    If (at < 0 || at >= state.Length) Return [char](0);
    Return state.Chars[at];
}

Safe Function void Advance(LexerState state)
{
    char current = Current(state);
    If ([int](current) == 0) Return;
    If ([int](current) == 10)
    {
        state.Line = state.Line + 1;
        state.Column = 1;
    }
    Else
    {
        state.Column = state.Column + 1;
    }
    state.Position = state.Position + 1;
}

Safe Function void AdvanceTwice(LexerState state)
{
    Advance(state);
    Advance(state);
}

Safe Function bool IsIdentifierStart(char value)
{
    int code = [int](value);
    Return (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95 || code >= 128;
}

Safe Function bool IsDigit(char value)
{
    int code = [int](value);
    Return code >= 48 && code <= 57;
}

Safe Function bool IsHexDigit(char value)
{
    int code = [int](value);
    Return IsDigit(value) || (code >= 97 && code <= 102) || (code >= 65 && code <= 70);
}

Safe Function bool IsWhitespace(char value)
{
    int code = [int](value);
    Return code == 32 || code == 9 || code == 10 || code == 13;
}

Safe Function bool IsCharacterEscape(char value)
{
    int code = [int](value);
    Return code == 48 || code == 98 || code == 110 || code == 114 || code == 116 ||
           code == 92 || code == 39 || code == 34;
}

Safe Function TokenKind KeywordKind(string text)
{
    If (text == "Unit") Return TokenKind.KwUnit;
    If (text == "Get") Return TokenKind.KwGet;
    If (text == "Set") Return TokenKind.KwSet;
    If (text == "Alias") Return TokenKind.KwAlias;
    If (text == "By") Return TokenKind.KwBy;
    If (text == "Property") Return TokenKind.KwProperty;
    If (text == "Function") Return TokenKind.KwFunction;
    If (text == "Return") Return TokenKind.KwReturn;
    If (text == "If") Return TokenKind.KwIf;
    If (text == "Else") Return TokenKind.KwElse;
    If (text == "ElseIf") Return TokenKind.KwElseIf;
    If (text == "While") Return TokenKind.KwWhile;
    If (text == "For") Return TokenKind.KwFor;
    If (text == "Foreach") Return TokenKind.KwForeach;
    If (text == "Switch") Return TokenKind.KwSwitch;
    If (text == "Case") Return TokenKind.KwCase;
    If (text == "Break") Return TokenKind.KwBreak;
    If (text == "Continue") Return TokenKind.KwContinue;
    If (text == "Try") Return TokenKind.KwTry;
    If (text == "Catch") Return TokenKind.KwCatch;
    If (text == "Throw") Return TokenKind.KwThrow;
    If (text == "Const") Return TokenKind.KwConst;
    If (text == "Var") Return TokenKind.KwVar;
    If (text == "Safe") Return TokenKind.KwSafe;
    If (text == "Trusted") Return TokenKind.KwTrusted;
    If (text == "Unsafe") Return TokenKind.KwUnsafe;
    If (text == "Async") Return TokenKind.KwAsync;
    If (text == "Await") Return TokenKind.KwAwait;
    If (text == "Extern") Return TokenKind.KwExtern;
    If (text == "Class") Return TokenKind.KwClass;
    If (text == "Interface") Return TokenKind.KwInterface;
    If (text == "Struct") Return TokenKind.KwStruct;
    If (text == "Enum") Return TokenKind.KwEnum;
    If (text == "Public") Return TokenKind.KwPublic;
    If (text == "Private") Return TokenKind.KwPrivate;
    If (text == "Protected") Return TokenKind.KwProtected;
    If (text == "Internal") Return TokenKind.KwInternal;
    If (text == "Static") Return TokenKind.KwStatic;
    If (text == "Virtual") Return TokenKind.KwVirtual;
    If (text == "Override") Return TokenKind.KwOverride;
    If (text == "Abstract") Return TokenKind.KwAbstract;
    If (text == "Sealed") Return TokenKind.KwSealed;
    If (text == "Constructor") Return TokenKind.KwConstructor;
    If (text == "New") Return TokenKind.KwNew;
    If (text == "This") Return TokenKind.KwThis;
    If (text == "Base") Return TokenKind.KwBase;
    If (text == "Block") Return TokenKind.KwBlock;
    If (text == "Record") Return TokenKind.KwRecord;
    If (text == "Jump") Return TokenKind.KwJump;
    If (text == "Delegate") Return TokenKind.KwDelegate;
    If (text == "true") Return TokenKind.KwTrue;
    If (text == "false") Return TokenKind.KwFalse;
    If (text == "Is") Return TokenKind.KwIs;
    If (text == "In") Return TokenKind.KwIn;
    If (text == "default") Return TokenKind.KwDefault;
    If (text == "null") Return TokenKind.KwNull;
    If (text == "void") Return TokenKind.TypeVoid;
    If (text == "bool") Return TokenKind.TypeBool;
    If (text == "byte") Return TokenKind.TypeByte;
    If (text == "char") Return TokenKind.TypeChar;
    If (text == "int") Return TokenKind.TypeInt;
    If (text == "float") Return TokenKind.TypeFloat;
    If (text == "f16") Return TokenKind.TypeF16;
    If (text == "f32") Return TokenKind.TypeF32;
    If (text == "f64") Return TokenKind.TypeF64;
    If (text == "f128") Return TokenKind.TypeF128;
    If (text == "i8") Return TokenKind.TypeI8;
    If (text == "i16") Return TokenKind.TypeI16;
    If (text == "i32") Return TokenKind.TypeI32;
    If (text == "i64") Return TokenKind.TypeI64;
    If (text == "u8") Return TokenKind.TypeU8;
    If (text == "u16") Return TokenKind.TypeU16;
    If (text == "u32") Return TokenKind.TypeU32;
    If (text == "u64") Return TokenKind.TypeU64;
    If (text == "isize") Return TokenKind.TypeIsize;
    If (text == "usize") Return TokenKind.TypeUsize;
    If (text == "string") Return TokenKind.TypeString;
    If (text == "any") Return TokenKind.TypeAny;
    Return TokenKind.Identifier;
}

Safe Function void SkipTrivia(LexerState state)
{
    While (true)
    {
        While (IsWhitespace(Current(state))) Advance(state);
        If ([int](Current(state)) == 47 && [int](Peek(state)) == 47)
        {
            AdvanceTwice(state);
            While ([int](Current(state)) != 0 && [int](Current(state)) != 10) Advance(state);
            Continue;
        }
        If ([int](Current(state)) == 47 && [int](Peek(state)) == 42)
        {
            AdvanceTwice(state);
            While ([int](Current(state)) != 0)
            {
                If ([int](Current(state)) == 42 && [int](Peek(state)) == 47)
                {
                    AdvanceTwice(state);
                    Break;
                }
                Advance(state);
            }
            Continue;
        }
        Break;
    }
}

Safe Function string MakeToken(LexerState state, TokenKind kind, int start, int line, int column)
{
    Return IO.Kinal.Compiler.Lex.Token.Encode(kind, IO.Text.Slice(state.Source.Text, start, state.Position - start), line, column);
}

Safe Function string ReadIdentifier(LexerState state, int line, int column)
{
    int start = state.Position;
    While (IsIdentifierStart(Current(state)) || IsDigit(Current(state))) Advance(state);
    string text = IO.Text.Slice(state.Source.Text, start, state.Position - start);
    Return IO.Kinal.Compiler.Lex.Token.Encode(KeywordKind(text), text, line, column);
}

Safe Function string ReadNumber(LexerState state, int line, int column)
{
    int start = state.Position;
    If ([int](Current(state)) == 48 && ([int](Peek(state)) == 120 || [int](Peek(state)) == 88))
    {
        AdvanceTwice(state);
        While (IsHexDigit(Current(state))) Advance(state);
    }
    Else
    {
        While (IsDigit(Current(state))) Advance(state);
        If ([int](Current(state)) == 46 && IsDigit(Peek(state)))
        {
            Advance(state);
            While (IsDigit(Current(state))) Advance(state);
        }
    }
    If ([int](Current(state)) == 102 || [int](Current(state)) == 70) Advance(state);
    Return MakeToken(state, TokenKind.Number, start, line, column);
}

Safe Function string ReadString(LexerState state, int line, int column)
{
    int start = state.Position;
    int scan = state.Position + 1;
    bool hasClosingQuote = false;
    bool escaped = false;
    While (scan < state.Length)
    {
        int value = [int](state.Chars[scan]);
        If (value == 10 || value == 13) Break;
        If (!escaped && value == 34)
        {
            hasClosingQuote = true;
            Break;
        }
        If (!escaped && value == 92) escaped = true; Else escaped = false;
        scan = scan + 1;
    }
    Advance(state);
    bool terminated = false;
    While ([int](Current(state)) != 0)
    {
        If (hasClosingQuote && [int](Current(state)) == 34)
        {
            Advance(state);
            terminated = true;
            Break;
        }
        If (!hasClosingQuote && ([int](Current(state)) == 10 || [int](Current(state)) == 13 ||
            [int](Current(state)) == 41 || [int](Current(state)) == 59 || [int](Current(state)) == 125)) Break;
        If ([int](Current(state)) == 10 || [int](Current(state)) == 13) Break;
        If ([int](Current(state)) == 92)
        {
            Advance(state);
            If ([int](Current(state)) != 0) Advance(state);
            Continue;
        }
        Advance(state);
    }
    Return MakeToken(state, terminated ? TokenKind.String : TokenKind.BadString, start, line, column);
}

Safe Function string ReadCharacter(LexerState state, int line, int column)
{
    int start = state.Position;
    int values = 0;
    bool valid = true;
    bool closed = false;
    Advance(state);
    While ([int](Current(state)) != 0 && [int](Current(state)) != 10 && [int](Current(state)) != 13)
    {
        If ([int](Current(state)) == 39)
        {
            Advance(state);
            closed = true;
            Break;
        }
        values = values + 1;
        If ([int](Current(state)) == 92)
        {
            Advance(state);
            If (!IsCharacterEscape(Current(state))) valid = false;
        }
        Advance(state);
    }
    valid = valid && closed && values == 1;
    Return MakeToken(state, valid ? TokenKind.Character : TokenKind.BadCharacter, start, line, column);
}

Safe Function string SymbolToken(LexerState state, TokenKind kind, string text, int line, int column, bool twice)
{
    If (twice) AdvanceTwice(state); Else Advance(state);
    Return IO.Kinal.Compiler.Lex.Token.Encode(kind, text, line, column);
}

Safe Function string ReadSymbol(LexerState state, int line, int column)
{
    int current = [int](Current(state));
    int next = [int](Peek(state));
    If (current == 61 && next == 61) Return SymbolToken(state, TokenKind.Equal, "==", line, column, true);
    If (current == 33 && next == 61) Return SymbolToken(state, TokenKind.NotEqual, "!=", line, column, true);
    If (current == 60 && next == 61) Return SymbolToken(state, TokenKind.LessEqual, "<=", line, column, true);
    If (current == 62 && next == 61) Return SymbolToken(state, TokenKind.GreaterEqual, ">=", line, column, true);
    If (current == 60 && next == 60) Return SymbolToken(state, TokenKind.ShiftLeft, "<<", line, column, true);
    If (current == 62 && next == 62) Return SymbolToken(state, TokenKind.ShiftRight, ">>", line, column, true);
    If (current == 38 && next == 38) Return SymbolToken(state, TokenKind.AndAnd, "&&", line, column, true);
    If (current == 124 && next == 124) Return SymbolToken(state, TokenKind.OrOr, "||", line, column, true);
    If (current == 43 && next == 43) Return SymbolToken(state, TokenKind.PlusPlus, "++", line, column, true);
    If (current == 45 && next == 45) Return SymbolToken(state, TokenKind.MinusMinus, "--", line, column, true);
    If (current == 43 && next == 61) Return SymbolToken(state, TokenKind.PlusAssign, "+=", line, column, true);
    If (current == 45 && next == 61) Return SymbolToken(state, TokenKind.MinusAssign, "-=", line, column, true);
    If (current == 42 && next == 61) Return SymbolToken(state, TokenKind.StarAssign, "*=", line, column, true);
    If (current == 47 && next == 61) Return SymbolToken(state, TokenKind.SlashAssign, "/=", line, column, true);
    If (current == 37 && next == 61) Return SymbolToken(state, TokenKind.PercentAssign, "%=", line, column, true);

    If (current == 40) Return SymbolToken(state, TokenKind.LeftParen, "(", line, column, false);
    If (current == 41) Return SymbolToken(state, TokenKind.RightParen, ")", line, column, false);
    If (current == 123) Return SymbolToken(state, TokenKind.LeftBrace, "{", line, column, false);
    If (current == 125) Return SymbolToken(state, TokenKind.RightBrace, "}", line, column, false);
    If (current == 91) Return SymbolToken(state, TokenKind.LeftBracket, "[", line, column, false);
    If (current == 93) Return SymbolToken(state, TokenKind.RightBracket, "]", line, column, false);
    If (current == 44) Return SymbolToken(state, TokenKind.Comma, ",", line, column, false);
    If (current == 59) Return SymbolToken(state, TokenKind.Semicolon, ";", line, column, false);
    If (current == 46) Return SymbolToken(state, TokenKind.Dot, ".", line, column, false);
    If (current == 58) Return SymbolToken(state, TokenKind.Colon, ":", line, column, false);
    If (current == 63) Return SymbolToken(state, TokenKind.Question, "?", line, column, false);
    If (current == 64) Return SymbolToken(state, TokenKind.At, "@", line, column, false);
    If (current == 43) Return SymbolToken(state, TokenKind.Plus, "+", line, column, false);
    If (current == 45) Return SymbolToken(state, TokenKind.Minus, "-", line, column, false);
    If (current == 42) Return SymbolToken(state, TokenKind.Star, "*", line, column, false);
    If (current == 47) Return SymbolToken(state, TokenKind.Slash, "/", line, column, false);
    If (current == 37) Return SymbolToken(state, TokenKind.Percent, "%", line, column, false);
    If (current == 61) Return SymbolToken(state, TokenKind.Assign, "=", line, column, false);
    If (current == 60) Return SymbolToken(state, TokenKind.Less, "<", line, column, false);
    If (current == 62) Return SymbolToken(state, TokenKind.Greater, ">", line, column, false);
    If (current == 33) Return SymbolToken(state, TokenKind.Not, "!", line, column, false);
    If (current == 38) Return SymbolToken(state, TokenKind.Ampersand, "&", line, column, false);
    If (current == 124) Return SymbolToken(state, TokenKind.BitOr, "|", line, column, false);
    If (current == 94) Return SymbolToken(state, TokenKind.Xor, "^", line, column, false);
    If (current == 126) Return SymbolToken(state, TokenKind.Tilde, "~", line, column, false);

    string unknown = [string](Current(state));
    Advance(state);
    Return IO.Kinal.Compiler.Lex.Token.Encode(TokenKind.Eof, unknown, line, column);
}

Safe Function list Tokenize(SourceFile source, list diagnostics)
{
    list tokens = list.Create();
    LexerState state = New LexerState(source);
    While (true)
    {
        SkipTrivia(state);
        int line = state.Line;
        int column = state.Column;
        char current = Current(state);
        string token = "";
        If ([int](current) == 0)
        {
            token = IO.Kinal.Compiler.Lex.Token.Encode(TokenKind.Eof, "", line, column);
        }
        ElseIf (IsIdentifierStart(current))
        {
            token = ReadIdentifier(state, line, column);
        }
        ElseIf (IsDigit(current))
        {
            token = ReadNumber(state, line, column);
        }
        ElseIf ([int](current) == 34)
        {
            token = ReadString(state, line, column);
        }
        ElseIf ([int](current) == 39)
        {
            token = ReadCharacter(state, line, column);
        }
        Else
        {
            token = ReadSymbol(state, line, column);
        }
        tokens.Add(token);
        If (IO.Kinal.Compiler.Lex.Token.Kind(token) == TokenKind.BadString)
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Lexer", "Unterminated string",
                IO.Kinal.Compiler.Lex.Token.Text(token), IO.Kinal.Compiler.Lex.Token.Line(token),
                IO.Kinal.Compiler.Lex.Token.Column(token), 1);
        }
        ElseIf (IO.Kinal.Compiler.Lex.Token.Kind(token) == TokenKind.BadCharacter)
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Parser", "Invalid Character Literal",
                IO.Kinal.Compiler.Lex.Token.Text(token), IO.Kinal.Compiler.Lex.Token.Line(token),
                IO.Kinal.Compiler.Lex.Token.Column(token), 1);
        }
        If (IO.Kinal.Compiler.Lex.Token.Kind(token) == TokenKind.Eof) Break;
    }
    Return tokens;
}

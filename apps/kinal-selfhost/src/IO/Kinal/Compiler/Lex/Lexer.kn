Unit IO.Kinal.Compiler.Lex.Lexer;

Get IO.Text;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Lex.Token;
Get IO.Kinal.Compiler.Lex.TokenKind;

Class LexerState
{
    Public SourceFile Source;
    Public char[] Chars;
    Public int Length;
    Public int Position;
    Public int Line;
    Public int Column;

    Public Safe Constructor(SourceFile source)
    {
        This.Source = source;
        This.Chars = source.Text.ToChars();
        This.Length = This.Chars.Length();
        This.Position = 0;
        This.Line = 1;
        This.Column = 1;
    }
}

Safe Function char Current(LexerState state)
{
    If (state.Position < 0 || state.Position >= state.Length) Return '\0';
    Return state.Chars[state.Position];
}

Safe Function char Peek(LexerState state)
{
    int at = state.Position + 1;
    If (at < 0 || at >= state.Length) Return '\0';
    Return state.Chars[at];
}

Safe Function void Advance(LexerState state)
{
    char current = Current(state);
    If (current == '\0') Return;
    If (current == '\n')
    {
        state.Line = state.Line + 1;
        state.Column = 1;
    }
    Else
    {
        state.Column = state.Column + 1;
    }
    state.Position = state.Position + 1;
}

Safe Function void AdvanceTwice(LexerState state)
{
    Advance(state);
    Advance(state);
}

Safe Function bool IsIdentifierStart(char value)
{
    Return (value >= 'a' && value <= 'z') ||
           (value >= 'A' && value <= 'Z') || value == '_' || [int](value) >= 128;
}

Safe Function bool IsDigit(char value)
{
    Return value >= '0' && value <= '9';
}

Safe Function bool IsHexDigit(char value)
{
    Return IsDigit(value) || (value >= 'a' && value <= 'f') ||
           (value >= 'A' && value <= 'F');
}

Safe Function bool IsWhitespace(char value)
{
    Return value == ' ' || value == '\t' || value == '\n' || value == '\r';
}

Safe Function bool IsCharacterEscape(char value)
{
    Return value == '0' || value == 'b' || value == 'n' || value == 'r' ||
           value == 't' || value == '\\' || value == '\'' || value == '"';
}

Safe Function TokenKind KeywordKind(string text)
{
    Return Switch (text)
    {
        Case("Unit") { TokenKind.KwUnit; }
        Case("Get") { TokenKind.KwGet; }
        Case("Set") { TokenKind.KwSet; }
        Case("Alias") { TokenKind.KwAlias; }
        Case("By") { TokenKind.KwBy; }
        Case("Property") { TokenKind.KwProperty; }
        Case("Function") { TokenKind.KwFunction; }
        Case("Return") { TokenKind.KwReturn; }
        Case("If") { TokenKind.KwIf; }
        Case("Else") { TokenKind.KwElse; }
        Case("ElseIf") { TokenKind.KwElseIf; }
        Case("While") { TokenKind.KwWhile; }
        Case("For") { TokenKind.KwFor; }
        Case("Foreach") { TokenKind.KwForeach; }
        Case("Switch") { TokenKind.KwSwitch; }
        Case("Case") { TokenKind.KwCase; }
        Case("Break") { TokenKind.KwBreak; }
        Case("Continue") { TokenKind.KwContinue; }
        Case("Try") { TokenKind.KwTry; }
        Case("Catch") { TokenKind.KwCatch; }
        Case("Throw") { TokenKind.KwThrow; }
        Case("Const") { TokenKind.KwConst; }
        Case("Var") { TokenKind.KwVar; }
        Case("Safe") { TokenKind.KwSafe; }
        Case("Trusted") { TokenKind.KwTrusted; }
        Case("Unsafe") { TokenKind.KwUnsafe; }
        Case("Async") { TokenKind.KwAsync; }
        Case("Await") { TokenKind.KwAwait; }
        Case("Extern") { TokenKind.KwExtern; }
        Case("Class") { TokenKind.KwClass; }
        Case("Interface") { TokenKind.KwInterface; }
        Case("Struct") { TokenKind.KwStruct; }
        Case("Enum") { TokenKind.KwEnum; }
        Case("Public") { TokenKind.KwPublic; }
        Case("Private") { TokenKind.KwPrivate; }
        Case("Protected") { TokenKind.KwProtected; }
        Case("Internal") { TokenKind.KwInternal; }
        Case("Static") { TokenKind.KwStatic; }
        Case("Virtual") { TokenKind.KwVirtual; }
        Case("Override") { TokenKind.KwOverride; }
        Case("Abstract") { TokenKind.KwAbstract; }
        Case("Sealed") { TokenKind.KwSealed; }
        Case("Constructor") { TokenKind.KwConstructor; }
        Case("New") { TokenKind.KwNew; }
        Case("This") { TokenKind.KwThis; }
        Case("Base") { TokenKind.KwBase; }
        Case("Block") { TokenKind.KwBlock; }
        Case("Record") { TokenKind.KwRecord; }
        Case("Jump") { TokenKind.KwJump; }
        Case("Delegate") { TokenKind.KwDelegate; }
        Case("true") { TokenKind.KwTrue; }
        Case("false") { TokenKind.KwFalse; }
        Case("Is") { TokenKind.KwIs; }
        Case("In") { TokenKind.KwIn; }
        Case("default") { TokenKind.KwDefault; }
        Case("null") { TokenKind.KwNull; }
        Case("void") { TokenKind.TypeVoid; }
        Case("bool") { TokenKind.TypeBool; }
        Case("byte") { TokenKind.TypeByte; }
        Case("char") { TokenKind.TypeChar; }
        Case("int") { TokenKind.TypeInt; }
        Case("float") { TokenKind.TypeFloat; }
        Case("f16") { TokenKind.TypeF16; }
        Case("f32") { TokenKind.TypeF32; }
        Case("f64") { TokenKind.TypeF64; }
        Case("f128") { TokenKind.TypeF128; }
        Case("i8") { TokenKind.TypeI8; }
        Case("i16") { TokenKind.TypeI16; }
        Case("i32") { TokenKind.TypeI32; }
        Case("i64") { TokenKind.TypeI64; }
        Case("u8") { TokenKind.TypeU8; }
        Case("u16") { TokenKind.TypeU16; }
        Case("u32") { TokenKind.TypeU32; }
        Case("u64") { TokenKind.TypeU64; }
        Case("isize") { TokenKind.TypeIsize; }
        Case("usize") { TokenKind.TypeUsize; }
        Case("string") { TokenKind.TypeString; }
        Case("any") { TokenKind.TypeAny; }
        Case(default) { TokenKind.Identifier; }
    };
}

Safe Function void SkipTrivia(LexerState state)
{
    While (true)
    {
        While (IsWhitespace(Current(state))) Advance(state);
        If (Current(state) == '/' && Peek(state) == '/')
        {
            AdvanceTwice(state);
            While (Current(state) != '\0' && Current(state) != '\n') Advance(state);
            Continue;
        }
        If (Current(state) == '/' && Peek(state) == '*')
        {
            AdvanceTwice(state);
            While (Current(state) != '\0')
            {
                If (Current(state) == '*' && Peek(state) == '/')
                {
                    AdvanceTwice(state);
                    Break;
                }
                Advance(state);
            }
            Continue;
        }
        Break;
    }
}

Safe Function string MakeToken(LexerState state, TokenKind kind, int start, int line, int column)
{
    Return IO.Kinal.Compiler.Lex.Token.Encode(kind, IO.Text.Slice(state.Source.Text, start, state.Position - start), line, column);
}

Safe Function string ReadIdentifier(LexerState state, int line, int column)
{
    int start = state.Position;
    While (IsIdentifierStart(Current(state)) || IsDigit(Current(state))) Advance(state);
    string text = IO.Text.Slice(state.Source.Text, start, state.Position - start);
    Return IO.Kinal.Compiler.Lex.Token.Encode(KeywordKind(text), text, line, column);
}

Safe Function string ReadNumber(LexerState state, int line, int column)
{
    int start = state.Position;
    If (Current(state) == '0' && (Peek(state) == 'x' || Peek(state) == 'X'))
    {
        AdvanceTwice(state);
        While (IsHexDigit(Current(state))) Advance(state);
    }
    Else
    {
        While (IsDigit(Current(state))) Advance(state);
        If (Current(state) == '.' && IsDigit(Peek(state)))
        {
            Advance(state);
            While (IsDigit(Current(state))) Advance(state);
        }
    }
    If (Current(state) == 'f' || Current(state) == 'F') Advance(state);
    Return MakeToken(state, TokenKind.Number, start, line, column);
}

Safe Function string ReadString(LexerState state, int line, int column)
{
    int start = state.Position;
    int scan = state.Position + 1;
    bool hasClosingQuote = false;
    bool escaped = false;
    While (scan < state.Length)
    {
        char value = state.Chars[scan];
        If (value == '\n' || value == '\r') Break;
        If (!escaped && value == '"')
        {
            hasClosingQuote = true;
            Break;
        }
        If (!escaped && value == '\\') escaped = true; Else escaped = false;
        scan = scan + 1;
    }
    Advance(state);
    bool terminated = false;
    While (Current(state) != '\0')
    {
        If (hasClosingQuote && Current(state) == '"')
        {
            Advance(state);
            terminated = true;
            Break;
        }
        If (!hasClosingQuote && (Current(state) == '\n' || Current(state) == '\r' ||
            Current(state) == ')' || Current(state) == ';' || Current(state) == '}')) Break;
        If (Current(state) == '\n' || Current(state) == '\r') Break;
        If (Current(state) == '\\')
        {
            Advance(state);
            If (Current(state) != '\0') Advance(state);
            Continue;
        }
        Advance(state);
    }
    Return MakeToken(state, terminated ? TokenKind.String : TokenKind.BadString, start, line, column);
}

Safe Function string ReadCharacter(LexerState state, int line, int column)
{
    int start = state.Position;
    int values = 0;
    bool valid = true;
    bool closed = false;
    Advance(state);
    While (Current(state) != '\0' && Current(state) != '\n' && Current(state) != '\r')
    {
        If (Current(state) == '\'')
        {
            Advance(state);
            closed = true;
            Break;
        }
        values = values + 1;
        If (Current(state) == '\\')
        {
            Advance(state);
            If (!IsCharacterEscape(Current(state))) valid = false;
        }
        Advance(state);
    }
    valid = valid && closed && values == 1;
    Return MakeToken(state, valid ? TokenKind.Character : TokenKind.BadCharacter, start, line, column);
}

Safe Function string SymbolToken(LexerState state, TokenKind kind, string text, int line, int column, bool twice)
{
    If (twice) AdvanceTwice(state); Else Advance(state);
    Return IO.Kinal.Compiler.Lex.Token.Encode(kind, text, line, column);
}

Safe Function string ReadSymbol(LexerState state, int line, int column)
{
    char current = Current(state);
    char next = Peek(state);
    Switch (current)
    {
        Case('=')
        {
            If (next == '=') Return SymbolToken(state, TokenKind.Equal, "==", line, column, true);
            Return SymbolToken(state, TokenKind.Assign, "=", line, column, false);
        }
        Case('!')
        {
            If (next == '=') Return SymbolToken(state, TokenKind.NotEqual, "!=", line, column, true);
            Return SymbolToken(state, TokenKind.Not, "!", line, column, false);
        }
        Case('<')
        {
            If (next == '=') Return SymbolToken(state, TokenKind.LessEqual, "<=", line, column, true);
            If (next == '<') Return SymbolToken(state, TokenKind.ShiftLeft, "<<", line, column, true);
            Return SymbolToken(state, TokenKind.Less, "<", line, column, false);
        }
        Case('>')
        {
            If (next == '=') Return SymbolToken(state, TokenKind.GreaterEqual, ">=", line, column, true);
            If (next == '>') Return SymbolToken(state, TokenKind.ShiftRight, ">>", line, column, true);
            Return SymbolToken(state, TokenKind.Greater, ">", line, column, false);
        }
        Case('&')
        {
            If (next == '&') Return SymbolToken(state, TokenKind.AndAnd, "&&", line, column, true);
            Return SymbolToken(state, TokenKind.Ampersand, "&", line, column, false);
        }
        Case('|')
        {
            If (next == '|') Return SymbolToken(state, TokenKind.OrOr, "||", line, column, true);
            Return SymbolToken(state, TokenKind.BitOr, "|", line, column, false);
        }
        Case('+')
        {
            If (next == '+') Return SymbolToken(state, TokenKind.PlusPlus, "++", line, column, true);
            If (next == '=') Return SymbolToken(state, TokenKind.PlusAssign, "+=", line, column, true);
            Return SymbolToken(state, TokenKind.Plus, "+", line, column, false);
        }
        Case('-')
        {
            If (next == '-') Return SymbolToken(state, TokenKind.MinusMinus, "--", line, column, true);
            If (next == '=') Return SymbolToken(state, TokenKind.MinusAssign, "-=", line, column, true);
            Return SymbolToken(state, TokenKind.Minus, "-", line, column, false);
        }
        Case('*')
        {
            If (next == '=') Return SymbolToken(state, TokenKind.StarAssign, "*=", line, column, true);
            Return SymbolToken(state, TokenKind.Star, "*", line, column, false);
        }
        Case('/')
        {
            If (next == '=') Return SymbolToken(state, TokenKind.SlashAssign, "/=", line, column, true);
            Return SymbolToken(state, TokenKind.Slash, "/", line, column, false);
        }
        Case('%')
        {
            If (next == '=') Return SymbolToken(state, TokenKind.PercentAssign, "%=", line, column, true);
            Return SymbolToken(state, TokenKind.Percent, "%", line, column, false);
        }
        Case('(') { Return SymbolToken(state, TokenKind.LeftParen, "(", line, column, false); }
        Case(')') { Return SymbolToken(state, TokenKind.RightParen, ")", line, column, false); }
        Case('{') { Return SymbolToken(state, TokenKind.LeftBrace, "{", line, column, false); }
        Case('}') { Return SymbolToken(state, TokenKind.RightBrace, "}", line, column, false); }
        Case('[') { Return SymbolToken(state, TokenKind.LeftBracket, "[", line, column, false); }
        Case(']') { Return SymbolToken(state, TokenKind.RightBracket, "]", line, column, false); }
        Case(',') { Return SymbolToken(state, TokenKind.Comma, ",", line, column, false); }
        Case(';') { Return SymbolToken(state, TokenKind.Semicolon, ";", line, column, false); }
        Case('.') { Return SymbolToken(state, TokenKind.Dot, ".", line, column, false); }
        Case(':') { Return SymbolToken(state, TokenKind.Colon, ":", line, column, false); }
        Case('?') { Return SymbolToken(state, TokenKind.Question, "?", line, column, false); }
        Case('@') { Return SymbolToken(state, TokenKind.At, "@", line, column, false); }
        Case('^') { Return SymbolToken(state, TokenKind.Xor, "^", line, column, false); }
        Case('~') { Return SymbolToken(state, TokenKind.Tilde, "~", line, column, false); }
        Case(default) { }
    }

    string unknown = [string](Current(state));
    Advance(state);
    Return IO.Kinal.Compiler.Lex.Token.Encode(TokenKind.Eof, unknown, line, column);
}

Safe Function list Tokenize(SourceFile source, list diagnostics)
{
    list tokens = list.Create();
    LexerState state = New LexerState(source);
    While (true)
    {
        SkipTrivia(state);
        int line = state.Line;
        int column = state.Column;
        char current = Current(state);
        string token = "";
        If (current == '\0')
        {
            token = IO.Kinal.Compiler.Lex.Token.Encode(TokenKind.Eof, "", line, column);
        }
        ElseIf (IsIdentifierStart(current))
        {
            token = ReadIdentifier(state, line, column);
        }
        ElseIf (IsDigit(current))
        {
            token = ReadNumber(state, line, column);
        }
        ElseIf (current == '"')
        {
            token = ReadString(state, line, column);
        }
        ElseIf (current == '\'')
        {
            token = ReadCharacter(state, line, column);
        }
        Else
        {
            token = ReadSymbol(state, line, column);
        }
        tokens.Add(token);
        If (IO.Kinal.Compiler.Lex.Token.Kind(token) == TokenKind.BadString)
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Lexer", "Unterminated string",
                IO.Kinal.Compiler.Lex.Token.Text(token), IO.Kinal.Compiler.Lex.Token.Line(token),
                IO.Kinal.Compiler.Lex.Token.Column(token), 1);
        }
        ElseIf (IO.Kinal.Compiler.Lex.Token.Kind(token) == TokenKind.BadCharacter)
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Parser", "Invalid Character Literal",
                IO.Kinal.Compiler.Lex.Token.Text(token), IO.Kinal.Compiler.Lex.Token.Line(token),
                IO.Kinal.Compiler.Lex.Token.Column(token), 1);
        }
        If (IO.Kinal.Compiler.Lex.Token.Kind(token) == TokenKind.Eof) Break;
    }
    Return tokens;
}

Unit IO.Kinal.Compiler.Lex.TokenKind;

Enum TokenKind By int
{
    Eof = 0,
    Identifier,
    Number,
    String,
    BadString,
    Character,
    BadCharacter,

    KwUnit,
    KwGet,
    KwSet,
    KwAlias,
    KwBy,
    KwProperty,
    KwFunction,
    KwReturn,
    KwIf,
    KwElse,
    KwElseIf,
    KwWhile,
    KwFor,
    KwForeach,
    KwSwitch,
    KwCase,
    KwBreak,
    KwContinue,
    KwTry,
    KwCatch,
    KwThrow,
    KwConst,
    KwVar,
    KwSafe,
    KwTrusted,
    KwUnsafe,
    KwAsync,
    KwAwait,
    KwExtern,
    KwClass,
    KwInterface,
    KwStruct,
    KwEnum,
    KwPublic,
    KwPrivate,
    KwProtected,
    KwInternal,
    KwStatic,
    KwVirtual,
    KwOverride,
    KwAbstract,
    KwSealed,
    KwConstructor,
    KwNew,
    KwThis,
    KwBase,
    KwBlock,
    KwRecord,
    KwJump,
    KwDelegate,
    KwTrue,
    KwFalse,
    KwIs,
    KwIn,
    KwDefault,
    KwNull,

    TypeVoid,
    TypeBool,
    TypeByte,
    TypeChar,
    TypeInt,
    TypeFloat,
    TypeF16,
    TypeF32,
    TypeF64,
    TypeF128,
    TypeI8,
    TypeI16,
    TypeI32,
    TypeI64,
    TypeU8,
    TypeU16,
    TypeU32,
    TypeU64,
    TypeIsize,
    TypeUsize,
    TypeString,
    TypeAny,

    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Comma,
    Semicolon,
    Dot,
    Colon,
    Question,
    At,

    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Assign,
    PlusPlus,
    MinusMinus,
    PlusAssign,
    MinusAssign,
    StarAssign,
    SlashAssign,
    PercentAssign,

    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    AndAnd,
    OrOr,
    Not,
    Ampersand,
    BitOr,
    Xor,
    ShiftLeft,
    ShiftRight,
    Tilde
}

Safe Function string Name(int kind)
{
    If (kind == [int](TokenKind.Eof)) Return "Eof";
    If (kind == [int](TokenKind.Identifier)) Return "Identifier";
    If (kind == [int](TokenKind.Number)) Return "Number";
    If (kind == [int](TokenKind.String)) Return "String";
    If (kind == [int](TokenKind.BadString)) Return "BadString";
    If (kind == [int](TokenKind.Character)) Return "Character";
    If (kind == [int](TokenKind.BadCharacter)) Return "BadCharacter";
    If (kind == [int](TokenKind.KwUnit)) Return "KwUnit";
    Return "Token(" + [string](kind) + ")";
}

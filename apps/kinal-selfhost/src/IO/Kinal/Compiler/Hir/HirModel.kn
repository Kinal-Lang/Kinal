Unit IO.Kinal.Compiler.Hir.HirModel;

Get IO.Kinal.Compiler.Lex.TokenKind;
Get IO.Kinal.Compiler.Syntax.Nodes;
Get IO.Kinal.Compiler.Sema.Symbols;
Get IO.Kinal.Compiler.Types.TypeSymbol;

Enum HirExpressionKind By int
{
    Invalid = 0,
    Constant,
    Local,
    Global,
    Delegate,
    FunctionReference,
    Namespace,
    Field,
    Unary,
    Binary,
    Conditional,
    Call,
    Index,
    NewObject,
    Cast,
    ArrayLiteral,
    DictLiteral,
    DictEntry,
    Switch,
    SwitchCase,
    PackageLiteral,
    PropertyAccess
}

Enum HirCallKind By int
{
    None = 0,
    UnitFunction,
    InstanceMethod,
    RuntimeBuiltin,
    Constructor,
    DynamicFunction,
    Delegate
}

Class HirExpression
{
    Public int Kind;
    Public int CallKind;
    Public ExpressionNode Syntax;
    Public TypeSymbol Type;
    Public TypeSymbol AsyncResultType;
    // Sema-selected scalar coercion, distinct from a comparison's bool result.
    Public TypeSymbol OperandType;
    Public ValueSymbol Symbol;
    Public FunctionSymbol Function;
    Public FunctionSymbol PropertySetter;
    Public string Name;
    Public string Target;
    Public TokenKind Operator;
    Public bool HasPrimaryError;
    Public bool HasArrayStorageBound;
    // One-based hint into a Native function's root table. Zero means unseen.
    Public i32 NativeRootHint;
    Public HirExpression Left;
    Public HirExpression Right;
    Public HirExpression Third;
    Public HirExpression FirstArgument;
    Private HirExpression LastArgument;
    Public HirExpression Next;

    Public Safe Constructor(int kind, ExpressionNode syntax, TypeSymbol type)
    {
        This.Kind = kind;
        This.CallKind = [int](HirCallKind.None);
        This.Syntax = syntax;
        This.Type = type;
        This.AsyncResultType = null;
        This.OperandType = null;
        This.Symbol = null;
        This.Function = null;
        This.Name = syntax == null ? "" : syntax.Text;
        This.Target = "";
        This.Operator = syntax == null ? TokenKind.Eof : syntax.Operator;
        This.HasPrimaryError = false;
        This.Left = null;
        This.Right = null;
        This.Third = null;
        This.FirstArgument = null;
        This.LastArgument = null;
        This.Next = null;
    }

    Public Safe Function void AddArgument(HirExpression argument)
    {
        If (argument == null) Return;
        If (This.LastArgument == null) This.FirstArgument = argument;
        Else This.LastArgument.Next = argument;
        // A reused operand can already head a chain of arguments.
        This.LastArgument = argument;
        While (This.LastArgument.Next != null) This.LastArgument = This.LastArgument.Next;
    }

    Public Safe Function HirExpression TakeArguments()
    {
        HirExpression first = This.FirstArgument;
        This.FirstArgument = null;
        This.LastArgument = null;
        Return first;
    }
}

Class HirStatement
{
    Public int Kind;
    Public string Name;
    Public TypeSymbol DeclaredType;
    Public ValueSymbol DeclaredSymbol;
    Public HirExpression Expression;
    Public HirExpression SecondExpression;
    Public int FixedArrayLength;
    Public HirExpression ThirdExpression;
    Public HirStatement Initializer;
    Public HirStatement FirstChild;
    Public HirStatement ElseBranch;
    Public HirStatement Next;

    Public Safe Constructor(int kind)
    {
        This.Kind = kind;
        This.Name = "";
        This.DeclaredType = null;
        This.DeclaredSymbol = null;
        This.Expression = null;
        This.SecondExpression = null;
        This.FixedArrayLength = -1;
        This.ThirdExpression = null;
        This.Initializer = null;
        This.FirstChild = null;
        This.ElseBranch = null;
        This.Next = null;
    }

    Public Safe Function void AddChild(HirStatement child)
    {
        If (This.FirstChild == null)
        {
            This.FirstChild = child;
            Return;
        }
        HirStatement current = This.FirstChild;
        While (current.Next != null) current = current.Next;
        current.Next = child;
    }
}

Class HirFunction
{
    Public FunctionSymbol Symbol;
    Public HirStatement Body;
    Public HirFunction Next;

    Public Safe Constructor(FunctionSymbol symbol)
    {
        This.Symbol = symbol;
        This.Body = null;
        This.Next = null;
    }
}

Class HirGlobal
{
    Public GlobalSymbol Symbol;
    Public HirExpression Initializer;
    Public HirGlobal Next;

    Public Safe Constructor(GlobalSymbol symbol, HirExpression initializer)
    {
        This.Symbol = symbol;
        This.Initializer = initializer;
        This.Next = null;
    }
}

Class HirModule
{
    Public string UnitName;
    Public HirGlobal FirstGlobal;
    Private HirGlobal LastGlobal;
    Public HirFunction FirstFunction;
    Private HirFunction LastFunction;
    Public HirModule Next;

    Public Safe Constructor(string unitName)
    {
        This.UnitName = unitName;
        This.FirstGlobal = null;
        This.FirstFunction = null;
        This.Next = null;
    }

    Public Safe Function void AddGlobal(HirGlobal global)
    {
        If (This.LastGlobal == null) This.FirstGlobal = global;
        Else This.LastGlobal.Next = global;
        This.LastGlobal = global;
    }

    Public Safe Function void AddFunction(HirFunction function)
    {
        If (This.LastFunction == null) This.FirstFunction = function;
        Else This.LastFunction.Next = function;
        This.LastFunction = function;
    }
}

// Both backends index the completed HIR without changing module or declaration order.
Class HirDefinitionIndex
{
    Private list Functions;
    Private list Globals;

    Public Safe Constructor(HirModule module, int functionCount, int globalCount)
    {
        This.Functions = list.Create();
        This.Globals = list.Create();
        For (int functionIndex = 0; functionIndex < functionCount; functionIndex++) This.Functions.Add(null);
        For (int globalIndex = 0; globalIndex < globalCount; globalIndex++) This.Globals.Add(null);
        While (module != null)
        {
            HirFunction function = module.FirstFunction;
            While (function != null)
            {
                int index = function.Symbol.RegistrationIndex;
                If (index >= 0 && index < functionCount && [HirFunction](This.Functions.Fetch(index)) == null)
                    This.Functions.Set(index, function);
                function = function.Next;
            }
            HirGlobal global = module.FirstGlobal;
            While (global != null)
            {
                int index = global.Symbol.Value.GlobalIndex;
                If (index >= 0 && index < globalCount && [HirGlobal](This.Globals.Fetch(index)) == null)
                    This.Globals.Set(index, global);
                global = global.Next;
            }
            module = module.Next;
        }
    }

    Public Safe Function HirFunction FindFunction(FunctionSymbol symbol)
    {
        If (symbol == null || symbol.RegistrationIndex < 0 || symbol.RegistrationIndex >= This.Functions.Count())
            Return null;
        HirFunction function = [HirFunction](This.Functions.Fetch(symbol.RegistrationIndex));
        Return function != null && function.Symbol == symbol ? function : null;
    }

    Public Safe Function HirExpression FindInitializer(GlobalSymbol symbol)
    {
        If (symbol == null || symbol.Value.GlobalIndex < 0 || symbol.Value.GlobalIndex >= This.Globals.Count())
            Return null;
        HirGlobal global = [HirGlobal](This.Globals.Fetch(symbol.Value.GlobalIndex));
        Return global != null && global.Symbol == symbol ? global.Initializer : null;
    }
}

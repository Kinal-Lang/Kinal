Unit IO.Kinal.Compiler.Backend.LlvmModel;

Get IO.Kinal.Compiler.Types.TypeSymbol;
Get IO.Kinal.Compiler.Sema.Symbols;
Get IO.Kinal.Compiler.Hir.HirModel;

Class LlvmValue
{
    Public byte* Handle;
    Public TypeSymbol Type;
    Public byte* Address;

    Public Safe Constructor(byte* handle, TypeSymbol type)
    {
        This.Handle = handle;
        This.Type = type;
        This.Address = null;
    }
}

Class LlvmTypeBinding
{
    Public TypeSymbol Symbol;
    Public byte* Handle;
    Public byte* StructHandle;
    Public int RuntimeTypeId;
    Public LlvmTypeBinding Next;

    Public Safe Constructor(TypeSymbol symbol, byte* handle, byte* structHandle,
                            int runtimeTypeId)
    {
        This.Symbol = symbol;
        This.Handle = handle;
        This.StructHandle = structHandle;
        This.RuntimeTypeId = runtimeTypeId;
        This.Next = null;
    }
}

Class LlvmFunctionBinding
{
    Public FunctionSymbol Symbol;
    Public byte* FunctionType;
    Public byte* Function;
    Public byte* AsyncBodyFunctionType;
    Public byte* AsyncBodyFunction;
    Public byte* AsyncEnvironmentType;
    Public byte* AsyncRunnerFunctionType;
    Public byte* AsyncRunnerFunction;
    Public byte* CallableWrapperType;
    Public byte* CallableWrapper;
    Public bool UsesCAbi;
    Public LlvmFunctionBinding Next;

    Public Safe Constructor(FunctionSymbol symbol, byte* functionType, byte* function, bool usesCAbi)
    {
        This.Symbol = symbol;
        This.FunctionType = functionType;
        This.Function = function;
        This.AsyncBodyFunctionType = null;
        This.AsyncBodyFunction = null;
        This.AsyncEnvironmentType = null;
        This.AsyncRunnerFunctionType = null;
        This.AsyncRunnerFunction = null;
        This.CallableWrapperType = null;
        This.CallableWrapper = null;
        This.UsesCAbi = usesCAbi;
        This.Next = null;
    }
}

Class LlvmGlobalBinding
{
    Public GlobalSymbol Symbol;
    Public HirExpression Initializer;
    Public byte* Address;
    Public byte* StaticStorage;
    Public byte* StaticStorageSize;
    Public LlvmGlobalBinding Next;

    Public Safe Constructor(GlobalSymbol symbol, byte* address)
    {
        This.Symbol = symbol;
        This.Initializer = null;
        This.Address = address;
        This.StaticStorage = null;
        This.StaticStorageSize = null;
        This.Next = null;
    }
}

Class LlvmDelegateBinding
{
    Public FunctionSymbol Symbol;
    Public byte* FunctionType;
    Public byte* Address;
    Public bool UsesCAbi;
    Public LlvmDelegateBinding Next;

    Public Safe Constructor(FunctionSymbol symbol, byte* functionType,
                            byte* address, bool usesCAbi)
    {
        This.Symbol = symbol;
        This.FunctionType = functionType;
        This.Address = address;
        This.UsesCAbi = usesCAbi;
        This.Next = null;
    }
}

Class LlvmDelegateAdapter
{
    Public FunctionSymbol Delegate;
    Public FunctionSymbol Target;
    Public byte* Function;
    Public LlvmDelegateAdapter Next;

    Public Safe Constructor(FunctionSymbol delegate, FunctionSymbol target, byte* function)
    {
        This.Delegate = delegate;
        This.Target = target;
        This.Function = function;
        This.Next = null;
    }
}

Class LlvmVariable
{
    Public string Name;
    Public ValueSymbol Symbol;
    Public TypeSymbol Type;
    Public byte* Address;
    Public LlvmVariable Next;

    Public Safe Constructor(string name, ValueSymbol symbol, TypeSymbol type, byte* address)
    {
        This.Name = name;
        This.Symbol = symbol;
        This.Type = type;
        This.Address = address;
        This.Next = null;
    }
}

// A captured declaration owns one entry-registered pointer slot. Its heap
// cell is replaced each time the lexical declaration executes.
Class LlvmCaptureRoot
{
    Public ValueSymbol Symbol;
    Public byte* Address;
    Public LlvmCaptureRoot Next;

    Public Safe Constructor(ValueSymbol symbol, byte* address)
    {
        This.Symbol = symbol;
        This.Address = address;
        This.Next = null;
    }
}

Class LlvmExpressionRoot
{
    Public HirExpression Expression;
    Public TypeSymbol Type;
    Public byte* Address;
    Public LlvmExpressionRoot Next;

    Public Safe Constructor(HirExpression expression, TypeSymbol type, byte* address)
    {
        This.Expression = expression;
        This.Type = type;
        This.Address = address;
        This.Next = null;
    }
}

Class LlvmRecordBinding
{
    Public string Name;
    Public int Ordinal;
    Public byte* Block;
    Public LlvmRecordBinding Next;

    Public Safe Constructor(string name, int ordinal)
    {
        This.Name = name;
        This.Ordinal = ordinal;
        This.Block = null;
        This.Next = null;
    }
}

Class LlvmBlockBinding
{
    Public string Name;
    Public HirStatement Statement;
    Public LlvmRecordBinding FirstRecord;
    Public LlvmRecordBinding LastRecord;
    Public byte* StartBlock;
    Public byte* DoneBlock;
    Public bool Emitted;
    Public LlvmBlockBinding Next;

    Public Safe Constructor(string name, HirStatement statement)
    {
        This.Name = name;
        This.Statement = statement;
        This.FirstRecord = null;
        This.LastRecord = null;
        This.StartBlock = null;
        This.DoneBlock = null;
        This.Emitted = false;
        This.Next = null;
    }

    Public Safe Function void AddRecord(LlvmRecordBinding record)
    {
        If (This.FirstRecord == null)
        {
            This.FirstRecord = record;
            This.LastRecord = record;
        }
        Else
        {
            This.LastRecord.Next = record;
            This.LastRecord = record;
        }
    }

    Public Safe Function LlvmRecordBinding FindRecord(string name)
    {
        LlvmRecordBinding current = This.FirstRecord;
        While (current != null)
        {
            If (current.Name == name) Return current;
            current = current.Next;
        }
        Return null;
    }
}

Class LlvmFunctionContext
{
    Public LlvmFunctionBinding Binding;
    Public LlvmVariable FirstVariable;
    Public LlvmExpressionRoot FirstExpressionRoot;
    Public LlvmCaptureRoot FirstCaptureRoot;
    Public LlvmBlockBinding FirstBlock;
    Public LlvmBlockBinding ActiveBlock;
    Public byte* BreakTarget;
    Public byte* ContinueTarget;
    Public byte* CatchTarget;
    Public byte* ExceptionSlot;
    Public byte* GcFrame;
    Public byte* RuntimeUntilEnabled;
    Public byte* RuntimeUntilOrdinal;
    Public string TraceName;

    Public Safe Constructor(LlvmFunctionBinding binding)
    {
        This.Binding = binding;
        This.FirstVariable = null;
        This.FirstExpressionRoot = null;
        This.FirstCaptureRoot = null;
        This.FirstBlock = null;
        This.ActiveBlock = null;
        This.BreakTarget = null;
        This.ContinueTarget = null;
        This.CatchTarget = null;
        This.ExceptionSlot = null;
        This.GcFrame = null;
        This.RuntimeUntilEnabled = null;
        This.RuntimeUntilOrdinal = null;
        This.TraceName = binding.Symbol.QualifiedName();
    }

    Public Safe Function void AddVariable(LlvmVariable variable)
    {
        variable.Next = This.FirstVariable;
        This.FirstVariable = variable;
    }

    Public Safe Function LlvmVariable FindVariable(ValueSymbol symbol, string name)
    {
        LlvmVariable current = This.FirstVariable;
        While (current != null)
        {
            If ((symbol != null && current.Symbol == symbol) ||
                (symbol == null && current.Name == name)) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function void AddExpressionRoot(LlvmExpressionRoot root)
    {
        root.Next = This.FirstExpressionRoot;
        This.FirstExpressionRoot = root;
    }

    Public Safe Function void AddCaptureRoot(LlvmCaptureRoot root)
    {
        root.Next = This.FirstCaptureRoot;
        This.FirstCaptureRoot = root;
    }

    Public Safe Function LlvmCaptureRoot FindCaptureRoot(ValueSymbol symbol)
    {
        LlvmCaptureRoot current = This.FirstCaptureRoot;
        While (current != null)
        {
            If (current.Symbol == symbol) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function LlvmExpressionRoot FindExpressionRoot(HirExpression expression)
    {
        LlvmExpressionRoot current = This.FirstExpressionRoot;
        While (current != null)
        {
            If (current.Expression == expression) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function void AddBlock(LlvmBlockBinding binding)
    {
        binding.Next = This.FirstBlock;
        This.FirstBlock = binding;
    }

    Public Safe Function LlvmBlockBinding FindBlock(string name)
    {
        LlvmBlockBinding current = This.FirstBlock;
        While (current != null)
        {
            If (current.Name == name) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function string VariableNames()
    {
        string result = "";
        LlvmVariable current = This.FirstVariable;
        While (current != null)
        {
            If (result != "") result = result + ",";
            result = result + current.Name;
            current = current.Next;
        }
        Return result;
    }
}

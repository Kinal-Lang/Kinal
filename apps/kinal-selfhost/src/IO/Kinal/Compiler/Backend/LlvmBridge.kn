Enum LlvmIntPredicate By int
{
    Equal = 32,
    NotEqual = 33,
    UnsignedGreater = 34,
    UnsignedGreaterEqual = 35,
    UnsignedLess = 36,
    UnsignedLessEqual = 37,
    SignedGreater = 38,
    SignedGreaterEqual = 39,
    SignedLess = 40,
    SignedLessEqual = 41
}

Enum LlvmFloatPredicate By int
{
    OrderedEqual = 1,
    OrderedGreater = 2,
    OrderedGreaterEqual = 3,
    OrderedLess = 4,
    OrderedLessEqual = 5,
    OrderedNotEqual = 6
}

Trusted Function int VersionMajor()
{
    Return NativeVersionMajor();
}

Trusted Function string LastError()
{
    string detail = NativeLastError();
    Return detail == null ? "" : detail;
}

Trusted Function string ExecutablePath()
{
    string path = NativeExecutablePath();
    Return path == null ? "" : path;
}

Trusted Function int Execute(string commandLine)
{
    Return NativeExecute(commandLine);
}

Class LlvmHandles
{
    Private byte* Handle;

    Public Trusted Constructor()
    {
        This.Handle = NativeHandlesCreate();
    }

    Public Safe Function bool IsValid()
    {
        Return This.Handle != null;
    }

    Public Trusted Function bool Add(byte* handle)
    {
        Return This.Handle != null && handle != null && NativeHandlesAdd(This.Handle, handle) != 0;
    }

    Public Trusted Function int Count()
    {
        Return This.Handle == null ? 0 : NativeHandlesCount(This.Handle);
    }

    Public Trusted Function byte* Fetch(int index)
    {
        Return This.Handle == null ? null : NativeHandlesGet(This.Handle, index);
    }

    Public Safe Function byte* Raw()
    {
        Return This.Handle;
    }
}

Class LlvmModule
{
    Private byte* Handle;

    Public Trusted Constructor(string name)
    {
        This.Handle = NativeModuleCreate(name);
    }

    Public Safe Function bool IsValid()
    {
        Return This.Handle != null;
    }

    Public Trusted Function bool BuildProbe(string functionName, int returnValue)
    {
        If (This.Handle == null) Return false;
        Return NativeBuildProbe(This.Handle, functionName, returnValue) != 0;
    }

    Public Trusted Function string Ir()
    {
        If (This.Handle == null) Return "";
        Return NativeModuleIr(This.Handle);
    }

    Public Trusted Function bool EmitObject(string targetTriple, string outputPath)
    {
        If (This.Handle == null) Return false;
        Return NativeEmitObject(This.Handle, targetTriple, outputPath) != 0;
    }

    Public Trusted Function byte* VoidType() { Return NativeTypeVoid(This.Handle); }
    Public Trusted Function byte* IntType(int bits) { Return NativeTypeInt(This.Handle, bits); }
    Public Trusted Function byte* FloatType(int bits) { Return NativeTypeFloat(This.Handle, bits); }
    Public Trusted Function byte* PointerType(byte* elementType) { Return NativeTypePointer(elementType); }
    Public Trusted Function byte* NamedStructType(string name) { Return NativeTypeNamedStruct(This.Handle, name); }
    Public Trusted Function byte* LiteralStructType(LlvmHandles fields, bool packed)
    {
        Return NativeTypeLiteralStruct(This.Handle, fields.Raw(), packed ? 1 : 0);
    }
    Public Trusted Function bool SetStructBody(byte* type, LlvmHandles fields, bool packed)
    {
        Return NativeTypeSetStructBody(type, fields.Raw(), packed ? 1 : 0) != 0;
    }
    Public Trusted Function byte* FunctionType(byte* returnType, LlvmHandles parameters, bool variadic)
    {
        Return NativeTypeFunction(returnType, parameters.Raw(), variadic ? 1 : 0);
    }
    Public Trusted Function byte* ArrayType(byte* elementType, int count) { Return NativeTypeArray(elementType, count); }
    Public Trusted Function byte* TypeOf(byte* value) { Return NativeTypeOf(value); }

    Public Trusted Function byte* AddFunction(string name, byte* functionType)
    {
        Return NativeAddFunction(This.Handle, name, functionType);
    }
    Public Trusted Function byte* GetFunction(string name) { Return NativeGetFunction(This.Handle, name); }
    Public Trusted Function byte* Parameter(byte* function, int index) { Return NativeGetParameter(function, index); }
    Public Trusted Function byte* AppendBlock(byte* function, string name)
    {
        Return NativeAppendBlock(This.Handle, function, name);
    }
    Public Trusted Function void PositionAtEnd(byte* block) { NativePositionAtEnd(This.Handle, block); }
    Public Trusted Function byte* CurrentBlock() { Return NativeCurrentBlock(This.Handle); }
    Public Trusted Function bool IsTerminated(byte* block) { Return NativeBlockIsTerminated(block) != 0; }
    Public Trusted Function byte* ConstInt(byte* type, int value)
    {
        Return NativeConstInt(type, [i64](value), value < 0 ? 1 : 0);
    }
    Public Trusted Function byte* ConstI64(byte* type, i64 value, bool signedValue)
    {
        Return NativeConstInt(type, value, signedValue ? 1 : 0);
    }
    Public Trusted Function byte* ConstFloat(byte* type, float value) { Return NativeConstFloat(type, value); }
    Public Trusted Function byte* ConstNull(byte* type) { Return NativeConstNull(type); }
    Public Trusted Function byte* ConstUndef(byte* type) { Return NativeConstUndef(type); }
    Public Trusted Function byte* GlobalString(string text, string name)
    {
        Return NativeBuildGlobalString(This.Handle, text, name);
    }

    Public Trusted Function byte* Alloca(byte* type, string name) { Return NativeBuildAlloca(This.Handle, type, name); }
    Public Trusted Function byte* Load(byte* type, byte* pointer, string name) { Return NativeBuildLoad(This.Handle, type, pointer, name); }
    Public Trusted Function byte* Store(byte* value, byte* pointer) { Return NativeBuildStore(This.Handle, value, pointer); }
    Public Trusted Function byte* StructGep(byte* structType, byte* pointer, int index, string name)
    {
        Return NativeBuildStructGep(This.Handle, structType, pointer, index, name);
    }
    Public Trusted Function byte* Gep(byte* elementType, byte* pointer, LlvmHandles indices, bool inBounds, string name)
    {
        Return NativeBuildGep(This.Handle, elementType, pointer, indices.Raw(), inBounds ? 1 : 0, name);
    }
    Public Trusted Function byte* ExtractValue(byte* aggregate, int index, string name)
    {
        Return NativeBuildExtractValue(This.Handle, aggregate, index, name);
    }
    Public Trusted Function byte* InsertValue(byte* aggregate, byte* value, int index, string name)
    {
        Return NativeBuildInsertValue(This.Handle, aggregate, value, index, name);
    }
    Public Trusted Function byte* SizeOf(byte* type) { Return NativeBuildSizeOf(type); }

    Public Trusted Function byte* Add(byte* left, byte* right, string name) { Return NativeBuildAdd(This.Handle, left, right, name); }
    Public Trusted Function byte* Subtract(byte* left, byte* right, string name) { Return NativeBuildSub(This.Handle, left, right, name); }
    Public Trusted Function byte* Multiply(byte* left, byte* right, string name) { Return NativeBuildMul(This.Handle, left, right, name); }
    Public Trusted Function byte* SignedDivide(byte* left, byte* right, string name) { Return NativeBuildSignedDivide(This.Handle, left, right, name); }
    Public Trusted Function byte* SignedRemainder(byte* left, byte* right, string name) { Return NativeBuildSignedRemainder(This.Handle, left, right, name); }
    Public Trusted Function byte* UnsignedDivide(byte* left, byte* right, string name) { Return NativeBuildUnsignedDivide(This.Handle, left, right, name); }
    Public Trusted Function byte* UnsignedRemainder(byte* left, byte* right, string name) { Return NativeBuildUnsignedRemainder(This.Handle, left, right, name); }
    Public Trusted Function byte* FloatAdd(byte* left, byte* right, string name) { Return NativeBuildFloatAdd(This.Handle, left, right, name); }
    Public Trusted Function byte* FloatSubtract(byte* left, byte* right, string name) { Return NativeBuildFloatSubtract(This.Handle, left, right, name); }
    Public Trusted Function byte* FloatMultiply(byte* left, byte* right, string name) { Return NativeBuildFloatMultiply(This.Handle, left, right, name); }
    Public Trusted Function byte* FloatDivide(byte* left, byte* right, string name) { Return NativeBuildFloatDivide(This.Handle, left, right, name); }
    Public Trusted Function byte* And(byte* left, byte* right, string name) { Return NativeBuildAnd(This.Handle, left, right, name); }
    Public Trusted Function byte* Or(byte* left, byte* right, string name) { Return NativeBuildOr(This.Handle, left, right, name); }
    Public Trusted Function byte* Xor(byte* left, byte* right, string name) { Return NativeBuildXor(This.Handle, left, right, name); }
    Public Trusted Function byte* ShiftLeft(byte* left, byte* right, string name) { Return NativeBuildShiftLeft(This.Handle, left, right, name); }
    Public Trusted Function byte* ShiftRight(byte* left, byte* right, string name) { Return NativeBuildArithmeticShiftRight(This.Handle, left, right, name); }
    Public Trusted Function byte* LogicalShiftRight(byte* left, byte* right, string name) { Return NativeBuildLogicalShiftRight(This.Handle, left, right, name); }
    Public Trusted Function byte* Negate(byte* value, string name) { Return NativeBuildNegate(This.Handle, value, name); }
    Public Trusted Function byte* FloatNegate(byte* value, string name) { Return NativeBuildFloatNegate(This.Handle, value, name); }
    Public Trusted Function byte* Not(byte* value, string name) { Return NativeBuildNot(This.Handle, value, name); }
    Public Trusted Function byte* Compare(int predicate, byte* left, byte* right, string name)
    {
        Return NativeBuildIntegerCompare(This.Handle, predicate, left, right, name);
    }
    Public Trusted Function byte* FloatCompare(int predicate, byte* left, byte* right, string name)
    {
        Return NativeBuildFloatCompare(This.Handle, predicate, left, right, name);
    }
    Public Trusted Function byte* Select(byte* condition, byte* whenTrue, byte* whenFalse, string name)
    {
        Return NativeBuildSelect(This.Handle, condition, whenTrue, whenFalse, name);
    }
    Public Trusted Function byte* BitCast(byte* value, byte* type, string name) { Return NativeBuildBitCast(This.Handle, value, type, name); }
    Public Trusted Function byte* ZeroExtend(byte* value, byte* type, string name) { Return NativeBuildZeroExtend(This.Handle, value, type, name); }
    Public Trusted Function byte* SignExtend(byte* value, byte* type, string name) { Return NativeBuildSignExtend(This.Handle, value, type, name); }
    Public Trusted Function byte* Truncate(byte* value, byte* type, string name) { Return NativeBuildTruncate(This.Handle, value, type, name); }
    Public Trusted Function byte* PointerToInt(byte* value, byte* type, string name) { Return NativeBuildPointerToInt(This.Handle, value, type, name); }
    Public Trusted Function byte* IntToPointer(byte* value, byte* type, string name) { Return NativeBuildIntToPointer(This.Handle, value, type, name); }
    Public Trusted Function byte* SignedIntToFloat(byte* value, byte* type, string name) { Return NativeBuildSignedIntToFloat(This.Handle, value, type, name); }
    Public Trusted Function byte* UnsignedIntToFloat(byte* value, byte* type, string name) { Return NativeBuildUnsignedIntToFloat(This.Handle, value, type, name); }
    Public Trusted Function byte* FloatToSignedInt(byte* value, byte* type, string name) { Return NativeBuildFloatToSignedInt(This.Handle, value, type, name); }
    Public Trusted Function byte* FloatToUnsignedInt(byte* value, byte* type, string name) { Return NativeBuildFloatToUnsignedInt(This.Handle, value, type, name); }

    Public Trusted Function byte* Call(byte* functionType, byte* function, LlvmHandles arguments, string name)
    {
        Return NativeBuildCall(This.Handle, functionType, function, arguments.Raw(), name);
    }
    Public Trusted Function byte* ReturnValue(byte* value) { Return NativeBuildReturn(This.Handle, value); }
    Public Trusted Function byte* ReturnVoid() { Return NativeBuildReturnVoid(This.Handle); }
    Public Trusted Function byte* Branch(byte* destination) { Return NativeBuildBranch(This.Handle, destination); }
    Public Trusted Function byte* ConditionalBranch(byte* condition, byte* whenTrue, byte* whenFalse)
    {
        Return NativeBuildConditionalBranch(This.Handle, condition, whenTrue, whenFalse);
    }
    Public Trusted Function byte* Phi(byte* type, string name) { Return NativeBuildPhi(This.Handle, type, name); }
    Public Trusted Function bool AddIncoming(byte* phi, byte* value, byte* block)
    {
        Return NativePhiAddIncoming(phi, value, block) != 0;
    }
    Public Trusted Function bool Verify() { Return NativeVerifyModule(This.Handle) != 0; }

    Public Trusted Function void Dispose()
    {
        If (This.Handle == null) Return;
        NativeModuleDispose(This.Handle);
        This.Handle = null;
    }
}

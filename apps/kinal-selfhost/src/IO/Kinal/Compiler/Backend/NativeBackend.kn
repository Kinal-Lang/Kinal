    Public Trusted Function byte* EnsureCallableWrapper(LlvmFunctionBinding binding)
    {
        If (binding == null) Return null;
        If (binding.CallableWrapper != null) Return binding.CallableWrapper;

        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* anyPointer = This.Module.PointerType(This.AnyType);
        LlvmHandles wrapperParameters = New LlvmHandles();
        wrapperParameters.Add(bytePointer);
        wrapperParameters.Add(anyPointer);
        wrapperParameters.Add(This.Module.IntType(64));
        byte* wrapperType = This.Module.FunctionType(This.AnyType, wrapperParameters, false);
        byte* wrapper = This.Module.AddFunction("__kn_selfhost_callable_" +
            This.Sanitize(binding.Symbol.QualifiedName()), wrapperType);
        binding.CallableWrapperType = wrapperType;
        binding.CallableWrapper = wrapper;

        byte* savedBlock = This.Module.CurrentBlock();
        byte* entry = This.Module.AppendBlock(wrapper, "entry");
        This.Module.PositionAtEnd(entry);

        LlvmHandles arguments = New LlvmHandles();
        If (binding.Symbol.FirstCapture != null)
        {
            arguments.Add(This.Module.Parameter(wrapper, 0));
        }
        ElseIf (binding.Symbol.OwnerType != null &&
            (!binding.Symbol.Declaration.IsStatic || binding.Symbol.Declaration.IsConstructor))
        {
            byte* receiver = This.Module.BitCast(This.Module.Parameter(wrapper, 0),
                This.TypeHandle(binding.Symbol.OwnerType), This.Unique("callable_receiver"));
            arguments.Add(receiver);
        }
        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        int index = 0;
        byte* argumentData = This.Module.Parameter(wrapper, 1);
        While (parameter != null)
        {
            byte* address = This.Module.Gep(This.AnyType, argumentData,
                This.Types1(This.Module.ConstInt(This.Module.IntType(64), index)), true,
                This.Unique("callable_argument"));
            LlvmValue boxed = New LlvmValue(This.Module.Load(This.AnyType, address,
                This.Unique("callable_any")), This.Semantics.Primitive("any"));
            LlvmValue value = This.UnboxAny(boxed, parameter.Type);
            arguments.Add(binding.UsesCAbi ? This.ToCAbi(value, parameter.Type) :
                value.Handle);
            parameter = parameter.Next;
            index = index + 1;
        }

        string resultName = binding.Symbol.ReturnType.Kind == [int](TypeKind.VoidType) ? "" :
            This.Unique("callable_result");
        byte* result = This.Module.Call(binding.FunctionType, binding.Function, arguments, resultName);
        If (binding.Symbol.ReturnType.Kind == [int](TypeKind.VoidType))
            This.Module.ReturnValue(This.DefaultValue(This.Semantics.Primitive("any")).Handle);
        Else
        {
            LlvmValue value = binding.UsesCAbi ?
                This.FromCAbi(result, binding.Symbol.ReturnType) :
                New LlvmValue(result, binding.Symbol.ReturnType);
            This.Module.ReturnValue(This.BoxAny(value).Handle);
        }

        If (savedBlock != null) This.Module.PositionAtEnd(savedBlock);
        Return wrapper;
    }

    Public Trusted Function byte* EnsureBuiltinCallableWrapper(string target)
    {
        bool console = target == "IO.Console.Print" ||
            target == "IO.Console.PrintLine" || target == "IO.Console.Write" ||
            target == "IO.Console.WriteLine";
        If (!console)
        {
            This.Fail("builtin function reference is not lowered: " + target);
            Return null;
        }

        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* anyPointer = This.Module.PointerType(This.AnyType);
        LlvmHandles parameters = New LlvmHandles();
        parameters.Add(bytePointer);
        parameters.Add(anyPointer);
        parameters.Add(This.Module.IntType(64));
        byte* wrapperType = This.Module.FunctionType(This.AnyType, parameters, false);
        byte* wrapper = This.Module.AddFunction(This.Unique(
            "__kn_selfhost_builtin_callable_" + This.Sanitize(target) + "_"),
            wrapperType);

        byte* savedBlock = This.Module.CurrentBlock();
        This.Module.PositionAtEnd(This.Module.AppendBlock(wrapper, "entry"));
        byte* arguments = This.Module.BitCast(This.Module.Parameter(wrapper, 1),
            bytePointer, This.Unique("builtin_arguments"));
        bool newline = target == "IO.Console.PrintLine" ||
            target == "IO.Console.WriteLine";
        This.CallRuntime("kn_sh_rt_console_values", This.Types3(arguments,
            This.Module.Parameter(wrapper, 2),
            This.Module.ConstInt(This.Module.IntType(32), newline ? 1 : 0)), "");
        This.Module.ReturnValue(This.DefaultValue(This.Semantics.Primitive("any")).Handle);
        If (savedBlock != null) This.Module.PositionAtEnd(savedBlock);
        Return wrapper;
    }

    Public Trusted Function void EmitMetaDictString(byte* dictionary, string key, string value)

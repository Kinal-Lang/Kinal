                This.Semantics.Primitive("string"));
            byte* exists = This.RuntimeBool(This.CallRuntime("__kn_sys_file_exists",
                This.Types1(path.Handle), This.Unique("file_exists_c")));
            byte* contents = This.CallRuntime("__kn_file_read_all_text",
                This.Types1(path.Handle), This.Unique("file_contents"));
            Return New LlvmValue(This.Module.Select(exists, contents,
                This.Module.ConstNull(This.Module.PointerType(This.Module.IntType(8))),
                This.Unique("file_read_if")), This.Semantics.Primitive("string"));
        }
        If (target == "IO.File.Exists") runtimeName = "__kn_sys_file_exists";
        ElseIf (target == "IO.File.Create") runtimeName = "__kn_file_create";
        ElseIf (target == "IO.File.Touch") runtimeName = "__kn_file_touch";
        ElseIf (target == "IO.File.ReadAllText") runtimeName = "__kn_file_read_all_text";
        ElseIf (target == "IO.File.ReadFirstLine") runtimeName = "__kn_file_read_first_line";
        ElseIf (target == "IO.File.WriteAllText") runtimeName = "__kn_file_write_all_text";
        ElseIf (target == "IO.File.AppendAllText") runtimeName = "__kn_file_append_all_text";
        ElseIf (target == "IO.File.AppendLine") runtimeName = "__kn_file_append_line";
        ElseIf (target == "IO.File.Delete") runtimeName = "__kn_file_delete";
        ElseIf (target == "IO.File.DeleteIfExists") runtimeName = "__kn_file_delete_if_exists";
        ElseIf (target == "IO.File.Size") runtimeName = "__kn_file_size";
        ElseIf (target == "IO.File.IsEmpty") runtimeName = "__kn_file_is_empty";
        ElseIf (target == "IO.File.Copy") runtimeName = "__kn_file_copy";
        ElseIf (target == "IO.File.Move") runtimeName = "__kn_file_move";
        ElseIf (target == "IO.File.ReplaceText") runtimeName = "__kn_file_replace_text";
        ElseIf (target == "IO.Directory.Exists") runtimeName = "__kn_dir_exists";
        ElseIf (target == "IO.Directory.Files") runtimeName = "__kn_dir_files";
        ElseIf (target == "IO.Path.Combine") runtimeName = "__kn_path_combine";
        ElseIf (target == "IO.Path.Join3") runtimeName = "__kn_path_join3";
        ElseIf (target == "IO.Path.Join4") runtimeName = "__kn_path_join4";
        ElseIf (target == "IO.Path.FileName") runtimeName = "__kn_path_file_name";
        ElseIf (target == "IO.Path.Extension") runtimeName = "__kn_path_extension";
        ElseIf (target == "IO.Path.Directory") runtimeName = "__kn_path_directory";
        ElseIf (target == "IO.Path.Normalize") runtimeName = "__kn_path_normalize";
        ElseIf (target == "IO.Path.CurrentDirectory") runtimeName = "__kn_path_cwd";
        ElseIf (target == "IO.Path.ChangeExtension") runtimeName = "__kn_path_change_extension";
        ElseIf (target == "IO.Path.IsAbsolute") runtimeName = "__kn_path_is_absolute";
        ElseIf (target == "IO.Path.BaseName") runtimeName = "__kn_path_base_name";
        ElseIf (target == "IO.Path.EnsureTrailingSeparator") runtimeName = "__kn_path_ensure_trailing_separator";
        ElseIf (target == "IO.Text.Contains") runtimeName = "__kn_text_contains";
        ElseIf (target == "IO.Text.StartsWith") runtimeName = "__kn_text_starts_with";
        ElseIf (target == "IO.Text.EndsWith") runtimeName = "__kn_text_ends_with";
        ElseIf (target == "IO.Text.IndexOf") runtimeName = "__kn_text_index_of";
        ElseIf (target == "IO.Text.LastIndexOf") runtimeName = "__kn_text_last_index_of";
        ElseIf (target == "IO.Text.Trim") runtimeName = "__kn_text_trim";
        ElseIf (target == "IO.Text.Replace") runtimeName = "__kn_text_replace";
        ElseIf (target == "IO.Text.ToUpper") runtimeName = "__kn_text_to_upper";
        ElseIf (target == "IO.Text.ToLower") runtimeName = "__kn_text_to_lower";
        ElseIf (target == "IO.Text.Slice") runtimeName = "__kn_text_slice";
        ElseIf (target == "IO.Text.Count") runtimeName = "__kn_text_count";
        ElseIf (target == "IO.Text.Split") runtimeName = "__kn_text_split";
        ElseIf (target == "IO.Text.Lines") runtimeName = "__kn_text_lines";
        ElseIf (target == "IO.Text.Length") runtimeName = "kn_sh_rt_string_length";
        ElseIf (target == "IO.Text.IsEmpty")
        {
            LlvmValue text = This.CastValue(This.EmitExpression(context, first), This.Semantics.Primitive("string"));
            byte* length = This.CallRuntime("kn_sh_rt_string_length", This.Types1(text.Handle), This.Unique("text_length"));
            Return New LlvmValue(This.Module.Compare([int](LlvmIntPredicate.Equal), length,
                This.Module.ConstInt(This.Module.IntType(64), 0), This.Unique("text_empty")),
                This.Semantics.Primitive("bool"));
        }

        If (!IO.Text.IsEmpty(runtimeName))
        {
            LlvmHandles arguments = New LlvmHandles();
            HirExpression argument = first;
            int parameterIndex = 0;
            While (argument != null)
            {
                LlvmValue value = This.EmitExpression(context, argument);
                If (target == "IO.Directory.Files" && parameterIndex == 1)
                    arguments.Add(This.Module.ZeroExtend(value.Handle, This.Module.IntType(32), This.Unique("recursive")));
                Else arguments.Add(value.Handle);
                parameterIndex = parameterIndex + 1;
                argument = argument.Next;
            }
            byte* raw = This.CallRuntime(runtimeName, arguments,
                expression.Type.Kind == [int](TypeKind.VoidType) ? "" : This.Unique("runtime"));
            Return New LlvmValue(boolResult ? This.RuntimeBool(raw) : raw, expression.Type);
        }

        This.Fail("unsupported runtime builtin: " + target);
        Return This.DefaultValue(expression.Type);
    }

    Public Trusted Function LlvmValue EmitNewObject(LlvmFunctionContext context, HirExpression expression)
    {
        TypeSymbol type = expression.Type;
        LlvmTypeBinding typeBinding = This.FindTypeBinding(type);
        If (typeBinding == null)
        {
            This.Fail("missing class layout: " + type.QualifiedName());
            Return This.DefaultValue(type);
        }
        byte* size = This.Module.SizeOf(typeBinding.StructHandle);
        byte* memory = This.CallRuntime("__kn_gc_alloc", This.Types1(size), This.Unique("object_memory"));
        byte* object = This.Module.BitCast(memory, typeBinding.Handle, This.Unique("object"));
        byte* vtable = This.Module.StructGep(typeBinding.StructHandle, object, 0, This.Unique("vtable_slot"));
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        This.Module.Store(This.Module.ConstNull(This.Module.PointerType(bytePointer)), vtable);

        int fieldIndex = 1;
        FieldDecl field = type.Declaration.FirstField;
        SyntaxTree definingSyntax = This.Semantics.FindUnit(type.UnitName).Syntax;
        While (field != null)
        {
            If (!field.IsStatic)
            {
                TypeSymbol fieldType = This.Semantics.ResolveType(definingSyntax, field.TypeName);
                byte* address = This.Module.StructGep(typeBinding.StructHandle, object, fieldIndex, This.Unique("field_init"));
                This.Module.Store(This.DefaultValue(fieldType).Handle, address);
                fieldIndex = fieldIndex + 1;
            }
            field = field.Next;
        }

        int count = This.HirArgumentCount(expression);
        LlvmFunctionBinding constructor = This.FirstFunction;
        While (constructor != null)
        {
            If (constructor.Symbol.OwnerType == type && constructor.Symbol.Declaration.IsConstructor &&
                constructor.Symbol.ParameterCount() == count) Break;
            constructor = constructor.Next;
        }
        If (constructor != null)
            This.EmitFunctionCall(context, constructor, expression, New LlvmValue(object, type));
        ElseIf (count != 0)
            This.Fail("constructor is not declared: " + type.QualifiedName());
        Return New LlvmValue(object, type);
    }

    Public Trusted Function LlvmValue EmitShortCircuit(LlvmFunctionContext context,
                                                        HirExpression expression, bool isAnd)
    {
        LlvmValue left = This.CastValue(This.EmitExpression(context, expression.Left),
            This.Semantics.Primitive("bool"));
        byte* leftBlock = This.Module.CurrentBlock();
        byte* function = context.Binding.Function;
        byte* rightBlock = This.Module.AppendBlock(function, This.Unique("logic_right"));
        byte* mergeBlock = This.Module.AppendBlock(function, This.Unique("logic_merge"));
        If (isAnd) This.Module.ConditionalBranch(left.Handle, rightBlock, mergeBlock);
        Else This.Module.ConditionalBranch(left.Handle, mergeBlock, rightBlock);

        This.Module.PositionAtEnd(rightBlock);
        LlvmValue right = This.CastValue(This.EmitExpression(context, expression.Right),
            This.Semantics.Primitive("bool"));
        byte* rightEnd = This.Module.CurrentBlock();
        If (!This.Module.IsTerminated(rightEnd)) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(mergeBlock);
        byte* phi = This.Module.Phi(This.Module.IntType(1), This.Unique("logic"));
        This.Module.AddIncoming(phi, This.Module.ConstInt(This.Module.IntType(1), isAnd ? 0 : 1), leftBlock);
        This.Module.AddIncoming(phi, right.Handle, rightEnd);
        Return New LlvmValue(phi, This.Semantics.Primitive("bool"));
    }

    Public Trusted Function LlvmValue EmitConditional(LlvmFunctionContext context, HirExpression expression)
    {
        LlvmValue condition = This.CastValue(This.EmitExpression(context, expression.Left),
            This.Semantics.Primitive("bool"));
        byte* function = context.Binding.Function;
        byte* trueBlock = This.Module.AppendBlock(function, This.Unique("conditional_true"));
        byte* falseBlock = This.Module.AppendBlock(function, This.Unique("conditional_false"));
        byte* mergeBlock = This.Module.AppendBlock(function, This.Unique("conditional_merge"));
        This.Module.ConditionalBranch(condition.Handle, trueBlock, falseBlock);

        This.Module.PositionAtEnd(trueBlock);
        LlvmValue whenTrue = This.CastValue(This.EmitExpression(context, expression.Right), expression.Type);
        byte* trueEnd = This.Module.CurrentBlock();
        If (!This.Module.IsTerminated(trueEnd)) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(falseBlock);
        LlvmValue whenFalse = This.CastValue(This.EmitExpression(context, expression.Third), expression.Type);
        byte* falseEnd = This.Module.CurrentBlock();
        If (!This.Module.IsTerminated(falseEnd)) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(mergeBlock);
        byte* phi = This.Module.Phi(This.TypeHandle(expression.Type), This.Unique("conditional"));
        This.Module.AddIncoming(phi, whenTrue.Handle, trueEnd);
        This.Module.AddIncoming(phi, whenFalse.Handle, falseEnd);
        Return New LlvmValue(phi, expression.Type);
    }

    Public Trusted Function byte* EmitSwitchMatch(LlvmValue left, LlvmValue right)
    {
        If (left.Type.Kind == [int](TypeKind.StringType))
        {
            right = This.CastValue(right, left.Type);
            Return This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                This.Types2(left.Handle, right.Handle), This.Unique("switch_string_c")));
        }
        If (left.Type.Kind == [int](TypeKind.FloatType) || right.Type.Kind == [int](TypeKind.FloatType))
        {
            TypeSymbol floatType = left.Type.Kind == [int](TypeKind.FloatType) ? left.Type : right.Type;
            left = This.CastValue(left, floatType);
            right = This.CastValue(right, floatType);
            Return This.Module.FloatCompare([int](LlvmFloatPredicate.OrderedEqual), left.Handle,
                right.Handle, This.Unique("switch_float"));
        }
        If (This.IsReferenceType(left.Type) || left.Type.Kind == [int](TypeKind.NullType) ||
            This.IsReferenceType(right.Type) || right.Type.Kind == [int](TypeKind.NullType))
        {
            TypeSymbol comparisonType = left.Type.Kind == [int](TypeKind.NullType) ? right.Type : left.Type;
            left = This.CastValue(left, comparisonType);
            right = This.CastValue(right, comparisonType);
        }
        Else right = This.CastValue(right, left.Type);
        Return This.Module.Compare([int](LlvmIntPredicate.Equal), left.Handle, right.Handle,
            This.Unique("switch_match"));
    }

    Public Trusted Function LlvmValue EmitSwitchExpression(LlvmFunctionContext context,
                                                            HirExpression expression)
    {
        LlvmValue selector = This.EmitExpression(context, expression.Left);
        byte* resultAddress = This.Module.Alloca(This.TypeHandle(expression.Type),
            This.Unique("switch_result"));
        This.Module.Store(This.DefaultValue(expression.Type).Handle, resultAddress);
        byte* mergeBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("switch_merge"));
        HirExpression item = expression.FirstArgument;
        While (item != null)
        {
            If (item.Name == "default")
            {
                LlvmValue value = This.CastValue(This.EmitExpression(context, item.Right), expression.Type);
                This.Module.Store(value.Handle, resultAddress);
                This.Module.Branch(mergeBlock);
                item = item.Next;
                Break;
            }
            byte* valueBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("switch_value"));
            byte* nextBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("switch_next"));
            LlvmValue caseValue = This.EmitExpression(context, item.Left);
            This.Module.ConditionalBranch(This.EmitSwitchMatch(selector, caseValue), valueBlock, nextBlock);
            This.Module.PositionAtEnd(valueBlock);
            LlvmValue value = This.CastValue(This.EmitExpression(context, item.Right), expression.Type);
            This.Module.Store(value.Handle, resultAddress);
            This.Module.Branch(mergeBlock);
            This.Module.PositionAtEnd(nextBlock);
            item = item.Next;
        }
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(mergeBlock);
        This.Module.PositionAtEnd(mergeBlock);
        Return New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), resultAddress,
            This.Unique("switch_result_value")), expression.Type);
    }

    Public Trusted Function LlvmValue EmitBinary(LlvmFunctionContext context, HirExpression expression)
    {
        int operatorKind = expression.Operator;
        If (operatorKind == [int](TokenKind.AndAnd)) Return This.EmitShortCircuit(context, expression, true);
        If (operatorKind == [int](TokenKind.OrOr)) Return This.EmitShortCircuit(context, expression, false);

        bool assignment = operatorKind == [int](TokenKind.Assign) ||
            operatorKind == [int](TokenKind.PlusAssign) || operatorKind == [int](TokenKind.MinusAssign) ||
            operatorKind == [int](TokenKind.StarAssign) || operatorKind == [int](TokenKind.SlashAssign) ||
            operatorKind == [int](TokenKind.PercentAssign);
        If (assignment)
        {
            byte* address = This.EmitAddress(context, expression.Left);
            LlvmValue right = null;
            If (expression.Left.Kind == [int](HirExpressionKind.Delegate) &&
                expression.Right.Kind == [int](HirExpressionKind.FunctionReference))
            {
                LlvmDelegateBinding delegate = This.FindDelegateBinding(expression.Left.Function);
                LlvmFunctionBinding target = This.FindFunctionBinding(expression.Right.Function);
                If (delegate == null || target == null)
                {
                    This.Fail("delegate assignment binding is missing: " + expression.Left.Target);
                    right = This.DefaultValue(expression.Left.Type);
                }
                Else
                {
                    byte* callable = delegate.UsesCAbi ?
                        This.EnsureDelegateAdapter(delegate.Symbol, target.Symbol) : target.Function;
                    right = New LlvmValue(callable, expression.Left.Type);
                }
            }
            Else right = This.CastValue(This.EmitExpression(context, expression.Right), expression.Left.Type);
            If (operatorKind != [int](TokenKind.Assign))
            {
                LlvmValue left = New LlvmValue(This.Module.Load(This.TypeHandle(expression.Left.Type), address,
                    This.Unique("assignment_left")), expression.Left.Type);
                If (operatorKind == [int](TokenKind.PlusAssign) && left.Type.Kind == [int](TypeKind.StringType))
                    right = New LlvmValue(This.CallRuntime("kn_sh_rt_string_concat",
                        This.Types2(left.Handle, This.CastValue(right, left.Type).Handle), This.Unique("concat")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == [int](TokenKind.PlusAssign))
                    right = New LlvmValue(This.Module.FloatAdd(left.Handle, right.Handle, This.Unique("float_add")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == [int](TokenKind.MinusAssign))
                    right = New LlvmValue(This.Module.FloatSubtract(left.Handle, right.Handle, This.Unique("float_sub")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == [int](TokenKind.StarAssign))
                    right = New LlvmValue(This.Module.FloatMultiply(left.Handle, right.Handle, This.Unique("float_mul")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == [int](TokenKind.SlashAssign))
                    right = New LlvmValue(This.Module.FloatDivide(left.Handle, right.Handle, This.Unique("float_div")), left.Type);
                ElseIf (operatorKind == [int](TokenKind.PlusAssign))
                    right = New LlvmValue(This.Module.Add(left.Handle, right.Handle, This.Unique("add")), left.Type);
                ElseIf (operatorKind == [int](TokenKind.MinusAssign))
                    right = New LlvmValue(This.Module.Subtract(left.Handle, right.Handle, This.Unique("sub")), left.Type);
                ElseIf (operatorKind == [int](TokenKind.StarAssign))
                    right = New LlvmValue(This.Module.Multiply(left.Handle, right.Handle, This.Unique("mul")), left.Type);
                ElseIf (operatorKind == [int](TokenKind.SlashAssign))
                {
                    byte* quotient = This.IsUnsignedInteger(left.Type) ?
                        This.Module.UnsignedDivide(left.Handle, right.Handle, This.Unique("udiv")) :
                        This.Module.SignedDivide(left.Handle, right.Handle, This.Unique("div"));
                    right = New LlvmValue(quotient, left.Type);
                }
                Else
                {
                    byte* remainder = This.IsUnsignedInteger(left.Type) ?
                        This.Module.UnsignedRemainder(left.Handle, right.Handle, This.Unique("urem")) :
                        This.Module.SignedRemainder(left.Handle, right.Handle, This.Unique("rem"));
                    right = New LlvmValue(remainder, left.Type);
                }
            }
            If (address == null)
                This.Fail("assignment target has no address: " + expression.Left.Target +
                    " kind=" + [string](expression.Left.Kind) + " in " +
                    context.Binding.Symbol.QualifiedName());
            Else This.Module.Store(right.Handle, address);
            Return right;
        }

        LlvmValue left = This.EmitExpression(context, expression.Left);
        LlvmValue right = This.EmitExpression(context, expression.Right);
        If (operatorKind == [int](TokenKind.Plus) &&
            (left.Type.Kind == [int](TypeKind.StringType) || right.Type.Kind == [int](TypeKind.StringType)))
        {
            left = This.CastValue(left, This.Semantics.Primitive("string"));
            right = This.CastValue(right, This.Semantics.Primitive("string"));
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_string_concat",
                This.Types2(left.Handle, right.Handle), This.Unique("concat")), This.Semantics.Primitive("string"));
        }

        bool equality = operatorKind == [int](TokenKind.Equal) || operatorKind == [int](TokenKind.NotEqual);
        If (equality && left.Type.Kind == [int](TypeKind.StringType))
        {
            right = This.CastValue(right, left.Type);
            byte* equal = This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                This.Types2(left.Handle, right.Handle), This.Unique("string_equal_c")));
            If (operatorKind == [int](TokenKind.NotEqual)) equal = This.Module.Not(equal, This.Unique("string_not_equal"));
            Return New LlvmValue(equal, This.Semantics.Primitive("bool"));
        }
        If (equality && (This.IsReferenceType(left.Type) || left.Type.Kind == [int](TypeKind.NullType) ||
                         This.IsReferenceType(right.Type) || right.Type.Kind == [int](TypeKind.NullType)))
        {
            TypeSymbol comparisonType = left.Type.Kind == [int](TypeKind.NullType) ? right.Type : left.Type;
            left = This.CastValue(left, comparisonType);
            right = This.CastValue(right, comparisonType);
            int predicate = operatorKind == [int](TokenKind.Equal) ?
                [int](LlvmIntPredicate.Equal) : [int](LlvmIntPredicate.NotEqual);
            Return New LlvmValue(This.Module.Compare(predicate, left.Handle, right.Handle, This.Unique("ref_compare")),
                This.Semantics.Primitive("bool"));
        }

        If (left.Type.Kind == [int](TypeKind.PointerType) &&
            (operatorKind == [int](TokenKind.Plus) || operatorKind == [int](TokenKind.Minus)))
        {
            right = This.CastValue(right, This.Semantics.Primitive("isize"));
            byte* offset = operatorKind == [int](TokenKind.Minus) ?
                This.Module.Negate(right.Handle, This.Unique("pointer_negative_offset")) : right.Handle;
            Return New LlvmValue(This.Module.Gep(This.TypeHandle(left.Type.ElementType), left.Handle,
                This.Types1(offset), true, This.Unique("pointer_offset")), left.Type);
        }

        TypeSymbol operandType = left.Type;
        right = This.CastValue(right, operandType);
        If (operandType.Kind == [int](TypeKind.FloatType))
        {
            If (operatorKind == [int](TokenKind.Plus))
                Return New LlvmValue(This.Module.FloatAdd(left.Handle, right.Handle, This.Unique("float_add")), expression.Type);
            If (operatorKind == [int](TokenKind.Minus))
                Return New LlvmValue(This.Module.FloatSubtract(left.Handle, right.Handle, This.Unique("float_sub")), expression.Type);
            If (operatorKind == [int](TokenKind.Star))
                Return New LlvmValue(This.Module.FloatMultiply(left.Handle, right.Handle, This.Unique("float_mul")), expression.Type);
            If (operatorKind == [int](TokenKind.Slash))
                Return New LlvmValue(This.Module.FloatDivide(left.Handle, right.Handle, This.Unique("float_div")), expression.Type);
            int floatPredicate = [int](LlvmFloatPredicate.OrderedEqual);
            If (operatorKind == [int](TokenKind.NotEqual))
                floatPredicate = [int](LlvmFloatPredicate.OrderedNotEqual);
            ElseIf (operatorKind == [int](TokenKind.Less))
                floatPredicate = [int](LlvmFloatPredicate.OrderedLess);
            ElseIf (operatorKind == [int](TokenKind.LessEqual))
                floatPredicate = [int](LlvmFloatPredicate.OrderedLessEqual);
            ElseIf (operatorKind == [int](TokenKind.Greater))
                floatPredicate = [int](LlvmFloatPredicate.OrderedGreater);
            ElseIf (operatorKind == [int](TokenKind.GreaterEqual))
                floatPredicate = [int](LlvmFloatPredicate.OrderedGreaterEqual);
            Return New LlvmValue(This.Module.FloatCompare(floatPredicate, left.Handle, right.Handle,
                This.Unique("float_compare")), This.Semantics.Primitive("bool"));
        }
        If (operatorKind == [int](TokenKind.Plus))
            Return New LlvmValue(This.Module.Add(left.Handle, right.Handle, This.Unique("add")), expression.Type);
        If (operatorKind == [int](TokenKind.Minus))
            Return New LlvmValue(This.Module.Subtract(left.Handle, right.Handle, This.Unique("sub")), expression.Type);
        If (operatorKind == [int](TokenKind.Star))
            Return New LlvmValue(This.Module.Multiply(left.Handle, right.Handle, This.Unique("mul")), expression.Type);
        If (operatorKind == [int](TokenKind.Slash))
        {
            byte* quotient = This.IsUnsignedInteger(operandType) ?
                This.Module.UnsignedDivide(left.Handle, right.Handle, This.Unique("udiv")) :
                This.Module.SignedDivide(left.Handle, right.Handle, This.Unique("div"));
            Return New LlvmValue(quotient, expression.Type);
        }
        If (operatorKind == [int](TokenKind.Percent))
        {
            byte* remainder = This.IsUnsignedInteger(operandType) ?
                This.Module.UnsignedRemainder(left.Handle, right.Handle, This.Unique("urem")) :
                This.Module.SignedRemainder(left.Handle, right.Handle, This.Unique("rem"));
            Return New LlvmValue(remainder, expression.Type);
        }
        If (operatorKind == [int](TokenKind.Ampersand))
            Return New LlvmValue(This.Module.And(left.Handle, right.Handle, This.Unique("and")), expression.Type);
        If (operatorKind == [int](TokenKind.BitOr))
            Return New LlvmValue(This.Module.Or(left.Handle, right.Handle, This.Unique("or")), expression.Type);
        If (operatorKind == [int](TokenKind.Xor))
            Return New LlvmValue(This.Module.Xor(left.Handle, right.Handle, This.Unique("xor")), expression.Type);
        If (operatorKind == [int](TokenKind.ShiftLeft))
            Return New LlvmValue(This.Module.ShiftLeft(left.Handle, right.Handle, This.Unique("shl")), expression.Type);
        If (operatorKind == [int](TokenKind.ShiftRight))
        {
            byte* shifted = This.IsUnsignedInteger(operandType) ?
                This.Module.LogicalShiftRight(left.Handle, right.Handle, This.Unique("lshr")) :
                This.Module.ShiftRight(left.Handle, right.Handle, This.Unique("shr"));
            Return New LlvmValue(shifted, expression.Type);
        }

        int predicate = [int](LlvmIntPredicate.Equal);
        If (operatorKind == [int](TokenKind.NotEqual)) predicate = [int](LlvmIntPredicate.NotEqual);
        ElseIf (operatorKind == [int](TokenKind.Less)) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedLess) : [int](LlvmIntPredicate.SignedLess);
        ElseIf (operatorKind == [int](TokenKind.LessEqual)) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedLessEqual) : [int](LlvmIntPredicate.SignedLessEqual);
        ElseIf (operatorKind == [int](TokenKind.Greater)) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedGreater) : [int](LlvmIntPredicate.SignedGreater);
        ElseIf (operatorKind == [int](TokenKind.GreaterEqual)) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedGreaterEqual) : [int](LlvmIntPredicate.SignedGreaterEqual);
        Return New LlvmValue(This.Module.Compare(predicate, left.Handle, right.Handle, This.Unique("compare")),
            This.Semantics.Primitive("bool"));
    }

    Public Trusted Function LlvmValue EmitUnary(LlvmFunctionContext context, HirExpression expression)
    {
        int operatorKind = expression.Operator;
        If (operatorKind == [int](TokenKind.Ampersand))
        {
            byte* address = This.EmitAddress(context, expression.Left);
            If (address == null) This.Fail("address-of operand has no address");
            Return New LlvmValue(address, expression.Type);
        }
        LlvmValue operand = This.EmitExpression(context, expression.Left);
        If (operatorKind == [int](TokenKind.Star))
            Return New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), operand.Handle,
                This.Unique("dereference")), expression.Type);
        If (operatorKind == [int](TokenKind.Not))
            Return New LlvmValue(This.Module.Not(operand.Handle, This.Unique("not")), expression.Type);
        If (operatorKind == [int](TokenKind.Minus))
            Return New LlvmValue(operand.Type.Kind == [int](TypeKind.FloatType) ?
                This.Module.FloatNegate(operand.Handle, This.Unique("float_negate")) :
                This.Module.Negate(operand.Handle, This.Unique("negate")), expression.Type);
        If (operatorKind == [int](TokenKind.Tilde))
            Return New LlvmValue(This.Module.Not(operand.Handle, This.Unique("bit_not")), expression.Type);
        If (operatorKind == [int](TokenKind.PlusPlus) || operatorKind == [int](TokenKind.MinusMinus))
        {
            byte* address = This.EmitAddress(context, expression.Left);
            byte* one = This.Module.ConstInt(This.TypeHandle(operand.Type), 1);
            byte* next = operatorKind == [int](TokenKind.PlusPlus) ?
                This.Module.Add(operand.Handle, one, This.Unique("increment")) :
                This.Module.Subtract(operand.Handle, one, This.Unique("decrement"));
            If (address != null) This.Module.Store(next, address);
            If (expression.Syntax != null && expression.Syntax.IsPostfix) Return operand;
            Return New LlvmValue(next, expression.Type);
        }
        Return operand;
    }

    Public Safe Function int CollectBlockRecords(LlvmBlockBinding binding,
                                                  HirStatement statement, int nextOrdinal)
    {
        HirStatement current = statement;
        int ordinal = nextOrdinal;
        While (current != null)
        {
            If (current.Kind == [int](StatementKind.Record))
            {
                binding.AddRecord(New LlvmRecordBinding(current.Name, ordinal));
                ordinal = ordinal + 1;
            }
            Else
            {
                If (current.Initializer != null)
                    ordinal = This.CollectBlockRecords(binding, current.Initializer, ordinal);
                If (current.FirstChild != null)
                    ordinal = This.CollectBlockRecords(binding, current.FirstChild, ordinal);
                If (current.ElseBranch != null)
                    ordinal = This.CollectBlockRecords(binding, current.ElseBranch, ordinal);
            }
            current = current.Next;
        }
        Return ordinal;
    }

    Public Safe Function LlvmBlockBinding RegisterUnsafeBlock(LlvmFunctionContext context,
                                                               HirStatement statement)
    {
        LlvmBlockBinding existing = context.FindBlock(statement.Name);
        If (existing != null) Return existing;
        LlvmBlockBinding binding = New LlvmBlockBinding(statement.Name, statement);
        This.CollectBlockRecords(binding, statement.FirstChild, 1);
        context.AddBlock(binding);
        Return binding;
    }

    Public Safe Function int BlockRecordOrdinal(LlvmFunctionContext context, string target)
    {
        LlvmBlockBinding binding = context.FirstBlock;
        While (binding != null)
        {
            string prefix = binding.Name + ".";
            If (IO.Text.StartsWith(target, prefix))
            {
                string name = IO.Text.Slice(target, IO.Text.Length(prefix),
                    IO.Text.Length(target) - IO.Text.Length(prefix));
                LlvmRecordBinding record = binding.FindRecord(name);
                If (record != null) Return record.Ordinal;
            }
            binding = binding.Next;
        }
        Return -1;
    }

    Public Trusted Function void EmitUnsafeJump(LlvmFunctionContext context,
                                                 LlvmBlockBinding binding,
                                                 HirStatement statement)
    {
        If (binding == null)
        {
            This.Fail("Jump used outside Block");
            Return;
        }
        byte* function = context.Binding.Function;
        If (!IO.Text.IsEmpty(statement.Name))
        {
            LlvmRecordBinding target = binding.FindRecord(statement.Name);
            If (target == null) This.Fail("unknown Block record: " + statement.Name);
            Else This.Module.Branch(target.Block);
        }
        Else
        {
            LlvmValue targetValue = This.CastValue(
                This.EmitExpression(context, statement.Expression), This.Semantics.Primitive("int"));
            LlvmRecordBinding record = binding.FirstRecord;
            While (record != null)
            {
                byte* nextCheck = This.Module.AppendBlock(function, This.Unique("block_jump_check"));
                byte* equal = This.Module.Compare([int](LlvmIntPredicate.Equal), targetValue.Handle,
                    This.Module.ConstInt(This.Module.IntType(64), record.Ordinal),
                    This.Unique("block_jump_equal"));
                This.Module.ConditionalBranch(equal, record.Block, nextCheck);
                This.Module.PositionAtEnd(nextCheck);
                record = record.Next;
            }
            This.Module.Branch(binding.DoneBlock);
        }
        byte* continuation = This.Module.AppendBlock(function, This.Unique("block_jump_continuation"));
        This.Module.PositionAtEnd(continuation);
    }

    Public Trusted Function void EmitUnsafeStatementList(LlvmFunctionContext context,
                                                          LlvmBlockBinding binding,
                                                          HirStatement statement)
    {
        HirStatement current = statement;
        While (current != null)
        {
            If (current.Kind == [int](StatementKind.Record))
            {
                LlvmRecordBinding record = binding.FindRecord(current.Name);
                If (record != null)
                {
                    If (!This.Module.IsTerminated(This.Module.CurrentBlock()))
                        This.Module.Branch(record.Block);
                    This.Module.PositionAtEnd(record.Block);
                    This.EmitStatementList(context, current.FirstChild);
                }
            }
            Else If (!This.Module.IsTerminated(This.Module.CurrentBlock()))
            {
                This.EmitStatement(context, current);
            }
            current = current.Next;
        }
    }

    Public Trusted Function void EmitUnsafeBlock(LlvmFunctionContext context,
                                                  LlvmBlockBinding binding)
    {
        If (binding == null || binding.Emitted) Return;
        binding.Emitted = true;
        byte* function = context.Binding.Function;
        binding.StartBlock = This.Module.AppendBlock(function, This.Unique("block_start"));
        binding.DoneBlock = This.Module.AppendBlock(function, This.Unique("block_done"));
        LlvmRecordBinding record = binding.FirstRecord;
        While (record != null)
        {
            record.Block = This.Module.AppendBlock(function,
                This.Unique("block_record_" + This.Sanitize(record.Name)));
            record = record.Next;
        }
        This.Module.Branch(binding.StartBlock);
        This.Module.PositionAtEnd(binding.StartBlock);
        LlvmBlockBinding previous = context.ActiveBlock;
        context.ActiveBlock = binding;
        This.EmitUnsafeStatementList(context, binding, binding.Statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(binding.DoneBlock);
        context.ActiveBlock = previous;
        This.Module.PositionAtEnd(binding.DoneBlock);
    }

    Public Trusted Function LlvmValue EmitExpression(LlvmFunctionContext context, HirExpression expression)
    {
        If (expression == null) Return This.DefaultValue(This.Semantics.Primitive("void"));
        If (expression.Kind == [int](HirExpressionKind.Constant))
        {
            int syntaxKind = expression.Syntax.Kind;
            int recordOrdinal = This.BlockRecordOrdinal(context, expression.Target);
            If (recordOrdinal >= 0)
                Return New LlvmValue(This.Module.ConstInt(This.Module.IntType(64), recordOrdinal),
                    This.Semantics.Primitive("isize"));
            If (This.IsEnum(expression.Type))
                Return New LlvmValue(This.Module.ConstInt(This.Module.IntType(64),
                    This.EnumValue(expression.Type, expression.Target)), expression.Type);
            If (syntaxKind == [int](ExpressionKind.Number))
            {
                If (expression.Type.Kind == [int](TypeKind.FloatType))
                    Return New LlvmValue(This.Module.ConstFloat(This.TypeHandle(expression.Type),
                        [float](expression.Name)), expression.Type);
                Return New LlvmValue(This.Module.ConstI64(This.TypeHandle(expression.Type),
                    [i64]([int](expression.Name)), false), expression.Type);
            }
            If (syntaxKind == [int](ExpressionKind.String) ||
                syntaxKind == [int](ExpressionKind.FormattedString))
                Return New LlvmValue(This.Module.GlobalString(
                    expression.Syntax.IsRawString ? This.Unquote(expression.Name) :
                    syntaxKind == [int](ExpressionKind.FormattedString) ?
                        This.ExpandFormattedString(expression.Name) : This.DecodeString(expression.Name),
                    This.Unique("text")), expression.Type);
            If (syntaxKind == [int](ExpressionKind.Character))
                Return New LlvmValue(This.Module.ConstInt(This.TypeHandle(expression.Type),
                    This.DecodeCharacter(expression.Name)), expression.Type);
            If (syntaxKind == [int](ExpressionKind.Boolean))
                Return New LlvmValue(This.Module.ConstInt(This.Module.IntType(1),
                    expression.Name == "true" || expression.Name == "True" ? 1 : 0),
                    expression.Type);
            Return This.DefaultValue(expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Local) ||
            expression.Kind == [int](HirExpressionKind.Global) ||
            expression.Kind == [int](HirExpressionKind.Delegate))
        {
            byte* address = This.EmitAddress(context, expression);
            If (address == null)
            {
                This.Fail("unknown local: " + expression.Target + " in " +
                    context.Binding.Symbol.QualifiedName() + "; available=" + context.VariableNames());
                Return This.DefaultValue(expression.Type);
            }
            LlvmValue result = New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), address,
                This.Unique("load")), expression.Type);
            result.Address = address;
            Return result;
        }
        If (expression.Kind == [int](HirExpressionKind.FunctionReference))
        {
            LlvmFunctionBinding function = This.FindFunctionBinding(expression.Function);
            If (function == null)
            {
                This.Fail("function reference binding is missing: " + expression.Target);
                Return This.DefaultValue(expression.Type);
            }
            Return New LlvmValue(This.EnsureCallableWrapper(function), expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Field) ||
            expression.Kind == [int](HirExpressionKind.Index))
        {
            byte* address = This.EmitAddress(context, expression);
            LlvmValue result = New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), address,
                This.Unique("load")), expression.Type);
            result.Address = address;
            Return result;
        }
        If (expression.Kind == [int](HirExpressionKind.Unary)) Return This.EmitUnary(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Binary)) Return This.EmitBinary(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Conditional)) Return This.EmitConditional(context, expression);
        If (expression.Kind == [int](HirExpressionKind.ArrayLiteral))
            Return This.EmitArrayLiteral(context, expression);
        If (expression.Kind == [int](HirExpressionKind.DictLiteral))
            Return This.EmitDictLiteral(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Switch))
            Return This.EmitSwitchExpression(context, expression);
        If (expression.Kind == [int](HirExpressionKind.NewObject)) Return This.EmitNewObject(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Cast))
            Return This.CastValue(This.EmitExpression(context, expression.Left), expression.Type);
        If (expression.Kind == [int](HirExpressionKind.Call))
        {
            If (expression.CallKind == [int](HirCallKind.RuntimeBuiltin))
                Return This.EmitRuntimeBuiltin(context, expression);
            If (expression.CallKind == [int](HirCallKind.DynamicFunction))
                Return This.EmitDynamicFunctionCall(context, expression);
            If (expression.CallKind == [int](HirCallKind.Delegate))
                Return This.EmitDelegateCall(context, expression);
            LlvmFunctionBinding binding = expression.Function == null ?
                This.FindFunctionByTarget(expression.Target, This.HirArgumentCount(expression)) :
                This.FindFunctionBinding(expression.Function);
            If (binding == null)
            {
                This.Fail("function binding is missing: " + expression.Target);
                Return This.DefaultValue(expression.Type);
            }
            LlvmValue receiver = expression.Left == null ? null : This.EmitExpression(context, expression.Left);
            Return This.EmitFunctionCall(context, binding, expression, receiver);
        }
        If (expression.Kind == [int](HirExpressionKind.Invalid))
            This.Fail("invalid HIR expression reached backend");
        Return This.DefaultValue(expression.Type);
    }

    Public Safe Function HirFunction FindHirFunction(FunctionSymbol symbol)
    {
        HirModule module = This.Semantics.FirstHirModule;
        While (module != null)
        {
            HirFunction function = module.FirstFunction;
            While (function != null)
            {
                If (function.Symbol == symbol) Return function;
                function = function.Next;
            }
            module = module.Next;
        }
        Return null;
    }

    Public Trusted Function void AddGcRoot(LlvmFunctionContext context, TypeSymbol type, byte* address)
    {
        If (!This.NeedsGcRoot(type) || context.GcFrame == null || address == null) Return;
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* rootAddress = This.Module.BitCast(address, bytePointer, This.Unique("gc_root"));
        This.CallRuntime("__kn_gc_add_root",
            This.Types3(context.GcFrame, rootAddress, This.Module.SizeOf(This.TypeHandle(type))), "");
    }

    Public Trusted Function void PopGcFrame(LlvmFunctionContext context)
    {
        If (context.GcFrame != null)
            This.CallRuntime("__kn_gc_pop_frame", This.Types1(context.GcFrame), "");
    }

    Public Trusted Function void EmitReturn(LlvmFunctionContext context, HirExpression expression)
    {
        TypeSymbol returnType = context.Binding.Symbol.ReturnType;
        LlvmValue value = expression == null ? This.DefaultValue(returnType) :
            This.CastValue(This.EmitExpression(context, expression), returnType);
        This.PopGcFrame(context);
        If (returnType.Kind == [int](TypeKind.VoidType)) This.Module.ReturnVoid();
        Else This.Module.ReturnValue(value.Handle);
    }

    Public Trusted Function void EmitStatementList(LlvmFunctionContext context, HirStatement statement)
    {
        HirStatement current = statement;
        While (current != null)
        {
            byte* block = This.Module.CurrentBlock();
            If (block == null || This.Module.IsTerminated(block)) Return;
            This.EmitStatement(context, current);
            current = current.Next;
        }
    }

    Public Trusted Function void EmitIf(LlvmFunctionContext context, HirStatement statement)
    {
        LlvmValue condition = This.CastValue(This.EmitExpression(context, statement.Expression),
            This.Semantics.Primitive("bool"));
        byte* function = context.Binding.Function;
        byte* trueBlock = This.Module.AppendBlock(function, This.Unique("if_true"));
        byte* falseBlock = This.Module.AppendBlock(function, This.Unique("if_false"));
        byte* mergeBlock = This.Module.AppendBlock(function, This.Unique("if_merge"));
        This.Module.ConditionalBranch(condition.Handle, trueBlock, falseBlock);

        This.Module.PositionAtEnd(trueBlock);
        This.EmitStatementList(context, statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(falseBlock);
        This.EmitStatementList(context, statement.ElseBranch);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(mergeBlock);
    }

    Public Trusted Function void EmitWhile(LlvmFunctionContext context, HirStatement statement)
    {
        byte* function = context.Binding.Function;
        byte* conditionBlock = This.Module.AppendBlock(function, This.Unique("while_condition"));
        byte* bodyBlock = This.Module.AppendBlock(function, This.Unique("while_body"));
        byte* endBlock = This.Module.AppendBlock(function, This.Unique("while_end"));
        This.Module.Branch(conditionBlock);

        This.Module.PositionAtEnd(conditionBlock);
        LlvmValue condition = This.CastValue(This.EmitExpression(context, statement.Expression),
            This.Semantics.Primitive("bool"));
        This.Module.ConditionalBranch(condition.Handle, bodyBlock, endBlock);

        byte* previousBreak = context.BreakTarget;
        byte* previousContinue = context.ContinueTarget;
        context.BreakTarget = endBlock;
        context.ContinueTarget = conditionBlock;
        This.Module.PositionAtEnd(bodyBlock);
        This.EmitStatementList(context, statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(conditionBlock);
        context.BreakTarget = previousBreak;
        context.ContinueTarget = previousContinue;
        This.Module.PositionAtEnd(endBlock);
    }

    Public Trusted Function void EmitFor(LlvmFunctionContext context, HirStatement statement)
    {
        LlvmVariable savedVariables = context.FirstVariable;
        If (statement.Initializer != null) This.EmitStatement(context, statement.Initializer);
        byte* function = context.Binding.Function;
        byte* conditionBlock = This.Module.AppendBlock(function, This.Unique("for_condition"));
        byte* bodyBlock = This.Module.AppendBlock(function, This.Unique("for_body"));
        byte* stepBlock = This.Module.AppendBlock(function, This.Unique("for_step"));
        byte* endBlock = This.Module.AppendBlock(function, This.Unique("for_end"));
        This.Module.Branch(conditionBlock);

        This.Module.PositionAtEnd(conditionBlock);
        If (statement.Expression == null) This.Module.Branch(bodyBlock);
        Else
        {
            LlvmValue condition = This.CastValue(This.EmitExpression(context, statement.Expression),
                This.Semantics.Primitive("bool"));
            This.Module.ConditionalBranch(condition.Handle, bodyBlock, endBlock);
        }

        byte* previousBreak = context.BreakTarget;
        byte* previousContinue = context.ContinueTarget;
        context.BreakTarget = endBlock;
        context.ContinueTarget = stepBlock;
        This.Module.PositionAtEnd(bodyBlock);
        This.EmitStatementList(context, statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(stepBlock);

        This.Module.PositionAtEnd(stepBlock);
        If (statement.SecondExpression != null) This.EmitExpression(context, statement.SecondExpression);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(conditionBlock);
        context.BreakTarget = previousBreak;
        context.ContinueTarget = previousContinue;
        context.FirstVariable = savedVariables;
        This.Module.PositionAtEnd(endBlock);
    }

    Public Trusted Function void EmitSwitchStatement(LlvmFunctionContext context, HirStatement statement)
    {
        LlvmValue selector = This.EmitExpression(context, statement.Expression);
        byte* function = context.Binding.Function;
        byte* endBlock = This.Module.AppendBlock(function, This.Unique("switch_end"));
        byte* previousBreak = context.BreakTarget;
        context.BreakTarget = endBlock;
        HirStatement defaultCase = null;
        HirStatement item = statement.FirstChild;
        While (item != null)
        {
            If (item.Name == "default")
            {
                defaultCase = item;
                item = item.Next;
                Continue;
            }
            byte* caseBlock = This.Module.AppendBlock(function, This.Unique("switch_case"));
            byte* nextBlock = This.Module.AppendBlock(function, This.Unique("switch_next"));
            LlvmValue caseValue = This.EmitExpression(context, item.Expression);
            This.Module.ConditionalBranch(This.EmitSwitchMatch(selector, caseValue), caseBlock, nextBlock);
            This.Module.PositionAtEnd(caseBlock);
            LlvmVariable savedVariables = context.FirstVariable;
            This.EmitStatementList(context, item.FirstChild);
            context.FirstVariable = savedVariables;
            If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(endBlock);
            This.Module.PositionAtEnd(nextBlock);
            item = item.Next;
        }
        If (defaultCase != null)
        {
            LlvmVariable savedVariables = context.FirstVariable;
            This.EmitStatementList(context, defaultCase.FirstChild);
            context.FirstVariable = savedVariables;
        }
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(endBlock);
        context.BreakTarget = previousBreak;
        This.Module.PositionAtEnd(endBlock);
    }

    Public Trusted Function void EmitStatement(LlvmFunctionContext context, HirStatement statement)
    {
        If (statement == null) Return;
        If (statement.Kind == [int](StatementKind.Block))
        {
            LlvmVariable savedVariables = context.FirstVariable;
            This.EmitStatementList(context, statement.FirstChild);
            context.FirstVariable = savedVariables;
            Return;
        }
        If (statement.Kind == [int](StatementKind.UnsafeBlock))
        {
            This.RegisterUnsafeBlock(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Jump))
        {
            This.EmitUnsafeJump(context, context.ActiveBlock, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Record)) Return;
        If (statement.Kind == [int](StatementKind.Variable))
        {
            byte* address = This.Module.Alloca(This.TypeHandle(statement.DeclaredType),
                This.Sanitize(statement.Name));
            LlvmVariable variable = New LlvmVariable(statement.Name, statement.DeclaredSymbol,
                statement.DeclaredType, address);
            context.AddVariable(variable);
            This.AddGcRoot(context, statement.DeclaredType, address);
            LlvmValue value = null;
            If (statement.DeclaredType.Kind == [int](TypeKind.ArrayType) &&
                statement.SecondExpression != null)
            {
                LlvmValue requestedLength = This.CastValue(
                    This.EmitExpression(context, statement.SecondExpression),
                    This.Semantics.Primitive("int"));
                HirExpression firstItem = statement.Expression != null &&
                    statement.Expression.Kind == [int](HirExpressionKind.ArrayLiteral) ?
                    statement.Expression.FirstArgument : null;
                value = This.EmitArrayValue(context, statement.DeclaredType, firstItem,
                    requestedLength.Handle);
            }
            Else value = statement.Expression == null ? This.DefaultValue(statement.DeclaredType) :
                This.CastValue(This.EmitExpression(context, statement.Expression), statement.DeclaredType);
            This.Module.Store(value.Handle, address);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Expression))
        {
            This.EmitExpression(context, statement.Expression);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Return))
        {
            This.EmitReturn(context, statement.Expression);
            Return;
        }
        If (statement.Kind == [int](StatementKind.If))
        {
            This.EmitIf(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.While))
        {
            This.EmitWhile(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.For))
        {
            This.EmitFor(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Switch))
        {
            This.EmitSwitchStatement(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Break))
        {
            If (context.BreakTarget == null) This.Fail("break used outside loop");
            Else This.Module.Branch(context.BreakTarget);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Continue))
        {
            If (context.ContinueTarget == null) This.Fail("continue used outside loop");
            Else This.Module.Branch(context.ContinueTarget);
        }
    }

    Public Trusted Function void EmitFunctionBody(LlvmFunctionBinding binding)
    {
        If (binding.Symbol.Declaration.IsExtern) Return;
        HirFunction hirFunction = This.FindHirFunction(binding.Symbol);
        If (hirFunction == null || hirFunction.Body == null) Return;

        byte* entry = This.Module.AppendBlock(binding.Function, "entry");
        This.Module.PositionAtEnd(entry);
        LlvmFunctionContext context = New LlvmFunctionContext(binding);
        context.GcFrame = This.CallRuntime("__kn_gc_push_frame", This.Types0(), This.Unique("gc_frame"));

        int parameterIndex = 0;
        bool hasReceiver = binding.Symbol.OwnerType != null &&
            (!binding.Symbol.Declaration.IsStatic || binding.Symbol.Declaration.IsConstructor);
        If (hasReceiver)
        {
            byte* address = This.Module.Alloca(This.TypeHandle(binding.Symbol.OwnerType), "This");
            This.Module.Store(This.Module.Parameter(binding.Function, parameterIndex), address);
            context.AddVariable(New LlvmVariable("This", binding.Symbol.Receiver,
                binding.Symbol.OwnerType, address));
            This.AddGcRoot(context, binding.Symbol.OwnerType, address);
            parameterIndex = parameterIndex + 1;
        }
        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        While (parameter != null)
        {
            byte* address = This.Module.Alloca(This.TypeHandle(parameter.Type), This.Sanitize(parameter.Name));
            This.Module.Store(This.Module.Parameter(binding.Function, parameterIndex), address);
            context.AddVariable(New LlvmVariable(parameter.Name, parameter.Value, parameter.Type, address));
            This.AddGcRoot(context, parameter.Type, address);
            parameterIndex = parameterIndex + 1;
            parameter = parameter.Next;
        }

        This.EmitStatementList(context, hirFunction.Body);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.EmitReturn(context, null);
    }

    Public Trusted Function void EmitFunctions()
    {
        LlvmFunctionBinding binding = This.FirstFunction;
        While (binding != null)
        {
            This.EmitFunctionBody(binding);
            binding = binding.Next;
        }
    }

    Public Safe Function LlvmFunctionBinding FindEntryFunction()
    {
        LlvmFunctionBinding binding = This.FirstFunction;
        While (binding != null)
        {
            If (binding.Symbol.OwnerType == null && binding.Symbol.Name == "Main" &&
                binding.Symbol.UnitName == This.Semantics.Session.EntryUnitName) Return binding;
            binding = binding.Next;
        }
        Return null;
    }

    Public Trusted Function void EmitEntryPoint()
    {
        LlvmFunctionBinding entryBinding = This.FindEntryFunction();
        If (entryBinding == null)
        {
            This.Fail("entry unit does not declare Main");
            Return;
        }
        byte* int32Type = This.Module.IntType(32);
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* argvType = This.Module.PointerType(bytePointer);
        LlvmHandles mainParameters = This.Types2(int32Type, argvType);
        byte* mainType = This.Module.FunctionType(int32Type, mainParameters, false);
        byte* mainFunction = This.Module.AddFunction("main", mainType);
        byte* block = This.Module.AppendBlock(mainFunction, "entry");
        This.Module.PositionAtEnd(block);
        This.CallRuntime("__kn_gc_init", This.Types0(), "");
        This.InitializeFixedGlobalArrays();
        This.InitializeGlobalCopies();

        LlvmHandles arguments = New LlvmHandles();
        int count = entryBinding.Symbol.ParameterCount();
        If (count == 1)
        {
            ParameterSymbol parameter = entryBinding.Symbol.FirstParameter;
            If (parameter.Type.Kind != [int](TypeKind.ArrayType) ||
                parameter.Type.ElementType.Kind != [int](TypeKind.StringType))
            {
                This.Fail("Main parameter must be string[]");
                Return;
            }
            byte* dataSlot = This.Module.Alloca(argvType, "args_data_slot");
            byte* lengthSlot = This.Module.Alloca(This.Module.IntType(64), "args_length_slot");
            This.CallRuntime("__kn_sys_args_from_argv", This.Types4(
                This.Module.Parameter(mainFunction, 0), This.Module.Parameter(mainFunction, 1),
                dataSlot, lengthSlot), "");
            byte* array = This.Module.ConstUndef(This.TypeHandle(parameter.Type));
            array = This.Module.InsertValue(array,
                This.Module.Load(argvType, dataSlot, "args_data"), 0, "");
            array = This.Module.InsertValue(array,
                This.Module.Load(This.Module.IntType(64), lengthSlot, "args_length"), 1, "");
            arguments.Add(array);
        }
        ElseIf (count != 0)
        {
            This.Fail("Main must take zero parameters or string[]");
            Return;
        }

        byte* result = This.Module.Call(entryBinding.FunctionType, entryBinding.Function,
            arguments, entryBinding.Symbol.ReturnType.Kind == [int](TypeKind.VoidType) ? "" : "entry_result");
        If (entryBinding.Symbol.ReturnType.Kind == [int](TypeKind.VoidType))
            This.Module.ReturnValue(This.Module.ConstInt(int32Type, 0));
        Else
            This.Module.ReturnValue(This.Module.Truncate(result, int32Type, "exit_code"));
    }

    Public Trusted Function bool GenerateModule()
    {
        If (!This.Module.IsValid())
        {
            This.Fail("LLVM module creation failed: " + IO.Kinal.Compiler.Backend.LlvmBridge.LastError());
            Return false;
        }
        This.PrepareTypes();
        This.DeclareRuntime();
        This.DeclareFunctions();
        This.DeclareGlobals();
        This.EmitFunctions();
        This.EmitEntryPoint();
        If (This.Failed()) Return false;
        If (!This.Module.Verify())
        {
            This.Fail("LLVM verification failed: " + IO.Kinal.Compiler.Backend.LlvmBridge.LastError());
            Return false;
        }
        Return true;
    }

    Public Trusted Function bool EmitObject(string outputPath)
    {
        If (!This.GenerateModule()) Return false;
        If (!This.Module.EmitObject("", outputPath))
        {
            This.Fail("object emission failed: " + IO.Kinal.Compiler.Backend.LlvmBridge.LastError());
            Return false;
        }
        Return true;
    }

    Public Trusted Function void Dispose()
    {
        This.Module.Dispose();
    }
}

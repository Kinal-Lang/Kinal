        This.DeclareRuntimeFunction("__kn_dir_files", pointer, This.Types2(pointer, int32Type));

        This.DeclareRuntimeFunction("__kn_path_combine", pointer, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_path_join3", pointer, This.Types3(pointer, pointer, pointer));
        This.DeclareRuntimeFunction("__kn_path_join4", pointer, This.Types4(pointer, pointer, pointer, pointer));
        This.DeclareRuntimeFunction("__kn_path_file_name", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_path_extension", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_path_directory", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_path_normalize", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_path_cwd", pointer, This.Types0());
        This.DeclareRuntimeFunction("__kn_path_change_extension", pointer, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_path_is_absolute", int32Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_path_base_name", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_path_ensure_trailing_separator", pointer, This.Types1(pointer));

        This.DeclareRuntimeFunction("__kn_text_contains", int32Type, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_starts_with", int32Type, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_ends_with", int32Type, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_index_of", int64Type, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_last_index_of", int64Type, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_trim", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_text_replace", pointer, This.Types3(pointer, pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_to_upper", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_text_to_lower", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_text_slice", pointer, This.Types3(pointer, int64Type, int64Type));
        This.DeclareRuntimeFunction("__kn_text_count", int64Type, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_split", pointer, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("__kn_text_lines", pointer, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_text_join", pointer, This.Types2(pointer, pointer));
    }

    Public Trusted Function byte* CallRuntime(string name, LlvmHandles arguments, string resultName)
    {
        LlvmRuntimeFunction runtime = This.Runtime(name);
        If (runtime == null)
        {
            This.Fail("runtime function is not declared: " + name);
            Return null;
        }
        Return This.Module.Call(runtime.FunctionType, runtime.Function, arguments, resultName);
    }

    Public Trusted Function byte* RuntimeBool(byte* cValue)
    {
        Return This.Module.Compare([int](LlvmIntPredicate.NotEqual), cValue,
            This.Module.ConstInt(This.Module.IntType(32), 0), This.Unique("bool"));
    }

    Public Safe Function bool SameType(TypeSymbol left, TypeSymbol right)
    {
        If (left == right) Return true;
        If (left == null || right == null || left.Kind != right.Kind) Return false;
        If (left.Kind == [int](TypeKind.ArrayType) || left.Kind == [int](TypeKind.PointerType))
            Return This.SameType(left.ElementType, right.ElementType);
        If (left.Kind == [int](TypeKind.PackageType))
        {
            If (left.PackageCount != right.PackageCount) Return false;
            PackageElementType leftElement = left.FirstPackageElement;
            PackageElementType rightElement = right.FirstPackageElement;
            While (leftElement != null && rightElement != null)
            {
                If (!This.SameType(leftElement.Type, rightElement.Type)) Return false;
                leftElement = leftElement.Next;
                rightElement = rightElement.Next;
            }
            Return leftElement == null && rightElement == null;
        }
        Return left.Name == right.Name && left.UnitName == right.UnitName;
    }

    Public Safe Function bool IsIntegerLike(TypeSymbol type)
    {
        Return type != null && (type.Kind == [int](TypeKind.IntegerType) || This.IsEnum(type));
    }

    Public Trusted Function LlvmValue DefaultValue(TypeSymbol type)
    {
        byte* typeHandle = This.TypeHandle(type);
        If (type.Kind == [int](TypeKind.VoidType)) Return New LlvmValue(null, type);
        If (type.Kind == [int](TypeKind.ArrayType) || type.Kind == [int](TypeKind.PackageType))
        {
            byte* value = This.Module.ConstUndef(typeHandle);
            value = This.Module.InsertValue(value,
                This.Module.ConstNull(This.Module.PointerType(This.TypeHandle(type.ElementType))), 0, "");
            value = This.Module.InsertValue(value, This.Module.ConstInt(This.Module.IntType(64), 0), 1, "");
            Return New LlvmValue(value, type);
        }
        If (type.Kind == [int](TypeKind.AnyType))
        {
            byte* value = This.Module.ConstUndef(typeHandle);
            value = This.Module.InsertValue(value, This.Module.ConstInt(This.Module.IntType(64), 0), 0, "");
            value = This.Module.InsertValue(value, This.Module.ConstInt(This.Module.IntType(64), 0), 1, "");
            Return New LlvmValue(value, type);
        }
        If (This.IsReferenceType(type) || type.Kind == [int](TypeKind.NullType))
            Return New LlvmValue(This.Module.ConstNull(typeHandle), type);
        If (This.Semantics.IsStructType(type))
            Return New LlvmValue(This.Module.ConstNull(typeHandle), type);
        If (type.Kind == [int](TypeKind.FloatType))
            Return New LlvmValue(This.Module.ConstFloat(typeHandle, 0.0), type);
        Return New LlvmValue(This.Module.ConstInt(typeHandle, 0), type);
    }

    Public Trusted Function byte* ToI64(LlvmValue value)
    {
        int bits = This.IntegerBits(value.Type);
        If (value.Type.Kind == [int](TypeKind.BoolType))
            Return This.Module.ZeroExtend(value.Handle, This.Module.IntType(64), This.Unique("bool_i64"));
        If (This.IsReferenceType(value.Type))
            Return This.Module.PointerToInt(value.Handle, This.Module.IntType(64), This.Unique("ptr_i64"));
        If (bits < 64)
        {
            If (This.IsUnsignedInteger(value.Type))
                Return This.Module.ZeroExtend(value.Handle, This.Module.IntType(64), This.Unique("u64"));
            Return This.Module.SignExtend(value.Handle, This.Module.IntType(64), This.Unique("i64"));
        }
        Return value.Handle;
    }

    Public Trusted Function LlvmValue BoxAny(LlvmValue value)
    {
        If (value.Type.Kind == [int](TypeKind.AnyType)) Return value;
        int tag = 0;
        byte* payload = This.Module.ConstInt(This.Module.IntType(64), 0);
        If (value.Type.Kind == [int](TypeKind.BoolType))
        {
            tag = 3;
            payload = This.Module.ZeroExtend(value.Handle, This.Module.IntType(64), This.Unique("any_bool"));
        }
        ElseIf (value.Type.Name == "char")
        {
            tag = 4;
            payload = This.Module.ZeroExtend(value.Handle, This.Module.IntType(64), This.Unique("any_char"));
        }
        ElseIf (This.IsIntegerLike(value.Type))
        {
            tag = 1;
            payload = This.ToI64(value);
        }
        ElseIf (value.Type.Kind == [int](TypeKind.FloatType))
        {
            tag = 2;
            byte* normalized = value.Handle;
            int bits = This.FloatBits(value.Type);
            byte* f64Type = This.TypeHandle(This.Semantics.Primitive("f64"));
            If (bits < 64)
                normalized = This.Module.FloatExtend(normalized, f64Type,
                    This.Unique("any_float_widen"));
            ElseIf (bits > 64)
                normalized = This.Module.FloatTruncate(normalized, f64Type,
                    This.Unique("any_float_narrow"));
            payload = This.Module.BitCast(normalized, This.Module.IntType(64),
                This.Unique("any_float"));
        }
        ElseIf (value.Type.Kind == [int](TypeKind.StringType))
        {
            byte* isNull = This.Module.Compare([int](LlvmIntPredicate.Equal),
                value.Handle, This.Module.ConstNull(This.TypeHandle(value.Type)),
                This.Unique("any_string_null"));
            byte* raw = This.Module.PointerToInt(value.Handle,
                This.Module.IntType(64), This.Unique("any_string"));
            tag = 5;
            byte* tagValue = This.Module.Select(isNull,
                This.Module.ConstInt(This.Module.IntType(64), 0),
                This.Module.ConstInt(This.Module.IntType(64), tag),
                This.Unique("any_string_tag"));
            payload = This.Module.Select(isNull,
                This.Module.ConstInt(This.Module.IntType(64), 0), raw,
                This.Unique("any_string_payload"));
            byte* boxed = This.Module.ConstUndef(This.AnyType);
            boxed = This.Module.InsertValue(boxed, tagValue, 0, "");
            boxed = This.Module.InsertValue(boxed, payload, 1, "");
            Return New LlvmValue(boxed, This.Semantics.Primitive("any"));
        }
        ElseIf (This.IsReferenceType(value.Type))
        {
            tag = value.Type.Kind == [int](TypeKind.ListType) ? 8 :
                (value.Type.Kind == [int](TypeKind.DictType) ? 7 :
                (value.Type.Kind == [int](TypeKind.SetType) ? 9 : 6));
            byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
            byte* pointer = This.Module.BitCast(value.Handle, bytePointer,
                This.Unique("any_pointer_cast"));
            byte* isNull = This.Module.Compare([int](LlvmIntPredicate.Equal),
                pointer, This.Module.ConstNull(bytePointer),
                This.Unique("any_pointer_null"));
            byte* raw = This.Module.PointerToInt(pointer,
                This.Module.IntType(64), This.Unique("any_pointer"));
            byte* tagValue = This.Module.Select(isNull,
                This.Module.ConstInt(This.Module.IntType(64), 0),
                This.Module.ConstInt(This.Module.IntType(64), tag),
                This.Unique("any_pointer_tag"));
            payload = This.Module.Select(isNull,
                This.Module.ConstInt(This.Module.IntType(64), 0), raw,
                This.Unique("any_pointer_payload"));
            byte* boxed = This.Module.ConstUndef(This.AnyType);
            boxed = This.Module.InsertValue(boxed, tagValue, 0, "");
            boxed = This.Module.InsertValue(boxed, payload, 1, "");
            Return New LlvmValue(boxed, This.Semantics.Primitive("any"));
        }
        ElseIf (This.Semantics.IsStructType(value.Type) ||
                value.Type.Kind == [int](TypeKind.ArrayType) ||
                value.Type.Kind == [int](TypeKind.PackageType))
        {
            // `any` has a fixed two-word ABI. Preserve value aggregates in a
            // GC allocation and store its address in the pointer payload.
            tag = 6;
            byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
            byte* storage = This.CallRuntime("__kn_gc_alloc",
                This.Types1(This.Module.SizeOf(This.TypeHandle(value.Type))),
                This.Unique("any_aggregate"));
            byte* typedStorage = This.Module.BitCast(storage,
                This.Module.PointerType(This.TypeHandle(value.Type)),
                This.Unique("any_aggregate_pointer"));
            This.Module.Store(value.Handle, typedStorage);
            payload = This.Module.PointerToInt(
                This.Module.BitCast(storage, bytePointer,
                    This.Unique("any_aggregate_raw")),
                This.Module.IntType(64), This.Unique("any_aggregate_payload"));
        }
        ElseIf (value.Type.Kind == [int](TypeKind.NullType))
        {
            tag = 0;
        }
        Else
        {
            This.Fail("cannot box value as any: " + value.Type.Name);
        }
        byte* boxed = This.Module.ConstUndef(This.AnyType);
        boxed = This.Module.InsertValue(boxed, This.Module.ConstInt(This.Module.IntType(64), tag), 0, "");
        boxed = This.Module.InsertValue(boxed, payload, 1, "");
        Return New LlvmValue(boxed, This.Semantics.Primitive("any"));
    }

    Public Trusted Function LlvmValue AnyValue(byte* tag, byte* payload)
    {
        byte* value = This.Module.ConstUndef(This.AnyType);
        value = This.Module.InsertValue(value, tag, 0, "");
        value = This.Module.InsertValue(value, payload, 1, "");
        Return New LlvmValue(value, This.Semantics.Primitive("any"));
    }

    Public Trusted Function LlvmValue AnyFromSlots(byte* tagSlot, byte* payloadSlot,
                                                    string prefix)
    {
        byte* tag = This.Module.Load(This.Module.IntType(64), tagSlot,
            This.Unique(prefix + "_tag"));
        byte* payload = This.Module.Load(This.Module.IntType(64), payloadSlot,
            This.Unique(prefix + "_payload"));
        Return This.AnyValue(tag, payload);
    }

    Public Trusted Function LlvmValue RunAsyncTask(byte* task, string prefix)
    {
        byte* int64Type = This.Module.IntType(64);
        byte* tagSlot = This.Module.Alloca(int64Type,
            This.Unique(prefix + "_tag_slot"));
        byte* payloadSlot = This.Module.Alloca(int64Type,
            This.Unique(prefix + "_payload_slot"));
        This.Module.Store(This.Module.ConstInt(int64Type, 0), tagSlot);
        This.Module.Store(This.Module.ConstInt(int64Type, 0), payloadSlot);
        byte* rawTask = This.Module.BitCast(task,
            This.Module.PointerType(This.Module.IntType(8)),
            This.Unique(prefix + "_task"));
        This.CallRuntime("__kn_async_task_run",
            This.Types3(rawTask, tagSlot, payloadSlot), "");
        Return This.AnyFromSlots(tagSlot, payloadSlot, prefix);
    }

    Public Trusted Function LlvmValue AwaitTaskResult(
        LlvmFunctionContext context, byte* task, TypeSymbol resultType,
        string prefix)
    {
        LlvmValue boxed = This.RunAsyncTask(task, prefix);
        This.MaybePropagateException(context);
        If (resultType.Kind == [int](TypeKind.VoidType))
            Return This.DefaultValue(resultType);
        If (resultType.Kind == [int](TypeKind.AnyType)) Return boxed;
        Return This.UnboxAny(boxed, resultType);
    }

    Public Trusted Function LlvmValue UnboxAny(LlvmValue value, TypeSymbol target)
    {
        byte* tag = This.Module.ExtractValue(value.Handle, 0, This.Unique("any_tag"));
        byte* payload = This.Module.ExtractValue(value.Handle, 1, This.Unique("any_payload"));
        If (target.Kind == [int](TypeKind.BoolType))
            Return New LlvmValue(This.RuntimeBool(This.CallRuntime("kn_sh_rt_any_to_bool",
                This.Types2(tag, payload), This.Unique("any_bool_c"))), target);
        If (This.IsIntegerLike(target))
        {
            byte* converted = target.Name == "char" ?
                This.CallRuntime("kn_sh_rt_any_to_char", This.Types2(tag, payload),
                    This.Unique("any_char")) :
                This.CallRuntime("kn_sh_rt_any_to_i64", This.Types2(tag, payload),
                    This.Unique("any_i64"));
            int bits = This.IntegerBits(target);
            byte* raw = bits < 64 && target.Name != "char" ?
                This.Module.Truncate(converted, This.Module.IntType(bits),
                    This.Unique("any_int")) : converted;
            Return New LlvmValue(raw, target);
        }
        If (target.Kind == [int](TypeKind.FloatType))
        {
            byte* raw = This.CallRuntime("kn_sh_rt_any_to_f64",
                This.Types2(tag, payload), This.Unique("any_float"));
            int bits = This.FloatBits(target);
            If (bits < 64)
                raw = This.Module.FloatTruncate(raw, This.TypeHandle(target),
                    This.Unique("any_float_narrow"));
            ElseIf (bits > 64)
                raw = This.Module.FloatExtend(raw, This.TypeHandle(target),
                    This.Unique("any_float_widen"));
            Return New LlvmValue(raw, target);
        }
        If (This.Semantics.IsStructType(target) ||
            target.Kind == [int](TypeKind.ArrayType) ||
            target.Kind == [int](TypeKind.PackageType))
        {
            byte* hasPointerTag = This.Module.Compare(
                [int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(This.Module.IntType(64), 6),
                This.Unique("any_aggregate_tag_match"));
            byte* hasPayload = This.Module.Compare(
                [int](LlvmIntPredicate.NotEqual), payload,
                This.Module.ConstInt(This.Module.IntType(64), 0),
                This.Unique("any_aggregate_nonnull"));
            byte* valid = This.Module.And(hasPointerTag, hasPayload,
                This.Unique("any_aggregate_valid"));
            byte* aggregateType = This.TypeHandle(target);
            byte* aggregatePointer = This.Module.PointerType(aggregateType);
            byte* raw = This.Module.IntToPointer(payload,
                This.Module.PointerType(This.Module.IntType(8)),
                This.Unique("any_aggregate_raw"));
            byte* typed = This.Module.BitCast(raw, aggregatePointer,
                This.Unique("any_aggregate_pointer"));
            byte* fallback = This.Module.Alloca(aggregateType,
                This.Unique("any_aggregate_default"));
            This.Module.Store(This.Module.ConstNull(aggregateType), fallback);
            byte* selected = This.Module.Select(valid, typed, fallback,
                This.Unique("any_aggregate_selected"));
            Return New LlvmValue(This.Module.Load(aggregateType, selected,
                This.Unique("any_aggregate_value")), target);
        }
        If (This.IsReferenceType(target))
            Return New LlvmValue(This.Module.IntToPointer(payload, This.TypeHandle(target), This.Unique("any_pointer")), target);
        Return This.DefaultValue(target);
    }

    Public Trusted Function LlvmValue AnyToString(LlvmValue value, TypeSymbol target)
    {
        byte* tag = This.Module.ExtractValue(value.Handle, 0, This.Unique("any_tag"));
        byte* payload = This.Module.ExtractValue(value.Handle, 1, This.Unique("any_payload"));
        If (tag == null || payload == null)
        {
            This.Fail("cannot extract dynamic any value for string conversion");
            Return This.DefaultValue(target);
        }
        byte* result = This.CallRuntime("kn_sh_rt_any_to_string",
            This.Types2(tag, payload), This.Unique("any_text"));
        If (result == null) This.Fail("cannot lower dynamic any-to-string conversion");
        Return New LlvmValue(result, target);
    }

    Public Trusted Function LlvmValue CastValue(LlvmValue value, TypeSymbol target)
    {
        If (value == null || target == null) Return value;
        If (This.SameType(value.Type, target)) Return New LlvmValue(value.Handle, target);
        If (target.Kind == [int](TypeKind.AnyType)) Return This.BoxAny(value);
        If (value.Type.Kind == [int](TypeKind.AnyType) && target.Kind == [int](TypeKind.StringType))
            Return This.AnyToString(value, target);
        If (value.Type.Kind == [int](TypeKind.AnyType)) Return This.UnboxAny(value, target);
        If (value.Type.Kind == [int](TypeKind.NullType)) Return This.DefaultValue(target);

        If (target.Kind == [int](TypeKind.StringType))
        {
            If (value.Type.Name == "char")
                Return New LlvmValue(This.CallRuntime("kn_sh_rt_char_to_string",
                    This.Types1(value.Handle), This.Unique("char_text")), target);
            If (value.Type.Kind == [int](TypeKind.BoolType))
                Return New LlvmValue(This.Module.Select(value.Handle,
                    This.Module.GlobalString("true", This.Unique("true")),
                    This.Module.GlobalString("false", This.Unique("false")), This.Unique("bool_text")), target);
            If (This.IsIntegerLike(value.Type))
                Return New LlvmValue(This.CallRuntime("kn_sh_rt_i64_to_string",
                    This.Types1(This.ToI64(value)), This.Unique("int_text")), target);
            If (value.Type.Kind == [int](TypeKind.FloatType))
            {
                byte* floatValue = This.FloatBits(value.Type) < 64 ?
                    This.Module.FloatExtend(value.Handle, This.Module.FloatType(64),
                        This.Unique("float_text_wide")) : value.Handle;
                Return New LlvmValue(This.CallRuntime("kn_sh_rt_f64_to_string",
                    This.Types1(floatValue), This.Unique("float_text")), target);
            }
        }
        If (value.Type.Kind == [int](TypeKind.StringType) && This.IsIntegerLike(target))
        {
            byte* parsed = This.CallRuntime("kn_sh_rt_string_to_i64", This.Types1(value.Handle), This.Unique("parsed"));
            int bits = This.IntegerBits(target);
            If (bits < 64) parsed = This.Module.Truncate(parsed, This.Module.IntType(bits), This.Unique("parsed_narrow"));
            Return New LlvmValue(parsed, target);
        }
        If (value.Type.Kind == [int](TypeKind.StringType) && target.Kind == [int](TypeKind.FloatType))
        {
            string runtimeName = target.Name == "f32" ? "kn_sh_rt_string_to_f32" :
                "kn_sh_rt_string_to_f64";
            Return New LlvmValue(This.CallRuntime(runtimeName, This.Types1(value.Handle),
                This.Unique("parsed_float")), target);
        }
        If (value.Type.Kind == [int](TypeKind.StringType) && target.Kind == [int](TypeKind.BoolType))
            Return New LlvmValue(This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_to_bool",
                This.Types1(value.Handle), This.Unique("string_bool_c"))), target);
        If (value.Type.Kind == [int](TypeKind.StringType) && target.Name == "char")
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_string_to_char",
                This.Types1(value.Handle), This.Unique("string_char")), target);
        If (target.Kind == [int](TypeKind.BoolType) && This.IsIntegerLike(value.Type))
            Return New LlvmValue(This.Module.Compare([int](LlvmIntPredicate.NotEqual), value.Handle,
                This.Module.ConstInt(This.TypeHandle(value.Type), 0), This.Unique("to_bool")), target);
        If (value.Type.Kind == [int](TypeKind.BoolType) && This.IsIntegerLike(target))
        {
            byte* extended = This.Module.ZeroExtend(value.Handle, This.TypeHandle(target), This.Unique("bool_int"));
            Return New LlvmValue(extended, target);
        }
        If (This.IsIntegerLike(value.Type) && This.IsIntegerLike(target))
        {
            int sourceBits = This.IntegerBits(value.Type);
            int targetBits = This.IntegerBits(target);
            byte* converted = value.Handle;
            If (sourceBits < targetBits)
            {
                If (This.IsUnsignedInteger(value.Type))
                    converted = This.Module.ZeroExtend(converted, This.TypeHandle(target), This.Unique("uint_widen"));
                Else converted = This.Module.SignExtend(converted, This.TypeHandle(target), This.Unique("int_widen"));
            }
            ElseIf (sourceBits > targetBits) converted = This.Module.Truncate(converted, This.TypeHandle(target), This.Unique("int_narrow"));
            Return New LlvmValue(converted, target);
        }
        If (This.IsIntegerLike(value.Type) && target.Kind == [int](TypeKind.FloatType))
        {
            byte* converted = This.IsUnsignedInteger(value.Type) ?
                This.Module.UnsignedIntToFloat(value.Handle, This.TypeHandle(target), This.Unique("uint_to_float")) :
                This.Module.SignedIntToFloat(value.Handle, This.TypeHandle(target), This.Unique("int_to_float"));
            Return New LlvmValue(converted, target);
        }
        If (value.Type.Kind == [int](TypeKind.FloatType) && This.IsIntegerLike(target))
        {
            byte* converted = This.IsUnsignedInteger(target) ?
                This.Module.FloatToUnsignedInt(value.Handle, This.TypeHandle(target), This.Unique("float_to_uint")) :
                This.Module.FloatToSignedInt(value.Handle, This.TypeHandle(target), This.Unique("float_to_int"));
            Return New LlvmValue(converted, target);
        }
        If (value.Type.Kind == [int](TypeKind.FloatType) &&
            target.Kind == [int](TypeKind.FloatType))
        {
            int sourceBits = This.FloatBits(value.Type);
            int targetBits = This.FloatBits(target);
            If (sourceBits < targetBits)
                Return New LlvmValue(This.Module.FloatExtend(value.Handle,
                    This.TypeHandle(target), This.Unique("float_widen")), target);
            If (sourceBits > targetBits)
                Return New LlvmValue(This.Module.FloatTruncate(value.Handle,
                    This.TypeHandle(target), This.Unique("float_narrow")), target);
            Return New LlvmValue(value.Handle, target);
        }
        If (This.IsIntegerLike(value.Type) && target.Kind == [int](TypeKind.PointerType))
            Return New LlvmValue(This.Module.IntToPointer(This.ToI64(value), This.TypeHandle(target),
                This.Unique("int_to_pointer")), target);
        If (value.Type.Kind == [int](TypeKind.PointerType) && This.IsIntegerLike(target))
        {
            byte* raw = This.Module.PointerToInt(value.Handle, This.Module.IntType(64),
                This.Unique("pointer_to_int"));
            If (This.IntegerBits(target) < 64) raw = This.Module.Truncate(raw, This.TypeHandle(target),
                This.Unique("pointer_to_narrow_int"));
            Return New LlvmValue(raw, target);
        }
        If (value.Type.Kind == [int](TypeKind.ArrayType) &&
            target.Kind == [int](TypeKind.PointerType))
        {
            byte* data = This.Module.ExtractValue(value.Handle, 0,
                This.Unique("array_pointer_data"));
            Return New LlvmValue(This.Module.BitCast(data, This.TypeHandle(target),
                This.Unique("array_pointer")), target);
        }
        If (This.IsReferenceType(value.Type) && This.IsReferenceType(target))
            Return New LlvmValue(This.Module.BitCast(value.Handle, This.TypeHandle(target), This.Unique("ref_cast")), target);
        Return New LlvmValue(value.Handle, target);
    }

    Public Trusted Function LlvmValue FromCAbi(byte* value, TypeSymbol type)
    {
        If (type.Kind == [int](TypeKind.VoidType)) Return New LlvmValue(null, type);
        If (type.Name == "int")
            Return New LlvmValue(This.Module.SignExtend(value, This.Module.IntType(64), This.Unique("c_int")), type);
        If (type.Name == "bool")
            Return New LlvmValue(This.RuntimeBool(value), type);
        If (type.Kind == [int](TypeKind.ArrayType))
        {
            byte* array = This.Module.ConstUndef(This.TypeHandle(type));
            array = This.Module.InsertValue(array, This.Module.BitCast(value,
                This.Module.PointerType(This.TypeHandle(type.ElementType)),
                This.Unique("ffi_array_data")), 0, "");
            array = This.Module.InsertValue(array,
                This.Module.ConstInt(This.Module.IntType(64), 0), 1, "");
            Return New LlvmValue(array, type);
        }
        Return New LlvmValue(value, type);
    }

    Public Trusted Function byte* ToCAbi(LlvmValue value, TypeSymbol type)
    {
        If (value.Type.Kind == [int](TypeKind.ArrayType) &&
            type.Kind == [int](TypeKind.PointerType))
            Return This.Module.ExtractValue(value.Handle, 0,
                This.Unique("ffi_array_data"));
        LlvmValue converted = This.CastValue(value, type);
        If (type.Kind == [int](TypeKind.ArrayType))
            Return This.Module.ExtractValue(converted.Handle, 0,
                This.Unique("ffi_array_data"));
        If (type.Name == "int")
            Return This.Module.Truncate(converted.Handle, This.Module.IntType(32), This.Unique("ffi_int"));
        If (type.Name == "bool")
            Return This.Module.ZeroExtend(converted.Handle, This.Module.IntType(32), This.Unique("ffi_bool"));
        Return converted.Handle;
    }

    Public Safe Function int FieldIndex(TypeSymbol owner, string name)
    {
        If (owner == null || owner.Declaration == null) Return -1;
        If (This.Semantics.IsStructType(owner))
        {
            int structIndex = 0;
            FieldDecl structField = owner.Declaration.FirstField;
            While (structField != null)
            {
                If (!structField.IsStatic)
                {
                    If (structField.Name == name) Return structIndex;
                    structIndex = structIndex + 1;
                }
                structField = structField.Next;
            }
            Return -1;
        }
        int inherited = This.FieldIndex(owner.BaseType, name);
        If (inherited >= 0) Return inherited;
        int index = 2 + This.InstanceFieldCount(owner.BaseType);
        FieldDecl field = owner.Declaration.FirstField;
        While (field != null)
        {
            If (!field.IsStatic)
            {
                If (field.Name == name) Return index;
                index = index + 1;
            }
            field = field.Next;
        }
        Return -1;
    }

    Public Trusted Function int InitializeObjectFields(LlvmTypeBinding binding,
                                                        byte* object,
                                                        TypeSymbol type,
                                                        int fieldIndex)
    {
        If (type == null || type.Declaration == null) Return fieldIndex;
        fieldIndex = This.InitializeObjectFields(binding, object, type.BaseType, fieldIndex);
        FieldDecl field = type.Declaration.FirstField;
        While (field != null)
        {
            If (!field.IsStatic)
            {
                TypeSymbol fieldType = This.Semantics.ResolveType(type.Syntax, field.TypeName);
                byte* address = This.Module.StructGep(binding.StructHandle, object,
                    fieldIndex, This.Unique("field_init"));
                int lengthValue = This.FixedArrayLength(type.UnitName, field.TypeName);
                If (fieldType.Kind == [int](TypeKind.ArrayType) && lengthValue >= 0)
                {
                    byte* elementHandle = This.TypeHandle(fieldType.ElementType);
                    byte* length = This.Module.ConstInt(This.Module.IntType(64), lengthValue);
                    byte* bytes = This.Module.Multiply(length, This.Module.SizeOf(elementHandle),
                        This.Unique("field_array_bytes"));
                    byte* memory = This.CallRuntime("__kn_gc_alloc", This.Types1(bytes),
                        This.Unique("field_array_memory"));
                    This.CallRuntime("kn_sh_rt_memory_zero", This.Types2(memory, bytes), "");
                    byte* data = This.Module.BitCast(memory, This.Module.PointerType(elementHandle),
                        This.Unique("field_array_data"));
                    byte* value = This.Module.ConstUndef(This.TypeHandle(fieldType));
                    value = This.Module.InsertValue(value, data, 0, "");
                    value = This.Module.InsertValue(value, length, 1, "");
                    This.Module.Store(value, address);
                }
                Else This.Module.Store(This.DefaultValue(fieldType).Handle, address);
                fieldIndex = fieldIndex + 1;
            }
            field = field.Next;
        }
        Return fieldIndex;
    }

    Public Trusted Function void InitializeObjectVtable(LlvmTypeBinding binding,
                                                         byte* object,
                                                         TypeSymbol type)
    {
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* vtableSlot = This.Module.StructGep(binding.StructHandle, object, 0,
            This.Unique("vtable_slot"));
        int interfaceSlotCount = This.InterfaceSlotCount();
        int virtualSlotCount = This.VirtualSlotCount(type);
        int slotCount = interfaceSlotCount + virtualSlotCount;
        If (slotCount == 0)
        {
            This.Module.Store(This.Module.ConstNull(This.Module.PointerType(bytePointer)), vtableSlot);
            Return;
        }
        byte* count = This.Module.ConstInt(This.Module.IntType(64), slotCount);
        byte* bytes = This.Module.Multiply(count, This.Module.SizeOf(bytePointer),
            This.Unique("vtable_bytes"));
        byte* vtable = This.CallRuntime("__kn_gc_alloc", This.Types1(bytes),
            This.Unique("vtable"));
        int slot = 0;
        While (slot < interfaceSlotCount)
        {
            FunctionSymbol declaration = This.InterfaceSlotDeclaration(slot);
            LlvmFunctionBinding function = null;
            If (declaration != null &&
                This.Semantics.TypeImplementsInterface(type,
                    declaration.OwnerType))
            {
                FunctionSymbol implementation =
                    This.Semantics.FindMethodSignature(type, declaration);
                If (implementation != null &&
                    !implementation.Declaration.IsAbstract)
                    function = This.FindFunctionBinding(implementation);
            }
            byte* address = This.Module.Gep(bytePointer, vtable,
                This.Types1(This.Module.ConstInt(This.Module.IntType(64), slot)), true,
                This.Unique("interface_vtable_entry"));
            This.Module.Store(function == null ?
                This.Module.ConstNull(bytePointer) : function.Function, address);
            slot = slot + 1;
        }
        int virtualSlot = 0;
        While (virtualSlot < virtualSlotCount)
        {
            FunctionSymbol declaration = This.VirtualSlotDeclaration(type,
                virtualSlot);
            FunctionSymbol implementation = This.VirtualImplementation(type, declaration);
            LlvmFunctionBinding function = This.FindFunctionBinding(implementation);
            If (function == null)
            {
                This.Fail("virtual method binding is missing: " + declaration.QualifiedName());
            }
            Else
            {
                byte* address = This.Module.Gep(bytePointer, vtable,
                    This.Types1(This.Module.ConstInt(This.Module.IntType(64),
                        interfaceSlotCount + virtualSlot)), true,
                    This.Unique("vtable_entry"));
                This.Module.Store(function.Function, address);
            }
            virtualSlot = virtualSlot + 1;
        }
        This.Module.Store(vtable, vtableSlot);
    }

    Public Trusted Function void InitializeObjectTypeId(LlvmTypeBinding binding,
                                                         byte* object)
    {
        byte* typeIdSlot = This.Module.StructGep(binding.StructHandle, object, 1,
            This.Unique("type_id_slot"));
        This.Module.Store(This.Module.ConstInt(This.Module.IntType(64),
            binding.RuntimeTypeId), typeIdSlot);
    }

    Public Safe Function bool RuntimeTypeAssignable(TypeSymbol actual,
                                                     TypeSymbol target)
    {
        If (actual == null || target == null || This.IsEnum(actual) ||
            This.IsEnum(target) || This.Semantics.IsStructType(actual) ||
            This.Semantics.IsStructType(target)) Return false;
        If (target.Name == "IO.Type.Object.Class" ||
            target.Name == "Object.Class") Return true;
        If (This.Semantics.IsInterfaceType(target))
            Return This.Semantics.TypeImplementsInterface(actual, target);
        TypeSymbol current = actual;
        While (current != null)
        {
            If (This.Semantics.SameType(current, target)) Return true;
            current = current.BaseType;
        }
        Return false;
    }

    Public Trusted Function byte* ObjectHeaderType()
    {
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        LlvmHandles headerFields = New LlvmHandles();
        headerFields.Add(This.Module.PointerType(bytePointer));
        headerFields.Add(This.Module.IntType(64));
        Return This.Module.LiteralStructType(headerFields, false);
    }

    Public Trusted Function byte* LoadObjectVtable(byte* object)
    {
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* headerType = This.ObjectHeaderType();
        byte* header = This.Module.BitCast(object,
            This.Module.PointerType(headerType), This.Unique("object_header"));
        byte* vtableAddress = This.Module.StructGep(headerType, header, 0,
            This.Unique("object_vtable_address"));
        Return This.Module.Load(This.Module.PointerType(bytePointer),
            vtableAddress, This.Unique("object_vtable"));
    }

    Public Trusted Function byte* LoadRuntimeTypeId(byte* object)
    {
        byte* headerType = This.ObjectHeaderType();
        byte* header = This.Module.BitCast(object,
            This.Module.PointerType(headerType), This.Unique("object_header"));
        byte* typeIdAddress = This.Module.StructGep(headerType, header, 1,
            This.Unique("object_type_id_address"));
        Return This.Module.Load(This.Module.IntType(64), typeIdAddress,
            This.Unique("object_type_id"));
    }

    Public Trusted Function byte* EmitRuntimeTypeIdMatch(byte* object,
                                                          TypeSymbol target)
    {
        byte* typeId = This.LoadRuntimeTypeId(object);
        byte* matched = This.Module.ConstInt(This.Module.IntType(1), 0);
        LlvmTypeBinding candidate = This.FirstType;
        While (candidate != null)
        {
            If (This.RuntimeTypeAssignable(candidate.Symbol, target))
            {
                byte* equals = This.Module.Compare([int](LlvmIntPredicate.Equal),
                    typeId, This.Module.ConstInt(This.Module.IntType(64),
                        candidate.RuntimeTypeId), This.Unique("type_id_equal"));
                matched = This.Module.Or(matched, equals,
                    This.Unique("type_id_match"));
            }
            candidate = candidate.Next;
        }
        Return matched;
    }

    Public Trusted Function byte* EmitGuardedRuntimeTypeMatch(
        LlvmFunctionContext context, byte* object, byte* isObject,
        TypeSymbol target)
    {
        byte* entryBlock = This.Module.CurrentBlock();
        byte* matchBlock = This.Module.AppendBlock(context.Binding.Function,
            This.Unique("type_match"));
        byte* doneBlock = This.Module.AppendBlock(context.Binding.Function,
            This.Unique("type_match_done"));
        This.Module.ConditionalBranch(isObject, matchBlock, doneBlock);

        This.Module.PositionAtEnd(matchBlock);
        byte* matched = This.EmitRuntimeTypeIdMatch(object, target);
        byte* matchEnd = This.Module.CurrentBlock();
        This.Module.Branch(doneBlock);

        This.Module.PositionAtEnd(doneBlock);
        byte* result = This.Module.Phi(This.Module.IntType(1),
            This.Unique("type_match_result"));
        This.Module.AddIncoming(result,
            This.Module.ConstInt(This.Module.IntType(1), 0), entryBlock);
        This.Module.AddIncoming(result, matched, matchEnd);
        Return result;
    }

    Public Safe Function int EnumValue(TypeSymbol type, string target)
    {
        If (type == null || type.Declaration == null) Return 0;
        int value = 0;
        EnumMemberDecl member = type.Declaration.FirstEnumMember;
        While (member != null)
        {
            If (member.Value != null) value = [int](member.Value.Text);
            If (IO.Text.EndsWith(target, "." + member.Name) || target == member.Name) Return value;
            value = value + 1;
            member = member.Next;
        }
        Return 0;
    }

    Public Trusted Function byte* EmitAddress(LlvmFunctionContext context, HirExpression expression)
    {
        If (expression == null) Return null;
        If (expression.Kind == [int](HirExpressionKind.Local))
        {
            LlvmVariable variable = context.FindVariable(expression.Symbol, expression.Target);
            Return variable == null ? null : variable.Address;
        }
        If (expression.Kind == [int](HirExpressionKind.Global))
        {
            LlvmGlobalBinding global = This.FindGlobalBinding(expression.Symbol);
            Return global == null ? null : global.Address;
        }
        If (expression.Kind == [int](HirExpressionKind.Delegate))
        {
            LlvmDelegateBinding delegate = This.FindDelegateBinding(expression.Function);
            Return delegate == null ? null : delegate.Address;
        }
        If (expression.Kind == [int](HirExpressionKind.Field))
        {
            LlvmValue receiver = This.EmitExpression(context, expression.Left);
            int index = This.FieldIndex(receiver.Type, expression.Target);
            LlvmTypeBinding binding = This.FindTypeBinding(receiver.Type);
            If (index < 0 || binding == null)
            {
                This.Fail("unknown field address: " + expression.Target);
                Return null;
            }
            byte* base = receiver.Handle;
            If (This.Semantics.IsStructType(receiver.Type))
            {
                base = receiver.Address;
                If (base == null)
                {
                    base = This.Module.Alloca(This.TypeHandle(receiver.Type),
                        This.Unique("struct_temporary"));
                    This.Module.Store(receiver.Handle, base);
                }
            }
            Return This.Module.StructGep(binding.StructHandle, base, index, This.Unique("field"));
        }
        If (expression.Kind == [int](HirExpressionKind.Index))
        {
            LlvmValue receiver = This.EmitExpression(context, expression.Left);
            LlvmValue indexValue = This.CastValue(This.EmitExpression(context, expression.Right),
                This.Semantics.Primitive("int"));
            If (receiver.Type.Kind == [int](TypeKind.ArrayType) ||
                receiver.Type.Kind == [int](TypeKind.PackageType))
            {
                byte* data = This.Module.ExtractValue(receiver.Handle, 0, This.Unique("array_data"));
                LlvmHandles indices = This.Types1(indexValue.Handle);
                Return This.Module.Gep(This.TypeHandle(receiver.Type.ElementType), data, indices, true,
                    This.Unique("element"));
            }
            If (receiver.Type.Kind == [int](TypeKind.PointerType))
            {
                LlvmHandles indices = This.Types1(indexValue.Handle);
                Return This.Module.Gep(This.TypeHandle(receiver.Type.ElementType), receiver.Handle, indices, true,
                    This.Unique("pointer_element"));
            }
            If (receiver.Type.Kind == [int](TypeKind.StringType))
                Return This.Module.Gep(This.Module.IntType(8), receiver.Handle,
                    This.Types1(indexValue.Handle), true, This.Unique("string_character"));
        }
        Return null;
    }

    Public Trusted Function LlvmValue EmitErrorField(
        LlvmFunctionContext context, HirExpression expression)
    {
        LlvmValue receiver = This.EmitExpression(context, expression.Left);
        byte* raw = This.ErrorPointer(receiver);
        If (expression.Target == "Inner")
        {
            byte* inner = This.CallRuntime("kn_sh_rt_error_inner",
                This.Types1(raw), This.Unique("error_inner"));
            Return New LlvmValue(This.Module.BitCast(inner,
                This.TypeHandle(expression.Type), This.Unique("typed_error_inner")),
                expression.Type);
        }
        string runtimeName = expression.Target == "Title" ?
            "kn_sh_rt_error_title" :
            (expression.Target == "Message" ? "kn_sh_rt_error_message" :
            "kn_sh_rt_error_trace");
        Return New LlvmValue(This.CallRuntime(runtimeName, This.Types1(raw),
            This.Unique("error_field")), expression.Type);
    }

    Public Trusted Function LlvmValue EmitPackageIndex(LlvmFunctionContext context,
                                                         HirExpression expression)
    {
        LlvmValue receiver = This.EmitExpression(context, expression.Left);
        LlvmValue indexValue = This.CastValue(This.EmitExpression(context, expression.Right),
            This.Semantics.Primitive("int"));
        byte* data = This.Module.ExtractValue(receiver.Handle, 0, This.Unique("package_data"));
        byte* address = This.Module.Gep(This.AnyType, data, This.Types1(indexValue.Handle), true,
            This.Unique("package_element"));
        LlvmValue boxed = New LlvmValue(This.Module.Load(This.AnyType, address,
            This.Unique("package_any")), This.Semantics.Primitive("any"));
        // Package storage is internally boxed as `any`, but indexing a typed
        // package is an extraction, not a language-level dynamic conversion.
        LlvmValue result = expression.Type.Kind == [int](TypeKind.AnyType) ? boxed :
            This.UnboxAny(boxed, expression.Type);
        result.Address = address;
        Return result;
    }

    Public Safe Function int HirArgumentCount(HirExpression expression)
    {
        int count = 0;
        HirExpression argument = expression.FirstArgument;
        While (argument != null)
        {
            count = count + 1;
            argument = argument.Next;
        }
        Return count;
    }

    Public Trusted Function LlvmValue EmitFunctionCall(LlvmFunctionContext context,
                                                        LlvmFunctionBinding binding,
                                                        HirExpression expression,
                                                        LlvmValue receiver)
    {
        LlvmHandles arguments = New LlvmHandles();
        TypeSymbol callResultType = binding.Symbol.Declaration.IsAsync ?
            expression.Type : binding.Symbol.ReturnType;
        bool hasReceiver = binding.Symbol.OwnerType != null &&
            (!binding.Symbol.Declaration.IsStatic || binding.Symbol.Declaration.IsConstructor);
        If (hasReceiver)
        {
            If (receiver == null)
            {
                LlvmVariable thisVariable = context.FindVariable(context.Binding.Symbol.Receiver, "This");
                If (thisVariable != null)
                    receiver = New LlvmValue(This.Module.Load(This.TypeHandle(thisVariable.Type),
                        thisVariable.Address, This.Unique("this")), thisVariable.Type);
            }
            If (receiver == null)
            {
                This.Fail("instance call has no receiver: " + binding.Symbol.QualifiedName());
                Return This.DefaultValue(callResultType);
            }
            arguments.Add(This.CastValue(receiver, binding.Symbol.OwnerType).Handle);
        }

        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        HirExpression argument = expression == null ? null : expression.FirstArgument;
        While (parameter != null)
        {
            If (argument == null)
            {
                This.Fail("missing argument for " + binding.Symbol.QualifiedName());
                arguments.Add(This.DefaultValue(parameter.Type).Handle);
            }
            Else
            {
                LlvmValue value = This.EmitExpression(context, argument);
                arguments.Add(binding.UsesCAbi ? This.ToCAbi(value, parameter.Type) :
                    This.CastValue(value, parameter.Type).Handle);
                argument = argument.Next;
            }
            parameter = parameter.Next;
        }
        string resultName = callResultType.Kind == [int](TypeKind.VoidType) ? "" : This.Unique("call");
        byte* result = This.Module.Call(binding.FunctionType, binding.Function, arguments, resultName);
        If (!binding.UsesCAbi) This.MaybePropagateException(context);
        Return binding.UsesCAbi ? This.FromCAbi(result, binding.Symbol.ReturnType) :
            New LlvmValue(result, callResultType);
    }

    Public Trusted Function LlvmValue EmitVirtualFunctionCall(LlvmFunctionContext context,
                                                               LlvmFunctionBinding binding,
                                                               HirExpression expression,
                                                               LlvmValue receiver)
    {
        TypeSymbol callResultType = binding.Symbol.Declaration.IsAsync ?
            expression.Type : binding.Symbol.ReturnType;
        If (receiver == null)
        {
            LlvmVariable thisVariable = context.FindVariable(context.Binding.Symbol.Receiver, "This");
            If (thisVariable != null)
                receiver = New LlvmValue(This.Module.Load(This.TypeHandle(thisVariable.Type),
                    thisVariable.Address, This.Unique("this")), thisVariable.Type);
        }
        If (receiver == null)
        {
            This.Fail("virtual call has no receiver: " + binding.Symbol.QualifiedName());
            Return This.DefaultValue(callResultType);
        }
        int slot = This.DispatchSlot(binding.Symbol.OwnerType,
            binding.Symbol);
        If (slot < 0)
        {
            This.Fail("virtual slot is missing: " + binding.Symbol.QualifiedName());
            Return This.DefaultValue(callResultType);
        }
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* rawReceiver = This.Module.BitCast(receiver.Handle, bytePointer,
            This.Unique("virtual_receiver"));
        byte* vtable = This.LoadObjectVtable(rawReceiver);
        byte* methodAddress = This.Module.Gep(bytePointer, vtable,
            This.Types1(This.Module.ConstInt(This.Module.IntType(64), slot)), true,
            This.Unique("virtual_slot"));
        byte* callable = This.Module.Load(This.Module.PointerType(binding.FunctionType),
            methodAddress, This.Unique("virtual_method"));

        LlvmHandles arguments = New LlvmHandles();
        arguments.Add(This.CastValue(receiver, binding.Symbol.OwnerType).Handle);
        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        HirExpression argument = expression.FirstArgument;
        While (parameter != null)
        {
            If (argument == null)
            {
                This.Fail("missing argument for " + binding.Symbol.QualifiedName());
                arguments.Add(This.DefaultValue(parameter.Type).Handle);
            }
            Else
            {
                arguments.Add(This.CastValue(This.EmitExpression(context, argument),
                    parameter.Type).Handle);
                argument = argument.Next;
            }
            parameter = parameter.Next;
        }
        string resultName = callResultType.Kind == [int](TypeKind.VoidType) ?
            "" : This.Unique("virtual_call");
        byte* result = This.Module.Call(binding.FunctionType, callable,
            arguments, resultName);
        This.MaybePropagateException(context);
        Return New LlvmValue(result, callResultType);
    }

    Public Trusted Function LlvmValue EmitDelegateCall(LlvmFunctionContext context,
                                                        HirExpression expression)
    {
        LlvmDelegateBinding binding = This.FindDelegateBinding(expression.Function);
        If (binding == null)
        {
            This.Fail("delegate binding is missing: " + expression.Target);
            Return This.DefaultValue(expression.Type);
        }
        byte* pointerType = This.Module.PointerType(binding.FunctionType);
        byte* callable = This.Module.Load(pointerType, binding.Address, This.Unique("delegate"));
        LlvmHandles arguments = New LlvmHandles();
        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        HirExpression argument = expression.FirstArgument;
        While (parameter != null)
        {
            If (argument == null)
            {
                This.Fail("missing delegate argument: " + binding.Symbol.QualifiedName());
                arguments.Add(This.DefaultValue(parameter.Type).Handle);
            }
            Else
            {
                LlvmValue value = This.EmitExpression(context, argument);
                arguments.Add(binding.UsesCAbi ? This.ToCAbi(value, parameter.Type) :
                    This.CastValue(value, parameter.Type).Handle);
                argument = argument.Next;
            }
            parameter = parameter.Next;
        }
        string resultName = binding.Symbol.ReturnType.Kind == [int](TypeKind.VoidType) ?
            "" : This.Unique("delegate_call");
        byte* result = This.Module.Call(binding.FunctionType, callable, arguments, resultName);
        If (!binding.UsesCAbi) This.MaybePropagateException(context);
        Return binding.UsesCAbi ? This.FromCAbi(result, binding.Symbol.ReturnType) :
            New LlvmValue(result, binding.Symbol.ReturnType);
    }

    Public Trusted Function byte* EnsureDelegateAdapter(FunctionSymbol delegate,
                                                         FunctionSymbol target)
    {
        LlvmDelegateAdapter existing = This.FirstDelegateAdapter;
        While (existing != null)
        {
            If (existing.Delegate == delegate && existing.Target == target) Return existing.Function;
            existing = existing.Next;
        }
        LlvmDelegateBinding delegateBinding = This.FindDelegateBinding(delegate);
        LlvmFunctionBinding targetBinding = This.FindFunctionBinding(target);
        If (delegateBinding == null || targetBinding == null || target.OwnerType != null ||
            delegate.ParameterCount() != target.ParameterCount())
        {
            This.Fail("incompatible delegate assignment: " + delegate.QualifiedName());
            Return null;
        }

        byte* adapter = This.Module.AddFunction("__kn_sh_delegate_adapter_" +
            This.Sanitize(delegate.QualifiedName()) + "_" + This.Sanitize(target.QualifiedName()),
            delegateBinding.FunctionType);
        LlvmDelegateAdapter cached = New LlvmDelegateAdapter(delegate, target, adapter);
        cached.Next = This.FirstDelegateAdapter;
        This.FirstDelegateAdapter = cached;

        byte* savedBlock = This.Module.CurrentBlock();
        byte* entry = This.Module.AppendBlock(adapter, "entry");
        This.Module.PositionAtEnd(entry);
        LlvmHandles arguments = New LlvmHandles();
        ParameterSymbol delegateParameter = delegate.FirstParameter;
        ParameterSymbol targetParameter = target.FirstParameter;
        int index = 0;
        While (delegateParameter != null && targetParameter != null)
        {
            LlvmValue value = delegateBinding.UsesCAbi ?
                This.FromCAbi(This.Module.Parameter(adapter, index), delegateParameter.Type) :
                New LlvmValue(This.Module.Parameter(adapter, index), delegateParameter.Type);
            arguments.Add(This.CastValue(value, targetParameter.Type).Handle);
            delegateParameter = delegateParameter.Next;
            targetParameter = targetParameter.Next;
            index = index + 1;
        }
        string resultName = target.ReturnType.Kind == [int](TypeKind.VoidType) ? "" : "result";
        byte* result = This.Module.Call(targetBinding.FunctionType, targetBinding.Function,
            arguments, resultName);
        If (delegate.ReturnType.Kind == [int](TypeKind.VoidType)) This.Module.ReturnVoid();
        Else
        {
            LlvmValue value = This.CastValue(New LlvmValue(result, target.ReturnType),
                delegate.ReturnType);
            This.Module.ReturnValue(delegateBinding.UsesCAbi ?
                This.ToCAbi(value, delegate.ReturnType) : value.Handle);
        }
        If (savedBlock != null) This.Module.PositionAtEnd(savedBlock);
        Return adapter;
    }

    Public Trusted Function LlvmValue EmitBlockObjectCall(LlvmFunctionContext context,
                                                           HirExpression expression)
    {
        LlvmValue callable = This.EmitExpression(context, expression.Left);
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        LlvmHandles parameters = New LlvmHandles();
        parameters.Add(bytePointer);

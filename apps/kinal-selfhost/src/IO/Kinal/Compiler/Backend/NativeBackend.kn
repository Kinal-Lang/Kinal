    Public Safe Function int ExpressionListCount(HirExpression expression)
    {
        int count = 0;
        HirExpression current = expression;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Trusted Function LlvmValue EmitArrayLiteral(LlvmFunctionContext context,

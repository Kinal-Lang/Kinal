            This.Unique("package_array_target"));
        This.Module.Store(converted.Handle, targetAddress);
        This.Module.Store(This.Module.Add(index, This.Module.ConstInt(This.Module.IntType(64), 1),
            This.Unique("package_array_next")), indexAddress);
        This.Module.Branch(conditionBlock);
        This.Module.PositionAtEnd(doneBlock);

        byte* result = This.Module.ConstUndef(This.TypeHandle(arrayType));
        result = This.Module.InsertValue(result, targetData, 0, "");
        result = This.Module.InsertValue(result, length, 1, "");
        Return New LlvmValue(result, arrayType);
    }

    Public Trusted Function LlvmValue EmitArrayAdd(LlvmFunctionContext context, LlvmValue receiver,
                                                    HirExpression itemExpression)
    {
        TypeSymbol arrayType = receiver.Type;
        TypeSymbol elementType = arrayType.ElementType;
        byte* elementHandle = This.TypeHandle(elementType);
        byte* oldData = This.Module.ExtractValue(receiver.Handle, 0, This.Unique("array_old_data"));
        byte* oldLength = This.Module.ExtractValue(receiver.Handle, 1, This.Unique("array_old_length"));
        byte* newLength = This.Module.Add(oldLength,
            This.Module.ConstInt(This.Module.IntType(64), 1), This.Unique("array_new_length"));
        byte* bytes = This.Module.Multiply(newLength, This.Module.SizeOf(elementHandle),
            This.Unique("array_new_bytes"));
        byte* memory = This.CallRuntime("__kn_gc_alloc", This.Types1(bytes), This.Unique("array_new_memory"));
        byte* newData = This.Module.BitCast(memory, This.Module.PointerType(elementHandle),
            This.Unique("array_new_data"));

        byte* indexAddress = This.Module.Alloca(This.Module.IntType(64), This.Unique("array_copy_index"));
        This.Module.Store(This.Module.ConstInt(This.Module.IntType(64), 0), indexAddress);
        byte* conditionBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("array_copy_condition"));
        byte* bodyBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("array_copy_body"));
        byte* doneBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("array_copy_done"));
        This.Module.Branch(conditionBlock);
        This.Module.PositionAtEnd(conditionBlock);
        byte* index = This.Module.Load(This.Module.IntType(64), indexAddress, This.Unique("array_copy_i"));
        byte* more = This.Module.Compare([int](LlvmIntPredicate.UnsignedLess), index, oldLength,
            This.Unique("array_copy_more"));
        This.Module.ConditionalBranch(more, bodyBlock, doneBlock);
        This.Module.PositionAtEnd(bodyBlock);
        byte* source = This.Module.Gep(elementHandle, oldData, This.Types1(index), true,
            This.Unique("array_copy_source"));
        byte* destination = This.Module.Gep(elementHandle, newData, This.Types1(index), true,
            This.Unique("array_copy_destination"));
        This.Module.Store(This.Module.Load(elementHandle, source, This.Unique("array_copy_value")), destination);
        This.Module.Store(This.Module.Add(index, This.Module.ConstInt(This.Module.IntType(64), 1),
            This.Unique("array_copy_next")), indexAddress);
        This.Module.Branch(conditionBlock);
        This.Module.PositionAtEnd(doneBlock);

        byte* tail = This.Module.Gep(elementHandle, newData, This.Types1(oldLength), true,
            This.Unique("array_tail"));
        This.Module.Store(This.CastValue(This.EmitExpression(context, itemExpression), elementType).Handle, tail);
        byte* value = This.Module.ConstUndef(This.TypeHandle(arrayType));
        value = This.Module.InsertValue(value, newData, 0, "");
        value = This.Module.InsertValue(value, newLength, 1, "");
        Return New LlvmValue(value, arrayType);
    }

    Public Trusted Function LlvmValue EmitDictLiteral(LlvmFunctionContext context,
                                                       HirExpression expression)
    {
        byte* dictionary = This.CallRuntime("__kn_dict_new", This.Types0(),
            This.Unique("dict_literal"));
        HirExpression entry = expression.FirstArgument;
        While (entry != null)
        {
            LlvmValue key = This.CastValue(This.EmitExpression(context, entry.Left),
                This.Semantics.Primitive("string"));
            LlvmValue boxed = This.BoxAny(This.EmitExpression(context, entry.Right));
            byte* tag = This.Module.ExtractValue(boxed.Handle, 0, This.Unique("dict_literal_tag"));
            byte* payload = This.Module.ExtractValue(boxed.Handle, 1,
                This.Unique("dict_literal_payload"));
            This.CallRuntime("__kn_dict_set", This.Types4(dictionary, key.Handle, tag, payload), "");
            entry = entry.Next;
        }
        Return New LlvmValue(dictionary, expression.Type);
    }

    Public Safe Function string RuntimeTypeName(TypeSymbol type)
    {
        If (type == null) Return "unknown";
        If (type.Kind == [int](TypeKind.ListType)) Return "IO.Collection.list";
        If (type.Kind == [int](TypeKind.DictType)) Return "IO.Collection.dict";
        If (type.Kind == [int](TypeKind.SetType)) Return "IO.Collection.set";
        If (type.Kind == [int](TypeKind.PackageType)) Return "Package";
        If (type.Kind == [int](TypeKind.NamedType)) Return type.QualifiedName();
        Return type.Name;
    }

    Public Safe Function bool IsAnyBuiltin(string target)
    {
        string name = IO.Text.StartsWith(target, "IO.Type.any.") ?
            IO.Text.Slice(target, 12, IO.Text.Length(target) - 12) : target;
        Return name == "IsNull" || name == "ToString" || name == "Equals" ||
            name == "Tag" || name == "TypeName" || name == "IsNumber" ||
            name == "IsPointer" || name == "IsInt" || name == "IsFloat" ||
            name == "IsString" || name == "IsBool" || name == "IsChar" ||
            name == "IsObject";
    }

    Public Trusted Function LlvmValue EmitAnyBuiltin(LlvmFunctionContext context,
                                                       HirExpression expression,
                                                       LlvmValue receiver)
    {
        string target = expression.Target;
        string name = IO.Text.StartsWith(target, "IO.Type.any.") ?
            IO.Text.Slice(target, 12, IO.Text.Length(target) - 12) : target;
        HirExpression argument = expression.FirstArgument;
        LlvmValue value = receiver;
        If (value == null && argument != null)
        {
            value = This.EmitExpression(context, argument);
            argument = argument.Next;
        }
        If (value == null) Return null;

        If (name == "ToString")
            Return This.CastValue(value, This.Semantics.Primitive("string"));
        If (name == "TypeName" && value.Type.Kind != [int](TypeKind.AnyType))
            Return New LlvmValue(This.Module.GlobalString(This.RuntimeTypeName(value.Type),
                This.Unique("type_name")), This.Semantics.Primitive("string"));

        LlvmValue boxed = This.BoxAny(value);
        byte* tag = This.Module.ExtractValue(boxed.Handle, 0, This.Unique("any_tag"));
        byte* payload = This.Module.ExtractValue(boxed.Handle, 1, This.Unique("any_payload"));
        byte* int64Type = This.Module.IntType(64);
        If (name == "Tag") Return New LlvmValue(tag, This.Semantics.Primitive("int"));
        If (name == "Equals")
        {
            If (argument == null) Return This.DefaultValue(This.Semantics.Primitive("bool"));
            LlvmValue other = This.BoxAny(This.EmitExpression(context, argument));
            byte* otherTag = This.Module.ExtractValue(other.Handle, 0,
                This.Unique("any_other_tag"));
            byte* otherPayload = This.Module.ExtractValue(other.Handle, 1,
                This.Unique("any_other_payload"));
            byte* sameTag = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                otherTag, This.Unique("any_same_tag"));
            byte* samePayload = This.Module.Compare([int](LlvmIntPredicate.Equal), payload,
                otherPayload, This.Unique("any_same_payload"));
            byte* isString = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 5), This.Unique("any_is_string"));
            byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
            byte* nullPointer = This.Module.ConstNull(bytePointer);
            byte* leftString = This.Module.Select(isString,
                This.Module.IntToPointer(payload, bytePointer, This.Unique("any_left_string")),
                nullPointer, This.Unique("any_safe_left_string"));
            byte* rightString = This.Module.Select(isString,
                This.Module.IntToPointer(otherPayload, bytePointer,
                    This.Unique("any_right_string")),
                nullPointer, This.Unique("any_safe_right_string"));
            byte* stringEqual = This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                This.Types2(leftString, rightString), This.Unique("any_string_equal_c")));
            byte* equalValue = This.Module.Select(isString, stringEqual, samePayload,
                This.Unique("any_equal_value"));
            Return New LlvmValue(This.Module.And(sameTag, equalValue,
                This.Unique("any_equal")), This.Semantics.Primitive("bool"));
        }
        If (name == "TypeName")
        {
            byte* result = This.Module.GlobalString("pointer", This.Unique("type_pointer"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 0), This.Unique("type_is_null")),
                This.Module.GlobalString("null", This.Unique("type_null")), result,
                This.Unique("type_name_null"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 1), This.Unique("type_is_int")),
                This.Module.GlobalString("int", This.Unique("type_int")), result,
                This.Unique("type_name_int"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 2), This.Unique("type_is_float")),
                This.Module.GlobalString("float", This.Unique("type_float")), result,
                This.Unique("type_name_float"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 3), This.Unique("type_is_bool")),
                This.Module.GlobalString("bool", This.Unique("type_bool")), result,
                This.Unique("type_name_bool"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 4), This.Unique("type_is_char")),
                This.Module.GlobalString("char", This.Unique("type_char")), result,
                This.Unique("type_name_char"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 5), This.Unique("type_is_string")),
                This.Module.GlobalString("string", This.Unique("type_string")), result,
                This.Unique("type_name_string"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 7), This.Unique("type_is_dict")),
                This.Module.GlobalString("IO.Collection.dict", This.Unique("type_dict")), result,
                This.Unique("type_name_dict"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 8), This.Unique("type_is_list")),
                This.Module.GlobalString("IO.Collection.list", This.Unique("type_list")), result,
                This.Unique("type_name_list"));
            result = This.Module.Select(This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 9), This.Unique("type_is_set")),
                This.Module.GlobalString("IO.Collection.set", This.Unique("type_set")), result,
                This.Unique("type_name_set"));
            Return New LlvmValue(result, This.Semantics.Primitive("string"));
        }

        byte* matches = null;
        If (name == "IsNull")
        {
            byte* nullTag = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 0), This.Unique("any_null_tag"));
            byte* nullPayload = This.Module.Compare([int](LlvmIntPredicate.Equal), payload,
                This.Module.ConstInt(int64Type, 0), This.Unique("any_null_payload"));
            matches = This.Module.And(nullTag, nullPayload, This.Unique("any_is_null"));
        }
        ElseIf (name == "IsNumber")
        {
            byte* integer = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 1), This.Unique("any_is_integer"));
            byte* floating = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 2), This.Unique("any_is_floating"));
            matches = This.Module.Or(integer, floating, This.Unique("any_is_number"));
        }
        ElseIf (name == "IsObject")
        {
            byte* pointer = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 6), This.Unique("any_is_pointer"));
            byte* dictionary = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 7), This.Unique("any_is_dictionary"));
            byte* values = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 8), This.Unique("any_is_list"));
            byte* setValues = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(int64Type, 9), This.Unique("any_is_set"));
            matches = This.Module.Or(This.Module.Or(pointer, dictionary,
                This.Unique("any_object_pointer")), This.Module.Or(values, setValues,
                This.Unique("any_object_collection")), This.Unique("any_is_object"));
        }
        Else
        {
            int expectedTag = name == "IsPointer" ? 6 : (name == "IsInt" ? 1 :
                (name == "IsFloat" ? 2 : (name == "IsString" ? 5 :
                (name == "IsBool" ? 3 : (name == "IsChar" ? 4 : -1)))));
            If (expectedTag >= 0)
                matches = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
                    This.Module.ConstInt(int64Type, expectedTag), This.Unique("any_kind"));
        }
        If (matches == null) Return null;
        Return New LlvmValue(matches, This.Semantics.Primitive("bool"));
    }

    Public Trusted Function LlvmValue EmitRuntimeBuiltin(LlvmFunctionContext context, HirExpression expression)
    {
        string target = expression.Target;
        If (IO.Text.StartsWith(target, "Block."))
            Return This.EmitBlockObjectCall(context, expression);
        If (expression.Left == null && IO.Text.EndsWith(target, ".Run"))
        {
            string blockName = IO.Text.Slice(target, 0, IO.Text.Length(target) - 4);
            LlvmBlockBinding block = context.FindBlock(blockName);
            If (block != null)
            {
                This.EmitUnsafeBlock(context, block);
                Return This.DefaultValue(This.Semantics.Primitive("void"));
            }
        }
        bool namespaceReceiver = expression.Left != null &&
            expression.Left.Kind == [int](HirExpressionKind.Namespace);
        TypeSymbol receiverType = expression.Left == null ? null : expression.Left.Type;
        LlvmValue receiver = expression.Left == null || namespaceReceiver ?
            null : This.EmitExpression(context, expression.Left);
        HirExpression first = expression.FirstArgument;

        If (This.IsAnyBuiltin(target))
        {
            LlvmValue anyResult = This.EmitAnyBuiltin(context, expression, receiver);
            If (anyResult != null) Return anyResult;
        }

        If (target == "TypeOf" && receiver != null)
            Return New LlvmValue(This.Module.GlobalString(receiver.Type.Name,
                This.Unique("type_name")), This.Semantics.Primitive("string"));
        If (target == "ToString" && receiver != null)
            Return This.CastValue(receiver, This.Semantics.Primitive("string"));

        If (target == "IO.Error.Clear")
        {
            This.CallRuntime("__kn_exc_clear", This.Types0(), "");
            Return This.DefaultValue(This.Semantics.Primitive("void"));
        }
        If (target == "IO.Error.HasException")
            Return New LlvmValue(This.RuntimeBool(This.CallRuntime(
                "__kn_exc_has", This.Types0(), This.Unique("error_has_c"))),
                This.Semantics.Primitive("bool"));
        If (target == "IO.Error.LastTrace")
            Return New LlvmValue(This.CallRuntime("__kn_exc_trace", This.Types0(),
                This.Unique("error_last_trace")), This.Semantics.Primitive("string"));
        If (target == "IO.Error.Current")
        {
            byte* raw = This.CallRuntime("__kn_exc_last", This.Types0(),
                This.Unique("error_current"));
            Return New LlvmValue(This.Module.BitCast(raw,
                This.TypeHandle(This.ErrorType()), This.Unique("typed_error_current")),
                This.ErrorType());
        }

        If (target == "IO.Console.ReadLine")
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_read_line", This.Types0(),
                This.Unique("read_line")), This.Semantics.Primitive("string"));
        If (IO.Text.StartsWith(target, "IO.Console."))
        {
            bool newline = target == "IO.Console.WriteLine" ||
                IO.Text.StartsWith(target, "IO.Console.PrintLine");
            HirExpression argument = first;
            If (argument == null && newline)
                This.CallRuntime("kn_sh_rt_print_line",
                    This.Types1(This.Module.GlobalString("", This.Unique("empty_line"))), "");
            int index = 0;
            While (argument != null)
            {
                If (index > 0)
                    This.CallRuntime("kn_sh_rt_print",
                        This.Types1(This.Module.GlobalString(" ", This.Unique("console_space"))), "");
                LlvmValue value = This.AnyToString(
                    This.BoxAny(This.EmitExpression(context, argument)),
                    This.Semantics.Primitive("string"));
                bool last = argument.Next == null;
                This.CallRuntime(newline && last ? "kn_sh_rt_print_line" : "kn_sh_rt_print",
                    This.Types1(value.Handle), "");
                index = index + 1;
                argument = argument.Next;
            }
            Return This.DefaultValue(This.Semantics.Primitive("void"));
        }
        If (target == "IO.Type.string.Length")
        {
            LlvmValue value = This.CastValue(This.EmitExpression(context, first),
                This.Semantics.Primitive("string"));
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_string_length",
                This.Types1(value.Handle), This.Unique("string_length")),
                This.Semantics.Primitive("int"));
        }
        If (target == "IO.Type.string.Concat")
        {
            LlvmValue left = This.CastValue(This.EmitExpression(context, first),
                This.Semantics.Primitive("string"));
            LlvmValue right = This.CastValue(This.EmitExpression(context, first.Next),
                This.Semantics.Primitive("string"));
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_string_concat",
                This.Types2(left.Handle, right.Handle), This.Unique("string_concat")),
                This.Semantics.Primitive("string"));
        }
        If (target == "IO.Type.string.Equals")
        {
            LlvmValue left = This.CastValue(This.EmitExpression(context, first),
                This.Semantics.Primitive("string"));
            LlvmValue right = This.CastValue(This.EmitExpression(context, first.Next),
                This.Semantics.Primitive("string"));
            Return New LlvmValue(This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                This.Types2(left.Handle, right.Handle), This.Unique("string_equal_c"))),
                This.Semantics.Primitive("bool"));
        }
        If (target == "IO.Type.string.ToChars")
        {
            LlvmValue value = This.CastValue(This.EmitExpression(context, first),
                This.Semantics.Primitive("string"));
            byte* lengthSlot = This.Module.Alloca(This.Module.IntType(64),
                This.Unique("chars_length_slot"));
            This.Module.Store(This.Module.ConstInt(This.Module.IntType(64), 0), lengthSlot);
            byte* data = This.CallRuntime("__kn_string_to_chars",
                This.Types2(value.Handle, lengthSlot), This.Unique("chars_data"));
            byte* array = This.Module.ConstUndef(This.TypeHandle(expression.Type));
            array = This.Module.InsertValue(array, data, 0, "");
            array = This.Module.InsertValue(array,
                This.Module.Load(This.Module.IntType(64), lengthSlot,
                    This.Unique("chars_length")), 1, "");
            Return New LlvmValue(array, expression.Type);
        }
        If (IO.Text.StartsWith(target, "IO.Type."))
        {
            string convertedName = IO.Text.Slice(target, 8,
                IO.Text.Length(target) - 8);
            If (!IO.Text.Contains(convertedName, ".") && first != null)
                Return This.CastValue(This.EmitExpression(context, first), expression.Type);
        }
        If (target == "list.Create")
            Return New LlvmValue(This.CallRuntime("__kn_list_new", This.Types0(), This.Unique("list")),
                This.Semantics.Primitive("list"));
        If (target == "dict.Create")
            Return New LlvmValue(This.CallRuntime("__kn_dict_new", This.Types0(), This.Unique("dict")),
                This.Semantics.Primitive("dict"));
        If (target == "set.Create")
            Return New LlvmValue(This.CallRuntime("__kn_set_new", This.Types0(), This.Unique("set")),
                This.Semantics.Primitive("set"));
        If (target == "IO.Meta.Query") Return This.EmitMetaQuery(context, expression);
        If (target == "IO.Meta.Of") Return This.EmitMetaOf(context, expression);
        If (target == "IO.Meta.Find") Return This.EmitMetaFind(context, expression);
        If (target == "IO.Meta.Has") Return This.EmitMetaHas(context, expression);
        If (target == "IO.GC.Collect")
        {
            This.CallRuntime("__kn_gc_collect", This.Types0(), "");
            Return This.DefaultValue(This.Semantics.Primitive("void"));
        }
        If (target == "IO.Async.Spawn")
        {
            LlvmValue command = This.CastValue(This.EmitExpression(context, first),
                This.Semantics.Primitive("string"));
            Return New LlvmValue(This.CallRuntime("__kn_async_process_spawn",
                This.Types1(command.Handle), This.Unique("async_process")),
                expression.Type);
        }
        If (target == "IO.Async.IsCompleted")
        {
            LlvmValue handle = This.EmitExpression(context, first);
            Return New LlvmValue(This.RuntimeBool(This.CallRuntime(
                "__kn_async_process_is_completed", This.Types1(handle.Handle),
                This.Unique("async_completed_c"))), This.Semantics.Primitive("bool"));
        }
        If (target == "IO.Async.Wait")
        {
            LlvmValue handle = This.EmitExpression(context, first);
            LlvmValue timeout = This.CastValue(This.EmitExpression(context, first.Next),
                This.Semantics.Primitive("int"));
            Return New LlvmValue(This.RuntimeBool(This.CallRuntime(
                "__kn_async_process_wait", This.Types2(handle.Handle, timeout.Handle),
                This.Unique("async_wait_c"))), This.Semantics.Primitive("bool"));
        }
        If (target == "IO.Async.ExitCode")
        {
            LlvmValue handle = This.EmitExpression(context, first);
            byte* exitCode = This.CallRuntime("__kn_async_process_exit_code",
                This.Types1(handle.Handle), This.Unique("async_exit_code_c"));
            Return New LlvmValue(This.Module.SignExtend(exitCode,
                This.Module.IntType(64), This.Unique("async_exit_code")),
                This.Semantics.Primitive("int"));
        }
        If (target == "IO.Async.Close")
        {
            LlvmValue handle = This.EmitExpression(context, first);
            Return New LlvmValue(This.RuntimeBool(This.CallRuntime(
                "__kn_async_process_close", This.Types1(handle.Handle),
                This.Unique("async_close_c"))), This.Semantics.Primitive("bool"));
        }
        If (target == "IO.Async.Run")
        {
            LlvmValue task = This.EmitExpression(context, first);
            Return This.AwaitTaskResult(context, task.Handle, expression.Type,
                "async_run");

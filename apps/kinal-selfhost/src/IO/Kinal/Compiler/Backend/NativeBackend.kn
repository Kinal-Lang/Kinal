        If (IO.Text.StartsWith(target, "IO.Volatile.Write"))
        {
            int bits = target == "IO.Volatile.Write8" ? 8 :
                (target == "IO.Volatile.Write16" ? 16 : (target == "IO.Volatile.Write32" ? 32 : 64));
            LlvmValue address = This.EmitExpression(context, first);
            LlvmValue value = This.CastValue(This.EmitExpression(context, first.Next),
                This.Semantics.Primitive("int"));
            byte* raw = bits < 64 ? This.Module.Truncate(value.Handle, This.Module.IntType(bits),
                This.Unique("volatile_write_narrow")) : value.Handle;

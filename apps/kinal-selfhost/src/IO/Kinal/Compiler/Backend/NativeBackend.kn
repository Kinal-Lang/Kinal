            This.EmitUnsafeBlock(context, context.FindBlock(blockName));
            Return This.DefaultValue(This.Semantics.Primitive("void"));
        }
        LlvmValue receiver = expression.Left == null ? null : This.EmitExpression(context, expression.Left);
        HirExpression first = expression.FirstArgument;

        If (target == "TypeOf" && receiver != null)
            Return New LlvmValue(This.Module.GlobalString(receiver.Type.Name,
                This.Unique("type_name")), This.Semantics.Primitive("string"));

        If (target == "IO.Console.ReadLine")
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_read_line", This.Types0(),
                This.Unique("read_line")), This.Semantics.Primitive("string"));
        If (IO.Text.StartsWith(target, "IO.Console."))
        {
            LlvmValue value = This.CastValue(This.EmitExpression(context, first), This.Semantics.Primitive("string"));
            bool newline = target == "IO.Console.WriteLine" ||
                IO.Text.StartsWith(target, "IO.Console.PrintLine");
            This.CallRuntime(newline ? "kn_sh_rt_print_line" : "kn_sh_rt_print",
                This.Types1(value.Handle), "");
            Return This.DefaultValue(This.Semantics.Primitive("void"));

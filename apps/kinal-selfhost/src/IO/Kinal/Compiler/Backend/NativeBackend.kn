                [int](LlvmIntPredicate.UnsignedGreater), length,
                This.Module.ConstInt(This.Module.IntType(64), 0),
                This.Unique("path_has_extension")), This.Semantics.Primitive("bool"));
        }
        If (target == "IO.Path.IsRelative")
        {
            LlvmValue path = This.CastValue(This.EmitExpression(context, first),
                This.Semantics.Primitive("string"));
            byte* absolute = This.RuntimeBool(This.CallRuntime("__kn_path_is_absolute",
                This.Types1(path.Handle), This.Unique("path_absolute_c")));
            Return New LlvmValue(This.Module.Not(absolute, This.Unique("path_relative")),
                This.Semantics.Primitive("bool"));
        }
        If (target == "IO.File.Exists" || target == "IO.System.FileExists")
            runtimeName = "__kn_sys_file_exists";
        ElseIf (target == "IO.File.Create") runtimeName = "__kn_file_create";
        ElseIf (target == "IO.File.Touch") runtimeName = "__kn_file_touch";
        ElseIf (target == "IO.File.ReadAllText") runtimeName = "__kn_file_read_all_text";
        ElseIf (target == "IO.File.ReadFirstLine") runtimeName = "__kn_file_read_first_line";
        ElseIf (target == "IO.File.WriteAllText") runtimeName = "__kn_file_write_all_text";
        ElseIf (target == "IO.File.AppendAllText") runtimeName = "__kn_file_append_all_text";
        ElseIf (target == "IO.File.AppendLine") runtimeName = "__kn_file_append_line";
        ElseIf (target == "IO.File.Delete") runtimeName = "__kn_file_delete";
        ElseIf (target == "IO.File.DeleteIfExists") runtimeName = "__kn_file_delete_if_exists";
        ElseIf (target == "IO.File.Size") runtimeName = "__kn_file_size";
        ElseIf (target == "IO.File.IsEmpty") runtimeName = "__kn_file_is_empty";
        ElseIf (target == "IO.File.Copy") runtimeName = "__kn_file_copy";
        ElseIf (target == "IO.File.Move") runtimeName = "__kn_file_move";
        ElseIf (target == "IO.File.ReplaceText") runtimeName = "__kn_file_replace_text";
        ElseIf (target == "IO.File.ReadLines") runtimeName = "__kn_file_read_lines";
        ElseIf (target == "IO.File.WriteLines") runtimeName = "__kn_file_write_lines";
        ElseIf (target == "IO.Directory.Exists") runtimeName = "__kn_dir_exists";
        ElseIf (target == "IO.Directory.Create") runtimeName = "__kn_dir_create";
        ElseIf (target == "IO.Directory.Ensure") runtimeName = "__kn_dir_ensure";
        ElseIf (target == "IO.Directory.Delete") runtimeName = "__kn_dir_delete";
        ElseIf (target == "IO.Directory.DeleteIfExists") runtimeName = "__kn_dir_delete_if_exists";
        ElseIf (target == "IO.Directory.Files") runtimeName = "__kn_dir_files";
        ElseIf (target == "IO.Path.Combine" || target == "IO.Path.Join")
            runtimeName = "__kn_path_combine";
        ElseIf (target == "IO.Path.Join3") runtimeName = "__kn_path_join3";
        ElseIf (target == "IO.Path.Join4") runtimeName = "__kn_path_join4";
        ElseIf (target == "IO.Path.FileName") runtimeName = "__kn_path_file_name";
        ElseIf (target == "IO.Path.Extension") runtimeName = "__kn_path_extension";
        ElseIf (target == "IO.Path.Directory" || target == "IO.Path.Parent")
            runtimeName = "__kn_path_directory";
        ElseIf (target == "IO.Path.Normalize") runtimeName = "__kn_path_normalize";
        ElseIf (target == "IO.Path.CurrentDirectory" || target == "IO.Path.Cwd")
            runtimeName = "__kn_path_cwd";
        ElseIf (target == "IO.Path.ChangeExtension") runtimeName = "__kn_path_change_extension";
        ElseIf (target == "IO.Path.IsAbsolute") runtimeName = "__kn_path_is_absolute";
        ElseIf (target == "IO.Path.BaseName" || target == "IO.Path.Stem")
            runtimeName = "__kn_path_base_name";
        ElseIf (target == "IO.Path.EnsureTrailingSeparator") runtimeName = "__kn_path_ensure_trailing_separator";
        ElseIf (target == "IO.Text.Contains") runtimeName = "__kn_text_contains";
        ElseIf (target == "IO.Text.StartsWith") runtimeName = "__kn_text_starts_with";
        ElseIf (target == "IO.Text.EndsWith") runtimeName = "__kn_text_ends_with";
        ElseIf (target == "IO.Text.IndexOf") runtimeName = "__kn_text_index_of";
        ElseIf (target == "IO.Text.LastIndexOf") runtimeName = "__kn_text_last_index_of";
        ElseIf (target == "IO.Text.Trim") runtimeName = "__kn_text_trim";
        ElseIf (target == "IO.Text.Replace") runtimeName = "__kn_text_replace";
        ElseIf (target == "IO.Text.ToUpper") runtimeName = "__kn_text_to_upper";
        ElseIf (target == "IO.Text.ToLower") runtimeName = "__kn_text_to_lower";
        ElseIf (target == "IO.Text.Slice") runtimeName = "__kn_text_slice";
        ElseIf (target == "IO.Text.Count") runtimeName = "__kn_text_count";
        ElseIf (target == "IO.Text.Split") runtimeName = "__kn_text_split";
        ElseIf (target == "IO.Text.Lines") runtimeName = "__kn_text_lines";
        ElseIf (target == "IO.Text.Join") runtimeName = "__kn_text_join";
        ElseIf (target == "IO.Text.Length") runtimeName = "kn_sh_rt_string_length";
        ElseIf (target == "IO.Text.IsEmpty")
        {
            LlvmValue text = This.CastValue(This.EmitExpression(context, first), This.Semantics.Primitive("string"));
            byte* length = This.CallRuntime("kn_sh_rt_string_length", This.Types1(text.Handle), This.Unique("text_length"));
            Return New LlvmValue(This.Module.Compare([int](LlvmIntPredicate.Equal), length,
                This.Module.ConstInt(This.Module.IntType(64), 0), This.Unique("text_empty")),
                This.Semantics.Primitive("bool"));
        }

        If (!IO.Text.IsEmpty(runtimeName))
        {
            LlvmHandles arguments = New LlvmHandles();
            HirExpression argument = first;
            int parameterIndex = 0;
            While (argument != null)
            {
                LlvmValue value = This.EmitExpression(context, argument);
                If (target == "IO.Directory.Files" && parameterIndex == 1)
                    arguments.Add(This.Module.ZeroExtend(value.Handle, This.Module.IntType(32), This.Unique("recursive")));
                Else arguments.Add(value.Handle);
                parameterIndex = parameterIndex + 1;
                argument = argument.Next;
            }
            byte* raw = This.CallRuntime(runtimeName, arguments,
                expression.Type.Kind == [int](TypeKind.VoidType) ? "" : This.Unique("runtime"));
            Return New LlvmValue(boolResult ? This.RuntimeBool(raw) : raw, expression.Type);
        }

        This.Fail("unsupported runtime builtin: " + target);
        Return This.DefaultValue(expression.Type);
    }

    Public Trusted Function LlvmValue EmitNewObject(LlvmFunctionContext context, HirExpression expression)
    {
        TypeSymbol type = expression.Type;
        If (type.Name == "IO.Error")
        {
            HirExpression first = expression.FirstArgument;
            byte* title = first == null ?
                This.Module.GlobalString("Error", This.Unique("error_title")) :
                This.CastValue(This.EmitExpression(context, first),
                    This.Semantics.Primitive("string")).Handle;
            byte* message = first == null || first.Next == null ?
                This.Module.GlobalString("", This.Unique("error_message")) :
                This.CastValue(This.EmitExpression(context, first.Next),
                    This.Semantics.Primitive("string")).Handle;
            Return This.CreateError(title, message);
        }
        LlvmTypeBinding typeBinding = This.FindTypeBinding(type);
        If (typeBinding == null)
        {
            This.Fail("missing class layout: " + type.QualifiedName());
            Return This.DefaultValue(type);
        }
        byte* size = This.Module.SizeOf(typeBinding.StructHandle);
        byte* memory = This.CallRuntime("__kn_gc_alloc", This.Types1(size), This.Unique("object_memory"));
        byte* object = This.Module.BitCast(memory, typeBinding.Handle, This.Unique("object"));
        This.InitializeObjectVtable(typeBinding, object, type);
        This.InitializeObjectTypeId(typeBinding, object);

        This.InitializeObjectFields(typeBinding, object, type, 2);

        int count = This.HirArgumentCount(expression);
        LlvmFunctionBinding constructor = This.FirstFunction;
        While (constructor != null)
        {
            If (constructor.Symbol.OwnerType == type && constructor.Symbol.Declaration.IsConstructor &&
                constructor.Symbol.ParameterCount() == count) Break;
            constructor = constructor.Next;
        }
        If (constructor != null)
            This.EmitFunctionCall(context, constructor, expression, New LlvmValue(object, type));
        ElseIf (count != 0)
            This.Fail("constructor is not declared: " + type.QualifiedName());
        Return New LlvmValue(object, type);
    }

    Public Trusted Function LlvmValue EmitShortCircuit(LlvmFunctionContext context,
                                                        HirExpression expression, bool isAnd)
    {
        LlvmValue left = This.CastValue(This.EmitExpression(context, expression.Left),
            This.Semantics.Primitive("bool"));
        byte* leftBlock = This.Module.CurrentBlock();
        byte* function = context.Binding.Function;
        byte* rightBlock = This.Module.AppendBlock(function, This.Unique("logic_right"));
        byte* mergeBlock = This.Module.AppendBlock(function, This.Unique("logic_merge"));
        If (isAnd) This.Module.ConditionalBranch(left.Handle, rightBlock, mergeBlock);
        Else This.Module.ConditionalBranch(left.Handle, mergeBlock, rightBlock);

        This.Module.PositionAtEnd(rightBlock);
        LlvmValue right = This.CastValue(This.EmitExpression(context, expression.Right),
            This.Semantics.Primitive("bool"));
        byte* rightEnd = This.Module.CurrentBlock();
        If (!This.Module.IsTerminated(rightEnd)) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(mergeBlock);
        byte* phi = This.Module.Phi(This.Module.IntType(1), This.Unique("logic"));
        This.Module.AddIncoming(phi, This.Module.ConstInt(This.Module.IntType(1), isAnd ? 0 : 1), leftBlock);
        This.Module.AddIncoming(phi, right.Handle, rightEnd);
        Return New LlvmValue(phi, This.Semantics.Primitive("bool"));
    }

    Public Trusted Function LlvmValue EmitConditional(LlvmFunctionContext context, HirExpression expression)
    {
        LlvmValue condition = This.CastValue(This.EmitExpression(context, expression.Left),
            This.Semantics.Primitive("bool"));
        byte* function = context.Binding.Function;
        byte* trueBlock = This.Module.AppendBlock(function, This.Unique("conditional_true"));
        byte* falseBlock = This.Module.AppendBlock(function, This.Unique("conditional_false"));
        byte* mergeBlock = This.Module.AppendBlock(function, This.Unique("conditional_merge"));
        This.Module.ConditionalBranch(condition.Handle, trueBlock, falseBlock);

        This.Module.PositionAtEnd(trueBlock);
        LlvmValue whenTrue = This.CastValue(This.EmitExpression(context, expression.Right), expression.Type);
        byte* trueEnd = This.Module.CurrentBlock();
        If (!This.Module.IsTerminated(trueEnd)) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(falseBlock);
        LlvmValue whenFalse = This.CastValue(This.EmitExpression(context, expression.Third), expression.Type);
        byte* falseEnd = This.Module.CurrentBlock();
        If (!This.Module.IsTerminated(falseEnd)) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(mergeBlock);
        byte* phi = This.Module.Phi(This.TypeHandle(expression.Type), This.Unique("conditional"));
        This.Module.AddIncoming(phi, whenTrue.Handle, trueEnd);
        This.Module.AddIncoming(phi, whenFalse.Handle, falseEnd);
        Return New LlvmValue(phi, expression.Type);
    }

    Public Trusted Function byte* EmitSwitchMatch(LlvmValue left, LlvmValue right)
    {
        If (left.Type.Kind == [int](TypeKind.StringType))
        {
            right = This.CastValue(right, left.Type);
            Return This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                This.Types2(left.Handle, right.Handle), This.Unique("switch_string_c")));
        }
        If (left.Type.Kind == [int](TypeKind.FloatType) || right.Type.Kind == [int](TypeKind.FloatType))
        {
            TypeSymbol floatType = left.Type.Kind == [int](TypeKind.FloatType) ? left.Type : right.Type;
            left = This.CastValue(left, floatType);
            right = This.CastValue(right, floatType);
            Return This.Module.FloatCompare([int](LlvmFloatPredicate.OrderedEqual), left.Handle,
                right.Handle, This.Unique("switch_float"));
        }
        If (This.IsReferenceType(left.Type) || left.Type.Kind == [int](TypeKind.NullType) ||
            This.IsReferenceType(right.Type) || right.Type.Kind == [int](TypeKind.NullType))
        {
            TypeSymbol comparisonType = left.Type.Kind == [int](TypeKind.NullType) ? right.Type : left.Type;
            left = This.CastValue(left, comparisonType);
            right = This.CastValue(right, comparisonType);
        }
        Else right = This.CastValue(right, left.Type);
        Return This.Module.Compare([int](LlvmIntPredicate.Equal), left.Handle, right.Handle,
            This.Unique("switch_match"));
    }

    Public Trusted Function LlvmValue EmitSwitchExpression(LlvmFunctionContext context,
                                                            HirExpression expression)
    {
        LlvmValue selector = This.EmitExpression(context, expression.Left);
        byte* resultAddress = This.Module.Alloca(This.TypeHandle(expression.Type),
            This.Unique("switch_result"));
        This.Module.Store(This.DefaultValue(expression.Type).Handle, resultAddress);
        byte* mergeBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("switch_merge"));
        HirExpression item = expression.FirstArgument;
        While (item != null)
        {
            If (item.Name == "default")
            {
                LlvmValue value = This.CastValue(This.EmitExpression(context, item.Right), expression.Type);
                This.Module.Store(value.Handle, resultAddress);
                This.Module.Branch(mergeBlock);
                item = item.Next;
                Break;
            }
            byte* valueBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("switch_value"));
            byte* nextBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("switch_next"));
            LlvmValue caseValue = This.EmitExpression(context, item.Left);
            This.Module.ConditionalBranch(This.EmitSwitchMatch(selector, caseValue), valueBlock, nextBlock);
            This.Module.PositionAtEnd(valueBlock);
            LlvmValue value = This.CastValue(This.EmitExpression(context, item.Right), expression.Type);
            This.Module.Store(value.Handle, resultAddress);
            This.Module.Branch(mergeBlock);
            This.Module.PositionAtEnd(nextBlock);
            item = item.Next;
        }
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(mergeBlock);
        This.Module.PositionAtEnd(mergeBlock);
        Return New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), resultAddress,
            This.Unique("switch_result_value")), expression.Type);
    }

    Public Safe Function int AnyTypeTag(TypeSymbol type)
    {
        If (type == null) Return -1;
        If (type.Kind == [int](TypeKind.BoolType)) Return 3;
        If (type.Name == "char") Return 4;
        If (This.IsIntegerLike(type)) Return 1;
        If (type.Kind == [int](TypeKind.FloatType)) Return 2;
        If (type.Kind == [int](TypeKind.StringType)) Return 5;
        If (type.Kind == [int](TypeKind.ListType)) Return 8;
        If (type.Kind == [int](TypeKind.DictType)) Return 7;
        If (type.Kind == [int](TypeKind.SetType)) Return 9;
        Return -1;
    }

    Public Safe Function bool IsRuntimeObjectType(TypeSymbol type)
    {
        Return type != null &&
            type.Kind == [int](TypeKind.NamedType) &&
            !This.IsEnum(type) &&
            !This.Semantics.IsStructType(type) &&
            (type.Declaration != null ||
             type.Name == "IO.Error" ||
             type.Name == "IO.Type.Object.Class" ||
             type.Name == "Object.Class" ||
             type.Name == "IO.Type.Object.Function" ||
             type.Name == "Object.Function" ||
             type.Name == "IO.Type.Object.Block" ||
             type.Name == "Object.Block");
    }

    Public Trusted Function void EmitInvalidCast(
        LlvmFunctionContext context, TypeSymbol source, TypeSymbol target)
    {
        string sourceName = source == null ? "unknown" : source.Name;
        string targetName = target == null ? "unknown" : target.Name;
        LlvmValue error = This.CreateError(
            This.Module.GlobalString("Invalid Cast",
                This.Unique("invalid_cast_title")),
            This.Module.GlobalString("Cannot cast " + sourceName + " to " +
                targetName, This.Unique("invalid_cast_message")));
        This.SetAndRouteException(context, This.ErrorPointer(error));
    }

    Public Trusted Function LlvmValue EmitCheckedAnyReferenceCast(
        LlvmFunctionContext context, LlvmValue value, TypeSymbol target)
    {
        byte* tag = This.Module.ExtractValue(value.Handle, 0,
            This.Unique("cast_any_tag"));
        byte* payload = This.Module.ExtractValue(value.Handle, 1,
            This.Unique("cast_any_payload"));
        byte* function = context.Binding.Function;
        byte* entryBlock = This.Module.CurrentBlock();
        byte* tagBlock = This.Module.AppendBlock(function,
            This.Unique("cast_any_tag_check"));
        byte* pointerBlock = This.Module.AppendBlock(function,
            This.Unique("cast_any_pointer"));
        byte* nonnullBlock = This.Module.AppendBlock(function,
            This.Unique("cast_any_nonnull"));
        byte* successBlock = This.Module.AppendBlock(function,
            This.Unique("cast_any_success"));
        byte* failBlock = This.Module.AppendBlock(function,
            This.Unique("cast_any_fail"));
        byte* doneBlock = This.Module.AppendBlock(function,
            This.Unique("cast_any_done"));
        byte* isNone = This.Module.Compare([int](LlvmIntPredicate.Equal), tag,
            This.Module.ConstInt(This.Module.IntType(64), 0),
            This.Unique("cast_any_none"));
        This.Module.ConditionalBranch(isNone, doneBlock, tagBlock);

        This.Module.PositionAtEnd(tagBlock);
        int collectionTag = This.AnyTypeTag(target);
        byte* expectedTag = This.Module.ConstInt(This.Module.IntType(64),
            collectionTag >= 0 ? collectionTag : 6);
        byte* hasExpectedTag = This.Module.Compare(
            [int](LlvmIntPredicate.Equal), tag, expectedTag,
            This.Unique("cast_any_expected_tag"));
        This.Module.ConditionalBranch(hasExpectedTag, pointerBlock, failBlock);

        This.Module.PositionAtEnd(pointerBlock);
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* raw = This.Module.IntToPointer(payload, bytePointer,
            This.Unique("cast_any_pointer_value"));
        byte* isNull = This.Module.Compare([int](LlvmIntPredicate.Equal), raw,
            This.Module.ConstNull(bytePointer), This.Unique("cast_any_null"));
        This.Module.ConditionalBranch(isNull, doneBlock, nonnullBlock);

        This.Module.PositionAtEnd(nonnullBlock);
        If (This.IsRuntimeObjectType(target))
        {
            byte* matched = This.EmitRuntimeTypeIdMatch(raw, target);
            This.Module.ConditionalBranch(matched, successBlock, failBlock);
        }
        Else This.Module.Branch(successBlock);

        This.Module.PositionAtEnd(successBlock);
        byte* casted = This.Module.BitCast(raw, This.TypeHandle(target),
            This.Unique("cast_any_reference"));
        This.Module.Branch(doneBlock);
        byte* successEnd = This.Module.CurrentBlock();

        This.Module.PositionAtEnd(failBlock);
        This.EmitInvalidCast(context, value.Type, target);

        This.Module.PositionAtEnd(doneBlock);
        byte* result = This.Module.Phi(This.TypeHandle(target),
            This.Unique("cast_any_result"));
        This.Module.AddIncoming(result,
            This.Module.ConstNull(This.TypeHandle(target)), entryBlock);
        This.Module.AddIncoming(result,
            This.Module.ConstNull(This.TypeHandle(target)), pointerBlock);
        This.Module.AddIncoming(result, casted, successEnd);
        Return New LlvmValue(result, target);
    }

    Public Trusted Function LlvmValue EmitCheckedObjectCast(
        LlvmFunctionContext context, LlvmValue value, TypeSymbol target)
    {
        If (value.Type.Kind == [int](TypeKind.NullType))
            Return This.DefaultValue(target);
        If (value.Type.Kind == [int](TypeKind.AnyType))
            Return This.EmitCheckedAnyReferenceCast(context, value, target);
        If (This.RuntimeTypeAssignable(value.Type, target))
            Return New LlvmValue(This.Module.BitCast(value.Handle,
                This.TypeHandle(target), This.Unique("cast_object_static")),
                target);

        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* raw = This.Module.BitCast(value.Handle, bytePointer,
            This.Unique("cast_object_pointer"));
        byte* function = context.Binding.Function;
        byte* entryBlock = This.Module.CurrentBlock();
        byte* nonnullBlock = This.Module.AppendBlock(function,
            This.Unique("cast_object_nonnull"));
        byte* successBlock = This.Module.AppendBlock(function,
            This.Unique("cast_object_success"));
        byte* failBlock = This.Module.AppendBlock(function,
            This.Unique("cast_object_fail"));
        byte* doneBlock = This.Module.AppendBlock(function,
            This.Unique("cast_object_done"));
        byte* isNull = This.Module.Compare([int](LlvmIntPredicate.Equal), raw,
            This.Module.ConstNull(bytePointer), This.Unique("cast_object_null"));
        This.Module.ConditionalBranch(isNull, doneBlock, nonnullBlock);

        This.Module.PositionAtEnd(nonnullBlock);
        byte* matched = This.EmitRuntimeTypeIdMatch(raw, target);
        This.Module.ConditionalBranch(matched, successBlock, failBlock);

        This.Module.PositionAtEnd(successBlock);
        byte* casted = This.Module.BitCast(raw, This.TypeHandle(target),
            This.Unique("cast_object_reference"));
        This.Module.Branch(doneBlock);
        byte* successEnd = This.Module.CurrentBlock();

        This.Module.PositionAtEnd(failBlock);
        This.EmitInvalidCast(context, value.Type, target);

        This.Module.PositionAtEnd(doneBlock);
        byte* result = This.Module.Phi(This.TypeHandle(target),
            This.Unique("cast_object_result"));
        This.Module.AddIncoming(result,
            This.Module.ConstNull(This.TypeHandle(target)), entryBlock);
        This.Module.AddIncoming(result, casted, successEnd);
        Return New LlvmValue(result, target);
    }

    Public Trusted Function byte* ReferenceIsNonNull(LlvmValue value)
    {
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* pointer = This.Module.BitCast(value.Handle, bytePointer,
            This.Unique("is_reference_pointer"));
        Return This.Module.Compare([int](LlvmIntPredicate.NotEqual), pointer,
            This.Module.ConstNull(bytePointer), This.Unique("is_reference_nonnull"));
    }

    Public Trusted Function LlvmValue EmitIsValue(LlvmFunctionContext context,
                                                   HirExpression expression,
                                                   LlvmValue value)
    {
        TypeSymbol boolType = This.Semantics.Primitive("bool");
        TypeSymbol source = value.Type;
        TypeSymbol target = expression.Right == null ? null : expression.Right.Type;
        byte* yes = This.Module.ConstInt(This.Module.IntType(1), 1);
        byte* no = This.Module.ConstInt(This.Module.IntType(1), 0);

        // `Is any` describes every value except void.  The left expression is
        // still emitted above so observable side effects are preserved.
        If (target != null && target.Kind == [int](TypeKind.AnyType))
            Return New LlvmValue(
                source.Kind == [int](TypeKind.VoidType) ? no : yes, boolType);

        If (source.Kind == [int](TypeKind.AnyType))
        {
            byte* tag = This.Module.ExtractValue(value.Handle, 0,
                This.Unique("is_any_tag"));
            byte* payload = This.Module.ExtractValue(value.Handle, 1,
                This.Unique("is_any_payload"));
            If (This.IsRuntimeObjectType(target))
            {
                byte* hasObjectTag = This.Module.Compare(
                    [int](LlvmIntPredicate.Equal), tag,
                    This.Module.ConstInt(This.Module.IntType(64), 6),
                    This.Unique("is_any_object_tag"));
                byte* hasPayload = This.Module.Compare(
                    [int](LlvmIntPredicate.NotEqual), payload,
                    This.Module.ConstInt(This.Module.IntType(64), 0),
                    This.Unique("is_any_object_nonnull"));
                byte* isObject = This.Module.And(hasObjectTag, hasPayload,
                    This.Unique("is_any_object"));
                byte* object = This.Module.IntToPointer(payload,
                    This.Module.PointerType(This.Module.IntType(8)),
                    This.Unique("is_any_object_pointer"));
                Return New LlvmValue(This.EmitGuardedRuntimeTypeMatch(
                    context, object, isObject, target), boolType);
            }
            int targetTag = This.AnyTypeTag(target);
            If (targetTag < 0) Return New LlvmValue(no, boolType);
            Return New LlvmValue(This.Module.Compare(
                [int](LlvmIntPredicate.Equal), tag,
                This.Module.ConstInt(This.Module.IntType(64), targetTag),
                This.Unique("is_any_type")), boolType);
        }

        If (source.Kind == [int](TypeKind.NullType) || target == null)
            Return New LlvmValue(no, boolType);

        If (This.IsRuntimeObjectType(source) &&
            This.IsRuntimeObjectType(target))
        {
            byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
            byte* object = This.Module.BitCast(value.Handle, bytePointer,
                This.Unique("is_object_pointer"));
            byte* nonnull = This.Module.Compare([int](LlvmIntPredicate.NotEqual),
                object, This.Module.ConstNull(bytePointer),
                This.Unique("is_object_nonnull"));
            Return New LlvmValue(This.EmitGuardedRuntimeTypeMatch(
                context, object, nonnull, target), boolType);
        }

        bool sameReference = This.SameType(source, target) &&
            (source.Kind == [int](TypeKind.StringType) ||
             source.Kind == [int](TypeKind.ListType) ||
             source.Kind == [int](TypeKind.DictType) ||
             source.Kind == [int](TypeKind.SetType) ||
             source.Kind == [int](TypeKind.PointerType));
        If (sameReference)
            Return New LlvmValue(This.ReferenceIsNonNull(value), boolType);
        Return New LlvmValue(This.SameType(source, target) ? yes : no, boolType);
    }

    Public Trusted Function LlvmValue EmitIs(LlvmFunctionContext context,
                                              HirExpression expression)
    {
        Return This.EmitIsValue(context, expression,
            This.EmitExpression(context, expression.Left));
    }

    Public Trusted Function LlvmValue EmitBinary(LlvmFunctionContext context, HirExpression expression)
    {
        TokenKind operatorKind = expression.Operator;
        If (operatorKind == TokenKind.KwIs) Return This.EmitIs(context, expression);
        If (operatorKind == TokenKind.AndAnd) Return This.EmitShortCircuit(context, expression, true);
        If (operatorKind == TokenKind.OrOr) Return This.EmitShortCircuit(context, expression, false);

        bool assignment = operatorKind == TokenKind.Assign ||
            operatorKind == TokenKind.PlusAssign || operatorKind == TokenKind.MinusAssign ||
            operatorKind == TokenKind.StarAssign || operatorKind == TokenKind.SlashAssign ||
            operatorKind == TokenKind.PercentAssign;
        If (assignment)
        {
            If (expression.Left.Kind == [int](HirExpressionKind.Field) &&
                expression.Left.Function != null)
            {
                LlvmFunctionBinding getter = This.FindFunctionBinding(expression.Left.Function);
                LlvmFunctionBinding setter = This.FindFunctionByTarget(expression.Left.Name, 1);
                If (getter == null || setter == null)
                {
                    This.Fail("property accessor binding is missing: " + expression.Left.Target);
                    Return This.DefaultValue(expression.Left.Type);
                }
                LlvmValue receiver = expression.Left.Left == null ? null :
                    This.EmitExpression(context, expression.Left.Left);
                LlvmValue right = This.CastValue(
                    This.EmitExpression(context, expression.Right), expression.Left.Type);
                If (operatorKind != TokenKind.Assign)
                {
                    LlvmValue left = This.EmitFunctionCall(context, getter,
                        expression.Left, receiver);
                    If (operatorKind == TokenKind.PlusAssign &&
                        left.Type.Kind == [int](TypeKind.StringType))
                        right = New LlvmValue(This.CallRuntime("kn_sh_rt_string_concat",
                            This.Types2(left.Handle,
                                This.CastValue(right, left.Type).Handle),
                            This.Unique("property_concat")), left.Type);
                    ElseIf (left.Type.Kind == [int](TypeKind.FloatType) &&
                        operatorKind == TokenKind.PlusAssign)
                        right = New LlvmValue(This.Module.FloatAdd(left.Handle, right.Handle,
                            This.Unique("property_float_add")), left.Type);
                    ElseIf (left.Type.Kind == [int](TypeKind.FloatType) &&
                        operatorKind == TokenKind.MinusAssign)
                        right = New LlvmValue(This.Module.FloatSubtract(left.Handle, right.Handle,
                            This.Unique("property_float_sub")), left.Type);
                    ElseIf (left.Type.Kind == [int](TypeKind.FloatType) &&
                        operatorKind == TokenKind.StarAssign)
                        right = New LlvmValue(This.Module.FloatMultiply(left.Handle, right.Handle,
                            This.Unique("property_float_mul")), left.Type);
                    ElseIf (left.Type.Kind == [int](TypeKind.FloatType) &&
                        operatorKind == TokenKind.SlashAssign)
                        right = New LlvmValue(This.Module.FloatDivide(left.Handle, right.Handle,
                            This.Unique("property_float_div")), left.Type);
                    ElseIf (operatorKind == TokenKind.PlusAssign)
                        right = New LlvmValue(This.Module.Add(left.Handle, right.Handle,
                            This.Unique("property_add")), left.Type);
                    ElseIf (operatorKind == TokenKind.MinusAssign)
                        right = New LlvmValue(This.Module.Subtract(left.Handle, right.Handle,
                            This.Unique("property_sub")), left.Type);
                    ElseIf (operatorKind == TokenKind.StarAssign)
                        right = New LlvmValue(This.Module.Multiply(left.Handle, right.Handle,
                            This.Unique("property_mul")), left.Type);
                    ElseIf (operatorKind == TokenKind.SlashAssign)
                        right = New LlvmValue(This.IsUnsignedInteger(left.Type) ?
                            This.Module.UnsignedDivide(left.Handle, right.Handle,
                                This.Unique("property_udiv")) :
                            This.Module.SignedDivide(left.Handle, right.Handle,
                                This.Unique("property_div")), left.Type);
                    Else
                        right = New LlvmValue(This.IsUnsignedInteger(left.Type) ?
                            This.Module.UnsignedRemainder(left.Handle, right.Handle,
                                This.Unique("property_urem")) :
                            This.Module.SignedRemainder(left.Handle, right.Handle,
                                This.Unique("property_rem")), left.Type);
                }
                LlvmHandles arguments = New LlvmHandles();
                bool hasReceiver = setter.Symbol.OwnerType != null &&
                    !setter.Symbol.Declaration.IsStatic;
                If (hasReceiver)
                {
                    If (receiver == null)
                    {
                        This.Fail("property setter has no receiver: " + expression.Left.Target);
                        Return right;
                    }
                    arguments.Add(This.CastValue(receiver,
                        setter.Symbol.OwnerType).Handle);
                }
                arguments.Add(right.Handle);
                This.Module.Call(setter.FunctionType, setter.Function, arguments, "");
                This.MaybePropagateException(context);
                Return right;
            }
            bool packageElement = expression.Left.Kind == [int](HirExpressionKind.Index) &&
                expression.Left.Left != null &&
                expression.Left.Left.Type.Kind == [int](TypeKind.PackageType);
            byte* address = This.EmitAddress(context, expression.Left);
            LlvmValue right = null;
            If (expression.Left.Kind == [int](HirExpressionKind.Delegate) &&
                expression.Right.Kind == [int](HirExpressionKind.FunctionReference))
            {
                LlvmDelegateBinding delegate = This.FindDelegateBinding(expression.Left.Function);
                LlvmFunctionBinding target = This.FindFunctionBinding(expression.Right.Function);
                If (delegate == null || target == null)
                {
                    This.Fail("delegate assignment binding is missing: " + expression.Left.Target);
                    right = This.DefaultValue(expression.Left.Type);
                }
                Else
                {
                    byte* callable = delegate.UsesCAbi ?
                        This.EnsureDelegateAdapter(delegate.Symbol, target.Symbol) : target.Function;
                    right = New LlvmValue(callable, expression.Left.Type);
                }
            }
            Else right = This.CastValue(This.EmitExpression(context, expression.Right), expression.Left.Type);
            If (operatorKind != TokenKind.Assign)
            {
                LlvmValue left = null;
                If (packageElement)
                {
                    LlvmValue boxedLeft = New LlvmValue(This.Module.Load(This.AnyType, address,
                        This.Unique("assignment_any")), This.Semantics.Primitive("any"));
                    left = expression.Left.Type.Kind == [int](TypeKind.AnyType) ? boxedLeft :
                        This.CastValue(boxedLeft, expression.Left.Type);
                }
                Else left = New LlvmValue(This.Module.Load(This.TypeHandle(expression.Left.Type), address,
                    This.Unique("assignment_left")), expression.Left.Type);
                If (operatorKind == TokenKind.PlusAssign && left.Type.Kind == [int](TypeKind.StringType))
                    right = New LlvmValue(This.CallRuntime("kn_sh_rt_string_concat",
                        This.Types2(left.Handle, This.CastValue(right, left.Type).Handle), This.Unique("concat")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == TokenKind.PlusAssign)
                    right = New LlvmValue(This.Module.FloatAdd(left.Handle, right.Handle, This.Unique("float_add")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == TokenKind.MinusAssign)
                    right = New LlvmValue(This.Module.FloatSubtract(left.Handle, right.Handle, This.Unique("float_sub")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == TokenKind.StarAssign)
                    right = New LlvmValue(This.Module.FloatMultiply(left.Handle, right.Handle, This.Unique("float_mul")), left.Type);
                ElseIf (left.Type.Kind == [int](TypeKind.FloatType) && operatorKind == TokenKind.SlashAssign)
                    right = New LlvmValue(This.Module.FloatDivide(left.Handle, right.Handle, This.Unique("float_div")), left.Type);
                ElseIf (operatorKind == TokenKind.PlusAssign)
                    right = New LlvmValue(This.Module.Add(left.Handle, right.Handle, This.Unique("add")), left.Type);
                ElseIf (operatorKind == TokenKind.MinusAssign)
                    right = New LlvmValue(This.Module.Subtract(left.Handle, right.Handle, This.Unique("sub")), left.Type);
                ElseIf (operatorKind == TokenKind.StarAssign)
                    right = New LlvmValue(This.Module.Multiply(left.Handle, right.Handle, This.Unique("mul")), left.Type);
                ElseIf (operatorKind == TokenKind.SlashAssign)
                {
                    byte* quotient = This.IsUnsignedInteger(left.Type) ?
                        This.Module.UnsignedDivide(left.Handle, right.Handle, This.Unique("udiv")) :
                        This.Module.SignedDivide(left.Handle, right.Handle, This.Unique("div"));
                    right = New LlvmValue(quotient, left.Type);
                }
                Else
                {
                    byte* remainder = This.IsUnsignedInteger(left.Type) ?
                        This.Module.UnsignedRemainder(left.Handle, right.Handle, This.Unique("urem")) :
                        This.Module.SignedRemainder(left.Handle, right.Handle, This.Unique("rem"));
                    right = New LlvmValue(remainder, left.Type);
                }
            }
            If (address == null)
                This.Fail("assignment target has no address: " + expression.Left.Target +
                    " kind=" + [string](expression.Left.Kind) + " in " +
                    context.Binding.Symbol.QualifiedName());
            ElseIf (packageElement) This.Module.Store(This.BoxAny(right).Handle, address);
            Else This.Module.Store(right.Handle, address);
            Return right;
        }

        LlvmValue left = This.EmitExpression(context, expression.Left);
        LlvmValue right = This.EmitExpression(context, expression.Right);
        If (operatorKind == TokenKind.Plus &&
            (left.Type.Kind == [int](TypeKind.StringType) || right.Type.Kind == [int](TypeKind.StringType)))
        {
            left = This.CastValue(left, This.Semantics.Primitive("string"));
            right = This.CastValue(right, This.Semantics.Primitive("string"));
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_string_concat",
                This.Types2(left.Handle, right.Handle), This.Unique("concat")), This.Semantics.Primitive("string"));
        }

        bool equality = operatorKind == TokenKind.Equal || operatorKind == TokenKind.NotEqual;
        If (equality && left.Type.Kind == [int](TypeKind.StringType))
        {
            right = This.CastValue(right, left.Type);
            byte* equal = This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                This.Types2(left.Handle, right.Handle), This.Unique("string_equal_c")));
            If (operatorKind == TokenKind.NotEqual) equal = This.Module.Not(equal, This.Unique("string_not_equal"));
            Return New LlvmValue(equal, This.Semantics.Primitive("bool"));
        }
        If (equality && (This.IsReferenceType(left.Type) || left.Type.Kind == [int](TypeKind.NullType) ||
                         This.IsReferenceType(right.Type) || right.Type.Kind == [int](TypeKind.NullType)))
        {
            TypeSymbol comparisonType = left.Type.Kind == [int](TypeKind.NullType) ? right.Type : left.Type;
            left = This.CastValue(left, comparisonType);
            right = This.CastValue(right, comparisonType);
            int predicate = operatorKind == TokenKind.Equal ?
                [int](LlvmIntPredicate.Equal) : [int](LlvmIntPredicate.NotEqual);
            Return New LlvmValue(This.Module.Compare(predicate, left.Handle, right.Handle, This.Unique("ref_compare")),
                This.Semantics.Primitive("bool"));
        }

        If (left.Type.Kind == [int](TypeKind.PointerType) &&
            (operatorKind == TokenKind.Plus || operatorKind == TokenKind.Minus))
        {
            right = This.CastValue(right, This.Semantics.Primitive("isize"));
            byte* offset = operatorKind == TokenKind.Minus ?
                This.Module.Negate(right.Handle, This.Unique("pointer_negative_offset")) : right.Handle;
            Return New LlvmValue(This.Module.Gep(This.TypeHandle(left.Type.ElementType), left.Handle,
                This.Types1(offset), true, This.Unique("pointer_offset")), left.Type);
        }

        TypeSymbol operandType = left.Type;
        right = This.CastValue(right, operandType);
        If (operandType.Kind == [int](TypeKind.FloatType))
        {
            If (operatorKind == TokenKind.Plus)
                Return New LlvmValue(This.Module.FloatAdd(left.Handle, right.Handle, This.Unique("float_add")), expression.Type);
            If (operatorKind == TokenKind.Minus)
                Return New LlvmValue(This.Module.FloatSubtract(left.Handle, right.Handle, This.Unique("float_sub")), expression.Type);
            If (operatorKind == TokenKind.Star)
                Return New LlvmValue(This.Module.FloatMultiply(left.Handle, right.Handle, This.Unique("float_mul")), expression.Type);
            If (operatorKind == TokenKind.Slash)
                Return New LlvmValue(This.Module.FloatDivide(left.Handle, right.Handle, This.Unique("float_div")), expression.Type);
            int floatPredicate = [int](LlvmFloatPredicate.OrderedEqual);
            If (operatorKind == TokenKind.NotEqual)
                floatPredicate = [int](LlvmFloatPredicate.OrderedNotEqual);
            ElseIf (operatorKind == TokenKind.Less)
                floatPredicate = [int](LlvmFloatPredicate.OrderedLess);
            ElseIf (operatorKind == TokenKind.LessEqual)
                floatPredicate = [int](LlvmFloatPredicate.OrderedLessEqual);
            ElseIf (operatorKind == TokenKind.Greater)
                floatPredicate = [int](LlvmFloatPredicate.OrderedGreater);
            ElseIf (operatorKind == TokenKind.GreaterEqual)
                floatPredicate = [int](LlvmFloatPredicate.OrderedGreaterEqual);
            Return New LlvmValue(This.Module.FloatCompare(floatPredicate, left.Handle, right.Handle,
                This.Unique("float_compare")), This.Semantics.Primitive("bool"));
        }
        If (operatorKind == TokenKind.Plus)
            Return New LlvmValue(This.Module.Add(left.Handle, right.Handle, This.Unique("add")), expression.Type);
        If (operatorKind == TokenKind.Minus)
            Return New LlvmValue(This.Module.Subtract(left.Handle, right.Handle, This.Unique("sub")), expression.Type);
        If (operatorKind == TokenKind.Star)
            Return New LlvmValue(This.Module.Multiply(left.Handle, right.Handle, This.Unique("mul")), expression.Type);
        If (operatorKind == TokenKind.Slash)
        {
            byte* quotient = This.IsUnsignedInteger(operandType) ?
                This.Module.UnsignedDivide(left.Handle, right.Handle, This.Unique("udiv")) :
                This.Module.SignedDivide(left.Handle, right.Handle, This.Unique("div"));
            Return New LlvmValue(quotient, expression.Type);
        }
        If (operatorKind == TokenKind.Percent)
        {
            byte* remainder = This.IsUnsignedInteger(operandType) ?
                This.Module.UnsignedRemainder(left.Handle, right.Handle, This.Unique("urem")) :
                This.Module.SignedRemainder(left.Handle, right.Handle, This.Unique("rem"));
            Return New LlvmValue(remainder, expression.Type);
        }
        If (operatorKind == TokenKind.Ampersand)
            Return New LlvmValue(This.Module.And(left.Handle, right.Handle, This.Unique("and")), expression.Type);
        If (operatorKind == TokenKind.BitOr)
            Return New LlvmValue(This.Module.Or(left.Handle, right.Handle, This.Unique("or")), expression.Type);
        If (operatorKind == TokenKind.Xor)
            Return New LlvmValue(This.Module.Xor(left.Handle, right.Handle, This.Unique("xor")), expression.Type);
        If (operatorKind == TokenKind.ShiftLeft)
            Return New LlvmValue(This.Module.ShiftLeft(left.Handle, right.Handle, This.Unique("shl")), expression.Type);
        If (operatorKind == TokenKind.ShiftRight)
        {
            byte* shifted = This.IsUnsignedInteger(operandType) ?
                This.Module.LogicalShiftRight(left.Handle, right.Handle, This.Unique("lshr")) :
                This.Module.ShiftRight(left.Handle, right.Handle, This.Unique("shr"));
            Return New LlvmValue(shifted, expression.Type);
        }

        int predicate = [int](LlvmIntPredicate.Equal);
        If (operatorKind == TokenKind.NotEqual) predicate = [int](LlvmIntPredicate.NotEqual);
        ElseIf (operatorKind == TokenKind.Less) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedLess) : [int](LlvmIntPredicate.SignedLess);
        ElseIf (operatorKind == TokenKind.LessEqual) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedLessEqual) : [int](LlvmIntPredicate.SignedLessEqual);
        ElseIf (operatorKind == TokenKind.Greater) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedGreater) : [int](LlvmIntPredicate.SignedGreater);
        ElseIf (operatorKind == TokenKind.GreaterEqual) predicate = This.IsUnsignedInteger(operandType) ?
            [int](LlvmIntPredicate.UnsignedGreaterEqual) : [int](LlvmIntPredicate.SignedGreaterEqual);
        Return New LlvmValue(This.Module.Compare(predicate, left.Handle, right.Handle, This.Unique("compare")),
            This.Semantics.Primitive("bool"));
    }

    Public Trusted Function LlvmValue EmitUnary(LlvmFunctionContext context, HirExpression expression)
    {
        TokenKind operatorKind = expression.Operator;
        If (operatorKind == TokenKind.Ampersand)
        {
            If (expression.Left != null &&
                expression.Left.Kind == [int](HirExpressionKind.FunctionReference))
            {
                LlvmFunctionBinding function = This.FindFunctionBinding(expression.Left.Function);
                If (function == null)
                {
                    This.Fail("address-of function binding is missing");
                    Return This.DefaultValue(expression.Type);
                }
                Return New LlvmValue(function.Function, expression.Type);
            }
            byte* address = This.EmitAddress(context, expression.Left);
            If (address == null) This.Fail("address-of operand has no address");
            Return New LlvmValue(address, expression.Type);
        }
        LlvmValue operand = This.EmitExpression(context, expression.Left);
        If (operatorKind == TokenKind.KwAwait)
            Return This.AwaitTaskResult(context, operand.Handle, expression.Type,
                "await");
        If (operatorKind == TokenKind.Star)
            Return New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), operand.Handle,
                This.Unique("dereference")), expression.Type);
        If (operatorKind == TokenKind.Not)
            Return New LlvmValue(This.Module.Not(operand.Handle, This.Unique("not")), expression.Type);
        If (operatorKind == TokenKind.Minus)
            Return New LlvmValue(operand.Type.Kind == [int](TypeKind.FloatType) ?
                This.Module.FloatNegate(operand.Handle, This.Unique("float_negate")) :
                This.Module.Negate(operand.Handle, This.Unique("negate")), expression.Type);
        If (operatorKind == TokenKind.Tilde)
            Return New LlvmValue(This.Module.Not(operand.Handle, This.Unique("bit_not")), expression.Type);
        If (operatorKind == TokenKind.PlusPlus || operatorKind == TokenKind.MinusMinus)
        {
            byte* address = This.EmitAddress(context, expression.Left);
            byte* one = This.Module.ConstInt(This.TypeHandle(operand.Type), 1);
            byte* next = operatorKind == TokenKind.PlusPlus ?
                This.Module.Add(operand.Handle, one, This.Unique("increment")) :
                This.Module.Subtract(operand.Handle, one, This.Unique("decrement"));
            If (address != null) This.Module.Store(next, address);
            If (expression.Syntax != null && expression.Syntax.IsPostfix) Return operand;
            Return New LlvmValue(next, expression.Type);
        }
        Return operand;
    }

    Public Safe Function int CollectBlockRecords(LlvmBlockBinding binding,
                                                  HirStatement statement, int nextOrdinal)
    {
        HirStatement current = statement;
        int ordinal = nextOrdinal;
        While (current != null)
        {
            If (current.Kind == [int](StatementKind.Record))
            {
                binding.AddRecord(New LlvmRecordBinding(current.Name, ordinal));
                ordinal = ordinal + 1;
            }
            Else
            {
                If (current.Initializer != null)
                    ordinal = This.CollectBlockRecords(binding, current.Initializer, ordinal);
                If (current.FirstChild != null)
                    ordinal = This.CollectBlockRecords(binding, current.FirstChild, ordinal);
                If (current.ElseBranch != null)
                    ordinal = This.CollectBlockRecords(binding, current.ElseBranch, ordinal);
            }
            current = current.Next;
        }
        Return ordinal;
    }

    Public Safe Function LlvmBlockBinding RegisterUnsafeBlock(LlvmFunctionContext context,
                                                               HirStatement statement)
    {
        LlvmBlockBinding existing = context.FindBlock(statement.Name);
        If (existing != null) Return existing;
        LlvmBlockBinding binding = New LlvmBlockBinding(statement.Name, statement);
        This.CollectBlockRecords(binding, statement.FirstChild, 1);
        context.AddBlock(binding);
        Return binding;
    }

    Public Safe Function int BlockRecordOrdinal(LlvmFunctionContext context, string target)
    {
        LlvmBlockBinding binding = context.FirstBlock;
        While (binding != null)
        {
            string prefix = binding.Name + ".";
            If (IO.Text.StartsWith(target, prefix))
            {
                string name = IO.Text.Slice(target, IO.Text.Length(prefix),
                    IO.Text.Length(target) - IO.Text.Length(prefix));
                LlvmRecordBinding record = binding.FindRecord(name);
                If (record != null) Return record.Ordinal;
            }
            binding = binding.Next;
        }
        Return -1;
    }

    Public Trusted Function void EmitUnsafeJump(LlvmFunctionContext context,
                                                 LlvmBlockBinding binding,
                                                 HirStatement statement)
    {
        If (binding == null)
        {
            This.Fail("Jump used outside Block");
            Return;
        }
        byte* function = context.Binding.Function;
        If (!IO.Text.IsEmpty(statement.Name))
        {
            LlvmRecordBinding target = binding.FindRecord(statement.Name);
            If (target == null) This.Fail("unknown Block record: " + statement.Name);
            Else This.Module.Branch(target.Block);
        }
        Else
        {
            LlvmValue targetValue = This.CastValue(
                This.EmitExpression(context, statement.Expression), This.Semantics.Primitive("int"));
            LlvmRecordBinding record = binding.FirstRecord;
            While (record != null)
            {
                byte* nextCheck = This.Module.AppendBlock(function, This.Unique("block_jump_check"));
                byte* equal = This.Module.Compare([int](LlvmIntPredicate.Equal), targetValue.Handle,
                    This.Module.ConstInt(This.Module.IntType(64), record.Ordinal),
                    This.Unique("block_jump_equal"));
                This.Module.ConditionalBranch(equal, record.Block, nextCheck);
                This.Module.PositionAtEnd(nextCheck);
                record = record.Next;
            }
            This.Module.Branch(binding.DoneBlock);
        }
        byte* continuation = This.Module.AppendBlock(function, This.Unique("block_jump_continuation"));
        This.Module.PositionAtEnd(continuation);
    }

    Public Trusted Function void EmitUnsafeStatementList(LlvmFunctionContext context,
                                                          LlvmBlockBinding binding,
                                                          HirStatement statement)
    {
        HirStatement current = statement;
        While (current != null)
        {
            If (current.Kind == [int](StatementKind.Record))
            {
                LlvmRecordBinding record = binding.FindRecord(current.Name);
                If (record != null)
                {
                    If (!This.Module.IsTerminated(This.Module.CurrentBlock()))
                        This.Module.Branch(record.Block);
                    This.Module.PositionAtEnd(record.Block);
                    If (context.RuntimeUntilEnabled != null)
                    {
                        byte* runBlock = This.Module.AppendBlock(context.Binding.Function,
                            This.Unique("block_record_run"));
                        byte* atLimit = This.Module.Compare([int](LlvmIntPredicate.Equal),
                            context.RuntimeUntilOrdinal,
                            This.Module.ConstInt(This.Module.IntType(64), record.Ordinal),
                            This.Unique("block_at_limit"));
                        byte* stop = This.Module.And(context.RuntimeUntilEnabled, atLimit,
                            This.Unique("block_stop"));
                        This.Module.ConditionalBranch(stop, binding.DoneBlock, runBlock);
                        This.Module.PositionAtEnd(runBlock);
                    }
                    This.EmitStatementList(context, current.FirstChild);
                }
            }
            Else If (!This.Module.IsTerminated(This.Module.CurrentBlock()))
            {
                This.EmitStatement(context, current);
            }
            current = current.Next;
        }
    }

    Public Trusted Function void EmitUnsafeBlock(LlvmFunctionContext context,
                                                  LlvmBlockBinding binding)
    {
        If (binding == null || binding.Emitted) Return;
        binding.Emitted = true;
        byte* function = context.Binding.Function;
        binding.StartBlock = This.Module.AppendBlock(function, This.Unique("block_start"));
        binding.DoneBlock = This.Module.AppendBlock(function, This.Unique("block_done"));
        LlvmRecordBinding record = binding.FirstRecord;
        While (record != null)
        {
            record.Block = This.Module.AppendBlock(function,
                This.Unique("block_record_" + This.Sanitize(record.Name)));
            record = record.Next;
        }
        This.Module.Branch(binding.StartBlock);
        This.Module.PositionAtEnd(binding.StartBlock);
        LlvmBlockBinding previous = context.ActiveBlock;
        context.ActiveBlock = binding;
        This.EmitUnsafeStatementList(context, binding, binding.Statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(binding.DoneBlock);
        context.ActiveBlock = previous;
        This.Module.PositionAtEnd(binding.DoneBlock);
    }

    Public Trusted Function LlvmValue EmitExpression(LlvmFunctionContext context, HirExpression expression)
    {
        If (expression == null) Return This.DefaultValue(This.Semantics.Primitive("void"));
        If (expression.Kind == [int](HirExpressionKind.Constant))
        {
            int syntaxKind = expression.Syntax.Kind;
            If (expression.Target == "__target_string")
                Return New LlvmValue(This.Module.GlobalString(expression.Name,
                    This.Unique("target_text")), expression.Type);
            int recordOrdinal = This.BlockRecordOrdinal(context, expression.Target);
            If (recordOrdinal >= 0)
                Return New LlvmValue(This.Module.ConstInt(This.Module.IntType(64), recordOrdinal),
                    This.Semantics.Primitive("isize"));
            If (This.IsEnum(expression.Type))
                Return New LlvmValue(This.Module.ConstInt(This.TypeHandle(expression.Type),
                    This.EnumValue(expression.Type, expression.Target)), expression.Type);
            If (syntaxKind == [int](ExpressionKind.Number))
            {
                If (expression.Type.Kind == [int](TypeKind.FloatType))
                    Return New LlvmValue(This.Module.ConstFloat(This.TypeHandle(expression.Type),
                        [float](expression.Name)), expression.Type);
                Return New LlvmValue(This.Module.ConstI64(This.TypeHandle(expression.Type),
                    This.IntegerLiteralValue(expression.Name), false), expression.Type);
            }
            If (syntaxKind == [int](ExpressionKind.String) ||
                syntaxKind == [int](ExpressionKind.FormattedString))
                Return New LlvmValue(This.Module.GlobalString(
                    expression.Syntax.IsRawString ? This.Unquote(expression.Name) :
                    syntaxKind == [int](ExpressionKind.FormattedString) ?
                        This.ExpandFormattedString(expression.Name) : This.DecodeString(expression.Name),
                    This.Unique("text")), expression.Type);
            If (syntaxKind == [int](ExpressionKind.Character))
                Return New LlvmValue(This.Module.ConstInt(This.TypeHandle(expression.Type),
                    This.DecodeCharacter(expression.Name)), expression.Type);
            If (syntaxKind == [int](ExpressionKind.Boolean))
                Return New LlvmValue(This.Module.ConstInt(This.Module.IntType(1),
                    expression.Name == "true" || expression.Name == "True" ? 1 : 0),
                    expression.Type);
            Return This.DefaultValue(expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Local) ||
            expression.Kind == [int](HirExpressionKind.Global) ||
            expression.Kind == [int](HirExpressionKind.Delegate))
        {
            byte* address = This.EmitAddress(context, expression);
            If (address == null)
            {
                This.Fail("unknown local: " + expression.Target + " in " +
                    context.Binding.Symbol.QualifiedName() + "; available=" + context.VariableNames());
                Return This.DefaultValue(expression.Type);
            }
            LlvmValue result = New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), address,
                This.Unique("load")), expression.Type);
            result.Address = address;
            Return result;
        }
        If (expression.Kind == [int](HirExpressionKind.FunctionReference))
        {
            LlvmFunctionBinding function = This.FindFunctionBinding(expression.Function);
            If (function == null)
            {
                If (This.Semantics.RuntimeCallType(expression.Target, null) != null)
                {
                    byte* wrapper = This.EnsureBuiltinCallableWrapper(expression.Target);
                    If (wrapper != null)
                        Return New LlvmValue(This.CreateCallableObject(false, wrapper, null),
                            expression.Type);
                }
                If (!This.Failed())
                    This.Fail("function reference binding is missing: " + expression.Target);
                Return This.DefaultValue(expression.Type);
            }
            Return New LlvmValue(This.EmitCallableObject(context, function), expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Index) && expression.Left != null &&
            expression.Left.Type.Kind == [int](TypeKind.PackageType))
            Return This.EmitPackageIndex(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Field) &&
            expression.Left != null &&
            expression.Left.Type.Name == "IO.Time.DateTime" &&
            expression.Target == "Ticks")
        {
            LlvmValue dateTime = This.EmitExpression(context, expression.Left);
            byte* raw = This.Module.BitCast(dateTime.Handle,
                This.Module.PointerType(This.Module.IntType(8)), This.Unique("datetime_raw"));
            Return New LlvmValue(This.CallRuntime("kn_sh_rt_datetime_ticks",
                This.Types1(raw), This.Unique("datetime_ticks")),
                This.Semantics.Primitive("int"));
        }
        If (expression.Kind == [int](HirExpressionKind.Field) &&
            expression.Left != null && expression.Left.Type.Name == "IO.Error")
            Return This.EmitErrorField(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Field) &&
            expression.Function != null)
        {
            LlvmFunctionBinding getter = This.FindFunctionBinding(expression.Function);
            If (getter == null)
            {
                This.Fail("property getter binding is missing: " + expression.Target);
                Return This.DefaultValue(expression.Type);
            }
            LlvmValue receiver = expression.Left == null ? null :
                This.EmitExpression(context, expression.Left);
            If (This.IsVirtualMethod(getter.Symbol) && receiver != null)
                Return This.EmitVirtualFunctionCall(context, getter, expression, receiver);
            Return This.EmitFunctionCall(context, getter, expression, receiver);
        }
        If (expression.Kind == [int](HirExpressionKind.Field) ||
            expression.Kind == [int](HirExpressionKind.Index))
        {
            byte* address = This.EmitAddress(context, expression);
            LlvmValue result = New LlvmValue(This.Module.Load(This.TypeHandle(expression.Type), address,
                This.Unique("load")), expression.Type);
            result.Address = address;
            Return result;
        }
        If (expression.Kind == [int](HirExpressionKind.Unary)) Return This.EmitUnary(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Binary)) Return This.EmitBinary(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Conditional)) Return This.EmitConditional(context, expression);
        If (expression.Kind == [int](HirExpressionKind.ArrayLiteral))
            Return This.EmitArrayLiteral(context, expression);
        If (expression.Kind == [int](HirExpressionKind.PackageLiteral))
            Return This.EmitArrayValue(context, expression.Type, expression.FirstArgument,
                This.Module.ConstInt(This.Module.IntType(64), This.HirArgumentCount(expression)));
        If (expression.Kind == [int](HirExpressionKind.DictLiteral))
            Return This.EmitDictLiteral(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Switch))
            Return This.EmitSwitchExpression(context, expression);
        If (expression.Kind == [int](HirExpressionKind.NewObject)) Return This.EmitNewObject(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Cast))
        {
            If (expression.Left != null &&
                expression.Left.Kind == [int](HirExpressionKind.PackageLiteral) &&
                expression.Type.Kind == [int](TypeKind.ArrayType))
                Return This.EmitArrayValue(context, expression.Type, expression.Left.FirstArgument,
                    This.Module.ConstInt(This.Module.IntType(64),
                        This.HirArgumentCount(expression.Left)));
            If (expression.Left != null &&
                expression.Left.Type.Kind == [int](TypeKind.PackageType) &&
                expression.Type.Kind == [int](TypeKind.ArrayType))
                Return This.EmitPackageArrayCast(context,
                    This.EmitExpression(context, expression.Left), expression.Type);
            If (expression.Function != null)
            {
                LlvmFunctionBinding customCast = This.FindFunctionBinding(expression.Function);
                If (customCast == null)
                {
                    This.Fail("custom cast binding is missing: " + expression.Function.QualifiedName());
                    Return This.DefaultValue(expression.Type);
                }
                HirExpression call = New HirExpression([int](HirExpressionKind.Call),
                    expression.Syntax, expression.Type);
                call.Function = expression.Function;
                call.AddArgument(expression.Left);
                Return This.EmitFunctionCall(context, customCast, call, null);
            }
            LlvmValue castSource = This.EmitExpression(context, expression.Left);
            bool checkedTarget = This.IsRuntimeObjectType(expression.Type) ||
                expression.Type.Kind == [int](TypeKind.ListType) ||
                expression.Type.Kind == [int](TypeKind.DictType) ||
                expression.Type.Kind == [int](TypeKind.SetType);
            bool checkedSource = castSource.Type.Kind == [int](TypeKind.AnyType) ||
                castSource.Type.Kind == [int](TypeKind.NullType) ||
                This.IsRuntimeObjectType(castSource.Type);
            If (checkedTarget && checkedSource)
                Return This.EmitCheckedObjectCast(context, castSource, expression.Type);
            Return This.CastValue(castSource, expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Call))
        {
            If (expression.CallKind == [int](HirCallKind.RuntimeBuiltin))
                Return This.EmitRuntimeBuiltin(context, expression);
            If (expression.CallKind == [int](HirCallKind.DynamicFunction))
                Return This.EmitDynamicFunctionCall(context, expression);
            If (expression.CallKind == [int](HirCallKind.Delegate))
                Return This.EmitDelegateCall(context, expression);
            LlvmFunctionBinding binding = expression.Function == null ?
                This.FindFunctionByTarget(expression.Target, This.HirArgumentCount(expression)) :
                This.FindFunctionBinding(expression.Function);
            If (binding == null)
            {
                This.Fail("function binding is missing: " + expression.Target);
                Return This.DefaultValue(expression.Type);
            }
            LlvmValue receiver = expression.Left == null ? null : This.EmitExpression(context, expression.Left);
            If (expression.CallKind == [int](HirCallKind.InstanceMethod) &&
                This.IsVirtualMethod(binding.Symbol) &&
                (expression.Left == null || expression.Left.Name != "Base"))
                Return This.EmitVirtualFunctionCall(context, binding, expression, receiver);
            Return This.EmitFunctionCall(context, binding, expression, receiver);
        }
        If (expression.Kind == [int](HirExpressionKind.Invalid))
            This.Fail("invalid HIR expression reached backend");
        Return This.DefaultValue(expression.Type);
    }

    Public Safe Function HirFunction FindHirFunction(FunctionSymbol symbol)
    {
        HirModule module = This.Semantics.FirstHirModule;
        While (module != null)
        {
            HirFunction function = module.FirstFunction;
            While (function != null)
            {
                If (function.Symbol == symbol) Return function;
                function = function.Next;
            }
            module = module.Next;
        }
        Return null;
    }

    Public Trusted Function void AddGcRoot(LlvmFunctionContext context, TypeSymbol type, byte* address)
    {
        If (!This.NeedsGcRoot(type) || context.GcFrame == null || address == null) Return;
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* rootAddress = This.Module.BitCast(address, bytePointer, This.Unique("gc_root"));
        This.CallRuntime("__kn_gc_add_root",
            This.Types3(context.GcFrame, rootAddress, This.Module.SizeOf(This.TypeHandle(type))), "");
    }

    Public Trusted Function byte* AllocateVariableAddress(LlvmFunctionContext context,
                                                            ValueSymbol symbol,
                                                            TypeSymbol type,
                                                            string name)
    {
        If (symbol == null || !symbol.IsCaptured)
        {
            byte* address = This.Module.Alloca(This.TypeHandle(type), name);
            If (This.Semantics.IsStructType(type) &&
                type.Declaration.Align > 0 &&
                !This.Module.SetAlignment(address, type.Declaration.Align))
                This.Fail("failed to set Struct alignment: " + type.QualifiedName());
            Return address;
        }

        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* storage = This.CallRuntime("__kn_gc_alloc",
            This.Types1(This.Module.SizeOf(This.TypeHandle(type))), This.Unique("captured_storage"));
        byte* address = This.Module.BitCast(storage,
            This.Module.PointerType(This.TypeHandle(type)), This.Unique("captured_address"));

        // Keep the cell itself alive until the callable environment owns it.
        byte* rootSlot = This.Module.Alloca(bytePointer, This.Unique("captured_root"));
        This.Module.Store(storage, rootSlot);
        This.AddGcRoot(context, This.Semantics.MakePointerType(type), rootSlot);
        Return address;
    }

    Public Trusted Function void PopGcFrame(LlvmFunctionContext context)
    {
        If (context.GcFrame != null)
            This.CallRuntime("__kn_gc_pop_frame", This.Types1(context.GcFrame), "");
    }

    Public Safe Function TypeSymbol ErrorType()
    {
        Return This.Semantics.FindExactType("IO.Error");
    }

    Public Safe Function int ErrorRuntimeTypeId()
    {
        LlvmTypeBinding binding = This.FindTypeBinding(This.ErrorType());
        Return binding == null ? 0 : binding.RuntimeTypeId;
    }

    Public Trusted Function byte* ErrorPointer(LlvmValue value)
    {
        Return This.Module.BitCast(value.Handle,
            This.Module.PointerType(This.Module.IntType(8)),
            This.Unique("error_pointer"));
    }

    Public Trusted Function LlvmValue CreateError(byte* title, byte* message)
    {
        byte* raw = This.CallRuntime("kn_sh_rt_error_new", This.Types3(
            This.Module.ConstInt(This.Module.IntType(64), This.ErrorRuntimeTypeId()),
            title, message), This.Unique("error"));
        Return New LlvmValue(This.Module.BitCast(raw,
            This.TypeHandle(This.ErrorType()), This.Unique("typed_error")),
            This.ErrorType());
    }

    Public Trusted Function void ReturnForException(LlvmFunctionContext context)
    {
        This.PopGcFrame(context);
        TypeSymbol returnType = context.Binding.Symbol.ReturnType;
        If (returnType.Kind == [int](TypeKind.VoidType)) This.Module.ReturnVoid();
        Else This.Module.ReturnValue(This.DefaultValue(returnType).Handle);
    }

    Public Trusted Function void RouteException(LlvmFunctionContext context,
                                                 byte* error)
    {
        byte* functionName = This.Module.GlobalString(
            context.Binding.Symbol.QualifiedName(), This.Unique("exception_function"));
        This.CallRuntime("__kn_exc_push", This.Types1(functionName), "");
        byte* trace = This.CallRuntime("__kn_exc_trace", This.Types0(),
            This.Unique("exception_trace"));
        This.CallRuntime("kn_sh_rt_error_set_trace", This.Types2(error, trace), "");
        If (context.CatchTarget != null && context.ExceptionSlot != null)
        {
            This.Module.Store(error, context.ExceptionSlot);
            This.Module.Branch(context.CatchTarget);
        }
        Else This.ReturnForException(context);
    }

    Public Trusted Function void SetAndRouteException(
        LlvmFunctionContext context, byte* error)
    {
        byte* previous = This.CallRuntime("__kn_exc_last", This.Types0(),
            This.Unique("previous_exception"));
        This.CallRuntime("kn_sh_rt_error_link_inner",
            This.Types2(error, previous), "");
        This.CallRuntime("__kn_exc_set", This.Types1(error), "");
        This.RouteException(context, error);
    }

    Public Trusted Function void MaybePropagateException(
        LlvmFunctionContext context)
    {
        byte* function = context.Binding.Function;
        byte* errorBlock = This.Module.AppendBlock(function,
            This.Unique("exception_error"));
        byte* okBlock = This.Module.AppendBlock(function,
            This.Unique("exception_ok"));
        byte* hasException = This.RuntimeBool(This.CallRuntime(
            "__kn_exc_has", This.Types0(), This.Unique("exception_has_c")));
        This.Module.ConditionalBranch(hasException, errorBlock, okBlock);

        This.Module.PositionAtEnd(errorBlock);
        byte* error = This.CallRuntime("__kn_exc_get", This.Types0(),
            This.Unique("exception_current"));
        This.RouteException(context, error);

        This.Module.PositionAtEnd(okBlock);
    }

    Public Trusted Function void EmitReturn(LlvmFunctionContext context, HirExpression expression)
    {
        TypeSymbol returnType = context.Binding.Symbol.ReturnType;
        LlvmValue value = expression == null ? This.DefaultValue(returnType) :
            This.CastValue(This.EmitExpression(context, expression), returnType);
        This.PopGcFrame(context);
        If (returnType.Kind == [int](TypeKind.VoidType)) This.Module.ReturnVoid();
        Else This.Module.ReturnValue(value.Handle);
    }

    Public Trusted Function void EmitStatementList(LlvmFunctionContext context, HirStatement statement)
    {
        HirStatement current = statement;
        While (current != null)
        {
            byte* block = This.Module.CurrentBlock();
            If (block == null || This.Module.IsTerminated(block)) Return;
            This.EmitStatement(context, current);
            current = current.Next;
        }
    }

    Public Trusted Function void EmitIf(LlvmFunctionContext context, HirStatement statement)
    {
        bool hasPattern = statement.DeclaredSymbol != null &&
            statement.Expression != null &&
            statement.Expression.Kind == [int](HirExpressionKind.Binary) &&
            statement.Expression.Operator == TokenKind.KwIs;
        LlvmValue patternValue = null;
        LlvmValue condition = null;
        If (hasPattern)
        {
            patternValue = This.EmitExpression(context, statement.Expression.Left);
            condition = This.EmitIsValue(context, statement.Expression, patternValue);
        }
        Else condition = This.CastValue(
            This.EmitExpression(context, statement.Expression),
            This.Semantics.Primitive("bool"));
        byte* function = context.Binding.Function;
        byte* trueBlock = This.Module.AppendBlock(function, This.Unique("if_true"));
        byte* falseBlock = This.Module.AppendBlock(function, This.Unique("if_false"));
        byte* mergeBlock = This.Module.AppendBlock(function, This.Unique("if_merge"));
        This.Module.ConditionalBranch(condition.Handle, trueBlock, falseBlock);

        This.Module.PositionAtEnd(trueBlock);
        LlvmVariable savedVariables = context.FirstVariable;
        If (hasPattern)
        {
            byte* address = This.AllocateVariableAddress(context,
                statement.DeclaredSymbol, statement.DeclaredType,
                This.Unique("is_pattern_" + statement.DeclaredSymbol.Name));
            This.Module.Store(
                This.CastValue(patternValue, statement.DeclaredType).Handle,
                address);
            context.AddVariable(New LlvmVariable(statement.DeclaredSymbol.Name,
                statement.DeclaredSymbol, statement.DeclaredType, address));
            This.AddGcRoot(context, statement.DeclaredType, address);
        }
        This.EmitStatementList(context, statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(mergeBlock);
        context.FirstVariable = savedVariables;

        This.Module.PositionAtEnd(falseBlock);
        This.EmitStatementList(context, statement.ElseBranch);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(mergeBlock);

        This.Module.PositionAtEnd(mergeBlock);
    }

    Public Trusted Function void EmitWhile(LlvmFunctionContext context, HirStatement statement)
    {
        byte* function = context.Binding.Function;
        byte* conditionBlock = This.Module.AppendBlock(function, This.Unique("while_condition"));
        byte* bodyBlock = This.Module.AppendBlock(function, This.Unique("while_body"));
        byte* endBlock = This.Module.AppendBlock(function, This.Unique("while_end"));
        This.Module.Branch(conditionBlock);

        This.Module.PositionAtEnd(conditionBlock);
        LlvmValue condition = This.CastValue(This.EmitExpression(context, statement.Expression),
            This.Semantics.Primitive("bool"));
        This.Module.ConditionalBranch(condition.Handle, bodyBlock, endBlock);

        byte* previousBreak = context.BreakTarget;
        byte* previousContinue = context.ContinueTarget;
        context.BreakTarget = endBlock;
        context.ContinueTarget = conditionBlock;
        This.Module.PositionAtEnd(bodyBlock);
        This.EmitStatementList(context, statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(conditionBlock);
        context.BreakTarget = previousBreak;
        context.ContinueTarget = previousContinue;
        This.Module.PositionAtEnd(endBlock);
    }

    Public Trusted Function void EmitFor(LlvmFunctionContext context, HirStatement statement)
    {
        LlvmVariable savedVariables = context.FirstVariable;
        If (statement.Initializer != null) This.EmitStatement(context, statement.Initializer);
        byte* function = context.Binding.Function;
        byte* conditionBlock = This.Module.AppendBlock(function, This.Unique("for_condition"));
        byte* bodyBlock = This.Module.AppendBlock(function, This.Unique("for_body"));
        byte* stepBlock = This.Module.AppendBlock(function, This.Unique("for_step"));
        byte* endBlock = This.Module.AppendBlock(function, This.Unique("for_end"));
        This.Module.Branch(conditionBlock);

        This.Module.PositionAtEnd(conditionBlock);
        If (statement.Expression == null) This.Module.Branch(bodyBlock);
        Else
        {
            LlvmValue condition = This.CastValue(This.EmitExpression(context, statement.Expression),
                This.Semantics.Primitive("bool"));
            This.Module.ConditionalBranch(condition.Handle, bodyBlock, endBlock);
        }

        byte* previousBreak = context.BreakTarget;
        byte* previousContinue = context.ContinueTarget;
        context.BreakTarget = endBlock;
        context.ContinueTarget = stepBlock;
        This.Module.PositionAtEnd(bodyBlock);
        This.EmitStatementList(context, statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(stepBlock);

        This.Module.PositionAtEnd(stepBlock);
        If (statement.SecondExpression != null) This.EmitExpression(context, statement.SecondExpression);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(conditionBlock);
        context.BreakTarget = previousBreak;
        context.ContinueTarget = previousContinue;
        context.FirstVariable = savedVariables;
        This.Module.PositionAtEnd(endBlock);
    }

    Public Trusted Function void EmitForeach(LlvmFunctionContext context,
                                               HirStatement statement)
    {
        LlvmValue source = This.EmitExpression(context, statement.Expression);
        bool stringSource = source.Type.Kind == [int](TypeKind.StringType);
        bool arraySource = source.Type.Kind == [int](TypeKind.ArrayType);
        If (!stringSource && !arraySource)
        {
            This.Fail("foreach source must be an array or string");
            Return;
        }

        byte* int64Type = This.Module.IntType(64);
        byte* sourceAddress = This.Module.Alloca(This.TypeHandle(source.Type),
            This.Unique("foreach_source"));
        This.Module.Store(source.Handle, sourceAddress);
        This.AddGcRoot(context, source.Type, sourceAddress);
        byte* indexAddress = This.Module.Alloca(int64Type,
            This.Unique("foreach_index"));
        This.Module.Store(This.Module.ConstInt(int64Type, 0), indexAddress);
        byte* itemAddress = This.AllocateVariableAddress(context,
            statement.DeclaredSymbol, statement.DeclaredType,
            This.Unique("foreach_" + statement.Name));
        This.AddGcRoot(context, statement.DeclaredType, itemAddress);

        byte* function = context.Binding.Function;
        byte* conditionBlock = This.Module.AppendBlock(function,
            This.Unique("foreach_condition"));
        byte* bodyBlock = This.Module.AppendBlock(function,
            This.Unique("foreach_body"));
        byte* stepBlock = This.Module.AppendBlock(function,
            This.Unique("foreach_step"));
        byte* endBlock = This.Module.AppendBlock(function,
            This.Unique("foreach_end"));
        This.Module.Branch(conditionBlock);

        This.Module.PositionAtEnd(conditionBlock);
        byte* index = This.Module.Load(int64Type, indexAddress,
            This.Unique("foreach_index_value"));
        LlvmValue currentSource = New LlvmValue(
            This.Module.Load(This.TypeHandle(source.Type), sourceAddress,
                This.Unique("foreach_source_value")), source.Type);
        byte* length = stringSource ?
            This.CallRuntime("kn_sh_rt_string_length", This.Types1(currentSource.Handle),
                This.Unique("foreach_string_length")) :
            This.Module.ExtractValue(currentSource.Handle, 1,
                This.Unique("foreach_array_length"));
        byte* more = This.Module.Compare([int](LlvmIntPredicate.UnsignedLess),
            index, length, This.Unique("foreach_more"));
        This.Module.ConditionalBranch(more, bodyBlock, endBlock);

        byte* previousBreak = context.BreakTarget;
        byte* previousContinue = context.ContinueTarget;
        context.BreakTarget = endBlock;
        context.ContinueTarget = stepBlock;
        This.Module.PositionAtEnd(bodyBlock);
        TypeSymbol sourceItemType = stringSource ?
            This.Semantics.Primitive("char") : source.Type.ElementType;
        byte* data = stringSource ? currentSource.Handle :
            This.Module.ExtractValue(currentSource.Handle, 0,
                This.Unique("foreach_array_data"));
        byte* elementAddress = This.Module.Gep(This.TypeHandle(sourceItemType), data,
            This.Types1(index), true, This.Unique("foreach_element_address"));
        LlvmValue item = New LlvmValue(This.Module.Load(This.TypeHandle(sourceItemType),
            elementAddress, This.Unique("foreach_element")), sourceItemType);
        This.Module.Store(This.CastValue(item, statement.DeclaredType).Handle, itemAddress);
        LlvmVariable savedVariables = context.FirstVariable;
        context.AddVariable(New LlvmVariable(statement.Name,
            statement.DeclaredSymbol, statement.DeclaredType, itemAddress));
        This.EmitStatementList(context, statement.FirstChild);
        context.FirstVariable = savedVariables;
        If (!This.Module.IsTerminated(This.Module.CurrentBlock()))
            This.Module.Branch(stepBlock);

        This.Module.PositionAtEnd(stepBlock);
        byte* nextIndex = This.Module.Add(
            This.Module.Load(int64Type, indexAddress,
                This.Unique("foreach_step_index")),
            This.Module.ConstInt(int64Type, 1), This.Unique("foreach_next_index"));
        This.Module.Store(nextIndex, indexAddress);
        This.Module.Branch(conditionBlock);
        context.BreakTarget = previousBreak;
        context.ContinueTarget = previousContinue;
        This.Module.PositionAtEnd(endBlock);
    }

    Public Trusted Function void EmitSwitchStatement(LlvmFunctionContext context, HirStatement statement)
    {
        LlvmValue selector = This.EmitExpression(context, statement.Expression);
        byte* function = context.Binding.Function;
        byte* endBlock = This.Module.AppendBlock(function, This.Unique("switch_end"));
        byte* previousBreak = context.BreakTarget;
        context.BreakTarget = endBlock;
        HirStatement defaultCase = null;
        HirStatement item = statement.FirstChild;
        While (item != null)
        {
            If (item.Name == "default")
            {
                defaultCase = item;
                item = item.Next;
                Continue;
            }
            byte* caseBlock = This.Module.AppendBlock(function, This.Unique("switch_case"));
            byte* nextBlock = This.Module.AppendBlock(function, This.Unique("switch_next"));
            LlvmValue caseValue = This.EmitExpression(context, item.Expression);
            This.Module.ConditionalBranch(This.EmitSwitchMatch(selector, caseValue), caseBlock, nextBlock);
            This.Module.PositionAtEnd(caseBlock);
            LlvmVariable savedVariables = context.FirstVariable;
            This.EmitStatementList(context, item.FirstChild);
            context.FirstVariable = savedVariables;
            If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(endBlock);
            This.Module.PositionAtEnd(nextBlock);
            item = item.Next;
        }
        If (defaultCase != null)
        {
            LlvmVariable savedVariables = context.FirstVariable;
            This.EmitStatementList(context, defaultCase.FirstChild);
            context.FirstVariable = savedVariables;
        }
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(endBlock);
        context.BreakTarget = previousBreak;
        This.Module.PositionAtEnd(endBlock);
    }

    Public Trusted Function void EmitTry(LlvmFunctionContext context,
                                          HirStatement statement)
    {
        HirStatement handler = statement.ElseBranch;
        If (handler == null)
        {
            This.EmitStatementList(context, statement.FirstChild);
            Return;
        }

        byte* function = context.Binding.Function;
        byte* catchBlock = This.Module.AppendBlock(function,
            This.Unique("catch"));
        byte* afterBlock = This.Module.AppendBlock(function,
            This.Unique("try_end"));
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* exceptionSlot = This.Module.Alloca(bytePointer,
            This.Unique("try_exception"));
        This.Module.Store(This.Module.ConstNull(bytePointer), exceptionSlot);

        byte* previousCatch = context.CatchTarget;
        byte* previousSlot = context.ExceptionSlot;
        context.CatchTarget = catchBlock;
        context.ExceptionSlot = exceptionSlot;
        This.EmitStatementList(context, statement.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock()))
            This.Module.Branch(afterBlock);
        context.CatchTarget = previousCatch;
        context.ExceptionSlot = previousSlot;

        This.Module.PositionAtEnd(catchBlock);
        byte* error = This.Module.Load(bytePointer, exceptionSlot,
            This.Unique("caught_error"));
        This.CallRuntime("__kn_exc_clear", This.Types0(), "");
        LlvmVariable savedVariables = context.FirstVariable;
        If (handler.DeclaredSymbol != null && handler.DeclaredType != null)
        {
            byte* address = This.AllocateVariableAddress(context,
                handler.DeclaredSymbol, handler.DeclaredType,
                This.Unique("catch_" + handler.DeclaredSymbol.Name));
            byte* caught = null;
            If (handler.DeclaredType.Kind == [int](TypeKind.StringType))
                caught = This.CallRuntime("kn_sh_rt_error_message",
                    This.Types1(error), This.Unique("caught_message"));
            Else caught = This.Module.BitCast(error,
                This.TypeHandle(handler.DeclaredType), This.Unique("caught_object"));
            This.Module.Store(caught, address);
            context.AddVariable(New LlvmVariable(handler.DeclaredSymbol.Name,
                handler.DeclaredSymbol, handler.DeclaredType, address));
            This.AddGcRoot(context, handler.DeclaredType, address);
        }
        This.EmitStatementList(context, handler.FirstChild);
        context.FirstVariable = savedVariables;
        If (!This.Module.IsTerminated(This.Module.CurrentBlock()))
            This.Module.Branch(afterBlock);
        This.Module.PositionAtEnd(afterBlock);
    }

    Public Trusted Function void EmitThrow(LlvmFunctionContext context,
                                            HirStatement statement)
    {
        LlvmValue value = This.EmitExpression(context, statement.Expression);
        byte* error = null;
        If (value.Type.Name == "IO.Error") error = This.ErrorPointer(value);
        Else
        {
            LlvmValue message = This.CastValue(value,
                This.Semantics.Primitive("string"));
            LlvmValue created = This.CreateError(
                This.Module.GlobalString("Error", This.Unique("throw_title")),
                message.Handle);
            error = This.ErrorPointer(created);
        }
        This.SetAndRouteException(context, error);
    }

    Public Trusted Function void EmitStatement(LlvmFunctionContext context, HirStatement statement)
    {
        If (statement == null) Return;
        If (statement.Kind == [int](StatementKind.Block))
        {
            LlvmVariable savedVariables = context.FirstVariable;
            This.EmitStatementList(context, statement.FirstChild);
            context.FirstVariable = savedVariables;
            Return;
        }
        If (statement.Kind == [int](StatementKind.UnsafeBlock))
        {
            This.RegisterUnsafeBlock(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Jump))
        {
            This.EmitUnsafeJump(context, context.ActiveBlock, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Record)) Return;
        If (statement.Kind == [int](StatementKind.Variable))
        {
            byte* address = This.AllocateVariableAddress(context, statement.DeclaredSymbol,
                statement.DeclaredType, This.Sanitize(statement.Name));
            LlvmVariable variable = New LlvmVariable(statement.Name, statement.DeclaredSymbol,
                statement.DeclaredType, address);
            context.AddVariable(variable);
            This.AddGcRoot(context, statement.DeclaredType, address);
            LlvmValue value = null;
            If (statement.DeclaredType.Kind == [int](TypeKind.ArrayType) &&
                statement.SecondExpression != null)
            {
                LlvmValue requestedLength = This.CastValue(
                    This.EmitExpression(context, statement.SecondExpression),
                    This.Semantics.Primitive("int"));
                HirExpression firstItem = statement.Expression != null &&
                    statement.Expression.Kind == [int](HirExpressionKind.ArrayLiteral) ?
                    statement.Expression.FirstArgument : null;
                value = This.EmitArrayValue(context, statement.DeclaredType, firstItem,
                    requestedLength.Handle);
            }
            Else value = statement.Expression == null ? This.DefaultValue(statement.DeclaredType) :
                This.CastValue(This.EmitExpression(context, statement.Expression), statement.DeclaredType);
            This.Module.Store(value.Handle, address);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Expression))
        {
            This.EmitExpression(context, statement.Expression);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Return))
        {
            This.EmitReturn(context, statement.Expression);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Throw))
        {
            This.EmitThrow(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Try))
        {
            This.EmitTry(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.If))
        {
            This.EmitIf(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.While))
        {
            This.EmitWhile(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.For))
        {
            This.EmitFor(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Foreach))
        {
            This.EmitForeach(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Switch))
        {
            This.EmitSwitchStatement(context, statement);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Break))
        {
            If (context.BreakTarget == null) This.Fail("break used outside loop");
            Else This.Module.Branch(context.BreakTarget);
            Return;
        }
        If (statement.Kind == [int](StatementKind.Continue))
        {
            If (context.ContinueTarget == null) This.Fail("continue used outside loop");
            Else This.Module.Branch(context.ContinueTarget);
        }
    }

    Public Trusted Function void EmitBlockFunctionBody(LlvmFunctionBinding binding,
                                                        HirFunction hirFunction)
    {
        byte* entry = This.Module.AppendBlock(binding.Function, "entry");
        This.Module.PositionAtEnd(entry);
        LlvmFunctionContext context = New LlvmFunctionContext(binding);
        context.GcFrame = This.CallRuntime("__kn_gc_push_frame", This.Types0(), This.Unique("gc_frame"));

        If (binding.Symbol.FirstCapture != null)
        {
            byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
            byte* environment = This.Module.Parameter(binding.Function, 0);
            CaptureSymbol capture = binding.Symbol.FirstCapture;
            While (capture != null)
            {
                byte* slot = This.Module.Gep(bytePointer, environment,
                    This.Types1(This.Module.ConstInt(This.Module.IntType(64), capture.Index)),
                    true, This.Unique("capture_slot"));
                byte* address = This.Module.Load(bytePointer, slot,
                    This.Unique("capture_address"));
                context.AddVariable(New LlvmVariable(capture.Name, capture.Value,
                    capture.Type, address));
                capture = capture.Next;
            }
        }

        LlvmBlockBinding block = This.RegisterUnsafeBlock(context, hirFunction.Body);
        block.Emitted = true;
        block.StartBlock = This.Module.AppendBlock(binding.Function, This.Unique("block_start"));
        block.DoneBlock = This.Module.AppendBlock(binding.Function, This.Unique("block_done"));
        LlvmRecordBinding record = block.FirstRecord;
        While (record != null)
        {
            record.Block = This.Module.AppendBlock(binding.Function,
                This.Unique("block_record_" + This.Sanitize(record.Name)));
            record = record.Next;
        }

        byte* mode = This.Module.Parameter(binding.Function, 1);
        byte* first = This.Module.Parameter(binding.Function, 2);
        byte* second = This.Module.Parameter(binding.Function, 3);
        byte* modeJump = This.Module.Compare([int](LlvmIntPredicate.Equal), mode,
            This.Module.ConstInt(This.Module.IntType(64), 1), This.Unique("block_mode_jump"));
        byte* modeJumpUntil = This.Module.Compare([int](LlvmIntPredicate.Equal), mode,
            This.Module.ConstInt(This.Module.IntType(64), 3), This.Unique("block_mode_jump_until"));
        byte* startsAtRecord = This.Module.Or(modeJump, modeJumpUntil,
            This.Unique("block_starts_at_record"));
        byte* startOrdinal = This.Module.Select(startsAtRecord, first,
            This.Module.ConstInt(This.Module.IntType(64), 0), This.Unique("block_start_ordinal"));
        byte* modeUntil = This.Module.Compare([int](LlvmIntPredicate.Equal), mode,
            This.Module.ConstInt(This.Module.IntType(64), 2), This.Unique("block_mode_until"));
        context.RuntimeUntilEnabled = This.Module.Or(modeUntil, modeJumpUntil,
            This.Unique("block_until_enabled"));
        context.RuntimeUntilOrdinal = This.Module.Select(modeJumpUntil, second, first,
            This.Unique("block_until_ordinal"));

        byte* firstCheck = This.Module.AppendBlock(binding.Function, This.Unique("block_dispatch"));
        byte* startsAtBeginning = This.Module.Compare([int](LlvmIntPredicate.Equal), startOrdinal,
            This.Module.ConstInt(This.Module.IntType(64), 0), This.Unique("block_starts_at_beginning"));
        This.Module.ConditionalBranch(startsAtBeginning, block.StartBlock, firstCheck);
        This.Module.PositionAtEnd(firstCheck);
        record = block.FirstRecord;
        While (record != null)
        {
            byte* nextCheck = This.Module.AppendBlock(binding.Function,
                This.Unique("block_dispatch_next"));
            byte* matches = This.Module.Compare([int](LlvmIntPredicate.Equal), startOrdinal,
                This.Module.ConstInt(This.Module.IntType(64), record.Ordinal),
                This.Unique("block_dispatch_match"));
            This.Module.ConditionalBranch(matches, record.Block, nextCheck);
            This.Module.PositionAtEnd(nextCheck);
            record = record.Next;
        }
        This.Module.Branch(block.DoneBlock);

        This.Module.PositionAtEnd(block.StartBlock);
        byte* startRun = This.Module.AppendBlock(binding.Function, This.Unique("block_start_run"));
        byte* stopAtStart = This.Module.And(context.RuntimeUntilEnabled,
            This.Module.Compare([int](LlvmIntPredicate.Equal), context.RuntimeUntilOrdinal,
                This.Module.ConstInt(This.Module.IntType(64), 0), This.Unique("block_start_limit")),
            This.Unique("block_stop_at_start"));
        This.Module.ConditionalBranch(stopAtStart, block.DoneBlock, startRun);
        This.Module.PositionAtEnd(startRun);
        context.ActiveBlock = block;
        This.EmitUnsafeStatementList(context, block, hirFunction.Body.FirstChild);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.Module.Branch(block.DoneBlock);

        This.Module.PositionAtEnd(block.DoneBlock);
        This.PopGcFrame(context);
        This.Module.ReturnVoid();
    }

    Public Trusted Function void EmitRegularFunctionBody(
        LlvmFunctionBinding binding, HirFunction hirFunction)
    {
        byte* entry = This.Module.AppendBlock(binding.Function, "entry");
        This.Module.PositionAtEnd(entry);
        LlvmFunctionContext context = New LlvmFunctionContext(binding);
        context.GcFrame = This.CallRuntime("__kn_gc_push_frame", This.Types0(), This.Unique("gc_frame"));

        int parameterIndex = 0;
        If (binding.Symbol.FirstCapture != null)
        {
            byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
            byte* environment = This.Module.Parameter(binding.Function, parameterIndex);
            parameterIndex = parameterIndex + 1;
            CaptureSymbol capture = binding.Symbol.FirstCapture;
            While (capture != null)
            {
                byte* slot = This.Module.Gep(bytePointer, environment,
                    This.Types1(This.Module.ConstInt(This.Module.IntType(64), capture.Index)),
                    true, This.Unique("capture_slot"));
                byte* address = This.Module.Load(bytePointer, slot,
                    This.Unique("capture_address"));
                context.AddVariable(New LlvmVariable(capture.Name, capture.Value,
                    capture.Type, address));
                capture = capture.Next;
            }
        }
        bool hasReceiver = binding.Symbol.OwnerType != null &&
            (!binding.Symbol.Declaration.IsStatic || binding.Symbol.Declaration.IsConstructor);
        If (hasReceiver)
        {
            byte* address = This.AllocateVariableAddress(context, binding.Symbol.Receiver,
                binding.Symbol.OwnerType, "This");
            This.Module.Store(This.Module.Parameter(binding.Function, parameterIndex), address);
            context.AddVariable(New LlvmVariable("This", binding.Symbol.Receiver,
                binding.Symbol.OwnerType, address));
            This.AddGcRoot(context, binding.Symbol.OwnerType, address);
            parameterIndex = parameterIndex + 1;
        }
        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        While (parameter != null)
        {
            byte* address = This.AllocateVariableAddress(context, parameter.Value,
                parameter.Type, This.Sanitize(parameter.Name));
            This.Module.Store(This.Module.Parameter(binding.Function, parameterIndex), address);
            context.AddVariable(New LlvmVariable(parameter.Name, parameter.Value, parameter.Type, address));
            This.AddGcRoot(context, parameter.Type, address);
            parameterIndex = parameterIndex + 1;
            parameter = parameter.Next;
        }

        This.EmitStatementList(context, hirFunction.Body);
        If (!This.Module.IsTerminated(This.Module.CurrentBlock())) This.EmitReturn(context, null);
    }

    Public Trusted Function void EmitAsyncFunctionBody(
        LlvmFunctionBinding binding, HirFunction hirFunction)
    {
        LlvmFunctionBinding bodyBinding = New LlvmFunctionBinding(
            binding.Symbol, binding.AsyncBodyFunctionType,
            binding.AsyncBodyFunction, false);
        This.EmitRegularFunctionBody(bodyBinding, hirFunction);

        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* int64Type = This.Module.IntType(64);
        byte* runnerEntry = This.Module.AppendBlock(
            binding.AsyncRunnerFunction, "entry");
        This.Module.PositionAtEnd(runnerEntry);
        byte* environment = This.Module.BitCast(
            This.Module.Parameter(binding.AsyncRunnerFunction, 0),
            This.Module.PointerType(binding.AsyncEnvironmentType),
            This.Unique("async_environment"));
        byte* task = This.Module.Parameter(binding.AsyncRunnerFunction, 1);
        LlvmHandles arguments = New LlvmHandles();
        int fieldIndex = 0;
        If (binding.Symbol.FirstCapture != null)
        {
            byte* address = This.Module.StructGep(binding.AsyncEnvironmentType,
                environment, fieldIndex, This.Unique("async_capture_address"));
            arguments.Add(This.Module.Load(bytePointer, address,
                This.Unique("async_capture")));
            fieldIndex = fieldIndex + 1;
        }
        bool hasReceiver = binding.Symbol.OwnerType != null &&
            (!binding.Symbol.Declaration.IsStatic ||
             binding.Symbol.Declaration.IsConstructor);
        If (hasReceiver)
        {
            byte* address = This.Module.StructGep(binding.AsyncEnvironmentType,
                environment, fieldIndex, This.Unique("async_receiver_address"));
            arguments.Add(This.Module.Load(This.TypeHandle(binding.Symbol.OwnerType),
                address, This.Unique("async_receiver")));
            fieldIndex = fieldIndex + 1;
        }
        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        While (parameter != null)
        {
            byte* address = This.Module.StructGep(binding.AsyncEnvironmentType,
                environment, fieldIndex, This.Unique("async_parameter_address"));
            arguments.Add(This.Module.Load(This.TypeHandle(parameter.Type), address,
                This.Unique("async_parameter")));
            fieldIndex = fieldIndex + 1;
            parameter = parameter.Next;
        }

        byte* logicalResult = This.Module.Call(binding.AsyncBodyFunctionType,
            binding.AsyncBodyFunction, arguments,
            binding.Symbol.ReturnType.Kind == [int](TypeKind.VoidType) ?
                "" : This.Unique("async_body_result"));
        byte* failedBlock = This.Module.AppendBlock(binding.AsyncRunnerFunction,
            This.Unique("async_failed"));
        byte* completedBlock = This.Module.AppendBlock(binding.AsyncRunnerFunction,
            This.Unique("async_completed"));
        byte* hasException = This.RuntimeBool(This.CallRuntime(
            "__kn_exc_has", This.Types0(), This.Unique("async_exception_c")));
        This.Module.ConditionalBranch(hasException, failedBlock, completedBlock);

        This.Module.PositionAtEnd(failedBlock);
        byte* error = This.CallRuntime("__kn_exc_get", This.Types0(),
            This.Unique("async_error"));
        byte* trace = This.CallRuntime("__kn_exc_trace", This.Types0(),
            This.Unique("async_trace"));
        This.CallRuntime("__kn_async_task_fail",
            This.Types3(task, error, trace), "");
        This.Module.ReturnVoid();

        This.Module.PositionAtEnd(completedBlock);
        byte* tag = This.Module.ConstInt(int64Type, 0);
        byte* payload = This.Module.ConstInt(int64Type, 0);
        If (binding.Symbol.ReturnType.Kind != [int](TypeKind.VoidType))
        {
            LlvmValue boxed = This.BoxAny(New LlvmValue(
                logicalResult, binding.Symbol.ReturnType));
            tag = This.Module.ExtractValue(boxed.Handle, 0,
                This.Unique("async_result_tag"));
            payload = This.Module.ExtractValue(boxed.Handle, 1,
                This.Unique("async_result_payload"));
        }
        This.CallRuntime("__kn_async_task_complete",
            This.Types3(task, tag, payload), "");
        This.Module.ReturnVoid();

        byte* outerEntry = This.Module.AppendBlock(binding.Function, "entry");
        This.Module.PositionAtEnd(outerEntry);
        byte* rawEnvironment = This.CallRuntime("__kn_gc_alloc",
            This.Types1(This.Module.SizeOf(binding.AsyncEnvironmentType)),
            This.Unique("async_environment_memory"));
        environment = This.Module.BitCast(rawEnvironment,
            This.Module.PointerType(binding.AsyncEnvironmentType),
            This.Unique("async_environment_pointer"));
        int outerIndex = 0;
        int fieldCount = binding.Symbol.ParameterCount() +
            (binding.Symbol.FirstCapture == null ? 0 : 1) +
            (hasReceiver ? 1 : 0);
        While (outerIndex < fieldCount)
        {
            byte* address = This.Module.StructGep(binding.AsyncEnvironmentType,
                environment, outerIndex, This.Unique("async_environment_field"));
            This.Module.Store(This.Module.Parameter(binding.Function, outerIndex),
                address);
            outerIndex = outerIndex + 1;
        }
        byte* rawRunner = This.Module.BitCast(binding.AsyncRunnerFunction,
            bytePointer, This.Unique("async_runner"));
        byte* spawned = This.CallRuntime("__kn_async_task_spawn",
            This.Types2(rawRunner, rawEnvironment), This.Unique("async_task"));
        This.Module.ReturnValue(This.Module.BitCast(spawned,
            This.TypeHandle(This.Semantics.FindExactType("IO.Async.Task")),
            This.Unique("async_task_value")));
    }

    Public Trusted Function void EmitFunctionBody(LlvmFunctionBinding binding)
    {
        If (binding.Symbol.Declaration.IsExtern) Return;
        HirFunction hirFunction = This.FindHirFunction(binding.Symbol);
        If (hirFunction == null || hirFunction.Body == null) Return;
        If (binding.Symbol.IsBlockLiteral)
        {
            This.EmitBlockFunctionBody(binding, hirFunction);
            Return;
        }
        If (binding.Symbol.Declaration.IsAsync)
        {
            This.EmitAsyncFunctionBody(binding, hirFunction);
            Return;
        }
        This.EmitRegularFunctionBody(binding, hirFunction);
    }

    Public Trusted Function void EmitFunctions()
    {
        LlvmFunctionBinding binding = This.FirstFunction;
        While (binding != null)
        {
            This.EmitFunctionBody(binding);
            binding = binding.Next;
        }
    }

    Public Safe Function LlvmFunctionBinding FindEntryFunction()
    {
        LlvmFunctionBinding binding = This.FirstFunction;
        While (binding != null)
        {
            If (binding.Symbol.OwnerType == null && binding.Symbol.Name == "Main" &&
                binding.Symbol.UnitName == This.Semantics.Session.EntryUnitName) Return binding;
            binding = binding.Next;
        }
        Return null;
    }

    Public Trusted Function void EmitEntryPoint()
    {
        LlvmFunctionBinding entryBinding = This.FindEntryFunction();
        If (entryBinding == null)
        {
            This.Fail("entry unit does not declare Main");
            Return;
        }
        byte* int32Type = This.Module.IntType(32);
        byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
        byte* argvType = This.Module.PointerType(bytePointer);
        LlvmHandles mainParameters = This.Types2(int32Type, argvType);
        byte* mainType = This.Module.FunctionType(int32Type, mainParameters, false);
        byte* mainFunction = This.Module.AddFunction("main", mainType);
        byte* block = This.Module.AppendBlock(mainFunction, "entry");
        This.Module.PositionAtEnd(block);
        This.CallRuntime("__kn_gc_init", This.Types0(), "");
        This.InitializeGlobalRoots();
        This.InitializeFixedGlobalArrays();
        This.InitializeGlobalCallables();
        This.InitializeGlobalCopies();

        LlvmHandles arguments = New LlvmHandles();
        int count = entryBinding.Symbol.ParameterCount();
        If (count == 1)
        {
            ParameterSymbol parameter = entryBinding.Symbol.FirstParameter;
            If (parameter.Type.Kind != [int](TypeKind.ArrayType) ||
                parameter.Type.ElementType.Kind != [int](TypeKind.StringType))
            {
                This.Fail("Main parameter must be string[]");
                Return;
            }
            byte* dataSlot = This.Module.Alloca(argvType, "args_data_slot");
            byte* lengthSlot = This.Module.Alloca(This.Module.IntType(64), "args_length_slot");
            This.CallRuntime("__kn_sys_args_from_argv", This.Types4(
                This.Module.Parameter(mainFunction, 0), This.Module.Parameter(mainFunction, 1),
                dataSlot, lengthSlot), "");
            byte* array = This.Module.ConstUndef(This.TypeHandle(parameter.Type));
            array = This.Module.InsertValue(array,
                This.Module.Load(argvType, dataSlot, "args_data"), 0, "");
            array = This.Module.InsertValue(array,
                This.Module.Load(This.Module.IntType(64), lengthSlot, "args_length"), 1, "");
            arguments.Add(array);
        }
        ElseIf (count != 0)
        {
            This.Fail("Main must take zero parameters or string[]");
            Return;
        }

        byte* result = This.Module.Call(entryBinding.FunctionType, entryBinding.Function,
            arguments, entryBinding.Symbol.Declaration.IsAsync ||
                entryBinding.Symbol.ReturnType.Kind != [int](TypeKind.VoidType) ?
                "entry_result" : "");
        byte* normalCode = This.Module.ConstInt(int32Type, 0);
        If (entryBinding.Symbol.Declaration.IsAsync)
        {
            LlvmValue boxed = This.RunAsyncTask(result, "entry_async");
            If (entryBinding.Symbol.ReturnType.Kind != [int](TypeKind.VoidType))
            {
                LlvmValue logicalResult = entryBinding.Symbol.ReturnType.Kind ==
                    [int](TypeKind.AnyType) ? boxed :
                    This.UnboxAny(boxed, entryBinding.Symbol.ReturnType);
                logicalResult = This.CastValue(logicalResult,
                    This.Semantics.Primitive("int"));
                normalCode = This.Module.Truncate(logicalResult.Handle,
                    int32Type, "exit_code");
            }
        }
        ElseIf (entryBinding.Symbol.ReturnType.Kind != [int](TypeKind.VoidType))
            normalCode = This.Module.Truncate(result, int32Type, "exit_code");

        byte* normalBlock = This.Module.AppendBlock(mainFunction, "entry_no_exception");
        byte* errorBlock = This.Module.AppendBlock(mainFunction, "entry_exception");
        byte* doneBlock = This.Module.AppendBlock(mainFunction, "entry_done");
        byte* hasException = This.RuntimeBool(This.CallRuntime(
            "__kn_exc_has", This.Types0(), "entry_exception_has_c"));
        This.Module.ConditionalBranch(hasException, errorBlock, normalBlock);

        This.Module.PositionAtEnd(normalBlock);
        This.Module.Branch(doneBlock);
        byte* normalEnd = This.Module.CurrentBlock();

        This.Module.PositionAtEnd(errorBlock);
        byte* error = This.CallRuntime("__kn_exc_get", This.Types0(),
            "entry_exception_value");
        byte* message = This.CallRuntime("kn_sh_rt_error_message",
            This.Types1(error), "entry_exception_message");
        byte* trace = This.CallRuntime("__kn_exc_trace", This.Types0(),
            "entry_exception_trace");
        byte* formattedTrace = This.CallRuntime("kn_sh_rt_trace_format",
            This.Types1(trace), "entry_exception_trace_text");
        This.CallRuntime("kn_sh_rt_print_line", This.Types1(message), "");
        This.CallRuntime("kn_sh_rt_print_line", This.Types1(formattedTrace), "");
        This.CallRuntime("__kn_exc_clear", This.Types0(), "");
        This.Module.Branch(doneBlock);
        byte* errorEnd = This.Module.CurrentBlock();

        This.Module.PositionAtEnd(doneBlock);
        byte* exitCode = This.Module.Phi(int32Type, "entry_final_code");
        This.Module.AddIncoming(exitCode, normalCode, normalEnd);
        This.Module.AddIncoming(exitCode, This.Module.ConstInt(int32Type, 1),
            errorEnd);
        This.Module.ReturnValue(exitCode);
    }

    Public Trusted Function bool GenerateModule()
    {
        If (!This.Module.IsValid())
        {
            This.Fail("LLVM module creation failed: " + IO.Kinal.Compiler.Backend.LlvmBridge.LastError());
            Return false;
        }
        This.PrepareTypes();
        This.DeclareRuntime();
        This.DeclareFunctions();
        This.DeclareGlobals();
        This.EmitFunctions();
        This.EmitEntryPoint();
        If (This.Failed()) Return false;
        If (!This.Module.Verify())
        {
            This.Fail("LLVM verification failed: " + IO.Kinal.Compiler.Backend.LlvmBridge.LastError());
            Return false;
        }
        Return true;
    }

    Public Trusted Function bool EmitObject(string outputPath)
    {
        If (!This.GenerateModule()) Return false;
        If (!This.Module.EmitObject("", outputPath))
        {
            This.Fail("object emission failed: " + IO.Kinal.Compiler.Backend.LlvmBridge.LastError());
            Return false;
        }
        Return true;
    }

    Public Trusted Function void Dispose()
    {
        This.Module.Dispose();
    }
}

                This.Semantics.Primitive("int"));
            This.CallRuntime("__kn_time_sleep", This.Types1(This.Module.Truncate(milliseconds.Handle,
                This.Module.IntType(32), This.Unique("sleep_ms"))), "");
            Return This.DefaultValue(This.Semantics.Primitive("void"));

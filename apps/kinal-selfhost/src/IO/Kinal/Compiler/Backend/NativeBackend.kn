            first.Kind == [int](HirExpressionKind.FunctionReference) &&
            first.Function != null ?
            New LlvmValue(This.Module.GlobalString(first.Function.QualifiedName(),
                This.Unique("meta_owner_name")), This.Semantics.Primitive("string")) :
            This.CastValue(This.EmitExpression(context, first),
                This.Semantics.Primitive("string"));

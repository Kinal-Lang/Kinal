                    This.Semantics.Primitive("usize"));
                This.CallRuntime("kn_sh_rt_memory_copy",
                    This.Types3(destination.Handle, source.Handle, count.Handle), "");
            }
            Else
            {
                LlvmValue count = This.CastValue(This.EmitExpression(context, first.Next),
                    This.Semantics.Primitive("usize"));
                This.CallRuntime("kn_sh_rt_memory_zero", This.Types2(destination.Handle, count.Handle), "");
            }
            Return This.DefaultValue(This.Semantics.Primitive("void"));
        }
        If (IO.Text.StartsWith(target, "IO.Volatile.Read"))
        {
            int bits = target == "IO.Volatile.Read8" ? 8 :
                (target == "IO.Volatile.Read16" ? 16 : (target == "IO.Volatile.Read32" ? 32 : 64));
            LlvmValue address = This.EmitExpression(context, first);
            byte* raw = This.CallRuntime("kn_sh_rt_volatile_read" + [string](bits),
                This.Types1(address.Handle), This.Unique("volatile_read"));
            If (bits < 64) raw = This.Module.ZeroExtend(raw, This.Module.IntType(64),
                This.Unique("volatile_read_wide"));

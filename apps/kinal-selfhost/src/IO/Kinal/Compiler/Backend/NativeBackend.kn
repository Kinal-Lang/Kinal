            This.Semantics.Primitive("string"));
        byte* owners = This.CallRuntime("__kn_list_new", This.Types0(), This.Unique("meta_owners"));
        FunctionSymbol symbol = This.Semantics.FirstFunction;
        While (symbol != null)
        {
            SyntaxAttribute attribute = symbol.Declaration.FirstAttribute;
            While (attribute != null)
            {
                byte* matches = This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                    This.Types2(requested.Handle,
                        This.Module.GlobalString(attribute.Name, This.Unique("meta_name"))),
                    This.Unique("meta_match_c")));
                byte* addBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("meta_query_add"));
                byte* nextBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("meta_query_next"));
                This.Module.ConditionalBranch(matches, addBlock, nextBlock);
                This.Module.PositionAtEnd(addBlock);
                byte* owner = This.Module.GlobalString(symbol.QualifiedName(), This.Unique("meta_owner"));
                This.CallRuntime("__kn_list_add", This.Types3(owners,
                    This.Module.ConstInt(This.Module.IntType(64), 5),
                    This.Module.PointerToInt(owner, This.Module.IntType(64), This.Unique("meta_owner_value"))), "");
                This.Module.Branch(nextBlock);
                This.Module.PositionAtEnd(nextBlock);
                attribute = attribute.Next;
            }
            symbol = symbol.Next;
        }
        Return New LlvmValue(owners, This.Semantics.Primitive("list"));
    }

    Public Trusted Function void EmitMetaAttributeArguments(byte* dictionary, SyntaxAttribute attribute)
    {
        int count = 0;
        ExpressionNode argument = attribute.FirstArgument;
        While (argument != null)
        {
            string name = "arg." + [string](count);
            If (attribute.Name == "VmBuiltin")
                name = count == 0 ? "arg.id" : "arg.name";
            If (argument.Kind == [int](ExpressionKind.String))
                This.EmitMetaDictString(dictionary, name, This.DecodeString(argument.Text));
            Else
                This.EmitMetaDictInteger(dictionary, name, [int](argument.Text));
            count = count + 1;
            argument = argument.Next;
        }
        This.EmitMetaDictInteger(dictionary, "arg_count", count);
    }

    Public Trusted Function LlvmValue EmitMetaFind(LlvmFunctionContext context, HirExpression expression)
    {

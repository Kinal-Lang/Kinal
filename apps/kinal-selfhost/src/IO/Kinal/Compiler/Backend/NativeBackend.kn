        If (receiver != null && receiver.Type.Kind == [int](TypeKind.DictType))
        {
            If (target == "Count")
                Return New LlvmValue(This.CallRuntime("__kn_dict_count", This.Types1(receiver.Handle),
                    This.Unique("dict_count")), This.Semantics.Primitive("int"));
            If (target == "Fetch")
            {
                LlvmValue key = This.CastValue(This.EmitExpression(context, first),
                    This.Semantics.Primitive("string"));
                byte* tagSlot = This.Module.Alloca(This.Module.IntType(64), This.Unique("dict_tag_slot"));
                byte* payloadSlot = This.Module.Alloca(This.Module.IntType(64), This.Unique("dict_payload_slot"));
                This.CallRuntime("__kn_dict_get",
                    This.Types4(receiver.Handle, key.Handle, tagSlot, payloadSlot), "");
                byte* boxed = This.Module.ConstUndef(This.AnyType);
                boxed = This.Module.InsertValue(boxed,
                    This.Module.Load(This.Module.IntType(64), tagSlot, This.Unique("dict_tag")), 0, "");
                boxed = This.Module.InsertValue(boxed,
                    This.Module.Load(This.Module.IntType(64), payloadSlot, This.Unique("dict_payload")), 1, "");
                Return New LlvmValue(boxed, This.Semantics.Primitive("any"));
            }
            If (target == "Contains")
            {
                LlvmValue key = This.CastValue(This.EmitExpression(context, first),
                    This.Semantics.Primitive("string"));
                Return New LlvmValue(This.RuntimeBool(This.CallRuntime("__kn_dict_contains",
                    This.Types2(receiver.Handle, key.Handle), This.Unique("dict_contains_c"))),
                    This.Semantics.Primitive("bool"));
            }
            If (target == "IsEmpty")
                Return New LlvmValue(This.RuntimeBool(This.CallRuntime("__kn_dict_is_empty",
                    This.Types1(receiver.Handle), This.Unique("dict_empty_c"))),
                    This.Semantics.Primitive("bool"));
        }

        If (receiver != null && receiver.Type.Kind == [int](TypeKind.StringType))
        {
            If (target == "Length")
                Return New LlvmValue(This.CallRuntime("kn_sh_rt_string_length", This.Types1(receiver.Handle),
                    This.Unique("string_length")), This.Semantics.Primitive("int"));
            If (target == "ToChars")
            {
                byte* lengthSlot = This.Module.Alloca(This.Module.IntType(64), This.Unique("chars_length_slot"));
                byte* data = This.CallRuntime("__kn_string_to_chars",
                    This.Types2(receiver.Handle, lengthSlot), This.Unique("chars_data"));
                TypeSymbol resultType = expression.Type;
                byte* array = This.Module.ConstUndef(This.TypeHandle(resultType));
                array = This.Module.InsertValue(array, data, 0, "");
                array = This.Module.InsertValue(array,
                    This.Module.Load(This.Module.IntType(64), lengthSlot, This.Unique("chars_length")), 1, "");
                Return New LlvmValue(array, resultType);
            }
        }
        If (receiver != null && receiver.Type.Kind == [int](TypeKind.ArrayType))
        {
            If (target == "Length")
                Return New LlvmValue(This.Module.ExtractValue(receiver.Handle, 1, This.Unique("array_length")),
                    This.Semantics.Primitive("int"));
            If (target == "Index")
            {
                LlvmValue index = This.CastValue(This.EmitExpression(context, first),
                    This.Semantics.Primitive("int"));
                byte* data = This.Module.ExtractValue(receiver.Handle, 0, This.Unique("array_data"));
                byte* address = This.Module.Gep(This.TypeHandle(receiver.Type.ElementType), data,
                    This.Types1(index.Handle), true, This.Unique("array_index"));
                Return New LlvmValue(This.Module.Load(This.TypeHandle(receiver.Type.ElementType), address,
                    This.Unique("array_value")), receiver.Type.ElementType);
            }
            If (target == "Add") Return This.EmitArrayAdd(context, receiver, first);

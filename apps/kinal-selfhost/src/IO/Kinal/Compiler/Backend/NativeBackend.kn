        cached.Next = This.FirstDelegateAdapter;
        This.FirstDelegateAdapter = cached;

        byte* savedBlock = This.Module.CurrentBlock();
        byte* entry = This.Module.AppendBlock(adapter, "entry");
        This.Module.PositionAtEnd(entry);
        LlvmHandles arguments = New LlvmHandles();
        ParameterSymbol delegateParameter = delegate.FirstParameter;
        ParameterSymbol targetParameter = target.FirstParameter;
        int index = 0;
        While (delegateParameter != null && targetParameter != null)
        {
            LlvmValue value = delegateBinding.UsesCAbi ?
                This.FromCAbi(This.Module.Parameter(adapter, index), delegateParameter.Type) :
                New LlvmValue(This.Module.Parameter(adapter, index), delegateParameter.Type);
            arguments.Add(This.CastValue(value, targetParameter.Type).Handle);
            delegateParameter = delegateParameter.Next;
            targetParameter = targetParameter.Next;
            index = index + 1;
        }
        string resultName = target.ReturnType.Kind == [int](TypeKind.VoidType) ? "" : "result";
        byte* result = This.Module.Call(targetBinding.FunctionType, targetBinding.Function,
            arguments, resultName);
        If (delegate.ReturnType.Kind == [int](TypeKind.VoidType)) This.Module.ReturnVoid();
        Else
        {

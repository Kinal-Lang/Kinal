        byte* conditionBlock = This.Module.AppendBlock(context.Binding.Function,
            This.Unique("package_array_condition"));
        byte* bodyBlock = This.Module.AppendBlock(context.Binding.Function,
            This.Unique("package_array_body"));
        byte* doneBlock = This.Module.AppendBlock(context.Binding.Function,
            This.Unique("package_array_done"));
        This.Module.Branch(conditionBlock);
        This.Module.PositionAtEnd(conditionBlock);
        byte* index = This.Module.Load(This.Module.IntType(64), indexAddress,
            This.Unique("package_array_i"));
        byte* more = This.Module.Compare([int](LlvmIntPredicate.UnsignedLess), index, length,
            This.Unique("package_array_more"));
        This.Module.ConditionalBranch(more, bodyBlock, doneBlock);
        This.Module.PositionAtEnd(bodyBlock);
        byte* sourceAddress = This.Module.Gep(This.AnyType, sourceData, This.Types1(index), true,
            This.Unique("package_array_source"));

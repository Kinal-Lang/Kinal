    Public Safe Function string BuiltinMetaParameterName(string attributeName, int index)
    {
        If (index != 0) Return [string](index);
        string name = This.Semantics.AttributeShortName(attributeName);
        If (name == "Docs") Return "text";
        If (name == "Deprecated" || name == "Experimental") Return "message";
        If (name == "Since") Return "version";
        If (name == "Example") Return "code";
        If (name == "VmBuiltin") Return "id";
        Return [string](index);
    }

    Public Trusted Function void EmitMetaArgument(byte* dictionary, string name,
                                                   SyntaxTree syntax,
                                                   ExpressionNode argument)
    {
        If (argument == null) Return;
        If (argument.Kind == [int](ExpressionKind.String))
        {
            This.EmitMetaDictString(dictionary, "arg." + name,
                This.DecodeString(argument.Text));
            Return;
        }
        ConstantIntegerValue constant = This.Semantics.ConstantInteger(
            syntax, null, argument);
        int value = constant.IsValid ? [int](constant.Value) : 0;
        If (!constant.IsValid)
        {
            string path = This.Semantics.ExpressionPath(argument);
            TypeSymbol enumType = This.Semantics.FindEnumMemberType(path);
            If (enumType != null) value = This.EnumValue(enumType, path);
        }
        This.EmitMetaDictInteger(dictionary, "arg." + name, value);
    }

    Public Trusted Function void EmitMetaAttributeArguments(byte* dictionary,
                                                             SyntaxTree syntax,
                                                             SyntaxAttribute attribute)
    {
        MetaDecl meta = This.Semantics.FindMeta(syntax, attribute.Name);
        int count = 0;
        ExpressionNode argument = attribute.FirstArgument;
        If (meta != null)
        {
            ParameterDecl parameter = meta.FirstParameter;
            While (parameter != null)
            {
                ExpressionNode value = argument == null ? parameter.DefaultValue : argument;
                This.EmitMetaArgument(dictionary, parameter.Name, syntax, value);
                If (argument != null) argument = argument.Next;
                count = count + 1;
                parameter = parameter.Next;
            }
        }
        Else
        {
            While (argument != null)
            {
                This.EmitMetaArgument(dictionary,
                    This.BuiltinMetaParameterName(attribute.Name, count), syntax, argument);
                count = count + 1;
                argument = argument.Next;
            }
        }
        This.EmitMetaDictInteger(dictionary, "arg_count", count);
    }

    Public Trusted Function LlvmValue EmitMetaFind(LlvmFunctionContext context, HirExpression expression)
    {
        HirExpression first = expression.FirstArgument;

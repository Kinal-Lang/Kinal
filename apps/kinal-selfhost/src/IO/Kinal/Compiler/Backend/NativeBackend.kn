            This.Semantics.Primitive("string"));
        byte* resultAddress = This.Module.Alloca(This.Module.PointerType(This.Module.IntType(8)),
            This.Unique("meta_result"));
        This.Module.Store(This.Module.ConstNull(This.Module.PointerType(This.Module.IntType(8))), resultAddress);
        byte* doneBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("meta_find_done"));

        FunctionSymbol symbol = This.Semantics.FirstFunction;
        While (symbol != null)
        {
            SyntaxAttribute attribute = symbol.Declaration.FirstAttribute;
            While (attribute != null)
            {
                string resolvedName = This.ResolvedAttributeName(symbol.Syntax, attribute);
                byte* ownerMatches = This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                    This.Types2(ownerName.Handle,
                        This.Module.GlobalString(symbol.QualifiedName(), This.Unique("meta_owner"))),
                    This.Unique("meta_owner_match_c")));
                byte* qualifiedMetaMatches = This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                    This.Types2(metaName.Handle,
                        This.Module.GlobalString(resolvedName, This.Unique("meta_name"))),
                    This.Unique("meta_qualified_name_match_c")));
                byte* shortMetaMatches = This.RuntimeBool(This.CallRuntime("kn_sh_rt_string_equal",
                    This.Types2(metaName.Handle,
                        This.Module.GlobalString(This.Semantics.AttributeShortName(resolvedName),
                            This.Unique("meta_short_name"))),
                    This.Unique("meta_short_name_match_c")));
                byte* metaMatches = This.Module.Or(qualifiedMetaMatches, shortMetaMatches,
                    This.Unique("meta_name_match"));
                byte* matches = This.Module.And(ownerMatches, metaMatches, This.Unique("meta_match"));
                byte* matchBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("meta_find_match"));
                byte* nextBlock = This.Module.AppendBlock(context.Binding.Function, This.Unique("meta_find_next"));
                This.Module.ConditionalBranch(matches, matchBlock, nextBlock);
                This.Module.PositionAtEnd(matchBlock);

                byte* dictionary = This.CallRuntime("__kn_dict_new", This.Types0(), This.Unique("meta_dictionary"));
                This.Module.Store(dictionary, resultAddress);
                This.EmitMetaDictString(dictionary, "owner", symbol.QualifiedName());
                This.EmitMetaDictInteger(dictionary, "owner_kind", 1);
                This.EmitMetaDictInteger(dictionary, "owner_param_count", symbol.ParameterCount());
                LlvmFunctionBinding functionBinding = This.FindFunctionBinding(symbol);
                byte* ownerPointer = null;
                If (This.Semantics.AttributeShortName(attribute.Name) == "__Dispatcher" &&
                    functionBinding != null)
                    ownerPointer = functionBinding.Function;
                Else
                {
                    byte* wrapper = This.EnsureCallableWrapper(functionBinding);
                    ownerPointer = This.CreateCallableObject(false, wrapper, null);
                }
                This.CallRuntime("__kn_dict_set", This.Types4(dictionary,
                    This.Module.GlobalString("owner_ptr", This.Unique("meta_key")),
                    This.Module.ConstInt(This.Module.IntType(64), 6),
                    This.Module.PointerToInt(ownerPointer, This.Module.IntType(64),
                        This.Unique("meta_owner_pointer"))), "");
                This.EmitMetaDictString(dictionary, "module", symbol.UnitName);
                This.EmitMetaDictString(dictionary, "meta", resolvedName);
                This.EmitMetaDictString(dictionary, "name",
                    This.Semantics.AttributeShortName(resolvedName));
                This.EmitMetaAttributeArguments(dictionary, symbol.Syntax, attribute);
                This.Module.Branch(doneBlock);

                This.Module.PositionAtEnd(nextBlock);
                attribute = attribute.Next;

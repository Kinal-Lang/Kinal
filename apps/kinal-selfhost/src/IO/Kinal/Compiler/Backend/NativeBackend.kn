Unit IO.Kinal.Compiler.Backend.NativeBackend;

Get IO.File;
Get IO.Path;
Get IO.Text;
Get IO.Kinal.Compiler.Lex.TokenKind;
Get IO.Kinal.Compiler.Syntax.Nodes;
Get IO.Kinal.Compiler.Syntax.SyntaxTree;
Get IO.Kinal.Compiler.Types.TypeSymbol;
Get IO.Kinal.Compiler.Sema.Symbols;
Get IO.Kinal.Compiler.Sema.SemanticCompilation;
Get IO.Kinal.Compiler.Hir.HirModel;
Get IO.Kinal.Compiler.Backend.LlvmBridge;
Get IO.Kinal.Compiler.Backend.LlvmModel;

Class NativeBackend
{
    Public SemanticCompilation Semantics;
    Public LlvmModule Module;
    Public LlvmTypeBinding FirstType;
    Public LlvmGlobalBinding FirstGlobal;
    Public LlvmDelegateBinding FirstDelegate;
    Public LlvmDelegateAdapter FirstDelegateAdapter;
    Public LlvmFunctionBinding FirstFunction;
    Public LlvmRuntimeFunction FirstRuntime;
    Public byte* AnyType;
    Public string Error;
    Private int NameSequence;

    Public Trusted Constructor(SemanticCompilation semantics)
    {
        This.Semantics = semantics;
        This.Module = New LlvmModule("kinal.selfhost.output");
        This.FirstType = null;
        This.FirstGlobal = null;
        This.FirstDelegate = null;
        This.FirstDelegateAdapter = null;
        This.FirstFunction = null;
        This.FirstRuntime = null;
        This.AnyType = null;
        This.Error = "";
        This.NameSequence = 0;
    }

    Public Safe Function string Unique(string prefix)
    {
        This.NameSequence = This.NameSequence + 1;
        Return prefix + [string](This.NameSequence);
    }

    Public Safe Function bool Failed()
    {
        Return !IO.Text.IsEmpty(This.Error);
    }

    Public Safe Function void Fail(string message)
    {
        If (IO.Text.IsEmpty(This.Error)) This.Error = message;
    }

    Public Safe Function string Unquote(string raw)
    {
        int length = IO.Text.Length(raw);
        If (length >= 2 && IO.Text.StartsWith(raw, "\"") && IO.Text.EndsWith(raw, "\""))
            Return IO.Text.Slice(raw, 1, length - 2);
        Return raw;
    }

    Public Safe Function string DecodeString(string raw)
    {
        string body = This.Unquote(raw);
        char[] chars = body.ToChars();
        string result = "";
        int i = 0;
        While (i < chars.Length())
        {
            int value = [int](chars[i]);
            If (value == 92 && i + 1 < chars.Length())
            {
                i = i + 1;
                int escaped = [int](chars[i]);
                If (escaped == 110) value = 10;
                ElseIf (escaped == 114) value = 13;
                ElseIf (escaped == 116) value = 9;
                ElseIf (escaped == 98) value = 8;
                ElseIf (escaped == 48) value = 0;
                Else value = escaped;
            }
            result = result + [string]([char](value));
            i = i + 1;
        }
        Return result;
    }

    Public Safe Function int DecodeCharacter(string raw)
    {
        int length = IO.Text.Length(raw);
        string body = length >= 2 && IO.Text.StartsWith(raw, "'") && IO.Text.EndsWith(raw, "'") ?
            IO.Text.Slice(raw, 1, length - 2) : raw;
        string value = This.DecodeString(body);
        char[] chars = value.ToChars();
        Return chars.Length() == 0 ? 0 : [int](chars[0]);
    }

    Public Safe Function string LanguageVersion()
    {
        string directory = IO.Path.Directory(
            IO.Kinal.Compiler.Backend.LlvmBridge.ExecutablePath());
        int level = 0;
        While (level < 3)
        {
            directory = IO.Path.Directory(directory);
            level = level + 1;
        }
        string contents = IO.File.ReadAllText(IO.Path.Combine(directory, "VERSION"));
        If (contents == null || !IO.Text.StartsWith(contents, "kinal=")) Return "unknown";
        int end = IO.Text.IndexOf(contents, "\n");
        If (end < 0) end = IO.Text.Length(contents);
        Return IO.Text.Trim(IO.Text.Slice(contents, 6, end - 6));
    }

    Public Safe Function string ExpandFormattedString(string raw)
    {
        string decoded = This.DecodeString(raw);
        Return IO.Text.Replace(decoded, "{IO.Version}", This.LanguageVersion());
    }

    Public Safe Function string Sanitize(string name)
    {
        char[] chars = name.ToChars();
        string result = "";
        int i = 0;
        While (i < chars.Length())
        {
            int value = [int](chars[i]);
            bool valid = (value >= 48 && value <= 57) ||
                (value >= 65 && value <= 90) || (value >= 97 && value <= 122);
            result = result + (valid ? [string](chars[i]) : "_");
            i = i + 1;
        }
        Return result;
    }

    Public Safe Function string AttributeString(FunctionDecl function, string name)
    {
        SyntaxAttribute attribute = function.FirstAttribute;
        While (attribute != null)
        {
            If (attribute.Name == name && attribute.FirstArgument != null)
                Return This.Unquote(attribute.FirstArgument.Text);
            attribute = attribute.Next;
        }
        Return "";
    }

    Public Safe Function bool IsEnum(TypeSymbol type)
    {
        Return type != null && type.Declaration != null &&
            type.Declaration.Kind == [int](TokenKind.KwEnum);
    }

    Public Safe Function bool IsReferenceType(TypeSymbol type)
    {
        If (type == null) Return false;
        Return type.Kind == [int](TypeKind.StringType) ||
            type.Kind == [int](TypeKind.ListType) ||
            type.Kind == [int](TypeKind.DictType) ||
            type.Kind == [int](TypeKind.SetType) ||
            type.Kind == [int](TypeKind.PointerType) ||
            (type.Kind == [int](TypeKind.NamedType) && !This.IsEnum(type));
    }

    Public Safe Function bool NeedsGcRoot(TypeSymbol type)
    {
        Return This.IsReferenceType(type) || type.Kind == [int](TypeKind.ArrayType) ||
            type.Kind == [int](TypeKind.AnyType);
    }

    Public Safe Function int IntegerBits(TypeSymbol type)
    {
        If (type == null) Return 64;
        If (type.Name == "byte" || type.Name == "char" || type.Name == "i8" || type.Name == "u8") Return 8;
        If (type.Name == "i16" || type.Name == "u16") Return 16;
        If (type.Name == "i32" || type.Name == "u32") Return 32;
        Return 64;
    }

    Public Safe Function bool IsUnsignedInteger(TypeSymbol type)
    {
        If (type == null) Return false;
        Return type.Name == "byte" || type.Name == "char" || type.Name == "u8" ||
            type.Name == "u16" || type.Name == "u32" || type.Name == "u64" ||
            type.Name == "usize";
    }

    Public Safe Function void AddTypeBinding(LlvmTypeBinding binding)
    {
        binding.Next = This.FirstType;
        This.FirstType = binding;
    }

    Public Safe Function LlvmTypeBinding FindTypeBinding(TypeSymbol symbol)
    {
        LlvmTypeBinding current = This.FirstType;
        While (current != null)
        {
            If (current.Symbol == symbol) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Trusted Function byte* TypeHandle(TypeSymbol type)
    {
        If (type == null) Return This.Module.IntType(64);
        If (type.Kind == [int](TypeKind.VoidType)) Return This.Module.VoidType();
        If (type.Kind == [int](TypeKind.BoolType)) Return This.Module.IntType(1);
        If (type.Kind == [int](TypeKind.IntegerType)) Return This.Module.IntType(This.IntegerBits(type));
        If (type.Kind == [int](TypeKind.FloatType))
        {
            If (type.Name == "f16") Return This.Module.FloatType(16);
            If (type.Name == "f32") Return This.Module.FloatType(32);
            If (type.Name == "f128") Return This.Module.FloatType(128);
            Return This.Module.FloatType(64);
        }
        If (type.Kind == [int](TypeKind.AnyType)) Return This.AnyType;
        If (type.Kind == [int](TypeKind.ArrayType))
        {
            LlvmHandles fields = New LlvmHandles();
            fields.Add(This.Module.PointerType(This.TypeHandle(type.ElementType)));
            fields.Add(This.Module.IntType(64));
            Return This.Module.LiteralStructType(fields, false);
        }
        If (type.Kind == [int](TypeKind.NamedType) && This.IsEnum(type)) Return This.Module.IntType(64);
        If (type.Kind == [int](TypeKind.NullType)) Return This.Module.PointerType(This.Module.IntType(8));
        If (This.IsReferenceType(type))
        {
            LlvmTypeBinding binding = This.FindTypeBinding(type);
            If (binding != null) Return binding.Handle;
            Return This.Module.PointerType(This.Module.IntType(8));
        }
        Return This.Module.IntType(64);
    }

    Public Trusted Function byte* AbiTypeHandle(TypeSymbol type)
    {
        If (type != null && (type.Name == "int" || type.Name == "bool"))
            Return This.Module.IntType(32);
        Return This.TypeHandle(type);
    }

    Public Trusted Function void PrepareTypes()
    {
        LlvmHandles anyFields = New LlvmHandles();
        anyFields.Add(This.Module.IntType(64));
        anyFields.Add(This.Module.IntType(64));
        This.AnyType = This.Module.LiteralStructType(anyFields, false);

        TypeSymbol type = This.Semantics.FirstType;
        While (type != null)
        {
            If (type.Kind == [int](TypeKind.NamedType) && !This.IsEnum(type))
            {
                byte* structType = This.Module.NamedStructType(type.QualifiedName());
                This.AddTypeBinding(New LlvmTypeBinding(type,
                    This.Module.PointerType(structType), structType));
            }
            type = type.Next;
        }

        LlvmTypeBinding binding = This.FirstType;
        While (binding != null)
        {
            If (binding.Symbol.Declaration == null)
            {
                binding = binding.Next;
                Continue;
            }
            LlvmHandles fields = New LlvmHandles();
            byte* bytePointer = This.Module.PointerType(This.Module.IntType(8));
            fields.Add(This.Module.PointerType(bytePointer));
            FieldDecl field = binding.Symbol.Declaration.FirstField;
            While (field != null)
            {
                If (!field.IsStatic)
                {
                    TypeSymbol fieldType = This.Semantics.ResolveType(
                        This.Semantics.FindUnit(binding.Symbol.UnitName).Syntax, field.TypeName);
                    fields.Add(This.TypeHandle(fieldType));
                }
                field = field.Next;
            }
            If (!This.Module.SetStructBody(binding.StructHandle, fields, false))
                This.Fail("failed to define class layout: " + binding.Symbol.QualifiedName());
            binding = binding.Next;
        }
    }

    Public Safe Function void AddFunctionBinding(LlvmFunctionBinding binding)
    {
        binding.Next = This.FirstFunction;
        This.FirstFunction = binding;
    }

    Public Safe Function void AddGlobalBinding(LlvmGlobalBinding binding)
    {
        binding.Next = This.FirstGlobal;
        This.FirstGlobal = binding;
    }

    Public Safe Function LlvmGlobalBinding FindGlobalBinding(ValueSymbol symbol)
    {
        LlvmGlobalBinding current = This.FirstGlobal;
        While (current != null)
        {
            If (current.Symbol.Value == symbol) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function void AddDelegateBinding(LlvmDelegateBinding binding)
    {
        binding.Next = This.FirstDelegate;
        This.FirstDelegate = binding;
    }

    Public Safe Function LlvmDelegateBinding FindDelegateBinding(FunctionSymbol symbol)
    {
        LlvmDelegateBinding current = This.FirstDelegate;
        While (current != null)
        {
            If (current.Symbol == symbol) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Trusted Function byte* ConstantGlobalInitializer(GlobalSymbol symbol)
    {
        ExpressionNode expression = symbol.Declaration.Initializer;
        byte* type = This.TypeHandle(symbol.Value.Type);
        If (expression == null || expression.Kind == [int](ExpressionKind.Null))
            Return This.Module.ConstNull(type);
        If (expression.Kind == [int](ExpressionKind.Number))
        {
            If (symbol.Value.Type.Kind == [int](TypeKind.FloatType))
                Return This.Module.ConstFloat(type, [float](expression.Text));
            Return This.Module.ConstI64(type, [i64]([int](expression.Text)), false);
        }
        If (expression.Kind == [int](ExpressionKind.Boolean))
            Return This.Module.ConstInt(type,
                expression.Text == "true" || expression.Text == "True" ? 1 : 0);
        If (expression.Kind == [int](ExpressionKind.Character))
            Return This.Module.ConstInt(type, This.DecodeCharacter(expression.Text));
        If (expression.Kind == [int](ExpressionKind.String) ||
            expression.Kind == [int](ExpressionKind.FormattedString))
            Return This.Module.GlobalString(
                expression.IsRawString ? This.Unquote(expression.Text) :
                expression.Kind == [int](ExpressionKind.FormattedString) ?
                    This.ExpandFormattedString(expression.Text) : This.DecodeString(expression.Text),
                This.Unique("global_text"));
        If (expression.Kind == [int](ExpressionKind.Unary) &&
            expression.Operator == [int](TokenKind.Minus) && expression.Left != null &&
            expression.Left.Kind == [int](ExpressionKind.Number))
        {
            If (symbol.Value.Type.Kind == [int](TypeKind.FloatType))
                Return This.Module.ConstFloat(type, -[float](expression.Left.Text));
            Return This.Module.ConstI64(type, -[i64]([int](expression.Left.Text)), true);
        }
        If (expression.Kind == [int](ExpressionKind.FunctionLiteral) ||
            expression.Kind == [int](ExpressionKind.BlockLiteral))
        {
            LlvmFunctionBinding function = This.FindFunctionBinding(symbol.Value.CallableFunction);
            If (function != null) Return This.EnsureCallableWrapper(function);
        }
        If (expression.Kind == [int](ExpressionKind.Name)) Return This.Module.ConstNull(type);
        Return null;
    }

    Public Trusted Function void DeclareGlobals()
    {
        GlobalSymbol symbol = This.Semantics.FirstGlobal;
        While (symbol != null)
        {
            byte* type = This.TypeHandle(symbol.Value.Type);
            byte* address = This.Module.AddGlobal(type,
                "__kn_sh_global_" + This.Sanitize(symbol.QualifiedName()));
            byte* initializer = This.ConstantGlobalInitializer(symbol);
            If (initializer == null)
                This.Fail("unsupported global initializer: " + symbol.QualifiedName());
            ElseIf (address == null || !This.Module.SetInitializer(address, initializer))
                This.Fail("failed to declare global: " + symbol.QualifiedName());
            Else This.AddGlobalBinding(New LlvmGlobalBinding(symbol, address));
            symbol = symbol.Next;
        }
    }

    Public Safe Function int FixedGlobalArrayLength(GlobalSymbol symbol)
    {
        string typeName = symbol.Declaration.TypeName;
        int open = IO.Text.IndexOf(typeName, "[");
        int close = IO.Text.IndexOf(typeName, "]");
        If (open < 0 || close <= open + 1) Return -1;
        string lengthText = IO.Text.Replace(
            IO.Text.Slice(typeName, open + 1, close - open - 1), " ", "");
        char[] chars = lengthText.ToChars();
        bool numeric = chars.Length() > 0;
        int index = 0;
        While (index < chars.Length())
        {
            int value = [int](chars[index]);
            If (value < 48 || value > 57) numeric = false;
            index = index + 1;
        }
        If (numeric) Return [int](lengthText);
        GlobalSymbol constant = This.Semantics.FindGlobal(symbol.UnitName, lengthText);
        If (constant != null && constant.Declaration.IsConst &&
            constant.Declaration.Initializer != null &&
            constant.Declaration.Initializer.Kind == [int](ExpressionKind.Number))
            Return [int](constant.Declaration.Initializer.Text);
        Return -1;
    }

    Public Trusted Function void InitializeFixedGlobalArrays()
    {
        LlvmGlobalBinding binding = This.FirstGlobal;
        While (binding != null)
        {
            TypeSymbol arrayType = binding.Symbol.Value.Type;
            int lengthValue = This.FixedGlobalArrayLength(binding.Symbol);
            If (arrayType.Kind == [int](TypeKind.ArrayType) && lengthValue >= 0)
            {
                TypeSymbol elementType = arrayType.ElementType;
                byte* elementHandle = This.TypeHandle(elementType);
                byte* length = This.Module.ConstInt(This.Module.IntType(64), lengthValue);
                byte* bytes = This.Module.Multiply(length, This.Module.SizeOf(elementHandle),
                    This.Unique("global_array_bytes"));
                byte* memory = This.CallRuntime("__kn_gc_alloc", This.Types1(bytes),
                    This.Unique("global_array_memory"));
                This.CallRuntime("kn_sh_rt_memory_zero", This.Types2(memory, bytes), "");
                byte* data = This.Module.BitCast(memory, This.Module.PointerType(elementHandle),
                    This.Unique("global_array_data"));
                byte* value = This.Module.ConstUndef(This.TypeHandle(arrayType));
                value = This.Module.InsertValue(value, data, 0, "");
                value = This.Module.InsertValue(value, length, 1, "");
                This.Module.Store(value, binding.Address);
            }
            binding = binding.Next;
        }
    }

    Public Trusted Function void InitializeGlobalCopies()
    {
        LlvmGlobalBinding destination = This.FirstGlobal;
        While (destination != null)
        {
            ExpressionNode initializer = destination.Symbol.Declaration.Initializer;
            If (initializer != null && initializer.Kind == [int](ExpressionKind.Name))
            {
                GlobalSymbol sourceSymbol = This.Semantics.FindGlobal(
                    destination.Symbol.UnitName, initializer.Text);
                LlvmGlobalBinding source = sourceSymbol == null ?
                    null : This.FindGlobalBinding(sourceSymbol.Value);
                If (source != null)
                {
                    byte* value = This.Module.Load(This.TypeHandle(source.Symbol.Value.Type),
                        source.Address, This.Unique("global_copy"));
                    This.Module.Store(value, destination.Address);
                }
            }
            destination = destination.Next;
        }
    }

    Public Safe Function LlvmFunctionBinding FindFunctionBinding(FunctionSymbol symbol)
    {
        LlvmFunctionBinding current = This.FirstFunction;
        While (current != null)
        {
            If (current.Symbol == symbol) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function LlvmFunctionBinding FindFunctionByTarget(string target, int parameterCount)
    {
        LlvmFunctionBinding current = This.FirstFunction;
        While (current != null)
        {
            If (current.Symbol.QualifiedName() == target &&
                current.Symbol.ParameterCount() == parameterCount) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function string FunctionName(FunctionSymbol symbol)
    {
        If (symbol.Declaration.IsExtern)
        {
            string linked = This.AttributeString(symbol.Declaration, "LinkName");
            Return IO.Text.IsEmpty(linked) ? symbol.Name : linked;
        }
        Return "__kn_sh_" + This.Sanitize(symbol.QualifiedName()) + "_" +
            [string](symbol.ParameterCount());
    }

    Public Trusted Function void DeclareFunctions()
    {
        FunctionSymbol symbol = This.Semantics.FirstFunction;
        While (symbol != null)
        {
            If (symbol.IsGenericTemplate())
            {
                symbol = symbol.Next;
                Continue;
            }
            bool cAbi = symbol.Declaration.IsExtern ||
                (symbol.Declaration.IsDelegate && symbol.Declaration.Abi == "C");
            LlvmHandles parameters = New LlvmHandles();
            bool hasReceiver = symbol.OwnerType != null &&
                (!symbol.Declaration.IsStatic || symbol.Declaration.IsConstructor);
            If (hasReceiver) parameters.Add(This.TypeHandle(symbol.OwnerType));
            ParameterSymbol parameter = symbol.FirstParameter;
            While (parameter != null)
            {
                parameters.Add(cAbi ? This.AbiTypeHandle(parameter.Type) : This.TypeHandle(parameter.Type));
                parameter = parameter.Next;
            }
            byte* returnType = cAbi ? This.AbiTypeHandle(symbol.ReturnType) : This.TypeHandle(symbol.ReturnType);
            byte* functionType = This.Module.FunctionType(returnType, parameters, false);
            If (symbol.Declaration.IsDelegate)
            {
                byte* pointerType = This.Module.PointerType(functionType);
                byte* address = This.Module.AddGlobal(pointerType,
                    "__kn_sh_delegate_" + This.Sanitize(symbol.QualifiedName()));
                If (address == null || !This.Module.SetInitializer(address,
                    This.Module.ConstNull(pointerType)))
                    This.Fail("failed to declare delegate: " + symbol.QualifiedName());
                Else This.AddDelegateBinding(New LlvmDelegateBinding(
                    symbol, functionType, address, cAbi));
                symbol = symbol.Next;
                Continue;
            }
            byte* function = This.Module.AddFunction(This.FunctionName(symbol), functionType);
            If (function == null) This.Fail("failed to declare function: " + symbol.QualifiedName());
            This.AddFunctionBinding(New LlvmFunctionBinding(symbol, functionType, function, cAbi));
            symbol = symbol.Next;
        }
    }

    Public Safe Function void AddRuntime(LlvmRuntimeFunction runtime)
    {
        runtime.Next = This.FirstRuntime;
        This.FirstRuntime = runtime;
    }

    Public Safe Function LlvmRuntimeFunction Runtime(string name)
    {
        LlvmRuntimeFunction current = This.FirstRuntime;
        While (current != null)
        {
            If (current.Name == name) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Trusted Function void DeclareRuntimeFunction(string name, byte* returnType, LlvmHandles parameters)
    {
        byte* functionType = This.Module.FunctionType(returnType, parameters, false);
        This.AddRuntime(New LlvmRuntimeFunction(name, functionType,
            This.Module.AddFunction(name, functionType)));
    }

    Public Trusted Function LlvmHandles Types0()
    {
        Return New LlvmHandles();
    }

    Public Trusted Function LlvmHandles Types1(byte* a)
    {
        LlvmHandles values = New LlvmHandles(); values.Add(a); Return values;
    }

    Public Trusted Function LlvmHandles Types2(byte* a, byte* b)
    {
        LlvmHandles values = New LlvmHandles(); values.Add(a); values.Add(b); Return values;
    }

    Public Trusted Function LlvmHandles Types3(byte* a, byte* b, byte* c)
    {
        LlvmHandles values = New LlvmHandles(); values.Add(a); values.Add(b); values.Add(c); Return values;
    }

    Public Trusted Function LlvmHandles Types4(byte* a, byte* b, byte* c, byte* d)
    {
        LlvmHandles values = New LlvmHandles(); values.Add(a); values.Add(b); values.Add(c); values.Add(d); Return values;
    }

    Public Trusted Function void DeclareRuntime()
    {
        byte* voidType = This.Module.VoidType();
        byte* int8Type = This.Module.IntType(8);
        byte* int32Type = This.Module.IntType(32);
        byte* int64Type = This.Module.IntType(64);
        byte* pointer = This.Module.PointerType(int8Type);
        byte* pointerPointer = This.Module.PointerType(pointer);
        byte* int64Pointer = This.Module.PointerType(int64Type);

        This.DeclareRuntimeFunction("__kn_gc_init", voidType, This.Types0());
        This.DeclareRuntimeFunction("__kn_gc_alloc", pointer, This.Types1(int64Type));
        This.DeclareRuntimeFunction("__kn_gc_push_frame", pointer, This.Types0());
        This.DeclareRuntimeFunction("__kn_gc_add_root", voidType, This.Types3(pointer, pointer, int64Type));
        This.DeclareRuntimeFunction("__kn_gc_pop_frame", voidType, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_sys_args_from_argv", voidType,
            This.Types4(int32Type, pointerPointer, This.Module.PointerType(pointerPointer), int64Pointer));

        This.DeclareRuntimeFunction("kn_sh_rt_print", voidType, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_print_line", voidType, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_read_line", pointer, This.Types0());
        This.DeclareRuntimeFunction("kn_sh_rt_memory_copy", voidType,
            This.Types3(pointer, pointer, int64Type));
        This.DeclareRuntimeFunction("kn_sh_rt_memory_zero", voidType, This.Types2(pointer, int64Type));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_read8", int8Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_read16", This.Module.IntType(16), This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_read32", int32Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_read64", int64Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_write8", voidType, This.Types2(pointer, int8Type));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_write16", voidType,
            This.Types2(pointer, This.Module.IntType(16)));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_write32", voidType, This.Types2(pointer, int32Type));
        This.DeclareRuntimeFunction("kn_sh_rt_volatile_write64", voidType, This.Types2(pointer, int64Type));
        This.DeclareRuntimeFunction("kn_sh_rt_string_length", int64Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_string_equal", int32Type, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_string_concat", pointer, This.Types2(pointer, pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_i64_to_string", pointer, This.Types1(int64Type));
        This.DeclareRuntimeFunction("kn_sh_rt_char_to_string", pointer, This.Types1(int8Type));
        This.DeclareRuntimeFunction("kn_sh_rt_string_to_i64", int64Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_string_to_f32", This.Module.FloatType(32), This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_string_to_f64", This.Module.FloatType(64), This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_string_to_bool", int32Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("kn_sh_rt_string_to_char", int8Type, This.Types1(pointer));
        This.DeclareRuntimeFunction("__kn_time_tick", int64Type, This.Types0());
        This.DeclareRuntimeFunction("__kn_time_nano", int64Type, This.Types0());
        This.DeclareRuntimeFunction("__kn_time_sleep", voidType, This.Types1(int32Type));

        This.DeclareRuntimeFunction("__kn_list_new", pointer, This.Types0());
        This.DeclareRuntimeFunction("__kn_list_add", voidType, This.Types3(pointer, int64Type, int64Type));
        This.DeclareRuntimeFunction("__kn_list_get", voidType, This.Types4(pointer, int64Type, int64Pointer, int64Pointer));
        This.DeclareRuntimeFunction("__kn_list_count", int64Type, This.Types1(pointer));

Unit IO.Kinal.Compiler.Backend.FreestandingRuntime;

// Target-independent LLVM IR for the freestanding core. These routines use
// neither libc nor the hosted runtime. Runtime=None mirrors stage0's bounded
// eight-slot, 512-byte scratch-string contract, including f64 truncation.
// Optional Alloc/GC operations are declared lazily by NativeBackend and must
// be supplied by the target. They are never silently backed by hosted code.

Safe Function string CoreIR()
{
    string ir = "";
    ir = ir + "define i64 @__kn_strlen(ptr %s) {\n"
        + "entry:\n"
        + "  %null = icmp eq ptr %s, null\n"
        + "  br i1 %null, label %empty, label %loop\n"
        + "loop:\n"
        + "  %i = phi i64 [0, %entry], [%next, %body]\n"
        + "  %p = getelementptr i8, ptr %s, i64 %i\n"
        + "  %c = load i8, ptr %p\n"
        + "  %end = icmp eq i8 %c, 0\n"
        + "  br i1 %end, label %done, label %body\n"
        + "body:\n"
        + "  %next = add i64 %i, 1\n"
        + "  br label %loop\n"
        + "done:\n"
        + "  ret i64 %i\n"
        + "empty:\n";
    ir = ir + "  ret i64 0\n"
        + "}\n"
        + "define i1 @__kn_str_eq(ptr %a, ptr %b) {\n"
        + "entry:\n"
        + "  %same = icmp eq ptr %a, %b\n"
        + "  br i1 %same, label %yes, label %nullcheck\n"
        + "nullcheck:\n"
        + "  %anull = icmp eq ptr %a, null\n"
        + "  %bnull = icmp eq ptr %b, null\n"
        + "  %null = or i1 %anull, %bnull\n"
        + "  br i1 %null, label %no, label %loop\n"
        + "loop:\n"
        + "  %i = phi i64 [0, %nullcheck], [%next, %body]\n"
        + "  %ap = getelementptr i8, ptr %a, i64 %i\n"
        + "  %bp = getelementptr i8, ptr %b, i64 %i\n"
        + "  %ac = load i8, ptr %ap\n";
    ir = ir + "  %bc = load i8, ptr %bp\n"
        + "  %equal = icmp eq i8 %ac, %bc\n"
        + "  br i1 %equal, label %checkend, label %no\n"
        + "checkend:\n"
        + "  %end = icmp eq i8 %ac, 0\n"
        + "  br i1 %end, label %yes, label %body\n"
        + "body:\n"
        + "  %next = add i64 %i, 1\n"
        + "  br label %loop\n"
        + "yes:\n"
        + "  ret i1 true\n"
        + "no:\n"
        + "  ret i1 false\n"
        + "}\n"
        + "define void @__kn_fs_memory_zero(ptr %memory, i64 %length) {\n"
        + "entry:\n";
    ir = ir + "  br label %loop\n"
        + "loop:\n"
        + "  %i = phi i64 [0, %entry], [%next, %body]\n"
        + "  %more = icmp ult i64 %i, %length\n"
        + "  br i1 %more, label %body, label %done\n"
        + "body:\n"
        + "  %p = getelementptr i8, ptr %memory, i64 %i\n"
        + "  store i8 0, ptr %p\n"
        + "  %next = add i64 %i, 1\n"
        + "  br label %loop\n"
        + "done:\n"
        + "  ret void\n"
        + "}\n";
    Return ir;
}

Safe Function string ScratchIR()
{
    string ir = "";
    ir = ir + "@__kn_fs_scratch_ring = private global [8 x [512 x i8]] zeroinitializer\n"
        + "@__kn_fs_scratch_index = private global i64 0\n"
        + "@__kn_fs_true = private constant [5 x i8] c\"true\\00\"\n"
        + "@__kn_fs_false = private constant [6 x i8] c\"false\\00\"\n"
        + "@__kn_fs_any = private constant [6 x i8] c\"<any>\\00\"\n"
        + "define ptr @__kn_fs_scratch_acquire() {\n"
        + "entry:\n"
        + "  %index = load i64, ptr @__kn_fs_scratch_index\n"
        + "  %next = add i64 %index, 1\n"
        + "  %wrapped = and i64 %next, 7\n"
        + "  store i64 %wrapped, ptr @__kn_fs_scratch_index\n"
        + "  %buffer = getelementptr [8 x [512 x i8]], ptr @__kn_fs_scratch_ring, i64 0, i64 %index, i64 0\n"
        + "  ret ptr %buffer\n"
        + "}\n"
        + "define ptr @__kn_str_concat(ptr %a, ptr %b) {\n"
        + "entry:\n";
    ir = ir + "  %alen = call i64 @__kn_strlen(ptr %a)\n"
        + "  %blen = call i64 @__kn_strlen(ptr %b)\n"
        + "  %afits = icmp ule i64 %alen, 511\n"
        + "  %acount = select i1 %afits, i64 %alen, i64 511\n"
        + "  %remaining = sub i64 511, %acount\n"
        + "  %bfits = icmp ule i64 %blen, %remaining\n"
        + "  %bcount = select i1 %bfits, i64 %blen, i64 %remaining\n"
        + "  %buffer = call ptr @__kn_fs_scratch_acquire()\n"
        + "  br label %aloop\n"
        + "aloop:\n"
        + "  %i = phi i64 [0, %entry], [%inext, %abody]\n"
        + "  %amore = icmp ult i64 %i, %acount\n"
        + "  br i1 %amore, label %abody, label %bstart\n"
        + "abody:\n"
        + "  %ap = getelementptr i8, ptr %a, i64 %i\n"
        + "  %ac = load i8, ptr %ap\n";
    ir = ir + "  %adest = getelementptr i8, ptr %buffer, i64 %i\n"
        + "  store i8 %ac, ptr %adest\n"
        + "  %inext = add i64 %i, 1\n"
        + "  br label %aloop\n"
        + "bstart:\n"
        + "  br label %bloop\n"
        + "bloop:\n"
        + "  %j = phi i64 [0, %bstart], [%jnext, %bbody]\n"
        + "  %bmore = icmp ult i64 %j, %bcount\n"
        + "  br i1 %bmore, label %bbody, label %done\n"
        + "bbody:\n"
        + "  %bp = getelementptr i8, ptr %b, i64 %j\n"
        + "  %bc = load i8, ptr %bp\n"
        + "  %off = add i64 %acount, %j\n"
        + "  %bdest = getelementptr i8, ptr %buffer, i64 %off\n"
        + "  store i8 %bc, ptr %bdest\n";
    ir = ir + "  %jnext = add i64 %j, 1\n"
        + "  br label %bloop\n"
        + "done:\n"
        + "  %length = add i64 %acount, %bcount\n"
        + "  %end = getelementptr i8, ptr %buffer, i64 %length\n"
        + "  store i8 0, ptr %end\n"
        + "  ret ptr %buffer\n"
        + "}\n"
        + "define ptr @__kn_i64_to_string(i64 %value) {\n"
        + "entry:\n"
        + "  %buffer = call ptr @__kn_fs_scratch_acquire()\n"
        + "  %end = getelementptr i8, ptr %buffer, i64 31\n"
        + "  store i8 0, ptr %end\n"
        + "  %negative = icmp slt i64 %value, 0\n"
        + "  %negated = sub i64 0, %value\n"
        + "  %magnitude = select i1 %negative, i64 %negated, i64 %value\n";
    ir = ir + "  br label %loop\n"
        + "loop:\n"
        + "  %current = phi i64 [%magnitude, %entry], [%remaining, %loop]\n"
        + "  %index = phi i64 [30, %entry], [%previous, %loop]\n"
        + "  %digit = urem i64 %current, 10\n"
        + "  %remaining = udiv i64 %current, 10\n"
        + "  %narrow = trunc i64 %digit to i8\n"
        + "  %char = add i8 %narrow, 48\n"
        + "  %p = getelementptr i8, ptr %buffer, i64 %index\n"
        + "  store i8 %char, ptr %p\n"
        + "  %previous = sub i64 %index, 1\n"
        + "  %more = icmp ne i64 %remaining, 0\n"
        + "  br i1 %more, label %loop, label %signcheck\n"
        + "signcheck:\n"
        + "  br i1 %negative, label %sign, label %done\n"
        + "sign:\n";
    ir = ir + "  %signp = getelementptr i8, ptr %buffer, i64 %previous\n"
        + "  store i8 45, ptr %signp\n"
        + "  br label %done\n"
        + "done:\n"
        + "  %start = phi i64 [%index, %signcheck], [%previous, %sign]\n"
        + "  %result = getelementptr i8, ptr %buffer, i64 %start\n"
        + "  ret ptr %result\n"
        + "}\n"
        + "define ptr @__kn_char_to_string(i8 %char) {\n"
        + "entry:\n"
        + "  %buffer = call ptr @__kn_fs_scratch_acquire()\n"
        + "  store i8 %char, ptr %buffer\n"
        + "  %end = getelementptr i8, ptr %buffer, i64 1\n"
        + "  store i8 0, ptr %end\n"
        + "  ret ptr %buffer\n"
        + "}\n";
    ir = ir + "define ptr @__kn_ptr_to_string(ptr %value) {\n"
        + "entry:\n"
        + "  %number = ptrtoint ptr %value to i64\n"
        + "  %buffer = call ptr @__kn_fs_scratch_acquire()\n"
        + "  %end = getelementptr i8, ptr %buffer, i64 31\n"
        + "  store i8 0, ptr %end\n"
        + "  br label %loop\n"
        + "loop:\n"
        + "  %current = phi i64 [%number, %entry], [%remaining, %loop]\n"
        + "  %index = phi i64 [30, %entry], [%previous, %loop]\n"
        + "  %digit = and i64 %current, 15\n"
        + "  %remaining = lshr i64 %current, 4\n"
        + "  %narrow = trunc i64 %digit to i8\n"
        + "  %decimal = icmp ult i8 %narrow, 10\n"
        + "  %digitc = add i8 %narrow, 48\n"
        + "  %letter = add i8 %narrow, 87\n";
    ir = ir + "  %char = select i1 %decimal, i8 %digitc, i8 %letter\n"
        + "  %p = getelementptr i8, ptr %buffer, i64 %index\n"
        + "  store i8 %char, ptr %p\n"
        + "  %previous = sub i64 %index, 1\n"
        + "  %more = icmp ne i64 %remaining, 0\n"
        + "  br i1 %more, label %loop, label %done\n"
        + "done:\n"
        + "  %xp = getelementptr i8, ptr %buffer, i64 %previous\n"
        + "  store i8 120, ptr %xp\n"
        + "  %start = sub i64 %previous, 1\n"
        + "  %result = getelementptr i8, ptr %buffer, i64 %start\n"
        + "  store i8 48, ptr %result\n"
        + "  ret ptr %result\n"
        + "}\n"
        + "define ptr @__kn_f64_to_string(double %value) {\n"
        + "entry:\n";
    ir = ir + "  %integer = fptosi double %value to i64\n"
        + "  %result = call ptr @__kn_i64_to_string(i64 %integer)\n"
        + "  ret ptr %result\n"
        + "}\n"
        + "define ptr @__kn_fs_any_to_string(i64 %tag, i64 %payload) {\n"
        + "entry:\n"
        + "  switch i64 %tag, label %unknown [i64 1, label %integer i64 2, label %floating i64 3, label %boolean i64 4, label %character i64 5, label %string i64 6, label %pointer i64 7, label %pointer i64 8, label %pointer i64 9, label %pointer]\n"
        + "integer:\n"
        + "  %i = call ptr @__kn_i64_to_string(i64 %payload)\n"
        + "  ret ptr %i\n"
        + "floating:\n"
        + "  %f = bitcast i64 %payload to double\n"
        + "  %fs = call ptr @__kn_f64_to_string(double %f)\n"
        + "  ret ptr %fs\n"
        + "boolean:\n"
        + "  %b = icmp ne i64 %payload, 0\n";
    ir = ir + "  %bs = select i1 %b, ptr @__kn_fs_true, ptr @__kn_fs_false\n"
        + "  ret ptr %bs\n"
        + "character:\n"
        + "  %c = trunc i64 %payload to i8\n"
        + "  %cs = call ptr @__kn_char_to_string(i8 %c)\n"
        + "  ret ptr %cs\n"
        + "string:\n"
        + "  %s = inttoptr i64 %payload to ptr\n"
        + "  ret ptr %s\n"
        + "pointer:\n"
        + "  %p = inttoptr i64 %payload to ptr\n"
        + "  %ps = call ptr @__kn_ptr_to_string(ptr %p)\n"
        + "  ret ptr %ps\n"
        + "unknown:\n"
        + "  ret ptr @__kn_fs_any\n"
        + "}\n";
    Return ir;
}

Safe Function string ErrorIR()
{
    string ir = "";
    ir = ir + "@__kn_fs_error_default_title = private constant [6 x i8] c\"Error\\00\"\n"
        + "@__kn_fs_error_empty = private constant [1 x i8] zeroinitializer\n"
        + "declare ptr @__kn_gc_alloc(i64)\n"
        + "define ptr @__kn_fs_error_new(i64 %type, ptr %title, ptr %message) {\n"
        + "entry:\n"
        + "  %size = ptrtoint ptr getelementptr ({ptr, i64, ptr, ptr, ptr, ptr}, ptr null, i64 1) to i64\n"
        + "  %memory = call ptr @__kn_gc_alloc(i64 %size)\n"
        + "  %null = icmp eq ptr %memory, null\n"
        + "  br i1 %null, label %done, label %init\n"
        + "init:\n"
        + "  %title_null = icmp eq ptr %title, null\n"
        + "  %title_value = select i1 %title_null, ptr @__kn_fs_error_default_title, ptr %title\n"
        + "  %message_null = icmp eq ptr %message, null\n"
        + "  %message_value = select i1 %message_null, ptr @__kn_fs_error_empty, ptr %message\n"
        + "  %type_slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %memory, i32 0, i32 1\n"
        + "  %title_slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %memory, i32 0, i32 2\n";
    ir = ir + "  %message_slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %memory, i32 0, i32 3\n"
        + "  %trace_slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %memory, i32 0, i32 4\n"
        + "  %inner_slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %memory, i32 0, i32 5\n"
        + "  store ptr null, ptr %memory\n"
        + "  store i64 %type, ptr %type_slot\n"
        + "  store ptr %title_value, ptr %title_slot\n"
        + "  store ptr %message_value, ptr %message_slot\n"
        + "  store ptr @__kn_fs_error_empty, ptr %trace_slot\n"
        + "  store ptr null, ptr %inner_slot\n"
        + "  br label %done\n"
        + "done:\n"
        + "  ret ptr %memory\n"
        + "}\n"
        + "define ptr @__kn_fs_error_title(ptr %value) {\n"
        + "entry:\n"
        + "  %null = icmp eq ptr %value, null\n";
    ir = ir + "  br i1 %null, label %empty, label %read\n"
        + "read:\n"
        + "  %slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %value, i32 0, i32 2\n"
        + "  %result = load ptr, ptr %slot\n"
        + "  ret ptr %result\n"
        + "empty:\n"
        + "  ret ptr null\n"
        + "}\n"
        + "define ptr @__kn_fs_error_message(ptr %value) {\n"
        + "entry:\n"
        + "  %null = icmp eq ptr %value, null\n"
        + "  br i1 %null, label %empty, label %read\n"
        + "read:\n"
        + "  %slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %value, i32 0, i32 3\n"
        + "  %result = load ptr, ptr %slot\n"
        + "  ret ptr %result\n";
    ir = ir + "empty:\n"
        + "  ret ptr null\n"
        + "}\n"
        + "define ptr @__kn_fs_error_trace(ptr %value) {\n"
        + "entry:\n"
        + "  %null = icmp eq ptr %value, null\n"
        + "  br i1 %null, label %empty, label %read\n"
        + "read:\n"
        + "  %slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %value, i32 0, i32 4\n"
        + "  %result = load ptr, ptr %slot\n"
        + "  ret ptr %result\n"
        + "empty:\n"
        + "  ret ptr null\n"
        + "}\n"
        + "define ptr @__kn_fs_error_inner(ptr %value) {\n"
        + "entry:\n";
    ir = ir + "  %null = icmp eq ptr %value, null\n"
        + "  br i1 %null, label %empty, label %read\n"
        + "read:\n"
        + "  %slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %value, i32 0, i32 5\n"
        + "  %result = load ptr, ptr %slot\n"
        + "  ret ptr %result\n"
        + "empty:\n"
        + "  ret ptr null\n"
        + "}\n"
        + "define void @__kn_fs_error_set_trace(ptr %value, ptr %trace) {\n"
        + "entry:\n"
        + "  %null = icmp eq ptr %value, null\n"
        + "  br i1 %null, label %done, label %write\n"
        + "write:\n"
        + "  %slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %value, i32 0, i32 4\n"
        + "  %trace_null = icmp eq ptr %trace, null\n";
    ir = ir + "  %text = select i1 %trace_null, ptr @__kn_fs_error_empty, ptr %trace\n"
        + "  store ptr %text, ptr %slot\n"
        + "  br label %done\n"
        + "done:\n"
        + "  ret void\n"
        + "}\n"
        + "define void @__kn_fs_error_link_inner(ptr %value, ptr %inner) {\n"
        + "entry:\n"
        + "  %value_null = icmp eq ptr %value, null\n"
        + "  %inner_null = icmp eq ptr %inner, null\n"
        + "  %null = or i1 %value_null, %inner_null\n"
        + "  %same = icmp eq ptr %value, %inner\n"
        + "  %skip = or i1 %null, %same\n"
        + "  br i1 %skip, label %done, label %check\n"
        + "check:\n"
        + "  %slot = getelementptr {ptr, i64, ptr, ptr, ptr, ptr}, ptr %value, i32 0, i32 5\n";
    ir = ir + "  %previous = load ptr, ptr %slot\n"
        + "  %empty = icmp eq ptr %previous, null\n"
        + "  br i1 %empty, label %write, label %done\n"
        + "write:\n"
        + "  store ptr %inner, ptr %slot\n"
        + "  br label %done\n"
        + "done:\n"
        + "  ret void\n"
        + "}\n";
    Return ir;
}

    Public Safe Function TokenKind ReverseLoopComparison(TokenKind op)
    {
        If (op == TokenKind.Less) Return TokenKind.Greater;
        If (op == TokenKind.LessEqual) Return TokenKind.GreaterEqual;
        If (op == TokenKind.Greater) Return TokenKind.Less;
        If (op == TokenKind.GreaterEqual) Return TokenKind.LessEqual;
        Return op;
    }
    Public Trusted Function bool TryFuseLoop(KncFunctionContext context, HirStatement statement, bool isFor)
    {

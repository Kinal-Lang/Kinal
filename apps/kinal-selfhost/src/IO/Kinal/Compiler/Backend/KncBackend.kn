        If (IO.Text.StartsWith(target, "Block.")) Return This.BlockCall(context, expression);
        If (expression.Left == null && IO.Text.EndsWith(target, ".Run"))
        {
            string name = IO.Text.Slice(target, 0, IO.Text.Length(target) - 4);
            KncBlockBinding block = context.FirstBlock;
            While (block != null && block.Name != name) block = block.Next;
            If (block != null)
            {
                This.EmitBlockBody(context, block.Body, -1, -1);
                Return New KncValue(255, This.Semantics.Primitive("void"));
            }
        }
        KncValue receiver = expression.Left == null || expression.Left.Kind == [int](HirExpressionKind.Namespace) ? null : This.Expression(context, expression.Left);
        HirExpression argument = expression.FirstArgument;
        If (target == "TypeOf")
        {
            TypeSymbol type = receiver == null && argument != null ? argument.Type : receiver == null ? expression.Type : receiver.Type;
            Return This.String(context, type.Name);
        }
        If (target == "ToString" && receiver != null) Return This.Cast(context, receiver, This.Semantics.Primitive("string"));
        If (IO.Text.StartsWith(target, "IO.Type."))
        {
            string name = IO.Text.Slice(target, 8, IO.Text.Length(target) - 8);
            If (!IO.Text.Contains(name, ".") && argument != null) Return This.Cast(context, This.Expression(context, argument), expression.Type);
        }
        If (receiver != null && target == "Index" && argument != null &&
            (receiver.Type.Kind == [int](TypeKind.ArrayType) || receiver.Type.Kind == [int](TypeKind.StringType)))
        {
            KncValue index = This.Cast(context, This.Expression(context, argument), This.Semantics.Primitive("int"));
            Return This.BinaryOp(context, KncOpCode.LoadIndex, receiver, index, expression.Type);
        }
        If (receiver != null && receiver.Type.Kind == [int](TypeKind.ArrayType))
        {
            If (target == "Length") Return This.UnaryOp(context, KncOpCode.ArrayLength, receiver, expression.Type);
            If (target == "Add" && argument != null)
            {
                KncValue value = This.Cast(context, This.CopyValue(context, This.Expression(context, argument)), receiver.Type.ElementType);
                KncValue result = This.BinaryOp(context, KncOpCode.ArrayAdd, receiver, value, expression.Type);
                KncValue length = This.UnaryOp(context, KncOpCode.ArrayLength, receiver, This.Semantics.Primitive("int"));
                This.InitializeArrayValues(context, result, length, true);

        If (target == "IO.Type.string.Concat") Return 20;
        If (target == "IO.Type.string.Equals") Return 21;
        If (target == "IO.Type.string.ToChars") Return 22;
        If (target == "IO.Type.any.IsNull") Return 130;
        If (target == "IO.Type.any.ToString") Return 131;
        If (target == "IO.Type.any.Equals") Return 132;
        If (target == "IO.Type.any.TypeName") Return 134;
        If (target == "IO.Type.any.IsNumber") Return 135;
        If (target == "IO.Type.any.IsPointer") Return 136;
        If (target == "IO.Type.any.IsInt") Return 137;
        If (target == "IO.Type.any.IsFloat") Return 138;
        If (target == "IO.Type.any.IsString") Return 139;
        If (target == "IO.Type.any.IsBool") Return 140;
        If (target == "IO.Type.any.IsChar") Return 141;
        If (target == "IO.Type.any.IsObject") Return 142;
        If (target == "IO.System.FileExists") Return 145;
        If (target == "IO.Error.LastTrace") Return 147;
        If (target == "IO.Error.HasException") Return 148;
        If (target == "IO.Error.Clear") Return 149;
        If (target == "IO.Error.Current") Return 150;
        If (target == "IO.GC.Collect") Return 151;

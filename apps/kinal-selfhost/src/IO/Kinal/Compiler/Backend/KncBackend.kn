Unit IO.Kinal.Compiler.Backend.KncBackend;

Get IO.Text;
Get IO.Kinal.Compiler.Lex.TokenKind;
Get IO.Kinal.Compiler.Syntax.Nodes;
Get IO.Kinal.Compiler.Syntax.SyntaxTree;
Get IO.Kinal.Compiler.Types.TypeSymbol;
Get IO.Kinal.Compiler.Sema.Symbols;
Get IO.Kinal.Compiler.Sema.SemanticCompilation;
Get IO.Kinal.Compiler.Hir.HirModel;
Get IO.Kinal.Compiler.Backend.KncModel;

// KNC lowering consumes the same bound HIR as the native backend. No source
// parsing, host compiler process, LLVM lowering or C-emitter callback is used.
Class KncValue
{
    Public int Register;
    Public TypeSymbol Type;
    Public bool IsDefault;
    Public bool IsCallable;
    Public Safe Constructor(int register, TypeSymbol type)
    {
        This.Register = register;
        This.Type = type;
        This.IsDefault = false;
        This.IsCallable = false;
    }
}

Class KncLocalBinding
{
    Public ValueSymbol Symbol;
    Public int Register;
    Public int CellRegister;
    Public KncLocalBinding Next;
    Public Safe Constructor(ValueSymbol symbol, int register)
    {
        This.Symbol = symbol;
        This.Register = register;
        This.CellRegister = -1;
        This.Next = null;
    }
}

Class KncFunctionBinding
{
    Public FunctionSymbol Symbol;
    Public HirFunction Hir;
    Public KncFunctionRecord Record;
    Public int Index;
    Public bool Built;
    Public KncFunctionBinding Next;
    Public Safe Constructor(FunctionSymbol symbol, HirFunction hir, KncFunctionRecord record, int index)
    {
        This.Symbol = symbol;
        This.Hir = hir;
        This.Record = record;
        This.Index = index;
        This.Built = false;
        This.Next = null;
    }
}

Class KncGlobalBinding
{
    Public GlobalSymbol Symbol;
    Public HirExpression Initializer;
    Public int Index;
    Public KncGlobalBinding Next;
    Public Safe Constructor(GlobalSymbol symbol, HirExpression initializer, int index)
    {
        This.Symbol = symbol;
        This.Initializer = initializer;
        This.Index = index;
        This.Next = null;
    }
}

Class KncLoopContext
{
    Public list BreakPatches;
    Public list ContinuePatches;
    Public KncLoopContext Parent;
    Public int TryDepth;
    Public Safe Constructor(KncLoopContext parent)
    {
        This.BreakPatches = list.Create();
        This.ContinuePatches = list.Create();
        This.Parent = parent;
        This.TryDepth = 0;
    }
}

Class KncRecordBinding
{
    Public string Name;
    Public int Ordinal;
    Public int Position;
    Public list Patches;
    Public KncRecordBinding Next;
    Public Safe Constructor(string name, int ordinal)
    {
        This.Name = name; This.Ordinal = ordinal; This.Position = -1;
        This.Patches = list.Create(); This.Next = null;
    }
}
Class KncBlockBinding
{
    Public string Name;
    Public HirStatement Body;
    Public KncRecordBinding FirstRecord;
    Public KncRecordBinding LastRecord;
    Public int RecordCount;
    Public int StartPosition;
    Public int UntilRegister;
    Public int TryDepth;
    Public list EndPatches;
    Public KncBlockBinding Next;
    Public Safe Constructor(string name, HirStatement body)
    {
        This.Name = name; This.Body = body; This.FirstRecord = null;
        This.LastRecord = null; This.RecordCount = 0; This.StartPosition = -1;
        This.UntilRegister = -1; This.TryDepth = 0; This.EndPatches = list.Create(); This.Next = null;
    }
    Public Safe Function KncRecordBinding FindRecord(string name)
    {
        KncRecordBinding record = This.FirstRecord;
        While (record != null) { If (record.Name == name) Return record; record = record.Next; }
        Return null;
    }
}

Class KncFunctionContext
{
    Public KncFunctionBinding Binding;
    Public KncFunctionRecord Record;
    Public KncLocalBinding FirstLocal;
    Public KncLoopContext Loop;
    Public KncBlockBinding FirstBlock;
    Public KncBlockBinding ActiveBlock;
    Public int NextRegister;
    Public int NullRegister;
    Public int TryDepth;
    Public string Error;
    Public Safe Constructor(KncFunctionBinding binding, KncFunctionRecord record)
    {
        This.Binding = binding;
        This.Record = record;
        This.FirstLocal = null;
        This.Loop = null;
        This.FirstBlock = null;
        This.ActiveBlock = null;
        This.NextRegister = 0;
        This.NullRegister = -1;
        This.TryDepth = 0;
        This.Error = "";
    }
    Public Safe Function int Allocate()
    {
        If (This.NextRegister >= 255)
        {
            If (This.Error == "") This.Error = "KNC function exceeds 255 simultaneously live registers";
            Return 0;
        }
        int result = This.NextRegister;
        This.NextRegister = This.NextRegister + 1;
        If (This.Record.RegisterCount < This.NextRegister)
            This.Record.RegisterCount = This.NextRegister;
        Return result;
    }
    Public Safe Function void AddLocal(ValueSymbol symbol)
    {
        If (symbol == null || This.FindLocal(symbol) >= 0) Return;
        KncLocalBinding binding = New KncLocalBinding(symbol, This.Allocate());
        This.Record.SetRegisterName(binding.Register, symbol.Name);
        binding.Next = This.FirstLocal;
        This.FirstLocal = binding;
    }
    Public Safe Function KncLocalBinding FindBinding(ValueSymbol symbol)
    {
        KncLocalBinding current = This.FirstLocal;
        While (current != null)
        {
            If (current.Symbol == symbol) Return current;
            current = current.Next;
        }
        Return null;
    }
    Public Safe Function void ReserveCells()
    {
        KncLocalBinding current = This.FirstLocal;
        While (current != null)
        {
            If (current.Symbol.IsCaptured)
            {
                current.CellRegister = This.Allocate();
                This.Record.SetRegisterName(current.CellRegister, current.Symbol.Name + "$cell");
            }
            current = current.Next;
        }
    }
    Public Safe Function int FindLocal(ValueSymbol symbol)
    {
        KncLocalBinding current = This.FirstLocal;
        While (current != null)
        {
            If (current.Symbol == symbol) Return current.Register;
            current = current.Next;
        }
        Return -1;
    }
}

// Evaluated lvalues retain their receiver/index once across read-modify-write.
Class KncLocation
{
    Public int Kind;
    Public int Register;
    Public int Index;
    Public TypeSymbol Type;
    Public FunctionSymbol Getter;
    Public FunctionSymbol Setter;
    Public KncValue Receiver;
    Public bool VirtualDispatch;
    Public Safe Constructor(int kind, int register, int index, TypeSymbol type)
    {
        This.Kind = kind;
        This.Getter = null;
        This.Setter = null;
        This.Receiver = null;
        This.VirtualDispatch = true;
        This.Register = register;
        This.Index = index;
        This.Type = type;
    }
}

Class KncTypeBinding
{
    Public TypeSymbol Type;
    Public KncTypeRecord Record;
    Public int Index;
    Public KncTypeBinding Next;
    Public Safe Constructor(TypeSymbol type, KncTypeRecord record, int index)
    {
        This.Type = type;
        This.Record = record;
        This.Index = index;
        This.Next = null;
    }
}

Class KncBackend
{
    Public SemanticCompilation Semantics;
    Public KncProgram Program;
    Public string Error;
    Public KncFunctionBinding FirstFunction;
    Public KncFunctionBinding LastFunction;
    Public KncGlobalBinding FirstGlobal;
    Public KncTypeBinding FirstType;
    Public bool EnableSuperloop;
    Private bool Lowered;
    Public Safe Constructor(SemanticCompilation semantics)
    {
        This.Semantics = semantics;
        This.Program = New KncProgram();
        This.Error = "";
        This.FirstFunction = null;
        This.LastFunction = null;
        This.FirstGlobal = null;
        This.FirstType = null;
        This.EnableSuperloop = true;
        This.Lowered = false;
    }
    Public Safe Function bool Failed() { Return This.Error != ""; }
    Public Safe Function void Fail(string message)
    {
        If (!This.Failed()) This.Error = "KNC: " + message;
    }
    Public Safe Function void Unsupported(KncFunctionContext context, string family)
    {
        This.Fail("unsupported " + family + (context == null ? "" : " in " + context.Record.Name));
    }
    Public Safe Function TypeSymbol Representation(TypeSymbol type)
    {
        If (This.Semantics.IsEnumType(type) && type.UnderlyingType != null)
            Return type.UnderlyingType;
        Return type;
    }
    Public Safe Function bool IsInteger(TypeSymbol type)
    {
        Return type != null && (type.Kind == [int](TypeKind.IntegerType) || This.Semantics.IsEnumType(type));
    }
    Public Safe Function bool IsUnsigned(TypeSymbol type)
    {
        type = This.Representation(type);
        Return type != null && (type.Name == "byte" || type.Name == "char" ||
            type.Name == "u8" || type.Name == "u16" || type.Name == "u32" ||
            type.Name == "u64" || type.Name == "usize");
    }
    Public Safe Function int IntegerBits(TypeSymbol type)
    {
        type = This.Representation(type);
        If (type == null) Return 64;
        If (type.Name == "byte" || type.Name == "char" || type.Name == "i8" || type.Name == "u8") Return 8;
        If (type.Name == "i16" || type.Name == "u16") Return 16;
        If (type.Name == "i32" || type.Name == "u32") Return 32;
        Return 64;
    }
    Public Safe Function int ValueKind(TypeSymbol type)
    {
        If (type == null) Return 0;
        If (type.Name == "char") Return 5;
        If (This.IsInteger(type)) Return 1;
        If (type.Kind == [int](TypeKind.FloatType)) Return 2;
        If (type.Kind == [int](TypeKind.BoolType)) Return 3;
        If (type.Kind == [int](TypeKind.StringType)) Return 4;
        If (type.Kind == [int](TypeKind.ArrayType) || type.Kind == [int](TypeKind.PackageType)) Return 6;
        If (type.Kind == [int](TypeKind.NamedType)) Return 7;
        If (type.Kind == [int](TypeKind.PointerType)) Return 8;
        Return 0;
    }
    Public Safe Function string Unquote(string raw)
    {
        int length = IO.Text.Length(raw);
        If (length >= 2 && IO.Text.StartsWith(raw, "\"") && IO.Text.EndsWith(raw, "\""))
            Return IO.Text.Slice(raw, 1, length - 2);
        Return raw;
    }
    Public Safe Function string DecodeString(string raw)
    {
        char[] chars = This.Unquote(raw).ToChars();
        string result = "";
        int i = 0;
        While (i < chars.Length())
        {
            int value = [int](chars[i]);
            If (value == 92 && i + 1 < chars.Length())
            {
                i = i + 1;
                int escaped = [int](chars[i]);
                If (escaped == 110) value = 10;
                ElseIf (escaped == 114) value = 13;
                ElseIf (escaped == 116) value = 9;
                ElseIf (escaped == 98) value = 8;
                ElseIf (escaped == 48) value = 0;
                Else value = escaped;
            }
            result = result + [string]([char](value));
            i = i + 1;
        }
        Return result;
    }
    Public Safe Function i64 EnumValue(TypeSymbol type, string target)
    {
        i64 value = 0;
        EnumMemberDecl member = type.Declaration.FirstEnumMember;
        While (member != null)
        {
            If (member.HasConstantValue) value = member.ConstantValue;
            If (IO.Text.EndsWith(target, "." + member.Name) || target == member.Name) Return value;
            value = value + 1;
            member = member.Next;
        }
        Return 0;
    }
    Public Safe Function HirFunction FindHir(FunctionSymbol symbol)
    {
        HirModule module = This.Semantics.FirstHirModule;
        While (module != null)
        {
            HirFunction function = module.FirstFunction;
            While (function != null)
            {
                If (function.Symbol == symbol) Return function;
                function = function.Next;
            }
            module = module.Next;
        }
        Return null;
    }
    Public Safe Function HirExpression FindInitializer(GlobalSymbol symbol)
    {
        HirModule module = This.Semantics.FirstHirModule;
        While (module != null)
        {
            HirGlobal global = module.FirstGlobal;
            While (global != null)
            {
                If (global.Symbol == symbol) Return global.Initializer;
                global = global.Next;
            }
            module = module.Next;
        }
        Return null;
    }
    Public Safe Function SyntaxAttribute RuntimeAttribute(FunctionSymbol function, string name)
    {
        MetaDecl expected = This.Semantics.FindMeta(function.Syntax, "IO.Kinal.Runtime." + name);
        If (expected == null) Return null;
        SyntaxAttribute attribute = function.Declaration.FirstAttribute;
        While (attribute != null)
        {
            If (This.Semantics.FindMeta(function.Syntax, attribute.Name) == expected) Return attribute;
            attribute = attribute.Next;
        }
        Return null;
    }
    Public Safe Function int IntrinsicId(FunctionSymbol function)
    {
        If (function == null) Return -1;
        SyntaxAttribute unsupported = This.RuntimeAttribute(function, "KncUnsupported");
        If (unsupported != null)
        {
            This.Fail(unsupported.FirstArgument == null ? "function has no KNC lowering" : This.DecodeString(unsupported.FirstArgument.Text));
            Return -1;
        }
        SyntaxAttribute attribute = This.RuntimeAttribute(function, "KncIntrinsic");
        If (attribute == null && function.Declaration.IsExtern && function.Declaration.Abi == "C")
        {
            // These four legacy leaf symbols are already part of the KNC/VM
            // ABI. Other native externs remain explicitly unsupported.
            string name = function.Name;
            string linkName = This.Semantics.AttributeString(function.Declaration, "LinkName");
            If (linkName != "") name = linkName;
            If (name == "__kn_time_tick") Return 15;
            If (name == "__kn_time_sleep") Return 16;
            If (name == "__kn_time_nano") Return 17;
            If (name == "__kn_sys_file_exists") Return 145;
        }
        If (attribute == null || attribute.FirstArgument == null || attribute.FirstArgument.Next != null) Return -1;
        i64 value = This.Semantics.IntegerLiteralValue(attribute.FirstArgument.Text);
        If (value < 0 || value > 65535) { This.Fail("invalid KncIntrinsic id"); Return -1; }
        Return [int](value);
    }
    Public Safe Function bool HasInstanceReceiver(FunctionSymbol symbol)
    {
        // A literal can bind lexical This through its capture environment.
        // That semantic receiver is not a physical method argument.
        Return symbol != null && symbol.OwnerType != null &&
            (!symbol.Declaration.IsStatic || symbol.Declaration.IsConstructor);
    }
    Public Safe Function KncFunctionBinding RequireFunction(FunctionSymbol symbol)
    {
        KncFunctionBinding current = This.FirstFunction;
        While (current != null)
        {
            If (current.Symbol == symbol) Return current;
            current = current.Next;
        }
        If (symbol == null) { This.Fail("missing bound function"); Return null; }
        SyntaxAttribute unsupported = This.RuntimeAttribute(symbol, "KncUnsupported");
        If (unsupported != null)
        {
            This.Fail(unsupported.FirstArgument == null ? "function has no KNC lowering" : This.DecodeString(unsupported.FirstArgument.Text));
            Return null;
        }
        If (symbol.Declaration.IsExtern)
        {
            This.Fail("native extern has no VM intrinsic: " + symbol.QualifiedName());
            Return null;
        }
        If (symbol.Declaration.IsDelegate || symbol.Declaration.IsAsync)
        {
            This.Fail("unsupported " + (symbol.Declaration.IsAsync ? "async function: " : "delegate: ") + symbol.QualifiedName());
            Return null;
        }
        If (symbol.ReturnType.Name == "f16" || symbol.ReturnType.Name == "f128")
        {
            This.Fail("unsupported extended floating-point return type " + symbol.ReturnType.Name + ": " + symbol.QualifiedName());
            Return null;
        }
        HirFunction hir = This.FindHir(symbol);
        If (hir == null || hir.Body == null) { This.Fail("function has no bound body: " + symbol.QualifiedName()); Return null; }
        int count = symbol.ParameterCount() + (This.HasInstanceReceiver(symbol) ? 1 : 0);
        If (count > 4) { This.Fail("function exceeds the KNC four-argument ABI: " + symbol.QualifiedName()); Return null; }
        KncFunctionRecord record = New KncFunctionRecord();
        record.Name = symbol.QualifiedName();
        record.ParameterCount = symbol.IsBlockLiteral ? 2 : count;
        record.ReturnKind = This.ValueKind(symbol.ReturnType);
        KncFunctionBinding binding = New KncFunctionBinding(symbol, hir, record, This.Program.AddFunction(record));
        If (This.FirstFunction == null) This.FirstFunction = binding;
        Else This.LastFunction.Next = binding;
        This.LastFunction = binding;
        Return binding;
    }
    Public Safe Function int GlobalIndex(ValueSymbol symbol)
    {
        KncGlobalBinding current = This.FirstGlobal;
        While (current != null)
        {
            If (current.Symbol.Value == symbol) Return current.Index;
            current = current.Next;
        }
        This.Fail("missing global binding");
        Return 0;
    }
    Public Safe Function void AllocateLocals(KncFunctionContext context, HirStatement statement)
    {
        While (statement != null)
        {
            context.AddLocal(statement.DeclaredSymbol);
            This.AllocateLocals(context, statement.Initializer);
            This.AllocateLocals(context, statement.FirstChild);
            This.AllocateLocals(context, statement.ElseBranch);
            statement = statement.Next;
        }
    }
    Public Safe Function void Op1(KncFunctionContext context, KncOpCode op, int a)
    {
        context.Record.Code.WriteU8([int](op)); context.Record.Code.WriteU8(a);
    }
    Public Safe Function void Op2(KncFunctionContext context, KncOpCode op, int a, int b)
    {
        This.Op1(context, op, a); context.Record.Code.WriteU8(b);
    }
    Public Safe Function void Op3(KncFunctionContext context, KncOpCode op, int a, int b, int c)
    {
        This.Op2(context, op, a, b); context.Record.Code.WriteU8(c);
    }
    Public Safe Function void SlotOp(KncFunctionContext context, KncOpCode op, int register, int slot)
    {
        This.Op1(context, op, register); context.Record.Code.WriteU16(slot);
    }
    Public Safe Function int EmitJump(KncFunctionContext context)
    {
        context.Record.Code.WriteU8([int](KncOpCode.JumpOp));
        int patch = context.Record.Code.Count;
        context.Record.Code.WriteU16(0);
        Return patch;
    }
    Public Safe Function int Branch(KncFunctionContext context, KncOpCode op, int register)
    {
        This.Op1(context, op, register);
        int patch = context.Record.Code.Count;
        context.Record.Code.WriteU16(0);
        Return patch;
    }
    Public Safe Function void Patch(KncFunctionContext context, int patch)
    {
        If (patch >= 0) context.Record.Code.PatchU16(patch, context.Record.Code.Count);
    }
    Public Safe Function void PatchList(KncFunctionContext context, list patches)
    {
        int index = 0;
        While (index < patches.Count())
        {
            This.Patch(context, [int](patches.Fetch(index)));
            index = index + 1;
        }
    }
    Public Safe Function KncValue Integer(KncFunctionContext context, i64 value)
    {
        int register = context.Allocate();
        This.SlotOp(context, KncOpCode.LoadInt, register, This.Program.InternInt(value));
        Return New KncValue(register, This.Semantics.Primitive("int"));
    }
    Public Safe Function KncValue String(KncFunctionContext context, string value)
    {
        int register = context.Allocate();
        This.SlotOp(context, KncOpCode.LoadString, register, This.Program.InternString(value));
        Return New KncValue(register, This.Semantics.Primitive("string"));
    }
    Public Safe Function KncValue UnaryOp(KncFunctionContext context, KncOpCode op, KncValue value, TypeSymbol type)
    {
        int register = context.Allocate();
        This.Op2(context, op, register, value.Register);
        Return New KncValue(register, type);
    }
    Public Safe Function KncValue BinaryOp(KncFunctionContext context, KncOpCode op, KncValue left, KncValue right, TypeSymbol type)
    {
        int register = context.Allocate();
        This.Op3(context, op, register, left.Register, right.Register);
        Return New KncValue(register, type);
    }
    Public Safe Function KncValue WidthOp(KncFunctionContext context, KncOpCode op, KncValue left, KncValue right, TypeSymbol type, int bits)
    {
        KncValue value = This.BinaryOp(context, op, left, right, type);
        context.Record.Code.WriteU8(bits);
        Return value;
    }
    Public Trusted Function KncValue Float(KncFunctionContext context, float value, TypeSymbol type)
    {
        int register = context.Allocate();
        This.SlotOp(context, KncOpCode.LoadFloat, register, This.Program.InternFloat(value));
        Return New KncValue(register, type);
    }
    Public Safe Function KncValue NormalizeInteger(KncFunctionContext context, KncValue value, TypeSymbol target)
    {
        If (value.Type.Name == "char")
            value = This.UnaryOp(context, KncOpCode.CharToInt, value, This.Semantics.Primitive("int"));
        int bits = This.IntegerBits(target);
        If (bits < 64)
        {
            If (This.IsUnsigned(target))
                value = This.WidthOp(context, KncOpCode.LShrInt, value, This.Integer(context, 0), target, bits);
            Else
            {
                KncValue shift = This.Integer(context, 64 - bits);
                value = This.BinaryOp(context, KncOpCode.ShlInt, value, shift, target);
                value = This.BinaryOp(context, KncOpCode.ShrInt, value, shift, target);
            }
        }
        If (target.Name == "char") Return This.UnaryOp(context, KncOpCode.IntToChar, value, target);
        Return New KncValue(value.Register, target);
    }
    Public Trusted Function KncValue Cast(KncFunctionContext context, KncValue value, TypeSymbol target)
    {
        If (target == null || value.Type == null) { This.Fail("missing HIR coercion type"); Return value; }
        If (value.IsDefault) Return This.Default(context, target);
        If (value.IsCallable && (target.Kind == [int](TypeKind.PointerType) || target.Name == "Object.Function" ||
            target.Name == "IO.Type.Object.Function" || target.Name == "Object.Class" || target.Name == "IO.Type.Object.Class"))
        {
            KncValue callable = New KncValue(value.Register, target);
            callable.IsCallable = true;
            Return callable;
        }
        If (target.Kind == [int](TypeKind.AnyType)) Return New KncValue(This.CopyValue(context, value).Register, target);
        If (target.Kind == [int](TypeKind.NamedType) && !This.Semantics.IsEnumType(target) &&
            (value.Type.Kind == [int](TypeKind.NamedType) || value.Type.Kind == [int](TypeKind.AnyType)))
        {
            KncValue converted = This.CheckedObjectCast(context, value, target);
            Return value.Type.Kind == [int](TypeKind.AnyType) && This.Semantics.IsStructType(target) ? This.CopyValue(context, converted) : converted;
        }
        If (target.Kind == [int](TypeKind.VoidType)) Return New KncValue(255, target);
        If (target.Name == "f16" || target.Name == "f128")
        {
            This.Unsupported(context, "extended floating-point type " + target.Name);
            Return value;
        }
        int sourceKind = value.Type.Kind;
        If (sourceKind == [int](TypeKind.AnyType) && (This.IsInteger(target) ||
            target.Kind == [int](TypeKind.FloatType) || target.Kind == [int](TypeKind.BoolType)))
            Return This.DynamicScalarCast(context, value, target);
        If (This.IsInteger(value.Type) && value.Type.Name != "char")
            value = This.NormalizeInteger(context, value, value.Type);
        If (target.Kind == [int](TypeKind.FloatType))
        {
            If (value.Type.Name == "char") value = This.UnaryOp(context, KncOpCode.CharToInt, value, This.Semantics.Primitive("int"));
            If (This.IsInteger(value.Type))
            {
                If (target.Name == "f32")
                {
                    KncValue converted = This.UnaryOp(context, KncOpCode.IntToF32, value, target);
                    context.Record.Code.WriteU8(This.IsUnsigned(value.Type) ? 1 : 0);
                    Return converted;
                }
                value = This.UnaryOp(context, KncOpCode.IntToFloat, value, target);
            }
            ElseIf (sourceKind == [int](TypeKind.BoolType))
                value = This.UnaryOp(context, KncOpCode.BoolToFloat, value, target);
            ElseIf (sourceKind == [int](TypeKind.StringType))
                value = This.UnaryOp(context, KncOpCode.StringToFloat, value, target);
            ElseIf (sourceKind != [int](TypeKind.FloatType))
            {
                This.Unsupported(context, "conversion from " + value.Type.Name + " to " + target.Name);
                Return value;
            }
            If (target.Name == "f32") value = This.UnaryOp(context, KncOpCode.FloatToF32, value, target);
            Return New KncValue(value.Register, target);
        }
        If (This.IsInteger(target))
        {
            If (sourceKind == [int](TypeKind.FloatType))
                value = This.UnaryOp(context, KncOpCode.FloatToInt, value, This.Semantics.Primitive("int"));
            ElseIf (sourceKind == [int](TypeKind.BoolType))
                value = This.UnaryOp(context, KncOpCode.BoolToInt, value, This.Semantics.Primitive("int"));
            ElseIf (sourceKind == [int](TypeKind.StringType))
                value = This.UnaryOp(context, target.Name == "char" ? KncOpCode.StringToChar : KncOpCode.StringToInt, value, target.Name == "char" ? target : This.Semantics.Primitive("int"));
            ElseIf (!This.IsInteger(value.Type) && sourceKind != [int](TypeKind.AnyType))
            {
                This.Unsupported(context, "conversion from " + value.Type.Name + " to " + target.Name);
                Return value;
            }
            Return This.NormalizeInteger(context, value, target);
        }
        If (target.Kind == [int](TypeKind.BoolType))
        {
            If (sourceKind == [int](TypeKind.BoolType)) Return value;
            If (sourceKind == [int](TypeKind.FloatType)) Return This.UnaryOp(context, KncOpCode.FloatToBool, value, target);
            If (sourceKind == [int](TypeKind.StringType)) Return This.UnaryOp(context, KncOpCode.StringToBool, value, target);
            If (value.Type.Name == "char") value = This.UnaryOp(context, KncOpCode.CharToInt, value, This.Semantics.Primitive("int"));
            If (This.IsInteger(value.Type)) Return This.BinaryOp(context, KncOpCode.Ne, value, This.Integer(context, 0), target);
            This.Unsupported(context, "conversion from " + value.Type.Name + " to bool");
            Return value;
        }
        If (target.Kind == [int](TypeKind.StringType))
        {
            If (sourceKind == [int](TypeKind.StringType) || sourceKind == [int](TypeKind.NullType)) Return New KncValue(value.Register, target);
            If (value.Type.Name == "char") Return This.UnaryOp(context, KncOpCode.CharToString, value, target);
            If (This.IsInteger(value.Type)) Return This.UnaryOp(context, KncOpCode.IntToString, value, target);
            If (sourceKind == [int](TypeKind.FloatType)) Return This.UnaryOp(context, KncOpCode.FloatToString, value, target);
            If (sourceKind == [int](TypeKind.BoolType)) Return This.UnaryOp(context, KncOpCode.BoolToString, value, target);
            int[] args = {value.Register};
            Return This.EmitCallRegisters(context, true, 131, args, target);
        }
        If (target.Kind == [int](TypeKind.PointerType))
        {
            If (sourceKind == [int](TypeKind.PointerType)) Return New KncValue(value.Register, target);
            If (sourceKind == [int](TypeKind.StringType) || sourceKind == [int](TypeKind.ArrayType))
            {
                int register = context.Allocate();
                This.Op2(context, KncOpCode.Move, register, context.NullRegister);
                KncValue isNull = This.BinaryOp(context, KncOpCode.Eq, value,
                    New KncValue(context.NullRegister, This.Semantics.Primitive("any")), This.Semantics.Primitive("bool"));
                int end = This.Branch(context, KncOpCode.JumpIfTrue, isNull.Register);
                KncValue zero = This.Integer(context, 0);
                This.Op3(context, KncOpCode.MakePtrIndex, register, value.Register, zero.Register);
                This.Patch(context, end);
                Return New KncValue(register, target);
            }
        }
        If (sourceKind == [int](TypeKind.PackageType) && target.Kind == [int](TypeKind.ArrayType))
            Return This.PackageArrayCast(context, value, target);
        If (sourceKind == [int](TypeKind.AnyType) || sourceKind == [int](TypeKind.NullType) ||
            This.Semantics.SameType(value.Type, target) ||
            (sourceKind == [int](TypeKind.ArrayType) && target.Kind == [int](TypeKind.ArrayType)))
            Return New KncValue(value.Register, target);
        This.Unsupported(context, "conversion from " + value.Type.Name + " to " + target.Name);
        Return value;
    }
    Public Trusted Function KncValue Default(KncFunctionContext context, TypeSymbol type)
    {
        If (type == null || type.Kind == [int](TypeKind.VoidType)) Return New KncValue(255, This.Semantics.Primitive("void"));
        If (This.IsInteger(type)) Return This.Cast(context, This.Integer(context, 0), type);
        If (type.Kind == [int](TypeKind.FloatType)) Return This.Float(context, 0.0, type);
        int register = context.Allocate();
        If (type.Kind == [int](TypeKind.BoolType)) This.Op2(context, KncOpCode.LoadBool, register, 0);
        ElseIf (type.Kind == [int](TypeKind.StringType)) This.SlotOp(context, KncOpCode.LoadString, register, This.Program.InternString(""));
        ElseIf (type.Kind == [int](TypeKind.ArrayType) || type.Kind == [int](TypeKind.PackageType))
        {
            int count = type.Kind == [int](TypeKind.PackageType) ? type.PackageCount : (type.ArrayLength < 0 ? 0 : type.ArrayLength);
            KncValue length = This.Integer(context, count);
            This.Op3(context, KncOpCode.NewArray, register, length.Register, type.Kind == [int](TypeKind.PackageType) ? 0 : This.ValueKind(type.ElementType));
            If (type.Kind == [int](TypeKind.ArrayType))
                This.InitializeArrayValues(context, New KncValue(register, type), length, false);
            If (type.Kind == [int](TypeKind.PackageType))
            {
                int mark = context.NextRegister;
                int index = 0;
                While (index < type.PackageCount)
                {
                    KncValue position = This.Integer(context, index);
                    KncValue element = This.Default(context, type.PackageElement(index));
                    This.Op3(context, KncOpCode.StoreIndex, register, position.Register, element.Register);
                    context.NextRegister = mark;
                    index = index + 1;
                }
            }
        }
        ElseIf (This.Semantics.IsStructType(type)) Return This.NewValue(context, type);
        Else This.Op2(context, KncOpCode.Move, register, context.NullRegister);
        Return New KncValue(register, type);
    }
    Public Trusted Function KncValue Constant(KncFunctionContext context, HirExpression expression)
    {
        If (expression.Target == "__target_string") Return This.String(context, expression.Name);
        If (expression.Target == "__target_integer") Return This.Cast(context, This.Integer(context, This.Semantics.IntegerLiteralValue(expression.Name)), expression.Type);
        If (This.Semantics.IsEnumType(expression.Type)) Return This.Cast(context, This.Integer(context, This.EnumValue(expression.Type, expression.Target)), expression.Type);
        If (expression.Syntax == null) Return This.Default(context, expression.Type);
        int kind = expression.Syntax.Kind;
        If (kind == [int](ExpressionKind.Null) && expression.Name == "default")
        {
            KncValue value = This.Default(context, expression.Type);
            value.IsDefault = true;
            Return value;
        }
        If (kind == [int](ExpressionKind.Number))
        {
            If (expression.Type.Kind == [int](TypeKind.FloatType)) Return This.Cast(context, This.Float(context, [float](expression.Name), This.Semantics.Primitive("float")), expression.Type);
            Return This.Cast(context, This.Integer(context, This.Semantics.IntegerLiteralValue(expression.Name)), expression.Type);
        }
        If (kind == [int](ExpressionKind.String) || kind == [int](ExpressionKind.FormattedString))
            Return This.String(context, expression.Syntax.IsRawString ? This.Unquote(expression.Name) : This.DecodeString(expression.Name));
        If (kind == [int](ExpressionKind.Character))
        {
            string raw = expression.Name;
            If (IO.Text.Length(raw) >= 2) raw = IO.Text.Slice(raw, 1, IO.Text.Length(raw) - 2);
            char[] chars = This.DecodeString(raw).ToChars();
            Return This.Cast(context, This.Integer(context, chars.Length() == 0 ? 0 : [int](chars[0])), expression.Type);
        }
        If (kind == [int](ExpressionKind.Boolean))
        {
            int register = context.Allocate();
            This.Op2(context, KncOpCode.LoadBool, register, expression.Name == "true" || expression.Name == "True" ? 1 : 0);
            Return New KncValue(register, expression.Type);
        }
        If (kind == [int](ExpressionKind.Null) && expression.Name != "default")
        {
            int register = context.Allocate();
            This.Op2(context, KncOpCode.Move, register, context.NullRegister);
            Return New KncValue(register, expression.Type);
        }
        Return This.Default(context, expression.Type);
    }
    Public Safe Function KncValue EmitCallRegisters(KncFunctionContext context, bool builtin, int index, int[] args, TypeSymbol returnType)
    {
        If (args.Length() > 4) { This.Fail("call exceeds the KNC four-argument ABI"); Return New KncValue(255, returnType); }
        int register = returnType.Kind == [int](TypeKind.VoidType) ? 255 : context.Allocate();
        This.SlotOp(context, builtin ? KncOpCode.CallBuiltin : KncOpCode.CallFunc, register, index);
        context.Record.Code.WriteU8(args.Length());
        int i = 0;
        While (i < 4)
        {
            context.Record.Code.WriteU8(i < args.Length() ? args[i] : 255);
            i = i + 1;
        }
        Return New KncValue(register, returnType);
    }
    Public Trusted Function KncValue ArrayLiteral(KncFunctionContext context, HirExpression expression, TypeSymbol type)
    {
        int count = 0;
        HirExpression item = expression.FirstArgument;
        While (item != null) { count = count + 1; item = item.Next; }
        If (type.Kind == [int](TypeKind.ArrayType) && type.ArrayLength > count) count = type.ArrayLength;
        KncValue length = This.Integer(context, count);
        int register = context.Allocate();
        bool package = type.Kind == [int](TypeKind.PackageType);
        TypeSymbol elementType = package ? This.Semantics.Primitive("any") : type.ElementType;
        If (elementType == null) elementType = This.Semantics.Primitive("any");
        This.Op3(context, KncOpCode.NewArray, register, length.Register, package ? 0 : This.ValueKind(elementType));
        int mark = context.NextRegister;
        int index = 0;
        item = expression.FirstArgument;
        While (index < count && !This.Failed())
        {
            TypeSymbol target = package ? type.PackageElement(index) : elementType;
            KncValue position = This.Integer(context, index);
            KncValue value = item == null ? This.Default(context, target) : This.Cast(context, This.CopyValue(context, This.Expression(context, item)), target);
            This.Op3(context, KncOpCode.StoreIndex, register, position.Register, value.Register);
            If (item != null) item = item.Next;
            context.NextRegister = mark;
            index = index + 1;
        }
        Return New KncValue(register, type);
    }
    Public Trusted Function KncLocation Location(KncFunctionContext context, HirExpression expression)
    {
        If (expression.Kind == [int](HirExpressionKind.Local))
        {
            KncLocalBinding local = context.FindBinding(expression.Symbol);
            If (local != null)
                Return New KncLocation(local.CellRegister < 0 ? 0 : 6,
                    local.CellRegister < 0 ? local.Register : local.CellRegister, 0, expression.Type);
            CaptureSymbol capture = This.FindCapture(context, expression.Symbol);
            If (capture != null) Return New KncLocation(7, 0, capture.Index, expression.Type);
            This.Fail("unbound local " + expression.Target);
            Return New KncLocation(0, 0, 0, expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Global))
            Return New KncLocation(1, 0, This.GlobalIndex(expression.Symbol), expression.Type);
        If (expression.Kind == [int](HirExpressionKind.Field))
        {
            KncValue receiver = expression.Left == null ? null : This.Expression(context, expression.Left);
            If (expression.Function != null)
            {
                KncLocation location = New KncLocation(5, 0, 0, expression.Type);
                location.Getter = expression.Function;
                location.Setter = This.Semantics.FindPropertySetter(expression.Function.OwnerType, expression.Target);
                location.Receiver = receiver;
                // Base-qualified properties use the declared accessors, just
                // like Base-qualified method calls; ordinary receivers dispatch.
                location.VirtualDispatch = expression.Left == null || expression.Left.Name != "Base";
                Return location;
            }
            int index = This.FieldIndex(receiver.Type, expression.Target);
            If (index < 0) This.Fail("unknown field: " + expression.Target);
            Return New KncLocation(4, receiver.Register, index, expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Index))
        {
            KncValue receiver = This.Expression(context, expression.Left);
            KncValue index = This.Cast(context, This.Expression(context, expression.Right), This.Semantics.Primitive("int"));
            If (receiver.Type.Kind == [int](TypeKind.PointerType))
            {
                KncValue pointer = This.BinaryOp(context, KncOpCode.AddPtr, receiver, index, receiver.Type);
                Return New KncLocation(3, pointer.Register, 0, expression.Type);
            }
            Return New KncLocation(2, receiver.Register, index.Register, expression.Type);
        }
        If (expression.Kind == [int](HirExpressionKind.Unary) && expression.Operator == TokenKind.Star)
        {
            KncValue pointer = This.Expression(context, expression.Left);
            Return New KncLocation(3, pointer.Register, 0, expression.Type);
        }
        This.Unsupported(context, "lvalue kind " + [string](expression.Kind));
        Return New KncLocation(0, 0, 0, expression.Type);
    }
    Public Trusted Function KncValue Load(KncFunctionContext context, KncLocation location)
    {
        If (location.Kind == 5)
        {
            int[] args = {};
            If (location.Receiver != null) args = args.Add(location.Receiver.Register);
            Return This.PreparedCall(context, location.Getter, args, location.Receiver, location.VirtualDispatch);
        }
        int register = context.Allocate();
        If (location.Kind == 0) This.Op2(context, KncOpCode.Move, register, location.Register);
        ElseIf (location.Kind == 1) This.SlotOp(context, KncOpCode.LoadGlobal, register, location.Index);
        ElseIf (location.Kind == 2) This.Op3(context, KncOpCode.LoadIndex, register, location.Register, location.Index);
        ElseIf (location.Kind == 4) This.FieldOp(context, KncOpCode.LoadField, register, location.Register, location.Index);
        ElseIf (location.Kind == 6) This.Op2(context, KncOpCode.LoadCell, register, location.Register);
        ElseIf (location.Kind == 7) This.SlotOp(context, KncOpCode.LoadCapture, register, location.Index);
        Else This.Op2(context, KncOpCode.LoadPtr, register, location.Register);
        Return New KncValue(register, location.Type);
    }
    Public Trusted Function KncValue Store(KncFunctionContext context, KncLocation location, KncValue value)
    {
        value = This.Cast(context, This.CopyValue(context, value), location.Type);
        If (location.Kind == 5)
        {
            int[] args = {};
            If (location.Receiver != null) args = args.Add(location.Receiver.Register);
            args = args.Add(value.Register);
            This.PreparedCall(context, location.Setter, args, location.Receiver, location.VirtualDispatch);
            Return value;
        }
        If (location.Kind == 0) This.Op2(context, KncOpCode.Move, location.Register, value.Register);
        ElseIf (location.Kind == 1) This.SlotOp(context, KncOpCode.StoreGlobal, value.Register, location.Index);
        ElseIf (location.Kind == 2) This.Op3(context, KncOpCode.StoreIndex, location.Register, location.Index, value.Register);
        ElseIf (location.Kind == 4) This.FieldOp(context, KncOpCode.StoreField, location.Register, value.Register, location.Index);
        ElseIf (location.Kind == 6) This.Op2(context, KncOpCode.StoreCell, location.Register, value.Register);
        ElseIf (location.Kind == 7) This.SlotOp(context, KncOpCode.StoreCapture, value.Register, location.Index);
        Else This.Op2(context, KncOpCode.StorePtr, location.Register, value.Register);
        Return value;
    }
    Public Safe Function TokenKind AssignmentOperator(TokenKind op)
    {
        If (op == TokenKind.PlusAssign) Return TokenKind.Plus;
        If (op == TokenKind.MinusAssign) Return TokenKind.Minus;
        If (op == TokenKind.StarAssign) Return TokenKind.Star;
        If (op == TokenKind.SlashAssign) Return TokenKind.Slash;
        If (op == TokenKind.PercentAssign) Return TokenKind.Percent;
        Return TokenKind.Assign;
    }
    Public Safe Function bool IsAssignment(TokenKind op)
    {
        Return op == TokenKind.Assign || op == TokenKind.PlusAssign || op == TokenKind.MinusAssign || op == TokenKind.StarAssign || op == TokenKind.SlashAssign || op == TokenKind.PercentAssign;
    }
    Public Trusted Function KncValue Calculate(KncFunctionContext context, TokenKind op, KncValue left, KncValue right, TypeSymbol operandType, TypeSymbol resultType)
    {
        If (op == TokenKind.Plus && resultType.Kind == [int](TypeKind.StringType))
        {
            left = This.Cast(context, left, resultType);
            right = This.Cast(context, right, resultType);
            int[] args = {left.Register, right.Register};
            Return This.EmitCallRegisters(context, true, 20, args, resultType);
        }
        // Both values have already been evaluated in source order. Selecting
        // the RHS pointer here must not exchange or re-evaluate expressions.
        If (op == TokenKind.Plus && right.Type.Kind == [int](TypeKind.PointerType) &&
            left.Type.Kind == [int](TypeKind.IntegerType))
        {
            left = This.Cast(context, left, This.Semantics.Primitive("int"));
            Return This.BinaryOp(context, KncOpCode.AddPtr, right, left, resultType);
        }
        If (left.Type.Kind == [int](TypeKind.PointerType) && (op == TokenKind.Plus || op == TokenKind.Minus))
        {
            right = This.Cast(context, right, This.Semantics.Primitive("int"));
            If (op == TokenKind.Minus) right = This.UnaryOp(context, KncOpCode.NegInt, right, right.Type);
            Return This.BinaryOp(context, KncOpCode.AddPtr, left, right, resultType);
        }
        bool comparison = op == TokenKind.Equal || op == TokenKind.NotEqual ||
            op == TokenKind.Less || op == TokenKind.LessEqual || op == TokenKind.Greater || op == TokenKind.GreaterEqual;
        If (operandType == null) operandType = left.Type;
        bool numeric = This.IsInteger(operandType) || operandType.Kind == [int](TypeKind.FloatType);
        If (numeric)
        {
            left = This.Cast(context, left, operandType);
            right = This.Cast(context, right, operandType);
            If (operandType.Name == "char")
            {
                left = This.UnaryOp(context, KncOpCode.CharToInt, left, This.Semantics.Primitive("int"));
                right = This.UnaryOp(context, KncOpCode.CharToInt, right, This.Semantics.Primitive("int"));
            }
        }
        bool floating = operandType.Kind == [int](TypeKind.FloatType);
        bool unsigned = This.IsUnsigned(operandType);
        KncOpCode opcode = KncOpCode.Eq;
        If (op == TokenKind.Equal) opcode = KncOpCode.Eq;
        ElseIf (op == TokenKind.NotEqual) opcode = KncOpCode.Ne;
        ElseIf (op == TokenKind.Plus) opcode = floating ? KncOpCode.AddFloat : KncOpCode.AddInt;
        ElseIf (op == TokenKind.Minus) opcode = floating ? KncOpCode.SubFloat : KncOpCode.SubInt;
        ElseIf (op == TokenKind.Star) opcode = floating ? KncOpCode.MulFloat : KncOpCode.MulInt;
        ElseIf (op == TokenKind.Slash) opcode = floating ? KncOpCode.DivFloat : unsigned ? KncOpCode.UDivInt : KncOpCode.DivInt;
        ElseIf (op == TokenKind.Less) opcode = floating ? KncOpCode.LtFloat : unsigned ? KncOpCode.ULtInt : KncOpCode.LtInt;
        ElseIf (op == TokenKind.LessEqual) opcode = floating ? KncOpCode.LeFloat : unsigned ? KncOpCode.ULeInt : KncOpCode.LeInt;
        ElseIf (op == TokenKind.Greater) opcode = floating ? KncOpCode.GtFloat : unsigned ? KncOpCode.UGtInt : KncOpCode.GtInt;
        ElseIf (op == TokenKind.GreaterEqual) opcode = floating ? KncOpCode.GeFloat : unsigned ? KncOpCode.UGeInt : KncOpCode.GeInt;
        ElseIf (op == TokenKind.Ampersand) opcode = KncOpCode.BitAndInt;
        ElseIf (op == TokenKind.BitOr) opcode = KncOpCode.BitOrInt;
        ElseIf (op == TokenKind.Xor) opcode = KncOpCode.BitXorInt;
        ElseIf (op == TokenKind.ShiftLeft) opcode = KncOpCode.ShlInt;
        ElseIf (op == TokenKind.ShiftRight) opcode = unsigned ? KncOpCode.LShrInt : KncOpCode.ShrInt;
        ElseIf (op == TokenKind.Percent)
        {
            If (floating)
            {
                This.Unsupported(context, "floating-point remainder");
                Return left;
            }
            If (unsigned) opcode = KncOpCode.URemInt;
            Else
            {
                KncValue quotient = This.BinaryOp(context, KncOpCode.DivInt, left, right, operandType);
                KncValue product = This.BinaryOp(context, KncOpCode.MulInt, quotient, right, operandType);
                Return This.Cast(context, This.BinaryOp(context, KncOpCode.SubInt, left, product, operandType), resultType);
            }
        }
        Else { This.Unsupported(context, "binary operator " + [string]([int](op))); Return left; }
        KncValue result = [int](opcode) >= 130 && [int](opcode) <= 136 ?
            This.WidthOp(context, opcode, left, right, resultType, This.IntegerBits(operandType)) :
            This.BinaryOp(context, opcode, left, right, resultType);
        If (comparison) Return result;
        // Arithmetic on char uses Int registers until the explicit storage tag.
        If (resultType.Name == "char") result.Type = This.Semantics.Primitive("int");
        Return This.Cast(context, result, resultType);
    }
    Public Trusted Function KncValue Binary(KncFunctionContext context, HirExpression expression)
    {
        TokenKind op = expression.Operator;
        If (This.IsAssignment(op))
        {
            KncLocation location = This.Location(context, expression.Left);
            KncValue previous = op == TokenKind.Assign ? null : This.Load(context, location);
            KncValue value = This.Expression(context, expression.Right);
            If (previous != null)
            {
                TypeSymbol operandType = expression.OperandType == null ? location.Type : expression.OperandType;
                value = This.Calculate(context, This.AssignmentOperator(op), previous, value, operandType, operandType);
            }
            Return This.Store(context, location, value);
        }
        If (op == TokenKind.AndAnd || op == TokenKind.OrOr)
        {
            KncValue left = This.Cast(context, This.Expression(context, expression.Left), This.Semantics.Primitive("bool"));
            int result = context.Allocate();
            This.Op2(context, KncOpCode.Move, result, left.Register);
            int end = This.Branch(context, op == TokenKind.AndAnd ? KncOpCode.JumpIfFalse : KncOpCode.JumpIfTrue, left.Register);
            KncValue right = This.Cast(context, This.Expression(context, expression.Right), This.Semantics.Primitive("bool"));
            This.Op2(context, KncOpCode.Move, result, right.Register);
            This.Patch(context, end);
            Return New KncValue(result, expression.Type);
        }
        If (op == TokenKind.KwIs) Return This.IsValue(context, This.Expression(context, expression.Left), expression.Right.Type);
        KncValue left = This.Expression(context, expression.Left);
        KncValue right = This.Expression(context, expression.Right);
        Return This.Calculate(context, op, left, right, expression.OperandType, expression.Type);
    }
    Public Trusted Function KncValue Unary(KncFunctionContext context, HirExpression expression)
    {
        TokenKind op = expression.Operator;
        If (op == TokenKind.PlusPlus || op == TokenKind.MinusMinus)
        {
            KncLocation location = This.Location(context, expression.Left);
            KncValue previous = This.Load(context, location);
            KncValue one = location.Type.Kind == [int](TypeKind.PointerType) ?
                This.Integer(context, 1) : This.Cast(context, This.Integer(context, 1), location.Type);
            KncValue next = This.Calculate(context, op == TokenKind.PlusPlus ? TokenKind.Plus : TokenKind.Minus, previous, one, location.Type, location.Type);
            next = This.Store(context, location, next);
            Return expression.Syntax != null && expression.Syntax.IsPostfix ? previous : next;
        }
        If (op == TokenKind.Star) Return This.Load(context, This.Location(context, expression));
        If (op == TokenKind.Ampersand)
        {
            If (expression.Left.Kind == [int](HirExpressionKind.FunctionReference))
            {
                KncFunctionBinding function = This.RequireFunction(expression.Left.Function);
                int register = context.Allocate();
                If (function != null) This.SlotOp(context, KncOpCode.MakePtrFunc, register, function.Index);
                Return New KncValue(register, expression.Type);
            }
            KncLocation location = This.Location(context, expression.Left);
            int register = context.Allocate();
            If (location.Kind == 0) This.Op2(context, KncOpCode.MakePtrLocal, register, location.Register);
            ElseIf (location.Kind == 1) This.SlotOp(context, KncOpCode.MakePtrGlobal, register, location.Index);
            ElseIf (location.Kind == 2) This.Op3(context, KncOpCode.MakePtrIndex, register, location.Register, location.Index);
            ElseIf (location.Kind == 4) This.FieldOp(context, KncOpCode.MakePtrField, register, location.Register, location.Index);
            ElseIf (location.Kind == 6) This.Op2(context, KncOpCode.MakePtrCell, register, location.Register);
            ElseIf (location.Kind == 7)
            {
                int cell = context.Allocate();
                This.SlotOp(context, KncOpCode.LoadCaptureCell, cell, location.Index);
                This.Op2(context, KncOpCode.MakePtrCell, register, cell);
            }
            Else This.Op2(context, KncOpCode.Move, register, location.Register);
            Return New KncValue(register, expression.Type);
        }
        KncValue value = This.Expression(context, expression.Left);
        If (op == TokenKind.Plus) Return value;
        If (op == TokenKind.Not) Return This.UnaryOp(context, KncOpCode.NotBool, This.Cast(context, value, This.Semantics.Primitive("bool")), expression.Type);
        If (op == TokenKind.Minus)
        {
            value = This.Cast(context, value, expression.Type);
            If (value.Type.Name == "char") value = This.UnaryOp(context, KncOpCode.CharToInt, value, This.Semantics.Primitive("int"));
            value = This.UnaryOp(context, value.Type.Kind == [int](TypeKind.FloatType) ? KncOpCode.NegFloat : KncOpCode.NegInt, value, value.Type);
            Return This.Cast(context, value, expression.Type);
        }
        If (op == TokenKind.Tilde)
        {
            value = This.Cast(context, value, This.Semantics.Primitive("int"));
            Return This.Cast(context, This.UnaryOp(context, KncOpCode.BitNotInt, value, value.Type), expression.Type);
        }
        This.Unsupported(context, "unary operator " + [string]([int](op)));
        Return value;
    }
    Public Trusted Function KncValue Conditional(KncFunctionContext context, HirExpression expression)
    {
        KncValue condition = This.Cast(context, This.Expression(context, expression.Left), This.Semantics.Primitive("bool"));
        int result = context.Allocate();
        int mark = context.NextRegister;
        int alternative = This.Branch(context, KncOpCode.JumpIfFalse, condition.Register);
        KncValue left = This.Cast(context, This.Expression(context, expression.Right), expression.Type);
        This.Op2(context, KncOpCode.Move, result, left.Register);
        int end = This.EmitJump(context);

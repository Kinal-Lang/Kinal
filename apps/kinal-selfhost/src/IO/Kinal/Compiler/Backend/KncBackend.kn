        If (update == null || update.Left == null || update.Left.Kind != [int](HirExpressionKind.Local)) Return false;
        ValueSymbol symbol = update.Left.Symbol;
        If (symbol == null || symbol.IsCaptured || !This.IsLoopInteger(symbol.Type)) Return false;
        KncLocalBinding counter = context.FindBinding(symbol);
        If (counter == null || counter.CellRegister >= 0) Return false;
        If (isFor && !This.IsEmptyLoopBody(statement.FirstChild)) Return false;
        int step = This.LoopStep(update, symbol);
        If (step == 0) Return false;
        HirExpression bound = null;
        TokenKind comparison = condition.Operator;
        If (This.IsLoopLocal(condition.Left, symbol)) bound = condition.Right;
        ElseIf (This.IsLoopLocal(condition.Right, symbol))
        {
            bound = condition.Left;
            comparison = This.ReverseLoopComparison(comparison);
        }
        If (bound == null || !This.IsLoopInteger(bound.Type)) Return false;
        If (bound.Kind == [int](HirExpressionKind.Local))
        {
            KncLocalBinding limit = context.FindBinding(bound.Symbol);
            If (bound.Symbol == symbol || bound.Symbol.IsCaptured || limit == null || limit.CellRegister >= 0) Return false;
        }
        ElseIf (bound.Kind != [int](HirExpressionKind.Constant) || bound.Syntax == null ||
            bound.Syntax.Kind != [int](ExpressionKind.Number)) Return false;

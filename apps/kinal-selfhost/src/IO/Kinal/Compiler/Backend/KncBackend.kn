        {
            If (comparison == TokenKind.Less) opcode = KncOpCode.LoopIntLtInc;
            ElseIf (comparison == TokenKind.LessEqual) opcode = KncOpCode.LoopIntLeInc;
            ElseIf (comparison == TokenKind.Equal) opcode = KncOpCode.LoopIntEqInc;
            ElseIf (comparison == TokenKind.NotEqual) opcode = KncOpCode.LoopIntNeInc;
        }
        Else
        {
            If (comparison == TokenKind.Greater) opcode = KncOpCode.LoopIntGtDec;
            ElseIf (comparison == TokenKind.GreaterEqual) opcode = KncOpCode.LoopIntGeDec;
            ElseIf (comparison == TokenKind.Equal) opcode = KncOpCode.LoopIntEqDec;
            ElseIf (comparison == TokenKind.NotEqual) opcode = KncOpCode.LoopIntNeDec;

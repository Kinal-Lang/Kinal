            KncValue pattern = null;
            KncValue condition = null;
            If (statement.DeclaredSymbol != null && statement.Expression != null &&
                statement.Expression.Kind == [int](HirExpressionKind.Binary) && statement.Expression.Operator == TokenKind.KwIs)
            {
                pattern = This.Expression(context, statement.Expression.Left);
                condition = This.IsValue(context, pattern, statement.DeclaredType);
            }
            Else condition = This.Cast(context, This.Expression(context, statement.Expression), This.Semantics.Primitive("bool"));
            int alternative = This.Branch(context, KncOpCode.JumpIfFalse, condition.Register);
            If (pattern != null)
            {
                KncLocalBinding local = context.FindBinding(statement.DeclaredSymbol);
                KncValue value = This.Cast(context, pattern, statement.DeclaredType);
                If (local.CellRegister >= 0) This.Op2(context, KncOpCode.NewCell, local.CellRegister, value.Register);
                Else This.Op2(context, KncOpCode.Move, local.Register, value.Register);
            }
            This.Statements(context, statement.FirstChild);
            int end = This.EmitJump(context);
            This.Patch(context, alternative);
            This.Statements(context, statement.ElseBranch);
            This.Patch(context, end);
            Return;
        }
        If (kind == [int](StatementKind.While) || kind == [int](StatementKind.For))
        {
            This.ForStatement(context, statement, kind == [int](StatementKind.For)); Return;
        }
        If (kind == [int](StatementKind.Foreach)) { This.ForeachStatement(context, statement); Return; }
        If (kind == [int](StatementKind.Switch)) { This.SwitchStatement(context, statement); Return; }
        If (kind == [int](StatementKind.Break) || kind == [int](StatementKind.Continue))
        {
            If (context.Loop == null) { This.Fail("Break/Continue requires enclosing loop"); Return; }
            This.PopHandlers(context, context.Loop.TryDepth);
            If (kind == [int](StatementKind.Break)) context.Loop.BreakPatches.Add(This.EmitJump(context));
            Else context.Loop.ContinuePatches.Add(This.EmitJump(context));
            Return;
        }
        If (kind == [int](StatementKind.Try)) { This.TryStatement(context, statement); Return; }
        If (kind == [int](StatementKind.Throw))
        {
            KncValue value = This.Expression(context, statement.Expression);
            This.Op1(context, KncOpCode.ThrowOp, value.Register);
            Return;
        }
        This.Unsupported(context, "statement kind " + [string](kind));
    }
    Public Trusted Function void BuildFunction(KncFunctionBinding binding)
    {
        binding.Built = true;
        KncFunctionContext context = New KncFunctionContext(binding, binding.Record);
        If (binding.Symbol.IsBlockLiteral) { context.Allocate(); context.Allocate(); }
        If (This.HasInstanceReceiver(binding.Symbol)) context.AddLocal(binding.Symbol.Receiver);
        ParameterSymbol parameter = binding.Symbol.FirstParameter;
        While (parameter != null) { context.AddLocal(parameter.Value); parameter = parameter.Next; }
        // An immutable fresh register gives null a stable source after scratch
        // register reuse, including repeated declarations inside loops.
        context.NullRegister = context.Allocate();
        This.AllocateLocals(context, binding.Hir.Body);
        context.ReserveCells();
        int parameterMark = context.NextRegister;
        parameter = binding.Symbol.FirstParameter;
        While (parameter != null)
        {
            If (This.IsInteger(parameter.Type) || parameter.Type.Kind == [int](TypeKind.FloatType) || parameter.Type.Kind == [int](TypeKind.BoolType))
            {
                int register = context.FindLocal(parameter.Value);
                KncValue converted = This.DynamicScalarCast(context, New KncValue(register, This.Semantics.Primitive("any")), parameter.Type);
                This.Op2(context, KncOpCode.Move, register, converted.Register);
                context.NextRegister = parameterMark;
            }
            parameter = parameter.Next;
        }
        This.InitializeParameterCells(context);
        If (binding.Symbol.IsBlockLiteral) This.EmitBlockBody(context, binding.Hir.Body, 0, 1);
        Else This.Statements(context, binding.Hir.Body);
        If (!This.Failed())
        {
            KncValue value = This.Default(context, binding.Symbol.ReturnType);
            This.Op1(context, KncOpCode.Ret, value.Register);
        }
        If (context.Error != "") This.Fail(context.Error + ": " + binding.Record.Name);
        If (binding.Record.Code.Error != "") This.Fail(binding.Record.Code.Error + ": " + binding.Record.Name);
    }
    Public Trusted Function bool EmitListing(string outputPath)
    {
        If (This.Failed()) Return false;
        If (!This.Lowered)
        {
            This.Fail("emit bytecode before requesting its compiler listing");
            Return false;
        }
        If (!This.Program.EmitListing(outputPath))
        {
            This.Fail(This.Program.Error);
            Return false;
        }
        Return true;
    }
    Public Trusted Function bool Emit(string outputPath)
    {
        If (This.Failed()) Return false;
        If (This.Lowered)
        {
            If (!This.Program.Emit(outputPath)) { This.Fail(This.Program.Error); Return false; }
            Return true;
        }
        If (This.Semantics.Session.HasErrors()) { This.Fail("semantic compilation has errors"); Return false; }
        FunctionSymbol main = This.Semantics.FirstFunction;
        While (main != null && !(main.OwnerType == null && main.Name == "Main" && main.UnitName == This.Semantics.Session.EntryUnitName)) main = main.Next;
        If (main == null) { This.Fail("entry unit does not declare Main"); Return false; }
        If (main.ParameterCount() > 1 || (main.ParameterCount() == 1 &&
            (main.FirstParameter.Type.Kind != [int](TypeKind.ArrayType) ||
             main.FirstParameter.Type.ElementType.Kind != [int](TypeKind.StringType))))
        { This.Fail("KNC entry Main must take zero parameters or string[]"); Return false; }
        KncFunctionRecord entry = New KncFunctionRecord();
        entry.Name = "__knc_entry";
        entry.ReturnKind = This.ValueKind(main.ReturnType);
        This.Program.EntryFunction = This.Program.AddFunction(entry);
        KncFunctionContext context = New KncFunctionContext(null, entry);
        context.NullRegister = context.Allocate();
        GlobalSymbol global = This.Semantics.FirstGlobal;
        KncGlobalBinding lastGlobal = null;
        While (global != null)
        {
            KncGlobalBinding binding = New KncGlobalBinding(global, This.FindInitializer(global), This.Program.GlobalCount);
            This.Program.GlobalCount = This.Program.GlobalCount + 1;
            If (This.FirstGlobal == null) This.FirstGlobal = binding;
            Else lastGlobal.Next = binding;
            lastGlobal = binding;
            global = global.Next;
        }
        KncGlobalBinding globalBinding = This.FirstGlobal;
        While (globalBinding != null && !This.Failed())
        {
            TypeSymbol type = globalBinding.Symbol.Value.Type;
            HirExpression initializer = globalBinding.Initializer;
            KncValue value = globalBinding.Symbol.Value.CallableFunction != null ?
                This.FunctionValue(context, globalBinding.Symbol.Value.CallableFunction, type) : initializer == null ? This.Default(context, type) :
                initializer.Kind == [int](HirExpressionKind.ArrayLiteral) || initializer.Kind == [int](HirExpressionKind.PackageLiteral) ?
                    This.ArrayLiteral(context, initializer, type) : This.Expression(context, initializer);
            value = This.Cast(context, This.CopyValue(context, value), type);
            This.SlotOp(context, KncOpCode.StoreGlobal, value.Register, globalBinding.Index);
            context.NextRegister = 1;
            globalBinding = globalBinding.Next;
        }
        KncFunctionBinding mainBinding = This.RequireFunction(main);
        If (mainBinding != null)
        {
            int[] args = {};
            // KinalVM currently exposes no process argument injection ABI.
            // An ordinary no-argument VM invocation still gets a valid empty
            // string[] rather than an uninitialized register.
            If (main.ParameterCount() == 1) args = args.Add(This.Default(context, main.FirstParameter.Type).Register);
            KncValue value = This.EmitCallRegisters(context, false, mainBinding.Index, args, main.ReturnType);
            This.Op1(context, KncOpCode.Ret, value.Register);
        }
        KncFunctionBinding function = This.FirstFunction;
        While (function != null && !This.Failed())
        {
            This.BuildFunction(function);
            function = function.Next;
        }
        If (context.Error != "") This.Fail(context.Error);
        If (This.Failed()) Return false;
        This.Lowered = true;
        If (!This.Program.Emit(outputPath)) { This.Fail(This.Program.Error); Return false; }
        Return true;
    }
    Public Safe Function int InstanceFieldCount(TypeSymbol type)
    {
        If (type != null && type.Name == "IO.Error") Return 4;
        If (type == null || type.Declaration == null) Return 0;
        int count = This.InstanceFieldCount(type.BaseType);
        FieldDecl field = type.Declaration.FirstField;
        While (field != null) { If (!field.IsStatic) count = count + 1; field = field.Next; }
        Return count;
    }
    Public Safe Function int FieldIndex(TypeSymbol type, string name)
    {
        If (type != null && type.Name == "IO.Error")
        {
            If (name == "Title") Return 0;
            If (name == "Message") Return 1;
            If (name == "Inner") Return 2;
            If (name == "Trace") Return 3;
        }
        If (type == null || type.Declaration == null) Return -1;
        int inherited = This.FieldIndex(type.BaseType, name);
        If (inherited >= 0) Return inherited;
        int index = This.InstanceFieldCount(type.BaseType);
        FieldDecl field = type.Declaration.FirstField;
        While (field != null)
        {
            If (!field.IsStatic)
            {
                If (field.Name == name) Return index;
                index = index + 1;
            }
            field = field.Next;
        }
        Return -1;
    }
    Public Safe Function KncTypeBinding RequireType(TypeSymbol type)
    {
        If (type != null && type.Name == "Object.Function") type = This.Semantics.FindExactType("IO.Type.Object.Function");
        If (type != null && type.Name == "Object.Block") type = This.Semantics.FindExactType("IO.Type.Object.Block");
        KncTypeBinding current = This.FirstType;
        While (current != null) { If (current.Type == type) Return current; current = current.Next; }
        If (type == null || (type.Declaration == null && type.Name != "IO.Error" && type.Name != "IO.Type.Object.Function" && type.Name != "IO.Type.Object.Block"))
        {
            This.Fail("KNC object requires declared type metadata: " + (type == null ? "null" : type.Name));
            Return null;
        }
        KncTypeRecord record = New KncTypeRecord();
        record.Name = type.QualifiedName();
        record.Kind = This.Semantics.IsStructType(type) ? 2 : This.Semantics.IsInterfaceType(type) ? 3 : 1;
        record.FieldCount = type.Name == "IO.Type.Object.Function" || type.Name == "IO.Type.Object.Block" ? 2 : This.InstanceFieldCount(type);
        KncTypeBinding binding = New KncTypeBinding(type, record, This.Program.AddType(record));
        binding.Next = This.FirstType;
        This.FirstType = binding;
        If (type.BaseType != null)
        {
            KncTypeBinding base = This.RequireType(type.BaseType);
            If (base != null) record.BaseTypeIndex = base.Index;
        }
        TypeSymbol interfaceType = This.Semantics.FirstType;
        While (interfaceType != null)
        {
            If (interfaceType != type && This.Semantics.IsInterfaceType(interfaceType) && This.Semantics.TypeImplementsInterface(type, interfaceType))
            {
                KncTypeBinding implemented = This.RequireType(interfaceType);
                If (implemented != null) record.InterfaceTypes = record.InterfaceTypes.Add(implemented.Index);
            }
            interfaceType = interfaceType.Next;
        }
        If (record.Kind != 3)
        {
            int slot = 0;
            int interfaceCount = This.InterfaceSlotCount();
            While (slot < interfaceCount)
            {
                FunctionSymbol declaration = This.InterfaceSlotDeclaration(slot);
                FunctionSymbol implementation = declaration == null || !This.Semantics.TypeImplementsInterface(type, declaration.OwnerType) ? null : This.Semantics.FindMethodSignature(type, declaration);
                KncFunctionBinding function = implementation == null || implementation.Declaration.IsAbstract ? null : This.RequireFunction(implementation);
                record.VTable = record.VTable.Add(function == null ? -1 : function.Index);
                slot = slot + 1;
            }
            int virtualSlot = 0;
            While (virtualSlot < This.VirtualSlotCount(type))
            {
                FunctionSymbol declaration = This.VirtualSlotDeclaration(type, virtualSlot);
                FunctionSymbol implementation = This.VirtualImplementation(type, declaration);
                KncFunctionBinding function = implementation == null || implementation.Declaration.IsAbstract ? null : This.RequireFunction(implementation);
                record.VTable = record.VTable.Add(function == null ? -1 : function.Index);
                virtualSlot = virtualSlot + 1;
            }
        }
        Return binding;
    }
    Public Safe Function void FieldOp(KncFunctionContext context, KncOpCode op, int a, int b, int field)
    {
        This.Op2(context, op, a, b);
        context.Record.Code.WriteU16(field);
    }
    Public Trusted Function void InitializeFields(KncFunctionContext context, KncValue object, TypeSymbol type)
    {
        If (type == null || type.Declaration == null) Return;
        This.InitializeFields(context, object, type.BaseType);
        FieldDecl field = type.Declaration.FirstField;
        int index = This.InstanceFieldCount(type.BaseType);
        int mark = context.NextRegister;
        While (field != null && !This.Failed())
        {
            If (!field.IsStatic)
            {
                TypeSymbol fieldType = This.Semantics.ResolveFieldType(type.Syntax, field);
                // Reference fields retain null in zero-initialized aggregates;
                // value fields and explicitly fixed arrays get typed storage.
                bool valueField = This.IsInteger(fieldType) || fieldType.Kind == [int](TypeKind.BoolType) ||
                    fieldType.Kind == [int](TypeKind.FloatType) || This.Semantics.IsStructType(fieldType) ||
                    (fieldType.Kind == [int](TypeKind.ArrayType) && fieldType.ArrayLength >= 0);
                If (valueField)
                {
                    KncValue value = This.Default(context, fieldType);
                    This.FieldOp(context, KncOpCode.StoreField, object.Register, value.Register, index);
                }
                index = index + 1;
                context.NextRegister = mark;
            }
            field = field.Next;
        }
    }
    Public Trusted Function KncValue NewValue(KncFunctionContext context, TypeSymbol type)
    {
        KncTypeBinding binding = This.RequireType(type);
        int register = context.Allocate();
        KncValue value = New KncValue(register, type);
        If (binding == null) Return value;
        This.SlotOp(context, KncOpCode.NewObject, register, binding.Index);
        This.InitializeFields(context, value, type);
        Return value;
    }
    Public Trusted Function KncValue CopyValue(KncFunctionContext context, KncValue value)
    {
        If (!This.Semantics.IsStructType(value.Type)) Return value;
        KncTypeBinding binding = This.RequireType(value.Type);
        If (binding == null) Return value;
        int register = context.Allocate();
        This.SlotOp(context, KncOpCode.NewObject, register, binding.Index);
        int mark = context.NextRegister;
        FieldDecl field = value.Type.Declaration.FirstField;
        int index = 0;
        While (field != null && !This.Failed())
        {
            If (!field.IsStatic)
            {
                TypeSymbol type = This.Semantics.ResolveFieldType(value.Type.Syntax, field);
                int fieldRegister = context.Allocate();
                This.FieldOp(context, KncOpCode.LoadField, fieldRegister, value.Register, index);
                KncValue copied = This.CopyValue(context, New KncValue(fieldRegister, type));
                This.FieldOp(context, KncOpCode.StoreField, register, copied.Register, index);
                context.NextRegister = mark;
                index = index + 1;
            }
            field = field.Next;
        }
        Return New KncValue(register, value.Type);
    }
    Public Trusted Function KncValue NewObject(KncFunctionContext context, HirExpression expression)
    {
        KncValue value = This.NewValue(context, expression.Type);
        If (expression.Type.Name == "IO.Error")
        {
            HirExpression first = expression.FirstArgument;
            KncValue title = first == null ? This.String(context, "Error") : This.Cast(context, This.Expression(context, first), This.Semantics.Primitive("string"));
            KncValue detail = first == null || first.Next == null ? This.String(context, "") : This.Cast(context, This.Expression(context, first.Next), This.Semantics.Primitive("string"));
            This.FieldOp(context, KncOpCode.StoreField, value.Register, title.Register, 0);
            This.FieldOp(context, KncOpCode.StoreField, value.Register, detail.Register, 1);
            Return value;
        }
        If (expression.Function != null) This.BoundCall(context, expression.Function, expression.FirstArgument, value, false);
        Return value;
    }
    Public Safe Function bool IsVirtualMethod(FunctionSymbol symbol)
    {
        Return symbol != null && !symbol.Declaration.IsStatic &&
            !symbol.Declaration.IsConstructor &&
            (symbol.Declaration.IsAbstract || symbol.Declaration.IsVirtual ||
             symbol.Declaration.IsOverride);
    }

    Public Safe Function int InterfaceSlotCount()
    {
        int count = 0;
        FunctionSymbol method = This.Semantics.FirstFunction;
        While (method != null)
        {
            If (This.Semantics.IsInterfaceType(method.OwnerType) &&
                !method.Declaration.IsStatic &&
                !method.Declaration.IsConstructor)
                count = count + 1;
            method = method.Next;
        }
        Return count;
    }

    Public Safe Function int InterfaceSlot(FunctionSymbol target)
    {
        If (target == null) Return -1;
        int slot = 0;
        FunctionSymbol method = This.Semantics.FirstFunction;
        While (method != null)
        {
            If (This.Semantics.IsInterfaceType(method.OwnerType) &&
                !method.Declaration.IsStatic &&
                !method.Declaration.IsConstructor)
            {
                If (method == target) Return slot;
                slot = slot + 1;
            }
            method = method.Next;
        }
        Return -1;
    }

    Public Safe Function FunctionSymbol InterfaceSlotDeclaration(int targetSlot)
    {
        If (targetSlot < 0) Return null;
        int slot = 0;
        FunctionSymbol method = This.Semantics.FirstFunction;
        While (method != null)
        {
            If (This.Semantics.IsInterfaceType(method.OwnerType) &&
                !method.Declaration.IsStatic &&
                !method.Declaration.IsConstructor)
            {
                If (slot == targetSlot) Return method;
                slot = slot + 1;
            }
            method = method.Next;
        }
        Return null;
    }

    Public Safe Function int DispatchSlot(TypeSymbol owner,
                                           FunctionSymbol method)
    {
        If (This.Semantics.IsInterfaceType(owner))
            Return This.InterfaceSlot(method);
        int virtualSlot = This.VirtualSlot(owner, method);
        Return virtualSlot < 0 ? -1 :
            This.InterfaceSlotCount() + virtualSlot;
    }

    Public Safe Function int VirtualSlotCount(TypeSymbol type)
    {
        If (type == null) Return 0;
        int count = This.VirtualSlotCount(type.BaseType);
        FunctionSymbol method = This.Semantics.FirstFunction;
        While (method != null)
        {
            If (method.OwnerType == type && This.IsVirtualMethod(method))
            {
                FunctionSymbol inherited = This.Semantics.FindMethod(type.BaseType,
                    method.Name, method.ParameterCount());
                If (!This.IsVirtualMethod(inherited)) count = count + 1;
            }
            method = method.Next;
        }
        Return count;
    }

    Public Safe Function int VirtualSlot(TypeSymbol owner, FunctionSymbol method)
    {
        If (owner == null || method == null) Return -1;
        FunctionSymbol inherited = This.Semantics.FindMethod(owner.BaseType,
            method.Name, method.ParameterCount());
        If (This.IsVirtualMethod(inherited)) Return This.VirtualSlot(owner.BaseType, inherited);
        int slot = This.VirtualSlotCount(owner.BaseType);
        FunctionSymbol current = This.Semantics.FirstFunction;
        While (current != null)
        {
            If (current.OwnerType == owner && This.IsVirtualMethod(current))
            {
                FunctionSymbol currentInherited = This.Semantics.FindMethod(owner.BaseType,
                    current.Name, current.ParameterCount());
                If (!This.IsVirtualMethod(currentInherited))
                {
                    If (current == method) Return slot;
                    slot = slot + 1;
                }
            }
            current = current.Next;
        }
        Return -1;
    }

    Public Safe Function FunctionSymbol VirtualSlotDeclaration(TypeSymbol type, int slot)
    {
        If (type == null || slot < 0) Return null;
        int inheritedCount = This.VirtualSlotCount(type.BaseType);
        If (slot < inheritedCount) Return This.VirtualSlotDeclaration(type.BaseType, slot);
        int currentSlot = inheritedCount;
        FunctionSymbol method = This.Semantics.FirstFunction;
        While (method != null)
        {
            If (method.OwnerType == type && This.IsVirtualMethod(method))
            {
                FunctionSymbol inherited = This.Semantics.FindMethod(type.BaseType,
                    method.Name, method.ParameterCount());
                If (!This.IsVirtualMethod(inherited))
                {
                    If (currentSlot == slot) Return method;
                    currentSlot = currentSlot + 1;
                }
            }
            method = method.Next;
        }
        Return null;
    }

    Public Safe Function FunctionSymbol VirtualImplementation(TypeSymbol type,
                                                               FunctionSymbol declaration)
    {
        TypeSymbol current = type;
        While (current != null)
        {
            FunctionSymbol method = This.Semantics.FindDirectMethod(current,
                declaration.Name, declaration.ParameterCount());
            If (This.IsVirtualMethod(method)) Return method;
            current = current.BaseType;
        }
        Return declaration;
    }

    Public Trusted Function KncValue PreparedCall(KncFunctionContext context, FunctionSymbol function, int[] args, KncValue receiver, bool virtualDispatch)
    {
        If (function == null) { This.Fail("call has no bound function"); Return New KncValue(255, This.Semantics.Primitive("void")); }
        bool dispatch = virtualDispatch && receiver != null &&
            (This.IsVirtualMethod(function) || This.Semantics.IsInterfaceType(function.OwnerType));
        int intrinsic = This.IntrinsicId(function);
        KncFunctionBinding binding = intrinsic >= 0 || dispatch ? null : This.RequireFunction(function);
        If (intrinsic < 0 && !dispatch && binding == null) Return This.Default(context, function.ReturnType);
        If (dispatch)
        {
            If (args.Length() > 4) { This.Fail("method call exceeds the KNC four-argument ABI"); Return This.Default(context, function.ReturnType); }
            int slot = This.DispatchSlot(function.OwnerType, function);
            If (slot < 0) { This.Fail("missing virtual slot: " + function.QualifiedName()); Return This.Default(context, function.ReturnType); }
            int register = function.ReturnType.Kind == [int](TypeKind.VoidType) ? 255 : context.Allocate();
            This.Op2(context, KncOpCode.CallVirt, register, receiver.Register);
            context.Record.Code.WriteU16(slot);
            context.Record.Code.WriteU8(args.Length() - 1);
            int index = 1;
            While (index < 4) { context.Record.Code.WriteU8(index < args.Length() ? args[index] : 255); index = index + 1; }
            Return New KncValue(register, function.ReturnType);
        }
        Return This.EmitCallRegisters(context, intrinsic >= 0, intrinsic >= 0 ? intrinsic : binding.Index, args, function.ReturnType);
    }
    Public Trusted Function KncValue BoundCall(KncFunctionContext context, FunctionSymbol function, HirExpression argument, KncValue receiver, bool virtualDispatch)
    {
        If (function == null) { This.Fail("call has no bound function"); Return New KncValue(255, This.Semantics.Primitive("void")); }
        int[] args = {};
        If (This.HasInstanceReceiver(function))
        {
            If (receiver == null) { This.Fail("instance call has no receiver: " + function.QualifiedName()); Return This.Default(context, function.ReturnType); }
            args = args.Add(receiver.Register);
        }
        ParameterSymbol parameter = function.FirstParameter;
        While (argument != null && !This.Failed())
        {
            TypeSymbol target = parameter == null ? argument.Type : parameter.Type;
            KncValue value = (argument.Kind == [int](HirExpressionKind.ArrayLiteral) || argument.Kind == [int](HirExpressionKind.PackageLiteral)) ?
                This.ArrayLiteral(context, argument, target) : This.Cast(context, This.CopyValue(context, This.Expression(context, argument)), target);
            args = args.Add(value.Register);
            argument = argument.Next;
            If (parameter != null) parameter = parameter.Next;
        }
        Return This.PreparedCall(context, function, args, receiver, virtualDispatch);
    }
    Public Trusted Function KncValue IsValue(KncFunctionContext context, KncValue value, TypeSymbol target)
    {
        If (value.Type.Kind != [int](TypeKind.AnyType) &&
            ((This.IsInteger(value.Type) && This.IsInteger(target)) ||
             (value.Type.Kind == [int](TypeKind.FloatType) && target.Kind == [int](TypeKind.FloatType))))
        {
            int register = context.Allocate();
            This.Op2(context, KncOpCode.LoadBool, register, This.Semantics.SameType(value.Type, target) ? 1 : 0);
            Return New KncValue(register, This.Semantics.Primitive("bool"));
        }
        int kind = 0;
        int payload = 0;
        If (target.Kind == [int](TypeKind.BoolType)) kind = 1;
        ElseIf (target.Name == "char") kind = 2;
        ElseIf (This.IsInteger(target)) kind = 3;
        ElseIf (target.Kind == [int](TypeKind.FloatType)) kind = 4;
        ElseIf (target.Kind == [int](TypeKind.StringType)) kind = 5;
        ElseIf (target.Kind == [int](TypeKind.NamedType))
        {
            KncTypeBinding binding = This.RequireType(target);
            If (binding == null) Return This.Default(context, This.Semantics.Primitive("bool"));
            kind = 6;
            payload = binding.Index;
        }
        int register = context.Allocate();
        This.Op3(context, KncOpCode.IsType, register, value.Register, kind);
        context.Record.Code.WriteU16(payload);
        Return New KncValue(register, This.Semantics.Primitive("bool"));
    }
    Public Trusted Function KncValue CheckedObjectCast(KncFunctionContext context, KncValue value, TypeSymbol target)
    {
        If (value.Type.Kind == [int](TypeKind.NullType) ||
            (value.Type.Kind != [int](TypeKind.AnyType) && This.Semantics.IsAssignable(target, value.Type)))
            Return New KncValue(value.Register, target);
        KncValue nullValue = New KncValue(context.NullRegister, This.Semantics.Primitive("any"));
        KncValue isNull = This.BinaryOp(context, KncOpCode.Eq, value, nullValue, This.Semantics.Primitive("bool"));
        int nullEnd = This.Branch(context, KncOpCode.JumpIfTrue, isNull.Register);
        KncValue matches = This.IsValue(context, value, target);
        int success = This.Branch(context, KncOpCode.JumpIfTrue, matches.Register);
        TypeSymbol errorType = This.Semantics.FindExactType("IO.Error");
        KncValue error = This.NewValue(context, errorType);
        KncValue title = This.String(context, "Invalid Cast");
        KncValue detail = This.String(context, "Cannot cast " + value.Type.Name + " to " + target.Name);
        This.FieldOp(context, KncOpCode.StoreField, error.Register, title.Register, This.FieldIndex(errorType, "Title"));
        This.FieldOp(context, KncOpCode.StoreField, error.Register, detail.Register, This.FieldIndex(errorType, "Message"));
        This.Op1(context, KncOpCode.ThrowOp, error.Register);
        This.Patch(context, success);
        This.Patch(context, nullEnd);
        Return New KncValue(value.Register, target);
    }

    Public Safe Function void PopHandlers(KncFunctionContext context, int targetDepth)
    {
        int depth = context.TryDepth;
        While (depth > targetDepth)
        {
            context.Record.Code.WriteU8([int](KncOpCode.PopTry));
            depth = depth - 1;
        }
    }
    Public Trusted Function void TryStatement(KncFunctionContext context, HirStatement statement)
    {
        HirStatement handler = statement.ElseBranch;
        If (handler == null) { This.Statements(context, statement.FirstChild); Return; }
        int register = handler.DeclaredSymbol == null ? 255 : context.FindLocal(handler.DeclaredSymbol);
        int kind = 5;
        int payload = 0;
        If (handler.DeclaredType != null && handler.DeclaredType.Kind != [int](TypeKind.StringType))
        {
            KncTypeBinding type = This.RequireType(handler.DeclaredType);
            If (type == null) Return;
            kind = 6;
            payload = type.Index;
        }
        This.Op2(context, KncOpCode.PushTry, register, kind);
        context.Record.Code.WriteU16(payload);
        int catchPatch = context.Record.Code.Count;
        context.Record.Code.WriteU16(0);
        context.TryDepth = context.TryDepth + 1;
        This.Statements(context, statement.FirstChild);
        context.TryDepth = context.TryDepth - 1;
        context.Record.Code.WriteU8([int](KncOpCode.PopTry));
        int end = This.EmitJump(context);
        This.Patch(context, catchPatch);
        KncLocalBinding caught = context.FindBinding(handler.DeclaredSymbol);
        If (caught != null && caught.CellRegister >= 0)
            This.Op2(context, KncOpCode.NewCell, caught.CellRegister, caught.Register);
        This.Statements(context, handler.FirstChild);
        This.Patch(context, end);
    }
    Public Trusted Function void InitializeArrayValues(KncFunctionContext context, KncValue array, KncValue length, bool copyExisting)
    {
        TypeSymbol elementType = array.Type.ElementType;
        If (elementType == null || (!This.Semantics.IsStructType(elementType) &&
            !(elementType.Kind == [int](TypeKind.ArrayType) && elementType.ArrayLength >= 0))) Return;
        int mark = context.NextRegister;
        KncValue index = This.Integer(context, 0);
        KncValue one = This.Integer(context, 1);
        int start = context.Record.Code.Count;
        KncValue condition = This.BinaryOp(context, KncOpCode.LtInt, index, length, This.Semantics.Primitive("bool"));
        int end = This.Branch(context, KncOpCode.JumpIfFalse, condition.Register);
        KncValue item = copyExisting ? This.CopyValue(context, This.BinaryOp(context, KncOpCode.LoadIndex, array, index, elementType)) : This.Default(context, elementType);
        This.Op3(context, KncOpCode.StoreIndex, array.Register, index.Register, item.Register);
        This.Op3(context, KncOpCode.AddInt, index.Register, index.Register, one.Register);
        int back = This.EmitJump(context);
        context.Record.Code.PatchU16(back, start);
        This.Patch(context, end);
        context.NextRegister = mark;
    }
    Public Trusted Function KncValue DynamicScalarCast(KncFunctionContext context, KncValue value, TypeSymbol target)
    {
        int register = context.Allocate();
        int mark = context.NextRegister;
        list ends = list.Create();
        string[] names = {"bool", "char", "int", "float", "string"};
        int index = 0;
        While (index < names.Length() && !This.Failed())
        {
            TypeSymbol source = This.Semantics.Primitive(names[index]);
            KncValue matches = This.IsValue(context, value, source);
            int next = This.Branch(context, KncOpCode.JumpIfFalse, matches.Register);
            KncValue converted = This.Cast(context, New KncValue(value.Register, source), target);
            This.Op2(context, KncOpCode.Move, register, converted.Register);
            ends.Add(This.EmitJump(context));
            This.Patch(context, next);
            context.NextRegister = mark;
            index = index + 1;
        }
        KncValue fallback = This.Default(context, target);
        This.Op2(context, KncOpCode.Move, register, fallback.Register);
        This.PatchList(context, ends);
        context.NextRegister = mark;
        Return New KncValue(register, target);
    }
    Public Safe Function CaptureSymbol FindCapture(KncFunctionContext context, ValueSymbol value)
    {
        If (context.Binding == null) Return null;
        CaptureSymbol capture = context.Binding.Symbol.FirstCapture;
        While (capture != null)
        {
            If (capture.Value == value) Return capture;
            capture = capture.Next;
        }
        Return null;
    }
    Public Safe Function void InitializeParameterCells(KncFunctionContext context)
    {
        KncLocalBinding local = context.FirstLocal;
        While (local != null)
        {
            If (local.CellRegister >= 0 && local.Symbol.IsParameter)
                This.Op2(context, KncOpCode.NewCell, local.CellRegister, local.Register);
            local = local.Next;
        }
    }
    Public Trusted Function KncValue FunctionValue(KncFunctionContext context, FunctionSymbol function, TypeSymbol type)
    {
        If (function == null) { This.Fail("missing callable function"); Return This.Default(context, type); }
        If (This.HasInstanceReceiver(function)) { This.Unsupported(context, "bound instance method reference"); Return This.Default(context, type); }
        KncTypeBinding objectType = This.RequireType(This.Semantics.FindExactType(function.IsBlockLiteral ? "IO.Type.Object.Block" : "IO.Type.Object.Function"));
        int intrinsic = This.IntrinsicId(function);
        KncFunctionBinding binding = intrinsic >= 0 ? null : This.RequireFunction(function);
        int register = context.Allocate();
        If (objectType == null || (intrinsic < 0 && binding == null)) Return New KncValue(register, type);
        int environment = 255;
        If (function.FirstCapture != null)
        {
            int count = function.CaptureCount();
            KncValue length = This.Integer(context, count);
            environment = context.Allocate();
            This.Op3(context, KncOpCode.NewArray, environment, length.Register, 0);
            int mark = context.NextRegister;
            CaptureSymbol capture = function.FirstCapture;
            While (capture != null && !This.Failed())
            {
                int cell = -1;
                KncLocalBinding local = context.FindBinding(capture.Source);
                If (local != null) cell = local.CellRegister;
                Else
                {
                    CaptureSymbol inherited = This.FindCapture(context, capture.Source);
                    If (inherited != null)
                    {
                        cell = context.Allocate();
                        This.SlotOp(context, KncOpCode.LoadCaptureCell, cell, inherited.Index);
                    }
                }
                If (cell < 0) { This.Fail("capture has no shared storage: " + capture.Name); Break; }
                KncValue position = This.Integer(context, capture.Index);
                This.Op3(context, KncOpCode.StoreIndex, environment, position.Register, cell);
                context.NextRegister = mark;
                capture = capture.Next;
            }
        }
        This.SlotOp(context, KncOpCode.MakeFunc, register, objectType.Index);
        context.Record.Code.WriteU8(intrinsic >= 0 ? 1 : 0);
        context.Record.Code.WriteU16(intrinsic >= 0 ? intrinsic : binding.Index);
        context.Record.Code.WriteU8(environment);
        KncValue result = New KncValue(register, type);
        result.IsCallable = !function.IsBlockLiteral;
        Return result;
    }
    Public Trusted Function KncValue DynamicCall(KncFunctionContext context, HirExpression expression)
    {
        If (expression.Left == null) { This.Unsupported(context, "delegate storage call"); Return This.Default(context, expression.Type); }
        KncValue callable = This.Expression(context, expression.Left);
        int[] args = {};
        HirExpression argument = expression.FirstArgument;
        ParameterSymbol parameter = expression.Function == null ? null : expression.Function.FirstParameter;
        While (argument != null && !This.Failed())
        {
            TypeSymbol target = parameter == null ? argument.Type : parameter.Type;
            KncValue value = This.CopyValue(context, This.Expression(context, argument));
            If (target != null) value = This.Cast(context, value, target);
            args = args.Add(value.Register);
            argument = argument.Next;
            If (parameter != null) parameter = parameter.Next;
        }
        If (args.Length() > 4) { This.Fail("function-object call exceeds the KNC four-argument ABI"); Return This.Default(context, expression.Type); }
        int register = expression.Type.Kind == [int](TypeKind.VoidType) ? 255 : context.Allocate();
        This.Op3(context, KncOpCode.CallClosure, register, callable.Register, args.Length());
        int index = 0;
        While (index < 4) { context.Record.Code.WriteU8(index < args.Length() ? args[index] : 255); index = index + 1; }
        Return New KncValue(register, expression.Type);
    }
    Public Trusted Function KncValue PackageArrayCast(KncFunctionContext context, KncValue value, TypeSymbol target)
    {
        KncValue length = This.Integer(context, value.Type.PackageCount);
        int register = context.Allocate();
        This.Op3(context, KncOpCode.NewArray, register, length.Register, This.ValueKind(target.ElementType));
        int mark = context.NextRegister;
        int index = 0;
        While (index < value.Type.PackageCount && !This.Failed())
        {
            KncValue position = This.Integer(context, index);
            KncValue item = This.BinaryOp(context, KncOpCode.LoadIndex, value, position, value.Type.PackageElement(index));
            item = This.Cast(context, This.CopyValue(context, item), target.ElementType);
            This.Op3(context, KncOpCode.StoreIndex, register, position.Register, item.Register);
            context.NextRegister = mark;
            index = index + 1;
        }
        Return New KncValue(register, target);
    }
    Public Safe Function void RegisterBlockRecords(KncBlockBinding block, HirStatement statement)
    {
        While (statement != null)
        {
            If (statement.Kind == [int](StatementKind.Record))
            {
                KncRecordBinding record = New KncRecordBinding(statement.Name, block.RecordCount + 1);
                block.RecordCount = block.RecordCount + 1;
                If (block.FirstRecord == null) block.FirstRecord = record;
                Else block.LastRecord.Next = record;
                block.LastRecord = record;
            }
            If (statement.Kind != [int](StatementKind.UnsafeBlock))
            {
                This.RegisterBlockRecords(block, statement.FirstChild);
                This.RegisterBlockRecords(block, statement.ElseBranch);
            }
            statement = statement.Next;
        }
    }
    Public Safe Function void RegisterLocalBlock(KncFunctionContext context, HirStatement statement)
    {
        KncBlockBinding block = New KncBlockBinding(statement.Name, statement);
        block.Next = context.FirstBlock;
        context.FirstBlock = block;
        KncLocalBinding local = context.FindBinding(statement.DeclaredSymbol);
        If (local != null && local.CellRegister >= 0)
            This.Op2(context, KncOpCode.NewCell, local.CellRegister, context.NullRegister);
    }
    Public Safe Function void RecordJump(KncFunctionContext context, KncRecordBinding record, int patch)
    {
        If (record.Position >= 0) context.Record.Code.PatchU16(patch, record.Position);
        Else record.Patches.Add(patch);
    }
    Public Trusted Function void BlockJump(KncFunctionContext context, HirStatement statement)
    {
        KncBlockBinding block = context.ActiveBlock;
        If (block == null) { This.Fail("Jump requires an active Block"); Return; }
        If (context.TryDepth != block.TryDepth) { This.Unsupported(context, "Block Jump across Try handler scopes"); Return; }
        If (statement.Name != "")
        {
            KncRecordBinding record = block.FindRecord(statement.Name);
            If (record == null) This.Fail("unknown Block record: " + statement.Name);
            Else This.RecordJump(context, record, This.EmitJump(context));
            Return;
        }
        KncValue target = This.Cast(context, This.Expression(context, statement.Expression), This.Semantics.Primitive("int"));
        KncValue zero = This.Integer(context, 0);
        KncValue atStart = This.BinaryOp(context, KncOpCode.Eq, target, zero, This.Semantics.Primitive("bool"));
        int startPatch = This.Branch(context, KncOpCode.JumpIfTrue, atStart.Register);
        context.Record.Code.PatchU16(startPatch, block.StartPosition);
        KncRecordBinding record = block.FirstRecord;
        While (record != null)
        {
            KncValue ordinal = This.Integer(context, record.Ordinal);
            KncValue match = This.BinaryOp(context, KncOpCode.Eq, target, ordinal, This.Semantics.Primitive("bool"));
            This.RecordJump(context, record, This.Branch(context, KncOpCode.JumpIfTrue, match.Register));
            record = record.Next;
        }
        block.EndPatches.Add(This.EmitJump(context));
    }
    Public Trusted Function void BlockRecord(KncFunctionContext context, HirStatement statement)
    {
        KncBlockBinding block = context.ActiveBlock;
        If (block == null) { This.Fail("Record requires an active Block"); Return; }
        KncRecordBinding record = block.FindRecord(statement.Name);
        If (record == null) { This.Fail("missing Block record binding: " + statement.Name); Return; }
        record.Position = context.Record.Code.Count;
        This.PatchList(context, record.Patches);
        If (block.UntilRegister >= 0)
        {
            KncValue ordinal = This.Integer(context, record.Ordinal);
            KncValue match = This.BinaryOp(context, KncOpCode.Eq, New KncValue(block.UntilRegister, This.Semantics.Primitive("int")), ordinal, This.Semantics.Primitive("bool"));
            block.EndPatches.Add(This.Branch(context, KncOpCode.JumpIfTrue, match.Register));
        }
        This.Statements(context, statement.FirstChild);
    }
    Public Trusted Function void EmitBlockBody(KncFunctionContext context, HirStatement body, int startRegister, int untilRegister)
    {
        KncBlockBinding block = New KncBlockBinding(body.Name, body);
        block.TryDepth = context.TryDepth;
        block.UntilRegister = untilRegister;
        This.RegisterBlockRecords(block, body.FirstChild);
        KncBlockBinding previous = context.ActiveBlock;
        context.ActiveBlock = block;
        int mark = context.NextRegister;
        int startPatch = -1;
        If (startRegister >= 0)
        {
            KncValue start = New KncValue(startRegister, This.Semantics.Primitive("int"));
            KncValue zero = This.Integer(context, 0);
            KncValue atStart = This.BinaryOp(context, KncOpCode.Eq, start, zero, This.Semantics.Primitive("bool"));
            startPatch = This.Branch(context, KncOpCode.JumpIfTrue, atStart.Register);
            KncRecordBinding record = block.FirstRecord;
            While (record != null)
            {
                KncValue ordinal = This.Integer(context, record.Ordinal);
                KncValue match = This.BinaryOp(context, KncOpCode.Eq, start, ordinal, This.Semantics.Primitive("bool"));
                This.RecordJump(context, record, This.Branch(context, KncOpCode.JumpIfTrue, match.Register));
                context.NextRegister = mark;
                record = record.Next;
            }
            block.EndPatches.Add(This.EmitJump(context));
        }
        block.StartPosition = context.Record.Code.Count;
        This.Patch(context, startPatch);
        context.NextRegister = mark;
        If (untilRegister >= 0)
        {
            KncValue atLimit = This.BinaryOp(context, KncOpCode.Eq,
                New KncValue(untilRegister, This.Semantics.Primitive("int")), This.Integer(context, 0), This.Semantics.Primitive("bool"));
            block.EndPatches.Add(This.Branch(context, KncOpCode.JumpIfTrue, atLimit.Register));
        }
        context.NextRegister = mark;
        This.Statements(context, body.FirstChild);
        This.PatchList(context, block.EndPatches);
        context.ActiveBlock = previous;
        context.NextRegister = mark;
    }
    Public Trusted Function KncValue BlockCall(KncFunctionContext context, HirExpression expression)
    {
        KncValue callable = This.Expression(context, expression.Left);
        HirExpression argument = expression.FirstArgument;
        KncValue start = expression.Target == "Block.Jump" || expression.Target == "Block.JumpAndRunUntil" ?
            This.Cast(context, This.Expression(context, argument), This.Semantics.Primitive("int")) : This.Integer(context, 0);
        KncValue until = expression.Target == "Block.RunUntil" ?
            This.Cast(context, This.Expression(context, argument), This.Semantics.Primitive("int")) :
            expression.Target == "Block.JumpAndRunUntil" ?
                This.Cast(context, This.Expression(context, argument.Next), This.Semantics.Primitive("int")) : This.Integer(context, -1);
        This.Op3(context, KncOpCode.CallClosure, 255, callable.Register, 2);
        context.Record.Code.WriteU8(start.Register);
        context.Record.Code.WriteU8(until.Register);
        context.Record.Code.WriteU8(255);
        context.Record.Code.WriteU8(255);
        Return New KncValue(255, This.Semantics.Primitive("void"));
    }
}

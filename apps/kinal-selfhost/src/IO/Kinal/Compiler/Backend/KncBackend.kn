    // A full-loop opcode may only replace a loop whose sole effect is a raw
    // signed 64-bit local increment/decrement. Keep every other loop ordinary:
    // narrow/unsigned arithmetic, captures, calls and nonempty bodies can have
    // observable coercions or effects that a cached bound would lose.
    Public Safe Function bool IsLoopInteger(TypeSymbol type)
    {
        Return type != null && type.Kind == [int](TypeKind.IntegerType) &&
            (type.Name == "int" || type.Name == "i64");
    }
    Public Safe Function bool IsLoopOne(HirExpression expression)
    {
        Return expression != null && expression.Kind == [int](HirExpressionKind.Constant) &&
            This.IsLoopInteger(expression.Type) && expression.Syntax != null &&
            expression.Syntax.Kind == [int](ExpressionKind.Number) &&
            This.Semantics.IntegerLiteralValue(expression.Name) == 1;
    }
    Public Safe Function bool IsLoopLocal(HirExpression expression, ValueSymbol symbol)
    {
        Return expression != null && expression.Kind == [int](HirExpressionKind.Local) &&
            expression.Symbol == symbol;
    }
    Public Safe Function bool IsEmptyLoopBody(HirStatement statement)
    {
        While (statement != null)
        {
            If (statement.Kind == [int](StatementKind.Block))
            {
                If (!This.IsEmptyLoopBody(statement.FirstChild)) Return false;
            }
            ElseIf (statement.Kind != [int](StatementKind.Empty)) Return false;
            statement = statement.Next;
        }
        Return true;
    }
    Public Safe Function HirExpression SingleLoopUpdate(HirStatement statement)
    {
        HirExpression result = null;
        While (statement != null)
        {
            HirExpression current = null;
            If (statement.Kind == [int](StatementKind.Block))
            {
                If (!This.IsEmptyLoopBody(statement.FirstChild))
                {
                    current = This.SingleLoopUpdate(statement.FirstChild);
                    If (current == null) Return null;
                }
            }
            ElseIf (statement.Kind == [int](StatementKind.Expression)) current = statement.Expression;
            ElseIf (statement.Kind != [int](StatementKind.Empty)) Return null;
            If (current != null)
            {
                If (result != null) Return null;
                result = current;
            }
            statement = statement.Next;
        }
        Return result;
    }
    Public Safe Function int LoopStep(HirExpression expression, ValueSymbol symbol)
    {

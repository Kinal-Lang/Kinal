        If (expression.Kind != [int](HirExpressionKind.Binary)) Return 0;
        If (expression.Operator == TokenKind.PlusAssign && This.IsLoopOne(expression.Right)) Return 1;
        If (expression.Operator == TokenKind.MinusAssign && This.IsLoopOne(expression.Right)) Return -1;
        If (expression.Operator != TokenKind.Assign) Return 0;
        HirExpression value = expression.Right;
        If (value == null || value.Kind != [int](HirExpressionKind.Binary) ||
            !This.IsLoopInteger(value.OperandType)) Return 0;
        If (This.IsLoopLocal(value.Left, symbol) && This.IsLoopOne(value.Right))
        {
            If (value.Operator == TokenKind.Plus) Return 1;
            If (value.Operator == TokenKind.Minus) Return -1;
        }
        If (value.Operator == TokenKind.Plus && This.IsLoopOne(value.Left) &&
            This.IsLoopLocal(value.Right, symbol)) Return 1;

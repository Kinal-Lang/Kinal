            Return value;
        }
        If (expression.Kind == [int](HirExpressionKind.Binary)) Return This.Binary(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Unary)) Return This.Unary(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Conditional)) Return This.Conditional(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Switch)) Return This.SwitchExpression(context, expression);
        If (expression.Kind == [int](HirExpressionKind.Cast))

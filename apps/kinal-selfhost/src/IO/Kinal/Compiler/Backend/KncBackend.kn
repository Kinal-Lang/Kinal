        If (receiver != null)
        {
            If (receiver.Type.Kind == [int](TypeKind.StringType)) target = "IO.Type.string." + target;
            ElseIf (receiver.Type.Kind == [int](TypeKind.AnyType)) target = "IO.Type.any." + target;
        }
        If (receiver != null && (expression.Target == "IsNull" || expression.Target == "TypeName" ||
            expression.Target == "IsNumber" || expression.Target == "IsPointer" || expression.Target == "IsInt" ||
            expression.Target == "IsFloat" || expression.Target == "IsString" || expression.Target == "IsBool" ||
            expression.Target == "IsChar" || expression.Target == "IsObject" || expression.Target == "Equals"))
            target = "IO.Type.any." + expression.Target;
        int id = This.BuiltinId(target);
        If (id < 0) { This.Unsupported(context, "runtime builtin " + expression.Target); Return This.Default(context, expression.Type); }
        int[] args = {};
        If (receiver != null) args = args.Add(receiver.Register);
        While (argument != null && !This.Failed())
        {
            KncValue value = This.Expression(context, argument);
            args = args.Add(value.Register);
            argument = argument.Next;
        }
        Return This.EmitCallRegisters(context, true, id, args, expression.Type);
    }
    Public Trusted Function KncValue Call(KncFunctionContext context, HirExpression expression)
    {
        If (expression.CallKind == [int](HirCallKind.RuntimeBuiltin)) Return This.RuntimeCall(context, expression);
        If (expression.CallKind == [int](HirCallKind.DynamicFunction)) Return This.DynamicCall(context, expression);

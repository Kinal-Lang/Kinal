Unit IO.Kinal.Compiler.Sema.SemanticCompilation;

Get IO.Text;
Get IO.Host;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Core.CompileSession;
Get IO.Kinal.Compiler.Syntax.Nodes;
Get IO.Kinal.Compiler.Syntax.SyntaxTree;
Get IO.Kinal.Compiler.Types.TypeSymbol;
Get IO.Kinal.Compiler.Sema.Symbols;
Get IO.Kinal.Compiler.Hir.HirModel;
Get IO.Kinal.Compiler.Lex.TokenKind;

Class UnitSymbol
{
    Public string Name;
    Public SyntaxTree Syntax;
    Public UnitSymbol Next;

    Public Safe Constructor(string name, SyntaxTree syntax)
    {
        This.Name = name;
        This.Syntax = syntax;
        This.Next = null;
    }
}

Class ConstantIntegerValue
{
    Public bool IsValid;
    Public i64 Value;

    Public Safe Constructor(bool isValid, i64 value)
    {
        This.IsValid = isValid;
        This.Value = value;
    }
}

Class SemanticCompilation
{
    Public CompileSession Session;
    Public UnitSymbol FirstUnit;
    Public TypeSymbol FirstType;
    Public GlobalSymbol FirstGlobal;
    Public FunctionSymbol FirstFunction;
    Public HirModule FirstHirModule;
    Public int ImportCount;
    Public int FunctionCount;
    Public int GlobalCount;
    Public int GenericTemplateCount;
    Public int GenericInstanceCount;
    Public int DeclarationTypeCount;
    Public int UnresolvedImportCount;
    Public int UnresolvedTypeCount;
    Public int BoundExpressionCount;
    Public int UnresolvedExpressionCount;
    Public int LocalLiteralCount;
    Public int TryDepth;

    Public Safe Constructor(CompileSession session)
    {
        This.Session = session;
        This.FirstUnit = null;
        This.FirstType = null;
        This.FirstGlobal = null;
        This.FirstFunction = null;
        This.FirstHirModule = null;
        This.ImportCount = 0;
        This.FunctionCount = 0;
        This.GlobalCount = 0;
        This.GenericTemplateCount = 0;
        This.GenericInstanceCount = 0;
        This.DeclarationTypeCount = 0;
        This.UnresolvedImportCount = 0;
        This.UnresolvedTypeCount = 0;
        This.BoundExpressionCount = 0;
        This.UnresolvedExpressionCount = 0;
        This.LocalLiteralCount = 0;
        This.TryDepth = 0;
        This.RegisterBuiltinTypes();
    }

    Public Safe Function string CanonicalTypeName(string name)
    {
        Return IO.Text.Replace(name, " ", "");
    }

    Public Safe Function void AddType(TypeSymbol type)
    {
        If (This.FirstType == null)
        {
            This.FirstType = type;
            Return;
        }
        TypeSymbol current = This.FirstType;
        While (current.Next != null) current = current.Next;
        current.Next = type;
    }

    Public Safe Function void AddBuiltin(string name, int kind)
    {
        This.AddType(New TypeSymbol(kind, name));
    }

    Public Safe Function void RegisterBuiltinTypes()
    {
        This.AddBuiltin("void", [int](TypeKind.VoidType));
        This.AddBuiltin("bool", [int](TypeKind.BoolType));
        This.AddBuiltin("byte", [int](TypeKind.IntegerType));
        This.AddBuiltin("char", [int](TypeKind.IntegerType));
        This.AddBuiltin("int", [int](TypeKind.IntegerType));
        This.AddBuiltin("i8", [int](TypeKind.IntegerType));
        This.AddBuiltin("i16", [int](TypeKind.IntegerType));
        This.AddBuiltin("i32", [int](TypeKind.IntegerType));
        This.AddBuiltin("i64", [int](TypeKind.IntegerType));
        This.AddBuiltin("u8", [int](TypeKind.IntegerType));
        This.AddBuiltin("u16", [int](TypeKind.IntegerType));
        This.AddBuiltin("u32", [int](TypeKind.IntegerType));
        This.AddBuiltin("u64", [int](TypeKind.IntegerType));
        This.AddBuiltin("isize", [int](TypeKind.IntegerType));
        This.AddBuiltin("usize", [int](TypeKind.IntegerType));
        This.AddBuiltin("float", [int](TypeKind.FloatType));
        This.AddBuiltin("f16", [int](TypeKind.FloatType));
        This.AddBuiltin("f32", [int](TypeKind.FloatType));
        This.AddBuiltin("f64", [int](TypeKind.FloatType));
        This.AddBuiltin("f128", [int](TypeKind.FloatType));
        This.AddBuiltin("string", [int](TypeKind.StringType));
        This.AddBuiltin("any", [int](TypeKind.AnyType));
        This.AddBuiltin("list", [int](TypeKind.ListType));
        This.AddBuiltin("dict", [int](TypeKind.DictType));
        This.AddBuiltin("set", [int](TypeKind.SetType));
        This.AddBuiltin("IO.Type.Object.Function", [int](TypeKind.NamedType));
        This.AddBuiltin("Object.Function", [int](TypeKind.NamedType));
        This.AddBuiltin("IO.Type.Object.Class", [int](TypeKind.NamedType));
        This.AddBuiltin("Object.Class", [int](TypeKind.NamedType));
        This.AddBuiltin("IO.Type.Object.Block", [int](TypeKind.NamedType));
        This.AddBuiltin("Object.Block", [int](TypeKind.NamedType));
        TypeSymbol packageType = New TypeSymbol([int](TypeKind.PackageType), "IO.Type.Object.Package");
        packageType.ElementType = This.Primitive("any");
        This.AddType(packageType);
        This.AddBuiltin("IO.Collection.list", [int](TypeKind.ListType));
        This.AddBuiltin("IO.Collection.dict", [int](TypeKind.DictType));
        This.AddBuiltin("IO.Collection.set", [int](TypeKind.SetType));
        This.AddBuiltin("IO.Error", [int](TypeKind.NamedType));
        This.AddBuiltin("IO.Time.DateTime", [int](TypeKind.NamedType));
        This.AddBuiltin("IO.Async.Task", [int](TypeKind.NamedType));
    }

    Public Safe Function void AddUnit(UnitSymbol unit)
    {
        If (This.FirstUnit == null)
        {
            This.FirstUnit = unit;
            Return;
        }
        UnitSymbol current = This.FirstUnit;
        While (current.Next != null) current = current.Next;
        current.Next = unit;
    }

    Public Safe Function UnitSymbol FindUnit(string name)
    {
        UnitSymbol current = This.FirstUnit;
        While (current != null)
        {
            If (current.Name == name) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function UnitSymbol FindSyntaxUnit(SyntaxTree syntax)
    {
        UnitSymbol current = This.FirstUnit;
        While (current != null)
        {
            If (current.Syntax == syntax) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function FunctionSymbol CreateLocalLiteralFunction(SyntaxTree syntax,
                                                                    ExpressionNode expression,
                                                                    BindingScope outerScope)
    {
        This.LocalLiteralCount = This.LocalLiteralCount + 1;
        string literalKind = expression.Kind == [int](ExpressionKind.BlockLiteral) ?
            "__local_block_" : "__local_function_";
        int literalId = expression.LiteralId >= 0 ?
            expression.LiteralId : This.LocalLiteralCount;
        string name = literalKind + [string](literalId);
        string returnType = expression.Kind == [int](ExpressionKind.BlockLiteral) ?
            "void" : expression.Text;
        FunctionDecl literal = New FunctionDecl(name, returnType,
            expression.Line, expression.Column);
        literal.IsStatic = true;
        literal.Body = expression.Body;
        ExpressionNode parameter = expression.FirstArgument;
        While (parameter != null)
        {
            literal.AddParameter(New ParameterDecl(parameter.Text,
                parameter.Left == null ? "any" : parameter.Left.Text));
            parameter = parameter.Next;
        }
        syntax.AddFunction(literal);
        UnitSymbol unit = This.FindSyntaxUnit(syntax);
        If (unit == null) Return null;
        This.IndexFunction(unit, null, literal);
        FunctionSymbol function = This.FindQualifiedFunction(syntax.UnitName + "." + name,
            literal.ParameterCount());
        function.IsBlockLiteral = expression.Kind == [int](ExpressionKind.BlockLiteral);
        function.BlockRecords = This.BlockRecordNames(expression.Body == null ?
            null : expression.Body.FirstChild);
        BindingScope captureScope = outerScope;
        While (captureScope != null)
        {
            ValueSymbol value = captureScope.FirstValue;
            While (value != null)
            {
                function.AddCapture(value);
                value = value.Next;
            }
            captureScope = captureScope.Parent;
        }
        Return function;
    }

    Public Safe Function string BlockRecordNames(StatementNode statement)
    {
        string result = "";
        StatementNode current = statement;
        While (current != null)
        {
            If (current.Kind == [int](StatementKind.Record))
                result = result == "" ? current.Name : result + "," + current.Name;
            Else
            {
                string nested = This.BlockRecordNames(current.FirstChild);
                If (nested != "") result = result == "" ? nested : result + "," + nested;
                nested = This.BlockRecordNames(current.ElseBranch);
                If (nested != "") result = result == "" ? nested : result + "," + nested;
            }
            current = current.Next;
        }
        Return result;
    }

    Public Safe Function bool HasNestedBlockRecord(StatementNode statement, bool nested)
    {
        StatementNode current = statement;
        While (current != null)
        {
            If (nested && current.Kind == [int](StatementKind.Record)) Return true;
            bool childNested = nested || current.Kind == [int](StatementKind.If) ||
                current.Kind == [int](StatementKind.While) ||
                current.Kind == [int](StatementKind.For) ||
                current.Kind == [int](StatementKind.Foreach) ||
                current.Kind == [int](StatementKind.Switch) ||
                current.Kind == [int](StatementKind.Try);
            If (This.HasNestedBlockRecord(current.FirstChild, childNested)) Return true;
            If (This.HasNestedBlockRecord(current.ElseBranch, childNested)) Return true;
            current = current.Next;
        }
        Return false;
    }

    Public Safe Function int NamedOrdinal(string names, string name)
    {
        If (names == "") Return -1;
        list values = IO.Text.Split(names, ",");
        int index = 0;
        While (index < values.Count())
        {
            If ([string](values.Fetch(index)) == name) Return index + 1;
            index = index + 1;
        }
        Return -1;
    }

    Public Safe Function bool IsRuntimeUnit(string name)
    {
        Return name == "IO.Console" || name == "IO.File" || name == "IO.Directory" ||
               name == "IO.Path" || name == "IO.Text" || name == "IO.Collection" ||
               name == "IO.Error" || name == "IO.GC" || name == "IO.System" ||
               name == "IO.Type" || name == "IO.Memory" || name == "IO.Volatile" ||
               name == "IO.Meta" || name == "IO.Time" ||
               name == "IO.Async" || name == "IO.Target" ||
               name == "IO.Host" || name == "IO.Runtime" ||
               name == "IO.Version" || name == "IO.Panic" ||
               IO.Text.StartsWith(name, "IO.Type.");
    }

    Public Safe Function bool IsRuntimeImport(string name)
    {
        If (This.IsRuntimeUnit(name)) Return true;
        Return IO.Text.StartsWith(name, "IO.Console.") ||
               IO.Text.StartsWith(name, "IO.File.") ||
               IO.Text.StartsWith(name, "IO.Directory.") ||
               IO.Text.StartsWith(name, "IO.Path.") ||
               IO.Text.StartsWith(name, "IO.Text.") ||
               IO.Text.StartsWith(name, "IO.Collection.") ||
               IO.Text.StartsWith(name, "IO.Error.") ||
               IO.Text.StartsWith(name, "IO.GC.") ||
               IO.Text.StartsWith(name, "IO.System.") ||
               IO.Text.StartsWith(name, "IO.Memory.") ||
               IO.Text.StartsWith(name, "IO.Volatile.") ||
               IO.Text.StartsWith(name, "IO.Meta.") ||
               IO.Text.StartsWith(name, "IO.Time.") ||
               IO.Text.StartsWith(name, "IO.Async.") ||
               IO.Text.StartsWith(name, "IO.Target.") ||
               IO.Text.StartsWith(name, "IO.Host.") ||
               IO.Text.StartsWith(name, "IO.Runtime.") ||
               IO.Text.StartsWith(name, "IO.Version.") ||
               IO.Text.StartsWith(name, "IO.Panic.");
    }

    Public Safe Function bool IsKnownImport(string name)
    {
        If (This.FindUnit(name) != null || This.IsRuntimeImport(name)) Return true;
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            If (IO.Text.StartsWith(name, unit.Name + ".")) Return true;
            unit = unit.Next;
        }
        Return false;
    }

    Public Safe Function void Report(SyntaxTree syntax, string title, string detail, int line, int column)
    {
        IO.Kinal.Compiler.Core.Diagnostics.Add(This.Session.Diagnostics, syntax.Source,
            "Sema", title, detail, line, column, 1);
    }

    Public Safe Function void IndexDeclarations()
    {
        CompilationUnit compilationUnit = This.Session.FirstUnit;
        While (compilationUnit != null)
        {
            SyntaxTree syntax = compilationUnit.Syntax;
            // A unit is an open namespace: a project may contribute declarations
            // to the same unit from several source files.
            This.AddUnit(New UnitSymbol(syntax.UnitName, syntax));

            TypeDecl declaration = syntax.FirstType;
            While (declaration != null)
            {
                TypeSymbol type = New TypeSymbol([int](TypeKind.NamedType), declaration.Name);
                type.UnitName = syntax.UnitName;
                type.Declaration = declaration;
                type.Syntax = syntax;
                If (This.FindExactType(type.QualifiedName()) != null)
                {
                    This.Report(syntax, "Duplicate type", type.QualifiedName(), declaration.Line, declaration.Column);
                }
                Else
                {
                    This.AddType(type);
                }
                declaration = declaration.Next;
            }
            compilationUnit = compilationUnit.Next;
        }
    }

    Public Safe Function void ValidateAggregateTypes()
    {
        TypeSymbol type = This.FirstType;
        While (type != null)
        {
            If (This.IsEnumType(type))
            {
                TypeSymbol underlying = This.ResolveType(type.Syntax,
                    type.Declaration.UnderlyingTypeName);
                If (underlying == null)
                {
                    This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                    This.Report(type.Syntax, "Unknown Type",
                        This.CanonicalTypeName(type.Declaration.UnderlyingTypeName),
                        type.Declaration.Line, type.Declaration.Column);
                    This.Report(type.Syntax, "Invalid Enum",
                        "Enum underlying type must be integer",
                        type.Declaration.Line, type.Declaration.Column);
                    underlying = This.Primitive("int");
                }
                ElseIf (underlying.Kind != [int](TypeKind.IntegerType))
                {
                    This.Report(type.Syntax, "Invalid Enum",
                        "Enum underlying type must be integer",
                        type.Declaration.Line, type.Declaration.Column);
                }
                type.UnderlyingType = underlying;
            }
            ElseIf (This.IsStructType(type) && type.Declaration.Align > 0 &&
                (type.Declaration.Align & (type.Declaration.Align - 1)) != 0)
            {
                This.Report(type.Syntax, "Invalid Align",
                    "Align must be power of two",
                    type.Declaration.Line, type.Declaration.Column);
            }
            type = type.Next;
        }
    }

    Public Safe Function TypeSymbol FindExactType(string name)
    {
        TypeSymbol current = This.FirstType;
        While (current != null)
        {
            If (current.Name == name || current.QualifiedName() == name) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function bool IsDecimalText(string value)
    {
        If (IO.Text.IsEmpty(value)) Return false;
        char[] characters = value.ToChars();
        int index = 0;
        While (index < characters.Length())
        {
            int code = [int](characters[index]);
            If (code < 48 || code > 57) Return false;
            index = index + 1;
        }
        Return true;
    }

    Public Safe Function int PackageRepeatOpen(string value)
    {
        If (!IO.Text.EndsWith(value, ")")) Return -1;
        char[] characters = value.ToChars();
        int depth = 0;
        int index = characters.Length() - 1;
        While (index >= 0)
        {
            int code = [int](characters[index]);
            If (code == 41) depth = depth + 1;
            ElseIf (code == 40)
            {
                depth = depth - 1;
                If (depth == 0) Return index;
            }
            index = index - 1;
        }
        Return -1;
    }

    Public Safe Function TypeSymbol ResolvePackageType(SyntaxTree syntax,
                                                         FunctionSymbol function,
                                                         string rawName)
    {
        string name = This.CanonicalTypeName(rawName);
        int length = IO.Text.Length(name);
        If (length < 3 || !IO.Text.StartsWith(name, "<") ||
            !IO.Text.EndsWith(name, ">")) Return null;

        TypeSymbol packageType = New TypeSymbol([int](TypeKind.PackageType), name);
        packageType.ElementType = This.Primitive("any");
        char[] characters = name.ToChars();
        int start = 1;
        int angleDepth = 0;
        int parenDepth = 0;
        int index = 1;
        string identity = "<";
        While (index < length)
        {
            int code = [int](characters[index]);
            If (code == 60) angleDepth = angleDepth + 1;
            ElseIf (code == 62 && angleDepth > 0) angleDepth = angleDepth - 1;
            ElseIf (code == 40) parenDepth = parenDepth + 1;
            ElseIf (code == 41 && parenDepth > 0) parenDepth = parenDepth - 1;

            bool delimiter = (code == 44 && angleDepth == 0 && parenDepth == 0) ||
                (index == length - 1 && code == 62 && angleDepth == 0 && parenDepth == 0);
            If (delimiter)
            {
                string itemName = IO.Text.Slice(name, start, index - start);
                If (IO.Text.IsEmpty(itemName)) Return null;
                int repeat = 1;
                int repeatOpen = This.PackageRepeatOpen(itemName);
                If (repeatOpen > 0)
                {
                    string repeatText = IO.Text.Slice(itemName, repeatOpen + 1,
                        IO.Text.Length(itemName) - repeatOpen - 2);
                    If (!This.IsDecimalText(repeatText)) Return null;
                    repeat = [int](repeatText);
                    itemName = IO.Text.Slice(itemName, 0, repeatOpen);
                    If (repeat <= 0 || IO.Text.IsEmpty(itemName)) Return null;
                }
                TypeSymbol itemType = function == null ?
                    This.ResolveType(syntax, itemName) :
                    This.ResolveFunctionType(syntax, function, itemName);
                If (itemType == null || itemType.Kind == [int](TypeKind.VoidType)) Return null;
                int repeated = 0;
                While (repeated < repeat)
                {
                    packageType.AddPackageElement(itemType);
                    If (packageType.PackageCount > 1) identity = identity + ",";
                    identity = identity + This.TypeIdentity(itemType);
                    repeated = repeated + 1;
                }
                start = index + 1;
            }
            index = index + 1;
        }
        If (packageType.PackageCount == 0) Return null;
        packageType.Name = identity + ">";
        Return packageType;
    }

    Public Safe Function TypeSymbol ResolveType(SyntaxTree syntax, string rawName)
    {
        string name = This.CanonicalTypeName(rawName);
        If (name == "Object.Function") name = "IO.Type.Object.Function";
        ElseIf (name == "Object.Class") name = "IO.Type.Object.Class";
        ElseIf (name == "Object.Block") name = "IO.Type.Object.Block";
        ElseIf (name == "Object.Package") name = "IO.Type.Object.Package";
        If (IO.Text.StartsWith(name, "<") && IO.Text.EndsWith(name, ">"))
            Return This.ResolvePackageType(syntax, null, name);
        int fixedOpen = IO.Text.IndexOf(name, "[");
        If (fixedOpen > 0 && IO.Text.EndsWith(name, "]"))
        {
            TypeSymbol fixedElement = This.ResolveType(syntax,
                IO.Text.Slice(name, 0, fixedOpen));
            If (fixedElement == null) Return null;
            int dimensionCount = 0;
            char[] fixedChars = name.ToChars();
            int fixedIndex = fixedOpen;
            While (fixedIndex < fixedChars.Length())
            {
                If ([int](fixedChars[fixedIndex]) == 91) dimensionCount = dimensionCount + 1;
                fixedIndex = fixedIndex + 1;
            }
            TypeSymbol fixedType = fixedElement;
            While (dimensionCount > 0)
            {
                TypeSymbol arrayType = New TypeSymbol([int](TypeKind.ArrayType), fixedType.Name + "[]");
                arrayType.ElementType = fixedType;
                fixedType = arrayType;
                dimensionCount = dimensionCount - 1;
            }
            Return fixedType;
        }
        If (IO.Text.EndsWith(name, "*"))
        {
            TypeSymbol element = This.ResolveType(syntax,
                IO.Text.Slice(name, 0, IO.Text.Length(name) - 1));
            If (element == null) Return null;
            TypeSymbol pointerType = New TypeSymbol([int](TypeKind.PointerType), element.Name + "*");
            pointerType.ElementType = element;
            Return pointerType;
        }
        If (IO.Text.EndsWith(name, "[]"))
        {
            TypeSymbol element = This.ResolveType(syntax,
                IO.Text.Slice(name, 0, IO.Text.Length(name) - 2));
            If (element == null) Return null;
            TypeSymbol arrayType = New TypeSymbol([int](TypeKind.ArrayType), element.Name + "[]");
            arrayType.ElementType = element;
            Return arrayType;
        }

        // IO.Type exposes the primitive type keywords as qualified type names.
        If (IO.Text.StartsWith(name, "IO.Type."))
        {
            string primitiveName = IO.Text.Slice(name, 8, IO.Text.Length(name) - 8);
            If (!IO.Text.Contains(primitiveName, "."))
            {
                TypeSymbol primitiveType = This.FindExactType(primitiveName);
                If (primitiveType != null && primitiveType.UnitName == "") Return primitiveType;
            }
        }

        TypeSymbol direct = This.FindExactType(name);
        If (direct != null && direct.UnitName == "") Return direct;
        direct = This.FindExactType(syntax.UnitName + "." + name);
        If (direct != null) Return direct;
        If (IO.Text.StartsWith(name, syntax.UnitName + "."))
        {
            direct = This.FindExactType(name);
            If (direct != null) Return direct;
        }

        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            string aliasPrefix = import.Name + ".";
            If ((import.Kind == 1 || import.Kind == 3) &&
                IO.Text.StartsWith(name, aliasPrefix))
            {
                string importedName = import.Target + "." +
                    IO.Text.Slice(name, IO.Text.Length(aliasPrefix),
                        IO.Text.Length(name) - IO.Text.Length(aliasPrefix));
                TypeSymbol imported = This.FindExactType(importedName);
                If (imported != null) Return imported;
            }
            TypeSymbol current = This.FirstType;
            While (current != null)
            {
                If ((import.Kind == 0 || import.Kind == 2) &&
                    current.UnitName == import.Target && current.Name == name) Return current;
                current = current.Next;
            }
            If ((import.Kind == 0 || import.Kind == 2) &&
                (name == import.Target || IO.Text.StartsWith(name, import.Target + ".")))
            {
                TypeSymbol importedExact = This.FindExactType(name);
                If (importedExact != null) Return importedExact;
            }
            import = import.Next;
        }
        Return null;
    }

    Public Safe Function TypeSymbol ResolveFunctionType(SyntaxTree syntax,
                                                         FunctionSymbol function, string rawName)
    {
        string name = This.CanonicalTypeName(rawName);
        If (IO.Text.StartsWith(name, "<") && IO.Text.EndsWith(name, ">"))
            Return This.ResolvePackageType(syntax, function, name);
        If (IO.Text.EndsWith(name, "*"))
        {
            TypeSymbol element = This.ResolveFunctionType(syntax, function,
                IO.Text.Slice(name, 0, IO.Text.Length(name) - 1));
            If (element == null) Return null;
            TypeSymbol pointerType = New TypeSymbol([int](TypeKind.PointerType), element.Name + "*");
            pointerType.ElementType = element;
            Return pointerType;
        }
        If (IO.Text.EndsWith(name, "[]"))
        {
            TypeSymbol element = This.ResolveFunctionType(syntax, function,
                IO.Text.Slice(name, 0, IO.Text.Length(name) - 2));
            If (element == null) Return null;
            Return This.MakeArrayType(element);
        }
        If (function != null)
        {
            TypeSymbol substituted = function.Substitute(name);
            If (substituted != null) Return substituted;
        }
        Return This.ResolveType(syntax, name);
    }

    Public Safe Function TypeSymbol CheckFunctionType(SyntaxTree syntax,
                                                       FunctionSymbol function, string name,
                                                       int line, int column)
    {
        This.DeclarationTypeCount = This.DeclarationTypeCount + 1;
        TypeSymbol type = This.ResolveFunctionType(syntax, function, name);
        If (type != null) Return type;
        This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
        This.Report(syntax, "Unknown Type", This.CanonicalTypeName(name), line, column);
        Return null;
    }

    Public Safe Function void CheckType(SyntaxTree syntax, string name, int line, int column)
    {
        This.DeclarationTypeCount = This.DeclarationTypeCount + 1;
        If (This.ResolveType(syntax, name) != null) Return;
        This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
        This.Report(syntax, "Unknown Type", This.CanonicalTypeName(name), line, column);
    }

    Public Safe Function void CheckExpression(SyntaxTree syntax, ExpressionNode expression)
    {
        If (expression == null) Return;
        If (expression.Kind == [int](ExpressionKind.Cast) ||
            expression.Kind == [int](ExpressionKind.NewObject))
        {
            This.CheckType(syntax, expression.Text, expression.Line, expression.Column);
        }
        This.CheckExpression(syntax, expression.Left);
        This.CheckExpression(syntax, expression.Right);
        This.CheckExpression(syntax, expression.Third);
        ExpressionNode argument = expression.FirstArgument;
        While (argument != null)
        {
            This.CheckExpression(syntax, argument);
            argument = argument.Next;
        }
    }

    Public Safe Function void CheckStatement(SyntaxTree syntax, StatementNode statement)
    {
        While (statement != null)
        {
            If (statement.Kind == [int](StatementKind.Variable))
            {
                If (statement.TypeName != "Var")
                    This.CheckType(syntax, statement.TypeName, statement.Line, statement.Column);
            }
            This.CheckExpression(syntax, statement.Expression);
            This.CheckExpression(syntax, statement.SecondExpression);
            This.CheckExpression(syntax, statement.ThirdExpression);
            This.CheckStatement(syntax, statement.Initializer);
            This.CheckStatement(syntax, statement.FirstChild);
            This.CheckStatement(syntax, statement.ElseBranch);
            statement = statement.Next;
        }
    }

    Public Safe Function void CheckFunction(SyntaxTree syntax, FunctionDecl function)
    {
        ParameterDecl parameter = function.FirstParameter;
        While (parameter != null)
        {
            This.CheckExpression(syntax, parameter.DefaultValue);
            parameter = parameter.Next;
        }
        This.CheckStatement(syntax, function.Body);
    }

    Public Safe Function void AddFunctionSymbol(FunctionSymbol function)
    {
        If (This.FirstFunction == null)
        {
            This.FirstFunction = function;
            Return;
        }
        FunctionSymbol current = This.FirstFunction;
        While (current.Next != null) current = current.Next;
        current.Next = function;
    }

    Public Safe Function void IndexFunction(UnitSymbol unit, TypeSymbol owner, FunctionDecl declaration)
    {
        FunctionSymbol function = New FunctionSymbol(unit.Name, owner, declaration);
        function.Syntax = unit.Syntax;
        This.FunctionCount = This.FunctionCount + 1;
        TypeParameterDecl typeParameter = declaration.FirstTypeParameter;
        While (typeParameter != null)
        {
            If (function.Substitute(typeParameter.Name) != null)
                This.Report(unit.Syntax, "Duplicate generic parameter", typeParameter.Name,
                    typeParameter.Line, typeParameter.Column);
            Else
            {
                TypeSymbol parameterType = New TypeSymbol([int](TypeKind.TypeParameter), typeParameter.Name);
                function.AddSubstitution(New TypeSubstitution(typeParameter.Name, parameterType));
            }
            typeParameter = typeParameter.Next;
        }
        If (function.IsGenericTemplate()) This.GenericTemplateCount = This.GenericTemplateCount + 1;
        If (declaration.IsExtern && function.IsGenericTemplate())
            This.Report(unit.Syntax, "Invalid generic function", "Extern function cannot be generic",
                declaration.Line, declaration.Column);
        If (owner != null && function.IsGenericTemplate())
            This.Report(unit.Syntax, "Unsupported generic method", declaration.Name,
                declaration.Line, declaration.Column);
        function.ReturnType = This.CheckFunctionType(unit.Syntax, function,
            declaration.ReturnType, declaration.Line, declaration.Column);
        ParameterDecl parameter = declaration.FirstParameter;
        While (parameter != null)
        {
            ParameterSymbol parameterSymbol = New ParameterSymbol(parameter.Name,
                This.CheckFunctionType(unit.Syntax, function, parameter.TypeName,
                    declaration.Line, declaration.Column));
            parameterSymbol.Declaration = parameter;
            function.AddParameter(parameterSymbol);
            parameter = parameter.Next;
        }
        This.ValidateFunctionDeclaration(function);
        This.AddFunctionSymbol(function);
    }

    Public Safe Function void IndexFunctions()
    {
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            FunctionDecl function = unit.Syntax.FirstFunction;
            While (function != null)
            {
                This.IndexFunction(unit, null, function);
                function = function.Next;
            }
            TypeDecl declaration = unit.Syntax.FirstType;
            While (declaration != null)
            {
                TypeSymbol owner = This.FindExactType(unit.Name + "." + declaration.Name);
                function = declaration.FirstMethod;
                While (function != null)
                {
                    This.IndexFunction(unit, owner, function);
                    function = function.Next;
                }
                declaration = declaration.Next;
            }
            unit = unit.Next;
        }
    }

    Public Safe Function void AddGlobalSymbol(GlobalSymbol global)
    {
        If (This.FirstGlobal == null)
        {
            This.FirstGlobal = global;
            Return;
        }
        GlobalSymbol current = This.FirstGlobal;
        While (current.Next != null) current = current.Next;
        current.Next = global;
    }

    Public Safe Function GlobalSymbol FindGlobal(string unitName, string name)
    {
        GlobalSymbol current = This.FirstGlobal;
        While (current != null)
        {
            If (current.UnitName == unitName && current.Declaration.Name == name) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function GlobalSymbol FindQualifiedGlobal(string path)
    {
        int separator = IO.Text.LastIndexOf(path, ".");
        If (separator <= 0) Return null;
        Return This.FindGlobal(
            IO.Text.Slice(path, 0, separator),
            IO.Text.Slice(path, separator + 1, IO.Text.Length(path) - separator - 1));
    }

    Public Safe Function GlobalSymbol FindVisibleGlobal(SyntaxTree syntax, string name)
    {
        GlobalSymbol global = This.FindGlobal(syntax.UnitName, name);
        If (global != null) Return global;
        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            global = This.FirstGlobal;
            While (global != null)
            {
                If (global.Declaration.Name == name &&
                    (global.UnitName == import.Target ||
                     IO.Text.StartsWith(import.Target, global.UnitName + "."))) Return global;
                global = global.Next;
            }
            import = import.Next;
        }
        Return null;
    }

    Public Safe Function GlobalSymbol FindStaticGlobal(TypeSymbol owner, string name)
    {
        TypeSymbol current = owner;
        While (current != null)
        {
            GlobalSymbol global = This.FindGlobal(current.QualifiedName(), name);
            If (global != null) Return global;
            current = current.BaseType;
        }
        Return null;
    }

    Public Safe Function bool IsInterfaceType(TypeSymbol type)
    {
        Return type != null && type.Declaration != null &&
            type.Declaration.Kind == TokenKind.KwInterface;
    }

    Public Safe Function bool IsClassType(TypeSymbol type)
    {
        If (type == null || type.Kind != [int](TypeKind.NamedType)) Return false;
        If (type.Declaration != null)
            Return type.Declaration.Kind == TokenKind.KwClass;
        // Runtime-provided named types have no source declaration in the
        // selfhost compilation, but represent ordinary class types.
        Return true;
    }

    Public Safe Function bool IsStructType(TypeSymbol type)
    {
        Return type != null && type.Kind == [int](TypeKind.NamedType) &&
            type.Declaration != null &&
            type.Declaration.Kind == TokenKind.KwStruct;
    }

    Public Safe Function bool IsEnumType(TypeSymbol type)
    {
        Return type != null && type.Kind == [int](TypeKind.NamedType) &&
            type.Declaration != null &&
            type.Declaration.Kind == TokenKind.KwEnum;
    }

    Public Safe Function bool TypeImplementsInterface(TypeSymbol type,
                                                       TypeSymbol target)
    {
        If (type == null || target == null) Return false;
        If (This.SameType(type, target)) Return true;
        TypeSymbol current = type;
        int depth = 0;
        While (current != null && depth < 256)
        {
            InterfaceTypeLink interfaceLink = current.FirstInterface;
            While (interfaceLink != null)
            {
                If (This.SameType(interfaceLink.Type, target)) Return true;
                interfaceLink = interfaceLink.Next;
            }
            current = current.BaseType;
            depth = depth + 1;
        }
        Return false;
    }

    Public Safe Function void AddImplementedInterface(TypeSymbol type,
                                                       TypeSymbol interfaceType)
    {
        If (type.HasDirectInterface(interfaceType))
        {
            This.Report(type.Syntax, "Duplicate Interface",
                "Interface already listed",
                type.Declaration.Line, type.Declaration.Column);
            Return;
        }
        type.AddInterface(interfaceType);
    }

    Public Safe Function void LinkBaseTypes()
    {
        TypeSymbol type = This.FirstType;
        While (type != null)
        {
            If (type.Declaration != null &&
                type.Declaration.Kind == TokenKind.KwClass)
            {
                TypeBaseDecl base = type.Declaration.FirstBase;
                bool first = true;
                While (base != null)
                {
                    TypeSymbol resolved = This.ResolveType(type.Syntax, base.Name);
                    If (resolved == null)
                    {
                        This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                        This.Report(type.Syntax, first ? "Unknown Base" :
                            "Unknown Interface", first ?
                            "Base class or interface not found" :
                            "Interface not found",
                            type.Declaration.Line, type.Declaration.Column);
                    }
                    ElseIf (first && This.IsClassType(resolved))
                    {
                        type.BaseType = resolved;
                    }
                    ElseIf (This.IsInterfaceType(resolved))
                    {
                        This.AddImplementedInterface(type, resolved);
                    }
                    ElseIf (first)
                    {
                        This.Report(type.Syntax, "Unknown Base",
                            "Base class or interface not found",
                            type.Declaration.Line, type.Declaration.Column);
                    }
                    Else
                    {
                        This.Report(type.Syntax, "Unknown Interface",
                            "Interface not found",
                            type.Declaration.Line, type.Declaration.Column);
                    }
                    first = false;
                    base = base.Next;
                }
            }
            type = type.Next;
        }
    }

    Public Safe Function void IndexGlobals()
    {
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            FieldDecl declaration = unit.Syntax.FirstGlobal;
            While (declaration != null)
            {
                If (This.FindGlobal(unit.Name, declaration.Name) != null)
                {
                    This.Report(unit.Syntax, "Duplicate global", declaration.Name,
                        declaration.Line, declaration.Column);
                }
                Else
                {
                    This.DeclarationTypeCount = This.DeclarationTypeCount + 1;
                    TypeSymbol type = This.ResolveType(unit.Syntax, declaration.TypeName);
                    If (type == null)
                    {
                        This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                        This.Report(unit.Syntax, "Unknown Type", This.CanonicalTypeName(declaration.TypeName),
                            declaration.Line, declaration.Column);
                        type = This.Primitive("any");
                    }
                    This.AddGlobalSymbol(New GlobalSymbol(unit.Name, declaration, type));
                    This.GlobalCount = This.GlobalCount + 1;
                    If (declaration.Initializer != null &&
                        (declaration.Initializer.Kind == [int](ExpressionKind.FunctionLiteral) ||
                         declaration.Initializer.Kind == [int](ExpressionKind.BlockLiteral)))
                    {
                        string literalName = "__global_literal_" + declaration.Name;
                        string returnType = declaration.Initializer.Kind ==
                            [int](ExpressionKind.FunctionLiteral) ?
                            declaration.Initializer.Text : "void";
                        FunctionDecl literal = New FunctionDecl(literalName, returnType,
                            declaration.Line, declaration.Column);
                        literal.IsStatic = true;
                        literal.Body = declaration.Initializer.Body;
                        unit.Syntax.AddFunction(literal);
                    }
                }
                declaration = declaration.Next;
            }
            TypeDecl typeDeclaration = unit.Syntax.FirstType;
            While (typeDeclaration != null)
            {
                TypeSymbol owner = This.FindExactType(unit.Name + "." + typeDeclaration.Name);
                FieldDecl field = typeDeclaration.FirstField;
                While (field != null)
                {
                    If (field.IsStatic)
                    {
                        string ownerName = owner == null ?
                            unit.Name + "." + typeDeclaration.Name : owner.QualifiedName();
                        If (This.FindGlobal(ownerName, field.Name) != null)
                        {
                            This.Report(unit.Syntax, "Duplicate static field", field.Name,
                                field.Line, field.Column);
                        }
                        Else
                        {
                            This.DeclarationTypeCount = This.DeclarationTypeCount + 1;
                            TypeSymbol fieldType = This.ResolveType(unit.Syntax, field.TypeName);
                            If (fieldType == null)
                            {
                                This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                                This.Report(unit.Syntax, "Unknown Type", This.CanonicalTypeName(field.TypeName),
                                    field.Line, field.Column);
                                fieldType = This.Primitive("any");
                            }
                            This.AddGlobalSymbol(New GlobalSymbol(ownerName, field, fieldType));
                            This.GlobalCount = This.GlobalCount + 1;
                        }
                    }
                    field = field.Next;
                }
                typeDeclaration = typeDeclaration.Next;
            }
            unit = unit.Next;
        }
    }

    Public Safe Function void LinkGlobalLiteralFunctions()
    {
        GlobalSymbol global = This.FirstGlobal;
        While (global != null)
        {
            If (global.Declaration.Initializer != null &&
                (global.Declaration.Initializer.Kind == [int](ExpressionKind.FunctionLiteral) ||
                 global.Declaration.Initializer.Kind == [int](ExpressionKind.BlockLiteral)))
                global.Value.CallableFunction = This.FindQualifiedFunction(global.UnitName +
                    ".__global_literal_" + global.Declaration.Name, 0);
            global = global.Next;
        }
    }

    Public Safe Function void CheckUnit(UnitSymbol unit)
    {
        SyntaxTree syntax = unit.Syntax;
        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            This.ImportCount = This.ImportCount + 1;
            If (import.Kind == 3 && !This.AliasTargetIsVisible(syntax, import))
                This.Report(syntax, "Invalid Alias Target", import.Target,
                    import.Line, import.Column);
            If (!This.IsKnownImport(This.ExpandImportPath(syntax, import.Target)))
            {
                This.UnresolvedImportCount = This.UnresolvedImportCount + 1;
                This.Report(syntax, "Unknown imported unit", import.Target, import.Line, import.Column);
            }
            import = import.Next;
        }

        FunctionDecl function = syntax.FirstFunction;
        While (function != null)
        {
            If (function.FirstTypeParameter == null) This.CheckFunction(syntax, function);
            function = function.Next;
        }
        FieldDecl global = syntax.FirstGlobal;
        While (global != null)
        {
            This.CheckExpression(syntax, global.Initializer);
            global = global.Next;
        }
        TypeDecl type = syntax.FirstType;
        While (type != null)
        {
            FieldDecl field = type.FirstField;
            While (field != null)
            {
                If (!field.IsStatic) This.CheckType(syntax, field.TypeName, field.Line, field.Column);
                This.CheckExpression(syntax, field.Initializer);
                field = field.Next;
            }
            function = type.FirstMethod;
            While (function != null)
            {
                If (function.FirstTypeParameter == null) This.CheckFunction(syntax, function);
                function = function.Next;
            }
            type = type.Next;
        }
    }

    Public Safe Function TypeSymbol Primitive(string name)
    {
        Return This.FindExactType(name);
    }

    Public Safe Function TypeSymbol MakeArrayType(TypeSymbol element)
    {
        TypeSymbol arrayType = New TypeSymbol([int](TypeKind.ArrayType), element.Name + "[]");
        arrayType.ElementType = element;
        Return arrayType;
    }

    Public Safe Function TypeSymbol MakePointerType(TypeSymbol element)
    {
        TypeSymbol pointerType = New TypeSymbol([int](TypeKind.PointerType), element.Name + "*");
        pointerType.ElementType = element;
        Return pointerType;
    }

    Public Safe Function FunctionSymbol FindQualifiedFunction(string name, int parameterCount)
    {
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (current.QualifiedName() == name && current.AcceptsArgumentCount(parameterCount)) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function FunctionSymbol FindDirectMethod(TypeSymbol owner, string name, int parameterCount)
    {
        If (owner == null) Return null;
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (current.OwnerType == owner && current.Name == name &&
                current.AcceptsArgumentCount(parameterCount)) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function FunctionSymbol FindMethod(TypeSymbol owner, string name, int parameterCount)
    {
        TypeSymbol currentOwner = owner;
        While (currentOwner != null)
        {
            FunctionSymbol direct = This.FindDirectMethod(currentOwner, name, parameterCount);
            If (direct != null) Return direct;
            currentOwner = currentOwner.BaseType;
        }
        Return null;
    }

    Public Safe Function FunctionSymbol FindPropertyGetter(TypeSymbol owner, string name)
    {
        Return This.FindMethod(owner, "__get_" + name, 0);
    }

    Public Safe Function FunctionSymbol FindPropertySetter(TypeSymbol owner, string name)
    {
        Return This.FindMethod(owner, "__set_" + name, 1);
    }

    Public Safe Function HirExpression BindPropertyAccess(SyntaxTree syntax,
                                                            FunctionSymbol function,
                                                            ExpressionNode expression,
                                                            HirExpression receiver,
                                                            FunctionSymbol getter)
    {
        HirExpression result = New HirExpression([int](HirExpressionKind.Field),
            expression, getter.ReturnType);
        result.Left = receiver;
        result.Target = expression.Text;
        result.Function = getter;
        FunctionSymbol setter = This.FindPropertySetter(getter.OwnerType, expression.Text);
        result.Name = setter == null ? "" : setter.QualifiedName();
        This.CheckCallSafety(syntax, function, getter, expression);
        Return result;
    }

    Public Safe Function FunctionSymbol FindMethodSignature(TypeSymbol owner,
                                                             FunctionSymbol signature)
    {
        If (owner == null || signature == null) Return null;
        TypeSymbol currentOwner = owner;
        While (currentOwner != null)
        {
            FunctionSymbol method = This.FirstFunction;
            While (method != null)
            {
                If (method.OwnerType == currentOwner &&
                    !method.Declaration.IsConstructor &&
                    method.Declaration.IsStatic ==
                        signature.Declaration.IsStatic &&
                    method.Name == signature.Name &&
                    This.SameFunctionSignature(method, signature))
                    Return method;
                method = method.Next;
            }
            currentOwner = currentOwner.BaseType;
        }
        Return null;
    }

    Public Safe Function bool HasConstructor(TypeSymbol owner)
    {
        FunctionSymbol function = This.FirstFunction;
        While (function != null)
        {
            If (function.OwnerType == owner && function.Declaration.IsConstructor) Return true;
            function = function.Next;
        }
        Return false;
    }

    Public Safe Function FunctionSymbol FindVisibleFunction(SyntaxTree syntax, TypeSymbol owner,
                                                             string name, int parameterCount)
    {
        FunctionSymbol method = This.FindMethod(owner, name, parameterCount);
        If (method != null) Return method;
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (current.OwnerType == null && current.UnitName == syntax.UnitName &&
                current.Name == name && current.AcceptsArgumentCount(parameterCount)) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function FunctionSymbol FindVisibleCallable(SyntaxTree syntax, TypeSymbol owner,
                                                              string name)
    {
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (current.OwnerType == owner && current.Name == name) Return current;
            If (current.OwnerType == null && current.UnitName == syntax.UnitName &&
                current.Name == name) Return current;
            current = current.Next;
        }
        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            current = This.FirstFunction;
            While (current != null)
            {
                If (current.QualifiedName() == import.Target && import.Name == name) Return current;
                current = current.Next;
            }
            import = import.Next;
        }
        Return null;
    }

    Public Safe Function int VisibleFunctionCount(SyntaxTree syntax, TypeSymbol owner,
                                                    string name, int parameterCount)
    {
        int count = 0;
        TypeSymbol currentOwner = owner;
        While (currentOwner != null)
        {
            FunctionSymbol method = This.FirstFunction;
            While (method != null)
            {
                If (method.OwnerType == currentOwner && method.Name == name &&
                    method.AcceptsArgumentCount(parameterCount)) count = count + 1;
                method = method.Next;
            }
            If (count > 0) Return count;
            currentOwner = currentOwner.BaseType;
        }
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (current.OwnerType == null && current.UnitName == syntax.UnitName &&
                current.Name == name && current.AcceptsArgumentCount(parameterCount))
                count = count + 1;
            current = current.Next;
        }
        If (count > 0) Return count;
        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            current = This.FirstFunction;
            While (current != null)
            {
                If (current.OwnerType == null && current.UnitName == import.Target &&
                    current.Name == name && current.AcceptsArgumentCount(parameterCount))
                    count = count + 1;
                current = current.Next;
            }
            import = import.Next;
        }
        Return count;
    }

    Public Safe Function void CheckCallSafety(SyntaxTree syntax, FunctionSymbol caller,
                                               FunctionSymbol target, ExpressionNode call)
    {
        If (caller == null || target == null) Return;
        bool callerIsSafe = caller.Declaration.Safety == 0 ||
            caller.Declaration.Safety == 1;
        bool targetIsUnsafe = target.Declaration.Safety == 3 ||
            (target.Declaration.IsExtern && target.Declaration.Abi == "C") ||
            (target.Declaration.IsDelegate && target.Declaration.Abi == "C");
        If (callerIsSafe && targetIsUnsafe)
            This.Report(syntax, "Unsafe Call", "Safe function cannot call Unsafe",
                call.Line, call.Column);
    }

    Public Safe Function bool FunctionIsSafe(FunctionSymbol function)
    {
        Return function != null && (function.Declaration.Safety == 0 ||
            function.Declaration.Safety == 1);
    }

    Public Safe Function void CheckPointerSafety(SyntaxTree syntax, FunctionSymbol function,
                                                  ExpressionNode expression)
    {
        If (function != null && function.Declaration.Safety == 1)
            This.Report(syntax, "Unsafe Pointer", "Safe function cannot use pointer operation",
                expression.Line, expression.Column);
    }

    Public Safe Function bool RelatedNamedTypes(TypeSymbol left, TypeSymbol right)
    {
        If (This.SameType(left, right)) Return true;
        If (left.Name == "IO.Type.Object.Class" || left.Name == "Object.Class" ||
            right.Name == "IO.Type.Object.Class" || right.Name == "Object.Class")
            Return true;
        bool leftInterface = This.IsInterfaceType(left);
        bool rightInterface = This.IsInterfaceType(right);
        If (leftInterface && rightInterface) Return true;
        If (leftInterface)
        {
            If (This.TypeImplementsInterface(right, left)) Return true;
            Return This.IsClassType(right) &&
                (right.Declaration == null || !right.Declaration.IsSealed);
        }
        If (rightInterface)
        {
            If (This.TypeImplementsInterface(left, right)) Return true;
            Return This.IsClassType(left) &&
                (left.Declaration == null || !left.Declaration.IsSealed);
        }
        TypeSymbol current = left;
        While (current != null)
        {
            If (This.SameType(current, right)) Return true;
            current = current.BaseType;
        }
        current = right;
        While (current != null)
        {
            If (This.SameType(current, left)) Return true;
            current = current.BaseType;
        }
        Return false;
    }

    Public Safe Function bool IsObjectSchemaType(TypeSymbol type)
    {
        If (type == null || type.Kind != [int](TypeKind.NamedType))
            Return false;
        TypeSymbol resolved = type.Declaration == null ?
            This.FindExactType(type.QualifiedName()) : type;
        If (resolved == null || resolved.Declaration == null)
        {
            TypeSymbol candidate = This.FirstType;
            While (candidate != null)
            {
                If (candidate.Declaration != null &&
                    (candidate.Declaration.Kind == TokenKind.KwEnum ||
                     candidate.Declaration.Kind == TokenKind.KwStruct) &&
                    (candidate.Name == type.Name ||
                     candidate.QualifiedName() == type.Name ||
                     IO.Text.EndsWith(candidate.QualifiedName(),
                          "." + type.Name))) Return false;
                candidate = candidate.Next;
            }
        }
        Return resolved == null || resolved.Declaration == null ||
            (resolved.Declaration.Kind != TokenKind.KwEnum &&
             resolved.Declaration.Kind != TokenKind.KwStruct);
    }

    Public Safe Function bool SameFunctionSignature(FunctionSymbol left, FunctionSymbol right)
    {
        If (left == null || right == null || !This.SameType(left.ReturnType, right.ReturnType))
            Return false;
        ParameterSymbol leftParameter = left.FirstParameter;
        ParameterSymbol rightParameter = right.FirstParameter;
        While (leftParameter != null && rightParameter != null)
        {
            If (!This.SameType(leftParameter.Type, rightParameter.Type)) Return false;
            leftParameter = leftParameter.Next;
            rightParameter = rightParameter.Next;
        }
        Return leftParameter == null && rightParameter == null;
    }

    Public Safe Function void ValidateClassRelationships()
    {
        TypeSymbol type = This.FirstType;
        While (type != null)
        {
            TypeDecl declaration = type.Declaration;
            If (declaration != null && declaration.Kind == TokenKind.KwClass)
            {
                If (declaration.IsStatic)
                {
                    If (type.BaseType != null)
                        This.Report(type.Syntax, "Invalid Static Class",
                            "Static class cannot inherit from a base class",
                            declaration.Line, declaration.Column);
                    If (type.InterfaceCount > 0)
                        This.Report(type.Syntax, "Invalid Static Class",
                            "Static class cannot implement interfaces",
                            declaration.Line, declaration.Column);
                    If (declaration.IsAbstract || declaration.IsSealed)
                        This.Report(type.Syntax, "Invalid Static Class",
                            "Static class cannot be abstract or sealed",
                            declaration.Line, declaration.Column);
                }
                If (type.BaseType != null)
                {
                    If (This.SameType(type, type.BaseType))
                        This.Report(type.Syntax, "Invalid Inheritance",
                            "Class cannot inherit from itself",
                            declaration.Line, declaration.Column);
                    ElseIf (type.BaseType.Declaration != null &&
                        type.BaseType.Declaration.IsSealed)
                        This.Report(type.Syntax, "Invalid Inheritance",
                            "Cannot inherit from sealed class",
                            declaration.Line, declaration.Column);
                }

                If (!declaration.IsStatic && !declaration.IsAbstract)
                {
                    TypeSymbol baseType = type.BaseType;
                    int depth = 0;
                    While (baseType != null && depth < 256)
                    {
                        FunctionSymbol baseMethod = This.FirstFunction;
                        While (baseMethod != null)
                        {
                            If (baseMethod.OwnerType == baseType &&
                                baseMethod.Declaration.IsAbstract &&
                                !baseMethod.Declaration.IsConstructor)
                            {
                                FunctionSymbol implementation =
                                    This.FindMethodSignature(type, baseMethod);
                                If (implementation == null ||
                                    implementation.Declaration.IsAbstract)
                                    This.Report(type.Syntax, "Abstract Method",
                                        "Class must implement abstract base method",
                                        declaration.Line, declaration.Column);
                            }
                            baseMethod = baseMethod.Next;
                        }
                        baseType = baseType.BaseType;
                        depth = depth + 1;
                    }

                    TypeSymbol interfaceOwner = type;
                    int interfaceDepth = 0;
                    While (interfaceOwner != null &&
                        interfaceDepth < 256)
                    {
                        InterfaceTypeLink interfaceLink =
                            interfaceOwner.FirstInterface;
                        While (interfaceLink != null)
                        {
                            FunctionSymbol interfaceMethod = This.FirstFunction;
                            While (interfaceMethod != null)
                            {
                                If (interfaceMethod.OwnerType ==
                                        interfaceLink.Type &&
                                    !interfaceMethod.Declaration.IsStatic &&
                                    !interfaceMethod.Declaration.IsConstructor)
                                {
                                    FunctionSymbol implementation =
                                        This.FindMethodSignature(type,
                                            interfaceMethod);
                                    If (implementation == null ||
                                        implementation.Declaration.IsAbstract)
                                        This.Report(type.Syntax,
                                            "Interface Method",
                                            "Class must implement interface method",
                                            declaration.Line,
                                            declaration.Column);
                                    ElseIf (implementation.Declaration.Access != 1)
                                        This.Report(implementation.Syntax,
                                            "Interface Method",
                                            "Interface implementation must be public",
                                            implementation.Declaration.Line,
                                            implementation.Declaration.Column);
                                }
                                interfaceMethod = interfaceMethod.Next;
                            }
                            interfaceLink = interfaceLink.Next;
                        }
                        interfaceOwner = interfaceOwner.BaseType;
                        interfaceDepth = interfaceDepth + 1;
                    }
                }
            }
            type = type.Next;
        }
    }

    Public Safe Function bool IsBuiltinAttribute(string name)
    {
        string shortName = This.AttributeShortName(name);
        Return shortName == "Cast" || shortName == "Docs" || shortName == "Deprecated" ||
            shortName == "Since" || shortName == "Example" || shortName == "Experimental" ||
            name == "IO.Web.Route" ||
            shortName == "Overload" || shortName == "SymbolName" ||
            shortName == "LinkName" || shortName == "LinkLib" ||
            shortName == "LinkFile" || shortName == "LinkLibTarget" ||
            shortName == "LinkFileTarget";
    }

    Public Safe Function string AttributeShortName(string name)
    {
        int separator = IO.Text.LastIndexOf(name, ".");
        If (separator < 0) Return name;
        Return IO.Text.Slice(name, separator + 1,
            IO.Text.Length(name) - separator - 1);
    }

    Public Safe Function MetaDecl FindMeta(SyntaxTree syntax, string name)
    {
        string shortName = This.AttributeShortName(name);
        bool qualified = shortName != name;
        UnitSymbol unit = This.FirstUnit;
        MetaDecl fallback = null;
        While (unit != null)
        {
            MetaDecl meta = unit.Syntax.FirstMeta;
            While (meta != null)
            {
                If (qualified)
                {
                    If (unit.Name + "." + meta.Name == name) Return meta;
                }
                ElseIf (meta.Name == name)
                {
                    If (unit.Syntax == syntax) Return meta;
                    If (fallback == null) fallback = meta;
                }
                meta = meta.Next;
            }
            unit = unit.Next;
        }
        Return fallback;
    }

    Public Safe Function int BuiltinAttributeTargetMask(string name)
    {
        string shortName = This.AttributeShortName(name);
        If (shortName == "LinkName" || shortName == "LinkLib" ||
            shortName == "LinkFile" || shortName == "LinkLibTarget" ||
            shortName == "LinkFileTarget") Return 2;
        If (shortName == "SymbolName") Return 1 | 4 | 128;
        If (shortName == "Overload") Return 1 | 128;
        If (shortName == "Cast") Return 128;
        Return 511;
    }

    Public Safe Function bool AttributeTargetMatches(int targetMask, int ownerMask)
    {
        If (ownerMask == 2) Return (targetMask & (1 | 2)) != 0;
        If (ownerMask == 4) Return (targetMask & (1 | 4)) != 0;
        Return (targetMask & ownerMask) != 0;
    }

    Public Safe Function bool AttributeIsRepeatable(string name, MetaDecl meta)
    {
        If (meta != null) Return meta.IsRepeatable;
        string shortName = This.AttributeShortName(name);
        Return shortName == "LinkLib" || shortName == "LinkFile" ||
            shortName == "LinkLibTarget" || shortName == "LinkFileTarget";
    }

    Public Safe Function bool MetaArgumentMatches(string typeName, ExpressionNode argument)
    {
        If (argument == null) Return false;
        string canonical = This.CanonicalTypeName(typeName);
        If (canonical == "string")
            Return argument.Kind == [int](ExpressionKind.String);
        If (canonical == "bool")
            Return argument.Kind == [int](ExpressionKind.Boolean);
        If (canonical == "char")
            Return argument.Kind == [int](ExpressionKind.Character);
        If (canonical == "byte" || canonical == "int" ||
            canonical == "i8" || canonical == "i16" ||
            canonical == "i32" || canonical == "i64" ||
            canonical == "u8" || canonical == "u16" ||
            canonical == "u32" || canonical == "u64" ||
            canonical == "isize" || canonical == "usize" ||
            canonical == "float" || canonical == "f16" ||
            canonical == "f32" || canonical == "f64" ||
            canonical == "f128")
            Return argument.Kind == [int](ExpressionKind.Number);
        Return argument.Kind == [int](ExpressionKind.Member);
    }

    Public Safe Function void ValidateAttributeArguments(SyntaxTree syntax,
                                                          SyntaxAttribute attribute,
                                                          MetaDecl meta,
                                                          int line, int column)
    {
        int count = 0;
        ExpressionNode argument = attribute.FirstArgument;
        While (argument != null)
        {
            count = count + 1;
            argument = argument.Next;
        }
        string shortName = This.AttributeShortName(attribute.Name);
        If (meta != null)
        {
            If (count < meta.RequiredParameterCount() ||
                count > meta.ParameterCount())
            {
                This.Report(syntax, "Invalid Attribute",
                    "Meta argument count does not match declaration", line, column);
                Return;
            }
            ParameterDecl parameter = meta.FirstParameter;
            argument = attribute.FirstArgument;
            While (argument != null && parameter != null)
            {
                If (!This.MetaArgumentMatches(parameter.TypeName, argument))
                    This.Report(syntax, "Invalid Attribute",
                        "Meta argument type does not match declaration", line, column);
                argument = argument.Next;
                parameter = parameter.Next;
            }
            Return;
        }
        If (attribute.Name == "IO.Web.Route") Return;
        If (shortName == "Cast" || shortName == "Overload")
        {
            If (count != 0)
                This.Report(syntax, "Invalid Attribute",
                    shortName + " requires no arguments", line, column);
            Return;
        }
        int minimum = 1;
        bool unbounded = shortName == "LinkLib" || shortName == "LinkFile";
        If (shortName == "LinkLibTarget" || shortName == "LinkFileTarget")
        {
            minimum = 2;
            unbounded = true;
        }
        If (count < minimum || (!unbounded && count != minimum))
        {
            This.Report(syntax, "Invalid Attribute",
                "Built-in Meta argument count does not match declaration",
                line, column);
            Return;
        }
        argument = attribute.FirstArgument;
        While (argument != null)
        {
            If (argument.Kind != [int](ExpressionKind.String))
                This.Report(syntax, "Invalid Attribute",
                    "Built-in Meta requires string literal arguments",
                    line, column);
            argument = argument.Next;
        }
    }

    Public Safe Function void ValidateAttributeList(SyntaxTree syntax,
                                                     SyntaxAttribute first,
                                                     int ownerMask,
                                                     int line, int column)
    {
        SyntaxAttribute attribute = first;
        While (attribute != null)
        {
            MetaDecl meta = This.FindMeta(syntax, attribute.Name);
            bool builtin = This.IsBuiltinAttribute(attribute.Name);
            If (!builtin && meta == null)
                This.Report(syntax, "Unknown Attribute", "Meta not declared",
                    line, column);
            Else
            {
                int targetMask = meta == null ?
                    This.BuiltinAttributeTargetMask(attribute.Name) : meta.TargetMask;
                If (!This.AttributeTargetMatches(targetMask, ownerMask))
                    This.Report(syntax, "Invalid Attribute",
                        This.AttributeShortName(attribute.Name) +
                            " is not valid on this declaration",
                        line, column);
                Else This.ValidateAttributeArguments(
                    syntax, attribute, meta, line, column);
                SyntaxAttribute previous = first;
                While (previous != attribute)
                {
                    If (This.AttributeShortName(previous.Name) ==
                            This.AttributeShortName(attribute.Name) &&
                        !This.AttributeIsRepeatable(attribute.Name, meta))
                    {
                        This.Report(syntax, "Invalid Attribute",
                            "Meta is not Repeatable on this declaration",
                            line, column);
                        Break;
                    }
                    previous = previous.Next;
                }
            }
            attribute = attribute.Next;
        }
    }

    Public Safe Function void ValidateAttributes(FunctionSymbol function)
    {
        int ownerMask = function.OwnerType != null ? 128 :
            (function.Declaration.IsExtern ? 2 :
             (function.Declaration.IsDelegate ? 4 : 1));
        This.ValidateAttributeList(function.Syntax,
            function.Declaration.FirstAttribute, ownerMask,
            function.Declaration.Line, function.Declaration.Column);
    }

    Public Safe Function bool MetaParameterTypeSupported(string typeName)
    {
        string canonical = This.CanonicalTypeName(typeName);
        If (canonical == "bool" || canonical == "char" ||
            canonical == "string" || canonical == "byte" ||
            canonical == "int" || canonical == "i8" ||
            canonical == "i16" || canonical == "i32" ||
            canonical == "i64" || canonical == "u8" ||
            canonical == "u16" || canonical == "u32" ||
            canonical == "u64" || canonical == "isize" ||
            canonical == "usize" || canonical == "float" ||
            canonical == "f16" || canonical == "f32" ||
            canonical == "f64" || canonical == "f128") Return true;
        TypeSymbol type = This.FindExactType(canonical);
        Return type != null && type.Declaration != null &&
            type.Declaration.Kind == TokenKind.KwEnum;
    }

    Public Safe Function void ValidateMetaDeclarations()
    {
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            MetaDecl meta = unit.Syntax.FirstMeta;
            While (meta != null)
            {
                If (This.IsBuiltinAttribute(meta.Name))
                    This.Report(unit.Syntax, "Invalid Meta",
                        "Built-in Meta names cannot be redefined",
                        meta.Line, meta.Column);
                If (meta.TargetMask == 0)
                    This.Report(unit.Syntax, "Invalid Meta",
                        "Meta declaration must define at least one On target",
                        meta.Line, meta.Column);
                If (meta.KeepKind == 0)
                    This.Report(unit.Syntax, "Invalid Meta",
                        "Meta declaration must define a Keep mode",
                        meta.Line, meta.Column);
                ParameterDecl parameter = meta.FirstParameter;
                While (parameter != null)
                {
                    If (!This.MetaParameterTypeSupported(parameter.TypeName))
                        This.Report(unit.Syntax, "Invalid Meta",
                            "Meta parameters only support literal-friendly types",
                            meta.Line, meta.Column);
                    ParameterDecl previous = meta.FirstParameter;
                    While (previous != parameter)
                    {
                        If (previous.Name == parameter.Name)
                        {
                            This.Report(unit.Syntax, "Duplicate Parameter",
                                "Meta parameter already defined",
                                meta.Line, meta.Column);
                            Break;
                        }
                        previous = previous.Next;
                    }
                    If (parameter.DefaultValue != null &&
                        !This.MetaArgumentMatches(
                            parameter.TypeName, parameter.DefaultValue))
                        This.Report(unit.Syntax, "Invalid Attribute",
                            "Meta default value must be a matching literal",
                            meta.Line, meta.Column);
                    parameter = parameter.Next;
                }
                meta = meta.Next;
            }
            unit = unit.Next;
        }
    }

    Public Safe Function int TypeAttributeTargetMask(TypeDecl declaration)
    {
        If (declaration.Kind == TokenKind.KwClass) Return 8;
        If (declaration.Kind == TokenKind.KwStruct) Return 16;
        If (declaration.Kind == TokenKind.KwEnum) Return 32;
        If (declaration.Kind == TokenKind.KwInterface) Return 64;
        Return 0;
    }

    Public Safe Function void ValidateTypeAndFieldAttributes()
    {
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            TypeDecl type = unit.Syntax.FirstType;
            While (type != null)
            {
                This.ValidateAttributeList(unit.Syntax, type.FirstAttribute,
                    This.TypeAttributeTargetMask(type), type.Line, type.Column);
                FieldDecl field = type.FirstField;
                While (field != null)
                {
                    This.ValidateAttributeList(unit.Syntax, field.FirstAttribute,
                        256, field.Line, field.Column);
                    field = field.Next;
                }
                type = type.Next;
            }
            unit = unit.Next;
        }
    }

    Public Safe Function bool IsCustomCast(FunctionSymbol function, TypeSymbol target,
                                             HirExpression source)
    {
        If (function.OwnerType != target || !function.Declaration.IsStatic ||
            This.FindAttribute(function.Declaration, "Cast") == null ||
            function.Declaration.Access != 1 || function.Declaration.IsAsync ||
            function.Declaration.IsVirtual || function.Declaration.IsOverride ||
            function.Declaration.IsAbstract || function.Declaration.IsSealed ||
            function.Declaration.IsConstructor ||
            !This.SameType(function.ReturnType, target) ||
            function.FirstParameter == null || function.FirstParameter.Next != null)
            Return false;
        Return This.IsHirAssignable(function.FirstParameter.Type, source);
    }

    Public Safe Function int CustomCastCount(TypeSymbol target, HirExpression source)
    {
        int count = 0;
        FunctionSymbol function = This.FirstFunction;
        While (function != null)
        {
            If (This.IsCustomCast(function, target, source)) count = count + 1;
            function = function.Next;
        }
        Return count;
    }

    Public Safe Function FunctionSymbol FindCustomCast(TypeSymbol target, HirExpression source)
    {
        FunctionSymbol function = This.FirstFunction;
        While (function != null)
        {
            If (This.IsCustomCast(function, target, source)) Return function;
            function = function.Next;
        }
        Return null;
    }

    Public Safe Function string TypeIdentity(TypeSymbol type)
    {
        If (type == null) Return "?";
        If (type.Kind == [int](TypeKind.ArrayType)) Return This.TypeIdentity(type.ElementType) + "[]";
        If (type.Kind == [int](TypeKind.PackageType))
        {
            If (type.PackageCount == 0) Return type.Name;
            string packageName = "<";
            PackageElementType element = type.FirstPackageElement;
            int index = 0;
            While (element != null)
            {
                If (index > 0) packageName = packageName + ",";
                packageName = packageName + This.TypeIdentity(element.Type);
                index = index + 1;
                element = element.Next;
            }
            Return packageName + ">";
        }
        If (type.Kind == [int](TypeKind.PointerType)) Return This.TypeIdentity(type.ElementType) + "*";
        Return type.QualifiedName();
    }

    Public Safe Function bool SameType(TypeSymbol left, TypeSymbol right)
    {
        If (left == right) Return true;
        If (left == null || right == null || left.Kind != right.Kind) Return false;
        If (left.Kind == [int](TypeKind.ArrayType) ||
            left.Kind == [int](TypeKind.PointerType))
            Return This.SameType(left.ElementType, right.ElementType);
        If (left.Kind == [int](TypeKind.PackageType))
        {
            If (left.PackageCount != right.PackageCount) Return false;
            PackageElementType leftElement = left.FirstPackageElement;
            PackageElementType rightElement = right.FirstPackageElement;
            While (leftElement != null && rightElement != null)
            {
                If (!This.SameType(leftElement.Type, rightElement.Type)) Return false;
                leftElement = leftElement.Next;
                rightElement = rightElement.Next;
            }
            Return leftElement == null && rightElement == null;
        }
        Return left.QualifiedName() == right.QualifiedName();
    }

    Public Safe Function bool IsAssignable(TypeSymbol target, TypeSymbol source)
    {
        If (target == null || source == null) Return false;
        If (This.SameType(target, source) || target.Kind == [int](TypeKind.AnyType)) Return true;
        If (source.Kind == [int](TypeKind.AnyType)) Return true;
        If (target.Kind == [int](TypeKind.StringType) && source.Name == "char") Return true;
        If (target.Kind == [int](TypeKind.PointerType) && target.ElementType != null &&
            source.Kind == [int](TypeKind.ArrayType) && source.ElementType != null &&
            (target.ElementType.Kind == [int](TypeKind.VoidType) ||
             This.SameType(target.ElementType, source.ElementType))) Return true;
        If (target.Kind == [int](TypeKind.PointerType) && target.ElementType != null &&
            target.ElementType.Name == "char" && source.Kind == [int](TypeKind.StringType))
            Return true;
        If (target.Kind == [int](TypeKind.PointerType) &&
            source.Kind == [int](TypeKind.IntegerType)) Return true;
        If ((target.Name == "IO.Type.Object.Class" || target.Name == "Object.Class") &&
            ((source.Kind == [int](TypeKind.NamedType) &&
              !This.IsStructType(source) && !This.IsEnumType(source)) ||
             source.Kind == [int](TypeKind.ArrayType) ||
             source.Kind == [int](TypeKind.PointerType))) Return true;
        If (target.Kind == [int](TypeKind.IntegerType) &&
            source.Kind == [int](TypeKind.IntegerType)) Return true;
        If (target.Kind == [int](TypeKind.FloatType) &&
            (source.Kind == [int](TypeKind.FloatType) ||
             source.Kind == [int](TypeKind.IntegerType))) Return true;
        If (source.Kind == [int](TypeKind.NullType) &&
            (target.Kind == [int](TypeKind.StringType) ||
             target.Kind == [int](TypeKind.ListType) ||
             target.Kind == [int](TypeKind.DictType) ||
             target.Kind == [int](TypeKind.SetType) ||
             target.Kind == [int](TypeKind.ArrayType) ||
             target.Kind == [int](TypeKind.PointerType) ||
             (target.Kind == [int](TypeKind.NamedType) &&
              !This.IsStructType(target) && !This.IsEnumType(target)))) Return true;
        If (target.Kind == [int](TypeKind.NamedType) &&
            source.Kind == [int](TypeKind.NamedType))
        {
            If (This.IsInterfaceType(target))
                Return This.TypeImplementsInterface(source, target);
            TypeSymbol current = source.BaseType;
            While (current != null)
            {
                If (This.SameType(target, current)) Return true;
                current = current.BaseType;
            }
        }
        Return false;
    }

    Public Safe Function bool IsHirAssignable(TypeSymbol target, HirExpression source)
    {
        If (source == null) Return false;
        If (source.Syntax != null && source.Syntax.Kind == [int](ExpressionKind.Null) &&
            source.Syntax.Text == "default")
        {
            source.Type = target;
            Return true;
        }
        If (target.Kind == [int](TypeKind.PackageType) &&
            source.Kind == [int](HirExpressionKind.PackageLiteral))
        {
            If (target.PackageCount != source.Type.PackageCount) Return false;
            PackageElementType expected = target.FirstPackageElement;
            HirExpression actual = source.FirstArgument;
            bool assignable = true;
            While (expected != null && actual != null)
            {
                If (!This.IsHirAssignable(expected.Type, actual)) assignable = false;
                expected = expected.Next;
                actual = actual.Next;
            }
            If (assignable) source.Type = target;
            Return assignable;
        }
        If (This.IsAssignable(target, source.Type)) Return true;
        If ((target.Name == "IO.Type.Object.Function" || target.Name == "Object.Function") &&
            source.Kind == [int](HirExpressionKind.Namespace) &&
            This.RuntimeCallType(source.Target, null) != null)
        {
            source.Kind = [int](HirExpressionKind.FunctionReference);
            source.Type = This.MakePointerType(This.Primitive("byte"));
            Return true;
        }
        If (target.Kind == [int](TypeKind.ArrayType) &&
            source.Kind == [int](HirExpressionKind.ArrayLiteral))
        {
            HirExpression item = source.FirstArgument;
            While (item != null)
            {
                If (!This.IsHirAssignable(target.ElementType, item)) Return false;
                item = item.Next;
            }
            source.Type = target;
            Return true;
        }
        If (source.Kind != [int](HirExpressionKind.FunctionReference) ||
            source.Function == null) Return false;
        If (target.Name == "IO.Type.Object.Class" || target.Name == "Object.Class") Return true;
        If (source.Function.IsBlockLiteral)
            Return target.Name == "IO.Type.Object.Block" || target.Name == "Object.Block";
        Return target.Name == "IO.Type.Object.Function" || target.Name == "Object.Function";
    }

    Public Safe Function SyntaxAttribute FindAttribute(FunctionDecl declaration, string name)
    {
        If (declaration == null) Return null;
        SyntaxAttribute attribute = declaration.FirstAttribute;
        While (attribute != null)
        {
            If (This.AttributeShortName(attribute.Name) == name) Return attribute;
            attribute = attribute.Next;
        }
        Return null;
    }

    Public Safe Function string AttributeString(FunctionDecl declaration, string name)
    {
        SyntaxAttribute attribute = This.FindAttribute(declaration, name);
        If (attribute == null || attribute.FirstArgument == null) Return "";
        string value = attribute.FirstArgument.Text;
        int length = IO.Text.Length(value);
        If (length >= 2) Return IO.Text.Slice(value, 1, length - 2);
        Return value;
    }

    Public Safe Function string RuntimeSymbolName(FunctionSymbol function)
    {
        If (function == null || function.Declaration == null) Return null;
        If (function.Declaration.IsDelegate)
        {
            string symbol = This.AttributeString(function.Declaration, "SymbolName");
            Return IO.Text.IsEmpty(symbol) ? function.Name : symbol;
        }
        If (function.Declaration.IsExtern)
        {
            string symbol = This.AttributeString(function.Declaration, "LinkName");
            Return IO.Text.IsEmpty(symbol) ? function.Name : symbol;
        }
        Return null;
    }

    Public Safe Function bool IsSupportedCAbiType(TypeSymbol type)
    {
        If (type == null) Return false;
        Return type.Kind == [int](TypeKind.VoidType) ||
            type.Kind == [int](TypeKind.BoolType) ||
            type.Kind == [int](TypeKind.IntegerType) ||
            type.Kind == [int](TypeKind.FloatType) ||
            type.Kind == [int](TypeKind.StringType) ||
            type.Kind == [int](TypeKind.PointerType) ||
            type.Kind == [int](TypeKind.ArrayType);
    }

    Public Safe Function void ValidateFunctionDeclaration(FunctionSymbol function)
    {
        FunctionDecl declaration = function.Declaration;
        SyntaxTree syntax = function.Syntax;
        This.ValidateAttributes(function);
        SyntaxAttribute overload = This.FindAttribute(declaration, "Overload");
        SyntaxAttribute symbolName = This.FindAttribute(declaration, "SymbolName");
        SyntaxAttribute cast = This.FindAttribute(declaration, "Cast");
        If (overload != null && symbolName == null)
            This.Report(syntax, "Invalid Overload", "Overload requires SymbolName",
                declaration.Line, declaration.Column);
        If (symbolName != null &&
            (declaration.IsExtern || (declaration.IsDelegate && declaration.Abi != "C")))
            This.Report(syntax, "Invalid Attribute", "SymbolName is not valid on this declaration",
                declaration.Line, declaration.Column);
        If (cast != null && function.OwnerType != null)
        {
            If (declaration.IsConstructor)
                This.Report(syntax, "Invalid Cast Method",
                    "Cast method cannot be a constructor",
                    declaration.Line, declaration.Column);
            ElseIf (!declaration.IsStatic)
                This.Report(syntax, "Invalid Cast Method",
                    "Cast method must be static",
                    declaration.Line, declaration.Column);
            ElseIf (declaration.Access != 1)
                This.Report(syntax, "Invalid Cast Method",
                    "Cast method must be public",
                    declaration.Line, declaration.Column);
            ElseIf (declaration.IsAsync)
                This.Report(syntax, "Invalid Cast Method",
                    "Cast method cannot be async",
                    declaration.Line, declaration.Column);
            ElseIf (declaration.IsVirtual || declaration.IsOverride ||
                declaration.IsAbstract || declaration.IsSealed)
                This.Report(syntax, "Invalid Cast Method",
                    "Cast method cannot be virtual, override, abstract, or sealed",
                    declaration.Line, declaration.Column);
            ElseIf (function.ParameterCount() != 1)
                This.Report(syntax, "Invalid Cast Method",
                    "Cast method must declare exactly one parameter",
                    declaration.Line, declaration.Column);
            ElseIf (!This.SameType(function.ReturnType, function.OwnerType))
                This.Report(syntax, "Invalid Cast Method",
                    "Cast method must return its owning class",
                    declaration.Line, declaration.Column);
        }

        If (declaration.IsExtern && declaration.Abi == "C")
        {
            If (!This.IsSupportedCAbiType(function.ReturnType))
                This.Report(syntax, "Unsupported Type", "C ABI return type is not supported",
                    declaration.Line, declaration.Column);
            ParameterSymbol parameter = function.FirstParameter;
            While (parameter != null)
            {
                If (!This.IsSupportedCAbiType(parameter.Type))
                    This.Report(syntax, "Unsupported Type", "C ABI parameter type is not supported",
                        declaration.Line, declaration.Column);
                parameter = parameter.Next;
            }
        }
    }

    Public Safe Function FunctionSymbol FindGenericInstance(FunctionSymbol definition, string key)
    {
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (current.IsGenericInstance && current.GenericDefinition == definition &&
                current.GenericKey == key) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function FunctionSymbol InstantiateGenericFunction(SyntaxTree callerSyntax,
                                                                     FunctionSymbol caller,
                                                                     FunctionSymbol definition,
                                                                     ExpressionNode call)
    {
        TypeParameterDecl parameter = definition.Declaration.FirstTypeParameter;
        TypeArgumentNode argument = call.FirstTypeArgument;
        TypeSubstitution first = null;
        TypeSubstitution last = null;
        string key = "";
        int count = 0;
        While (parameter != null && argument != null)
        {
            TypeSymbol argumentType = This.ResolveFunctionType(callerSyntax, caller, argument.TypeName);
            If (argumentType == null)
            {
                This.Report(callerSyntax, "Unknown generic argument",
                    This.CanonicalTypeName(argument.TypeName), argument.Line, argument.Column);
                Return null;
            }
            TypeSubstitution substitution = New TypeSubstitution(parameter.Name, argumentType);
            If (first == null) first = substitution;
            Else last.Next = substitution;
            last = substitution;
            If (!IO.Text.IsEmpty(key)) key = key + "$";
            key = key + This.TypeIdentity(argumentType);
            count = count + 1;
            parameter = parameter.Next;
            argument = argument.Next;
        }
        If (parameter != null || argument != null || count != definition.Declaration.TypeParameterCount())
        {
            This.Report(callerSyntax, "Generic arity", definition.Name,
                call.Line, call.Column);
            Return null;
        }

        FunctionSymbol existing = This.FindGenericInstance(definition, key);
        If (existing != null) Return existing;

        FunctionSymbol instance = New FunctionSymbol(definition.UnitName,
            definition.OwnerType, definition.Declaration);
        instance.Syntax = definition.Syntax;
        instance.IsGenericInstance = true;
        instance.GenericDefinition = definition;
        instance.GenericKey = key;
        instance.FirstSubstitution = first;
        UnitSymbol definingUnit = This.FindUnit(definition.UnitName);
        SyntaxTree definingSyntax = definingUnit == null ? callerSyntax : definingUnit.Syntax;
        instance.ReturnType = This.ResolveFunctionType(definingSyntax, instance,
            definition.Declaration.ReturnType);
        ParameterDecl declaredParameter = definition.Declaration.FirstParameter;
        While (declaredParameter != null)
        {
            ParameterSymbol parameterSymbol = New ParameterSymbol(declaredParameter.Name,
                This.ResolveFunctionType(definingSyntax, instance, declaredParameter.TypeName));
            parameterSymbol.Declaration = declaredParameter;
            instance.AddParameter(parameterSymbol);
            declaredParameter = declaredParameter.Next;
        }
        If (instance.ReturnType == null)
        {
            This.Report(definingSyntax, "Invalid generic return type", definition.Name,
                definition.Declaration.Line, definition.Declaration.Column);
            Return null;
        }
        ParameterSymbol concreteParameter = instance.FirstParameter;
        While (concreteParameter != null)
        {
            If (concreteParameter.Type == null)
            {
                This.Report(definingSyntax, "Invalid generic parameter type", definition.Name,
                    definition.Declaration.Line, definition.Declaration.Column);
                Return null;
            }
            concreteParameter = concreteParameter.Next;
        }
        This.AddFunctionSymbol(instance);
        This.FunctionCount = This.FunctionCount + 1;
        This.GenericInstanceCount = This.GenericInstanceCount + 1;
        Return instance;
    }

    Public Safe Function FunctionSymbol ResolveGenericCallTarget(SyntaxTree syntax,
                                                                  FunctionSymbol caller,
                                                                  FunctionSymbol target,
                                                                  ExpressionNode call)
    {
        If (target == null) Return null;
        If (target.IsGenericTemplate())
        {
            If (call.TypeArgumentCount() == 0)
            {
                This.Report(syntax, "Generic Function", "explicit type arguments are required",
                    call.Line, call.Column);
                Return null;
            }
            Return This.InstantiateGenericFunction(syntax, caller, target, call);
        }
        If (call.TypeArgumentCount() != 0)
        {
            This.Report(syntax, "Invalid generic call", target.Name,
                call.Line, call.Column);
            Return null;
        }
        Return target;
    }

    Public Safe Function string ExpressionPath(ExpressionNode expression)
    {
        If (expression == null) Return "";
        If (expression.Kind == [int](ExpressionKind.Name)) Return expression.Text;
        If (expression.Kind != [int](ExpressionKind.Member)) Return "";
        string parent = This.ExpressionPath(expression.Left);
        If (IO.Text.IsEmpty(parent)) Return "";
        Return parent + "." + expression.Text;
    }

    Public Safe Function string ExpandImportPath(SyntaxTree syntax, string path)
    {
        string expanded = path;
        int pass = 0;
        While (pass < 32)
        {
            string next = expanded;
            ImportDecl import = syntax.FirstImport;
            While (import != null)
            {
                If ((import.Kind == 1 || import.Kind == 3) && expanded == import.Name)
                    next = import.Target;
                Else
                {
                    string prefix = import.Name + ".";
                    If ((import.Kind == 1 || import.Kind == 3) &&
                        IO.Text.StartsWith(expanded, prefix))
                        next = import.Target + "." +
                            IO.Text.Slice(expanded, IO.Text.Length(prefix),
                                IO.Text.Length(expanded) - IO.Text.Length(prefix));
                }
                If (next != expanded) Break;
                import = import.Next;
            }
            If (next == expanded) Return expanded;
            expanded = next;
            pass = pass + 1;
        }
        Return expanded;
    }

    Public Safe Function bool AliasTargetIsVisible(SyntaxTree syntax, ImportDecl alias)
    {
        If (!IO.Text.Contains(alias.Target, ".")) Return true;
        If (alias.Target == syntax.UnitName ||
            IO.Text.StartsWith(alias.Target, syntax.UnitName + ".")) Return true;
        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            If (import != alias && (import.Kind == 0 || import.Kind == 2) &&
                (alias.Target == import.Target ||
                 IO.Text.StartsWith(alias.Target, import.Target + "."))) Return true;
            import = import.Next;
        }
        Return false;
    }

    Public Safe Function bool PathUsesHiddenAliasTarget(SyntaxTree syntax, string path)
    {
        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            If (import.Kind == 1 &&
                (path == import.Target || IO.Text.StartsWith(path, import.Target + ".")))
            {
                ImportDecl direct = syntax.FirstImport;
                While (direct != null)
                {
                    If ((direct.Kind == 0 || direct.Kind == 2) &&
                        (path == direct.Target ||
                         IO.Text.StartsWith(path, direct.Target + "."))) Return false;
                    direct = direct.Next;
                }
                Return true;
            }
            import = import.Next;
        }
        Return false;
    }

    Public Safe Function bool QualifiedPathIsVisible(SyntaxTree syntax, string path)
    {
        If (path == syntax.UnitName || IO.Text.StartsWith(path, syntax.UnitName + "."))
            Return true;
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            If (unit.Name == syntax.UnitName)
            {
                ImportDecl import = unit.Syntax.FirstImport;
                While (import != null)
                {
                    If ((import.Kind == 0 || import.Kind == 2) &&
                        (path == import.Target || IO.Text.StartsWith(path, import.Target + ".")))
                        Return true;
                    If ((import.Kind == 1 || import.Kind == 3) &&
                        (path == import.Name || IO.Text.StartsWith(path, import.Name + ".")))
                        Return true;
                    import = import.Next;
                }
            }
            unit = unit.Next;
        }
        Return false;
    }

    Public Safe Function bool HasUnscopedImportedFunction(SyntaxTree syntax, string name,
                                                           int parameterCount)
    {
        ImportDecl import = syntax.FirstImport;
        While (import != null)
        {
            If (import.Kind == 2 && import.Name == name) Return true;
            If (import.Kind == 0)
            {
                FunctionSymbol function = This.FirstFunction;
                While (function != null)
                {
                    If (function.OwnerType == null && function.UnitName == import.Target &&
                        function.Name == name && function.AcceptsArgumentCount(parameterCount))
                        Return true;
                    function = function.Next;
                }
                If (This.RuntimeCallType(import.Target + "." + name, null) != null) Return true;
            }
            import = import.Next;
        }
        Return false;
    }

    Public Safe Function int ArgumentCount(ExpressionNode call)
    {
        int count = 0;
        ExpressionNode argument = call.FirstArgument;
        While (argument != null)
        {
            count = count + 1;
            argument = argument.Next;
        }
        Return count;
    }

    Public Safe Function bool IsNamespacePrefix(string name)
    {
        If (name == "IO" || name == "IO.Kinal" || name == "IO.Kinal.Compiler") Return true;
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            If (unit.Name == name || IO.Text.StartsWith(unit.Name, name + ".")) Return true;
            unit = unit.Next;
        }
        Return false;
    }

    Public Safe Function TypeSymbol FindEnumMemberType(string path)
    {
        TypeSymbol type = This.FirstType;
        While (type != null)
        {
            If (type.Declaration != null && type.Declaration.Kind == TokenKind.KwEnum &&
                IO.Text.StartsWith(path, type.QualifiedName() + "."))
            {
                string memberName = IO.Text.Slice(path, IO.Text.Length(type.QualifiedName()) + 1,
                    IO.Text.Length(path) - IO.Text.Length(type.QualifiedName()) - 1);
                EnumMemberDecl member = type.Declaration.FirstEnumMember;
                While (member != null)
                {
                    If (member.Name == memberName) Return type;
                    member = member.Next;
                }
            }
            type = type.Next;
        }
        Return null;
    }

    Public Safe Function TypeSymbol RuntimeCallType(string target, TypeSymbol receiver)
    {
        string name = target;
        int receiverKind = receiver == null ? [int](TypeKind.Unknown) : receiver.Kind;
        If (target == "IO.Console.PrintLine" || target == "IO.Console.Print" ||
            target == "IO.Console.Write" || target == "IO.Console.WriteLine") Return This.Primitive("void");
        If (target == "IO.Console.ReadLine") Return This.Primitive("string");
        If (IO.Text.StartsWith(target, "IO.File."))
        {
            name = IO.Text.Slice(target, 8, IO.Text.Length(target) - 8);
            If (name == "ReadAllText" || name == "ReadFirstLine" || name == "ReadOrDefault" ||
                name == "ReadIfExists" || name == "ReadOr") Return This.Primitive("string");
            If (name == "ReadLines") Return This.Primitive("list");
            If (name == "Size") Return This.Primitive("int");
            Return This.Primitive("bool");
        }
        If (target == "IO.Memory.Copy" || target == "IO.Memory.Zero" ||
            target == "IO.Time.Sleep") Return This.Primitive("void");
        If (target == "IO.Memory.Set" || target == "IO.GC.Collect" ||
            target == "IO.Error.Clear" || target == "IO.System.Exit" ||
            target == "IO.Panic.Abort" || target == "IO.Panic.Halt")
            Return This.Primitive("void");
        If (target == "IO.Memory.Compare" || target == "IO.System.Exec" ||
            target == "IO.Async.ExitCode") Return This.Primitive("int");
        If (target == "IO.System.CommandLine" || target == "IO.System.LastError" ||
            target == "IO.Error.LastTrace") Return This.Primitive("string");
        If (target == "IO.System.LoadLibrary" || target == "IO.System.GetSymbol" ||
            target == "IO.Async.Spawn") Return This.MakePointerType(This.Primitive("byte"));
        If (target == "IO.System.FileExists" || target == "IO.System.CloseLibrary" ||
            target == "IO.Async.IsCompleted" ||
            target == "IO.Async.Wait" || target == "IO.Async.Close" ||
            target == "IO.Error.HasException") Return This.Primitive("bool");
        If (target == "IO.Time.Now") Return This.FindExactType("IO.Time.DateTime");
        If (target == "IO.Time.Format") Return This.Primitive("string");
        If (target == "IO.Async.Sleep" || target == "IO.Async.Yield")
            Return This.FindExactType("IO.Async.Task");
        If (target == "IO.Async.Run") Return This.Primitive("any");
        If (target == "IO.Error.Current") Return This.FindExactType("IO.Error");
        If (target == "IO.Time.GetTick" || target == "IO.Time.GetNanoTick")
            Return This.Primitive("int");
        If (target == "IO.Meta.Query" || target == "IO.Meta.Of") Return This.Primitive("list");
        If (target == "IO.Meta.Find") Return This.Primitive("dict");
        If (target == "IO.Meta.Has") Return This.Primitive("bool");
        If (IO.Text.StartsWith(target, "IO.Volatile.Read")) Return This.Primitive("int");
        If (IO.Text.StartsWith(target, "IO.Volatile.Write")) Return This.Primitive("void");
        If (target == "IO.Directory.Files") Return This.Primitive("list");
        If (target == "IO.Directory.Exists" || target == "IO.Directory.Create" ||
            target == "IO.Directory.Ensure" || target == "IO.Directory.Delete" ||
            target == "IO.Directory.DeleteIfExists") Return This.Primitive("bool");
        If (IO.Text.StartsWith(target, "IO.Type."))
        {
            If (target == "IO.Type.string.Length") Return This.Primitive("int");
            If (target == "IO.Type.string.Concat") Return This.Primitive("string");
            If (target == "IO.Type.string.Equals") Return This.Primitive("bool");
            If (target == "IO.Type.string.ToChars")
                Return This.MakeArrayType(This.Primitive("char"));
            If (target == "IO.Type.any.ToString" || target == "IO.Type.any.TypeName")
                Return This.Primitive("string");
            If (target == "IO.Type.any.Tag") Return This.Primitive("int");
            If (target == "IO.Type.any.Equals" || target == "IO.Type.any.IsNull" ||
                target == "IO.Type.any.IsNumber" || target == "IO.Type.any.IsPointer" ||
                target == "IO.Type.any.IsInt" || target == "IO.Type.any.IsFloat" ||
                target == "IO.Type.any.IsString" || target == "IO.Type.any.IsBool" ||
                target == "IO.Type.any.IsChar" || target == "IO.Type.any.IsObject")
                Return This.Primitive("bool");
            string convertedName = IO.Text.Slice(target, 8, IO.Text.Length(target) - 8);
            If (!IO.Text.Contains(convertedName, "."))
            {
                TypeSymbol convertedType = This.Primitive(convertedName);
                If (convertedType != null) Return convertedType;
            }
        }
        If (IO.Text.StartsWith(target, "IO.Path."))
        {
            name = IO.Text.Slice(target, 8, IO.Text.Length(target) - 8);
            If (name == "IsAbsolute" || name == "IsRelative" || name == "HasExtension")
                Return This.Primitive("bool");
            If (name == "BaseName" || name == "ChangeExtension" || name == "Combine" ||
                name == "CurrentDirectory" || name == "Cwd" || name == "Directory" ||
                name == "EnsureTrailingSeparator" || name == "Extension" ||
                name == "FileName" || name == "Join" || name == "Join3" || name == "Join4" ||
                name == "Normalize" || name == "Parent" || name == "Stem")
                Return This.Primitive("string");
            Return null;
        }
        If (IO.Text.StartsWith(target, "IO.Text."))
        {
            name = IO.Text.Slice(target, 8, IO.Text.Length(target) - 8);
            If (name == "Length" || name == "Count" || name == "IndexOf" || name == "LastIndexOf")
                Return This.Primitive("int");
            If (name == "IsEmpty" || name == "Contains" || name == "StartsWith" || name == "EndsWith")
                Return This.Primitive("bool");
            If (name == "Split" || name == "Lines") Return This.Primitive("list");
            Return This.Primitive("string");
        }
        If (target == "list.Create") Return This.Primitive("list");
        If (target == "dict.Create") Return This.Primitive("dict");
        If (target == "set.Create") Return This.Primitive("set");
        If (receiverKind == [int](TypeKind.ListType))
        {
            If (target == "Count") Return This.Primitive("int");
            If (target == "Fetch" || target == "TryFetch" || target == "Peek" ||
                target == "Pop" || target == "RemoveAt") Return This.Primitive("any");
            If (target == "Contains" || target == "IsEmpty") Return This.Primitive("bool");
            If (target == "IndexOf") Return This.Primitive("int");
            If (target == "Add" || target == "Set" || target == "Insert" || target == "Clear")
                Return This.Primitive("void");
        }
        If (receiverKind == [int](TypeKind.StringType))
        {
            If (target == "ToChars") Return This.MakeArrayType(This.Primitive("char"));
            If (target == "Length") Return This.Primitive("int");
            If (target == "Index") Return This.Primitive("char");
        }
        If (receiverKind == [int](TypeKind.DictType))
        {
            If (target == "Count") Return This.Primitive("int");
            If (target == "Fetch" || target == "TryFetch") Return This.Primitive("any");
            If (target == "Contains" || target == "IsEmpty" || target == "Remove")
                Return This.Primitive("bool");
            If (target == "Set") Return This.Primitive("void");
            If (target == "Keys" || target == "Values") Return This.Primitive("list");
        }
        If (receiverKind == [int](TypeKind.SetType))
        {
            If (target == "Count") Return This.Primitive("int");
            If (target == "Contains" || target == "Remove" || target == "IsEmpty")
                Return This.Primitive("bool");
            If (target == "Add" || target == "Clear") Return This.Primitive("void");
            If (target == "Values") Return This.Primitive("list");
        }
        If (receiverKind == [int](TypeKind.ArrayType))
        {
            If (target == "Length") Return This.Primitive("int");
            If (target == "Index") Return receiver.ElementType;
            If (target == "Add") Return receiver;
        }
        If (receiver != null && (target == "TypeOf" || target == "ToString" ||
            target == "TypeName")) Return This.Primitive("string");
        If (receiver != null && (target == "Equals" || target == "IsNull" ||
            target == "IsNumber" || target == "IsPointer" || target == "IsInt" ||
            target == "IsFloat" || target == "IsString" || target == "IsBool" ||
            target == "IsChar" || target == "IsObject")) Return This.Primitive("bool");
        If (receiverKind == [int](TypeKind.NamedType) &&
            (receiver.Name == "block" || receiver.Name == "IO.Type.Object.Block" ||
             receiver.Name == "Object.Block") &&
            (target == "Run" || target == "Jump" || target == "RunUntil" ||
             target == "JumpAndRunUntil")) Return This.Primitive("void");
        Return null;
    }

    Public Safe Function TypeSymbol FindFieldType(SyntaxTree syntax, TypeSymbol owner, string name)
    {
        TypeSymbol current = owner;
        While (current != null && current.Declaration != null)
        {
            SyntaxTree definingSyntax = current.Syntax == null ? syntax : current.Syntax;
            FieldDecl field = current.Declaration.FirstField;
            While (field != null)
            {
                If (field.Name == name) Return This.ResolveType(definingSyntax, field.TypeName);
                field = field.Next;
            }
            current = current.BaseType;
        }
        Return null;
    }

    Public Safe Function TypeSymbol FindInstanceFieldType(SyntaxTree syntax,
                                                           TypeSymbol owner, string name)
    {
        TypeSymbol current = owner;
        While (current != null && current.Declaration != null)
        {
            SyntaxTree definingSyntax = current.Syntax == null ? syntax : current.Syntax;
            FieldDecl field = current.Declaration.FirstField;
            While (field != null)
            {
                If (!field.IsStatic && field.Name == name)
                    Return This.ResolveType(definingSyntax, field.TypeName);
                field = field.Next;
            }
            current = current.BaseType;
        }
        Return null;
    }

    Public Safe Function HirExpression InvalidExpression(SyntaxTree syntax, ExpressionNode expression,
                                                          string title, string detail)
    {
        This.UnresolvedExpressionCount = This.UnresolvedExpressionCount + 1;
        This.Report(syntax, title, detail, expression.Line, expression.Column);
        Return New HirExpression([int](HirExpressionKind.Invalid), expression,
            New TypeSymbol([int](TypeKind.Unknown), "unknown"));
    }

    Public Safe Function HirExpression FailedExpression(ExpressionNode expression)
    {
        This.UnresolvedExpressionCount = This.UnresolvedExpressionCount + 1;
        Return New HirExpression([int](HirExpressionKind.Invalid), expression,
            New TypeSymbol([int](TypeKind.Unknown), "unknown"));
    }

    Public Safe Function bool IsNamedArgument(ExpressionNode expression)
    {
        Return expression != null && expression.Kind == [int](ExpressionKind.Binary) &&
            expression.Operator == TokenKind.Assign && expression.Left != null &&
            expression.Left.Kind == [int](ExpressionKind.Name);
    }

    Public Safe Function ExpressionNode FindNamedArgument(ExpressionNode call, string name)
    {
        ExpressionNode argument = call.FirstArgument;
        While (argument != null)
        {
            If (This.IsNamedArgument(argument) && argument.Left.Text == name)
                Return argument.Right;
            argument = argument.Next;
        }
        Return null;
    }

    Public Safe Function ExpressionNode PositionalArgument(ExpressionNode call, int ordinal)
    {
        int index = 0;
        ExpressionNode argument = call.FirstArgument;
        While (argument != null)
        {
            If (!This.IsNamedArgument(argument))
            {
                If (index == ordinal) Return argument;
                index = index + 1;
            }
            argument = argument.Next;
        }
        Return null;
    }

    Public Safe Function void BindFunctionArguments(SyntaxTree syntax, FunctionSymbol caller,
                                                      BindingScope scope, ExpressionNode call,
                                                      FunctionSymbol target, HirExpression bound)
    {
        ParameterSymbol parameter = target.FirstParameter;
        int positionalOrdinal = 0;
        While (parameter != null)
        {
            ExpressionNode selected = This.FindNamedArgument(call, parameter.Name);
            If (selected == null)
            {
                selected = This.PositionalArgument(call, positionalOrdinal);
                positionalOrdinal = positionalOrdinal + 1;
            }
            bool useDefault = selected == null ||
                (selected.Kind == [int](ExpressionKind.Null) && selected.Text == "default");
            If (useDefault)
            {
                ExpressionNode defaultValue = parameter.Declaration == null ?
                    null : parameter.Declaration.DefaultValue;
                If (defaultValue == null)
                {
                    This.Report(syntax, selected == null ? "Missing argument" : "Default Argument",
                        parameter.Name, call.Line, call.Column);
                    bound.AddArgument(New HirExpression([int](HirExpressionKind.Constant),
                        selected, parameter.Type));
                }
                Else
                {
                    BindingScope defaultScope = New BindingScope(null);
                    HirExpression defaultArgument = This.BindExpression(target.Syntax, target,
                        defaultScope, defaultValue);
                    If (defaultArgument != null && !This.IsHirAssignable(parameter.Type, defaultArgument))
                        This.Report(syntax, "Type Mismatch", "Default argument type does not match parameter",
                            call.Line, call.Column);
                    bound.AddArgument(defaultArgument);
                }
            }
            Else
            {
                HirExpression argument = This.BindExpression(syntax, caller, scope, selected);
                If (argument != null && !This.IsHirAssignable(parameter.Type, argument))
                    This.Report(syntax, "Type Mismatch", "Argument type does not match parameter",
                        selected.Line, selected.Column);
                bound.AddArgument(argument);
            }
            parameter = parameter.Next;
        }
    }

    Public Safe Function bool FunctionArgumentsAssignable(SyntaxTree syntax,
                                                            FunctionSymbol caller,
                                                            BindingScope scope,
                                                            ExpressionNode call,
                                                            FunctionSymbol target)
    {
        ParameterSymbol parameter = target.FirstParameter;
        int positionalOrdinal = 0;
        While (parameter != null)
        {
            ExpressionNode selected = This.FindNamedArgument(call, parameter.Name);
            If (selected == null)
            {
                selected = This.PositionalArgument(call, positionalOrdinal);
                positionalOrdinal = positionalOrdinal + 1;
            }
            bool useDefault = selected == null ||
                (selected.Kind == [int](ExpressionKind.Null) && selected.Text == "default");
            If (useDefault)
            {
                If (parameter.Declaration == null || parameter.Declaration.DefaultValue == null)
                    Return false;
            }
            Else
            {
                HirExpression argument = This.BindExpression(syntax, caller, scope, selected);
                If (argument == null || argument.Kind == [int](HirExpressionKind.Invalid) ||
                    !This.IsHirAssignable(parameter.Type, argument)) Return false;
            }
            parameter = parameter.Next;
        }
        Return true;
    }

    Public Safe Function int CandidateFunctionCount(FunctionSymbol group, int argumentCount)
    {
        int count = 0;
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (!current.IsGenericInstance && current.OwnerType == group.OwnerType &&
                current.UnitName == group.UnitName && current.Name == group.Name &&
                current.AcceptsArgumentCount(argumentCount)) count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function FunctionSymbol FindApplicableFunction(SyntaxTree syntax,
                                                                FunctionSymbol caller,
                                                                BindingScope scope,
                                                                ExpressionNode call,
                                                                FunctionSymbol group)
    {
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (!current.IsGenericInstance && current.OwnerType == group.OwnerType &&
                current.UnitName == group.UnitName && current.Name == group.Name &&
                current.AcceptsArgumentCount(call.ArgumentCount()) &&
                This.FunctionArgumentsAssignable(syntax, caller, scope, call, current))
                Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function int ApplicableFunctionCount(SyntaxTree syntax,
                                                       FunctionSymbol caller,
                                                       BindingScope scope,
                                                       ExpressionNode call,
                                                       FunctionSymbol group)
    {
        int count = 0;
        FunctionSymbol current = This.FirstFunction;
        While (current != null)
        {
            If (!current.IsGenericInstance && current.OwnerType == group.OwnerType &&
                current.UnitName == group.UnitName && current.Name == group.Name &&
                current.AcceptsArgumentCount(call.ArgumentCount()) &&
                This.FunctionArgumentsAssignable(syntax, caller, scope, call, current))
                count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function FunctionSymbol SelectOverload(SyntaxTree syntax,
                                                        FunctionSymbol caller,
                                                        BindingScope scope,
                                                        ExpressionNode call,
                                                        FunctionSymbol initial)
    {
        If (initial == null || This.CandidateFunctionCount(initial, call.ArgumentCount()) <= 1)
            Return initial;
        FunctionSymbol selected = This.FindApplicableFunction(syntax, caller, scope, call, initial);
        int count = This.ApplicableFunctionCount(syntax, caller, scope, call, initial);
        If (count > 1)
        {
            This.Report(syntax, "Ambiguous Call", initial.Name, call.Line, call.Column);
            Return null;
        }
        Return selected == null ? initial : selected;
    }

    Public Safe Function HirExpression HirArgument(HirExpression call, int ordinal)
    {
        HirExpression argument = call.FirstArgument;
        int index = 0;
        While (argument != null)
        {
            If (index == ordinal) Return argument;
            index = index + 1;
            argument = argument.Next;
        }
        Return null;
    }

    Public Safe Function void ValidateRuntimeArguments(SyntaxTree syntax,
                                                        ExpressionNode expression,
                                                        HirExpression call)
    {
        string target = call.Target;
        int expectedCount = -1;
        int receiverKind = call.Left == null ? [int](TypeKind.Unknown) : call.Left.Type.Kind;
        bool namespaceReceiver = call.Left != null &&
            call.Left.Kind == [int](HirExpressionKind.Namespace);
        int receiverArgumentCount = namespaceReceiver ? 1 : 0;

        If (receiverKind == [int](TypeKind.ListType))
        {
            If (target == "Add" || target == "Fetch" || target == "RemoveAt" ||
                target == "Contains" || target == "IndexOf")
                expectedCount = receiverArgumentCount + 1;
            ElseIf (target == "Set" || target == "Insert" || target == "TryFetch")
                expectedCount = receiverArgumentCount + 2;
            ElseIf (target == "Count" || target == "Clear" || target == "Pop" ||
                target == "Peek" || target == "IsEmpty")
                expectedCount = receiverArgumentCount;
        }
        ElseIf (receiverKind == [int](TypeKind.DictType))
        {
            If (target == "Set" || target == "TryFetch")
                expectedCount = receiverArgumentCount + 2;
            ElseIf (target == "Fetch" || target == "Contains" || target == "Remove")
                expectedCount = receiverArgumentCount + 1;
            ElseIf (target == "Count" || target == "IsEmpty" || target == "Keys" ||
                target == "Values") expectedCount = receiverArgumentCount;
        }
        ElseIf (receiverKind == [int](TypeKind.SetType))
        {
            If (target == "Add" || target == "Contains" || target == "Remove")
                expectedCount = receiverArgumentCount + 1;
            ElseIf (target == "Count" || target == "Clear" || target == "IsEmpty" ||
                target == "Values") expectedCount = receiverArgumentCount;
        }
        ElseIf ((target == "IsNull" || target == "ToString" || target == "Tag" ||
            target == "TypeName" || target == "IsNumber" || target == "IsPointer" ||
            target == "IsInt" || target == "IsFloat" || target == "IsString" ||
            target == "IsBool" || target == "IsChar" || target == "IsObject") &&
            call.Left != null) expectedCount = 0;
        ElseIf (target == "Equals" && call.Left != null) expectedCount = 1;
        ElseIf (IO.Text.StartsWith(target, "IO.Type.any."))
        {
            string anyMember = IO.Text.Slice(target, 12, IO.Text.Length(target) - 12);
            expectedCount = anyMember == "Equals" ? 2 : 1;
        }
        ElseIf (target == "Index" && call.Left != null &&
            (call.Left.Type.Kind == [int](TypeKind.StringType) ||
             call.Left.Type.Kind == [int](TypeKind.ArrayType))) expectedCount = 1;
        ElseIf (target == "IO.Text.Join") expectedCount = 2;
        ElseIf (target == "IO.File.WriteLines") expectedCount = 2;
        ElseIf (target == "IO.Async.Spawn" || target == "IO.Async.IsCompleted" ||
            target == "IO.Async.ExitCode" || target == "IO.Async.Close" ||
            target == "IO.Async.Run" || target == "IO.Async.Sleep") expectedCount = 1;
        ElseIf (target == "IO.Async.Wait") expectedCount = 2;
        ElseIf (target == "IO.Async.Yield") expectedCount = 0;

        int actualCount = expression.ArgumentCount();
        If (expectedCount >= 0 && actualCount != expectedCount)
        {
            This.Report(syntax, "Argument Count", target,
                expression.Line, expression.Column);
            Return;
        }

        HirExpression collection = namespaceReceiver ? This.HirArgument(call, 0) : null;
        HirExpression first = This.HirArgument(call, receiverArgumentCount);
        HirExpression second = This.HirArgument(call, receiverArgumentCount + 1);
        If (target == "IO.System.GetSymbol" && second != null && second.Function != null)
        {
            string symbol = This.RuntimeSymbolName(second.Function);
            If (symbol != null)
            {
                second.Kind = [int](HirExpressionKind.Constant);
                second.Type = This.Primitive("string");
                second.Function = null;
                second.Target = "__target_string";
                second.Name = symbol;
            }
        }
        If (collection != null && collection.Type.Kind != receiverKind)
            This.Report(syntax, "Type Mismatch", "collection receiver type does not match",
                expression.Line, expression.Column);
        If (receiverKind == [int](TypeKind.DictType) &&
            (target == "Set" || target == "Fetch" || target == "TryFetch" ||
             target == "Contains" || target == "Remove") && first != null &&
            first.Type.Kind != [int](TypeKind.StringType))
            This.Report(syntax, "Type Mismatch", "dict key must be string",
                expression.Line, expression.Column);
        If (receiverKind == [int](TypeKind.SetType) &&
            (target == "Add" || target == "Contains" || target == "Remove") &&
            first != null && first.Type.Kind != [int](TypeKind.StringType))
            This.Report(syntax, "Type Mismatch", "set value must be string",
                expression.Line, expression.Column);
        If (receiverKind == [int](TypeKind.ListType) &&
            (target == "Fetch" || target == "Set" || target == "Insert" ||
             target == "TryFetch" || target == "RemoveAt") && first != null &&
            first.Type.Kind != [int](TypeKind.IntegerType))
            This.Report(syntax, "Type Mismatch", "list index must be integer",
                expression.Line, expression.Column);
        If (target == "IO.Text.Join" && first != null &&
            first.Type.Kind != [int](TypeKind.ListType) &&
            (first.Type.Kind != [int](TypeKind.ArrayType) ||
             first.Type.ElementType.Kind != [int](TypeKind.StringType)))
            This.Report(syntax, "Type Mismatch", "Join values must be string[]",
                expression.Line, expression.Column);
        If (target == "IO.File.WriteLines" && second != null &&
            second.Type.Kind != [int](TypeKind.ListType) &&
            (second.Type.Kind != [int](TypeKind.ArrayType) ||
             second.Type.ElementType.Kind != [int](TypeKind.StringType)))
            This.Report(syntax, "Type Mismatch", "WriteLines values must be string[]",
                expression.Line, expression.Column);
        If (target == "IO.Async.Run" && first != null &&
            first.Type.Name != "IO.Async.Task")
            This.Report(syntax, "Async Run", "IO.Async.Run expects IO.Async.Task",
                expression.Line, expression.Column);
    }

    Public Safe Function HirExpression BindCall(SyntaxTree syntax, FunctionSymbol function,
                                                 BindingScope scope, ExpressionNode expression)
    {
        int argumentCount = This.ArgumentCount(expression);
        ExpressionNode targetSyntax = expression.Left;
        string sourcePath = This.ExpressionPath(targetSyntax);
        If (This.PathUsesHiddenAliasTarget(syntax, sourcePath))
        {
            This.Report(syntax, "Scoped Symbol Required", sourcePath,
                expression.Line, expression.Column);
            Return This.FailedExpression(expression);
        }
        int sourceDot = IO.Text.IndexOf(sourcePath, ".");
        string sourceRoot = sourceDot < 0 ? sourcePath :
            IO.Text.Slice(sourcePath, 0, sourceDot);
        bool namespacePath = sourceDot > 0 && This.IsNamespacePrefix(sourceRoot) &&
            !IO.Text.StartsWith(sourcePath, "IO.Type.");
        If (namespacePath && !This.QualifiedPathIsVisible(syntax, sourcePath))
        {
            This.Report(syntax, "Missing Get", sourcePath,
                expression.Line, expression.Column);
            Return This.FailedExpression(expression);
        }
        string path = This.ExpandImportPath(syntax, sourcePath);
        FunctionSymbol targetFunction = IO.Text.IsEmpty(path) ? null :
            This.FindQualifiedFunction(path, argumentCount);
        TypeSymbol returnType = null;
        int callKind = [int](HirCallKind.None);
        HirExpression receiver = null;
        string targetName = path;

        If (targetFunction != null)
        {
            targetFunction = This.SelectOverload(syntax, function, scope, expression, targetFunction);
            targetFunction = This.ResolveGenericCallTarget(syntax, function, targetFunction, expression);
            If (targetFunction == null) Return This.FailedExpression(expression);
            returnType = targetFunction.ReturnType;
            callKind = targetFunction.Declaration.IsDelegate ?
                [int](HirCallKind.Delegate) : [int](HirCallKind.UnitFunction);
            targetName = targetFunction.QualifiedName();
        }
        Else
        {
            returnType = This.RuntimeCallType(path, null);
            If (returnType != null)
            {
                If (expression.TypeArgumentCount() != 0)
                {
                    This.Report(syntax, "Invalid generic call", path,
                        expression.Line, expression.Column);
                    Return This.FailedExpression(expression);
                }
                callKind = [int](HirCallKind.RuntimeBuiltin);
            }
        }

        If (returnType == null && targetSyntax != null &&
            targetSyntax.Kind == [int](ExpressionKind.Member))
        {
            receiver = This.BindExpression(syntax, function, scope, targetSyntax.Left);
            If (receiver.Kind == [int](HirExpressionKind.Invalid))
            {
                If (targetSyntax.Left.Kind == [int](ExpressionKind.Member) &&
                    receiver.Syntax != targetSyntax.Left)
                    This.Report(syntax, "Invalid Member",
                        "Member call requires class instance",
                        expression.Line, expression.Column);
                Return receiver;
            }
            string memberName = targetSyntax.Text;
            If (receiver.Kind != [int](HirExpressionKind.Invalid))
            {
                If (receiver.Symbol != null && receiver.Symbol.CallableFunction != null &&
                    memberName == "Run" && !receiver.Symbol.CallableFunction.IsBlockLiteral)
                {
                    targetFunction = receiver.Symbol.CallableFunction;
                    returnType = This.Primitive("any");
                    callKind = [int](HirCallKind.DynamicFunction);
                    targetName = receiver.Target;
                }
                If (returnType == null)
                {
                    targetFunction = This.FindMethod(receiver.Type, memberName, argumentCount);
                    If (targetFunction != null)
                    {
                        targetFunction = This.SelectOverload(syntax, function, scope,
                            expression, targetFunction);
                        targetFunction = This.ResolveGenericCallTarget(syntax, function, targetFunction, expression);
                        If (targetFunction == null) Return This.FailedExpression(expression);
                        returnType = targetFunction.ReturnType;
                        callKind = [int](HirCallKind.InstanceMethod);
                        targetName = targetFunction.QualifiedName();
                    }
                    Else
                    {
                        returnType = This.RuntimeCallType(memberName, receiver.Type);
                        If (returnType != null)
                        {
                            If (expression.TypeArgumentCount() != 0)
                            {
                                This.Report(syntax, "Invalid generic call", memberName,
                                    expression.Line, expression.Column);
                                Return This.FailedExpression(expression);
                            }
                            callKind = [int](HirCallKind.RuntimeBuiltin);
                            If (receiver.Type.Kind == [int](TypeKind.NamedType) &&
                                receiver.Type.Name == "block")
                                targetName = receiver.Target + "." + memberName;
                            ElseIf (receiver.Type.Kind == [int](TypeKind.NamedType) &&
                                (receiver.Type.Name == "IO.Type.Object.Block" ||
                                 receiver.Type.Name == "Object.Block"))
                                targetName = "Block." + memberName;
                            Else targetName = memberName;
                            If (receiver.Type.Kind == [int](TypeKind.NamedType) &&
                                receiver.Type.Name == "block") receiver = null;
                        }
                    }
                }
            }
        }

        If (returnType == null && targetSyntax != null &&
            targetSyntax.Kind == [int](ExpressionKind.Name))
        {
            targetFunction = This.FindVisibleFunction(syntax, function.OwnerType,
                targetSyntax.Text, argumentCount);
            If (targetFunction != null)
            {
                targetFunction = This.SelectOverload(syntax, function, scope,
                    expression, targetFunction);
                If (targetFunction == null)
                {
                    This.Report(syntax, "Unknown Function", targetSyntax.Text,
                        expression.Line, expression.Column);
                    Return This.FailedExpression(expression);
                }
                targetFunction = This.ResolveGenericCallTarget(syntax, function, targetFunction, expression);
                If (targetFunction == null) Return This.FailedExpression(expression);
                returnType = targetFunction.ReturnType;
                callKind = targetFunction.Declaration.IsDelegate ?
                    [int](HirCallKind.Delegate) : targetFunction.OwnerType == null ?
                    [int](HirCallKind.UnitFunction) : [int](HirCallKind.InstanceMethod);
                targetName = targetFunction.QualifiedName();
            }
            Else
            {
                ValueSymbol dynamic = scope.Find(targetSyntax.Text);
                If (dynamic == null)
                {
                    GlobalSymbol dynamicGlobal = This.FindVisibleGlobal(syntax, targetSyntax.Text);
                    If (dynamicGlobal != null) dynamic = dynamicGlobal.Value;
                }
                If (dynamic != null &&
                    (dynamic.CallableFunction != null ||
                     dynamic.Type.Name == "IO.Type.Object.Function" ||
                     dynamic.Type.Name == "Object.Function"))
                {
                    receiver = This.BindExpression(syntax, function, scope, targetSyntax);
                    returnType = dynamic.CallableFunction == null ?
                        This.Primitive("any") : dynamic.CallableFunction.ReturnType;
                    callKind = [int](HirCallKind.DynamicFunction);
                    targetName = targetSyntax.Text;
                    targetFunction = dynamic.CallableFunction;
                }
                ElseIf (This.HasUnscopedImportedFunction(syntax,
                    targetSyntax.Text, argumentCount))
                {
                    This.Report(syntax, "Scoped Symbol Required", targetSyntax.Text,
                        expression.Line, expression.Column);
                    Return This.FailedExpression(expression);
                }
            }
        }

        If (returnType == null && targetSyntax != null &&
            targetSyntax.Kind == [int](ExpressionKind.Index))
        {
            receiver = This.BindExpression(syntax, function, scope, targetSyntax);
            If (receiver.Function != null ||
                receiver.Type.Name == "IO.Type.Object.Function" ||
                receiver.Type.Name == "Object.Function" ||
                receiver.Type.Name == "IO.Type.Object.Block" ||
                receiver.Type.Name == "Object.Block")
            {
                targetFunction = receiver.Function;
                returnType = targetFunction == null ? This.Primitive("any") :
                    targetFunction.ReturnType;
                callKind = [int](HirCallKind.DynamicFunction);
                targetName = "indexed callable";
            }
        }

        If (returnType == null)
        {
            If (namespacePath)
            {
                This.Report(syntax, "Unknown Symbol", "Symbol not found in module",
                    expression.Line, expression.Column);
                This.Report(syntax, "Unknown Variable", "Variable not defined",
                    expression.Line, expression.Column);
                This.Report(syntax, "Invalid Member",
                    "Member call requires class instance",
                    expression.Line, expression.Column);
                Return This.FailedExpression(expression);
            }
            Return This.InvalidExpression(syntax, expression,
                "Unresolved call",
                IO.Text.IsEmpty(path) ? targetSyntax.Text : path);
        }

        HirExpression bound = New HirExpression([int](HirExpressionKind.Call), expression, returnType);
        bound.CallKind = callKind;
        bound.Target = targetName;
        bound.Function = targetFunction;
        bound.Left = receiver;
        This.CheckCallSafety(syntax, function, targetFunction, expression);
        If (targetFunction != null)
            This.BindFunctionArguments(syntax, function, scope, expression, targetFunction, bound);
        Else
        {
            ExpressionNode argument = expression.FirstArgument;
            While (argument != null)
            {
                bound.AddArgument(This.BindExpression(syntax, function, scope, argument));
                argument = argument.Next;
            }
        }
        If (callKind == [int](HirCallKind.RuntimeBuiltin))
            This.ValidateRuntimeArguments(syntax, expression, bound);
        If (targetFunction != null && targetFunction.Declaration.IsAsync)
        {
            bound.AsyncResultType = targetFunction.ReturnType;
            bound.Type = This.FindExactType("IO.Async.Task");
        }
        ElseIf (callKind == [int](HirCallKind.RuntimeBuiltin) &&
            (bound.Target == "IO.Async.Sleep" || bound.Target == "IO.Async.Yield"))
        {
            bound.AsyncResultType = This.Primitive("void");
        }
        ElseIf (callKind == [int](HirCallKind.RuntimeBuiltin) &&
            bound.Target == "IO.Async.Run")
        {
            HirExpression task = This.HirArgument(bound, 0);
            If (task != null && task.Type.Name == "IO.Async.Task")
            {
                If (task.AsyncResultType == null)
                    This.Report(syntax, "Async Run", "Task result type is not known here",
                        expression.Line, expression.Column);
                Else bound.Type = task.AsyncResultType;
            }
        }
        Return bound;
    }

    Public Safe Function HirExpression BindMember(SyntaxTree syntax, FunctionSymbol function,
                                                   BindingScope scope, ExpressionNode expression)
    {
        string fullPath = This.ExpressionPath(expression);
        string targetText = This.TargetStringConstant(fullPath);
        If (targetText != null)
        {
            HirExpression constant = New HirExpression([int](HirExpressionKind.Constant),
                expression, This.Primitive("string"));
            constant.Target = "__target_string";
            constant.Name = targetText;
            Return constant;
        }
        int targetValue = This.TargetIntegerConstant(fullPath);
        If (targetValue >= 0)
        {
            HirExpression constant = New HirExpression([int](HirExpressionKind.Constant),
                expression, This.Primitive("int"));
            constant.Target = fullPath;
            constant.Name = [string](targetValue);
            Return constant;
        }
        HirExpression receiver = This.BindExpression(syntax, function, scope, expression.Left);
        If (receiver.Kind == [int](HirExpressionKind.Invalid))
        {
            If (expression.Left.Kind == [int](ExpressionKind.Member))
            {
                This.Report(syntax, "Invalid Member",
                    "Member access requires class instance",
                    expression.Line, expression.Column);
                Return This.FailedExpression(expression);
            }
            Return receiver;
        }
        string blockRecords = receiver.Symbol == null ? "" : receiver.Symbol.BlockRecords;
        If (blockRecords == "" && receiver.Function != null)
            blockRecords = receiver.Function.BlockRecords;
        int blockOrdinal = This.NamedOrdinal(blockRecords, expression.Text);
        If (blockOrdinal > 0)
        {
            ExpressionNode ordinalSyntax = New ExpressionNode([int](ExpressionKind.Number),
                [string](blockOrdinal), expression.Line, expression.Column);
            HirExpression ordinal = New HirExpression([int](HirExpressionKind.Constant),
                ordinalSyntax, This.Primitive("isize"));
            ordinal.Target = receiver.Target + "." + expression.Text;
            Return ordinal;
        }
        If (receiver.Type.Kind == [int](TypeKind.PackageType) && receiver.Symbol != null &&
            receiver.Symbol.PackageLabels != "")
        {
            list labels = IO.Text.Split(receiver.Symbol.PackageLabels, ",");
            int labelIndex = 0;
            While (labelIndex < labels.Count())
            {
                If ([string](labels.Fetch(labelIndex)) == expression.Text)
                {
                    TypeSymbol elementType = receiver.Type.PackageElement(labelIndex);
                    If (elementType == null) elementType = This.Primitive("any");
                    ExpressionNode indexSyntax = New ExpressionNode([int](ExpressionKind.Number),
                        [string](labelIndex), expression.Line, expression.Column);
                    HirExpression result = New HirExpression([int](HirExpressionKind.Index),
                        expression, elementType);
                    result.Left = receiver;
                    result.Right = New HirExpression([int](HirExpressionKind.Constant),
                        indexSyntax, This.Primitive("int"));
                    Return result;
                }
                labelIndex = labelIndex + 1;
            }
        }
        // Type names use Namespace HIR expressions even when their semantic
        // type is NamedType. Use the expression role so nested types resolve.
        If (receiver.Kind == [int](HirExpressionKind.Namespace))
        {
            FunctionSymbol staticGetter = This.FindPropertyGetter(
                receiver.Type, expression.Text);
            If (staticGetter != null && staticGetter.Declaration.IsStatic)
                Return This.BindPropertyAccess(syntax, function, expression,
                    null, staticGetter);
            string combined = receiver.Target + "." + expression.Text;
            TypeSymbol named = This.ResolveType(syntax, combined);
            If (named == null) named = This.FindExactType(combined);
            If (named != null)
            {
                HirExpression result = New HirExpression([int](HirExpressionKind.Namespace), expression, named);
                result.Target = combined;
                Return result;
            }
            TypeSymbol enumType = This.FindEnumMemberType(combined);
            If (enumType != null)
            {
                HirExpression result = New HirExpression(
                    [int](HirExpressionKind.Constant), expression, enumType);
                result.Target = combined;
                Return result;
            }
            GlobalSymbol global = This.FindQualifiedGlobal(combined);
            If (global != null)
            {
                HirExpression result = New HirExpression(
                    [int](HirExpressionKind.Global), expression, global.Value.Type);
                result.Target = global.QualifiedName();
                result.Symbol = global.Value;
                Return result;
            }
            TypeSymbol namespaceType = New TypeSymbol([int](TypeKind.NamespaceType), combined);
            HirExpression result = New HirExpression([int](HirExpressionKind.Namespace), expression, namespaceType);
            result.Target = combined;
            Return result;
        }

        FunctionSymbol getter = This.FindPropertyGetter(receiver.Type, expression.Text);
        If (getter != null && !getter.Declaration.IsStatic)
            Return This.BindPropertyAccess(syntax, function, expression,
                receiver, getter);
        TypeSymbol fieldType = This.FindFieldType(syntax, receiver.Type, expression.Text);
        If (fieldType != null)
        {
            HirExpression result = New HirExpression([int](HirExpressionKind.Field), expression, fieldType);
            result.Left = receiver;
            result.Target = expression.Text;
            Return result;
        }
        If (receiver.Type.Name == "IO.Error")
        {
            TypeSymbol errorMemberType = expression.Text == "Inner" ?
                This.FindExactType("IO.Error") : This.Primitive("string");
            If (expression.Text == "Title" || expression.Text == "Message" ||
                expression.Text == "Trace" || expression.Text == "Inner")
            {
                HirExpression result = New HirExpression([int](HirExpressionKind.Field),
                    expression, errorMemberType);
                result.Left = receiver;
                result.Target = expression.Text;
                Return result;
            }
        }
        If (receiver.Type.Name == "IO.Time.DateTime" && expression.Text == "Ticks")
        {
            HirExpression result = New HirExpression([int](HirExpressionKind.Field),
                expression, This.Primitive("int"));
            result.Left = receiver;
            result.Target = expression.Text;
            Return result;
        }
        If (receiver.Type.Kind == [int](TypeKind.NamedType) && receiver.Type.Declaration != null &&
            receiver.Type.Declaration.FirstField == null && receiver.Type.Declaration.FirstMethod == null)
        {
            HirExpression result = New HirExpression([int](HirExpressionKind.Constant), expression, receiver.Type);
            result.Target = receiver.Type.QualifiedName() + "." + expression.Text;
            Return result;
        }
        If (receiver.Type.Kind == [int](TypeKind.NamedType) && receiver.Type.Name == "block")
        {
            HirExpression result = New HirExpression([int](HirExpressionKind.Constant),
                expression, This.Primitive("isize"));
            result.Target = receiver.Target + "." + expression.Text;
            Return result;
        }
        Return This.InvalidExpression(syntax, expression, "Unknown member", expression.Text);
    }

    Public Safe Function HirExpression BindStringExpression(SyntaxTree syntax,
                                                              FunctionSymbol function,
                                                              BindingScope scope,
                                                              ExpressionNode expression)
    {
        HirExpression text = null;
        If (expression.Kind == [int](ExpressionKind.FormattedString) &&
            expression.FirstArgument != null)
        {
            ExpressionNode part = expression.FirstArgument;
            While (part != null)
            {
                HirExpression boundPart = This.BindExpression(syntax, function, scope, part);
                If (text == null) text = boundPart;
                Else
                {
                    HirExpression combined = New HirExpression([int](HirExpressionKind.Binary),
                        expression, This.Primitive("string"));
                    combined.Operator = TokenKind.Plus;
                    combined.Left = text;
                    combined.Right = boundPart;
                    text = combined;
                }
                part = part.Next;
            }
        }
        Else text = New HirExpression([int](HirExpressionKind.Constant),
            expression, This.Primitive("string"));
        If (!expression.IsCharacterString) Return text;
        HirExpression characters = New HirExpression([int](HirExpressionKind.Call),
            expression, This.MakeArrayType(This.Primitive("char")));
        characters.CallKind = [int](HirCallKind.RuntimeBuiltin);
        characters.Target = "ToChars";
        characters.Left = text;
        Return characters;
    }

    Public Safe Function int TargetIntegerConstant(string path)
    {
        If (path == "IO.Target" || path == "IO.Target.OS" ||
            path == "IO.Target.OS.Current") Return IO.Host.OS.Current;
        If (path == "IO.Target.Windows" || path == "IO.Target.OS.Windows") Return 1;
        If (path == "IO.Target.Linux" || path == "IO.Target.OS.Linux") Return 2;
        If (path == "IO.Target.MacOS" || path == "IO.Target.OS.MacOS") Return 3;
        If (path == "IO.Target.Unknown" || path == "IO.Target.OS.Unknown") Return 0;
        If (path == "IO.Target.Arch" || path == "IO.Target.Arch.Current") Return IO.Host.Arch.Current;
        If (path == "IO.Target.X64" || path == "IO.Target.Arch.X64") Return 2;
        If (path == "IO.Target.X86" || path == "IO.Target.Arch.X86") Return 1;
        If (path == "IO.Target.Arm64" || path == "IO.Target.Arch.Arm64") Return 3;
        If (path == "IO.Target.Arch.Unknown") Return 0;
        If (path == "IO.Target.Env" || path == "IO.Target.Env.Current" ||
            path == "IO.Target.Hosted" || path == "IO.Target.Env.Hosted") Return 1;
        If (path == "IO.Target.Freestanding" || path == "IO.Target.Env.Freestanding") Return 2;
        If (path == "IO.Target.Env.Unknown") Return 0;
        If (path == "IO.Target.PointerBits") Return 64;
        If (path == "IO.Host" || path == "IO.Host.OS" ||
            path == "IO.Host.OS.Current") Return IO.Host.OS.Current;
        If (path == "IO.Host.Windows" || path == "IO.Host.OS.Windows") Return 1;
        If (path == "IO.Host.Linux" || path == "IO.Host.OS.Linux") Return 2;
        If (path == "IO.Host.MacOS" || path == "IO.Host.OS.MacOS") Return 3;
        If (path == "IO.Host.Unknown" || path == "IO.Host.OS.Unknown") Return 0;
        If (path == "IO.Host.Arch" || path == "IO.Host.Arch.Current") Return IO.Host.Arch.Current;
        If (path == "IO.Host.X64" || path == "IO.Host.Arch.X64") Return 2;
        If (path == "IO.Host.X86" || path == "IO.Host.Arch.X86") Return 1;
        If (path == "IO.Host.Arm64" || path == "IO.Host.Arch.Arm64") Return 3;
        If (path == "IO.Host.Arch.Unknown") Return 0;
        If (path == "IO.Host.Env" || path == "IO.Host.Env.Current" ||
            path == "IO.Host.Hosted" || path == "IO.Host.Env.Hosted") Return 1;
        If (path == "IO.Host.Freestanding" || path == "IO.Host.Env.Freestanding") Return 2;
        If (path == "IO.Host.Env.Unknown") Return 0;
        If (path == "IO.Host.PointerBits") Return 64;
        Return -1;
    }

    Public Safe Function string TargetStringConstant(string path)
    {
        If (path == "IO.Target.PathSeparator" || path == "IO.Host.PathSeparator")
            Return IO.Host.PathSeparator;
        If (path == "IO.Target.ExeSuffix" || path == "IO.Host.ExeSuffix")
            Return IO.Host.ExeSuffix;
        If (path == "IO.Target.ObjectSuffix" || path == "IO.Host.ObjectSuffix")
            Return IO.Host.ObjectSuffix;
        If (path == "IO.Target.DynamicLibrarySuffix" ||
            path == "IO.Host.DynamicLibrarySuffix") Return IO.Host.DynamicLibrarySuffix;
        If (path == "IO.Target.StaticLibrarySuffix" ||
            path == "IO.Host.StaticLibrarySuffix") Return IO.Host.StaticLibrarySuffix;
        If (path == "IO.Target.NewLine" || path == "IO.Host.NewLine") Return IO.Host.NewLine;
        Return null;
    }

    Public Safe Function int EvaluateTargetCondition(ExpressionNode expression)
    {
        If (expression == null || expression.Kind != [int](ExpressionKind.Binary) ||
            (expression.Operator != TokenKind.Equal &&
             expression.Operator != TokenKind.NotEqual)) Return -1;
        int left = This.TargetIntegerConstant(This.ExpressionPath(expression.Left));
        int right = This.TargetIntegerConstant(This.ExpressionPath(expression.Right));
        If (left < 0 || right < 0) Return -1;
        bool equal = left == right;
        If (expression.Operator == TokenKind.NotEqual) equal = !equal;
        Return equal ? 1 : 0;
    }

    Public Safe Function i64 CharacterConstant(string raw)
    {
        int length = IO.Text.Length(raw);
        string body = length >= 2 && IO.Text.StartsWith(raw, "'") &&
            IO.Text.EndsWith(raw, "'") ? IO.Text.Slice(raw, 1, length - 2) : raw;
        char[] characters = body.ToChars();
        If (characters.Length() == 0) Return 0;
        If (characters[0] != '\\' || characters.Length() < 2) Return [int](characters[0]);
        char escaped = characters[1];
        If (escaped == '0') Return 0;
        If (escaped == 'b') Return 8;
        If (escaped == 'n') Return 10;
        If (escaped == 'r') Return 13;
        If (escaped == 't') Return 9;
        Return [int](escaped);
    }

    Public Safe Function bool NumberIsFloat(string text)
    {
        bool hexadecimal = IO.Text.StartsWith(text, "0x") ||
            IO.Text.StartsWith(text, "0X");
        If (IO.Text.Contains(text, ".")) Return true;
        If (hexadecimal || IO.Text.IsEmpty(text)) Return false;
        Return IO.Text.EndsWith(text, "f") || IO.Text.EndsWith(text, "F");
    }

    Public Safe Function i64 IntegerLiteralValue(string text)
    {
        If (!IO.Text.StartsWith(text, "0x") && !IO.Text.StartsWith(text, "0X"))
            Return [i64](text);
        char[] characters = text.ToChars();
        i64 value = 0;
        int index = 2;
        While (index < characters.Length())
        {
            int code = [int](characters[index]);
            int digit = code >= 48 && code <= 57 ? code - 48 :
                (code >= 65 && code <= 70 ? code - 55 : code - 87);
            value = value * 16 + digit;
            index = index + 1;
        }
        Return value;
    }

    Public Safe Function ConstantIntegerValue ConstantIntegerCore(
        SyntaxTree syntax, BindingScope scope, ExpressionNode expression, int depth)
    {
        If (expression == null || depth > 192) Return New ConstantIntegerValue(false, 0);
        If (expression.Kind == [int](ExpressionKind.Number))
        {
            If (This.NumberIsFloat(expression.Text))
                Return New ConstantIntegerValue(false, 0);
            Return New ConstantIntegerValue(true,
                This.IntegerLiteralValue(expression.Text));
        }
        If (expression.Kind == [int](ExpressionKind.Character))
            Return New ConstantIntegerValue(true, This.CharacterConstant(expression.Text));
        If (expression.Kind == [int](ExpressionKind.Boolean))
            Return New ConstantIntegerValue(true,
                expression.Text == "true" || expression.Text == "True" ? 1 : 0);
        If (expression.Kind == [int](ExpressionKind.Name))
        {
            ValueSymbol local = scope == null ? null : scope.Find(expression.Text);
            If (local != null)
            {
                If (!local.IsConst || local.ConstantOrigin == null)
                    Return New ConstantIntegerValue(false, 0);
                Return This.ConstantIntegerCore(
                    syntax, scope, local.ConstantOrigin, depth + 1);
            }
            GlobalSymbol global = This.FindVisibleGlobal(syntax, expression.Text);
            If (global == null || !global.Declaration.IsConst ||
                global.Declaration.Initializer == expression)
                Return New ConstantIntegerValue(false, 0);
            Return This.ConstantIntegerCore(
                syntax, scope, global.Declaration.Initializer, depth + 1);
        }
        If (expression.Kind == [int](ExpressionKind.Unary))
        {
            ConstantIntegerValue operand = This.ConstantIntegerCore(
                syntax, scope, expression.Left, depth + 1);
            If (!operand.IsValid) Return operand;
            If (expression.Operator == TokenKind.Minus)
                Return New ConstantIntegerValue(true, -operand.Value);
            If (expression.Operator == TokenKind.Not)
                Return New ConstantIntegerValue(true, operand.Value == 0 ? 1 : 0);
            Return New ConstantIntegerValue(false, 0);
        }
        If (expression.Kind == [int](ExpressionKind.Binary))
        {
            ConstantIntegerValue left = This.ConstantIntegerCore(
                syntax, scope, expression.Left, depth + 1);
            ConstantIntegerValue right = This.ConstantIntegerCore(
                syntax, scope, expression.Right, depth + 1);
            If (!left.IsValid || !right.IsValid)
                Return New ConstantIntegerValue(false, 0);
            If (expression.Operator == TokenKind.Plus)
                Return New ConstantIntegerValue(true, left.Value + right.Value);
            If (expression.Operator == TokenKind.Minus)
                Return New ConstantIntegerValue(true, left.Value - right.Value);
            If (expression.Operator == TokenKind.Star)
                Return New ConstantIntegerValue(true, left.Value * right.Value);
            If (expression.Operator == TokenKind.Slash)
                Return right.Value == 0 ? New ConstantIntegerValue(false, 0) :
                    New ConstantIntegerValue(true, left.Value / right.Value);
            If (expression.Operator == TokenKind.Percent)
                Return right.Value == 0 ? New ConstantIntegerValue(false, 0) :
                    New ConstantIntegerValue(true, left.Value % right.Value);
            If (expression.Operator == TokenKind.Equal)
                Return New ConstantIntegerValue(true, left.Value == right.Value ? 1 : 0);
            If (expression.Operator == TokenKind.NotEqual)
                Return New ConstantIntegerValue(true, left.Value != right.Value ? 1 : 0);
            If (expression.Operator == TokenKind.Less)
                Return New ConstantIntegerValue(true, left.Value < right.Value ? 1 : 0);
            If (expression.Operator == TokenKind.LessEqual)
                Return New ConstantIntegerValue(true, left.Value <= right.Value ? 1 : 0);
            If (expression.Operator == TokenKind.Greater)
                Return New ConstantIntegerValue(true, left.Value > right.Value ? 1 : 0);
            If (expression.Operator == TokenKind.GreaterEqual)
                Return New ConstantIntegerValue(true, left.Value >= right.Value ? 1 : 0);
            If (expression.Operator == TokenKind.AndAnd)
                Return New ConstantIntegerValue(true,
                    left.Value != 0 && right.Value != 0 ? 1 : 0);
            If (expression.Operator == TokenKind.OrOr)
                Return New ConstantIntegerValue(true,
                    left.Value != 0 || right.Value != 0 ? 1 : 0);
            If (expression.Operator == TokenKind.Ampersand)
                Return New ConstantIntegerValue(true, left.Value & right.Value);
            If (expression.Operator == TokenKind.BitOr)
                Return New ConstantIntegerValue(true, left.Value | right.Value);
            If (expression.Operator == TokenKind.Xor)
                Return New ConstantIntegerValue(true, left.Value ^ right.Value);
            If (expression.Operator == TokenKind.ShiftLeft)
                Return New ConstantIntegerValue(true, left.Value << right.Value);
            If (expression.Operator == TokenKind.ShiftRight)
                Return New ConstantIntegerValue(true, left.Value >> right.Value);
        }
        Return New ConstantIntegerValue(false, 0);
    }

    Public Safe Function ConstantIntegerValue ConstantInteger(
        SyntaxTree syntax, BindingScope scope, ExpressionNode expression)
    {
        Return This.ConstantIntegerCore(syntax, scope, expression, 0);
    }

    Public Safe Function bool PackageCanMaterialize(TypeSymbol packageType,
                                                      TypeSymbol elementType)
    {
        If (packageType == null || packageType.Kind != [int](TypeKind.PackageType) ||
            packageType.PackageCount <= 0) Return false;
        PackageElementType element = packageType.FirstPackageElement;
        While (element != null)
        {
            If (!This.IsAssignable(elementType, element.Type)) Return false;
            element = element.Next;
        }
        Return true;
    }

    Public Safe Function void ValidatePackageAliases(SyntaxTree syntax,
                                                       StatementNode statement,
                                                       TypeSymbol packageType)
    {
        If (statement.PackageLabels == "") Return;
        list labels = IO.Text.Split(statement.PackageLabels, ",");
        If (packageType == null || packageType.Kind != [int](TypeKind.PackageType))
        {
            This.Report(syntax, "Invalid Package Fields",
                "Package field names require a Package value", statement.Line, statement.Column);
            Return;
        }
        If (labels.Count() != packageType.PackageCount)
            This.Report(syntax, "Package Field Count", "Package field count mismatch",
                statement.Line, statement.Column);
        int index = 0;
        While (index < labels.Count())
        {
            int other = index + 1;
            While (other < labels.Count())
            {
                If ([string](labels.Fetch(index)) == [string](labels.Fetch(other)))
                    This.Report(syntax, "Duplicate Package Field",
                        "Package field names cannot repeat", statement.Line, statement.Column);
                other = other + 1;
            }
            index = index + 1;
        }
    }

    Public Safe Function HirExpression BindExpression(SyntaxTree syntax, FunctionSymbol function,
                                                       BindingScope scope, ExpressionNode expression)
    {
        If (expression == null) Return null;
        This.BoundExpressionCount = This.BoundExpressionCount + 1;
        If (expression.Kind == [int](ExpressionKind.Number))
            Return New HirExpression([int](HirExpressionKind.Constant), expression,
                This.Primitive(This.NumberIsFloat(expression.Text) ? "float" : "int"));
        If (expression.Kind == [int](ExpressionKind.String) ||
            expression.Kind == [int](ExpressionKind.FormattedString))
            Return This.BindStringExpression(syntax, function, scope, expression);
        If (expression.Kind == [int](ExpressionKind.Character))
            Return New HirExpression([int](HirExpressionKind.Constant), expression, This.Primitive("char"));
        If (expression.Kind == [int](ExpressionKind.Boolean))
            Return New HirExpression([int](HirExpressionKind.Constant), expression, This.Primitive("bool"));
        If (expression.Kind == [int](ExpressionKind.Null))
            Return New HirExpression([int](HirExpressionKind.Constant), expression,
                New TypeSymbol([int](TypeKind.NullType), "null"));
        If (expression.Kind == [int](ExpressionKind.Name))
        {
            If (expression.Text == "Base" && function != null &&
                function.OwnerType != null && function.OwnerType.BaseType != null)
            {
                HirExpression baseValue = New HirExpression(
                    [int](HirExpressionKind.Local), expression, function.OwnerType.BaseType);
                baseValue.Target = "This";
                baseValue.Name = "Base";
                baseValue.Symbol = function.Receiver;
                Return baseValue;
            }
            ValueSymbol value = scope.Find(expression.Text);
            If (value != null)
            {
                HirExpression local = New HirExpression([int](HirExpressionKind.Local), expression, value.Type);
                local.Target = value.Name;
                local.Symbol = value;
                local.AsyncResultType = value.AsyncResultType;
                Return local;
            }
            GlobalSymbol global = This.FindVisibleGlobal(syntax, expression.Text);
            If (global != null)
            {
                HirExpression globalValue = New HirExpression(
                    [int](HirExpressionKind.Global), expression, global.Value.Type);
                globalValue.Target = global.QualifiedName();
                globalValue.Symbol = global.Value;
                globalValue.AsyncResultType = global.Value.AsyncResultType;
                Return globalValue;
            }
            If (function != null)
            {
                global = This.FindStaticGlobal(function.OwnerType, expression.Text);
                If (global != null)
                {
                    HirExpression staticValue = New HirExpression(
                        [int](HirExpressionKind.Global), expression, global.Value.Type);
                    staticValue.Target = global.QualifiedName();
                    staticValue.Symbol = global.Value;
                    Return staticValue;
                }
                FunctionSymbol propertyGetter = This.FindPropertyGetter(
                    function.OwnerType, expression.Text);
                If (propertyGetter != null && !propertyGetter.Declaration.IsStatic &&
                    function.Receiver != null)
                {
                    HirExpression receiver = New HirExpression(
                        [int](HirExpressionKind.Local), expression, function.OwnerType);
                    receiver.Target = "This";
                    receiver.Symbol = function.Receiver;
                    Return This.BindPropertyAccess(syntax, function, expression,
                        receiver, propertyGetter);
                }
                TypeSymbol instanceField = This.FindInstanceFieldType(
                    syntax, function.OwnerType, expression.Text);
                If (instanceField != null && function.Receiver != null)
                {
                    HirExpression receiver = New HirExpression(
                        [int](HirExpressionKind.Local), expression, function.OwnerType);
                    receiver.Target = "This";
                    receiver.Symbol = function.Receiver;
                    HirExpression fieldValue = New HirExpression(
                        [int](HirExpressionKind.Field), expression, instanceField);
                    fieldValue.Left = receiver;
                    fieldValue.Target = expression.Text;
                    Return fieldValue;
                }
            }
            FunctionSymbol callable = This.FindVisibleCallable(syntax,
                function == null ? null : function.OwnerType, expression.Text);
            If (callable != null)
            {
                HirExpression callableValue = New HirExpression(
                    callable.Declaration.IsDelegate ? [int](HirExpressionKind.Delegate) :
                        [int](HirExpressionKind.FunctionReference),
                    expression, This.MakePointerType(This.Primitive("byte")));
                callableValue.Target = callable.QualifiedName();
                callableValue.Function = callable;
                Return callableValue;
            }
            If (expression.Text == "This" && function != null && function.OwnerType != null)
            {
                HirExpression thisValue = New HirExpression([int](HirExpressionKind.Local), expression, function.OwnerType);
                thisValue.Target = "This";
                thisValue.Symbol = function.Receiver;
                Return thisValue;
            }
            string importedPath = This.ExpandImportPath(syntax, expression.Text);
            If (importedPath != expression.Text)
            {
                TypeSymbol importedType = This.ResolveType(syntax, importedPath);
                If (importedType != null)
                {
                    HirExpression imported = New HirExpression(
                        [int](HirExpressionKind.Namespace), expression, importedType);
                    imported.Target = importedPath;
                    Return imported;
                }
                importedType = This.FindEnumMemberType(importedPath);
                If (importedType != null)
                {
                    HirExpression importedValue = New HirExpression(
                        [int](HirExpressionKind.Constant), expression, importedType);
                    importedValue.Target = importedPath;
                    Return importedValue;
                }
                TypeSymbol importedNamespace = New TypeSymbol(
                    [int](TypeKind.NamespaceType), importedPath);
                HirExpression imported = New HirExpression(
                    [int](HirExpressionKind.Namespace), expression, importedNamespace);
                imported.Target = importedPath;
                Return imported;
            }
            TypeSymbol type = This.ResolveType(syntax, expression.Text);
            If (type != null)
            {
                HirExpression named = New HirExpression([int](HirExpressionKind.Namespace), expression, type);
                named.Target = type.QualifiedName();
                Return named;
            }
            If (This.IsNamespacePrefix(expression.Text))
            {
                TypeSymbol namespaceType = New TypeSymbol([int](TypeKind.NamespaceType), expression.Text);
                HirExpression named = New HirExpression([int](HirExpressionKind.Namespace), expression, namespaceType);
                named.Target = expression.Text;
                Return named;
            }
            Return This.InvalidExpression(syntax, expression, "Unknown Variable", expression.Text);
        }
        If (expression.Kind == [int](ExpressionKind.Member))
            Return This.BindMember(syntax, function, scope, expression);
        If (expression.Kind == [int](ExpressionKind.Call))
            Return This.BindCall(syntax, function, scope, expression);
        If (expression.Kind == [int](ExpressionKind.NewObject))
        {
            TypeSymbol type = This.ResolveFunctionType(syntax, function, expression.Text);
            If (type == null) Return This.InvalidExpression(syntax, expression, "Unknown constructed type", expression.Text);
            If (!This.IsClassType(type))
                Return This.InvalidExpression(syntax, expression, "Unknown Type", "Class not found");
            If (type.Declaration != null && type.Declaration.IsStatic)
                This.Report(syntax, "Invalid New", "Cannot instantiate static class",
                    expression.Line, expression.Column);
            If (type.Declaration != null && type.Declaration.IsAbstract)
                This.Report(syntax, "Invalid New", "Cannot instantiate abstract class",
                    expression.Line, expression.Column);
            HirExpression result = New HirExpression([int](HirExpressionKind.NewObject), expression, type);
            result.CallKind = [int](HirCallKind.Constructor);
            result.Target = type.QualifiedName() + ".Constructor";
            FunctionSymbol constructor = This.FindMethod(type, "Constructor",
                This.ArgumentCount(expression));
            If (constructor == null && This.HasConstructor(type))
                This.Report(syntax, "Constructor not found", type.QualifiedName(),
                    expression.Line, expression.Column);
            result.Function = constructor;
            If (constructor != null)
                This.BindFunctionArguments(syntax, function, scope, expression, constructor, result);
            Else
            {
                ExpressionNode argument = expression.FirstArgument;
                While (argument != null)
                {
                    result.AddArgument(This.BindExpression(syntax, function, scope, argument));
                    argument = argument.Next;
                }
            }
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.Cast))
        {
            TypeSymbol type = This.ResolveFunctionType(syntax, function, expression.Text);
            If (type == null) Return This.InvalidExpression(syntax, expression, "Unknown cast type", expression.Text);
            HirExpression result = New HirExpression([int](HirExpressionKind.Cast), expression, type);
            result.Left = This.BindExpression(syntax, function, scope, expression.Left);
            int customCastCount = result.Left == null ? 0 :
                This.CustomCastCount(type, result.Left);
            If (customCastCount > 1)
                This.Report(syntax, "Ambiguous Cast", This.TypeIdentity(type),
                    expression.Line, expression.Column);
            ElseIf (customCastCount == 1)
                result.Function = This.FindCustomCast(type, result.Left);
            If (result.Left != null &&
                (result.Left.Type.Kind == [int](TypeKind.PointerType) ||
                 type.Kind == [int](TypeKind.PointerType)) &&
                !This.SameType(result.Left.Type, type))
            {
                If (This.FunctionIsSafe(function))
                    This.Report(syntax, "Unsafe Pointer",
                        "Safe function cannot cast pointer values",
                        expression.Line, expression.Column);
            }
            bool targetObject = This.IsObjectSchemaType(type);
            bool sourceObject = result.Left != null &&
                This.IsObjectSchemaType(result.Left.Type);
            bool relatedObjects = targetObject && sourceObject &&
                This.RelatedNamedTypes(result.Left.Type, type);
            bool dynamicObjectCast = targetObject && result.Left != null &&
                result.Left.Type.Kind == [int](TypeKind.AnyType);
            bool rawFunctionPointer = result.Left != null &&
                result.Left.Type.Kind == [int](TypeKind.PointerType) &&
                (type.Name == "IO.Type.Object.Function" ||
                 type.Name == "Object.Function");
            If (targetObject && sourceObject && !relatedObjects &&
                customCastCount == 0)
                This.Report(syntax, "Invalid Cast", "Object types are unrelated",
                    expression.Line, expression.Column);
            ElseIf (targetObject && customCastCount != 1 && !relatedObjects &&
                !rawFunctionPointer && !dynamicObjectCast &&
                (result.Left == null ||
                 result.Left.Type.Kind != [int](TypeKind.NullType)))
                This.Report(syntax, "Invalid Cast",
                    "Cannot cast to Object types; use Object conversions instead",
                    expression.Line, expression.Column);
            If (sourceObject && !targetObject)
                This.Report(syntax, "Invalid Cast",
                    "Cannot cast Object values; use Object conversions instead",
                    expression.Line, expression.Column);
            If (result.Left != null && result.Left.Type.Kind == [int](TypeKind.PackageType) &&
                (type.Kind != [int](TypeKind.ArrayType) ||
                 !This.PackageCanMaterialize(result.Left.Type, type.ElementType)))
                This.Report(syntax, "Invalid Cast",
                    "Package elements are not assignable to the target array element type",
                    expression.Line, expression.Column);
            ElseIf (result.Left != null && type.Kind == [int](TypeKind.PackageType) &&
                result.Left.Type.Kind != [int](TypeKind.PackageType))
                This.Report(syntax, "Invalid Cast", "Only Package values can convert to Package",
                    expression.Line, expression.Column);
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.FunctionLiteral) ||
            expression.Kind == [int](ExpressionKind.BlockLiteral))
        {
            FunctionSymbol literal = This.CreateLocalLiteralFunction(syntax, expression, scope);
            If (literal == null)
                Return This.InvalidExpression(syntax, expression, "Invalid local literal", "unit is missing");
            TypeSymbol callableType = This.FindExactType(expression.Kind ==
                [int](ExpressionKind.BlockLiteral) ?
                "IO.Type.Object.Block" : "IO.Type.Object.Function");
            HirExpression result = New HirExpression([int](HirExpressionKind.FunctionReference),
                expression, callableType);
            result.Target = literal.QualifiedName();
            result.Function = literal;
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.ArrayLiteral))
        {
            TypeSymbol elementType = This.Primitive("any");
            HirExpression result = New HirExpression([int](HirExpressionKind.ArrayLiteral),
                expression, This.MakeArrayType(elementType));
            ExpressionNode item = expression.FirstArgument;
            While (item != null)
            {
                HirExpression boundItem = This.BindExpression(syntax, function, scope, item);
                If (result.FirstArgument == null && boundItem != null) elementType = boundItem.Type;
                result.AddArgument(boundItem);
                item = item.Next;
            }
            result.Type = This.MakeArrayType(elementType);
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.PackageLiteral))
        {
            TypeSymbol packageType = New TypeSymbol([int](TypeKind.PackageType), "Object.Package");
            packageType.ElementType = This.Primitive("any");
            HirExpression result = New HirExpression([int](HirExpressionKind.PackageLiteral),
                expression, packageType);
            ExpressionNode item = expression.FirstArgument;
            While (item != null)
            {
                HirExpression boundItem = This.BindExpression(syntax, function, scope, item);
                result.AddArgument(boundItem);
                If (boundItem != null) packageType.AddPackageElement(boundItem.Type);
                item = item.Next;
            }
            If (packageType.PackageCount == 0)
                This.Report(syntax, "Invalid Package Literal", "Empty Package literal is not supported",
                    expression.Line, expression.Column);
            packageType.Name = This.TypeIdentity(packageType);
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.DictLiteral))
        {
            HirExpression result = New HirExpression([int](HirExpressionKind.DictLiteral),
                expression, This.Primitive("dict"));
            ExpressionNode item = expression.FirstArgument;
            While (item != null)
            {
                HirExpression entry = New HirExpression([int](HirExpressionKind.DictEntry),
                    item, This.Primitive("void"));
                entry.Left = This.BindExpression(syntax, function, scope, item.Left);
                entry.Right = This.BindExpression(syntax, function, scope, item.Right);
                result.AddArgument(entry);
                item = item.Next;
            }
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.Switch))
        {
            HirExpression result = New HirExpression([int](HirExpressionKind.Switch),
                expression, This.Primitive("any"));
            result.Left = This.BindExpression(syntax, function, scope, expression.Left);
            ExpressionNode item = expression.FirstArgument;
            While (item != null)
            {
                HirExpression boundCase = New HirExpression([int](HirExpressionKind.SwitchCase),
                    item, This.Primitive("any"));
                boundCase.Name = item.Text;
                boundCase.Left = This.BindExpression(syntax, function, scope, item.Left);
                boundCase.Right = This.BindExpression(syntax, function, scope, item.Right);
                If (boundCase.Right != null)
                {
                    boundCase.Type = boundCase.Right.Type;
                    If (result.FirstArgument == null) result.Type = boundCase.Right.Type;
                }
                result.AddArgument(boundCase);
                item = item.Next;
            }
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.Index))
        {
            HirExpression receiver = This.BindExpression(syntax, function, scope, expression.Left);
            HirExpression boundIndex = This.BindExpression(
                syntax, function, scope, expression.Right);
            TypeSymbol type = receiver.Type.Kind == [int](TypeKind.ArrayType) ||
                receiver.Type.Kind == [int](TypeKind.PointerType) ?
                receiver.Type.ElementType : This.Primitive("any");
            If (receiver.Type.Kind == [int](TypeKind.StringType)) type = This.Primitive("char");
            ConstantIntegerValue packageIndex = New ConstantIntegerValue(false, 0);
            If (receiver.Type.Kind == [int](TypeKind.PackageType))
            {
                If (boundIndex == null ||
                    boundIndex.Type.Kind != [int](TypeKind.IntegerType))
                    This.Report(syntax, "Type Mismatch", "Index requires integer type",
                        expression.Line, expression.Column);
                packageIndex = This.ConstantInteger(syntax, scope, expression.Right);
                If (!packageIndex.IsValid)
                {
                    This.Report(syntax, "Invalid Package Index",
                        "Package index must be a compile-time constant",
                        expression.Line, expression.Column);
                    type = New TypeSymbol([int](TypeKind.Unknown), "unknown");
                }
                ElseIf (packageIndex.Value < 0 ||
                    packageIndex.Value >= receiver.Type.PackageCount)
                {
                    This.Report(syntax, "Invalid Package Index", "Package index out of range",
                        expression.Line, expression.Column);
                    type = New TypeSymbol([int](TypeKind.Unknown), "unknown");
                }
                Else type = receiver.Type.PackageElement([int](packageIndex.Value));
            }
            HirExpression result = New HirExpression([int](HirExpressionKind.Index), expression, type);
            result.Left = receiver;
            If (packageIndex.IsValid)
            {
                ExpressionNode constantIndex = New ExpressionNode([int](ExpressionKind.Number),
                    [string](packageIndex.Value), expression.Line, expression.Column);
                result.Right = New HirExpression([int](HirExpressionKind.Constant),
                    constantIndex, This.Primitive("int"));
            }
            Else result.Right = boundIndex;
            If (receiver.Symbol != null && packageIndex.IsValid && packageIndex.Value >= 0)
                result.Function = receiver.Symbol.CallableElement([int](packageIndex.Value));
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.Unary))
        {
            If (expression.Operator == TokenKind.KwAwait &&
                (function == null || !function.Declaration.IsAsync))
            {
                This.Report(syntax, "Await Outside Async",
                    "Await is only allowed inside Async Function",
                    expression.Line, expression.Column);
                Return New HirExpression([int](HirExpressionKind.Unary), expression,
                    New TypeSymbol([int](TypeKind.Unknown), "unknown"));
            }
            If (expression.Operator == TokenKind.KwAwait && This.TryDepth > 0)
            {
                This.Report(syntax, "Await In Try",
                    "Await inside Try/Catch is not supported yet",
                    expression.Line, expression.Column);
                Return New HirExpression([int](HirExpressionKind.Unary), expression,
                    New TypeSymbol([int](TypeKind.Unknown), "unknown"));
            }
            HirExpression operand = This.BindExpression(syntax, function, scope, expression.Left);
            TypeSymbol type = expression.Operator == TokenKind.Not ? This.Primitive("bool") : operand.Type;
            If (expression.Operator == TokenKind.KwAwait)
            {
                If (operand.Type.Name != "IO.Async.Task")
                {
                    This.Report(syntax, "Await Requires Task",
                        "Await operand must be IO.Async.Task",
                        expression.Line, expression.Column);
                    type = New TypeSymbol([int](TypeKind.Unknown), "unknown");
                }
                ElseIf (operand.AsyncResultType == null)
                {
                    This.Report(syntax, "Unknown Task Result",
                        "Task result type is not known here",
                        expression.Line, expression.Column);
                    type = New TypeSymbol([int](TypeKind.Unknown), "unknown");
                }
                Else type = operand.AsyncResultType;
            }
            If (expression.Operator == TokenKind.Ampersand)
                type = operand.Kind == [int](HirExpressionKind.FunctionReference) ?
                    operand.Type : This.MakePointerType(operand.Type);
            ElseIf (expression.Operator == TokenKind.Star &&
                operand.Type.Kind == [int](TypeKind.PointerType)) type = operand.Type.ElementType;
            If (expression.Operator == TokenKind.Star)
                This.CheckPointerSafety(syntax, function, expression);
            HirExpression result = New HirExpression([int](HirExpressionKind.Unary), expression, type);
            result.Left = operand;
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.Binary))
        {
            HirExpression left = This.BindExpression(syntax, function, scope, expression.Left);
            HirExpression right = null;
            If (expression.Operator == TokenKind.KwIs)
            {
                string targetName = This.ExpressionPath(expression.Right);
                TypeSymbol targetType = This.ResolveFunctionType(
                    syntax, function, targetName);
                If (targetType == null)
                {
                    This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                    This.Report(syntax, "Unknown Type",
                        This.CanonicalTypeName(targetName),
                        expression.Right.Line, expression.Right.Column);
                    targetType = New TypeSymbol([int](TypeKind.Unknown), "unknown");
                }
                right = New HirExpression([int](HirExpressionKind.Namespace),
                    expression.Right, targetType);
                right.Target = targetType.QualifiedName();
            }
            Else right = This.BindExpression(syntax, function, scope, expression.Right);
            bool comparison = expression.Operator == TokenKind.Equal ||
                expression.Operator == TokenKind.NotEqual ||
                expression.Operator == TokenKind.Less || expression.Operator == TokenKind.LessEqual ||
                expression.Operator == TokenKind.Greater || expression.Operator == TokenKind.GreaterEqual ||
                expression.Operator == TokenKind.AndAnd || expression.Operator == TokenKind.OrOr ||
                expression.Operator == TokenKind.KwIs || expression.Operator == TokenKind.KwIn;
            bool assignment = expression.Operator == TokenKind.Assign ||
                expression.Operator == TokenKind.PlusAssign ||
                expression.Operator == TokenKind.MinusAssign ||
                expression.Operator == TokenKind.StarAssign ||
                expression.Operator == TokenKind.SlashAssign ||
                expression.Operator == TokenKind.PercentAssign;
            If (assignment)
            {
                If (left.Symbol != null && left.Symbol.IsConst)
                    This.Report(syntax, "Const Assignment", "Cannot assign to const variable",
                        expression.Left.Line, expression.Left.Column);
                If (left.Kind == [int](HirExpressionKind.Field) &&
                    left.Function != null && IO.Text.IsEmpty(left.Name))
                    This.Report(syntax, "Read-only Property",
                        "Property does not declare a Set accessor",
                        expression.Left.Line, expression.Left.Column);
                bool delegateTarget = left.Kind == [int](HirExpressionKind.Delegate);
                bool functionReference = right.Kind == [int](HirExpressionKind.FunctionReference);
                bool cDelegate = delegateTarget && left.Function != null &&
                    left.Function.Declaration.Abi == "C";
                bool delegateAssignment = delegateTarget &&
                    (functionReference ||
                     (cDelegate && (right.Type.Kind == [int](TypeKind.PointerType) ||
                                    right.Type.Kind == [int](TypeKind.NullType))) ||
                     (!cDelegate && (right.Type.Kind == [int](TypeKind.NullType) ||
                                     right.Type.Name == "IO.Type.Object.Function" ||
                                     right.Type.Name == "Object.Function")));
                If (delegateTarget && functionReference &&
                    !This.SameFunctionSignature(left.Function, right.Function))
                    This.Report(syntax, "Type Mismatch", "Delegate signature does not match target",
                        expression.Line, expression.Column);
                ElseIf (delegateTarget && !delegateAssignment)
                    This.Report(syntax, "Type Mismatch",
                        cDelegate ?
                            "By C Delegate assignment requires a top-level function, raw pointer, or null" :
                            "Delegate assignment requires Object.Function or null",
                        expression.Line, expression.Column);
                ElseIf (!delegateTarget && !This.IsHirAssignable(left.Type, right))
                    This.Report(syntax, "Type Mismatch", "Assignment types do not match",
                        expression.Line, expression.Column);
            }
            If ((expression.Operator == TokenKind.Equal ||
                 expression.Operator == TokenKind.NotEqual) &&
                ((left.Type.Kind == [int](TypeKind.NamedType) &&
                  left.Type.Declaration != null &&
                  left.Type.Declaration.Kind == TokenKind.KwEnum) ||
                 (right.Type.Kind == [int](TypeKind.NamedType) &&
                  right.Type.Declaration != null &&
                  right.Type.Declaration.Kind == TokenKind.KwEnum)) &&
                !This.SameType(left.Type, right.Type))
                This.Report(syntax, "Type Mismatch", "Enum types do not match",
                    expression.Line, expression.Column);
            If ((expression.Operator == TokenKind.Equal ||
                 expression.Operator == TokenKind.NotEqual) &&
                (left.Type.Kind == [int](TypeKind.ArrayType) ||
                 left.Type.Kind == [int](TypeKind.PackageType) ||
                 left.Type.Kind == [int](TypeKind.AnyType) ||
                 (left.Type.Kind == [int](TypeKind.NamedType) &&
                  left.Type.Declaration != null &&
                  left.Type.Declaration.Kind == TokenKind.KwStruct)))
                This.Report(syntax, "Type Mismatch",
                    "Equality is not defined for aggregate or any values",
                    expression.Line, expression.Column);
            If (expression.Operator == TokenKind.Plus &&
                left.Type.Kind == [int](TypeKind.PointerType) &&
                right.Type.Kind == [int](TypeKind.PointerType))
            {
                This.Report(syntax, "Type Mismatch",
                    "Arithmetic operators require numeric types",
                    expression.Line, expression.Column);
            }
            TypeSymbol type = comparison ? This.Primitive("bool") : left.Type;
            If (!assignment && expression.Operator == TokenKind.Plus &&
                (left.Type.Kind == [int](TypeKind.StringType) || right.Type.Kind == [int](TypeKind.StringType)))
                type = This.Primitive("string");
            HirExpression result = New HirExpression([int](HirExpressionKind.Binary), expression, type);
            result.Left = left;
            result.Right = right;
            If (expression.Operator == TokenKind.Plus &&
                left.Type.Kind == [int](TypeKind.PointerType) &&
                right.Type.Kind == [int](TypeKind.PointerType))
                result.HasPrimaryError = true;
            Return result;
        }
        If (expression.Kind == [int](ExpressionKind.Conditional))
        {
            HirExpression condition = This.BindExpression(syntax, function, scope, expression.Left);
            HirExpression whenTrue = This.BindExpression(syntax, function, scope, expression.Right);
            HirExpression whenFalse = This.BindExpression(syntax, function, scope, expression.Third);
            TypeSymbol resultType = whenTrue.Type.Kind == [int](TypeKind.NullType) ?
                whenFalse.Type : whenTrue.Type;
            If (whenFalse.Type.Kind == [int](TypeKind.NullType)) resultType = whenTrue.Type;
            HirExpression result = New HirExpression([int](HirExpressionKind.Conditional), expression, resultType);
            result.Left = condition;
            result.Right = whenTrue;
            result.Third = whenFalse;
            Return result;
        }
        Return This.InvalidExpression(syntax, expression, "Unsupported expression", expression.Text);
    }

    Public Safe Function HirStatement BindStatement(SyntaxTree syntax, FunctionSymbol function,
                                                     BindingScope scope, StatementNode statement)
    {
        If (statement == null) Return null;
        HirStatement result = New HirStatement(statement.Kind);
        result.Name = statement.Name;
        If (statement.Kind == [int](StatementKind.If))
        {
            int targetCondition = This.EvaluateTargetCondition(statement.Expression);
            If (targetCondition >= 0)
            {
                ExpressionNode conditionSyntax = New ExpressionNode(
                    [int](ExpressionKind.Boolean), targetCondition == 1 ? "true" : "false",
                    statement.Line, statement.Column);
                result.Expression = New HirExpression([int](HirExpressionKind.Constant),
                    conditionSyntax, This.Primitive("bool"));
                If (targetCondition == 1)
                    result.FirstChild = This.BindStatement(syntax, function,
                        New BindingScope(scope), statement.FirstChild);
                Else result.ElseBranch = This.BindStatement(syntax, function,
                    New BindingScope(scope), statement.ElseBranch);
                result.Next = This.BindStatement(syntax, function, scope, statement.Next);
                Return result;
            }
        }
        If (statement.Kind == [int](StatementKind.Return))
        {
            result.Expression = This.BindExpression(syntax, function, scope, statement.Expression);
            If (function.ReturnType.Kind == [int](TypeKind.VoidType) && result.Expression != null)
                This.Report(syntax, "Return Type", "Void function cannot return a value",
                    statement.Line, statement.Column);
            ElseIf (function.ReturnType.Kind != [int](TypeKind.VoidType) && result.Expression == null)
                This.Report(syntax, "Return Type", "Non-void function must return a value",
                    statement.Line, statement.Column);
            ElseIf (result.Expression != null &&
                !This.IsHirAssignable(function.ReturnType, result.Expression))
                This.Report(syntax, "Return Type", "Return value does not match function type",
                    statement.Expression.Line, statement.Expression.Column);
            result.Next = This.BindStatement(syntax, function, scope, statement.Next);
            Return result;
        }
        If (statement.Kind == [int](StatementKind.Throw))
        {
            result.Expression = This.BindExpression(syntax, function, scope, statement.Expression);
            If (result.Expression == null ||
                (result.Expression.Type.Kind != [int](TypeKind.StringType) &&
                 result.Expression.Type.Name != "IO.Error"))
                This.Report(syntax, "Invalid Throw", "Throw requires string or IO.Error",
                    statement.Line, statement.Column);
            result.Next = This.BindStatement(syntax, function, scope, statement.Next);
            Return result;
        }
        If (statement.Kind == [int](StatementKind.Try) && statement.TypeName == "")
        {
            This.TryDepth = This.TryDepth + 1;
            result.FirstChild = This.BindStatement(syntax, function,
                New BindingScope(scope), statement.FirstChild);
            result.ElseBranch = This.BindStatement(syntax, function,
                scope, statement.ElseBranch);
            This.TryDepth = This.TryDepth - 1;
            result.Next = This.BindStatement(syntax, function, scope, statement.Next);
            Return result;
        }
        If (statement.Kind == [int](StatementKind.UnsafeBlock))
        {
            If (!statement.IsUnsafe && This.HasNestedBlockRecord(statement.FirstChild, false))
                This.Report(syntax, "Unsafe Block",
                    "Record inside control flow requires Unsafe Block",
                    statement.Line, statement.Column);
            TypeSymbol blockType = New TypeSymbol([int](TypeKind.NamedType), "block");
            ValueSymbol blockValue = New ValueSymbol(statement.Name, blockType, false);
            blockValue.BlockRecords = This.BlockRecordNames(statement.FirstChild);
            scope.Add(blockValue);
            result.DeclaredSymbol = blockValue;
        }
        If (statement.Kind == [int](StatementKind.Try) && statement.TypeName != "")
        {
            TypeSymbol catchType = This.ResolveFunctionType(syntax, function, statement.TypeName);
            If (catchType == null)
            {
                This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                This.Report(syntax, "Unknown Type", This.CanonicalTypeName(statement.TypeName),
                    statement.Line, statement.Column);
                catchType = This.Primitive("any");
            }
            If (catchType.Kind != [int](TypeKind.StringType) && catchType.Name != "IO.Error")
                This.Report(syntax, "Invalid Catch", "Catch type must be string or IO.Error",
                    statement.Line, statement.Column);
            BindingScope catchScope = New BindingScope(scope);
            result.DeclaredType = catchType;
            result.DeclaredSymbol = New ValueSymbol(statement.Name, catchType, false);
            catchScope.Add(result.DeclaredSymbol);
            result.FirstChild = This.BindStatement(syntax, function, catchScope, statement.FirstChild);
            result.Next = This.BindStatement(syntax, function, scope, statement.Next);
            Return result;
        }
        If (statement.Kind == [int](StatementKind.For))
        {
            BindingScope loopScope = New BindingScope(scope);
            result.Initializer = This.BindStatement(syntax, function, loopScope, statement.Initializer);
            result.Expression = This.BindExpression(syntax, function, loopScope, statement.Expression);
            result.SecondExpression = This.BindExpression(
                syntax, function, loopScope, statement.SecondExpression);
            result.ThirdExpression = This.BindExpression(
                syntax, function, loopScope, statement.ThirdExpression);
            result.FirstChild = This.BindStatement(syntax, function, loopScope, statement.FirstChild);
            result.Next = This.BindStatement(syntax, function, scope, statement.Next);
            Return result;
        }
        If (statement.Kind == [int](StatementKind.Foreach))
        {
            BindingScope loopScope = New BindingScope(scope);
            result.Expression = This.BindExpression(syntax, function, scope, statement.Expression);
            result.DeclaredType = This.ResolveFunctionType(syntax, function, statement.TypeName);
            If (result.DeclaredType == null)
            {
                This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                This.Report(syntax, "Unknown Type", This.CanonicalTypeName(statement.TypeName),
                    statement.Line, statement.Column);
                result.DeclaredType = This.Primitive("any");
            }
            If (result.DeclaredType.Kind == [int](TypeKind.NamedType) &&
                result.DeclaredType.Declaration != null &&
                result.DeclaredType.Declaration.IsStatic)
                This.Report(syntax, "Invalid Type",
                    "Static class cannot be used as a value type",
                    statement.Line, statement.Column);
            result.DeclaredSymbol = New ValueSymbol(statement.Name, result.DeclaredType, false);
            loopScope.Add(result.DeclaredSymbol);
            result.FirstChild = This.BindStatement(syntax, function, loopScope, statement.FirstChild);
            result.Next = This.BindStatement(syntax, function, scope, statement.Next);
            Return result;
        }
        If (statement.Kind == [int](StatementKind.Variable))
        {
            If (statement.SecondExpression == null)
            {
                int fixedOpen = IO.Text.IndexOf(statement.TypeName, "[");
                int fixedClose = IO.Text.IndexOf(statement.TypeName, "]");
                If (fixedOpen > 0 && fixedClose > fixedOpen + 1)
                {
                    string lengthText = This.CanonicalTypeName(IO.Text.Slice(
                        statement.TypeName, fixedOpen + 1, fixedClose - fixedOpen - 1));
                    If (!IO.Text.IsEmpty(lengthText))
                    {
                        char[] lengthChars = lengthText.ToChars();
                        bool numberLength = true;
                        int lengthIndex = 0;
                        While (lengthIndex < lengthChars.Length())
                        {
                            int value = [int](lengthChars[lengthIndex]);
                            If (value < 48 || value > 57) numberLength = false;
                            lengthIndex = lengthIndex + 1;
                        }
                        statement.SecondExpression = New ExpressionNode(
                            numberLength ? [int](ExpressionKind.Number) : [int](ExpressionKind.Name),
                            lengthText, statement.Line, statement.Column);
                    }
                }
            }
            result.Expression = This.BindExpression(syntax, function, scope, statement.Expression);
            If (statement.IsConst && statement.Expression == null)
                This.Report(syntax, "Const Requires Init",
                    "Const variable must have initializer", statement.Line, statement.Column);
            If (statement.TypeName == "Var")
                result.DeclaredType = result.Expression == null ?
                    This.Primitive("any") : result.Expression.Type;
            Else result.DeclaredType = This.ResolveFunctionType(syntax, function, statement.TypeName);
            If (result.DeclaredType == null)
            {
                This.UnresolvedTypeCount = This.UnresolvedTypeCount + 1;
                This.Report(syntax, "Unknown Type", This.CanonicalTypeName(statement.TypeName),
                    statement.Line, statement.Column);
                result.DeclaredType = This.Primitive("any");
            }
            If (result.DeclaredType.Kind == [int](TypeKind.NamedType) &&
                result.DeclaredType.Declaration != null &&
                result.DeclaredType.Declaration.IsStatic)
                This.Report(syntax, "Invalid Type",
                    "Static class cannot be used as a value type",
                    statement.Line, statement.Column);
            If (statement.TypeName == "Var" &&
                result.DeclaredType.Kind == [int](TypeKind.Unknown))
            {
                This.Report(syntax, "Invalid Type", "Type not specified",
                    statement.Line, statement.Column);
                This.Report(syntax, "Unsupported Type", "Type not supported yet",
                    statement.Line, statement.Column);
            }
            If (result.DeclaredType.Kind == [int](TypeKind.PackageType))
            {
                TypeSymbol initializerType = result.Expression == null ? null : result.Expression.Type;
                If (result.DeclaredType.PackageCount > 0 && result.Expression != null &&
                    result.Expression.Kind == [int](HirExpressionKind.PackageLiteral))
                {
                    This.IsHirAssignable(result.DeclaredType, result.Expression);
                    initializerType = result.Expression.Type;
                }
                If (result.DeclaredType.PackageCount == 0)
                {
                    If (initializerType == null)
                        This.Report(syntax, "Type Inference Failed",
                            "Object.Package requires initializer", statement.Line, statement.Column);
                    ElseIf (initializerType.Kind != [int](TypeKind.PackageType) ||
                        initializerType.PackageCount == 0)
                        This.Report(syntax, "Type Inference Failed",
                            "Object.Package initializer must be a Package value",
                            statement.Line, statement.Column);
                    Else result.DeclaredType = initializerType;
                }
                ElseIf (initializerType != null &&
                    initializerType.Kind == [int](TypeKind.PackageType))
                {
                    If (result.DeclaredType.PackageCount != initializerType.PackageCount)
                        This.Report(syntax, "Package Element Count",
                            "Package initializer element count does not match target type",
                            statement.Line, statement.Column);
                    Else
                    {
                        int packageIndex = 0;
                        While (packageIndex < result.DeclaredType.PackageCount)
                        {
                            If (!This.IsAssignable(result.DeclaredType.PackageElement(packageIndex),
                                initializerType.PackageElement(packageIndex)))
                                This.Report(syntax, "Type Mismatch",
                                    "Package initializer element type does not match target type",
                                    statement.Line, statement.Column);
                            packageIndex = packageIndex + 1;
                        }
                    }
                }
            }
            If (result.DeclaredType.Kind == [int](TypeKind.DictType) &&
                statement.Expression != null &&
                statement.Expression.Kind == [int](ExpressionKind.ArrayLiteral) &&
                statement.Expression.FirstArgument == null)
                result.Expression = New HirExpression([int](HirExpressionKind.DictLiteral),
                    statement.Expression, result.DeclaredType);
            If (result.Expression != null)
            {
                bool contextualEmptyArray = result.DeclaredType.Kind == [int](TypeKind.ArrayType) &&
                    result.Expression.Kind == [int](HirExpressionKind.ArrayLiteral) &&
                    result.Expression.FirstArgument == null;
                If (!contextualEmptyArray && !result.Expression.HasPrimaryError &&
                    !This.IsHirAssignable(result.DeclaredType, result.Expression))
                    This.Report(syntax, "Type Mismatch", "Initializer type does not match variable type",
                        statement.Line, statement.Column);
                If (result.DeclaredType.Name == "byte" && statement.Expression != null)
                {
                    ConstantIntegerValue byteValue = This.ConstantInteger(
                        syntax, scope, statement.Expression);
                    If (byteValue.IsValid &&
                        (byteValue.Value < 0 || byteValue.Value > 255))
                        This.Report(syntax, "Byte Overflow", "byte literal is outside 0..255",
                            statement.Line, statement.Column);
                }
            }
            result.DeclaredSymbol = New ValueSymbol(statement.Name, result.DeclaredType, false);
            If (result.Expression != null)
                result.DeclaredSymbol.AsyncResultType = result.Expression.AsyncResultType;
            result.DeclaredSymbol.IsConst = statement.IsConst;
            result.DeclaredSymbol.ConstantOrigin = statement.Expression;
            result.DeclaredSymbol.PackageLabels = statement.PackageLabels;
            This.ValidatePackageAliases(syntax, statement, result.DeclaredType);
            If (result.Expression != null &&
                result.Expression.Kind == [int](HirExpressionKind.FunctionReference))
            {
                result.DeclaredSymbol.CallableFunction = result.Expression.Function;
                If (result.Expression.Function != null)
                    result.DeclaredSymbol.BlockRecords = result.Expression.Function.BlockRecords;
            }
            If (result.Expression != null &&
                result.Expression.Kind == [int](HirExpressionKind.ArrayLiteral))
            {
                HirExpression item = result.Expression.FirstArgument;
                int itemIndex = 0;
                While (item != null)
                {
                    If (item.Function != null)
                        result.DeclaredSymbol.AddCallableElement(itemIndex, item.Function);
                    itemIndex = itemIndex + 1;
                    item = item.Next;
                }
            }
            scope.Add(result.DeclaredSymbol);
        }
        Else
        {
            result.Expression = This.BindExpression(syntax, function, scope, statement.Expression);
        }
        result.SecondExpression = This.BindExpression(
            syntax, function, scope, statement.SecondExpression);
        result.ThirdExpression = This.BindExpression(
            syntax, function, scope, statement.ThirdExpression);
        result.Initializer = This.BindStatement(syntax, function, scope, statement.Initializer);
        If (statement.FirstChild != null)
        {
            BindingScope childScope = statement.Kind == [int](StatementKind.Record) ?
                scope : New BindingScope(scope);
            If (statement.Kind == [int](StatementKind.If) && statement.Expression != null &&
                statement.Expression.Kind == [int](ExpressionKind.Binary) &&
                statement.Expression.Operator == TokenKind.KwIs &&
                statement.Expression.Third != null)
            {
                string patternTypeName = This.ExpressionPath(statement.Expression.Right);
                TypeSymbol patternType = This.ResolveFunctionType(syntax, function, patternTypeName);
                If (patternType != null)
                {
                    ValueSymbol pattern = New ValueSymbol(
                        statement.Expression.Third.Text, patternType, false);
                    result.DeclaredType = patternType;
                    result.DeclaredSymbol = pattern;
                    childScope.Add(pattern);
                }
            }
            result.FirstChild = This.BindStatement(syntax, function, childScope, statement.FirstChild);
        }
        If (statement.ElseBranch != null)
        {
            BindingScope elseScope = New BindingScope(scope);
            result.ElseBranch = This.BindStatement(syntax, function, elseScope, statement.ElseBranch);
        }
        result.Next = This.BindStatement(syntax, function, scope, statement.Next);
        Return result;
    }

    Public Safe Function void AddHirModule(HirModule module)
    {
        If (This.FirstHirModule == null)
        {
            This.FirstHirModule = module;
            Return;
        }
        HirModule current = This.FirstHirModule;
        While (current.Next != null) current = current.Next;
        current.Next = module;
    }

    Public Safe Function HirModule FindHirModule(string unitName)
    {
        HirModule current = This.FirstHirModule;
        While (current != null)
        {
            If (current.UnitName == unitName) Return current;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function bool SwitchAlwaysReturns(StatementNode statement)
    {
        bool hasCase = false;
        bool hasDefault = false;
        StatementNode item = statement == null ? null : statement.FirstChild;
        While (item != null)
        {
            If (item.Kind == [int](StatementKind.Case))
            {
                hasCase = true;
                If (item.Name == "default") hasDefault = true;
                If (!This.StatementAlwaysReturns(item.FirstChild)) Return false;
            }
            item = item.Next;
        }
        Return hasCase && hasDefault;
    }

    Public Safe Function bool StatementAlwaysReturns(StatementNode statement)
    {
        StatementNode current = statement;
        While (current != null)
        {
            If (current.Kind == [int](StatementKind.Return) ||
                current.Kind == [int](StatementKind.Throw)) Return true;
            If ((current.Kind == [int](StatementKind.Block) ||
                 current.Kind == [int](StatementKind.UnsafeBlock)) &&
                This.StatementAlwaysReturns(current.FirstChild)) Return true;
            If (current.Kind == [int](StatementKind.If) && current.ElseBranch != null &&
                This.StatementAlwaysReturns(current.FirstChild) &&
                This.StatementAlwaysReturns(current.ElseBranch)) Return true;
            If (current.Kind == [int](StatementKind.Switch) &&
                This.SwitchAlwaysReturns(current)) Return true;
            If (current.Kind == [int](StatementKind.Try) && current.TypeName == "" &&
                current.ElseBranch != null &&
                This.StatementAlwaysReturns(current.FirstChild) &&
                This.StatementAlwaysReturns(current.ElseBranch.FirstChild)) Return true;
            current = current.Next;
        }
        Return false;
    }

    Public Safe Function void BindBodies()
    {
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            If (This.FindHirModule(unit.Name) == null)
                This.AddHirModule(New HirModule(unit.Name));
            unit = unit.Next;
        }

        FunctionSymbol function = This.FirstFunction;
        While (function != null)
        {
            If (!function.IsGenericTemplate() && !function.Declaration.IsDelegate)
            {
                HirModule module = This.FindHirModule(function.UnitName);
                SyntaxTree syntax = function.Syntax;
                If (syntax != null && module != null)
                {
                    BindingScope scope = New BindingScope(null);
                    CaptureSymbol capture = function.FirstCapture;
                    While (capture != null)
                    {
                        scope.Add(capture.Value);
                        capture = capture.Next;
                    }
                    If (function.OwnerType != null &&
                        (!function.Declaration.IsStatic || function.Declaration.IsConstructor))
                    {
                        function.Receiver = New ValueSymbol("This", function.OwnerType, true);
                        scope.Add(function.Receiver);
                    }
                    ParameterSymbol parameter = function.FirstParameter;
                    While (parameter != null)
                    {
                        parameter.Value = New ValueSymbol(parameter.Name, parameter.Type, true);
                        scope.Add(parameter.Value);
                        parameter = parameter.Next;
                    }
                    HirFunction hirFunction = New HirFunction(function);
                    If (function.Declaration.Body != null &&
                        function.ReturnType.Kind != [int](TypeKind.VoidType) &&
                        !IO.Text.StartsWith(function.Name, "__global_literal_") &&
                        !This.StatementAlwaysReturns(function.Declaration.Body))
                        This.Report(syntax, "Missing Return", function.QualifiedName(),
                            function.Declaration.Line, function.Declaration.Column);
                    hirFunction.Body = This.BindStatement(syntax, function, scope, function.Declaration.Body);
                    module.AddFunction(hirFunction);
                }
            }
            function = function.Next;
        }
    }

    Public Safe Function bool Analyze()
    {
        This.IndexDeclarations();
        This.ValidateAggregateTypes();
        This.LinkBaseTypes();
        This.ValidateMetaDeclarations();
        This.ValidateTypeAndFieldAttributes();
        This.IndexGlobals();
        This.IndexFunctions();
        This.ValidateClassRelationships();
        This.LinkGlobalLiteralFunctions();
        UnitSymbol unit = This.FirstUnit;
        While (unit != null)
        {
            This.CheckUnit(unit);
            unit = unit.Next;
        }
        If (!This.Session.HasErrors()) This.BindBodies();
        Return !This.Session.HasErrors();
    }

    Public Safe Function string FunctionSummary()
    {
        string result = "format=kinal-selfhost-functions-v1";
        FunctionSymbol function = This.FirstFunction;
        While (function != null)
        {
            result = result + "\nfunction=" + function.QualifiedName() +
                "|parameters=" + [string](function.ParameterCount()) +
                "|static=" + [string](function.Declaration.IsStatic ? 1 : 0) +
                "|constructor=" + [string](function.Declaration.IsConstructor ? 1 : 0) +
                "|generic_template=" + [string](function.IsGenericTemplate() ? 1 : 0) +
                "|generic_instance=" + [string](function.IsGenericInstance ? 1 : 0);
            function = function.Next;
        }
        Return result;
    }

    Public Safe Function int NamedTypeCount()
    {
        int count = 0;
        TypeSymbol current = This.FirstType;
        While (current != null)
        {
            If (current.UnitName != "") count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function string Summary()
    {
        Return "format=kinal-selfhost-sema-v1\n" +
               "units=" + [string](This.Session.UnitCount()) + "\n" +
               "imports=" + [string](This.ImportCount) + "\n" +
               "globals=" + [string](This.GlobalCount) + "\n" +
               "types=" + [string](This.NamedTypeCount()) + "\n" +
               "functions=" + [string](This.FunctionCount) + "\n" +
               "generic_templates=" + [string](This.GenericTemplateCount) + "\n" +
               "generic_instances=" + [string](This.GenericInstanceCount) + "\n" +
               "declaration_types=" + [string](This.DeclarationTypeCount) + "\n" +
               "unresolved_imports=" + [string](This.UnresolvedImportCount) + "\n" +
               "unresolved_types=" + [string](This.UnresolvedTypeCount) + "\n" +
               "bound_expressions=" + [string](This.BoundExpressionCount) + "\n" +
               "unresolved_expressions=" + [string](This.UnresolvedExpressionCount);
    }
}

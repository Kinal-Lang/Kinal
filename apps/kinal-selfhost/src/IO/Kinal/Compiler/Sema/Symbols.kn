Unit IO.Kinal.Compiler.Sema.Symbols;

Get IO.Kinal.Compiler.Syntax.SyntaxTree;
Get IO.Kinal.Compiler.Types.TypeSymbol;

Class ParameterSymbol
{
    Public string Name;
    Public TypeSymbol Type;
    Public ParameterDecl Declaration;
    Public ValueSymbol Value;
    Public ParameterSymbol Next;

    Public Safe Constructor(string name, TypeSymbol type)
    {
        This.Name = name;
        This.Type = type;
        This.Declaration = null;
        This.Value = null;
        This.Next = null;
    }
}

Class FunctionSymbol
{
    Public string UnitName;
    Public TypeSymbol OwnerType;
    Public string Name;
    Public TypeSymbol ReturnType;
    Public SyntaxTree Syntax;
    Public ParameterSymbol FirstParameter;
    Public FunctionDecl Declaration;
    Public ValueSymbol Receiver;
    Public bool IsGenericInstance;
    Public FunctionSymbol GenericDefinition;
    Public string GenericKey;
    Public TypeSubstitution FirstSubstitution;
    Public CaptureSymbol FirstCapture;
    Public bool IsBlockLiteral;
    Public string BlockRecords;
    Public FunctionSymbol Next;

    Public Safe Constructor(string unitName, TypeSymbol ownerType, FunctionDecl declaration)
    {
        This.UnitName = unitName;
        This.OwnerType = ownerType;
        This.Name = declaration.Name;
        This.ReturnType = null;
        This.Syntax = null;
        This.FirstParameter = null;
        This.Declaration = declaration;
        This.Receiver = null;
        This.IsGenericInstance = false;
        This.GenericDefinition = null;
        This.GenericKey = "";
        This.FirstSubstitution = null;
        This.FirstCapture = null;
        This.IsBlockLiteral = false;
        This.BlockRecords = "";
        This.Next = null;
    }

    Public Safe Function void AddParameter(ParameterSymbol parameter)
    {
        If (This.FirstParameter == null)
        {
            This.FirstParameter = parameter;
            Return;
        }
        ParameterSymbol current = This.FirstParameter;
        While (current.Next != null) current = current.Next;
        current.Next = parameter;
    }

    Public Safe Function int ParameterCount()
    {
        int count = 0;
        ParameterSymbol current = This.FirstParameter;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function int RequiredParameterCount()
    {
        int count = 0;
        ParameterSymbol current = This.FirstParameter;
        While (current != null)
        {
            If (current.Declaration == null || current.Declaration.DefaultValue == null)
                count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function bool AcceptsArgumentCount(int count)
    {
        Return count >= This.RequiredParameterCount() && count <= This.ParameterCount();
    }

    Public Safe Function string QualifiedName()
    {
        string functionName = This.Name;
        If (This.IsGenericInstance) functionName = functionName + "$" + This.GenericKey;
        If (This.OwnerType != null)
        {
            Return This.OwnerType.QualifiedName() + "." + functionName;
        }
        Return This.UnitName + "." + functionName;
    }

    Public Safe Function bool IsGenericTemplate()
    {
        Return This.Declaration.FirstTypeParameter != null && !This.IsGenericInstance;
    }

    Public Safe Function void AddSubstitution(TypeSubstitution substitution)
    {
        If (This.FirstSubstitution == null)
        {
            This.FirstSubstitution = substitution;
            Return;
        }
        TypeSubstitution current = This.FirstSubstitution;
        While (current.Next != null) current = current.Next;
        current.Next = substitution;
    }

    Public Safe Function TypeSymbol Substitute(string name)
    {
        TypeSubstitution current = This.FirstSubstitution;
        While (current != null)
        {
            If (current.Name == name) Return current.Type;
            current = current.Next;
        }
        Return null;
    }

    Public Safe Function void AddCapture(ValueSymbol source)
    {
        CaptureSymbol current = This.FirstCapture;
        While (current != null)
        {
            If (current.Source == source || current.Name == source.Name) Return;
            current = current.Next;
        }
        source.IsCaptured = true;
        CaptureSymbol capture = New CaptureSymbol(source, This.CaptureCount());
        capture.Next = This.FirstCapture;
        This.FirstCapture = capture;
    }

    Public Safe Function int CaptureCount()
    {
        int count = 0;
        CaptureSymbol current = This.FirstCapture;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }
}

Class CaptureSymbol
{
    Public string Name;
    Public TypeSymbol Type;
    Public ValueSymbol Source;
    Public ValueSymbol Value;
    Public int Index;
    Public CaptureSymbol Next;

    Public Safe Constructor(ValueSymbol source, int index)
    {
        This.Name = source.Name;
        This.Type = source.Type;
        This.Source = source;
        This.Value = New ValueSymbol(source.Name, source.Type, false);
        This.Index = index;
        This.Next = null;
    }
}

Class TypeSubstitution
{
    Public string Name;
    Public TypeSymbol Type;
    Public TypeSubstitution Next;

    Public Safe Constructor(string name, TypeSymbol type)
    {
        This.Name = name;
        This.Type = type;
        This.Next = null;
    }
}

Class ValueSymbol
{
    Public string Name;
    Public TypeSymbol Type;
    Public bool IsParameter;
    Public bool IsCaptured;
    Public string PackageLabels;
    Public string BlockRecords;
    Public FunctionSymbol CallableFunction;
    Public CallableElementSymbol FirstCallableElement;
    Public ValueSymbol Next;

    Public Safe Constructor(string name, TypeSymbol type, bool isParameter)
    {
        This.Name = name;
        This.Type = type;
        This.IsParameter = isParameter;
        This.IsCaptured = false;
        This.PackageLabels = "";
        This.BlockRecords = "";
        This.CallableFunction = null;
        This.FirstCallableElement = null;
        This.Next = null;
    }

    Public Safe Function void AddCallableElement(int index, FunctionSymbol function)
    {
        CallableElementSymbol element = New CallableElementSymbol(index, function);
        element.Next = This.FirstCallableElement;
        This.FirstCallableElement = element;
    }

    Public Safe Function FunctionSymbol CallableElement(int index)
    {
        CallableElementSymbol current = This.FirstCallableElement;
        While (current != null)
        {
            If (current.Index == index) Return current.Function;
            current = current.Next;
        }
        Return null;
    }
}

Class CallableElementSymbol
{
    Public int Index;
    Public FunctionSymbol Function;
    Public CallableElementSymbol Next;

    Public Safe Constructor(int index, FunctionSymbol function)
    {
        This.Index = index;
        This.Function = function;
        This.Next = null;
    }
}

Class GlobalSymbol
{
    Public string UnitName;
    Public FieldDecl Declaration;
    Public ValueSymbol Value;
    Public GlobalSymbol Next;

    Public Safe Constructor(string unitName, FieldDecl declaration, TypeSymbol type)
    {
        This.UnitName = unitName;
        This.Declaration = declaration;
        This.Value = New ValueSymbol(declaration.Name, type, false);
        This.Next = null;
    }

    Public Safe Function string QualifiedName()
    {
        Return This.UnitName + "." + This.Declaration.Name;
    }
}

Class BindingScope
{
    Public BindingScope Parent;
    Public ValueSymbol FirstValue;

    Public Safe Constructor(BindingScope parent)
    {
        This.Parent = parent;
        This.FirstValue = null;
    }

    Public Safe Function void Add(ValueSymbol value)
    {
        value.Next = This.FirstValue;
        This.FirstValue = value;
    }

    Public Safe Function ValueSymbol Find(string name)
    {
        BindingScope scope = This;
        While (scope != null)
        {
            ValueSymbol current = scope.FirstValue;
            While (current != null)
            {
                If (current.Name == name) Return current;
                current = current.Next;
            }
            scope = scope.Parent;
        }
        Return null;
    }
}

Unit IO.Kinal.Compiler.Core.CompileSession;

Get IO.File;
Get IO.Path;
Get IO.Text;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Core.TargetInfo;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Source.SourceManager;
Get IO.Kinal.Compiler.Source.SourcePath;
Get IO.Kinal.Compiler.Lex.Lexer;
Get IO.Kinal.Compiler.Syntax.Parser;
Get IO.Kinal.Compiler.Syntax.SyntaxTree;
Get IO.Kinal.Compiler.Project.ProjectConfig;
Get IO.Kinal.Compiler.Project.ProjectLoader;

Class CompilationUnit
{
    Public SourceFile Source;
    Public list Tokens;
    Public SyntaxTree Syntax;
    Public CompilationUnit Next;

    Public Safe Constructor(SourceFile source, list tokens, SyntaxTree syntax)
    {
        This.Source = source;
        This.Tokens = tokens;
        This.Syntax = syntax;
        This.Next = null;
    }
}

Class ProjectSourceProbe
{
    Public string Path;
    Public SyntaxTree Syntax;
    Public bool Selected;
    Public ProjectSourceProbe Next;

    Public Safe Constructor(string path, SyntaxTree syntax)
    {
        This.Path = path;
        This.Syntax = syntax;
        This.Selected = false;
        This.Next = null;
    }
}

Class CompileSession
{
    Public list Diagnostics;
    Public SourceManager Sources;
    Public ProjectConfig Project;
    Public ProjectProfileConfig Profile;
    Public TargetInfo Target;
    Public string RequestedTarget;
    Public string RequestedBackend;
    Public string FrontendMode;
    Public list SourcePaths;
    Public dict ProjectProbeCache;
    Public CompilationUnit FirstUnit;
    Public string EntryUnitName;

    Public Safe Constructor()
    {
        This.Diagnostics = list.Create();
        This.Sources = New SourceManager();
        This.Project = null;
        This.Profile = null;
        This.Target = IO.Kinal.Compiler.Core.TargetInfo.Resolve("host");
        This.RequestedTarget = "";
        This.RequestedBackend = "Native";
        This.FrontendMode = "";
        This.SourcePaths = list.Create();
        This.ProjectProbeCache = dict.Create();
        This.FirstUnit = null;
        This.EntryUnitName = "";
    }

    Public Safe Function bool HasErrors()
    {
        Return IO.Kinal.Compiler.Core.Diagnostics.HasAny(This.Diagnostics);
    }

    Public Safe Function bool IsFreestanding()
    {
        Return This.Profile != null && This.Profile.Environment == "Freestanding";
    }

    Public Safe Function bool IsFreestandingCore()
    {
        Return This.Profile != null && This.Profile.Environment == "Freestanding" &&
            This.Profile.Runtime == "None";
    }

    Public Safe Function void ReportProject(string title, string detail)
    {
        SourceFile source = This.Sources.Load(This.Project.ManifestPath);
        IO.Kinal.Compiler.Core.Diagnostics.Add(This.Diagnostics, source, "Project", title, detail, 1, 1, 1);
    }

    Public Safe Function bool LoadProject(string manifestPath, string profileName, string explicitEntry = "")
    {
        This.Project = IO.Kinal.Compiler.Project.ProjectLoader.Load(manifestPath, This.Diagnostics);
        If (This.HasErrors()) Return false;
        This.Profile = This.Project.FindProfile(profileName);
        If (This.Profile == null)
        {
            This.ReportProject("Unknown profile", IO.Text.IsEmpty(profileName) ?
                This.Project.DefaultProfile : profileName);
            Return false;
        }
        // Explicit command-line inputs select the entry before source graph
        // validation, including when the manifest's default entry is absent.
        If (!IO.Text.IsEmpty(explicitEntry))
            This.Profile.Entry = IO.Kinal.Compiler.Source.SourcePath.Canonical(explicitEntry);
        If (IO.Text.IsEmpty(This.Profile.Entry))
        {
            This.ReportProject("No entry source", "project requires an entry or an explicit source input");
            Return false;
        }
        If (This.Project.IsLegacy && This.Project.FirstSourceSet != null)
        {
            This.Project.FirstSourceSet.Roots = list.Create();
            This.Project.FirstSourceSet.Roots.Add(IO.Path.Directory(This.Profile.Entry));
        }
        int selectedSet = 0;
        While (selectedSet < This.Profile.Sets.Count())
        {
            string setName = [string](This.Profile.Sets.Fetch(selectedSet));
            If (This.Project.FindSourceSet(setName) == null)
                This.ReportProject("Unknown SourceSet", setName);
            selectedSet = selectedSet + 1;
        }
        If (This.HasErrors()) Return false;
        This.SourcePaths = This.Project.DiscoverSources(This.Profile.Name);
        If (This.SourcePaths.Count() == 0)
        {
            This.ReportProject("No source files", "selected profile did not discover any Kinal sources");
            Return false;
        }
        string entryPath = This.Project.ResolvePath(This.Profile.Entry);
        If (!This.SourcePaths.Contains(entryPath))
        {
            This.ReportProject("Entry source not selected", entryPath);
            Return false;
        }
        // RequireUnit is a SourceSet contract, including files not reachable
        // from the entry Unit. Keep unrelated body diagnostics isolated.
        int sourceIndex = 0;
        While (sourceIndex < This.SourcePaths.Count())
        {
            string path = [string](This.SourcePaths.Fetch(sourceIndex));
            If (This.Project.SourceRequiresUnit(This.Profile.Name, path))
            {
                ProjectSourceProbe probe = This.ProbeProjectSource(path);
                If (probe == null || IO.Text.IsEmpty(probe.Syntax.UnitName))
                    This.ReportProject("Unit required",
                        "project source files must declare Unit: " + path);
            }
            sourceIndex = sourceIndex + 1;
        }
        Return !This.HasErrors();
    }

    Public Safe Function bool ValidateProfile()
    {
        string mode = IO.Text.ToLower(This.Profile.Mode);
        If (mode == "fileonly") This.Profile.Mode = "FileOnly";
        ElseIf (mode == "entryunit") This.Profile.Mode = "EntryUnit";
        ElseIf (mode == "reachableunits") This.Profile.Mode = "ReachableUnits";
        ElseIf (mode == "allsources") This.Profile.Mode = "AllSources";
        If (IO.Text.ToLower(This.Profile.Backend) == "native") This.Profile.Backend = "Native";
        ElseIf (IO.Text.ToLower(This.Profile.Backend) == "vm") This.Profile.Backend = "VM";
        string environment = IO.Text.ToLower(This.Profile.Environment);
        string runtime = IO.Text.ToLower(This.Profile.Runtime);
        string panic = IO.Text.ToLower(This.Profile.Panic);
        This.Profile.Environment = (environment == "freestanding" || environment == "bare") ? "Freestanding" : (environment == "hosted" ? "Hosted" : This.Profile.Environment);
        This.Profile.Runtime = (runtime == "none" || runtime == "core") ? "None" : (runtime == "alloc" ? "Alloc" : (runtime == "gc" ? "GC" : This.Profile.Runtime));
        This.Profile.Panic = (panic == "loop" || panic == "halt") ? "Loop" : ((panic == "trap" || panic == "abort") ? "Trap" : This.Profile.Panic);
        TargetInfo requested = IO.Kinal.Compiler.Core.TargetInfo.Resolve(IO.Text.IsEmpty(This.RequestedTarget) ? This.Profile.Target : This.RequestedTarget);
        If (!This.Profile.EnvironmentExplicit && requested != null && requested.OS == 0)
            This.Profile.Environment = "Freestanding";
        If (This.IsFreestanding() && !This.Profile.RuntimeExplicit) This.Profile.Runtime = "None";
        If (This.Profile.Mode != "FileOnly" &&
            This.Profile.Mode != "EntryUnit" &&
            This.Profile.Mode != "ReachableUnits" &&
            This.Profile.Mode != "AllSources")
            This.ReportProject("Unsupported project option",
                "Source.Mode=" + This.Profile.Mode);
        If (!This.Profile.BackendExplicit) This.Profile.Backend = This.RequestedBackend;
        If (This.Profile.Backend != This.RequestedBackend)
            This.ReportProject("Unsupported project option",
                "Build.Backend=" + This.Profile.Backend + "; requested " + This.RequestedBackend);
        If (This.Profile.Backend == "VM" && This.Profile.Environment != "Hosted")
            This.ReportProject("Unsupported project option", "VM requires Environment=Hosted");
        If (This.Profile.Environment != "Hosted" && !This.IsFreestanding())
            This.ReportProject("Unsupported project option",
                "Build.Environment=" + This.Profile.Environment);
        If (This.Profile.Runtime != "GC" && This.Profile.Runtime != "Alloc" && This.Profile.Runtime != "None")
            This.ReportProject("Unsupported project option",
                "Build.Runtime=" + This.Profile.Runtime);
        If (This.IsFreestanding() && This.Profile.Runtime != "None")
            This.ReportProject("Unsupported project option",
                "freestanding Alloc/GC requires a Kinal runtime package; currently only Runtime=None is supported");
        If (This.Profile.Panic != "Trap" &&
            !(This.IsFreestanding() && This.Profile.Panic == "Loop"))
            This.ReportProject("Unsupported project option",
                "Build.Panic=" + This.Profile.Panic);
        string targetName = IO.Text.IsEmpty(This.RequestedTarget) ?
            This.Profile.Target : This.RequestedTarget;
        This.Target = IO.Kinal.Compiler.Core.TargetInfo.Resolve(targetName);
        If (This.Target == null)
            This.ReportProject("Unsupported target", targetName +
                "; supported targets are Windows x86/x64/arm64 and Linux/macOS/bare x64/arm64");
        ElseIf (This.Target.OS == 0 && !This.IsFreestanding())
            This.ReportProject("Unsupported project option",
                "bare targets require Environment=Freestanding");
        If (This.Target != null && This.Profile.Backend == "VM" && !This.Target.IsHost())
            This.ReportProject("Unsupported target", "selfhost VM currently requires the host target");
        If (!This.IsFreestanding() && (This.Profile.RuntimeExplicit || This.Profile.PanicExplicit || This.Profile.NoCRT || !IO.Text.IsEmpty(This.Profile.LinkScript)))
            This.ReportProject("Invalid build options", "hosted builds do not accept freestanding-only options");
        If (This.IsFreestanding() && This.Profile.CRTExplicit)
            This.ReportProject("Invalid build options", "freestanding builds do not accept hosted CRT options");
        If (This.IsFreestanding() && This.Profile.ArtifactKind == "shared")
            This.ReportProject("Invalid build options", "freestanding does not support shared libraries");
        If (!IO.Text.IsEmpty(This.Profile.Linker) && This.Profile.Linker != "lld" && This.Profile.Linker != "zig" && This.Profile.Linker != "msvc")
            This.ReportProject("Invalid linker", This.Profile.Linker);
        If (!IO.Text.IsEmpty(This.Profile.LinkerPath) && IO.Text.IsEmpty(This.Profile.Linker))
            This.ReportProject("Invalid build options", "--linker-path requires --linker <lld|zig|msvc>");
        Return !This.HasErrors();
    }

    Public Safe Function void AddUnit(CompilationUnit unit)
    {
        If (This.FirstUnit == null)
        {
            This.FirstUnit = unit;
            Return;
        }
        CompilationUnit current = This.FirstUnit;
        While (current.Next != null) current = current.Next;
        current.Next = unit;
    }

    Public Safe Function CompilationUnit ParseFile(string path)
    {
        SourceFile source = This.Sources.Load(path);
        If (!IO.File.Exists(source.Path))
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(This.Diagnostics, source, "Source",
                "Source file not found", source.Path, 1, 1, 1);
            Return null;
        }
        list tokens = IO.Kinal.Compiler.Lex.Lexer.Tokenize(source, This.Diagnostics);
        If (This.HasErrors()) Return null;
        SyntaxTree syntax = This.FrontendMode == "build-tokens" ? New SyntaxTree(source, "") :
            IO.Kinal.Compiler.Syntax.Parser.Build(source, tokens, This.Diagnostics);
        If (syntax == null) Return null;
        If (This.FrontendMode != "build-tokens" && This.Project != null && This.Profile != null &&
            This.Project.SourceRequiresUnit(This.Profile.Name, source.Path) &&
            IO.Text.IsEmpty(syntax.UnitName))
        {
            IO.Kinal.Compiler.Core.Diagnostics.Add(This.Diagnostics, source,
                "Project", "Unit required",
                "SourceSet.RequireUnit requires an explicit Unit declaration",
                1, 1, 1);
            Return null;
        }
        CompilationUnit unit = New CompilationUnit(source, tokens, syntax);
        This.AddUnit(unit);
        Return unit;
    }

    Public Safe Function ProjectSourceProbe ProbeProjectSource(string path)
    {
        string canonical = IO.Kinal.Compiler.Source.SourcePath.Canonical(path);
        If (This.ProjectProbeCache.Contains(canonical))
            Return [ProjectSourceProbe](This.ProjectProbeCache.Fetch(canonical));
        SourceFile source = New SourceFile(
            canonical,
            IO.File.ReadAllText(path));
        list diagnostics = list.Create();
        list tokens = IO.Kinal.Compiler.Lex.Lexer.Tokenize(source, diagnostics);
        SyntaxTree syntax = IO.Kinal.Compiler.Syntax.Parser.Build(
            source, tokens, diagnostics, true);
        // Probing is used only to discover Unit/import relationships. Parser
        // recovery can still provide that structure after an error; selected
        // sources are parsed again through ParseFile so their diagnostics are
        // reported exactly once, while unreachable files remain isolated.
        If (syntax == null) Return null;
        ProjectSourceProbe probe = New ProjectSourceProbe(source.Path, syntax);
        // A compilation session sees an immutable source snapshot. Reuse the
        // same probe for validation, reachability, and dependency indexing.
        This.ProjectProbeCache.Set(canonical, probe);
        Return probe;
    }

    Public Safe Function ProjectSourceProbe BuildProjectProbes()
    {
        ProjectSourceProbe first = null;
        ProjectSourceProbe last = null;
        int index = 0;
        While (index < This.SourcePaths.Count())
        {
            ProjectSourceProbe probe = This.ProbeProjectSource(
                [string](This.SourcePaths.Fetch(index)));
            If (probe != null)
            {
                If (first == null) first = probe;
                Else last.Next = probe;
                last = probe;
            }
            index = index + 1;
        }
        Return first;
    }

    Public Safe Function ProjectSourceProbe FindProjectProbe(
        ProjectSourceProbe first, string path)
    {
        string normalized = IO.Kinal.Compiler.Source.SourcePath.Canonical(path);
        ProjectSourceProbe probe = first;
        While (probe != null)
        {
            If (probe.Path == normalized) Return probe;
            probe = probe.Next;
        }
        Return null;
    }

    Public Safe Function void SelectProjectUnit(ProjectSourceProbe first,
                                                 string unitName)
    {
        If (IO.Text.IsEmpty(unitName)) Return;
        ProjectSourceProbe probe = first;
        While (probe != null)
        {
            If (probe.Syntax.UnitName == unitName) probe.Selected = true;
            probe = probe.Next;
        }
    }

    Public Safe Function void SelectReachableProjectSources(
        ProjectSourceProbe first, ProjectSourceProbe entry)
    {
        entry.Selected = true;
        This.SelectProjectUnit(first, entry.Syntax.UnitName);
        bool changed = true;
        While (changed)
        {
            changed = false;
            ProjectSourceProbe source = first;
            While (source != null)
            {
                If (source.Selected)
                {
                    ImportDecl import = source.Syntax.FirstImport;
                    While (import != null)
                    {
                        ProjectSourceProbe candidate = first;
                        While (candidate != null)
                        {
                            string unitName = candidate.Syntax.UnitName;
                            If (!candidate.Selected && !IO.Text.IsEmpty(unitName) &&
                                (import.Target == unitName ||
                                 IO.Text.StartsWith(import.Target, unitName + ".")))
                            {
                                candidate.Selected = true;
                                This.SelectProjectUnit(first, unitName);
                                changed = true;
                            }
                            candidate = candidate.Next;
                        }
                        import = import.Next;
                    }
                }
                source = source.Next;
            }
        }
    }

    Public Safe Function bool ParseProject()
    {
        If (This.Project == null || This.Profile == null) Return false;
        string entryPath = This.Project.ResolvePath(This.Profile.Entry);
        bool entryFound = false;
        string mode = This.Profile.AutoDiscovery ? This.Profile.Mode : "FileOnly";
        If (mode == "AllSources")
        {
            int index = 0;
            While (index < This.SourcePaths.Count())
            {
                CompilationUnit unit = This.ParseFile(
                    [string](This.SourcePaths.Fetch(index)));
                If (unit != null && unit.Source.Path == entryPath)
                {
                    This.EntryUnitName = unit.Syntax.UnitName;
                    entryFound = true;
                }
                index = index + 1;
            }
        }
        ElseIf (mode == "FileOnly")
        {
            CompilationUnit unit = This.ParseFile(entryPath);
            If (unit != null)
            {
                This.EntryUnitName = unit.Syntax.UnitName;
                entryFound = true;
            }
        }
        Else
        {
            ProjectSourceProbe first = This.BuildProjectProbes();
            ProjectSourceProbe entry = This.FindProjectProbe(first, entryPath);
            If (entry == null)
            {
                // Keep the entry source authoritative even when the probe
                // could not recover a syntax tree.  ParseFile is the source
                // of truth for diagnostics and may still accept parser
                // recovery, so do not turn a valid entry into a misleading
                // "Entry source not found" error.
                CompilationUnit unit = This.ParseFile(entryPath);
                If (unit != null)
                {
                    This.EntryUnitName = unit.Syntax.UnitName;
                    entryFound = true;
                }
            }
            Else
            {
                entry.Selected = true;
                This.SelectProjectUnit(first, entry.Syntax.UnitName);
                If (mode == "ReachableUnits")
                    This.SelectReachableProjectSources(first, entry);
                ProjectSourceProbe probe = first;
                While (probe != null)
                {
                    If (probe.Selected)
                    {
                        CompilationUnit unit = This.ParseFile(probe.Path);
                        If (unit != null && unit.Source.Path == entryPath)
                        {
                            This.EntryUnitName = unit.Syntax.UnitName;
                            entryFound = true;
                        }
                    }
                    probe = probe.Next;
                }
            }
        }
        If (!entryFound)
        {
            This.ReportProject("Entry source not found", entryPath);
        }
        Return !This.HasErrors();
    }

    Public Safe Function int UnitCount()
    {
        int count = 0;
        CompilationUnit current = This.FirstUnit;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function string SyntaxSummary()
    {
        int imports = 0;
        int functions = 0;
        int types = 0;
        int fields = 0;
        int methods = 0;
        int globals = 0;
        CompilationUnit current = This.FirstUnit;
        While (current != null)
        {
            imports = imports + current.Syntax.ImportCount();
            functions = functions + current.Syntax.FunctionCount();
            types = types + current.Syntax.TypeCount();
            fields = fields + current.Syntax.FieldCount();
            methods = methods + current.Syntax.MethodCount();
            globals = globals + current.Syntax.GlobalCount();
            current = current.Next;
        }
        Return "format=kinal-syntax-v1\n" +
               "sources=" + [string](This.UnitCount()) + "\n" +
               "unit=" + This.EntryUnitName + "\n" +
               "imports=" + [string](imports) + "\n" +
               "functions=" + [string](functions) + "\n" +
               "types=" + [string](types) + "\n" +
               "fields=" + [string](fields) + "\n" +
               "methods=" + [string](methods) + "\n" +
               "globals=" + [string](globals);
    }
}

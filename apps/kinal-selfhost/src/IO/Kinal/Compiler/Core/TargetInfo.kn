Unit IO.Kinal.Compiler.Core.TargetInfo;

Get IO.Host;
Get IO.Text;

// Compilation facts, not runtime OS probes. Keep the host and output target
// separate: IO.Host describes the compiler; IO.Target describes its output.
Class TargetInfo
{
    Public string Triple;
    Public int OS;
    Public int Architecture;
    Public int PointerBits;

    Public Safe Constructor(string triple, int os, int architecture)
    {
        This.Triple = triple;
        This.OS = os;
        This.Architecture = architecture;
        This.PointerBits = 64;
    }

    Public Safe Function bool IsHost()
    {
        Return This.OS == IO.Host.OS.Current &&
            This.Architecture == IO.Host.Arch.Current;
    }

    Public Safe Function string PathSeparator() { Return This.OS == 1 ? "\\" : "/"; }
    Public Safe Function string NewLine() { Return This.OS == 1 ? "\r\n" : "\n"; }
    Public Safe Function string ExeSuffix() { Return This.OS == 1 ? ".exe" : ""; }
    Public Safe Function string ObjectSuffix() { Return This.OS == 1 ? ".obj" : ".o"; }
    Public Safe Function string StaticLibrarySuffix() { Return This.OS == 1 ? ".lib" : ".a"; }
    Public Safe Function string DynamicLibrarySuffix()
    {
        If (This.OS == 1) Return ".dll";
        Return This.OS == 3 ? ".dylib" : ".so";
    }
}

Safe Function string HostTriple()
{
    If (IO.Host.Arch != IO.Host.Arch.X64 && IO.Host.Arch != IO.Host.Arch.Arm64)
        Return "";
    If (IO.Host.OS == IO.Host.OS.Windows)
        Return IO.Host.Arch == IO.Host.Arch.Arm64 ?
            "aarch64-pc-windows-msvc" : "x86_64-pc-windows-msvc";
    If (IO.Host.OS == IO.Host.OS.Linux)
        Return IO.Host.Arch == IO.Host.Arch.Arm64 ?
            "aarch64-unknown-linux-gnu" : "x86_64-pc-linux-gnu";
    If (IO.Host.OS == IO.Host.OS.MacOS)
        Return IO.Host.Arch == IO.Host.Arch.Arm64 ?
            "aarch64-apple-darwin" : "x86_64-apple-darwin";
    Return "";
}

Safe Function TargetInfo Resolve(string requested)
{
    string target = IO.Text.ToLower(IO.Text.Trim(requested));
    If (IO.Text.IsEmpty(target) || target == "host") target = HostTriple();
    If (target == "win64" || target == "x64" || target == "windows" || target == "win-x64")
        target = "x86_64-pc-windows-msvc";
    If (target == "win-arm64" || target == "windows-arm64" ||
        target == "arm64" || target == "aarch64-windows") target = "aarch64-pc-windows-msvc";
    If (target == "linux64" || target == "linux-x64") target = "x86_64-pc-linux-gnu";
    If (target == "linux-arm64" || target == "linuxarm64" || target == "aarch64-linux")
        target = "aarch64-unknown-linux-gnu";
    If (target == "macos" || target == "macos-x64" || target == "mac64" ||
        target == "darwin" || target == "darwin-x64") target = "x86_64-apple-darwin";
    If (target == "macos-arm64" || target == "macarm64" ||
        target == "darwin-arm64" || target == "aarch64-darwin") target = "aarch64-apple-darwin";
    If (target == "bare64") target = "x86_64-unknown-none";
    If (target == "bare-arm64") target = "aarch64-unknown-none";

    // Reject unimplemented ABIs rather than silently treating them as x64.
    If (target == "x86_64-pc-windows-msvc") Return New TargetInfo(target, 1, 2);
    If (target == "aarch64-pc-windows-msvc") Return New TargetInfo(target, 1, 3);
    If (target == "x86_64-pc-linux-gnu" || target == "x86_64-unknown-linux-gnu" ||
        target == "x86_64-linux-gnu") Return New TargetInfo(target, 2, 2);
    If (target == "aarch64-unknown-linux-gnu" || target == "aarch64-linux-gnu")
        Return New TargetInfo(target, 2, 3);
    If (target == "x86_64-apple-darwin") Return New TargetInfo(target, 3, 2);
    If (target == "aarch64-apple-darwin") Return New TargetInfo(target, 3, 3);
    If (target == "x86_64-unknown-none") Return New TargetInfo(target, 0, 2);
    If (target == "aarch64-unknown-none") Return New TargetInfo(target, 0, 3);
    Return null;
}

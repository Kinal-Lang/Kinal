Safe Function string ChineseUi(string key)
{
    If (key == "ui.stage.lexer") Return "词法分析";
    If (key == "ui.stage.project") Return "项目";
    If (key == "ui.stage.driver") Return "驱动";
    If (key == "ui.stage.link") Return "链接";
    If (key == "ui.stage.native") Return "本机代码";
    If (key == "ui.stage.knc") Return "字节码";
    If (key == "ui.diag.location") Return "在 <{0}> 第 {1} 行，第 {2} 列";
    If (key == "ui.severity.error") Return "错误";
    If (key == "ui.severity.warning") Return "警告";
    If (key == "ui.stage.parser") Return "解析器";
    If (key == "ui.stage.sema") Return "语义分析";
    If (key == "ui.stage.codegen") Return "代码生成";
    Return "";
}

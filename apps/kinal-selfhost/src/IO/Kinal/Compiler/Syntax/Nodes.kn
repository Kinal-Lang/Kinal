Unit IO.Kinal.Compiler.Syntax.Nodes;

Enum ExpressionKind By int
{
    Missing = 0,
    Name,
    Number,
    String,
    FormattedString,
    Character,
    Boolean,
    Null,
    Unary,
    Binary,
    Conditional,
    Call,
    Member,
    Index,
    NewObject,
    Cast,
    ArrayLiteral,
    Switch,
    SwitchCase,
    FunctionLiteral,
    BlockLiteral
}

Enum StatementKind By int
{
    Empty = 0,
    Block,
    Variable,
    Expression,
    Return,
    If,
    While,
    For,
    Foreach,
    Switch,
    Case,
    Throw,
    Try,
    UnsafeBlock,
    Record,
    Jump,
    Break,
    Continue
}

Class ExpressionNode
{
    Public int Kind;
    Public string Text;
    Public int Operator;
    Public int Line;
    Public int Column;
    Public ExpressionNode Left;
    Public ExpressionNode Right;
    Public ExpressionNode Third;
    Public ExpressionNode FirstArgument;
    Public ExpressionNode LastArgument;
    Public TypeArgumentNode FirstTypeArgument;
    Public TypeArgumentNode LastTypeArgument;
    Public StatementNode Body;
    Public ExpressionNode Next;

    Public Safe Constructor(int kind, string text, int line, int column)
    {
        This.Kind = kind;
        This.Text = text;
        This.Operator = 0;
        This.Line = line;
        This.Column = column;
        This.Left = null;
        This.Right = null;
        This.Third = null;
        This.FirstArgument = null;
        This.LastArgument = null;
        This.FirstTypeArgument = null;
        This.LastTypeArgument = null;
        This.Body = null;
        This.Next = null;
    }

    Public Safe Function void AddArgument(ExpressionNode value)
    {
        If (This.FirstArgument == null)
        {
            This.FirstArgument = value;
            This.LastArgument = value;
        }
        Else
        {
            This.LastArgument.Next = value;
            This.LastArgument = value;
        }
    }

    Public Safe Function int ArgumentCount()
    {
        int count = 0;
        ExpressionNode current = This.FirstArgument;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function void AddTypeArgument(TypeArgumentNode value)
    {
        If (This.FirstTypeArgument == null)
        {
            This.FirstTypeArgument = value;
            This.LastTypeArgument = value;
        }
        Else
        {
            This.LastTypeArgument.Next = value;
            This.LastTypeArgument = value;
        }
    }

    Public Safe Function int TypeArgumentCount()
    {
        int count = 0;
        TypeArgumentNode current = This.FirstTypeArgument;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }
}

Class TypeArgumentNode
{
    Public string TypeName;
    Public int Line;
    Public int Column;
    Public TypeArgumentNode Next;

    Public Safe Constructor(string typeName, int line, int column)
    {
        This.TypeName = typeName;
        This.Line = line;
        This.Column = column;
        This.Next = null;
    }
}

Class StatementNode
{
    Public int Kind;
    Public string Name;
    Public string TypeName;
    Public int Line;
    Public int Column;
    Public ExpressionNode Expression;
    Public ExpressionNode SecondExpression;
    Public ExpressionNode ThirdExpression;
    Public StatementNode Initializer;
    Public StatementNode FirstChild;
    Public StatementNode LastChild;
    Public StatementNode ElseBranch;
    Public StatementNode Next;

    Public Safe Constructor(int kind, int line, int column)
    {
        This.Kind = kind;
        This.Name = "";
        This.TypeName = "";
        This.Line = line;
        This.Column = column;
        This.Expression = null;
        This.SecondExpression = null;
        This.ThirdExpression = null;
        This.Initializer = null;
        This.FirstChild = null;
        This.LastChild = null;
        This.ElseBranch = null;
        This.Next = null;
    }

    Public Safe Function void AddChild(StatementNode value)
    {
        If (This.FirstChild == null)
        {
            This.FirstChild = value;
            This.LastChild = value;
        }
        Else
        {
            This.LastChild.Next = value;
            This.LastChild = value;
        }
    }
}

Unit IO.Kinal.Compiler.Syntax.SyntaxTree;

Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Syntax.Nodes;

Class ImportDecl
{
    Public string Name;
    Public string Target;
    Public int Line;
    Public int Column;
    Public ImportDecl Next;

    Public Safe Constructor(string name, string target, int line, int column)
    {
        This.Name = name;
        This.Target = target;
        This.Line = line;
        This.Column = column;
        This.Next = null;
    }
}

Class ParameterDecl
{
    Public string Name;
    Public string TypeName;
    Public ExpressionNode DefaultValue;
    Public ParameterDecl Next;

    Public Safe Constructor(string name, string typeName)
    {
        This.Name = name;
        This.TypeName = typeName;
        This.DefaultValue = null;
        This.Next = null;
    }
}

Class SyntaxAttribute
{
    Public string Name;
    Public ExpressionNode FirstArgument;
    Public ExpressionNode LastArgument;
    Public SyntaxAttribute Next;

    Public Safe Constructor(string name)
    {
        This.Name = name;
        This.FirstArgument = null;
        This.LastArgument = null;
        This.Next = null;
    }

    Public Safe Function void AddArgument(ExpressionNode argument)
    {
        If (This.FirstArgument == null)
        {
            This.FirstArgument = argument;
            This.LastArgument = argument;
        }
        Else
        {
            This.LastArgument.Next = argument;
            This.LastArgument = argument;
        }
    }
}

Class FieldDecl
{
    Public string Name;
    Public string TypeName;
    Public int Access;
    Public bool IsStatic;
    Public bool IsConst;
    Public int Line;
    Public int Column;
    Public ExpressionNode Initializer;
    Public SyntaxAttribute FirstAttribute;
    Public FieldDecl Next;

    Public Safe Constructor(string name, string typeName, int line, int column)
    {
        This.Name = name;
        This.TypeName = typeName;
        This.Access = 0;
        This.IsStatic = false;
        This.IsConst = false;
        This.Line = line;
        This.Column = column;
        This.Initializer = null;
        This.FirstAttribute = null;
        This.Next = null;
    }
}

Class FunctionDecl
{
    Public string Name;
    Public string ReturnType;
    Public int Safety;
    Public bool IsStatic;
    Public bool IsAsync;
    Public bool IsExtern;
    Public bool IsDelegate;
    Public bool IsConstructor;
    Public string Abi;
    Public int Line;
    Public int Column;
    Public ParameterDecl FirstParameter;
    Public ParameterDecl LastParameter;
    Public TypeParameterDecl FirstTypeParameter;
    Public TypeParameterDecl LastTypeParameter;
    Public StatementNode Body;
    Public SyntaxAttribute FirstAttribute;
    Public FunctionDecl Next;

    Public Safe Constructor(string name, string returnType, int line, int column)
    {
        This.Name = name;
        This.ReturnType = returnType;
        This.Safety = 0;
        This.IsStatic = false;
        This.IsAsync = false;
        This.IsExtern = false;
        This.IsDelegate = false;
        This.IsConstructor = false;
        This.Abi = "Kinal";
        This.Line = line;
        This.Column = column;
        This.FirstParameter = null;
        This.LastParameter = null;
        This.FirstTypeParameter = null;
        This.LastTypeParameter = null;
        This.Body = null;
        This.FirstAttribute = null;
        This.Next = null;
    }

    Public Safe Function void AddParameter(ParameterDecl parameter)
    {
        If (This.FirstParameter == null)
        {
            This.FirstParameter = parameter;
            This.LastParameter = parameter;
        }
        Else
        {
            This.LastParameter.Next = parameter;
            This.LastParameter = parameter;
        }
    }

    Public Safe Function int ParameterCount()
    {
        int count = 0;
        ParameterDecl current = This.FirstParameter;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function void AddTypeParameter(TypeParameterDecl parameter)
    {
        If (This.FirstTypeParameter == null)
        {
            This.FirstTypeParameter = parameter;
            This.LastTypeParameter = parameter;
        }
        Else
        {
            This.LastTypeParameter.Next = parameter;
            This.LastTypeParameter = parameter;
        }
    }

    Public Safe Function int TypeParameterCount()
    {
        int count = 0;
        TypeParameterDecl current = This.FirstTypeParameter;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }
}

Class TypeParameterDecl
{
    Public string Name;
    Public int Line;
    Public int Column;
    Public TypeParameterDecl Next;

    Public Safe Constructor(string name, int line, int column)
    {
        This.Name = name;
        This.Line = line;
        This.Column = column;
        This.Next = null;
    }
}

Class EnumMemberDecl
{
    Public string Name;
    Public int Ordinal;
    Public ExpressionNode Value;
    Public EnumMemberDecl Next;

    Public Safe Constructor(string name, int ordinal)
    {
        This.Name = name;
        This.Ordinal = ordinal;
        This.Value = null;
        This.Next = null;
    }
}

Class TypeDecl
{
    Public int Kind;
    Public string Name;
    Public bool IsStatic;
    Public int Line;
    Public int Column;
    Public FieldDecl FirstField;
    Public FieldDecl LastField;
    Public FunctionDecl FirstMethod;
    Public FunctionDecl LastMethod;
    Public SyntaxAttribute FirstAttribute;
    Public EnumMemberDecl FirstEnumMember;
    Public EnumMemberDecl LastEnumMember;
    Public TypeDecl Next;

    Public Safe Constructor(int kind, string name, int line, int column)
    {
        This.Kind = kind;
        This.Name = name;
        This.IsStatic = false;
        This.Line = line;
        This.Column = column;
        This.FirstField = null;
        This.LastField = null;
        This.FirstMethod = null;
        This.LastMethod = null;
        This.FirstAttribute = null;
        This.FirstEnumMember = null;
        This.LastEnumMember = null;
        This.Next = null;
    }

    Public Safe Function void AddField(FieldDecl value)
    {
        If (This.FirstField == null)
        {
            This.FirstField = value;
            This.LastField = value;
        }
        Else
        {
            This.LastField.Next = value;
            This.LastField = value;
        }
    }

    Public Safe Function void AddMethod(FunctionDecl value)
    {
        If (This.FirstMethod == null)
        {
            This.FirstMethod = value;
            This.LastMethod = value;
        }
        Else
        {
            This.LastMethod.Next = value;
            This.LastMethod = value;
        }
    }

    Public Safe Function void AddEnumMember(EnumMemberDecl value)
    {
        If (This.FirstEnumMember == null)
        {
            This.FirstEnumMember = value;
            This.LastEnumMember = value;
        }
        Else
        {
            This.LastEnumMember.Next = value;
            This.LastEnumMember = value;
        }
    }

    Public Safe Function int FieldCount()
    {
        int count = 0;
        FieldDecl current = This.FirstField;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function int MethodCount()
    {
        int count = 0;
        FunctionDecl current = This.FirstMethod;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }
}

Class SyntaxTree
{
    Public SourceFile Source;
    Public string UnitName;
    Public ImportDecl FirstImport;
    Public ImportDecl LastImport;
    Public FieldDecl FirstGlobal;
    Public FieldDecl LastGlobal;
    Public FunctionDecl FirstFunction;
    Public FunctionDecl LastFunction;
    Public TypeDecl FirstType;
    Public TypeDecl LastType;

    Public Safe Constructor(SourceFile source, string unitName)
    {
        This.Source = source;
        This.UnitName = unitName;
        This.FirstImport = null;
        This.LastImport = null;
        This.FirstGlobal = null;
        This.LastGlobal = null;
        This.FirstFunction = null;
        This.LastFunction = null;
        This.FirstType = null;
        This.LastType = null;
    }

    Public Safe Function void AddGlobal(FieldDecl value)
    {
        If (This.FirstGlobal == null)
        {
            This.FirstGlobal = value;
            This.LastGlobal = value;
        }
        Else
        {
            This.LastGlobal.Next = value;
            This.LastGlobal = value;
        }
    }

    Public Safe Function void AddImport(ImportDecl value)
    {
        If (This.FirstImport == null)
        {
            This.FirstImport = value;
            This.LastImport = value;
        }
        Else
        {
            This.LastImport.Next = value;
            This.LastImport = value;
        }
    }

    Public Safe Function void AddFunction(FunctionDecl value)
    {
        If (This.FirstFunction == null)
        {
            This.FirstFunction = value;
            This.LastFunction = value;
        }
        Else
        {
            This.LastFunction.Next = value;
            This.LastFunction = value;
        }
    }

    Public Safe Function void AddType(TypeDecl value)
    {
        If (This.FirstType == null)
        {
            This.FirstType = value;
            This.LastType = value;
        }
        Else
        {
            This.LastType.Next = value;
            This.LastType = value;
        }
    }

    Public Safe Function int ImportCount()
    {
        int count = 0;
        ImportDecl current = This.FirstImport;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function int FunctionCount()
    {
        int count = 0;
        FunctionDecl current = This.FirstFunction;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function int GlobalCount()
    {
        int count = 0;
        FieldDecl current = This.FirstGlobal;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function int TypeCount()
    {
        int count = 0;
        TypeDecl current = This.FirstType;
        While (current != null)
        {
            count = count + 1;
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function int FieldCount()
    {
        int count = 0;
        TypeDecl current = This.FirstType;
        While (current != null)
        {
            count = count + current.FieldCount();
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function int MethodCount()
    {
        int count = 0;
        TypeDecl current = This.FirstType;
        While (current != null)
        {
            count = count + current.MethodCount();
            current = current.Next;
        }
        Return count;
    }

    Public Safe Function string Summary()
    {
        Return "format=kinal-syntax-v1\n" +
               "sources=1\n" +
               "unit=" + This.UnitName + "\n" +
               "imports=" + [string](This.ImportCount()) + "\n" +
               "functions=" + [string](This.FunctionCount()) + "\n" +
               "types=" + [string](This.TypeCount()) + "\n" +
               "fields=" + [string](This.FieldCount()) + "\n" +
               "methods=" + [string](This.MethodCount()) + "\n" +
               "globals=" + [string](This.GlobalCount());
    }
}

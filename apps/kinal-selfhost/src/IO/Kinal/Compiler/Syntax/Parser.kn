Unit IO.Kinal.Compiler.Syntax.Parser;

Get IO.Text;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Lex.Token;
Get IO.Kinal.Compiler.Lex.TokenKind;
Get IO.Kinal.Compiler.Syntax.SyntaxTree;
Get IO.Kinal.Compiler.Syntax.Nodes;

Class ParseCursor
{
    Public list Tokens;
    Public int Position;

    Public Safe Constructor(list tokens)
    {
        This.Tokens = tokens;
        This.Position = 0;
    }
}

Class UnsafeAliasRule
{
    Public list SourceTokens;
    Public list TargetTokens;
    Public UnsafeAliasRule Next;

    Public Safe Constructor()
    {
        This.SourceTokens = list.Create();
        This.TargetTokens = list.Create();
        This.Next = null;
    }

    Public Safe Function bool Matches(list tokens, int position)
    {
        If (position + This.SourceTokens.Count() > tokens.Count()) Return false;
        int i = 0;
        While (i < This.SourceTokens.Count())
        {
            string expected = [string](This.SourceTokens.Fetch(i));
            string actual = [string](tokens.Fetch(position + i));
            If (IO.Kinal.Compiler.Lex.Token.Kind(expected) !=
                    IO.Kinal.Compiler.Lex.Token.Kind(actual) ||
                IO.Kinal.Compiler.Lex.Token.Text(expected) !=
                    IO.Kinal.Compiler.Lex.Token.Text(actual)) Return false;
            i = i + 1;
        }
        Return true;
    }
}

Safe Function string ListTokenAt(list tokens, int index)
{
    If (index < 0 || index >= tokens.Count()) Return "";
    Return [string](tokens.Fetch(index));
}

Safe Function int ListTokenKindAt(list tokens, int index)
{
    Return IO.Kinal.Compiler.Lex.Token.Kind(ListTokenAt(tokens, index));
}

Safe Function int UnsafeAliasTerminator(list tokens, int start, int line)
{
    int terminator = -1;
    int index = start;
    While (index < tokens.Count())
    {
        string token = ListTokenAt(tokens, index);
        If (IO.Kinal.Compiler.Lex.Token.Line(token) != line) Break;
        If (IO.Kinal.Compiler.Lex.Token.Kind(token) == [int](TokenKind.Semicolon))
            terminator = index;
        index = index + 1;
    }
    Return terminator;
}

Safe Function list PrepareTokens(list tokens)
{
    UnsafeAliasRule firstRule = null;
    UnsafeAliasRule lastRule = null;
    int position = 0;
    While (position < tokens.Count())
    {
        bool triple = ListTokenKindAt(tokens, position) == [int](TokenKind.KwUnsafe) &&
            ListTokenKindAt(tokens, position + 1) == [int](TokenKind.KwUnsafe) &&
            ListTokenKindAt(tokens, position + 2) == [int](TokenKind.KwUnsafe) &&
            ListTokenKindAt(tokens, position + 3) == [int](TokenKind.KwAlias);
        bool keyword = ListTokenKindAt(tokens, position) == [int](TokenKind.KwUnsafe) &&
            ListTokenKindAt(tokens, position + 1) == [int](TokenKind.KwAlias);
        If (!triple && !keyword) Break;

        int line = IO.Kinal.Compiler.Lex.Token.Line(ListTokenAt(tokens, position));
        int sourceStart = position + (triple ? 4 : 2);
        int separator = sourceStart;
        While (separator < tokens.Count() &&
               ListTokenKindAt(tokens, separator) != [int](TokenKind.KwBy) &&
               IO.Kinal.Compiler.Lex.Token.Line(ListTokenAt(tokens, separator)) == line)
            separator = separator + 1;
        int terminator = UnsafeAliasTerminator(tokens, separator + 1, line);
        If (separator <= sourceStart || terminator <= separator + 1) Break;

        UnsafeAliasRule rule = New UnsafeAliasRule();
        int index = sourceStart;
        While (index < separator)
        {
            rule.SourceTokens.Add(ListTokenAt(tokens, index));
            index = index + 1;
        }
        index = separator + 1;
        While (index < terminator)
        {
            rule.TargetTokens.Add(ListTokenAt(tokens, index));
            index = index + 1;
        }
        If (!triple && (rule.SourceTokens.Count() != 1 || rule.TargetTokens.Count() != 1)) Break;
        If (firstRule == null) firstRule = rule; Else lastRule.Next = rule;
        lastRule = rule;
        position = terminator + 1;
    }

    If (firstRule == null) Return tokens;
    list prepared = list.Create();
    While (position < tokens.Count())
    {
        UnsafeAliasRule match = firstRule;
        While (match != null && !match.Matches(tokens, position)) match = match.Next;
        If (match == null)
        {
            prepared.Add(ListTokenAt(tokens, position));
            position = position + 1;
            Continue;
        }

        string sourceToken = ListTokenAt(tokens, position);
        int targetIndex = 0;
        While (targetIndex < match.TargetTokens.Count())
        {
            string targetToken = [string](match.TargetTokens.Fetch(targetIndex));
            prepared.Add(IO.Kinal.Compiler.Lex.Token.Encode(
                IO.Kinal.Compiler.Lex.Token.Kind(targetToken),
                IO.Kinal.Compiler.Lex.Token.Text(targetToken),
                IO.Kinal.Compiler.Lex.Token.Line(sourceToken),
                IO.Kinal.Compiler.Lex.Token.Column(sourceToken)));
            targetIndex = targetIndex + 1;
        }
        position = position + match.SourceTokens.Count();
    }
    Return prepared;
}

Safe Function string RawAt(ParseCursor cursor, int index)
{
    If (index < 0 || index >= cursor.Tokens.Count()) Return "";
    Return [string](cursor.Tokens.Fetch(index));
}

Safe Function int KindAt(ParseCursor cursor, int index)
{
    Return IO.Kinal.Compiler.Lex.Token.Kind(RawAt(cursor, index));
}

Safe Function int CurrentKind(ParseCursor cursor)
{
    Return KindAt(cursor, cursor.Position);
}

Safe Function string CurrentToken(ParseCursor cursor)
{
    Return RawAt(cursor, cursor.Position);
}

Safe Function bool IsEnd(ParseCursor cursor)
{
    Return CurrentKind(cursor) == [int](TokenKind.Eof);
}

Safe Function void Advance(ParseCursor cursor)
{
    If (cursor.Position < cursor.Tokens.Count()) cursor.Position = cursor.Position + 1;
}

Safe Function bool Match(ParseCursor cursor, int kind)
{
    If (CurrentKind(cursor) != kind) Return false;
    Advance(cursor);
    Return true;
}

Safe Function bool IsContextual(ParseCursor cursor, string text)
{
    Return CurrentKind(cursor) == [int](TokenKind.Identifier) &&
           IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor)) == text;
}

Safe Function bool MatchContextual(ParseCursor cursor, string text)
{
    If (!IsContextual(cursor, text)) Return false;
    Advance(cursor);
    Return true;
}

Safe Function void Report(ParseCursor cursor, list diagnostics, SourceFile source, string title, string detail)
{
    string token = CurrentToken(cursor);
    string text = IO.Kinal.Compiler.Lex.Token.Text(token);
    int length = IO.Text.Length(text);
    If (length < 1) length = 1;
    IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Parser", title, detail,
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token), length);
}

Safe Function bool Expect(ParseCursor cursor, list diagnostics, SourceFile source,
                          int kind, string title, string detail)
{
    If (Match(cursor, kind)) Return true;
    Report(cursor, diagnostics, source, title, detail);
    Return false;
}

Safe Function bool IsNameToken(int kind)
{
    // Stage0 treats keywords as contextual names where the grammar already
    // requires a qualified-name segment, for example IO.Type.string.
    Return kind == [int](TokenKind.Identifier) ||
           (kind >= [int](TokenKind.KwUnit) && kind <= [int](TokenKind.TypeAny));
}

Safe Function bool ExpectName(ParseCursor cursor, list diagnostics, SourceFile source,
                              string detail)
{
    If (IsNameToken(CurrentKind(cursor)))
    {
        Advance(cursor);
        Return true;
    }
    Report(cursor, diagnostics, source, "Expected identifier", detail);
    Return false;
}

Safe Function bool ParseQualifiedName(ParseCursor cursor, list diagnostics, SourceFile source)
{
    If (!ExpectName(cursor, diagnostics, source,
                    "qualified name must start with an identifier")) Return false;
    While (Match(cursor, [int](TokenKind.Dot)))
    {
        If (!ExpectName(cursor, diagnostics, source,
                        "missing identifier after '.'")) Return false;
    }
    Return true;
}

Safe Function string ReadQualifiedName(ParseCursor cursor)
{
    string value = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
    Advance(cursor);
    While (Match(cursor, [int](TokenKind.Dot)))
    {
        value = value + "." + IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
        Advance(cursor);
    }
    Return value;
}

Safe Function bool SkipBalanced(ParseCursor cursor, list diagnostics, SourceFile source,
                                int openKind, int closeKind, string title)
{
    If (!Expect(cursor, diagnostics, source, openKind, title, "missing opening delimiter")) Return false;
    int depth = 1;
    While (!IsEnd(cursor) && depth > 0)
    {
        int kind = CurrentKind(cursor);
        If (kind == openKind) depth = depth + 1;
        ElseIf (kind == closeKind) depth = depth - 1;
        Advance(cursor);
    }
    If (depth != 0)
    {
        Report(cursor, diagnostics, source, title, "delimiter is not closed");
        Return false;
    }
    Return true;
}

Safe Function bool SkipExpressionStatement(ParseCursor cursor, list diagnostics, SourceFile source)
{
    int parens = 0;
    int brackets = 0;
    int braces = 0;
    While (!IsEnd(cursor))
    {
        int kind = CurrentKind(cursor);
        If (kind == [int](TokenKind.Semicolon) && parens == 0 && brackets == 0 && braces == 0)
        {
            Advance(cursor);
            Return true;
        }
        If (kind == [int](TokenKind.RightBrace) && parens == 0 && brackets == 0 && braces == 0) Break;
        If (kind == [int](TokenKind.LeftParen)) parens = parens + 1;
        ElseIf (kind == [int](TokenKind.RightParen) && parens > 0) parens = parens - 1;
        ElseIf (kind == [int](TokenKind.LeftBracket)) brackets = brackets + 1;
        ElseIf (kind == [int](TokenKind.RightBracket) && brackets > 0) brackets = brackets - 1;
        ElseIf (kind == [int](TokenKind.LeftBrace)) braces = braces + 1;
        ElseIf (kind == [int](TokenKind.RightBrace) && braces > 0) braces = braces - 1;
        Advance(cursor);
    }
    Report(cursor, diagnostics, source, "Expected semicolon", "statement must end with ';'");
    Return false;
}

Safe Function bool ParseBlock(ParseCursor cursor, list diagnostics, SourceFile source)
{
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.LeftBrace),
                "Expected left brace", "block must start with '{'")) Return false;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
    {
        If (!ParseStatement(cursor, diagnostics, source)) Return false;
    }
    Return Expect(cursor, diagnostics, source, [int](TokenKind.RightBrace),
                  "Expected right brace", "block is not closed");
}

Safe Function bool ParseIfTail(ParseCursor cursor, list diagnostics, SourceFile source)
{
    If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                      [int](TokenKind.RightParen), "Expected parentheses")) Return false;
    If (!ParseStatement(cursor, diagnostics, source)) Return false;
    If (Match(cursor, [int](TokenKind.KwElse)))
    {
        If (Match(cursor, [int](TokenKind.KwIf))) Return ParseIfTail(cursor, diagnostics, source);
        Return ParseStatement(cursor, diagnostics, source);
    }
    If (Match(cursor, [int](TokenKind.KwElseIf))) Return ParseIfTail(cursor, diagnostics, source);
    Return true;
}

Safe Function bool ParseSwitchStatement(ParseCursor cursor, list diagnostics, SourceFile source)
{
    Advance(cursor);
    If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                      [int](TokenKind.RightParen), "Expected parentheses")) Return false;
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.LeftBrace),
                "Expected left brace", "Switch body must start with '{'")) Return false;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
    {
        If (!Expect(cursor, diagnostics, source, [int](TokenKind.KwCase),
                    "Expected Case", "Switch body only accepts Case clauses")) Return false;
        If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                          [int](TokenKind.RightParen), "Expected Case matcher")) Return false;
        If (!ParseStatement(cursor, diagnostics, source)) Return false;
    }
    Return Expect(cursor, diagnostics, source, [int](TokenKind.RightBrace),
                  "Expected right brace", "Switch body is not closed");
}

Safe Function bool ParseStatement(ParseCursor cursor, list diagnostics, SourceFile source)
{
    int kind = CurrentKind(cursor);
    If (kind == [int](TokenKind.LeftBrace)) Return ParseBlock(cursor, diagnostics, source);
    If (kind == [int](TokenKind.KwIf) || kind == [int](TokenKind.KwElseIf))
    {
        Advance(cursor);
        Return ParseIfTail(cursor, diagnostics, source);
    }
    If (kind == [int](TokenKind.KwSwitch))
        Return ParseSwitchStatement(cursor, diagnostics, source);
    If (kind == [int](TokenKind.KwWhile) || kind == [int](TokenKind.KwFor) ||
        kind == [int](TokenKind.KwForeach))
    {
        Advance(cursor);
        If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                          [int](TokenKind.RightParen), "Expected parentheses")) Return false;
        Return ParseStatement(cursor, diagnostics, source);
    }
    If (kind == [int](TokenKind.KwTry))
    {
        Advance(cursor);
        If (!ParseStatement(cursor, diagnostics, source)) Return false;
        If (!Match(cursor, [int](TokenKind.KwCatch)))
        {
            Report(cursor, diagnostics, source, "Expected Catch", "Try requires Catch");
            Return false;
        }
        If (CurrentKind(cursor) == [int](TokenKind.LeftParen) &&
            !SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                          [int](TokenKind.RightParen), "Expected parentheses")) Return false;
        Return ParseStatement(cursor, diagnostics, source);
    }
    If (kind == [int](TokenKind.KwGet))
    {
        Report(cursor, diagnostics, source, "Invalid Get position", "Get is top-level only");
        Return false;
    }
    Return SkipExpressionStatement(cursor, diagnostics, source);
}

Safe Function bool IsFunctionModifier(int kind)
{
    Return kind == [int](TokenKind.KwStatic) || kind == [int](TokenKind.KwSafe) ||
           kind == [int](TokenKind.KwTrusted) || kind == [int](TokenKind.KwUnsafe) ||
           kind == [int](TokenKind.KwAsync) || kind == [int](TokenKind.KwExtern);
}

Safe Function int FindFunctionNamePosition(ParseCursor cursor, int start)
{
    int scan = start;
    While (scan + 1 < cursor.Tokens.Count())
    {
        int kind = KindAt(cursor, scan);
        If (kind == [int](TokenKind.Identifier))
        {
            int next = KindAt(cursor, scan + 1);
            If (next == [int](TokenKind.LeftParen)) Return scan;
            If (next == [int](TokenKind.Less))
            {
                int depth = 0;
                int end = scan + 1;
                While (end < cursor.Tokens.Count())
                {
                    int genericKind = KindAt(cursor, end);
                    If (genericKind == [int](TokenKind.Less)) depth = depth + 1;
                    ElseIf (genericKind == [int](TokenKind.Greater))
                    {
                        depth = depth - 1;
                        If (depth == 0) Break;
                    }
                    ElseIf (genericKind == [int](TokenKind.Semicolon) ||
                            genericKind == [int](TokenKind.LeftBrace) ||
                            genericKind == [int](TokenKind.Eof)) Break;
                    end = end + 1;
                }
                If (depth == 0 && KindAt(cursor, end + 1) == [int](TokenKind.LeftParen)) Return scan;
            }
        }
        If (kind == [int](TokenKind.Semicolon) || kind == [int](TokenKind.LeftBrace) ||
            kind == [int](TokenKind.Eof)) Break;
        scan = scan + 1;
    }
    Return -1;
}

Safe Function bool ParseTypeParameterList(ParseCursor cursor, list diagnostics, SourceFile source)
{
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.Less),
                "Expected '<'", "generic parameter list must start with '<'")) Return false;
    While (!IsEnd(cursor))
    {
        If (!Expect(cursor, diagnostics, source, [int](TokenKind.Identifier),
                    "Expected identifier", "generic type parameter requires a name")) Return false;
        If (!Match(cursor, [int](TokenKind.Comma))) Break;
    }
    Return Expect(cursor, diagnostics, source, [int](TokenKind.Greater),
                  "Expected '>'", "generic parameter list is not closed");
}

Safe Function bool ParseFunction(ParseCursor cursor, list diagnostics, SourceFile source)
{
    bool external = false;
    While (IsFunctionModifier(CurrentKind(cursor)))
    {
        If (CurrentKind(cursor) == [int](TokenKind.KwExtern)) external = true;
        Advance(cursor);
    }
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.KwFunction),
                "Expected Function", "function declaration is missing Function")) Return false;

    int namePosition = FindFunctionNamePosition(cursor, cursor.Position);
    If (namePosition < 0)
    {
        Report(cursor, diagnostics, source, "Expected function name", "missing name before parameter list");
        Return false;
    }
    cursor.Position = namePosition + 1;
    If (CurrentKind(cursor) == [int](TokenKind.Less) &&
        !ParseTypeParameterList(cursor, diagnostics, source)) Return false;
    If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                      [int](TokenKind.RightParen), "Expected parameter list")) Return false;
    If (external)
    {
        If (Match(cursor, [int](TokenKind.KwBy)) && !ParseQualifiedName(cursor, diagnostics, source)) Return false;
        Return Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                      "Expected semicolon", "Extern function must end with ';'");
    }
    If (Match(cursor, [int](TokenKind.Semicolon))) Return true;
    Return ParseBlock(cursor, diagnostics, source);
}

Safe Function bool ParseGet(ParseCursor cursor, list diagnostics, SourceFile source)
{
    Advance(cursor);
    If (!ParseQualifiedName(cursor, diagnostics, source)) Return false;
    If (Match(cursor, [int](TokenKind.LeftBrace)))
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
        {
            If (!Expect(cursor, diagnostics, source, [int](TokenKind.Identifier),
                        "Expected import name", "selective Get entries must be names")) Return false;
            If (!Match(cursor, [int](TokenKind.Comma))) Break;
        }
        If (!Expect(cursor, diagnostics, source, [int](TokenKind.RightBrace),
                    "Expected right brace", "selective Get list is not closed")) Return false;
        Return Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                      "Expected semicolon", "Get declaration must end with ';'");
    }
    If (Match(cursor, [int](TokenKind.KwBy)) && !ParseQualifiedName(cursor, diagnostics, source)) Return false;
    Return Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                  "Expected semicolon", "Get declaration must end with ';'");
}

Safe Function bool ParseDelegate(ParseCursor cursor, list diagnostics, SourceFile source)
{
    Advance(cursor);
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.KwFunction),
                "Expected Function", "Delegate declaration requires Function")) Return false;
    int namePosition = FindFunctionNamePosition(cursor, cursor.Position);
    If (namePosition < cursor.Position)
    {
        Report(cursor, diagnostics, source, "Expected delegate name",
               "Delegate declaration has no callable name");
        Return false;
    }
    cursor.Position = namePosition + 1;
    If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                      [int](TokenKind.RightParen), "Expected parameter list")) Return false;
    If (Match(cursor, [int](TokenKind.KwBy)) &&
        !ParseQualifiedName(cursor, diagnostics, source)) Return false;
    Return Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                  "Expected semicolon", "Delegate declaration must end with ';'");
}

Safe Function bool ParseAlias(ParseCursor cursor, list diagnostics, SourceFile source)
{
    Advance(cursor);
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.Identifier),
                "Expected alias name", "Alias requires a local name")) Return false;
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.KwBy),
                "Expected By", "Alias requires a target after By")) Return false;
    If (!ParseQualifiedName(cursor, diagnostics, source)) Return false;
    Return Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                  "Expected semicolon", "Alias declaration must end with ';'");
}

Safe Function bool ParseMetaTarget(ParseCursor cursor, list diagnostics, SourceFile source)
{
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.At),
                "Invalid Meta target", "Meta targets must use built-in constants such as @function"))
        Return false;
    string target = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
    If (CurrentKind(cursor) == [int](TokenKind.Identifier) &&
        (target == "function" || target == "extern_function" ||
         target == "delegate_function" || target == "class" ||
         target == "struct" || target == "enum" || target == "interface" ||
         target == "method" || target == "field"))
    {
        Advance(cursor);
        Return true;
    }
    Report(cursor, diagnostics, source, "Invalid Meta target",
           "unsupported Meta target constant");
    Return false;
}

Safe Function bool ParseMetaKeep(ParseCursor cursor, list diagnostics, SourceFile source)
{
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.At),
                "Invalid Meta keep", "Meta keep mode must use a built-in constant such as @runtime"))
        Return false;
    string keep = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
    If (CurrentKind(cursor) == [int](TokenKind.Identifier) &&
        (keep == "source" || keep == "compile" || keep == "runtime"))
    {
        Advance(cursor);
        Return true;
    }
    Report(cursor, diagnostics, source, "Invalid Meta keep",
           "supported Meta keep modes are @source, @compile, and @runtime");
    Return false;
}

Safe Function bool ParseMeta(ParseCursor cursor, list diagnostics, SourceFile source)
{
    Advance(cursor);
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.Identifier),
                "Expected identifier", "expected Meta name")) Return false;
    If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftParen),
                      [int](TokenKind.RightParen), "Expected Meta parameters")) Return false;
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.LeftBrace),
                "Expected left brace", "Meta declaration body must start with '{'")) Return false;

    bool sawOn = false;
    bool sawKeep = false;
    bool sawRepeatable = false;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
    {
        If (MatchContextual(cursor, "On"))
        {
            If (sawOn)
            {
                Report(cursor, diagnostics, source, "Duplicate Meta clause",
                       "Meta declaration can only define one On clause");
                Return false;
            }
            sawOn = true;
            While (true)
            {
                If (!ParseMetaTarget(cursor, diagnostics, source)) Return false;
                If (!Match(cursor, [int](TokenKind.Comma))) Break;
            }
            If (!Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                        "Expected semicolon", "missing ';' after Meta On clause")) Return false;
            Continue;
        }
        If (MatchContextual(cursor, "Keep"))
        {
            If (sawKeep)
            {
                Report(cursor, diagnostics, source, "Duplicate Meta clause",
                       "Meta declaration can only define one Keep clause");
                Return false;
            }
            sawKeep = true;
            If (!ParseMetaKeep(cursor, diagnostics, source)) Return false;
            If (!Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                        "Expected semicolon", "missing ';' after Meta Keep clause")) Return false;
            Continue;
        }
        If (MatchContextual(cursor, "Repeatable"))
        {
            If (sawRepeatable)
            {
                Report(cursor, diagnostics, source, "Duplicate Meta clause",
                       "Meta declaration can only define Repeatable once");
                Return false;
            }
            sawRepeatable = true;
            If (!Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                        "Expected semicolon", "missing ';' after Repeatable")) Return false;
            Continue;
        }
        Report(cursor, diagnostics, source, "Invalid Meta clause",
               "Meta body only supports On, Keep, and Repeatable clauses");
        Return false;
    }
    If (!Expect(cursor, diagnostics, source, [int](TokenKind.RightBrace),
                "Expected right brace", "Meta declaration body is not closed")) Return false;
    If (!sawOn || !sawKeep)
    {
        Report(cursor, diagnostics, source, "Missing Meta clause",
               "Meta declaration requires both On and Keep clauses");
        Return false;
    }
    Return true;
}

Safe Function bool IsTypeStart(int kind)
{
    Return kind == [int](TokenKind.KwClass) || kind == [int](TokenKind.KwInterface) ||
           kind == [int](TokenKind.KwStruct) || kind == [int](TokenKind.KwEnum) ||
           kind == [int](TokenKind.KwPublic) || kind == [int](TokenKind.KwPrivate) ||
           kind == [int](TokenKind.KwProtected) || kind == [int](TokenKind.KwInternal) ||
           kind == [int](TokenKind.KwAbstract) || kind == [int](TokenKind.KwSealed);
}

Safe Function bool IsStaticTypeStart(ParseCursor cursor)
{
    If (CurrentKind(cursor) != [int](TokenKind.KwStatic)) Return false;
    int next = KindAt(cursor, cursor.Position + 1);
    Return next == [int](TokenKind.KwClass) || next == [int](TokenKind.KwStruct) ||
           next == [int](TokenKind.KwInterface);
}

Safe Function bool ParseType(ParseCursor cursor, list diagnostics, SourceFile source)
{
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.LeftBrace)) Advance(cursor);
    Return SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftBrace),
                        [int](TokenKind.RightBrace), "Expected type body");
}

Safe Function bool IsGlobalStart(int kind)
{
    Return kind == [int](TokenKind.KwConst) || kind == [int](TokenKind.Identifier) ||
           (kind >= [int](TokenKind.TypeVoid) && kind <= [int](TokenKind.TypeAny));
}

Safe Function bool ParseGlobal(ParseCursor cursor, list diagnostics, SourceFile source)
{
    int parenDepth = 0;
    int bracketDepth = 0;
    int braceDepth = 0;
    int blockLiteralDepth = 0;
    While (!IsEnd(cursor))
    {
        int kind = CurrentKind(cursor);
        If (kind == [int](TokenKind.Semicolon) && parenDepth == 0 &&
            bracketDepth == 0 && braceDepth == 0 && blockLiteralDepth == 0)
        {
            Advance(cursor);
            Return true;
        }
        If (kind == [int](TokenKind.LeftParen)) parenDepth = parenDepth + 1;
        ElseIf (kind == [int](TokenKind.RightParen) && parenDepth > 0) parenDepth = parenDepth - 1;
        ElseIf (kind == [int](TokenKind.LeftBracket)) bracketDepth = bracketDepth + 1;
        ElseIf (kind == [int](TokenKind.RightBracket) && bracketDepth > 0) bracketDepth = bracketDepth - 1;
        ElseIf (kind == [int](TokenKind.LeftBrace)) braceDepth = braceDepth + 1;
        ElseIf (kind == [int](TokenKind.RightBrace) && braceDepth > 0) braceDepth = braceDepth - 1;
        ElseIf (kind == [int](TokenKind.KwBlock) &&
            KindAt(cursor, cursor.Position + 1) == [int](TokenKind.Less) &&
            KindAt(cursor, cursor.Position + 2) == [int](TokenKind.Slash))
            blockLiteralDepth = blockLiteralDepth + 1;
        ElseIf (kind == [int](TokenKind.Slash) && blockLiteralDepth > 0 &&
            KindAt(cursor, cursor.Position + 1) == [int](TokenKind.Greater))
            blockLiteralDepth = blockLiteralDepth - 1;
        Advance(cursor);
    }
    Report(cursor, diagnostics, source, "Expected semicolon",
           "global declaration must end with ';'");
    Return false;
}

Safe Function bool ValidatePrepared(SourceFile source, list tokens, list diagnostics)
{
    ParseCursor cursor = New ParseCursor(tokens);
    If (Match(cursor, [int](TokenKind.KwUnit)))
    {
        If (!ParseQualifiedName(cursor, diagnostics, source)) Return false;
        If (!Expect(cursor, diagnostics, source, [int](TokenKind.Semicolon),
                    "Expected semicolon", "Unit declaration must end with ';'")) Return false;
    }

    While (!IsEnd(cursor))
    {
        While (CurrentKind(cursor) == [int](TokenKind.LeftBracket))
        {
            If (!SkipBalanced(cursor, diagnostics, source, [int](TokenKind.LeftBracket),
                              [int](TokenKind.RightBracket), "Expected attribute")) Return false;
        }
        int kind = CurrentKind(cursor);
        If (IsContextual(cursor, "Meta"))
        {
            If (!ParseMeta(cursor, diagnostics, source)) Return false;
        }
        ElseIf (kind == [int](TokenKind.KwGet))
        {
            If (!ParseGet(cursor, diagnostics, source)) Return false;
        }
        ElseIf (kind == [int](TokenKind.KwAlias))
        {
            If (!ParseAlias(cursor, diagnostics, source)) Return false;
        }
        ElseIf (kind == [int](TokenKind.KwDelegate))
        {
            If (!ParseDelegate(cursor, diagnostics, source)) Return false;
        }
        ElseIf (IsStaticTypeStart(cursor))
        {
            If (!ParseType(cursor, diagnostics, source)) Return false;
        }
        ElseIf (kind == [int](TokenKind.KwFunction) || IsFunctionModifier(kind))
        {
            If (!ParseFunction(cursor, diagnostics, source)) Return false;
        }
        ElseIf (IsTypeStart(kind))
        {
            If (!ParseType(cursor, diagnostics, source)) Return false;
        }
        ElseIf (IsGlobalStart(kind))
        {
            If (!ParseGlobal(cursor, diagnostics, source)) Return false;
        }
        Else
        {
            Report(cursor, diagnostics, source, "Unexpected top-level token", "expected Get, global, Function, Class, Struct, Enum, or Interface");
            Return false;
        }
    }
    Return !IO.Kinal.Compiler.Core.Diagnostics.HasAny(diagnostics);
}

Safe Function bool Validate(SourceFile source, list tokens, list diagnostics)
{
    Return ValidatePrepared(source, PrepareTokens(tokens), diagnostics);
}

Safe Function string JoinTokenText(ParseCursor cursor, int first, int end)
{
    string result = "";
    int index = first;
    While (index < end)
    {
        string text = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, index));
        If (!IO.Text.IsEmpty(result)) result = result + " ";
        result = result + text;
        index = index + 1;
    }
    Return result;
}

Safe Function void SkipBalancedUnchecked(ParseCursor cursor, int openKind, int closeKind)
{
    If (!Match(cursor, openKind)) Return;
    int depth = 1;
    While (!IsEnd(cursor) && depth > 0)
    {
        int kind = CurrentKind(cursor);
        If (kind == openKind) depth = depth + 1;
        ElseIf (kind == closeKind) depth = depth - 1;
        Advance(cursor);
    }
}

Safe Function int BinaryPrecedence(int kind)
{
    If (kind == [int](TokenKind.Assign) || kind == [int](TokenKind.PlusAssign) ||
        kind == [int](TokenKind.MinusAssign) || kind == [int](TokenKind.StarAssign) ||
        kind == [int](TokenKind.SlashAssign) || kind == [int](TokenKind.PercentAssign)) Return 1;
    If (kind == [int](TokenKind.OrOr)) Return 3;
    If (kind == [int](TokenKind.AndAnd)) Return 4;
    If (kind == [int](TokenKind.BitOr)) Return 5;
    If (kind == [int](TokenKind.Xor)) Return 6;
    If (kind == [int](TokenKind.Ampersand)) Return 7;
    If (kind == [int](TokenKind.Equal) || kind == [int](TokenKind.NotEqual)) Return 8;
    If (kind == [int](TokenKind.Less) || kind == [int](TokenKind.LessEqual) ||
        kind == [int](TokenKind.Greater) || kind == [int](TokenKind.GreaterEqual) ||
        kind == [int](TokenKind.KwIs) || kind == [int](TokenKind.KwIn)) Return 9;
    If (kind == [int](TokenKind.ShiftLeft) || kind == [int](TokenKind.ShiftRight)) Return 10;
    If (kind == [int](TokenKind.Plus) || kind == [int](TokenKind.Minus)) Return 11;
    If (kind == [int](TokenKind.Star) || kind == [int](TokenKind.Slash) ||
        kind == [int](TokenKind.Percent)) Return 12;
    Return 0;
}

Safe Function bool IsRightAssociative(int kind)
{
    Return kind == [int](TokenKind.Assign) || kind == [int](TokenKind.PlusAssign) ||
           kind == [int](TokenKind.MinusAssign) || kind == [int](TokenKind.StarAssign) ||
           kind == [int](TokenKind.SlashAssign) || kind == [int](TokenKind.PercentAssign);
}

Safe Function ExpressionNode NewExpression(int kind, string token)
{
    Return New ExpressionNode(kind, IO.Kinal.Compiler.Lex.Token.Text(token),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
}

Safe Function void ReadArguments(ParseCursor cursor, ExpressionNode call)
{
    If (!Match(cursor, [int](TokenKind.LeftParen))) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightParen))
    {
        ExpressionNode argument = ParseExpression(cursor, 1);
        call.AddArgument(argument);
        If (!Match(cursor, [int](TokenKind.Comma))) Break;
    }
    Match(cursor, [int](TokenKind.RightParen));
}

Safe Function bool IsGenericCallArgumentList(ParseCursor cursor)
{
    If (CurrentKind(cursor) != [int](TokenKind.Less)) Return false;
    int depth = 0;
    int index = cursor.Position;
    While (index < cursor.Tokens.Count())
    {
        int kind = KindAt(cursor, index);
        If (kind == [int](TokenKind.Less)) depth = depth + 1;
        ElseIf (kind == [int](TokenKind.Greater))
        {
            depth = depth - 1;
            If (depth == 0) Return KindAt(cursor, index + 1) == [int](TokenKind.LeftParen);
        }
        ElseIf (kind == [int](TokenKind.Semicolon) || kind == [int](TokenKind.Eof)) Return false;
        index = index + 1;
    }
    Return false;
}

Safe Function void ReadTypeArguments(ParseCursor cursor, ExpressionNode call)
{
    If (!Match(cursor, [int](TokenKind.Less))) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.Greater))
    {
        int start = cursor.Position;
        string location = CurrentToken(cursor);
        int depth = 0;
        While (!IsEnd(cursor))
        {
            int kind = CurrentKind(cursor);
            If (kind == [int](TokenKind.Less)) depth = depth + 1;
            ElseIf (kind == [int](TokenKind.Greater))
            {
                If (depth == 0) Break;
                depth = depth - 1;
            }
            If (kind == [int](TokenKind.Comma) && depth == 0) Break;
            Advance(cursor);
        }
        call.AddTypeArgument(New TypeArgumentNode(
            JoinTokenText(cursor, start, cursor.Position),
            IO.Kinal.Compiler.Lex.Token.Line(location),
            IO.Kinal.Compiler.Lex.Token.Column(location)));
        If (!Match(cursor, [int](TokenKind.Comma))) Break;
    }
    Match(cursor, [int](TokenKind.Greater));
}

Safe Function ExpressionNode ParseArrayLiteral(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    Advance(cursor);
    ExpressionNode array = New ExpressionNode([int](ExpressionKind.ArrayLiteral), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
    {
        array.AddArgument(ParseExpression(cursor, 1));
        If (!Match(cursor, [int](TokenKind.Comma))) Break;
    }
    Match(cursor, [int](TokenKind.RightBrace));
    Return array;
}

Safe Function ExpressionNode ParseSwitchExpression(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    Advance(cursor);
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.Switch), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Match(cursor, [int](TokenKind.LeftParen));
    value.Left = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.RightParen));
    Match(cursor, [int](TokenKind.LeftBrace));
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
    {
        string caseToken = CurrentToken(cursor);
        If (!Match(cursor, [int](TokenKind.KwCase)))
        {
            Advance(cursor);
            Continue;
        }
        ExpressionNode item = New ExpressionNode([int](ExpressionKind.SwitchCase), "",
            IO.Kinal.Compiler.Lex.Token.Line(caseToken),
            IO.Kinal.Compiler.Lex.Token.Column(caseToken));
        Match(cursor, [int](TokenKind.LeftParen));
        If (CurrentKind(cursor) == [int](TokenKind.KwDefault))
        {
            item.Text = "default";
            Advance(cursor);
        }
        Else item.Left = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.RightParen));
        Match(cursor, [int](TokenKind.LeftBrace));
        item.Right = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.Semicolon));
        Match(cursor, [int](TokenKind.RightBrace));
        value.AddArgument(item);
    }
    Match(cursor, [int](TokenKind.RightBrace));
    Return value;
}

Safe Function ExpressionNode ParseIfExpression(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    Advance(cursor);
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.Conditional), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Match(cursor, [int](TokenKind.LeftParen));
    value.Left = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.RightParen));
    Match(cursor, [int](TokenKind.LeftBrace));
    value.Right = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.Semicolon));
    Match(cursor, [int](TokenKind.RightBrace));
    Match(cursor, [int](TokenKind.KwElse));
    Match(cursor, [int](TokenKind.LeftBrace));
    value.Third = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.Semicolon));
    Match(cursor, [int](TokenKind.RightBrace));
    Return value;
}

Safe Function ExpressionNode ParseFunctionLiteral(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    Advance(cursor);
    int typeStart = cursor.Position;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.LeftParen)) Advance(cursor);
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.FunctionLiteral),
        JoinTokenText(cursor, typeStart, cursor.Position),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    SkipBalancedUnchecked(cursor, [int](TokenKind.LeftParen), [int](TokenKind.RightParen));
    value.Body = ParseAstBlock(cursor);
    Return value;
}

Safe Function ExpressionNode ParseBlockLiteral(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    Advance(cursor);
    Match(cursor, [int](TokenKind.Less));
    Match(cursor, [int](TokenKind.Slash));
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.BlockLiteral), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    StatementNode body = New StatementNode([int](StatementKind.Block), value.Line, value.Column);
    While (!IsEnd(cursor) && !(CurrentKind(cursor) == [int](TokenKind.Slash) &&
           KindAt(cursor, cursor.Position + 1) == [int](TokenKind.Greater)))
        body.AddChild(ParseAstStatement(cursor));
    Match(cursor, [int](TokenKind.Slash));
    Match(cursor, [int](TokenKind.Greater));
    value.Body = body;
    Return value;
}

Safe Function ExpressionNode ParsePrimary(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    int kind = CurrentKind(cursor);
    If (kind == [int](TokenKind.Number))
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Number), token);
    }
    If (kind == [int](TokenKind.String) || kind == [int](TokenKind.BadString))
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.String), token);
    }
    If (kind == [int](TokenKind.Character) || kind == [int](TokenKind.BadCharacter))
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Character), token);
    }
    If (kind == [int](TokenKind.KwTrue) || kind == [int](TokenKind.KwFalse))
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Boolean), token);
    }
    If (kind == [int](TokenKind.KwNull) || kind == [int](TokenKind.KwDefault))
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Null), token);
    }
    If (kind == [int](TokenKind.Identifier) || kind == [int](TokenKind.KwThis) ||
        kind == [int](TokenKind.KwBase) ||
        (kind >= [int](TokenKind.TypeVoid) && kind <= [int](TokenKind.TypeAny)))
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Name), token);
    }
    If (kind == [int](TokenKind.LeftParen))
    {
        Advance(cursor);
        ExpressionNode nested = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.RightParen));
        Return nested;
    }
    If (kind == [int](TokenKind.LeftBrace)) Return ParseArrayLiteral(cursor);
    If (kind == [int](TokenKind.KwIf)) Return ParseIfExpression(cursor);
    If (kind == [int](TokenKind.KwSwitch)) Return ParseSwitchExpression(cursor);
    If (kind == [int](TokenKind.KwFunction)) Return ParseFunctionLiteral(cursor);
    If (kind == [int](TokenKind.KwBlock)) Return ParseBlockLiteral(cursor);
    If (kind == [int](TokenKind.LeftBracket))
    {
        Advance(cursor);
        int typeStart = cursor.Position;
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBracket)) Advance(cursor);
        string typeName = JoinTokenText(cursor, typeStart, cursor.Position);
        Match(cursor, [int](TokenKind.RightBracket));
        If (typeName == "f" &&
            (CurrentKind(cursor) == [int](TokenKind.String) ||
             CurrentKind(cursor) == [int](TokenKind.BadString)))
        {
            string formatted = CurrentToken(cursor);
            Advance(cursor);
            Return NewExpression([int](ExpressionKind.FormattedString), formatted);
        }
        ExpressionNode cast = New ExpressionNode([int](ExpressionKind.Cast), typeName,
            IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
        If (Match(cursor, [int](TokenKind.LeftParen)))
        {
            cast.Left = ParseExpression(cursor, 1);
            Match(cursor, [int](TokenKind.RightParen));
        }
        Return cast;
    }
    If (kind == [int](TokenKind.KwNew))
    {
        Advance(cursor);
        int typeStart = cursor.Position;
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.LeftParen)) Advance(cursor);
        ExpressionNode value = New ExpressionNode([int](ExpressionKind.NewObject),
            JoinTokenText(cursor, typeStart, cursor.Position),
            IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
        ReadArguments(cursor, value);
        Return value;
    }
    Advance(cursor);
    Return NewExpression([int](ExpressionKind.Missing), token);
}

Safe Function ExpressionNode ParsePostfix(ParseCursor cursor)
{
    ExpressionNode value = ParsePrimary(cursor);
    While (!IsEnd(cursor))
    {
        string token = CurrentToken(cursor);
        If (IsGenericCallArgumentList(cursor))
        {
            ExpressionNode call = New ExpressionNode([int](ExpressionKind.Call), "",
                IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
            call.Left = value;
            ReadTypeArguments(cursor, call);
            ReadArguments(cursor, call);
            value = call;
            Continue;
        }
        If (CurrentKind(cursor) == [int](TokenKind.LeftParen))
        {
            ExpressionNode call = New ExpressionNode([int](ExpressionKind.Call), "",
                IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
            call.Left = value;
            ReadArguments(cursor, call);
            value = call;
            Continue;
        }
        If (Match(cursor, [int](TokenKind.Dot)))
        {
            string memberToken = CurrentToken(cursor);
            Advance(cursor);
            ExpressionNode member = NewExpression([int](ExpressionKind.Member), memberToken);
            member.Left = value;
            value = member;
            Continue;
        }
        If (CurrentKind(cursor) == [int](TokenKind.LeftBracket))
        {
            Advance(cursor);
            ExpressionNode index = New ExpressionNode([int](ExpressionKind.Index), "",
                IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
            index.Left = value;
            index.Right = ParseExpression(cursor, 1);
            Match(cursor, [int](TokenKind.RightBracket));
            value = index;
            Continue;
        }
        If (CurrentKind(cursor) == [int](TokenKind.PlusPlus) ||
            CurrentKind(cursor) == [int](TokenKind.MinusMinus))
        {
            ExpressionNode unary = NewExpression([int](ExpressionKind.Unary), token);
            unary.Operator = CurrentKind(cursor);
            unary.IsPostfix = true;
            unary.Left = value;
            Advance(cursor);
            value = unary;
            Continue;
        }
        Break;
    }
    Return value;
}

Safe Function ExpressionNode ParseUnary(ParseCursor cursor)
{
    int kind = CurrentKind(cursor);
    If (kind == [int](TokenKind.Not) || kind == [int](TokenKind.Minus) ||
        kind == [int](TokenKind.Plus) || kind == [int](TokenKind.Tilde) ||
        kind == [int](TokenKind.Star) || kind == [int](TokenKind.Ampersand) ||
        kind == [int](TokenKind.KwAwait) || kind == [int](TokenKind.PlusPlus) ||
        kind == [int](TokenKind.MinusMinus))
    {
        string token = CurrentToken(cursor);
        Advance(cursor);
        ExpressionNode unary = NewExpression([int](ExpressionKind.Unary), token);
        unary.Operator = kind;
        unary.Left = ParseUnary(cursor);
        Return unary;
    }
    Return ParsePostfix(cursor);
}

Safe Function ExpressionNode ParseExpression(ParseCursor cursor, int minimumPrecedence)
{
    ExpressionNode left = ParseUnary(cursor);
    While (!IsEnd(cursor))
    {
        int operatorKind = CurrentKind(cursor);
        int precedence = BinaryPrecedence(operatorKind);
        If (precedence < minimumPrecedence || precedence == 0) Break;
        string operatorToken = CurrentToken(cursor);
        Advance(cursor);
        ExpressionNode binary = NewExpression([int](ExpressionKind.Binary), operatorToken);
        binary.Operator = operatorKind;
        binary.Left = left;
        int nextMinimum = IsRightAssociative(operatorKind) ? precedence : precedence + 1;
        binary.Right = ParseExpression(cursor, nextMinimum);
        left = binary;
    }
    If (minimumPrecedence <= 2 && Match(cursor, [int](TokenKind.Question)))
    {
        ExpressionNode conditional = New ExpressionNode([int](ExpressionKind.Conditional), "", left.Line, left.Column);
        conditional.Left = left;
        conditional.Right = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.Colon));
        conditional.Third = ParseExpression(cursor, 2);
        left = conditional;
    }
    Return left;
}

Safe Function SyntaxAttribute ReadAttributes(ParseCursor cursor)
{
    SyntaxAttribute first = null;
    SyntaxAttribute last = null;
    While (Match(cursor, [int](TokenKind.LeftBracket)))
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBracket))
        {
            SyntaxAttribute attribute = New SyntaxAttribute(ReadQualifiedName(cursor));
            If (Match(cursor, [int](TokenKind.LeftParen)))
            {
                While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightParen))
                {
                    attribute.AddArgument(ParseExpression(cursor, 1));
                    If (!Match(cursor, [int](TokenKind.Comma))) Break;
                }
                Match(cursor, [int](TokenKind.RightParen));
            }
            If (first == null) first = attribute;
            Else last.Next = attribute;
            last = attribute;
            If (!Match(cursor, [int](TokenKind.Comma))) Break;
        }
        Match(cursor, [int](TokenKind.RightBracket));
    }
    Return first;
}

Safe Function int FindDeclarationName(ParseCursor cursor, bool allowContextualName)
{
    int firstKind = CurrentKind(cursor);
    bool validStart = firstKind == [int](TokenKind.Identifier) ||
        (firstKind >= [int](TokenKind.TypeVoid) && firstKind <= [int](TokenKind.TypeAny));
    If (!validStart) Return -1;
    int index = cursor.Position + 1;
    While (index < cursor.Tokens.Count())
    {
        int kind = KindAt(cursor, index);
        bool contextualName = kind == [int](TokenKind.Identifier) ||
            (allowContextualName && kind >= [int](TokenKind.KwUnit) && kind <= [int](TokenKind.TypeAny));
        If (contextualName &&
            (KindAt(cursor, index + 1) == [int](TokenKind.Assign) ||
             KindAt(cursor, index + 1) == [int](TokenKind.Semicolon)) &&
            KindAt(cursor, index - 1) != [int](TokenKind.Dot)) Return index;
        If (contextualName && KindAt(cursor, index + 1) == [int](TokenKind.LeftBracket) &&
            KindAt(cursor, index - 1) != [int](TokenKind.Dot)) Return index;
        bool typeSyntax = IsNameToken(kind) ||
            kind == [int](TokenKind.Dot) || kind == [int](TokenKind.LeftBracket) ||
            kind == [int](TokenKind.RightBracket) || kind == [int](TokenKind.Star);
        If (!typeSyntax) Return -1;
        index = index + 1;
    }
    Return -1;
}

Safe Function StatementNode ParseAstBlock(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    Match(cursor, [int](TokenKind.LeftBrace));
    StatementNode block = New StatementNode([int](StatementKind.Block),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
        block.AddChild(ParseAstStatement(cursor));
    Match(cursor, [int](TokenKind.RightBrace));
    Return block;
}

Safe Function StatementNode ParseAstFor(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.For),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    Match(cursor, [int](TokenKind.LeftParen));
    If (CurrentKind(cursor) == [int](TokenKind.Semicolon))
    {
        Advance(cursor);
        value.Initializer = New StatementNode([int](StatementKind.Empty), value.Line, value.Column);
    }
    Else value.Initializer = ParseAstStatement(cursor);
    If (CurrentKind(cursor) != [int](TokenKind.Semicolon))
        value.Expression = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.Semicolon));
    If (CurrentKind(cursor) != [int](TokenKind.RightParen))
        value.SecondExpression = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.RightParen));
    value.FirstChild = ParseAstStatement(cursor);
    value.LastChild = value.FirstChild;
    Return value;
}

Safe Function StatementNode ParseAstForeach(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.Foreach),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    Match(cursor, [int](TokenKind.LeftParen));
    int declarationStart = cursor.Position;
    int separator = declarationStart;
    While (!IsEnd(cursor) && KindAt(cursor, separator) != [int](TokenKind.KwIn) &&
           KindAt(cursor, separator) != [int](TokenKind.KwIs) &&
           KindAt(cursor, separator) != [int](TokenKind.RightParen)) separator = separator + 1;
    int nameIndex = separator - 1;
    value.TypeName = JoinTokenText(cursor, declarationStart, nameIndex);
    value.Name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex));
    cursor.Position = separator;
    If (CurrentKind(cursor) == [int](TokenKind.KwIn) ||
        CurrentKind(cursor) == [int](TokenKind.KwIs)) Advance(cursor);
    value.Expression = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.RightParen));
    value.FirstChild = ParseAstStatement(cursor);
    value.LastChild = value.FirstChild;
    Return value;
}

Safe Function StatementNode ParseAstSwitch(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.Switch),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    Match(cursor, [int](TokenKind.LeftParen));
    value.Expression = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.RightParen));
    Match(cursor, [int](TokenKind.LeftBrace));
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
    {
        string caseToken = CurrentToken(cursor);
        If (!Match(cursor, [int](TokenKind.KwCase)))
        {
            Advance(cursor);
            Continue;
        }
        StatementNode item = New StatementNode([int](StatementKind.Case),
            IO.Kinal.Compiler.Lex.Token.Line(caseToken),
            IO.Kinal.Compiler.Lex.Token.Column(caseToken));
        Match(cursor, [int](TokenKind.LeftParen));
        If (CurrentKind(cursor) == [int](TokenKind.KwDefault))
        {
            item.Name = "default";
            Advance(cursor);
        }
        Else item.Expression = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.RightParen));
        item.FirstChild = ParseAstBlock(cursor);
        item.LastChild = item.FirstChild;
        value.AddChild(item);
    }
    Match(cursor, [int](TokenKind.RightBrace));
    Return value;
}

Safe Function StatementNode ParseAstTry(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.Try),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    value.FirstChild = ParseAstStatement(cursor);
    value.LastChild = value.FirstChild;
    If (Match(cursor, [int](TokenKind.KwCatch)))
    {
        StatementNode handler = New StatementNode([int](StatementKind.Try), value.Line, value.Column);
        If (Match(cursor, [int](TokenKind.LeftParen)))
        {
            int start = cursor.Position;
            While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightParen)) Advance(cursor);
            int end = cursor.Position;
            int nameIndex = -1;
            int scan = start;
            While (scan < end)
            {
                If (KindAt(cursor, scan) == [int](TokenKind.Identifier) &&
                    KindAt(cursor, scan - 1) != [int](TokenKind.Dot)) nameIndex = scan;
                scan = scan + 1;
            }
            If (nameIndex >= start)
            {
                handler.TypeName = JoinTokenText(cursor, start, nameIndex);
                handler.Name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex));
            }
            Match(cursor, [int](TokenKind.RightParen));
        }
        handler.FirstChild = ParseAstStatement(cursor);
        handler.LastChild = handler.FirstChild;
        value.ElseBranch = handler;
    }
    Return value;
}

Safe Function StatementNode ParseAstUnsafeBlock(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.UnsafeBlock),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    Match(cursor, [int](TokenKind.KwBlock));
    value.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
    Advance(cursor);
    Match(cursor, [int](TokenKind.Less));
    Match(cursor, [int](TokenKind.Slash));
    While (!IsEnd(cursor) &&
           !(CurrentKind(cursor) == [int](TokenKind.Slash) &&
             KindAt(cursor, cursor.Position + 1) == [int](TokenKind.Greater)))
        value.AddChild(ParseAstStatement(cursor));
    Match(cursor, [int](TokenKind.Slash));
    Match(cursor, [int](TokenKind.Greater));
    Return value;
}

Safe Function StatementNode ParseAstStatement(ParseCursor cursor)
{
    string token = CurrentToken(cursor);
    int kind = CurrentKind(cursor);
    int line = IO.Kinal.Compiler.Lex.Token.Line(token);
    int column = IO.Kinal.Compiler.Lex.Token.Column(token);
    If (kind == [int](TokenKind.LeftBrace)) Return ParseAstBlock(cursor);
    If (kind == [int](TokenKind.Semicolon))
    {
        Advance(cursor);
        Return New StatementNode([int](StatementKind.Empty), line, column);
    }
    If (kind == [int](TokenKind.KwReturn))
    {
        Advance(cursor);
        StatementNode value = New StatementNode([int](StatementKind.Return), line, column);
        If (CurrentKind(cursor) != [int](TokenKind.Semicolon)) value.Expression = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.Semicolon));
        Return value;
    }
    If (kind == [int](TokenKind.KwIf) || kind == [int](TokenKind.KwElseIf))
    {
        Advance(cursor);
        StatementNode value = New StatementNode([int](StatementKind.If), line, column);
        Match(cursor, [int](TokenKind.LeftParen));
        value.Expression = ParseExpression(cursor, 1);
        If (value.Expression != null && value.Expression.Kind == [int](ExpressionKind.Binary) &&
            value.Expression.Operator == [int](TokenKind.KwIs) &&
            CurrentKind(cursor) == [int](TokenKind.Identifier))
        {
            value.Expression.Third = NewExpression([int](ExpressionKind.Name), CurrentToken(cursor));
            Advance(cursor);
        }
        Match(cursor, [int](TokenKind.RightParen));
        value.FirstChild = ParseAstStatement(cursor);
        If (Match(cursor, [int](TokenKind.KwElse)))
        {
            value.ElseBranch = ParseAstStatement(cursor);
        }
        ElseIf (CurrentKind(cursor) == [int](TokenKind.KwElseIf)) value.ElseBranch = ParseAstStatement(cursor);
        Return value;
    }
    If (kind == [int](TokenKind.KwWhile))
    {
        Advance(cursor);
        StatementNode value = New StatementNode([int](StatementKind.While), line, column);
        Match(cursor, [int](TokenKind.LeftParen));
        value.Expression = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.RightParen));
        value.FirstChild = ParseAstStatement(cursor);
        Return value;
    }
    If (kind == [int](TokenKind.KwFor)) Return ParseAstFor(cursor);
    If (kind == [int](TokenKind.KwForeach)) Return ParseAstForeach(cursor);
    If (kind == [int](TokenKind.KwSwitch)) Return ParseAstSwitch(cursor);
    If (kind == [int](TokenKind.KwTry)) Return ParseAstTry(cursor);
    If (kind == [int](TokenKind.KwThrow))
    {
        Advance(cursor);
        StatementNode value = New StatementNode([int](StatementKind.Throw), line, column);
        If (CurrentKind(cursor) != [int](TokenKind.Semicolon)) value.Expression = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.Semicolon));
        Return value;
    }
    If (kind == [int](TokenKind.KwUnsafe) &&
        KindAt(cursor, cursor.Position + 1) == [int](TokenKind.KwBlock))
        Return ParseAstUnsafeBlock(cursor);
    If (kind == [int](TokenKind.KwRecord))
    {
        Advance(cursor);
        StatementNode value = New StatementNode([int](StatementKind.Record), line, column);
        value.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
        Advance(cursor);
        If (CurrentKind(cursor) == [int](TokenKind.LeftBrace))
        {
            value.FirstChild = ParseAstBlock(cursor);
            value.LastChild = value.FirstChild;
        }
        Return value;
    }
    If (kind == [int](TokenKind.KwJump))
    {
        Advance(cursor);
        StatementNode value = New StatementNode([int](StatementKind.Jump), line, column);
        If (CurrentKind(cursor) == [int](TokenKind.Identifier) &&
            KindAt(cursor, cursor.Position + 1) == [int](TokenKind.Semicolon))
        {
            value.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
            Advance(cursor);
        }
        Else value.Expression = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.Semicolon));
        Return value;
    }
    If (kind == [int](TokenKind.KwBreak) || kind == [int](TokenKind.KwContinue))
    {
        Advance(cursor);
        Match(cursor, [int](TokenKind.Semicolon));
        Return New StatementNode(kind == [int](TokenKind.KwBreak) ?
            [int](StatementKind.Break) : [int](StatementKind.Continue), line, column);
    }
    If (kind == [int](TokenKind.KwVar))
    {
        Advance(cursor);
        StatementNode declaration = New StatementNode([int](StatementKind.Variable), line, column);
        declaration.TypeName = "Var";
        declaration.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
        Advance(cursor);
        If (Match(cursor, [int](TokenKind.Assign))) declaration.Expression = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.Semicolon));
        Return declaration;
    }
    int declarationName = FindDeclarationName(cursor, false);
    If (declarationName > cursor.Position)
    {
        StatementNode declaration = New StatementNode([int](StatementKind.Variable), line, column);
        declaration.TypeName = JoinTokenText(cursor, cursor.Position, declarationName);
        declaration.Name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, declarationName));
        cursor.Position = declarationName + 1;
        // C-style local arrays place dimensions after the variable name.
        // Normalize the type to the canonical T[] form while preserving the
        // outer fixed length for backend allocation.
        While (Match(cursor, [int](TokenKind.LeftBracket)))
        {
            If (CurrentKind(cursor) != [int](TokenKind.RightBracket) &&
                declaration.SecondExpression == null)
                declaration.SecondExpression = ParseExpression(cursor, 1);
            ElseIf (CurrentKind(cursor) != [int](TokenKind.RightBracket))
                ParseExpression(cursor, 1);
            Match(cursor, [int](TokenKind.RightBracket));
            declaration.TypeName = declaration.TypeName + "[]";
        }
        If (Match(cursor, [int](TokenKind.Assign))) declaration.Expression = ParseExpression(cursor, 1);
        Match(cursor, [int](TokenKind.Semicolon));
        Return declaration;
    }
    int start = cursor.Position;
    StatementNode expression = New StatementNode([int](StatementKind.Expression), line, column);
    expression.Expression = ParseExpression(cursor, 1);
    If (cursor.Position == start) Advance(cursor);
    Match(cursor, [int](TokenKind.Semicolon));
    Return expression;
}

Safe Function int AccessFromModifier(int kind)
{
    If (kind == [int](TokenKind.KwPublic)) Return 1;
    If (kind == [int](TokenKind.KwPrivate)) Return 2;
    If (kind == [int](TokenKind.KwProtected)) Return 3;
    If (kind == [int](TokenKind.KwInternal)) Return 4;
    Return 0;
}

Safe Function FunctionDecl ReadFunctionNode(ParseCursor cursor, bool constructor,
                                             bool isStatic, bool isAsync, bool isExtern, int safety)
{
    string declarationToken = CurrentToken(cursor);
    If (constructor)
    {
        Advance(cursor);
        FunctionDecl value = New FunctionDecl("Constructor", "void",
            IO.Kinal.Compiler.Lex.Token.Line(declarationToken),
            IO.Kinal.Compiler.Lex.Token.Column(declarationToken));
        value.IsConstructor = true;
        value.IsStatic = isStatic;
        value.IsAsync = isAsync;
        value.IsExtern = isExtern;
        value.Safety = safety;
        ReadParameters(cursor, value);
        If (!Match(cursor, [int](TokenKind.Semicolon))) value.Body = ParseAstBlock(cursor);
        Return value;
    }

    Advance(cursor);
    int returnStart = cursor.Position;
    int nameIndex = FindFunctionNamePosition(cursor, returnStart);
    If (nameIndex < returnStart)
    {
        string invalidToken = RawAt(cursor, returnStart);
        FunctionDecl invalid = New FunctionDecl("", "",
            IO.Kinal.Compiler.Lex.Token.Line(invalidToken),
            IO.Kinal.Compiler.Lex.Token.Column(invalidToken));
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.Semicolon) &&
               CurrentKind(cursor) != [int](TokenKind.LeftBrace)) Advance(cursor);
        If (!Match(cursor, [int](TokenKind.Semicolon)))
            SkipBalancedUnchecked(cursor, [int](TokenKind.LeftBrace), [int](TokenKind.RightBrace));
        Return invalid;
    }
    string nameToken = RawAt(cursor, nameIndex);
    FunctionDecl value = New FunctionDecl(
        IO.Kinal.Compiler.Lex.Token.Text(nameToken), JoinTokenText(cursor, returnStart, nameIndex),
        IO.Kinal.Compiler.Lex.Token.Line(nameToken), IO.Kinal.Compiler.Lex.Token.Column(nameToken));
    value.IsStatic = isStatic;
    value.IsAsync = isAsync;
    value.IsExtern = isExtern;
    value.Safety = safety;
    cursor.Position = nameIndex + 1;
    If (Match(cursor, [int](TokenKind.Less)))
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.Greater))
        {
            string parameterToken = CurrentToken(cursor);
            value.AddTypeParameter(New TypeParameterDecl(
                IO.Kinal.Compiler.Lex.Token.Text(parameterToken),
                IO.Kinal.Compiler.Lex.Token.Line(parameterToken),
                IO.Kinal.Compiler.Lex.Token.Column(parameterToken)));
            Advance(cursor);
            If (!Match(cursor, [int](TokenKind.Comma))) Break;
        }
        Match(cursor, [int](TokenKind.Greater));
    }
    ReadParameters(cursor, value);
    If (Match(cursor, [int](TokenKind.KwBy))) value.Abi = ReadQualifiedName(cursor);
    If (!Match(cursor, [int](TokenKind.Semicolon))) value.Body = ParseAstBlock(cursor);
    Return value;
}

Safe Function void ReadTypeMembers(ParseCursor cursor, TypeDecl type)
{
    If (type.Kind == [int](TokenKind.KwEnum))
    {
        If (!Match(cursor, [int](TokenKind.LeftBrace))) Return;
        int ordinal = 0;
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
        {
            string nameToken = CurrentToken(cursor);
            Advance(cursor);
            EnumMemberDecl member = New EnumMemberDecl(
                IO.Kinal.Compiler.Lex.Token.Text(nameToken), ordinal);
            If (Match(cursor, [int](TokenKind.Assign))) member.Value = ParseExpression(cursor, 1);
            type.AddEnumMember(member);
            ordinal = ordinal + 1;
            If (!Match(cursor, [int](TokenKind.Comma))) Break;
        }
        Match(cursor, [int](TokenKind.RightBrace));
        Return;
    }
    If (!Match(cursor, [int](TokenKind.LeftBrace))) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
    {
        SyntaxAttribute attributes = ReadAttributes(cursor);
        int access = 0;
        bool isStatic = false;
        bool isAsync = false;
        bool isExtern = false;
        int safety = 0;
        bool readingModifiers = true;
        While (readingModifiers)
        {
            int modifier = CurrentKind(cursor);
            int modifierAccess = AccessFromModifier(modifier);
            If (modifierAccess != 0)
            {
                access = modifierAccess;
                Advance(cursor);
            }
            ElseIf (modifier == [int](TokenKind.KwStatic))
            {
                isStatic = true;
                Advance(cursor);
            }
            ElseIf (modifier == [int](TokenKind.KwAsync))
            {
                isAsync = true;
                Advance(cursor);
            }
            ElseIf (modifier == [int](TokenKind.KwExtern))
            {
                isExtern = true;
                Advance(cursor);
            }
            ElseIf (modifier == [int](TokenKind.KwSafe))
            {
                safety = 1;
                Advance(cursor);
            }
            ElseIf (modifier == [int](TokenKind.KwTrusted))
            {
                safety = 2;
                Advance(cursor);
            }
            ElseIf (modifier == [int](TokenKind.KwUnsafe))
            {
                safety = 3;
                Advance(cursor);
            }
            Else
            {
                readingModifiers = false;
            }
        }

        If (CurrentKind(cursor) == [int](TokenKind.KwConstructor))
        {
            FunctionDecl constructor = ReadFunctionNode(cursor, true, isStatic, isAsync, isExtern, safety);
            constructor.IsStatic = constructor.IsStatic || type.IsStatic;
            constructor.FirstAttribute = attributes;
            type.AddMethod(constructor);
            Continue;
        }
        If (CurrentKind(cursor) == [int](TokenKind.KwFunction))
        {
            FunctionDecl method = ReadFunctionNode(cursor, false, isStatic, isAsync, isExtern, safety);
            If (method.ReturnType == "" && method.Name == type.Name)
            {
                method.Name = "Constructor";
                method.ReturnType = "void";
                method.IsConstructor = true;
            }
            method.IsStatic = method.IsStatic || type.IsStatic;
            method.FirstAttribute = attributes;
            type.AddMethod(method);
            Continue;
        }

        int fieldStart = cursor.Position;
        int fieldName = FindDeclarationName(cursor, true);
        If (fieldName > fieldStart)
        {
            string nameToken = RawAt(cursor, fieldName);
            FieldDecl field = New FieldDecl(IO.Kinal.Compiler.Lex.Token.Text(nameToken),
                JoinTokenText(cursor, fieldStart, fieldName),
                IO.Kinal.Compiler.Lex.Token.Line(nameToken), IO.Kinal.Compiler.Lex.Token.Column(nameToken));
            field.Access = access;
            field.IsStatic = isStatic || type.IsStatic;
            field.FirstAttribute = attributes;
            cursor.Position = fieldName + 1;
            If (Match(cursor, [int](TokenKind.Assign))) field.Initializer = ParseExpression(cursor, 1);
            Match(cursor, [int](TokenKind.Semicolon));
            type.AddField(field);
            Continue;
        }

        Advance(cursor);
    }
    Match(cursor, [int](TokenKind.RightBrace));
}

Safe Function void ReadParameters(ParseCursor cursor, FunctionDecl function)
{
    If (!Match(cursor, [int](TokenKind.LeftParen))) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightParen))
    {
        int start = cursor.Position;
        int comma = start;
        While (KindAt(cursor, comma) != [int](TokenKind.Comma) &&
               KindAt(cursor, comma) != [int](TokenKind.RightParen) &&
               KindAt(cursor, comma) != [int](TokenKind.Eof)) comma = comma + 1;
        int declarationEnd = comma;
        int assign = start;
        While (assign < comma && KindAt(cursor, assign) != [int](TokenKind.Assign))
            assign = assign + 1;
        If (assign < comma) declarationEnd = assign;
        int nameIndex = -1;
        int scan = start;
        While (scan < declarationEnd)
        {
            int kind = KindAt(cursor, scan);
            int next = KindAt(cursor, scan + 1);
            If (kind == [int](TokenKind.Identifier) &&
                KindAt(cursor, scan - 1) != [int](TokenKind.Dot) &&
                (scan + 1 == declarationEnd || next == [int](TokenKind.LeftBracket)))
            {
                nameIndex = scan;
                Break;
            }
            scan = scan + 1;
        }
        If (nameIndex >= start)
        {
            string name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex));
            string typeName = JoinTokenText(cursor, start, nameIndex);
            If (nameIndex + 1 < declarationEnd)
                typeName = typeName + " " + JoinTokenText(cursor, nameIndex + 1, declarationEnd);
            ParameterDecl parameter = New ParameterDecl(name, typeName);
            If (assign < comma)
            {
                cursor.Position = assign + 1;
                parameter.DefaultValue = ParseExpression(cursor, 1);
            }
            function.AddParameter(parameter);
        }
        cursor.Position = comma;
        If (!Match(cursor, [int](TokenKind.Comma))) Break;
    }
    Match(cursor, [int](TokenKind.RightParen));
}

Safe Function FieldDecl ReadGlobalNode(ParseCursor cursor, SyntaxAttribute attributes)
{
    bool isConst = Match(cursor, [int](TokenKind.KwConst));
    int declarationStart = cursor.Position;
    int declarationName = FindDeclarationName(cursor, true);
    If (declarationName <= declarationStart) Return null;
    string nameToken = RawAt(cursor, declarationName);
    FieldDecl global = New FieldDecl(IO.Kinal.Compiler.Lex.Token.Text(nameToken),
        JoinTokenText(cursor, declarationStart, declarationName),
        IO.Kinal.Compiler.Lex.Token.Line(nameToken), IO.Kinal.Compiler.Lex.Token.Column(nameToken));
    global.IsConst = isConst;
    global.FirstAttribute = attributes;
    cursor.Position = declarationName + 1;
    If (Match(cursor, [int](TokenKind.Assign))) global.Initializer = ParseExpression(cursor, 1);
    Match(cursor, [int](TokenKind.Semicolon));
    Return global;
}

Safe Function SyntaxTree Build(SourceFile source, list tokens, list diagnostics)
{
    list preparedTokens = PrepareTokens(tokens);
    If (!ValidatePrepared(source, preparedTokens, diagnostics)) Return null;
    ParseCursor cursor = New ParseCursor(preparedTokens);
    string unitName = "";
    If (Match(cursor, [int](TokenKind.KwUnit)))
    {
        unitName = ReadQualifiedName(cursor);
        Match(cursor, [int](TokenKind.Semicolon));
    }
    SyntaxTree tree = New SyntaxTree(source, unitName);

    While (!IsEnd(cursor))
    {
        SyntaxAttribute attributes = ReadAttributes(cursor);
        int kind = CurrentKind(cursor);
        If (IsContextual(cursor, "Meta"))
        {
            Advance(cursor);
            Advance(cursor);
            SkipBalancedUnchecked(cursor, [int](TokenKind.LeftParen), [int](TokenKind.RightParen));
            SkipBalancedUnchecked(cursor, [int](TokenKind.LeftBrace), [int](TokenKind.RightBrace));
            Continue;
        }
        If (kind == [int](TokenKind.KwGet))
        {
            string location = CurrentToken(cursor);
            Advance(cursor);
            string name = ReadQualifiedName(cursor);
            If (Match(cursor, [int](TokenKind.LeftBrace)))
            {
                While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.RightBrace))
                {
                    string memberToken = CurrentToken(cursor);
                    string member = IO.Kinal.Compiler.Lex.Token.Text(memberToken);
                    Advance(cursor);
                    tree.AddImport(New ImportDecl(member, name + "." + member,
                        IO.Kinal.Compiler.Lex.Token.Line(memberToken),
                        IO.Kinal.Compiler.Lex.Token.Column(memberToken)));
                    If (!Match(cursor, [int](TokenKind.Comma))) Break;
                }
                Match(cursor, [int](TokenKind.RightBrace));
                Match(cursor, [int](TokenKind.Semicolon));
                Continue;
            }
            string target = name;
            If (Match(cursor, [int](TokenKind.KwBy))) target = ReadQualifiedName(cursor);
            Match(cursor, [int](TokenKind.Semicolon));
            tree.AddImport(New ImportDecl(name, target,
                IO.Kinal.Compiler.Lex.Token.Line(location), IO.Kinal.Compiler.Lex.Token.Column(location)));
            Continue;
        }
        If (kind == [int](TokenKind.KwAlias))
        {
            string location = CurrentToken(cursor);
            Advance(cursor);
            string name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
            Advance(cursor);
            Match(cursor, [int](TokenKind.KwBy));
            string target = ReadQualifiedName(cursor);
            Match(cursor, [int](TokenKind.Semicolon));
            tree.AddImport(New ImportDecl(name, target,
                IO.Kinal.Compiler.Lex.Token.Line(location), IO.Kinal.Compiler.Lex.Token.Column(location)));
            Continue;
        }
        If (kind == [int](TokenKind.KwDelegate))
        {
            Advance(cursor);
            FunctionDecl delegate = ReadFunctionNode(cursor, false, false, false, false, 0);
            delegate.IsDelegate = true;
            delegate.FirstAttribute = attributes;
            tree.AddFunction(delegate);
            Continue;
        }

        If (IsGlobalStart(kind))
        {
            FieldDecl global = ReadGlobalNode(cursor, attributes);
            If (global != null)
            {
                tree.AddGlobal(global);
                Continue;
            }
        }

        bool isStatic = false;
        bool isAsync = false;
        bool isExtern = false;
        int safety = 0;
        While (IsFunctionModifier(CurrentKind(cursor)))
        {
            int modifier = CurrentKind(cursor);
            If (modifier == [int](TokenKind.KwStatic)) isStatic = true;
            If (modifier == [int](TokenKind.KwAsync)) isAsync = true;
            If (modifier == [int](TokenKind.KwExtern)) isExtern = true;
            If (modifier == [int](TokenKind.KwSafe)) safety = 1;
            If (modifier == [int](TokenKind.KwTrusted)) safety = 2;
            If (modifier == [int](TokenKind.KwUnsafe)) safety = 3;
            Advance(cursor);
        }
        If (CurrentKind(cursor) == [int](TokenKind.KwFunction))
        {
            FunctionDecl function = ReadFunctionNode(cursor, false, isStatic, isAsync, isExtern, safety);
            function.FirstAttribute = attributes;
            tree.AddFunction(function);
            Continue;
        }

        If (!IsTypeStart(CurrentKind(cursor)))
        {
            // Validation already reported structural errors. Keep AST construction
            // forward-progressing if an expression parser leaves a recovery token.
            Advance(cursor);
            Continue;
        }

        While (CurrentKind(cursor) == [int](TokenKind.KwPublic) ||
               CurrentKind(cursor) == [int](TokenKind.KwPrivate) ||
               CurrentKind(cursor) == [int](TokenKind.KwProtected) ||
               CurrentKind(cursor) == [int](TokenKind.KwInternal) ||
               CurrentKind(cursor) == [int](TokenKind.KwAbstract) ||
               CurrentKind(cursor) == [int](TokenKind.KwSealed)) Advance(cursor);
        int typeKind = CurrentKind(cursor);
        Advance(cursor);
        string typeNameToken = CurrentToken(cursor);
        string typeName = IO.Kinal.Compiler.Lex.Token.Text(typeNameToken);
        Advance(cursor);
        While (!IsEnd(cursor) && CurrentKind(cursor) != [int](TokenKind.LeftBrace)) Advance(cursor);
        TypeDecl type = New TypeDecl(typeKind, typeName,
            IO.Kinal.Compiler.Lex.Token.Line(typeNameToken), IO.Kinal.Compiler.Lex.Token.Column(typeNameToken));
        type.IsStatic = isStatic;
        type.FirstAttribute = attributes;
        ReadTypeMembers(cursor, type);
        tree.AddType(type);
    }
    Return tree;
}

Unit IO.Kinal.Compiler.Syntax.Parser;

Get IO.Text;
Get IO.Kinal.Compiler.Core.Diagnostics;
Get IO.Kinal.Compiler.Source.SourceFile;
Get IO.Kinal.Compiler.Lex.Lexer;
Get IO.Kinal.Compiler.Lex.Token;
Get IO.Kinal.Compiler.Lex.TokenKind;
Get IO.Kinal.Compiler.Syntax.SyntaxTree;
Get IO.Kinal.Compiler.Syntax.Nodes;

Class ParseCursor
{
    Public list Tokens;
    Public int Position;
    Public SourceFile Source;
    Public list Diagnostics;
    Public int StatementDepth;
    Public bool SawStatementDepthLimit;
    Public int PackageLiteralDepth;
    Public int BlockLiteralDepth;
    Public int NextAnonymousFunctionId;
    Public int NextBlockId;

    Public Safe Constructor(list tokens, SourceFile source, list diagnostics)
    {
        This.Tokens = tokens;
        This.Position = 0;
        This.Source = source;
        This.Diagnostics = diagnostics;
        This.StatementDepth = 0;
        This.SawStatementDepthLimit = false;
        This.PackageLiteralDepth = 0;
        This.BlockLiteralDepth = 0;
        This.NextAnonymousFunctionId = 0;
        This.NextBlockId = 0;
    }
}

Class UnsafeAliasRule
{
    Public list SourceTokens;
    Public list TargetTokens;
    Public UnsafeAliasRule Next;

    Public Safe Constructor()
    {
        This.SourceTokens = list.Create();
        This.TargetTokens = list.Create();
        This.Next = null;
    }

    Public Safe Function bool Matches(list tokens, int position)
    {
        If (position + This.SourceTokens.Count() > tokens.Count()) Return false;
        int i = 0;
        While (i < This.SourceTokens.Count())
        {
            Token expected = [Token](This.SourceTokens.Fetch(i));
            Token actual = [Token](tokens.Fetch(position + i));
            If (IO.Kinal.Compiler.Lex.Token.Kind(expected) !=
                    IO.Kinal.Compiler.Lex.Token.Kind(actual) ||
                IO.Kinal.Compiler.Lex.Token.Text(expected) !=
                    IO.Kinal.Compiler.Lex.Token.Text(actual)) Return false;
            i = i + 1;
        }
        Return true;
    }
}

Class PreparedTokenStream
{
    Public list Tokens;
    Public bool HasUnsafeAlias;
    Public bool HasPreparationError;

    Public Safe Constructor(list tokens, bool hasUnsafeAlias, bool hasPreparationError)
    {
        This.Tokens = tokens;
        This.HasUnsafeAlias = hasUnsafeAlias;
        This.HasPreparationError = hasPreparationError;
    }
}

Safe Function Token ListTokenAt(list tokens, int index)
{
    If (index < 0 || index >= tokens.Count()) Return null;
    Return [Token](tokens.Fetch(index));
}

Safe Function TokenKind ListTokenKindAt(list tokens, int index)
{
    Return IO.Kinal.Compiler.Lex.Token.Kind(ListTokenAt(tokens, index));
}

Safe Function void ReportToken(list diagnostics, SourceFile source, Token token,
                               string title, string detail)
{
    string text = IO.Kinal.Compiler.Lex.Token.Text(token);
    int length = IO.Text.Length(text);
    If (length < 1) length = 1;
    IO.Kinal.Compiler.Core.Diagnostics.Add(diagnostics, source, "Parser", title, detail,
        IO.Kinal.Compiler.Lex.Token.Line(token),
        IO.Kinal.Compiler.Lex.Token.Column(token), length);
}

Safe Function void ReportWarningToken(list diagnostics, SourceFile source, Token token,
                                      string title, string detail)
{
    string text = IO.Kinal.Compiler.Lex.Token.Text(token);
    int length = IO.Text.Length(text);
    If (length < 1) length = 1;
    IO.Kinal.Compiler.Core.Diagnostics.AddWarning(diagnostics, source, "Parser",
        title, detail, IO.Kinal.Compiler.Lex.Token.Line(token),
        IO.Kinal.Compiler.Lex.Token.Column(token), length);
}

Safe Function bool IsUnsafeAliasLiteral(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.Number) { true; }
        Case(TokenKind.String) { true; }
        Case(TokenKind.Character) { true; }
        Case(TokenKind.KwTrue) { true; }
        Case(TokenKind.KwFalse) { true; }
        Case(TokenKind.KwNull) { true; }
        Case(default) { false; }
    };
}

Safe Function bool IsUnsafeAliasOperatorOrPunctuation(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.LeftParen) { true; }
        Case(TokenKind.RightParen) { true; }
        Case(TokenKind.LeftBrace) { true; }
        Case(TokenKind.RightBrace) { true; }
        Case(TokenKind.LeftBracket) { true; }
        Case(TokenKind.RightBracket) { true; }
        Case(TokenKind.Comma) { true; }
        Case(TokenKind.Semicolon) { true; }
        Case(TokenKind.Dot) { true; }
        Case(TokenKind.Colon) { true; }
        Case(TokenKind.Question) { true; }
        Case(TokenKind.At) { true; }
        Case(TokenKind.Plus) { true; }
        Case(TokenKind.Minus) { true; }
        Case(TokenKind.Star) { true; }
        Case(TokenKind.Slash) { true; }
        Case(TokenKind.Percent) { true; }
        Case(TokenKind.Assign) { true; }
        Case(TokenKind.PlusPlus) { true; }
        Case(TokenKind.MinusMinus) { true; }
        Case(TokenKind.PlusAssign) { true; }
        Case(TokenKind.MinusAssign) { true; }
        Case(TokenKind.StarAssign) { true; }
        Case(TokenKind.SlashAssign) { true; }
        Case(TokenKind.PercentAssign) { true; }
        Case(TokenKind.Equal) { true; }
        Case(TokenKind.NotEqual) { true; }
        Case(TokenKind.Less) { true; }
        Case(TokenKind.LessEqual) { true; }
        Case(TokenKind.Greater) { true; }
        Case(TokenKind.GreaterEqual) { true; }
        Case(TokenKind.AndAnd) { true; }
        Case(TokenKind.OrOr) { true; }
        Case(TokenKind.Not) { true; }
        Case(TokenKind.Ampersand) { true; }
        Case(TokenKind.BitOr) { true; }
        Case(TokenKind.Xor) { true; }
        Case(TokenKind.ShiftLeft) { true; }
        Case(TokenKind.ShiftRight) { true; }
        Case(TokenKind.Tilde) { true; }
        Case(default) { false; }
    };
}

Safe Function bool CanUseUnsafeAliasSource(TokenKind kind, bool allowTokens)
{
    If (kind == TokenKind.Identifier || IsUnsafeAliasLiteral(kind) ||
        IsKeywordToken(kind) || IsPrimitiveTypeToken(kind)) Return true;
    Return allowTokens && IsUnsafeAliasOperatorOrPunctuation(kind);
}

Safe Function bool CanUseUnsafeAliasTarget(TokenKind kind, bool allowTokens)
{
    If (IsUnsafeAliasLiteral(kind) || IsKeywordToken(kind) ||
        IsPrimitiveTypeToken(kind)) Return true;
    Return allowTokens && IsUnsafeAliasOperatorOrPunctuation(kind);
}

Safe Function bool IsUnsafeAliasTerminator(list tokens, int position)
{
    If (ListTokenKindAt(tokens, position) != TokenKind.Semicolon) Return false;
    If (position + 1 >= tokens.Count()) Return true;
    If (ListTokenKindAt(tokens, position + 1) == TokenKind.Eof) Return true;
    Return IO.Kinal.Compiler.Lex.Token.Line(ListTokenAt(tokens, position + 1)) !=
        IO.Kinal.Compiler.Lex.Token.Line(ListTokenAt(tokens, position));
}

Safe Function PreparedTokenStream PrepareTokens(SourceFile source, list tokens, list diagnostics)
{
    UnsafeAliasRule firstRule = null;
    bool hasUnsafeAlias = false;
    bool preparationError = false;
    int position = 0;
    While (position < tokens.Count())
    {
        bool triple = ListTokenKindAt(tokens, position) == TokenKind.KwUnsafe &&
            ListTokenKindAt(tokens, position + 1) == TokenKind.KwUnsafe &&
            ListTokenKindAt(tokens, position + 2) == TokenKind.KwUnsafe &&
            ListTokenKindAt(tokens, position + 3) == TokenKind.KwAlias;
        bool keyword = ListTokenKindAt(tokens, position) == TokenKind.KwUnsafe &&
            ListTokenKindAt(tokens, position + 1) == TokenKind.KwAlias;
        If (!triple && !keyword) Break;
        hasUnsafeAlias = true;

        int sourceStart = position + (triple ? 4 : 2);
        UnsafeAliasRule rule = New UnsafeAliasRule();
        position = sourceStart;
        bool invalid = false;
        If (triple)
        {
            Token firstSource = ListTokenAt(tokens, position);
            While (position < tokens.Count() &&
                   ListTokenKindAt(tokens, position) != TokenKind.KwBy)
            {
                If (!CanUseUnsafeAliasSource(ListTokenKindAt(tokens, position), true))
                {
                    ReportToken(diagnostics, source, ListTokenAt(tokens, position),
                        "Invalid Unsafe Alias",
                        "Unsafe Unsafe Unsafe Alias requires token/literal/keyword source pieces");
                    preparationError = true;
                    invalid = true;
                    Break;
                }
                rule.SourceTokens.Add(ListTokenAt(tokens, position));
                position = position + 1;
            }
            If (invalid) Break;
            If (rule.SourceTokens.Count() == 0)
            {
                ReportToken(diagnostics, source, firstSource, "Invalid Unsafe Alias",
                    "Unsafe Unsafe Unsafe Alias requires a token/literal/keyword source");
                preparationError = true;
                Break;
            }
            If (ListTokenKindAt(tokens, position) != TokenKind.KwBy)
            {
                ReportToken(diagnostics, source, ListTokenAt(tokens, position),
                    "Expected By", "Unsafe Alias requires 'By'");
                preparationError = true;
                Break;
            }
            position = position + 1;
            While (position < tokens.Count() &&
                   !IsUnsafeAliasTerminator(tokens, position))
            {
                If (!CanUseUnsafeAliasTarget(ListTokenKindAt(tokens, position), true))
                {
                    ReportToken(diagnostics, source, ListTokenAt(tokens, position),
                        "Invalid Unsafe Alias",
                        "Unsafe Unsafe Unsafe Alias requires token/literal/keyword target pieces");
                    preparationError = true;
                    invalid = true;
                    Break;
                }
                rule.TargetTokens.Add(ListTokenAt(tokens, position));
                position = position + 1;
            }
            If (invalid) Break;
            If (rule.TargetTokens.Count() == 0)
            {
                ReportToken(diagnostics, source, ListTokenAt(tokens, position),
                    "Invalid Unsafe Alias",
                    "Unsafe Unsafe Unsafe Alias requires a token/literal/keyword target");
                preparationError = true;
                Break;
            }
        }
        Else
        {
            Token sourceToken = ListTokenAt(tokens, position);
            position = position + 1;
            If (!CanUseUnsafeAliasSource(IO.Kinal.Compiler.Lex.Token.Kind(sourceToken), false))
            {
                ReportToken(diagnostics, source, sourceToken, "Invalid Unsafe Alias",
                    "Unsafe Alias only supports keyword or literal aliases");
                preparationError = true;
                Break;
            }
            rule.SourceTokens.Add(sourceToken);
            If (ListTokenKindAt(tokens, position) != TokenKind.KwBy)
            {
                ReportToken(diagnostics, source, ListTokenAt(tokens, position),
                    "Expected By", "Unsafe Alias requires 'By'");
                preparationError = true;
                Break;
            }
            position = position + 1;
            Token targetToken = ListTokenAt(tokens, position);
            position = position + 1;
            If (!CanUseUnsafeAliasTarget(IO.Kinal.Compiler.Lex.Token.Kind(targetToken), false))
            {
                ReportToken(diagnostics, source, targetToken, "Invalid Unsafe Alias",
                    "Unsafe Alias only supports keyword or literal targets");
                preparationError = true;
                Break;
            }
            rule.TargetTokens.Add(targetToken);
        }
        If (ListTokenKindAt(tokens, position) != TokenKind.Semicolon)
        {
            ReportToken(diagnostics, source, ListTokenAt(tokens, position),
                "Expected Semicolon", "Missing ';' after Unsafe Alias");
            preparationError = true;
            Break;
        }
        position = position + 1;

        // C stage0 resolves overlapping aliases from the most recently
        // declared rule to the oldest rule.
        rule.Next = firstRule;
        firstRule = rule;
    }

    If (!hasUnsafeAlias) Return New PreparedTokenStream(tokens, false, false);
    list prepared = list.Create();
    While (position < tokens.Count())
    {
        UnsafeAliasRule match = firstRule;
        While (match != null && !match.Matches(tokens, position)) match = match.Next;
        If (match == null)
        {
            prepared.Add(ListTokenAt(tokens, position));
            position = position + 1;
            Continue;
        }

        Token sourceToken = ListTokenAt(tokens, position);
        int targetIndex = 0;
        While (targetIndex < match.TargetTokens.Count())
        {
            Token targetToken = [Token](match.TargetTokens.Fetch(targetIndex));
            prepared.Add(IO.Kinal.Compiler.Lex.Token.Create(
                IO.Kinal.Compiler.Lex.Token.Kind(targetToken),
                IO.Kinal.Compiler.Lex.Token.Text(targetToken),
                IO.Kinal.Compiler.Lex.Token.Line(sourceToken),
                IO.Kinal.Compiler.Lex.Token.Column(sourceToken)));
            targetIndex = targetIndex + 1;
        }
        position = position + match.SourceTokens.Count();
    }
    If (prepared.Count() == 0 ||
        ListTokenKindAt(prepared, prepared.Count() - 1) != TokenKind.Eof)
        prepared.Add(ListTokenAt(tokens, tokens.Count() - 1));
    Return New PreparedTokenStream(prepared, hasUnsafeAlias, preparationError);
}

Safe Function Token RawAt(ParseCursor cursor, int index)
{
    If (index < 0 || index >= cursor.Tokens.Count()) Return null;
    Return [Token](cursor.Tokens.Fetch(index));
}

Safe Function TokenKind KindAt(ParseCursor cursor, int index)
{
    Return IO.Kinal.Compiler.Lex.Token.Kind(RawAt(cursor, index));
}

Safe Function TokenKind CurrentKind(ParseCursor cursor)
{
    Return KindAt(cursor, cursor.Position);
}

Safe Function Token CurrentToken(ParseCursor cursor)
{
    Return RawAt(cursor, cursor.Position);
}

Safe Function bool IsEnd(ParseCursor cursor)
{
    Return CurrentKind(cursor) == TokenKind.Eof;
}

Safe Function void Advance(ParseCursor cursor)
{
    If (cursor.Position < cursor.Tokens.Count()) cursor.Position = cursor.Position + 1;
}

Safe Function bool Match(ParseCursor cursor, TokenKind kind)
{
    If (CurrentKind(cursor) != kind) Return false;
    Advance(cursor);
    Return true;
}

Safe Function bool IsContextual(ParseCursor cursor, string text)
{
    Return CurrentKind(cursor) == TokenKind.Identifier &&
           IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor)) == text;
}

Safe Function bool MatchContextual(ParseCursor cursor, string text)
{
    If (!IsContextual(cursor, text)) Return false;
    Advance(cursor);
    Return true;
}

Safe Function void Report(ParseCursor cursor, list diagnostics, SourceFile source, string title, string detail)
{
    ReportToken(diagnostics, source, CurrentToken(cursor), title, detail);
}

Safe Function bool IsStatementRecoveryStart(TokenKind kind)
{
    Return kind == TokenKind.KwReturn || kind == TokenKind.KwIf ||
        kind == TokenKind.KwSwitch || kind == TokenKind.KwFor ||
        kind == TokenKind.KwWhile || kind == TokenKind.KwBreak ||
        kind == TokenKind.KwContinue ||
        kind == TokenKind.KwTry || kind == TokenKind.KwThrow ||
        kind == TokenKind.KwConst || kind == TokenKind.KwVar ||
        kind == TokenKind.KwBlock || kind == TokenKind.KwClass ||
        kind == TokenKind.KwStruct || kind == TokenKind.KwEnum ||
        kind == TokenKind.KwInterface || kind == TokenKind.KwFunction ||
        kind == TokenKind.KwExtern || kind == TokenKind.KwGet ||
        kind == TokenKind.Identifier || IsPrimitiveTypeToken(kind);
}

Safe Function void RecoverAfterExpect(ParseCursor cursor, TokenKind expected)
{
    If (IsEnd(cursor)) Return;
    If (expected == TokenKind.Semicolon)
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Semicolon &&
               CurrentKind(cursor) != TokenKind.RightBrace &&
               !IsStatementRecoveryStart(CurrentKind(cursor)))
            Advance(cursor);
        Match(cursor, TokenKind.Semicolon);
        Return;
    }
    If (expected == TokenKind.RightParen)
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen &&
               CurrentKind(cursor) != TokenKind.Semicolon &&
               CurrentKind(cursor) != TokenKind.LeftBrace &&
               CurrentKind(cursor) != TokenKind.RightBrace)
            Advance(cursor);
        Match(cursor, TokenKind.RightParen);
        Return;
    }
    If (expected == TokenKind.RightBracket)
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBracket &&
               CurrentKind(cursor) != TokenKind.Semicolon &&
               CurrentKind(cursor) != TokenKind.RightBrace)
            Advance(cursor);
        Match(cursor, TokenKind.RightBracket);
        Return;
    }
    If (expected == TokenKind.RightBrace)
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
            Advance(cursor);
        Match(cursor, TokenKind.RightBrace);
        Return;
    }
    Advance(cursor);
}

Safe Function bool BuilderExpect(ParseCursor cursor, TokenKind kind,
                                 string title, string detail)
{
    Return Expect(cursor, cursor.Diagnostics, cursor.Source, kind, title, detail);
}

Safe Function bool Expect(ParseCursor cursor, list diagnostics, SourceFile source,
                          TokenKind kind, string title, string detail)
{
    If (Match(cursor, kind)) Return true;
    Report(cursor, diagnostics, source, title, detail);
    RecoverAfterExpect(cursor, kind);
    Return false;
}

Safe Function bool IsTopLevelRecoveryStart(TokenKind kind)
{
    Return kind == TokenKind.KwEnum || kind == TokenKind.KwStruct ||
        kind == TokenKind.KwInterface || kind == TokenKind.KwClass ||
        kind == TokenKind.KwPublic || kind == TokenKind.KwPrivate ||
        kind == TokenKind.KwProtected || kind == TokenKind.KwInternal ||
        kind == TokenKind.KwStatic || kind == TokenKind.KwAbstract ||
        kind == TokenKind.KwSealed || kind == TokenKind.KwConst ||
        kind == TokenKind.KwVar || kind == TokenKind.Less ||
        kind == TokenKind.KwExtern || kind == TokenKind.KwDelegate ||
        kind == TokenKind.KwFunction || kind == TokenKind.KwSafe ||
        kind == TokenKind.KwTrusted || kind == TokenKind.KwUnsafe ||
        kind == TokenKind.KwAsync || kind == TokenKind.KwGet ||
        kind == TokenKind.KwUnit;
}

Safe Function bool IsTypeMemberRecoveryStart(TokenKind kind)
{
    Return kind == TokenKind.LeftBracket || kind == TokenKind.KwConstructor ||
        kind == TokenKind.KwFunction || kind == TokenKind.KwProperty ||
        kind == TokenKind.KwClass || kind == TokenKind.KwInterface ||
        kind == TokenKind.KwStruct || kind == TokenKind.KwEnum ||
        kind == TokenKind.KwPublic || kind == TokenKind.KwPrivate ||
        kind == TokenKind.KwProtected || kind == TokenKind.KwInternal ||
        kind == TokenKind.KwStatic || kind == TokenKind.KwAbstract ||
        kind == TokenKind.KwVirtual || kind == TokenKind.KwOverride ||
        kind == TokenKind.KwSealed || kind == TokenKind.KwSafe ||
        kind == TokenKind.KwTrusted || kind == TokenKind.KwUnsafe ||
        kind == TokenKind.KwAsync || kind == TokenKind.KwExtern ||
        kind == TokenKind.Identifier || kind == TokenKind.Less ||
        IsPrimitiveTypeToken(kind);
}

Safe Function void SynchronizeTopLevel(ParseCursor cursor, int startPosition, int startLine)
{
    While (!IsEnd(cursor))
    {
        TokenKind kind = CurrentKind(cursor);
        If (kind == TokenKind.Semicolon)
        {
            Advance(cursor);
            Return;
        }
        If (cursor.Position > startPosition &&
            (IsTopLevelRecoveryStart(kind) ||
             (IO.Kinal.Compiler.Lex.Token.Line(CurrentToken(cursor)) > startLine &&
              IO.Kinal.Compiler.Lex.Token.Column(CurrentToken(cursor)) == 1))) Return;
        Advance(cursor);
    }
}

Safe Function void SynchronizeTypeMember(ParseCursor cursor, int startPosition)
{
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
    {
        If (CurrentKind(cursor) == TokenKind.Semicolon)
        {
            Advance(cursor);
            Return;
        }
        If (cursor.Position > startPosition &&
            IsTypeMemberRecoveryStart(CurrentKind(cursor))) Return;
        Advance(cursor);
    }
}

Safe Function void SynchronizeStatement(ParseCursor cursor, int startPosition)
{
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
    {
        If (CurrentKind(cursor) == TokenKind.Semicolon)
        {
            Advance(cursor);
            Return;
        }
        If (cursor.Position > startPosition &&
            IsStatementRecoveryStart(CurrentKind(cursor))) Return;
        Advance(cursor);
    }
}

Safe Function void SkipToEnclosingBlockEnd(ParseCursor cursor)
{
    int nestedBraces = 0;
    While (!IsEnd(cursor))
    {
        TokenKind kind = CurrentKind(cursor);
        If (kind == TokenKind.LeftBrace)
        {
            nestedBraces = nestedBraces + 1;
            Advance(cursor);
            Continue;
        }
        If (kind == TokenKind.RightBrace)
        {
            If (nestedBraces == 0) Return;
            nestedBraces = nestedBraces - 1;
            Advance(cursor);
            Continue;
        }
        Advance(cursor);
    }
}

Safe Function bool EnterStatement(ParseCursor cursor)
{
    cursor.StatementDepth = cursor.StatementDepth + 1;
    If (cursor.StatementDepth <= 192) Return true;
    If (!cursor.SawStatementDepthLimit)
    {
        cursor.SawStatementDepthLimit = true;
        Report(cursor, cursor.Diagnostics, cursor.Source, "Statement Too Deep",
            "Statement nesting exceeds parser recursion limit");
    }
    SkipToEnclosingBlockEnd(cursor);
    cursor.StatementDepth = cursor.StatementDepth - 1;
    Return false;
}

Safe Function void LeaveStatement(ParseCursor cursor)
{
    If (cursor.StatementDepth > 0)
        cursor.StatementDepth = cursor.StatementDepth - 1;
}

Safe Function bool IsPrimitiveTypeToken(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.TypeVoid) { true; }
        Case(TokenKind.TypeBool) { true; }
        Case(TokenKind.TypeByte) { true; }
        Case(TokenKind.TypeChar) { true; }
        Case(TokenKind.TypeInt) { true; }
        Case(TokenKind.TypeFloat) { true; }
        Case(TokenKind.TypeF16) { true; }
        Case(TokenKind.TypeF32) { true; }
        Case(TokenKind.TypeF64) { true; }
        Case(TokenKind.TypeF128) { true; }
        Case(TokenKind.TypeI8) { true; }
        Case(TokenKind.TypeI16) { true; }
        Case(TokenKind.TypeI32) { true; }
        Case(TokenKind.TypeI64) { true; }
        Case(TokenKind.TypeU8) { true; }
        Case(TokenKind.TypeU16) { true; }
        Case(TokenKind.TypeU32) { true; }
        Case(TokenKind.TypeU64) { true; }
        Case(TokenKind.TypeIsize) { true; }
        Case(TokenKind.TypeUsize) { true; }
        Case(TokenKind.TypeString) { true; }
        Case(TokenKind.TypeAny) { true; }
        Case(default) { false; }
    };
}

Safe Function bool IsKeywordToken(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.KwUnit) { true; }
        Case(TokenKind.KwGet) { true; }
        Case(TokenKind.KwSet) { true; }
        Case(TokenKind.KwAlias) { true; }
        Case(TokenKind.KwBy) { true; }
        Case(TokenKind.KwProperty) { true; }
        Case(TokenKind.KwFunction) { true; }
        Case(TokenKind.KwReturn) { true; }
        Case(TokenKind.KwIf) { true; }
        Case(TokenKind.KwElse) { true; }
        Case(TokenKind.KwElseIf) { true; }
        Case(TokenKind.KwWhile) { true; }
        Case(TokenKind.KwFor) { true; }
        Case(TokenKind.KwForeach) { true; }
        Case(TokenKind.KwSwitch) { true; }
        Case(TokenKind.KwCase) { true; }
        Case(TokenKind.KwBreak) { true; }
        Case(TokenKind.KwContinue) { true; }
        Case(TokenKind.KwTry) { true; }
        Case(TokenKind.KwCatch) { true; }
        Case(TokenKind.KwThrow) { true; }
        Case(TokenKind.KwConst) { true; }
        Case(TokenKind.KwVar) { true; }
        Case(TokenKind.KwSafe) { true; }
        Case(TokenKind.KwTrusted) { true; }
        Case(TokenKind.KwUnsafe) { true; }
        Case(TokenKind.KwAsync) { true; }
        Case(TokenKind.KwAwait) { true; }
        Case(TokenKind.KwExtern) { true; }
        Case(TokenKind.KwClass) { true; }
        Case(TokenKind.KwInterface) { true; }
        Case(TokenKind.KwStruct) { true; }
        Case(TokenKind.KwEnum) { true; }
        Case(TokenKind.KwPublic) { true; }
        Case(TokenKind.KwPrivate) { true; }
        Case(TokenKind.KwProtected) { true; }
        Case(TokenKind.KwInternal) { true; }
        Case(TokenKind.KwStatic) { true; }
        Case(TokenKind.KwVirtual) { true; }
        Case(TokenKind.KwOverride) { true; }
        Case(TokenKind.KwAbstract) { true; }
        Case(TokenKind.KwSealed) { true; }
        Case(TokenKind.KwConstructor) { true; }
        Case(TokenKind.KwNew) { true; }
        Case(TokenKind.KwThis) { true; }
        Case(TokenKind.KwBase) { true; }
        Case(TokenKind.KwBlock) { true; }
        Case(TokenKind.KwRecord) { true; }
        Case(TokenKind.KwJump) { true; }
        Case(TokenKind.KwDelegate) { true; }
        Case(TokenKind.KwTrue) { true; }
        Case(TokenKind.KwFalse) { true; }
        Case(TokenKind.KwIs) { true; }
        Case(TokenKind.KwIn) { true; }
        Case(TokenKind.KwDefault) { true; }
        Case(TokenKind.KwNull) { true; }
        Case(default) { false; }
    };
}

Safe Function bool IsNameToken(TokenKind kind)
{
    // Stage0 treats keywords as contextual names where the grammar already
    // requires a qualified-name segment, for example IO.Type.string.
    Return kind == TokenKind.Identifier || IsKeywordToken(kind) ||
           IsPrimitiveTypeToken(kind);
}

Safe Function string ReadQualifiedName(ParseCursor cursor)
{
    If (!IsNameToken(CurrentKind(cursor)))
    {
        Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Identifier",
            "Expected name");
        RecoverAfterExpect(cursor, TokenKind.Identifier);
        Return "";
    }
    string value = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
    Advance(cursor);
    While (Match(cursor, TokenKind.Dot))
    {
        If (!IsNameToken(CurrentKind(cursor)))
        {
            Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Identifier",
                "Expected name");
            RecoverAfterExpect(cursor, TokenKind.Identifier);
            Return value;
        }
        value = value + "." + IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
        Advance(cursor);
    }
    Return value;
}

Safe Function bool IsFunctionModifier(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.KwStatic) { true; }
        Case(TokenKind.KwSafe) { true; }
        Case(TokenKind.KwTrusted) { true; }
        Case(TokenKind.KwUnsafe) { true; }
        Case(TokenKind.KwAsync) { true; }
        Case(TokenKind.KwExtern) { true; }
        Case(default) { false; }
    };
}

Safe Function int FindFunctionNamePosition(ParseCursor cursor, int start)
{
    int scan = start;
    While (scan + 1 < cursor.Tokens.Count())
    {
        TokenKind kind = KindAt(cursor, scan);
        If (kind == TokenKind.Identifier)
        {
            TokenKind next = KindAt(cursor, scan + 1);
            If (next == TokenKind.LeftParen) Return scan;
            If (next == TokenKind.Less)
            {
                int depth = 0;
                int end = scan + 1;
                While (end < cursor.Tokens.Count())
                {
                    TokenKind genericKind = KindAt(cursor, end);
                    If (genericKind == TokenKind.Less) depth = depth + 1;
                    ElseIf (genericKind == TokenKind.Greater)
                    {
                        depth = depth - 1;
                        If (depth == 0) Break;
                    }
                    ElseIf (genericKind == TokenKind.Semicolon ||
                            genericKind == TokenKind.LeftBrace ||
                            genericKind == TokenKind.Eof) Break;
                    end = end + 1;
                }
                If (depth == 0 && KindAt(cursor, end + 1) == TokenKind.LeftParen) Return scan;
            }
        }
        If (kind == TokenKind.Semicolon || kind == TokenKind.LeftBrace ||
            kind == TokenKind.Eof) Break;
        scan = scan + 1;
    }
    Return -1;
}

Safe Function bool IsTypeStart(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.KwClass) { true; }
        Case(TokenKind.KwInterface) { true; }
        Case(TokenKind.KwStruct) { true; }
        Case(TokenKind.KwEnum) { true; }
        Case(TokenKind.KwPublic) { true; }
        Case(TokenKind.KwPrivate) { true; }
        Case(TokenKind.KwProtected) { true; }
        Case(TokenKind.KwInternal) { true; }
        Case(TokenKind.KwAbstract) { true; }
        Case(TokenKind.KwSealed) { true; }
        Case(default) { false; }
    };
}

Safe Function bool IsGlobalStart(TokenKind kind)
{
    Return kind == TokenKind.KwConst || kind == TokenKind.Identifier ||
           IsPrimitiveTypeToken(kind);
}

Safe Function bool Validate(SourceFile source, list tokens, list diagnostics)
{
    Return Build(source, tokens, diagnostics) != null;
}

Safe Function string JoinTokenText(ParseCursor cursor, int first, int end)
{
    string result = "";
    int index = first;
    While (index < end)
    {
        string text = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, index));
        If (!IO.Text.IsEmpty(result)) result = result + " ";
        result = result + text;
        index = index + 1;
    }
    Return result;
}

Safe Function void SkipBalancedUnchecked(ParseCursor cursor, TokenKind openKind, TokenKind closeKind)
{
    If (!Match(cursor, openKind)) Return;
    int depth = 1;
    While (!IsEnd(cursor) && depth > 0)
    {
        TokenKind kind = CurrentKind(cursor);
        If (kind == openKind) depth = depth + 1;
        ElseIf (kind == closeKind) depth = depth - 1;
        Advance(cursor);
    }
}

Safe Function int BinaryPrecedence(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.Assign) { 1; }
        Case(TokenKind.PlusAssign) { 1; }
        Case(TokenKind.MinusAssign) { 1; }
        Case(TokenKind.StarAssign) { 1; }
        Case(TokenKind.SlashAssign) { 1; }
        Case(TokenKind.PercentAssign) { 1; }
        Case(TokenKind.OrOr) { 3; }
        Case(TokenKind.AndAnd) { 4; }
        Case(TokenKind.BitOr) { 5; }
        Case(TokenKind.Xor) { 6; }
        Case(TokenKind.Ampersand) { 7; }
        Case(TokenKind.Equal) { 8; }
        Case(TokenKind.NotEqual) { 8; }
        Case(TokenKind.Less) { 9; }
        Case(TokenKind.LessEqual) { 9; }
        Case(TokenKind.Greater) { 9; }
        Case(TokenKind.GreaterEqual) { 9; }
        Case(TokenKind.KwIs) { 9; }
        Case(TokenKind.KwIn) { 9; }
        Case(TokenKind.ShiftLeft) { 10; }
        Case(TokenKind.ShiftRight) { 10; }
        Case(TokenKind.Plus) { 11; }
        Case(TokenKind.Minus) { 11; }
        Case(TokenKind.Star) { 12; }
        Case(TokenKind.Slash) { 12; }
        Case(TokenKind.Percent) { 12; }
        Case(default) { 0; }
    };
}

Safe Function bool IsRightAssociative(TokenKind kind)
{
    Return kind == TokenKind.Assign || kind == TokenKind.PlusAssign ||
           kind == TokenKind.MinusAssign || kind == TokenKind.StarAssign ||
           kind == TokenKind.SlashAssign || kind == TokenKind.PercentAssign;
}

Safe Function ExpressionNode NewExpression(int kind, Token token)
{
    Return New ExpressionNode(kind, IO.Kinal.Compiler.Lex.Token.Text(token),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
}

Safe Function void ReadArguments(ParseCursor cursor, ExpressionNode call)
{
    If (!BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                       "Missing '(' before argument list")) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen)
    {
        ExpressionNode argument = ParseExpression(cursor, 1);
        call.AddArgument(argument);
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Missing ')' after argument list");
}

Safe Function bool IsGenericCallArgumentList(ParseCursor cursor)
{
    If (CurrentKind(cursor) != TokenKind.Less) Return false;
    int depth = 0;
    int index = cursor.Position;
    While (index < cursor.Tokens.Count())
    {
        TokenKind kind = KindAt(cursor, index);
        If (kind == TokenKind.Less) depth = depth + 1;
        ElseIf (kind == TokenKind.Greater)
        {
            depth = depth - 1;
            If (depth == 0) Return KindAt(cursor, index + 1) == TokenKind.LeftParen;
        }
        ElseIf (kind == TokenKind.Semicolon || kind == TokenKind.Eof) Return false;
        index = index + 1;
    }
    Return false;
}

Safe Function void ReadTypeArguments(ParseCursor cursor, ExpressionNode call)
{
    If (!BuilderExpect(cursor, TokenKind.Less, "Expected '<'",
                       "Missing '<' before generic type arguments")) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Greater)
    {
        int start = cursor.Position;
        Token location = CurrentToken(cursor);
        int depth = 0;
        While (!IsEnd(cursor))
        {
            TokenKind kind = CurrentKind(cursor);
            If (kind == TokenKind.Less) depth = depth + 1;
            ElseIf (kind == TokenKind.Greater)
            {
                If (depth == 0) Break;
                depth = depth - 1;
            }
            If (kind == TokenKind.Comma && depth == 0) Break;
            Advance(cursor);
        }
        call.AddTypeArgument(New TypeArgumentNode(
            JoinTokenText(cursor, start, cursor.Position),
            IO.Kinal.Compiler.Lex.Token.Line(location),
            IO.Kinal.Compiler.Lex.Token.Column(location)));
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    BuilderExpect(cursor, TokenKind.Greater, "Expected '>'",
        "Missing '>' after generic type arguments");
}

Safe Function ExpressionNode ParseArrayLiteral(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    ExpressionNode collection = New ExpressionNode([int](ExpressionKind.ArrayLiteral), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
    {
        ExpressionNode first = ParseExpression(cursor, 1);
        If (Match(cursor, TokenKind.Colon))
        {
            collection.Kind = [int](ExpressionKind.DictLiteral);
            ExpressionNode entry = New ExpressionNode([int](ExpressionKind.DictEntry), "",
                first.Line, first.Column);
            entry.Left = first;
            entry.Right = ParseExpression(cursor, 1);
            collection.AddArgument(entry);
        }
        Else collection.AddArgument(first);
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
        "Array or dictionary literal is not closed");
    Return collection;
}

Safe Function ExpressionNode ParsePackageLiteral(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    ExpressionNode package = New ExpressionNode([int](ExpressionKind.PackageLiteral), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    If (CurrentKind(cursor) == TokenKind.Greater)
        Report(cursor, cursor.Diagnostics, cursor.Source, "Invalid Package Literal",
            "Empty Package literal is not supported");
    cursor.PackageLiteralDepth = cursor.PackageLiteralDepth + 1;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Greater)
    {
        package.AddArgument(ParseExpression(cursor, 1));
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    cursor.PackageLiteralDepth = cursor.PackageLiteralDepth - 1;
    BuilderExpect(cursor, TokenKind.Greater, "Expected '>'",
        "Package literal is not closed");
    Return package;
}

Safe Function ExpressionNode ParseSwitchExpression(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.Switch), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
        "Switch expression requires a selector");
    value.Left = ParseExpression(cursor, 1);
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Switch selector is not closed");
    BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
        "Switch expression body is missing");
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
    {
        Token caseToken = CurrentToken(cursor);
        If (!Match(cursor, TokenKind.KwCase))
        {
            Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Case",
                "Switch expression body only accepts Case clauses");
            Advance(cursor);
            Continue;
        }
        ExpressionNode item = New ExpressionNode([int](ExpressionKind.SwitchCase), "",
            IO.Kinal.Compiler.Lex.Token.Line(caseToken),
            IO.Kinal.Compiler.Lex.Token.Column(caseToken));
        BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
            "Case matcher is missing");
        If (CurrentKind(cursor) == TokenKind.KwDefault)
        {
            item.Text = "default";
            Advance(cursor);
        }
        Else item.Left = ParseExpression(cursor, 1);
        BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
            "Case matcher is not closed");
        BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
            "Case expression body is missing");
        item.Right = ParseExpression(cursor, 1);
        Match(cursor, TokenKind.Semicolon);
        BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
            "Case expression body is not closed");
        value.AddArgument(item);
    }
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
        "Switch expression body is not closed");
    Return value;
}

Safe Function ExpressionNode ParseIfExpression(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.Conditional), "",
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
        "If expression requires a condition");
    value.Left = ParseExpression(cursor, 1);
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "If expression condition is not closed");
    BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
        "If expression true branch is missing");
    value.Right = ParseExpression(cursor, 1);
    Match(cursor, TokenKind.Semicolon);
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
        "If expression true branch is not closed");
    BuilderExpect(cursor, TokenKind.KwElse, "Expected Else",
        "If expression requires an Else branch");
    BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
        "If expression Else branch is missing");
    value.Third = ParseExpression(cursor, 1);
    Match(cursor, TokenKind.Semicolon);
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
        "If expression Else branch is not closed");
    Return value;
}

Safe Function int FindParameterDeclarationEnd(ParseCursor cursor, int start)
{
    int parenDepth = 0;
    int bracketDepth = 0;
    int braceDepth = 0;
    int angleDepth = 0;
    int index = start;
    While (index < cursor.Tokens.Count())
    {
        TokenKind kind = KindAt(cursor, index);
        bool topLevel = parenDepth == 0 && bracketDepth == 0 &&
            braceDepth == 0 && angleDepth == 0;
        If (topLevel && (kind == TokenKind.Assign ||
                         kind == TokenKind.Comma ||
                         kind == TokenKind.RightParen ||
                         kind == TokenKind.LeftBrace ||
                         kind == TokenKind.RightBrace ||
                         kind == TokenKind.Semicolon ||
                         kind == TokenKind.Eof)) Return index;

        If (kind == TokenKind.LeftParen) parenDepth = parenDepth + 1;
        ElseIf (kind == TokenKind.RightParen && parenDepth > 0)
            parenDepth = parenDepth - 1;
        ElseIf (kind == TokenKind.LeftBracket) bracketDepth = bracketDepth + 1;
        ElseIf (kind == TokenKind.RightBracket && bracketDepth > 0)
            bracketDepth = bracketDepth - 1;
        ElseIf (kind == TokenKind.LeftBrace) braceDepth = braceDepth + 1;
        ElseIf (kind == TokenKind.RightBrace && braceDepth > 0)
            braceDepth = braceDepth - 1;
        ElseIf (kind == TokenKind.Less) angleDepth = angleDepth + 1;
        ElseIf (kind == TokenKind.Greater && angleDepth > 0)
            angleDepth = angleDepth - 1;
        index = index + 1;
    }
    Return index;
}

Safe Function int FindParameterName(ParseCursor cursor, int start, int declarationEnd)
{
    int nameIndex = -1;
    int scan = start;
    While (scan < declarationEnd)
    {
        TokenKind kind = KindAt(cursor, scan);
        TokenKind next = KindAt(cursor, scan + 1);
        If (kind == TokenKind.Identifier &&
            KindAt(cursor, scan - 1) != TokenKind.Dot &&
            (scan + 1 == declarationEnd || next == TokenKind.LeftBracket))
        {
            nameIndex = scan;
            Break;
        }
        scan = scan + 1;
    }
    Return nameIndex;
}

Safe Function void WarnLegacyArraySuffixes(ParseCursor cursor, int start, int end)
{
    int index = start;
    While (index < end)
    {
        If (KindAt(cursor, index) == TokenKind.LeftBracket)
            ReportWarningToken(cursor.Diagnostics, cursor.Source, RawAt(cursor, index),
                "Legacy Array Syntax",
                "Use 'Type[] name' instead of 'Type name[]'");
        index = index + 1;
    }
}

Safe Function string ReadLegacyArrayTypeSuffixes(ParseCursor cursor, string typeName)
{
    While (Match(cursor, TokenKind.LeftBracket))
    {
        ReportWarningToken(cursor.Diagnostics, cursor.Source,
            RawAt(cursor, cursor.Position - 1), "Legacy Array Syntax",
            "Use 'Type[] name' instead of 'Type name[]'");
        int start = cursor.Position;
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBracket)
            Advance(cursor);
        string length = JoinTokenText(cursor, start, cursor.Position);
        BuilderExpect(cursor, TokenKind.RightBracket, "Expected ']'",
            "Array declarator is not closed");
        typeName = typeName + "[" + length + "]";
    }
    Return typeName;
}

Safe Function ExpressionNode ParseFunctionLiteral(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    int typeStart = cursor.Position;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.LeftParen) Advance(cursor);
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.FunctionLiteral),
        JoinTokenText(cursor, typeStart, cursor.Position),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    value.LiteralId = cursor.NextAnonymousFunctionId;
    cursor.NextAnonymousFunctionId = cursor.NextAnonymousFunctionId + 1;
    If (!BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                       "Anonymous function parameter list is missing")) Return value;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen)
    {
        int parameterStart = cursor.Position;
        int parameterEnd = FindParameterDeclarationEnd(cursor, parameterStart);
        int nameIndex = FindParameterName(cursor, parameterStart, parameterEnd);
        If (nameIndex >= parameterStart)
        {
            Token nameToken = RawAt(cursor, nameIndex);
            ExpressionNode parameter = New ExpressionNode([int](ExpressionKind.Name),
                IO.Kinal.Compiler.Lex.Token.Text(nameToken),
                IO.Kinal.Compiler.Lex.Token.Line(nameToken),
                IO.Kinal.Compiler.Lex.Token.Column(nameToken));
            parameter.Left = New ExpressionNode([int](ExpressionKind.Name),
                JoinTokenText(cursor, parameterStart, nameIndex), parameter.Line, parameter.Column);
            value.AddArgument(parameter);
        }
        cursor.Position = parameterEnd;
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Anonymous function parameter list is not closed");
    value.Body = ParseAstBlock(cursor);
    Return value;
}

Safe Function ExpressionNode ParseBlockLiteral(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    string blockName = "";
    If (CurrentKind(cursor) == TokenKind.Identifier &&
        KindAt(cursor, cursor.Position + 1) == TokenKind.Less)
    {
        blockName = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
        Advance(cursor);
    }
    BuilderExpect(cursor, TokenKind.Less, "Expected '<'",
        "Missing '</' before Block body");
    BuilderExpect(cursor, TokenKind.Slash, "Expected '/'",
        "Missing '</' before Block body");
    ExpressionNode value = New ExpressionNode([int](ExpressionKind.BlockLiteral), blockName,
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    value.LiteralId = cursor.NextBlockId;
    cursor.NextBlockId = cursor.NextBlockId + 1;
    StatementNode body = New StatementNode([int](StatementKind.Block), value.Line, value.Column);
    cursor.BlockLiteralDepth = cursor.BlockLiteralDepth + 1;
    While (!IsEnd(cursor) && !(CurrentKind(cursor) == TokenKind.Slash &&
           KindAt(cursor, cursor.Position + 1) == TokenKind.Greater))
        body.AddChild(ParseAstStatement(cursor));
    cursor.BlockLiteralDepth = cursor.BlockLiteralDepth - 1;
    BuilderExpect(cursor, TokenKind.Slash, "Expected '/'",
        "Missing '/>' after Block body");
    BuilderExpect(cursor, TokenKind.Greater, "Expected '>'",
        "Missing '/>' after Block body");
    value.Body = body;
    Return value;
}

Safe Function bool IsFormatPrefix(string name)
{
    Return name == "f" || name == "format";
}

Safe Function bool IsRawPrefix(string name)
{
    Return name == "r" || name == "raw";
}

Safe Function bool IsCharacterPrefix(string name)
{
    Return name == "c" || name == "chars";
}

Safe Function bool IsStringPrefix(string name)
{
    Return IsFormatPrefix(name) || IsRawPrefix(name) || IsCharacterPrefix(name);
}

Safe Function void AddFormattedLiteral(ExpressionNode value, string text, bool raw)
{
    ExpressionNode literal = New ExpressionNode([int](ExpressionKind.String),
        "\"" + text + "\"", value.Line, value.Column);
    literal.IsRawString = raw;
    value.AddArgument(literal);
}

Safe Function ExpressionNode ParseFormattedFragment(string text, int line, int column)
{
    SourceFile source = New SourceFile("<formatted-string>", text);
    list diagnostics = list.Create();
    list tokens = IO.Kinal.Compiler.Lex.Lexer.Tokenize(source, diagnostics);
    If (IO.Kinal.Compiler.Core.Diagnostics.HasAny(diagnostics))
        Return New ExpressionNode([int](ExpressionKind.Missing), text, line, column);
    ParseCursor fragment = New ParseCursor(tokens, source, diagnostics);
    Return ParseExpression(fragment, 1);
}

Safe Function void ReadFormattedParts(ExpressionNode value, string rawToken, bool raw)
{
    int rawLength = IO.Text.Length(rawToken);
    string body = rawLength >= 2 ? IO.Text.Slice(rawToken, 1, rawLength - 2) : rawToken;
    char[] chars = body.ToChars();
    string literal = "";
    int index = 0;
    While (index < chars.Length())
    {
        int current = [int](chars[index]);
        If (current == 123 && index + 1 < chars.Length() && [int](chars[index + 1]) == 123)
        {
            literal = literal + "{";
            index = index + 2;
            Continue;
        }
        If (current == 125 && index + 1 < chars.Length() && [int](chars[index + 1]) == 125)
        {
            literal = literal + "}";
            index = index + 2;
            Continue;
        }
        If (current == 123)
        {
            AddFormattedLiteral(value, literal, raw);
            literal = "";
            index = index + 1;
            int depth = 1;
            string expressionText = "";
            While (index < chars.Length() && depth > 0)
            {
                int nested = [int](chars[index]);
                If (nested == 123) depth = depth + 1;
                ElseIf (nested == 125)
                {
                    depth = depth - 1;
                    If (depth == 0)
                    {
                        index = index + 1;
                        Break;
                    }
                }
                If (depth > 0) expressionText = expressionText + [string](chars[index]);
                index = index + 1;
            }
            value.AddArgument(ParseFormattedFragment(expressionText, value.Line, value.Column));
            Continue;
        }
        literal = literal + [string](chars[index]);
        index = index + 1;
    }
    AddFormattedLiteral(value, literal, raw);
}

Safe Function ExpressionNode ParsePrefixedString(ParseCursor cursor, string firstPrefix,
                                                   Token location)
{
    bool formatted = IsFormatPrefix(firstPrefix);
    bool raw = IsRawPrefix(firstPrefix);
    bool characters = IsCharacterPrefix(firstPrefix);
    While (CurrentKind(cursor) == TokenKind.LeftBracket)
    {
        Advance(cursor);
        int start = cursor.Position;
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBracket) Advance(cursor);
        string prefix = JoinTokenText(cursor, start, cursor.Position);
        Match(cursor, TokenKind.RightBracket);
        If (IsFormatPrefix(prefix)) formatted = true;
        ElseIf (IsRawPrefix(prefix)) raw = true;
        ElseIf (IsCharacterPrefix(prefix)) characters = true;
    }
    Token stringToken = CurrentToken(cursor);
    If (CurrentKind(cursor) == TokenKind.String ||
        CurrentKind(cursor) == TokenKind.BadString) Advance(cursor);
    ExpressionNode value = New ExpressionNode(
        formatted ? [int](ExpressionKind.FormattedString) : [int](ExpressionKind.String),
        IO.Kinal.Compiler.Lex.Token.Text(stringToken),
        IO.Kinal.Compiler.Lex.Token.Line(location), IO.Kinal.Compiler.Lex.Token.Column(location));
    value.IsRawString = raw;
    value.IsCharacterString = characters;
    If (formatted && !IO.Text.Contains(value.Text, "{IO.Version}"))
        ReadFormattedParts(value, value.Text, raw);
    Return value;
}

Safe Function bool LooksLikeFunctionLiteral(ParseCursor cursor)
{
    If (CurrentKind(cursor) != TokenKind.KwFunction) Return false;
    int index = cursor.Position + 1;
    TokenKind first = KindAt(cursor, index);
    If (first == TokenKind.Less)
    {
        int depth = 0;
        While (index < cursor.Tokens.Count())
        {
            TokenKind kind = KindAt(cursor, index);
            If (kind == TokenKind.Less) depth = depth + 1;
            ElseIf (kind == TokenKind.Greater)
            {
                depth = depth - 1;
                If (depth == 0)
                {
                    index = index + 1;
                    Break;
                }
            }
            ElseIf (kind == TokenKind.Semicolon || kind == TokenKind.Eof)
                Return false;
            index = index + 1;
        }
        If (depth != 0) Return false;
    }
    Else
    {
        If (!(first == TokenKind.Identifier || IsPrimitiveTypeToken(first)))
            Return false;
        index = index + 1;
        While (KindAt(cursor, index) == TokenKind.Dot)
        {
            If (!IsNameToken(KindAt(cursor, index + 1))) Return false;
            index = index + 2;
        }
        While (KindAt(cursor, index) == TokenKind.Star) index = index + 1;
        While (KindAt(cursor, index) == TokenKind.LeftBracket)
        {
            int depth = 1;
            index = index + 1;
            While (index < cursor.Tokens.Count() && depth > 0)
            {
                TokenKind kind = KindAt(cursor, index);
                If (kind == TokenKind.LeftBracket) depth = depth + 1;
                ElseIf (kind == TokenKind.RightBracket) depth = depth - 1;
                index = index + 1;
            }
            If (depth != 0) Return false;
        }
    }
    Return KindAt(cursor, index) == TokenKind.LeftParen;
}

Safe Function ExpressionNode ParsePrimary(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    TokenKind kind = CurrentKind(cursor);
    If (kind == TokenKind.Number)
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Number), token);
    }
    If (kind == TokenKind.String || kind == TokenKind.BadString)
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.String), token);
    }
    If (kind == TokenKind.Character || kind == TokenKind.BadCharacter)
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Character), token);
    }
    If (kind == TokenKind.KwTrue || kind == TokenKind.KwFalse)
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Boolean), token);
    }
    If (kind == TokenKind.KwNull || kind == TokenKind.KwDefault)
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Null), token);
    }
    If (kind == TokenKind.Identifier || kind == TokenKind.KwThis ||
        kind == TokenKind.KwBase ||
        IsPrimitiveTypeToken(kind))
    {
        Advance(cursor);
        Return NewExpression([int](ExpressionKind.Name), token);
    }
    If (kind == TokenKind.LeftParen)
    {
        Advance(cursor);
        ExpressionNode nested = ParseExpression(cursor, 1);
        BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
            "Parenthesized expression is not closed");
        Return nested;
    }
    If (kind == TokenKind.LeftBrace) Return ParseArrayLiteral(cursor);
    If (kind == TokenKind.Less) Return ParsePackageLiteral(cursor);
    If (kind == TokenKind.KwIf) Return ParseIfExpression(cursor);
    If (kind == TokenKind.KwSwitch) Return ParseSwitchExpression(cursor);
    If (kind == TokenKind.KwFunction && LooksLikeFunctionLiteral(cursor))
        Return ParseFunctionLiteral(cursor);
    If (kind == TokenKind.KwBlock) Return ParseBlockLiteral(cursor);
    If (kind == TokenKind.LeftBracket)
    {
        Advance(cursor);
        int typeStart = cursor.Position;
        int bracketDepth = 0;
        While (!IsEnd(cursor))
        {
            TokenKind bracketKind = CurrentKind(cursor);
            If (bracketKind == TokenKind.LeftBracket) bracketDepth = bracketDepth + 1;
            ElseIf (bracketKind == TokenKind.RightBracket)
            {
                If (bracketDepth == 0) Break;
                bracketDepth = bracketDepth - 1;
            }
            Advance(cursor);
        }
        string typeName = JoinTokenText(cursor, typeStart, cursor.Position);
        BuilderExpect(cursor, TokenKind.RightBracket, "Expected ']'",
            "Cast or string-prefix list is not closed");
        If (IsStringPrefix(typeName)) Return ParsePrefixedString(cursor, typeName, token);
        ExpressionNode cast = New ExpressionNode([int](ExpressionKind.Cast), typeName,
            IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
        If (Match(cursor, TokenKind.LeftParen))
        {
            cast.Left = ParseExpression(cursor, 1);
            BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
                "Cast expression is not closed");
        }
        Return cast;
    }
    If (kind == TokenKind.KwNew)
    {
        Advance(cursor);
        int typeStart = cursor.Position;
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.LeftParen) Advance(cursor);
        ExpressionNode value = New ExpressionNode([int](ExpressionKind.NewObject),
            JoinTokenText(cursor, typeStart, cursor.Position),
            IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
        ReadArguments(cursor, value);
        Return value;
    }
    If (kind == TokenKind.Eof)
        Report(cursor, cursor.Diagnostics, cursor.Source, "Unexpected End Of File",
            "Unexpected end of file while parsing expression");
    Else
    {
        Report(cursor, cursor.Diagnostics, cursor.Source, "Unexpected Token",
            "Unexpected token in expression");
        Advance(cursor);
    }
    Return NewExpression([int](ExpressionKind.Missing), token);
}

Safe Function ExpressionNode ParsePostfix(ParseCursor cursor)
{
    ExpressionNode value = ParsePrimary(cursor);
    While (!IsEnd(cursor))
    {
        Token token = CurrentToken(cursor);
        If (IsGenericCallArgumentList(cursor))
        {
            ExpressionNode call = New ExpressionNode([int](ExpressionKind.Call), "",
                value.Line, value.Column);
            call.Left = value;
            ReadTypeArguments(cursor, call);
            ReadArguments(cursor, call);
            value = call;
            Continue;
        }
        If (CurrentKind(cursor) == TokenKind.LeftParen)
        {
            ExpressionNode call = New ExpressionNode([int](ExpressionKind.Call), "",
                value.Line, value.Column);
            call.Left = value;
            ReadArguments(cursor, call);
            value = call;
            Continue;
        }
        If (Match(cursor, TokenKind.Dot))
        {
            Token memberToken = CurrentToken(cursor);
            Advance(cursor);
            ExpressionNode member = New ExpressionNode([int](ExpressionKind.Member),
                IO.Kinal.Compiler.Lex.Token.Text(memberToken), value.Line, value.Column);
            member.Left = value;
            value = member;
            Continue;
        }
        If (CurrentKind(cursor) == TokenKind.LeftBracket)
        {
            Advance(cursor);
            ExpressionNode index = New ExpressionNode([int](ExpressionKind.Index), "",
                value.Line, value.Column);
            index.Left = value;
            index.Right = ParseExpression(cursor, 1);
            Match(cursor, TokenKind.RightBracket);
            value = index;
            Continue;
        }
        If (CurrentKind(cursor) == TokenKind.PlusPlus ||
            CurrentKind(cursor) == TokenKind.MinusMinus)
        {
            ExpressionNode unary = NewExpression([int](ExpressionKind.Unary), token);
            unary.Operator = CurrentKind(cursor);
            unary.IsPostfix = true;
            unary.Left = value;
            Advance(cursor);
            value = unary;
            Continue;
        }
        Break;
    }
    Return value;
}

Safe Function ExpressionNode ParseUnary(ParseCursor cursor)
{
    TokenKind kind = CurrentKind(cursor);
    If (kind == TokenKind.Not || kind == TokenKind.Minus ||
        kind == TokenKind.Plus || kind == TokenKind.Tilde ||
        kind == TokenKind.Star || kind == TokenKind.Ampersand ||
        kind == TokenKind.KwAwait || kind == TokenKind.PlusPlus ||
        kind == TokenKind.MinusMinus)
    {
        Token token = CurrentToken(cursor);
        Advance(cursor);
        ExpressionNode unary = NewExpression([int](ExpressionKind.Unary), token);
        unary.Operator = kind;
        unary.Left = ParseUnary(cursor);
        Return unary;
    }
    Return ParsePostfix(cursor);
}

Safe Function ExpressionNode ParseExpression(ParseCursor cursor, int minimumPrecedence)
{
    ExpressionNode left = ParseUnary(cursor);
    While (!IsEnd(cursor))
    {
        TokenKind operatorKind = CurrentKind(cursor);
        If (cursor.PackageLiteralDepth > 0 &&
            operatorKind == TokenKind.Greater) Break;
        int precedence = BinaryPrecedence(operatorKind);
        If (precedence < minimumPrecedence || precedence == 0) Break;
        Token operatorToken = CurrentToken(cursor);
        Advance(cursor);
        ExpressionNode binary = NewExpression([int](ExpressionKind.Binary), operatorToken);
        binary.Operator = operatorKind;
        binary.Left = left;
        int nextMinimum = IsRightAssociative(operatorKind) ? precedence : precedence + 1;
        binary.Right = ParseExpression(cursor, nextMinimum);
        left = binary;
    }
    If (minimumPrecedence <= 2 && Match(cursor, TokenKind.Question))
    {
        ExpressionNode conditional = New ExpressionNode([int](ExpressionKind.Conditional), "", left.Line, left.Column);
        conditional.Left = left;
        conditional.Right = ParseExpression(cursor, 1);
        Match(cursor, TokenKind.Colon);
        conditional.Third = ParseExpression(cursor, 2);
        left = conditional;
    }
    Return left;
}

Safe Function SyntaxAttribute ReadAttributes(ParseCursor cursor)
{
    SyntaxAttribute first = null;
    SyntaxAttribute last = null;
    While (Match(cursor, TokenKind.LeftBracket))
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBracket)
        {
            SyntaxAttribute attribute = New SyntaxAttribute(ReadQualifiedName(cursor));
            If (Match(cursor, TokenKind.LeftParen))
            {
                If (!Match(cursor, TokenKind.RightParen))
                {
                    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen)
                    {
                        attribute.AddArgument(ParseExpression(cursor, 1));
                        If (!Match(cursor, TokenKind.Comma)) Break;
                    }
                    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
                        "Missing ')' in attribute");
                }
            }
            If (first == null) first = attribute;
            Else last.Next = attribute;
            last = attribute;
            If (!Match(cursor, TokenKind.Comma)) Break;
        }
        BuilderExpect(cursor, TokenKind.RightBracket, "Expected ']'",
            "Missing ']' after attribute");
    }
    Return first;
}

Safe Function int FindDeclarationName(ParseCursor cursor, bool allowContextualName)
{
    TokenKind firstKind = CurrentKind(cursor);
    int index = cursor.Position;
    If (firstKind == TokenKind.Less)
    {
        int depth = 0;
        While (index < cursor.Tokens.Count())
        {
            TokenKind packageKind = KindAt(cursor, index);
            If (packageKind == TokenKind.Less) depth = depth + 1;
            ElseIf (packageKind == TokenKind.Greater)
            {
                depth = depth - 1;
                If (depth == 0)
                {
                    index = index + 1;
                    Break;
                }
            }
            index = index + 1;
        }
        If (depth != 0) Return -1;
    }
    Else
    {
        bool validStart = firstKind == TokenKind.Identifier ||
            IsPrimitiveTypeToken(firstKind);
        If (!validStart) Return -1;
        index = index + 1;
        While (KindAt(cursor, index) == TokenKind.Dot)
        {
            If (!IsNameToken(KindAt(cursor, index + 1))) Return -1;
            index = index + 2;
        }
        While (KindAt(cursor, index) == TokenKind.Star) index = index + 1;
        While (KindAt(cursor, index) == TokenKind.LeftBracket)
        {
            int bracketDepth = 1;
            index = index + 1;
            While (index < cursor.Tokens.Count() && bracketDepth > 0)
            {
                TokenKind bracketKind = KindAt(cursor, index);
                If (bracketKind == TokenKind.LeftBracket) bracketDepth = bracketDepth + 1;
                ElseIf (bracketKind == TokenKind.RightBracket) bracketDepth = bracketDepth - 1;
                index = index + 1;
            }
            If (bracketDepth != 0) Return -1;
        }
    }
    TokenKind candidate = KindAt(cursor, index);
    If (candidate == TokenKind.Identifier ||
        (allowContextualName && IsNameToken(candidate))) Return index;
    Return -1;
}

Safe Function StatementNode ParseAstBlock(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
        "Statement block is missing");
    StatementNode block = New StatementNode([int](StatementKind.Block),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
    {
        int statementStart = cursor.Position;
        block.AddChild(ParseAstStatement(cursor));
        If (cursor.Position <= statementStart)
            SynchronizeStatement(cursor, statementStart);
    }
    string closeDetail = IsEnd(cursor) ?
        "Unexpected end of file while parsing block" :
        "Statement block is not closed";
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'", closeDetail);
    Return block;
}

Safe Function StatementNode ParseAstFor(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.For),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
        "For statement requires a header");
    If (CurrentKind(cursor) == TokenKind.Semicolon)
    {
        Advance(cursor);
        value.Initializer = New StatementNode([int](StatementKind.Empty), value.Line, value.Column);
    }
    Else value.Initializer = ParseAstStatement(cursor);
    If (CurrentKind(cursor) != TokenKind.Semicolon)
        value.Expression = ParseExpression(cursor, 1);
    BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
        "For condition must end with ';'");
    If (CurrentKind(cursor) != TokenKind.RightParen)
        value.SecondExpression = ParseExpression(cursor, 1);
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "For header is not closed");
    value.FirstChild = ParseAstStatement(cursor);
    value.LastChild = value.FirstChild;
    Return value;
}

Safe Function StatementNode ParseAstForeach(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.Foreach),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
        "Foreach statement requires a header");
    int declarationStart = cursor.Position;
    int separator = declarationStart;
    While (!IsEnd(cursor) && KindAt(cursor, separator) != TokenKind.KwIn &&
           KindAt(cursor, separator) != TokenKind.KwIs &&
           KindAt(cursor, separator) != TokenKind.RightParen) separator = separator + 1;
    int nameIndex = separator - 1;
    value.TypeName = JoinTokenText(cursor, declarationStart, nameIndex);
    value.Name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex));
    cursor.Position = separator;
    If (CurrentKind(cursor) == TokenKind.KwIn ||
        CurrentKind(cursor) == TokenKind.KwIs) Advance(cursor);
    value.Expression = ParseExpression(cursor, 1);
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Foreach header is not closed");
    value.FirstChild = ParseAstStatement(cursor);
    value.LastChild = value.FirstChild;
    Return value;
}

Safe Function StatementNode ParseAstSwitch(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.Switch),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
        "Switch statement requires a selector");
    value.Expression = ParseExpression(cursor, 1);
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Switch selector is not closed");
    BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
        "Switch statement body is missing");
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
    {
        Token caseToken = CurrentToken(cursor);
        If (!Match(cursor, TokenKind.KwCase))
        {
            Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Case",
                "Switch statement body only accepts Case clauses");
            Advance(cursor);
            Continue;
        }
        StatementNode item = New StatementNode([int](StatementKind.Case),
            IO.Kinal.Compiler.Lex.Token.Line(caseToken),
            IO.Kinal.Compiler.Lex.Token.Column(caseToken));
        BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
            "Case matcher is missing");
        If (CurrentKind(cursor) == TokenKind.KwDefault)
        {
            item.Name = "default";
            Advance(cursor);
        }
        Else item.Expression = ParseExpression(cursor, 1);
        BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
            "Case matcher is not closed");
        item.FirstChild = ParseAstBlock(cursor);
        item.LastChild = item.FirstChild;
        value.AddChild(item);
    }
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
        "Switch statement body is not closed");
    Return value;
}

Safe Function StatementNode ParseAstTry(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    StatementNode value = New StatementNode([int](StatementKind.Try),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    Advance(cursor);
    value.FirstChild = ParseAstStatement(cursor);
    value.LastChild = value.FirstChild;
    If (Match(cursor, TokenKind.KwCatch))
    {
        StatementNode handler = New StatementNode([int](StatementKind.Try), value.Line, value.Column);
        If (Match(cursor, TokenKind.LeftParen))
        {
            int start = cursor.Position;
            While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen) Advance(cursor);
            int end = cursor.Position;
            int nameIndex = -1;
            int scan = start;
            While (scan < end)
            {
                If (KindAt(cursor, scan) == TokenKind.Identifier &&
                    KindAt(cursor, scan - 1) != TokenKind.Dot) nameIndex = scan;
                scan = scan + 1;
            }
            If (nameIndex >= start)
            {
                handler.TypeName = JoinTokenText(cursor, start, nameIndex);
                handler.Name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex));
            }
            BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
                "Catch parameter is not closed");
        }
        handler.FirstChild = ParseAstStatement(cursor);
        handler.LastChild = handler.FirstChild;
        value.ElseBranch = handler;
    }
    Return value;
}

Safe Function StatementNode ParseAstUnsafeBlock(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    bool isUnsafe = CurrentKind(cursor) == TokenKind.KwUnsafe;
    StatementNode value = New StatementNode([int](StatementKind.UnsafeBlock),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    value.IsUnsafe = isUnsafe;
    Advance(cursor);
    If (isUnsafe)
        BuilderExpect(cursor, TokenKind.KwBlock, "Expected Block",
            "Unsafe Block statement requires Block");
    value.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
    Advance(cursor);
    BuilderExpect(cursor, TokenKind.Less, "Expected '<'",
        "Missing '</' before Block body");
    BuilderExpect(cursor, TokenKind.Slash, "Expected '/'",
        "Missing '</' before Block body");
    cursor.BlockLiteralDepth = cursor.BlockLiteralDepth + 1;
    While (!IsEnd(cursor) &&
           !(CurrentKind(cursor) == TokenKind.Slash &&
             KindAt(cursor, cursor.Position + 1) == TokenKind.Greater))
        value.AddChild(ParseAstStatement(cursor));
    cursor.BlockLiteralDepth = cursor.BlockLiteralDepth - 1;
    If (IsEnd(cursor))
        Report(cursor, cursor.Diagnostics, cursor.Source, "Expected '/>'",
            "Missing '/>' after block body");
    BuilderExpect(cursor, TokenKind.Slash, "Expected '/'",
        "Missing '/>' after block body");
    BuilderExpect(cursor, TokenKind.Greater, "Expected '>'",
        "Missing '/>' after block body");
    Return value;
}

Safe Function StatementNode ParseLocalFunctionStatement(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    int declarationStart = cursor.Position;
    int open = declarationStart;
    While (!IsEnd(cursor) && KindAt(cursor, open) != TokenKind.LeftParen) open = open + 1;
    int nameIndex = open - 1;
    StatementNode declaration = New StatementNode([int](StatementKind.Variable),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
    declaration.TypeName = "Object.Function";
    declaration.Name = nameIndex >= declarationStart ?
        IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex)) : "";
    ExpressionNode function = New ExpressionNode([int](ExpressionKind.FunctionLiteral),
        JoinTokenText(cursor, declarationStart, nameIndex), declaration.Line, declaration.Column);
    function.LiteralId = cursor.NextAnonymousFunctionId;
    cursor.NextAnonymousFunctionId = cursor.NextAnonymousFunctionId + 1;
    cursor.Position = open;
    BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
        "Local function parameter list is missing");
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen)
    {
        int parameterStart = cursor.Position;
        int parameterEnd = FindParameterDeclarationEnd(cursor, parameterStart);
        int parameterNameIndex = FindParameterName(cursor, parameterStart, parameterEnd);
        If (parameterNameIndex >= parameterStart)
        {
            Token nameToken = RawAt(cursor, parameterNameIndex);
            ExpressionNode parameter = New ExpressionNode([int](ExpressionKind.Name),
                IO.Kinal.Compiler.Lex.Token.Text(nameToken),
                IO.Kinal.Compiler.Lex.Token.Line(nameToken),
                IO.Kinal.Compiler.Lex.Token.Column(nameToken));
            parameter.Left = New ExpressionNode([int](ExpressionKind.Name),
                JoinTokenText(cursor, parameterStart, parameterNameIndex),
                parameter.Line, parameter.Column);
            function.AddArgument(parameter);
        }
        cursor.Position = parameterEnd;
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Local function parameter list is not closed");
    function.Body = ParseAstBlock(cursor);
    declaration.Expression = function;
    Return declaration;
}

Safe Function StatementNode ParseLocalTypeStatement(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    Advance(cursor);
    If (CurrentKind(cursor) == TokenKind.Identifier) Advance(cursor);
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.LeftBrace &&
           CurrentKind(cursor) != TokenKind.Semicolon) Advance(cursor);
    If (CurrentKind(cursor) == TokenKind.LeftBrace)
        SkipBalancedUnchecked(cursor, TokenKind.LeftBrace, TokenKind.RightBrace);
    Match(cursor, TokenKind.Semicolon);
    Return New StatementNode([int](StatementKind.Empty),
        IO.Kinal.Compiler.Lex.Token.Line(token), IO.Kinal.Compiler.Lex.Token.Column(token));
}

Safe Function StatementNode ParseVariableStatement(ParseCursor cursor, int line, int column,
                                                   bool isConst, bool inferred)
{
    StatementNode declaration = New StatementNode([int](StatementKind.Variable), line, column);
    declaration.IsConst = isConst;
    If (inferred)
    {
        declaration.TypeName = "Var";
        declaration.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
        Advance(cursor);
    }
    Else
    {
        int declarationName = FindDeclarationName(cursor, false);
        If (declarationName <= cursor.Position) Return null;
        declaration.TypeName = JoinTokenText(cursor, cursor.Position, declarationName);
        declaration.Name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, declarationName));
        cursor.Position = declarationName + 1;
    }
    If (Match(cursor, TokenKind.Less))
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Greater)
        {
            string label = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
            If (declaration.PackageLabels == "") declaration.PackageLabels = label;
            Else declaration.PackageLabels = declaration.PackageLabels + "," + label;
            Advance(cursor);
            If (!Match(cursor, TokenKind.Comma)) Break;
        }
        BuilderExpect(cursor, TokenKind.Greater, "Expected '>'",
            "Package field labels are not closed");
    }
    // C-style local arrays place dimensions after the variable name.
    // Normalize the type to the canonical T[] form while preserving the
    // outer fixed length for backend allocation.
    While (Match(cursor, TokenKind.LeftBracket))
    {
        ReportWarningToken(cursor.Diagnostics, cursor.Source,
            RawAt(cursor, cursor.Position - 1), "Legacy Array Syntax",
            "Use 'Type[] name' instead of 'Type name[]'");
        If (CurrentKind(cursor) != TokenKind.RightBracket &&
            declaration.SecondExpression == null)
            declaration.SecondExpression = ParseExpression(cursor, 1);
        ElseIf (CurrentKind(cursor) != TokenKind.RightBracket)
            ParseExpression(cursor, 1);
        BuilderExpect(cursor, TokenKind.RightBracket, "Expected ']'",
            "Array declarator is not closed");
        declaration.TypeName = declaration.TypeName + "[]";
    }
    If (Match(cursor, TokenKind.Assign)) declaration.Expression = ParseExpression(cursor, 1);
    BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
        "Variable declaration must end with ';'");
    Return declaration;
}

Safe Function StatementNode ParseAstStatementCore(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    TokenKind kind = CurrentKind(cursor);
    int line = IO.Kinal.Compiler.Lex.Token.Line(token);
    int column = IO.Kinal.Compiler.Lex.Token.Column(token);
    Switch (kind)
    {
        Case(TokenKind.LeftBrace)
        {
            Return ParseAstBlock(cursor);
        }
        Case(TokenKind.Semicolon)
        {
            Advance(cursor);
            Return New StatementNode([int](StatementKind.Empty), line, column);
        }
        Case(TokenKind.KwReturn)
        {
            Advance(cursor);
            StatementNode value = New StatementNode([int](StatementKind.Return), line, column);
            If (CurrentKind(cursor) != TokenKind.Semicolon) value.Expression = ParseExpression(cursor, 1);
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Missing ';' after return");
            Return value;
        }
        Case(TokenKind.KwIf)
        {
            Advance(cursor);
            StatementNode value = New StatementNode([int](StatementKind.If), line, column);
            BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                "If statement requires a condition");
            value.Expression = ParseExpression(cursor, 1);
            If (value.Expression != null && value.Expression.Kind == [int](ExpressionKind.Binary) &&
                value.Expression.Operator == TokenKind.KwIs &&
                CurrentKind(cursor) == TokenKind.Identifier)
            {
                value.Expression.Third = NewExpression([int](ExpressionKind.Name), CurrentToken(cursor));
                Advance(cursor);
            }
            BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
                "If condition is not closed");
            value.FirstChild = ParseAstStatement(cursor);
            If (Match(cursor, TokenKind.KwElse)) value.ElseBranch = ParseAstStatement(cursor);
            ElseIf (CurrentKind(cursor) == TokenKind.KwElseIf)
                value.ElseBranch = ParseAstStatement(cursor);
            Return value;
        }
        Case(TokenKind.KwElseIf)
        {
            Advance(cursor);
            StatementNode value = New StatementNode([int](StatementKind.If), line, column);
            BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                "ElseIf statement requires a condition");
            value.Expression = ParseExpression(cursor, 1);
            If (value.Expression != null && value.Expression.Kind == [int](ExpressionKind.Binary) &&
                value.Expression.Operator == TokenKind.KwIs &&
                CurrentKind(cursor) == TokenKind.Identifier)
            {
                value.Expression.Third = NewExpression([int](ExpressionKind.Name), CurrentToken(cursor));
                Advance(cursor);
            }
            BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
                "ElseIf condition is not closed");
            value.FirstChild = ParseAstStatement(cursor);
            If (Match(cursor, TokenKind.KwElse)) value.ElseBranch = ParseAstStatement(cursor);
            ElseIf (CurrentKind(cursor) == TokenKind.KwElseIf)
                value.ElseBranch = ParseAstStatement(cursor);
            Return value;
        }
        Case(TokenKind.KwWhile)
        {
            Advance(cursor);
            StatementNode value = New StatementNode([int](StatementKind.While), line, column);
            BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                "While statement requires a condition");
            value.Expression = ParseExpression(cursor, 1);
            BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
                "While condition is not closed");
            value.FirstChild = ParseAstStatement(cursor);
            Return value;
        }
        Case(TokenKind.KwFor) { Return ParseAstFor(cursor); }
        Case(TokenKind.KwForeach) { Return ParseAstForeach(cursor); }
        Case(TokenKind.KwSwitch) { Return ParseAstSwitch(cursor); }
        Case(TokenKind.KwTry) { Return ParseAstTry(cursor); }
        Case(TokenKind.KwThrow)
        {
            Advance(cursor);
            StatementNode value = New StatementNode([int](StatementKind.Throw), line, column);
            If (CurrentKind(cursor) != TokenKind.Semicolon) value.Expression = ParseExpression(cursor, 1);
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Throw statement must end with ';'");
            Return value;
        }
        Case(TokenKind.KwUnsafe)
        {
            If (KindAt(cursor, cursor.Position + 1) == TokenKind.KwBlock)
                Return ParseAstUnsafeBlock(cursor);
        }
        Case(TokenKind.KwBlock)
        {
            If (KindAt(cursor, cursor.Position + 1) == TokenKind.Identifier &&
                KindAt(cursor, cursor.Position + 2) == TokenKind.Less)
                Return ParseAstUnsafeBlock(cursor);
        }
        Case(TokenKind.KwFunction)
        {
            If (cursor.BlockLiteralDepth > 0)
                Return ParseLocalFunctionStatement(cursor);
        }
        Case(TokenKind.KwClass)
        {
            If (cursor.BlockLiteralDepth > 0)
                Return ParseLocalTypeStatement(cursor);
        }
        Case(TokenKind.KwStruct)
        {
            If (cursor.BlockLiteralDepth > 0)
                Return ParseLocalTypeStatement(cursor);
        }
        Case(TokenKind.KwEnum)
        {
            If (cursor.BlockLiteralDepth > 0)
                Return ParseLocalTypeStatement(cursor);
        }
        Case(TokenKind.KwInterface)
        {
            If (cursor.BlockLiteralDepth > 0)
                Return ParseLocalTypeStatement(cursor);
        }
        Case(TokenKind.KwRecord)
        {
            If (cursor.BlockLiteralDepth > 0)
            {
                Advance(cursor);
                StatementNode value = New StatementNode([int](StatementKind.Record), line, column);
                value.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
                Advance(cursor);
                If (CurrentKind(cursor) == TokenKind.LeftBrace)
                {
                    value.FirstChild = ParseAstBlock(cursor);
                    value.LastChild = value.FirstChild;
                }
                ElseIf (!(CurrentKind(cursor) == TokenKind.Slash &&
                         KindAt(cursor, cursor.Position + 1) == TokenKind.Greater))
                {
                    value.FirstChild = ParseAstStatement(cursor);
                    value.LastChild = value.FirstChild;
                }
                Return value;
            }
        }
        Case(TokenKind.KwJump)
        {
            If (cursor.BlockLiteralDepth > 0)
            {
                Advance(cursor);
                StatementNode value = New StatementNode([int](StatementKind.Jump), line, column);
                If (CurrentKind(cursor) == TokenKind.Identifier &&
                    KindAt(cursor, cursor.Position + 1) == TokenKind.Semicolon)
                {
                    value.Name = IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor));
                    Advance(cursor);
                }
                Else value.Expression = ParseExpression(cursor, 1);
                BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                    "Jump statement must end with ';'");
                Return value;
            }
        }
        Case(TokenKind.KwBreak)
        {
            Advance(cursor);
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Break statement must end with ';'");
            Return New StatementNode([int](StatementKind.Break), line, column);
        }
        Case(TokenKind.KwContinue)
        {
            Advance(cursor);
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Continue statement must end with ';'");
            Return New StatementNode([int](StatementKind.Continue), line, column);
        }
        Case(TokenKind.KwGet)
        {
            Report(cursor, cursor.Diagnostics, cursor.Source,
                "Invalid Get Position",
                "Get must appear at top-level after Unit and before declarations");
            Report(cursor, cursor.Diagnostics, cursor.Source,
                "Unexpected Token", "Unexpected token in expression");
            Advance(cursor);
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Missing ';' after expression");
            Return New StatementNode([int](StatementKind.Expression), line, column);
        }
        Case(TokenKind.KwVar)
        {
            Advance(cursor);
            Return ParseVariableStatement(cursor, line, column, false, true);
        }
        Case(TokenKind.KwConst)
        {
            Advance(cursor);
            bool inferred = Match(cursor, TokenKind.KwVar);
            StatementNode declaration = ParseVariableStatement(
                cursor, line, column, true, inferred);
            If (declaration != null) Return declaration;
            Report(cursor, cursor.Diagnostics, cursor.Source,
                "Expected Declaration", "Const requires a variable declaration");
        }
        Case(default) { }
    }
    StatementNode declaration = ParseVariableStatement(cursor, line, column, false, false);
    If (declaration != null) Return declaration;
    int start = cursor.Position;
    StatementNode expression = New StatementNode([int](StatementKind.Expression), line, column);
    expression.Expression = ParseExpression(cursor, 1);
    If (cursor.Position == start) Advance(cursor);
    BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
        "Expression statement must end with ';'");
    Return expression;
}

Safe Function StatementNode ParseAstStatement(ParseCursor cursor)
{
    Token token = CurrentToken(cursor);
    If (CurrentKind(cursor) == TokenKind.KwForeach)
        Return ParseAstStatementCore(cursor);
    If (!EnterStatement(cursor))
        Return New StatementNode([int](StatementKind.Empty),
            IO.Kinal.Compiler.Lex.Token.Line(token),
            IO.Kinal.Compiler.Lex.Token.Column(token));
    StatementNode statement = ParseAstStatementCore(cursor);
    LeaveStatement(cursor);
    Return statement;
}

Safe Function int AccessFromModifier(TokenKind kind)
{
    Return Switch (kind)
    {
        Case(TokenKind.KwPublic) { 1; }
        Case(TokenKind.KwPrivate) { 2; }
        Case(TokenKind.KwProtected) { 3; }
        Case(TokenKind.KwInternal) { 4; }
        Case(default) { 0; }
    };
}

Safe Function FunctionDecl ReadFunctionNode(ParseCursor cursor, bool constructor,
                                             bool isStatic, bool isAsync, bool isExtern, int safety)
{
    Token declarationToken = CurrentToken(cursor);
    If (constructor)
    {
        Advance(cursor);
        FunctionDecl value = New FunctionDecl("Constructor", "void",
            IO.Kinal.Compiler.Lex.Token.Line(declarationToken),
            IO.Kinal.Compiler.Lex.Token.Column(declarationToken));
        value.IsConstructor = true;
        value.IsStatic = isStatic;
        value.IsAsync = isAsync;
        value.IsExtern = isExtern;
        value.Safety = safety;
        ReadParameters(cursor, value);
        If (!Match(cursor, TokenKind.Semicolon)) value.Body = ParseAstBlock(cursor);
        Return value;
    }

    Advance(cursor);
    int returnStart = cursor.Position;
    int nameIndex = FindFunctionNamePosition(cursor, returnStart);
    If (nameIndex < returnStart)
    {
        Token invalidToken = RawAt(cursor, returnStart);
        Report(cursor, cursor.Diagnostics, cursor.Source, "Expected function name",
            "Missing function name before parameter list");
        FunctionDecl invalid = New FunctionDecl("", "",
            IO.Kinal.Compiler.Lex.Token.Line(invalidToken),
            IO.Kinal.Compiler.Lex.Token.Column(invalidToken));
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Semicolon &&
               CurrentKind(cursor) != TokenKind.LeftBrace) Advance(cursor);
        If (!Match(cursor, TokenKind.Semicolon))
            SkipBalancedUnchecked(cursor, TokenKind.LeftBrace, TokenKind.RightBrace);
        Return invalid;
    }
    Token nameToken = RawAt(cursor, nameIndex);
    FunctionDecl value = New FunctionDecl(
        IO.Kinal.Compiler.Lex.Token.Text(nameToken), JoinTokenText(cursor, returnStart, nameIndex),
        IO.Kinal.Compiler.Lex.Token.Line(nameToken), IO.Kinal.Compiler.Lex.Token.Column(nameToken));
    value.IsStatic = isStatic;
    value.IsAsync = isAsync;
    value.IsExtern = isExtern;
    value.Safety = safety;
    cursor.Position = nameIndex + 1;
    If (Match(cursor, TokenKind.Less))
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Greater)
        {
            Token parameterToken = CurrentToken(cursor);
            value.AddTypeParameter(New TypeParameterDecl(
                IO.Kinal.Compiler.Lex.Token.Text(parameterToken),
                IO.Kinal.Compiler.Lex.Token.Line(parameterToken),
                IO.Kinal.Compiler.Lex.Token.Column(parameterToken)));
            Advance(cursor);
            If (!Match(cursor, TokenKind.Comma)) Break;
        }
        BuilderExpect(cursor, TokenKind.Greater, "Expected '>'",
            "Generic type parameter list is not closed");
    }
    ReadParameters(cursor, value);
    If (Match(cursor, TokenKind.KwBy)) value.Abi = ReadQualifiedName(cursor);
    If (!Match(cursor, TokenKind.Semicolon)) value.Body = ParseAstBlock(cursor);
    Return value;
}

Safe Function void ReadAggregateSpecifiers(ParseCursor cursor, TypeDecl type)
{
    If (!Match(cursor, TokenKind.KwBy)) Return;
    If (type.Kind == TokenKind.KwEnum)
    {
        type.UnderlyingTypeName = ReadQualifiedName(cursor);
        Return;
    }
    If (type.Kind != TokenKind.KwStruct) Return;

    bool reading = true;
    While (reading)
    {
        Token specifier = CurrentToken(cursor);
        string name = IO.Kinal.Compiler.Lex.Token.Text(specifier);
        If (!BuilderExpect(cursor, TokenKind.Identifier, "Expected Identifier",
                           "Expected specifier")) Return;
        If (name == "Packed")
        {
            type.IsPacked = true;
        }
        ElseIf (name == "Align")
        {
            BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                "Missing '(' after Align");
            Token number = CurrentToken(cursor);
            If (BuilderExpect(cursor, TokenKind.Number, "Expected Number",
                              "Align requires a number"))
            {
                int value = [int](IO.Kinal.Compiler.Lex.Token.Text(number));
                If (value > 0 && value < 1073741824) type.Align = value;
            }
            BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
                "Missing ')' after Align");
        }
        Else
        {
            ReportToken(cursor.Diagnostics, cursor.Source, specifier,
                "Unknown Specifier", "Unsupported struct specifier");
        }
        reading = Match(cursor, TokenKind.Comma);
    }
}

Safe Function void ReadTypeMembers(ParseCursor cursor, TypeDecl type, SyntaxTree tree)
{
    If (type.Kind == TokenKind.KwEnum)
    {
        If (!BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
                           "Enum body is missing")) Return;
        int ordinal = 0;
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
        {
            If (!IsNameToken(CurrentKind(cursor)))
            {
                Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Identifier",
                    "Expected enum member");
                While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Comma &&
                       CurrentKind(cursor) != TokenKind.RightBrace) Advance(cursor);
                Match(cursor, TokenKind.Comma);
                Continue;
            }
            Token nameToken = CurrentToken(cursor);
            Advance(cursor);
            EnumMemberDecl member = New EnumMemberDecl(
                IO.Kinal.Compiler.Lex.Token.Text(nameToken), ordinal);
            If (Match(cursor, TokenKind.Assign)) member.Value = ParseExpression(cursor, 1);
            type.AddEnumMember(member);
            ordinal = ordinal + 1;
            If (!Match(cursor, TokenKind.Comma)) Break;
        }
        BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
            "Enum body is not closed");
        Return;
    }
    If (!BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
                       "Type body is missing")) Return;
    Block TypeMemberDispatch< /
        Record Dispatch
        If (IsEnd(cursor) || CurrentKind(cursor) == TokenKind.RightBrace)
        {
            Jump Done;
        }
        SyntaxAttribute attributes = ReadAttributes(cursor);
        int access = 0;
        bool isStatic = false;
        bool isAsync = false;
        bool isExtern = false;
        bool isAbstract = false;
        bool isVirtual = false;
        bool isOverride = false;
        bool isSealed = false;
        int safety = 0;
        bool readingModifiers = true;
        While (readingModifiers)
        {
            TokenKind modifier = CurrentKind(cursor);
            int modifierAccess = AccessFromModifier(modifier);
            bool consumed = modifierAccess != 0;
            If (modifierAccess != 0)
            {
                access = modifierAccess;
            }
            Else
            {
                Switch (modifier)
                {
                    Case(TokenKind.KwStatic) { isStatic = true; consumed = true; }
                    Case(TokenKind.KwAsync) { isAsync = true; consumed = true; }
                    Case(TokenKind.KwExtern) { isExtern = true; consumed = true; }
                    Case(TokenKind.KwAbstract) { isAbstract = true; consumed = true; }
                    Case(TokenKind.KwVirtual) { isVirtual = true; consumed = true; }
                    Case(TokenKind.KwOverride) { isOverride = true; consumed = true; }
                    Case(TokenKind.KwSealed) { isSealed = true; consumed = true; }
                    Case(TokenKind.KwSafe) { safety = 1; consumed = true; }
                    Case(TokenKind.KwTrusted) { safety = 2; consumed = true; }
                    Case(TokenKind.KwUnsafe) { safety = 3; consumed = true; }
                    Case(default) { }
                }
            }
            If (consumed) Advance(cursor); Else readingModifiers = false;
        }

        If (CurrentKind(cursor) == TokenKind.KwClass ||
            CurrentKind(cursor) == TokenKind.KwInterface ||
            CurrentKind(cursor) == TokenKind.KwStruct ||
            CurrentKind(cursor) == TokenKind.KwEnum)
        {
            TokenKind nestedKind = CurrentKind(cursor);
            Advance(cursor);
            Token nestedNameToken = CurrentToken(cursor);
            string nestedName = type.Name + "." +
                IO.Kinal.Compiler.Lex.Token.Text(nestedNameToken);
            Advance(cursor);
            TypeDecl nested = New TypeDecl(nestedKind, nestedName,
                IO.Kinal.Compiler.Lex.Token.Line(nestedNameToken),
                IO.Kinal.Compiler.Lex.Token.Column(nestedNameToken));
            If (nestedKind == TokenKind.KwClass &&
                Match(cursor, TokenKind.KwBy))
            {
                bool readingBases = true;
                While (readingBases)
                {
                    nested.AddBase(ReadQualifiedName(cursor));
                    readingBases = Match(cursor, TokenKind.Comma);
                }
            }
            ElseIf (nestedKind == TokenKind.KwStruct ||
                    nestedKind == TokenKind.KwEnum)
                ReadAggregateSpecifiers(cursor, nested);
            While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.LeftBrace)
                Advance(cursor);
            nested.IsStatic = isStatic;
            nested.IsAbstract = isAbstract;
            nested.IsSealed = isSealed;
            nested.FirstAttribute = attributes;
            ReadTypeMembers(cursor, nested, tree);
            tree.AddType(nested);
            Jump Dispatch;
        }

        If (CurrentKind(cursor) == TokenKind.KwConstructor)
        {
            FunctionDecl constructor = ReadFunctionNode(cursor, true, isStatic, isAsync, isExtern, safety);
            constructor.Access = access;
            constructor.IsStatic = constructor.IsStatic || type.IsStatic;
            constructor.IsAbstract = isAbstract;
            constructor.IsVirtual = isVirtual;
            constructor.IsOverride = isOverride;
            constructor.IsSealed = isSealed;
            constructor.FirstAttribute = attributes;
            type.AddMethod(constructor);
            Jump Dispatch;
        }
        If (CurrentKind(cursor) == TokenKind.KwFunction)
        {
            Token methodToken = CurrentToken(cursor);
            FunctionDecl method = ReadFunctionNode(cursor, false, isStatic, isAsync, isExtern, safety);
            If (method.ReturnType == "" && method.Name == type.Name)
            {
                ReportWarningToken(cursor.Diagnostics, cursor.Source, methodToken,
                    "Legacy Constructor Syntax",
                    "Use 'Constructor(...)' instead of 'Function ClassName(...)'");
                method.Name = "Constructor";
                method.ReturnType = "void";
                method.IsConstructor = true;
            }
            method.IsStatic = method.IsStatic || type.IsStatic;
            method.Access = type.Kind == TokenKind.KwInterface && access == 0 ?
                1 : access;
            method.IsAbstract = type.Kind == TokenKind.KwInterface || isAbstract;
            method.IsVirtual = isVirtual;
            method.IsOverride = isOverride;
            method.IsSealed = isSealed;
            method.FirstAttribute = attributes;
            type.AddMethod(method);
            Jump Dispatch;
        }
        If (CurrentKind(cursor) == TokenKind.KwProperty)
        {
            Advance(cursor);
            int propertyStart = cursor.Position;
            int bodyStart = propertyStart;
            While (!IsEnd(cursor) && KindAt(cursor, bodyStart) != TokenKind.LeftBrace &&
                   KindAt(cursor, bodyStart) != TokenKind.Semicolon) bodyStart = bodyStart + 1;
            int propertyName = bodyStart - 1;
            If (propertyName >= propertyStart)
            {
                Token nameToken = RawAt(cursor, propertyName);
                FieldDecl property = New FieldDecl(IO.Kinal.Compiler.Lex.Token.Text(nameToken),
                    JoinTokenText(cursor, propertyStart, propertyName),
                    IO.Kinal.Compiler.Lex.Token.Line(nameToken),
                    IO.Kinal.Compiler.Lex.Token.Column(nameToken));
                property.Access = access;
                property.IsStatic = isStatic || type.IsStatic;
                property.FirstAttribute = attributes;
                type.AddField(property);
            }
            cursor.Position = bodyStart;
            If (!Match(cursor, TokenKind.Semicolon))
                SkipBalancedUnchecked(cursor, TokenKind.LeftBrace, TokenKind.RightBrace);
            Jump Dispatch;
        }

        int fieldStart = cursor.Position;
        int fieldName = FindDeclarationName(cursor, true);
        If (fieldName > fieldStart)
        {
            Token nameToken = RawAt(cursor, fieldName);
            FieldDecl field = New FieldDecl(IO.Kinal.Compiler.Lex.Token.Text(nameToken),
                JoinTokenText(cursor, fieldStart, fieldName),
                IO.Kinal.Compiler.Lex.Token.Line(nameToken), IO.Kinal.Compiler.Lex.Token.Column(nameToken));
            field.Access = access;
            field.IsStatic = isStatic || type.IsStatic;
            field.FirstAttribute = attributes;
            cursor.Position = fieldName + 1;
            field.TypeName = ReadLegacyArrayTypeSuffixes(cursor, field.TypeName);
            If (Match(cursor, TokenKind.Assign)) field.Initializer = ParseExpression(cursor, 1);
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Missing ';' after field");
            type.AddField(field);
            Jump Dispatch;
        }

        Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Identifier",
            "Expected field or type member declaration");
        SynchronizeTypeMember(cursor, cursor.Position);
        Jump Dispatch;

        Record Done
    / >
    TypeMemberDispatch.Run();
    string closeDetail = "Type body is not closed";
    If (IsEnd(cursor))
    {
        If (type.Kind == TokenKind.KwClass)
            closeDetail = "Unexpected end of file while parsing class body";
        ElseIf (type.Kind == TokenKind.KwInterface)
            closeDetail = "Unexpected end of file while parsing interface body";
        ElseIf (type.Kind == TokenKind.KwStruct)
            closeDetail = "Unexpected end of file while parsing struct body";
    }
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'", closeDetail);
}

Safe Function void ReadParameters(ParseCursor cursor, FunctionDecl function)
{
    If (!BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                       "Function parameter list is missing")) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen)
    {
        int start = cursor.Position;
        int declarationEnd = FindParameterDeclarationEnd(cursor, start);
        bool hasDefault = KindAt(cursor, declarationEnd) == TokenKind.Assign;
        int nameIndex = FindParameterName(cursor, start, declarationEnd);
        If (nameIndex < start)
            Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Identifier",
                "Expected parameter name");
        If (nameIndex >= start)
        {
            WarnLegacyArraySuffixes(cursor, nameIndex + 1, declarationEnd);
            string name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex));
            string typeName = JoinTokenText(cursor, start, nameIndex);
            If (nameIndex + 1 < declarationEnd)
                typeName = typeName + " " + JoinTokenText(cursor, nameIndex + 1, declarationEnd);
            ParameterDecl parameter = New ParameterDecl(name, typeName);
            If (hasDefault)
            {
                cursor.Position = declarationEnd + 1;
                parameter.DefaultValue = ParseExpression(cursor, 1);
            }
            function.AddParameter(parameter);
        }
        If (!hasDefault) cursor.Position = declarationEnd;
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Function parameter list is not closed");
}

Safe Function int MetaTargetMask(string name)
{
    If (name == "function") Return 1;
    If (name == "extern_function") Return 2;
    If (name == "delegate_function") Return 4;
    If (name == "class") Return 8;
    If (name == "struct") Return 16;
    If (name == "enum") Return 32;
    If (name == "interface") Return 64;
    If (name == "method") Return 128;
    If (name == "field") Return 256;
    Return 0;
}

Safe Function int MetaKeepKind(string name)
{
    If (name == "source") Return 1;
    If (name == "compile") Return 2;
    If (name == "runtime") Return 3;
    Return 0;
}

Safe Function void ReadMetaParameters(ParseCursor cursor, MetaDecl meta)
{
    If (!BuilderExpect(cursor, TokenKind.LeftParen, "Expected '('",
                       "Meta parameter list is missing")) Return;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightParen)
    {
        int start = cursor.Position;
        int declarationEnd = FindParameterDeclarationEnd(cursor, start);
        bool hasDefault = KindAt(cursor, declarationEnd) == TokenKind.Assign;
        int nameIndex = FindParameterName(cursor, start, declarationEnd);
        If (nameIndex >= start)
        {
            WarnLegacyArraySuffixes(cursor, nameIndex + 1, declarationEnd);
            string name = IO.Kinal.Compiler.Lex.Token.Text(RawAt(cursor, nameIndex));
            string typeName = JoinTokenText(cursor, start, nameIndex);
            If (nameIndex + 1 < declarationEnd)
                typeName = typeName + " " +
                    JoinTokenText(cursor, nameIndex + 1, declarationEnd);
            ParameterDecl parameter = New ParameterDecl(name, typeName);
            If (hasDefault)
            {
                cursor.Position = declarationEnd + 1;
                parameter.DefaultValue = ParseExpression(cursor, 1);
            }
            meta.AddParameter(parameter);
        }
        If (!hasDefault) cursor.Position = declarationEnd;
        If (!Match(cursor, TokenKind.Comma)) Break;
    }
    BuilderExpect(cursor, TokenKind.RightParen, "Expected ')'",
        "Meta parameter list is not closed");
}

Safe Function MetaDecl ReadMetaNode(ParseCursor cursor)
{
    Token metaToken = CurrentToken(cursor);
    Advance(cursor);
    Token nameToken = CurrentToken(cursor);
    string name = IO.Kinal.Compiler.Lex.Token.Text(nameToken);
    BuilderExpect(cursor, TokenKind.Identifier, "Expected Identifier",
        "Expected Meta name");
    MetaDecl meta = New MetaDecl(name,
        IO.Kinal.Compiler.Lex.Token.Line(metaToken),
        IO.Kinal.Compiler.Lex.Token.Column(metaToken));
    ReadMetaParameters(cursor, meta);
    If (!BuilderExpect(cursor, TokenKind.LeftBrace, "Expected '{'",
                       "Meta declaration body is missing")) Return meta;
    bool sawOn = false;
    bool sawKeep = false;
    bool sawRepeatable = false;
    While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
    {
        If (MatchContextual(cursor, "On"))
        {
            If (sawOn)
                Report(cursor, cursor.Diagnostics, cursor.Source,
                    "Duplicate Meta Clause",
                    "Meta declaration can only define one On clause");
            sawOn = true;
            While (true)
            {
                If (!Match(cursor, TokenKind.At))
                {
                    Report(cursor, cursor.Diagnostics, cursor.Source,
                        "Invalid Meta Target",
                        "Meta targets must use built-in constants like @function");
                    If (!IsEnd(cursor)) Advance(cursor);
                }
                Else
                {
                    int target = MetaTargetMask(
                        IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor)));
                    If (CurrentKind(cursor) != TokenKind.Identifier || target == 0)
                    {
                        Report(cursor, cursor.Diagnostics, cursor.Source,
                            "Invalid Meta Target",
                            "Supported Meta targets are @function, @extern_function, @delegate_function, @class, @struct, @enum, @interface, @method, @field");
                    }
                    Else meta.TargetMask = meta.TargetMask | target;
                    If (!IsEnd(cursor)) Advance(cursor);
                }
                If (!Match(cursor, TokenKind.Comma)) Break;
            }
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Missing ';' after Meta On clause");
            Continue;
        }
        If (MatchContextual(cursor, "Keep"))
        {
            If (sawKeep)
                Report(cursor, cursor.Diagnostics, cursor.Source,
                    "Duplicate Meta Clause",
                    "Meta declaration can only define one Keep clause");
            sawKeep = true;
            If (!Match(cursor, TokenKind.At))
            {
                Report(cursor, cursor.Diagnostics, cursor.Source,
                    "Invalid Meta Keep",
                    "Meta keep modes must use built-in constants like @source, @compile, @runtime");
                If (!IsEnd(cursor)) Advance(cursor);
            }
            Else
            {
                int keep = MetaKeepKind(
                    IO.Kinal.Compiler.Lex.Token.Text(CurrentToken(cursor)));
                If (CurrentKind(cursor) != TokenKind.Identifier || keep == 0)
                    Report(cursor, cursor.Diagnostics, cursor.Source,
                        "Invalid Meta Keep",
                        "Supported Meta keep modes are @source, @compile, @runtime");
                Else meta.KeepKind = keep;
                If (!IsEnd(cursor)) Advance(cursor);
            }
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Missing ';' after Meta Keep clause");
            Continue;
        }
        If (MatchContextual(cursor, "Repeatable"))
        {
            If (sawRepeatable)
                Report(cursor, cursor.Diagnostics, cursor.Source,
                    "Duplicate Meta Clause",
                    "Meta declaration can only define Repeatable once");
            sawRepeatable = true;
            meta.IsRepeatable = true;
            BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
                "Missing ';' after Repeatable");
            Continue;
        }
        Report(cursor, cursor.Diagnostics, cursor.Source, "Invalid Meta Clause",
            "Meta body only supports On, Keep, and Repeatable clauses");
        If (!IsEnd(cursor)) Advance(cursor);
    }
    BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'",
        "Meta declaration body is not closed");
    If (!sawOn)
        ReportToken(cursor.Diagnostics, cursor.Source, metaToken,
            "Missing Meta Clause", "Meta declaration requires an On clause");
    If (!sawKeep)
        ReportToken(cursor.Diagnostics, cursor.Source, metaToken,
            "Missing Meta Clause", "Meta declaration requires a Keep clause");
    Return meta;
}

Safe Function FieldDecl ReadGlobalNode(ParseCursor cursor, SyntaxAttribute attributes)
{
    bool isConst = Match(cursor, TokenKind.KwConst);
    int declarationStart = cursor.Position;
    int declarationName = FindDeclarationName(cursor, true);
    If (declarationName <= declarationStart)
    {
        Report(cursor, cursor.Diagnostics, cursor.Source, "Expected Identifier",
            "Expected global variable name");
        Return null;
    }
    Token nameToken = RawAt(cursor, declarationName);
    FieldDecl global = New FieldDecl(IO.Kinal.Compiler.Lex.Token.Text(nameToken),
        JoinTokenText(cursor, declarationStart, declarationName),
        IO.Kinal.Compiler.Lex.Token.Line(nameToken), IO.Kinal.Compiler.Lex.Token.Column(nameToken));
    global.IsConst = isConst;
    global.FirstAttribute = attributes;
    cursor.Position = declarationName + 1;
    global.TypeName = ReadLegacyArrayTypeSuffixes(cursor, global.TypeName);
    If (Match(cursor, TokenKind.Assign))
    {
        If (IsEnd(cursor))
        {
            Report(cursor, cursor.Diagnostics, cursor.Source,
                "Unexpected End Of File",
                "Unexpected end of file while parsing variable declaration");
            Return global;
        }
        global.Initializer = ParseExpression(cursor, 1);
    }
    BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
        "Missing ';' after global variable");
    Return global;
}

Safe Function void ReadGetDeclaration(ParseCursor cursor, SyntaxTree tree)
{
    Token location = CurrentToken(cursor);
    Advance(cursor);
    string name = ReadQualifiedName(cursor);
    If (Match(cursor, TokenKind.KwBy))
    {
        If (IO.Text.Contains(name, "."))
            ReportToken(cursor.Diagnostics, cursor.Source, location,
                "Invalid Get Alias", "Alias before By must be a simple identifier");
        string target = ReadQualifiedName(cursor);
        BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
            "Missing ';' after Get");
        ImportDecl alias = New ImportDecl(name, target,
            IO.Kinal.Compiler.Lex.Token.Line(location),
            IO.Kinal.Compiler.Lex.Token.Column(location));
        alias.Kind = 1;
        tree.AddImport(alias);
        Return;
    }
    If (Match(cursor, TokenKind.LeftBrace))
    {
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.RightBrace)
        {
            Token memberToken = CurrentToken(cursor);
            If (!BuilderExpect(cursor, TokenKind.Identifier, "Expected Identifier",
                               "Expected name")) Break;
            string member = IO.Kinal.Compiler.Lex.Token.Text(memberToken);
            string remote = member;
            If (Match(cursor, TokenKind.KwBy))
            {
                Token remoteToken = CurrentToken(cursor);
                If (BuilderExpect(cursor, TokenKind.Identifier, "Expected Identifier",
                                  "Expected remote name"))
                    remote = IO.Kinal.Compiler.Lex.Token.Text(remoteToken);
            }
            ImportDecl selective = New ImportDecl(member, name + "." + remote,
                IO.Kinal.Compiler.Lex.Token.Line(memberToken),
                IO.Kinal.Compiler.Lex.Token.Column(memberToken));
            selective.Kind = 2;
            tree.AddImport(selective);
            If (!Match(cursor, TokenKind.Comma)) Break;
        }
        BuilderExpect(cursor, TokenKind.RightBrace, "Expected '}'", "Missing '}'");
        BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
            "Missing ';' after Get");
        Return;
    }
    BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
        "Missing ';' after Get");
    ImportDecl imported = New ImportDecl(name, name,
        IO.Kinal.Compiler.Lex.Token.Line(location),
        IO.Kinal.Compiler.Lex.Token.Column(location));
    imported.Kind = 0;
    tree.AddImport(imported);
}

Safe Function void ReadAliasDeclaration(ParseCursor cursor, SyntaxTree tree)
{
    Token location = CurrentToken(cursor);
    Advance(cursor);
    Token nameToken = CurrentToken(cursor);
    string name = IO.Kinal.Compiler.Lex.Token.Text(nameToken);
    If (!BuilderExpect(cursor, TokenKind.Identifier, "Expected Identifier",
                       "Alias name must be an identifier")) Return;
    BuilderExpect(cursor, TokenKind.KwBy, "Expected By", "Alias requires 'By'");
    string target = ReadQualifiedName(cursor);
    BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
        "Missing ';' after Alias");
    ImportDecl alias = New ImportDecl(name, target,
        IO.Kinal.Compiler.Lex.Token.Line(location),
        IO.Kinal.Compiler.Lex.Token.Column(location));
    alias.Kind = 3;
    tree.AddImport(alias);
}

Safe Function SyntaxTree Build(SourceFile source, list tokens, list diagnostics)
{
    int errorsBefore = IO.Kinal.Compiler.Core.Diagnostics.ErrorCount(diagnostics);
    PreparedTokenStream prepared = PrepareTokens(source, tokens, diagnostics);
    ParseCursor cursor = New ParseCursor(prepared.Tokens, source, diagnostics);
    string unitName = "";
    If (prepared.HasPreparationError && !IsEnd(cursor))
    {
        int recoveryStart = cursor.Position;
        int recoveryLine = IO.Kinal.Compiler.Lex.Token.Line(CurrentToken(cursor));
        Report(cursor, diagnostics, source, "Unexpected Top-Level Token",
            "Expected a top-level declaration after the invalid Unsafe Alias");
        SynchronizeTopLevel(cursor, recoveryStart, recoveryLine);
    }
    If (prepared.HasUnsafeAlias && CurrentKind(cursor) == TokenKind.KwUnit)
    {
        Report(cursor, diagnostics, source, "Invalid Unit With Unsafe Alias",
            "Files that use Unsafe Alias cannot declare Unit");
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Semicolon)
            Advance(cursor);
        Match(cursor, TokenKind.Semicolon);
    }
    ElseIf (Match(cursor, TokenKind.KwUnit))
    {
        unitName = ReadQualifiedName(cursor);
        BuilderExpect(cursor, TokenKind.Semicolon, "Expected Semicolon",
            "Missing ';' after Unit");
    }
    SyntaxTree tree = New SyntaxTree(source, unitName);
    While (CurrentKind(cursor) == TokenKind.KwGet ||
           CurrentKind(cursor) == TokenKind.KwAlias)
    {
        If (CurrentKind(cursor) == TokenKind.KwGet)
            ReadGetDeclaration(cursor, tree);
        Else ReadAliasDeclaration(cursor, tree);
    }

    Block TopLevelDispatch< /
        Record Dispatch
        If (IsEnd(cursor))
        {
            Jump Done;
        }
        SyntaxAttribute attributes = ReadAttributes(cursor);
        TokenKind kind = CurrentKind(cursor);
        If (kind == TokenKind.KwUnsafe &&
            (KindAt(cursor, cursor.Position + 1) == TokenKind.KwAlias ||
             (KindAt(cursor, cursor.Position + 1) == TokenKind.KwUnsafe &&
              KindAt(cursor, cursor.Position + 2) == TokenKind.KwUnsafe &&
              KindAt(cursor, cursor.Position + 3) == TokenKind.KwAlias)))
        {
            Report(cursor, diagnostics, source, "Invalid Unsafe Alias Position",
                "Unsafe Alias must appear in the file prologue before Unit, Get, Alias, and declarations");
            While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.Semicolon)
                Advance(cursor);
            Match(cursor, TokenKind.Semicolon);
            Jump Dispatch;
        }
        If (kind == TokenKind.KwGet || kind == TokenKind.KwAlias)
        {
            string title = kind == TokenKind.KwGet ?
                "Invalid Get Position" : "Invalid Alias Position";
            string detail = kind == TokenKind.KwGet ?
                "Get must appear at top-level after Unit and before declarations" :
                "Alias must appear at top-level after Unit/Get and before declarations";
            int recoveryStart = cursor.Position;
            int recoveryLine = IO.Kinal.Compiler.Lex.Token.Line(CurrentToken(cursor));
            Report(cursor, diagnostics, source, title, detail);
            Report(cursor, diagnostics, source, "Unexpected Top-Level Token",
                "Expected a top-level declaration (Function/Class/Struct/Enum/Interface/variable declaration)");
            SynchronizeTopLevel(cursor, recoveryStart, recoveryLine);
            Jump Dispatch;
        }
        If (IsContextual(cursor, "Meta") &&
            KindAt(cursor, cursor.Position + 1) == TokenKind.Identifier &&
            KindAt(cursor, cursor.Position + 2) == TokenKind.LeftParen)
        {
            If (attributes != null)
                Report(cursor, diagnostics, source, "Invalid Attribute",
                    "Attributes are not supported on Meta declarations");
            tree.AddMeta(ReadMetaNode(cursor));
            Jump Dispatch;
        }
        If (kind == TokenKind.KwDelegate)
        {
            Advance(cursor);
            FunctionDecl delegate = ReadFunctionNode(cursor, false, false, false, false, 0);
            delegate.IsDelegate = true;
            delegate.FirstAttribute = attributes;
            tree.AddFunction(delegate);
            Jump Dispatch;
        }

        If (IsGlobalStart(kind))
        {
            If (attributes != null)
                Report(cursor, diagnostics, source, "Invalid Attribute",
                    "Attributes are not supported on global variables");
            FieldDecl global = ReadGlobalNode(cursor, attributes);
            If (global != null)
            {
                tree.AddGlobal(global);
                Jump Dispatch;
            }
        }

        If (IsFunctionModifier(kind))
        {
            int modifierEnd = cursor.Position;
            While (IsFunctionModifier(KindAt(cursor, modifierEnd)))
                modifierEnd = modifierEnd + 1;
            If (IsGlobalStart(KindAt(cursor, modifierEnd)))
            {
                int recoveryStart = cursor.Position;
                int recoveryLine = IO.Kinal.Compiler.Lex.Token.Line(CurrentToken(cursor));
                Report(cursor, diagnostics, source, "Invalid Global Modifier",
                    "Top-level global variables cannot use function modifiers like Static/Extern/Delegate/Safe/Trusted/Unsafe/Async");
                SynchronizeTopLevel(cursor, recoveryStart, recoveryLine);
                Jump Dispatch;
            }
        }

        bool isStatic = false;
        bool isAsync = false;
        bool isExtern = false;
        int safety = 0;
        While (IsFunctionModifier(CurrentKind(cursor)))
        {
            TokenKind modifier = CurrentKind(cursor);
            Switch (modifier)
            {
                Case(TokenKind.KwStatic) { isStatic = true; }
                Case(TokenKind.KwAsync) { isAsync = true; }
                Case(TokenKind.KwExtern) { isExtern = true; }
                Case(TokenKind.KwSafe) { safety = 1; }
                Case(TokenKind.KwTrusted) { safety = 2; }
                Case(TokenKind.KwUnsafe) { safety = 3; }
                Case(default) { }
            }
            Advance(cursor);
        }
        If (CurrentKind(cursor) == TokenKind.KwFunction)
        {
            FunctionDecl function = ReadFunctionNode(cursor, false, isStatic, isAsync, isExtern, safety);
            function.FirstAttribute = attributes;
            tree.AddFunction(function);
            Jump Dispatch;
        }

        If (!IsTypeStart(CurrentKind(cursor)))
        {
            int recoveryStart = cursor.Position;
            int recoveryLine = IO.Kinal.Compiler.Lex.Token.Line(CurrentToken(cursor));
            Report(cursor, diagnostics, source, "Unexpected Top-Level Token",
                "Expected a top-level declaration");
            SynchronizeTopLevel(cursor, recoveryStart, recoveryLine);
            Jump Dispatch;
        }

        bool isAbstract = false;
        bool isSealed = false;
        bool readingTypeModifiers = true;
        While (readingTypeModifiers)
        {
            TokenKind modifier = CurrentKind(cursor);
            Switch (modifier)
            {
                Case(TokenKind.KwPublic) { Advance(cursor); }
                Case(TokenKind.KwPrivate) { Advance(cursor); }
                Case(TokenKind.KwProtected) { Advance(cursor); }
                Case(TokenKind.KwInternal) { Advance(cursor); }
                Case(TokenKind.KwAbstract)
                {
                    isAbstract = true;
                    Advance(cursor);
                }
                Case(TokenKind.KwSealed)
                {
                    isSealed = true;
                    Advance(cursor);
                }
                Case(default) { readingTypeModifiers = false; }
            }
        }
        TokenKind typeKind = CurrentKind(cursor);
        Advance(cursor);
        Token typeNameToken = CurrentToken(cursor);
        string typeName = IO.Kinal.Compiler.Lex.Token.Text(typeNameToken);
        Advance(cursor);
        TypeDecl type = New TypeDecl(typeKind, typeName,
            IO.Kinal.Compiler.Lex.Token.Line(typeNameToken), IO.Kinal.Compiler.Lex.Token.Column(typeNameToken));
        If (typeKind == TokenKind.KwClass &&
            Match(cursor, TokenKind.KwBy))
        {
            bool readingBases = true;
            While (readingBases)
            {
                type.AddBase(ReadQualifiedName(cursor));
                readingBases = Match(cursor, TokenKind.Comma);
            }
        }
        ElseIf (typeKind == TokenKind.KwStruct ||
                typeKind == TokenKind.KwEnum)
            ReadAggregateSpecifiers(cursor, type);
        While (!IsEnd(cursor) && CurrentKind(cursor) != TokenKind.LeftBrace) Advance(cursor);
        type.IsStatic = isStatic;
        type.IsAbstract = isAbstract;
        type.IsSealed = isSealed;
        type.FirstAttribute = attributes;
        ReadTypeMembers(cursor, type, tree);
        tree.AddType(type);
        Jump Dispatch;

        Record Done
    / >
    TopLevelDispatch.Run();
    Return IO.Kinal.Compiler.Core.Diagnostics.ErrorCount(diagnostics) == errorsBefore ?
        tree : null;
}

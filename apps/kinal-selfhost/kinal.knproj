Project KinalSelfhost
{
    DefaultProfile = "stage1";

    Workspace
    {
        Ignore = ["../../out/**"];
    }

    SourceSet "compiler"
    {
        Roots = ["src"];
        Include = ["**/*.kn"];
        RequireUnit = true;
    }

    SourceSet "runtime"
    {
        Roots = ["../../libs/std/IO.Kinal.Runtime/1.0.0/src"];
        Include = ["**/*.kn"];
        RequireUnit = true;
    }

    Profile "stage1"
    {
        Source
        {
            Entry = "src/Main.kn";
            Sets = ["compiler", "runtime"];
            Mode = ReachableUnits;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../out/selfhost/stage1/kinal-selfhost.exe";
        }

    }

    Lsp
    {
        Profile = "stage1";
        ExtraSets = ["compiler", "runtime"];
        StrictProjectScope = true;
    }
}

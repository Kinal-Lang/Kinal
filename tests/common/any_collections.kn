Unit Tests.AnyCollections;

Get Console By IO.Console;

Static Function int Main()
{
    any a= 10;
    any b= 10;
    Console.PrintLine(a.Equals(b));

    list l= list.Create();
    Console.PrintLine(l.IsEmpty());
    l.Add(1);
    l.Add(2);
    Console.PrintLine(l.IsEmpty());
    Console.PrintLine([int](l.Pop()));

    dict d= dict.Create();
    Console.PrintLine(d.IsEmpty());
    d.Set("k", 1);
    Console.PrintLine(d.IsEmpty());

    set s= set.Create();
    Console.PrintLine(s.IsEmpty());
    s.Add("x");
    Console.PrintLine(s.IsEmpty());

    any boxedList = l;
    any boxedDict = d;
    any boxedSet = s;
    Console.PrintLine(boxedList Is list);
    Console.PrintLine(boxedList Is dict);
    Console.PrintLine(boxedDict Is dict);
    Console.PrintLine(boxedSet Is set);
    Console.PrintLine([list](boxedList).IsEmpty());
    Console.PrintLine([dict](boxedDict).IsEmpty());
    Console.PrintLine([set](boxedSet).IsEmpty());

    any none = null;
    list empty = [list](none);
    Console.PrintLine(empty == null);

    Try
    {
        list wrong = [list](boxedDict);
        Console.PrintLine(wrong.IsEmpty());
    }
    Catch (IO.Error error)
    {
        Console.PrintLine(error.Title);
    }
    Return 0;
}

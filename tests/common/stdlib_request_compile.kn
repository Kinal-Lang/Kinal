Unit Tests.StdRequestCompile;

Get IO.Request;
Get IO.Json;

Static Function int Main()
{
    IO.Request.Options options = New IO.Request.Options("http://127.0.0.1:8080/api/echo", IO.Request.Method.POST);
    dict payload = dict.Create();
    payload.Set("hello", true);
    payload.Set("name", "kinal");
    options.Headers.Set("X-Test", "kinal");
    options.BodyDict = payload;
    dict.Remove(options.Headers, "Missing");
    options.TimeoutMs = 500;

    IO.Request.Response response = IO.Request.Send(options);
    response.EnsureSuccess();
    response.Headers.TryFetch("content-type", "");
    response.BodyJson;
    response.BodyObject;
    response.BodyDict;

    options.BodyObject = New IO.Json.Object(payload);
    options.BodyJson = New IO.Json.Value(payload);

    IO.Request.Fetch("https://127.0.0.1:8443/", 250);
    IO.Request.Head("http://127.0.0.1:8080/health", 250);
    IO.Request.Post("https://127.0.0.1:8443/post", "hello");
    IO.Request.Put("http://127.0.0.1:8080/put", "hello");
    IO.Request.Patch("http://127.0.0.1:8080/patch", "hello");
    IO.Request.DeleteRequest("http://127.0.0.1:8080/delete", 250);
    Return 0;
}

Unit Tests.KncSuperloop;

Get Console By IO.Console;

Static Function int Main()
{
    int i= 0;
    For (i= 0; i< 5; i++)
    {
    }
    Console.PrintLine(i);

    int j= 5;
    For (; j> 0; j--)
    {
    }
    Console.PrintLine(j);

    int k= 0;
    While (k< 1000)
    {
        k= k+ 1;
    }
    Console.PrintLine(k);
    Return 0;
}

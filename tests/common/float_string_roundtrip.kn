Unit Tests.FloatStringRoundtrip;

Get IO.Console;
Get IO.GC;

Static Function int Main()
{
    float value = 1.25;
    string positive = [string](value);
    string negative = [string](-2.5);
    any boxed = 0.125;
    string erased = [string](boxed);
    string large = [string]([float]("1e200"));
    string small = [string]([float]("1e-200"));
    IO.GC.Collect();
    IO.Console.PrintLine(positive);
    IO.Console.PrintLine(negative);
    IO.Console.PrintLine(erased);
    IO.Console.PrintLine([float](positive) == value);
    IO.Console.PrintLine([float](large) == [float]("1e200"));
    IO.Console.PrintLine([float](small) == [float]("1e-200"));
    Return 0;
}

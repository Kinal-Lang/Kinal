Project PkgProjectSource
{
    DefaultProfile = "native";

    Packages
    {
        Roots = ["../local"];
    }

    SourceSet "app"
    {
        Roots = ["src"];
        Include = ["**/*.kn"];
        RequireUnit = true;
    }

    Profile "native"
    {
        Source
        {
            Entry = "src/Main.kn";
            Sets = ["app"];
            Mode = ReachableUnits;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
        }
    }

    Lsp
    {
        Profile = "native";
    }
}

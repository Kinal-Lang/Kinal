Project SelfhostProjectPackages
{
    DefaultProfile = "test";

    Packages
    {
        Roots = ["packages/top"];
    }

    SourceSet "main"
    {
        Roots = ["src"];
        Include = ["**/*.kn"];
        RequireUnit = true;
    }

    Profile "test"
    {
        Source
        {
            Entry = "src/Main.kn";
            Sets = ["main"];
            Mode = ReachableUnits;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
        }

        Packages
        {
            Roots = ["packages/profile"];
        }
    }
}

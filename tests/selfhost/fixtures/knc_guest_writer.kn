Unit Tests.Selfhost.KncGuestWriter;

Get IO.Kinal.Compiler.Backend.KncModel;

Static Function int Main()
{
    KncByteBuffer output = New KncByteBuffer();
    output.BeginBuild();
    output.WriteU8(7);
    output.WriteI32(9);
    output.WriteString("é雪");
    output.PatchU16(1, 4321);

Unit Tests.GcFrames;

Get IO.Kinal.Runtime.GarbageCollector;
Get IO.Kinal.Runtime.Native;
Get IO.Type.string;

Safe Function int[] MakeGcPair()
{
    Return {19, 23};
}

Trusted Function int CollectCallArgument()
{
    // Exercise the explicit-root contract without accidental native stack
    // retention. Restore the original collector state before returning.
    usize stackBase = IO.Kinal.Runtime.GarbageCollector.StackBase();
    IO.Kinal.Runtime.GarbageCollector.SetStackBase([usize](0));
    IO.Kinal.Runtime.GarbageCollector.Collect();
    IO.Kinal.Runtime.GarbageCollector.SetStackBase(stackBase);
    Return 0;
}

Safe Function int ReadGcPair(any value, int ignored)
{
    int[] pair = [int[]](value);
    Return pair[0] + pair[1];
}

Safe Function bool ReadConvertedCharacter(string value, int ignored)
{
    Return value == "x";
}

Trusted Function int ReadDefaultGcPair(any value = MakeGcPair(),
                                      int ignored = CollectCallArgument())
{
    Return ReadGcPair(value, ignored);
}

[Variadic]
Safe Function int ReadVariadicGcPair(any value, int[] ignored)
{
    Return ReadGcPair(value, 0);
}

Delegate Function int ReadGcPairDelegate(any value, int ignored) By Kinal;

Class GcPairReader
{
    Public int Result;

    Public Safe Constructor(any value, int ignored)
    {
        This.Result = ReadGcPair(value, ignored);
    }

    Public Virtual Safe Function int Read(any value, int ignored)
    {
        Return ReadGcPair(value, ignored);
    }
}

Trusted Function bool CheckDynamicConvertedArguments(Object.Function callable, int[] pair)
{
    Return [int](callable(pair, CollectCallArgument())) == 42;
}

Trusted Function bool CheckConvertedArguments()
{
    int[] pair = MakeGcPair();
    If (ReadGcPair(pair, CollectCallArgument()) != 42) Return false;
    If (ReadGcPair(ignored = CollectCallArgument(), value = pair) != 42) Return false;
    If (ReadDefaultGcPair() != 42) Return false;
    If (ReadVariadicGcPair(pair, CollectCallArgument()) != 42) Return false;
    ReadGcPairDelegate = ReadGcPair;
    If (ReadGcPairDelegate(pair, CollectCallArgument()) != 42) Return false;
    GcPairReader reader = New GcPairReader(pair, CollectCallArgument());
    If (reader.Result != 42) Return false;
    If (reader.Read(pair, CollectCallArgument()) != 42) Return false;
    Object.Function callable = ReadGcPair;
    If (!CheckDynamicConvertedArguments(callable, pair)) Return false;
    If (!ReadConvertedCharacter('x', CollectCallArgument())) Return false;
    Return true;
}

Trusted Function string CollectBuiltinArgument()
{
    CollectCallArgument();
    Return "x";
}

Trusted Function bool CheckBuiltinConvertedArguments()
{
    If (IO.Type.string.Concat('x', CollectBuiltinArgument()) != "xx") Return false;
    If (!IO.Type.string.Equals('x', CollectBuiltinArgument())) Return false;
    Var concatenate = IO.Type.string.Concat;
    Var equal = IO.Type.string.Equals;
    If (concatenate('x', CollectBuiltinArgument()) != "xx") Return false;
    If (!equal('x', CollectBuiltinArgument())) Return false;
    Return true;
}

Struct AssignmentRecord
{
    int Value;
    int Tail;
}

byte* AssignmentRemembered;
int AssignmentRememberedCount;

Trusted Function void RememberAssignmentAddress(int* address)
{
    // A native allocation is not traced by the Kinal collector. Its contents
    // let this fixture inspect the writes without supplying another GC root.
    ([int**](AssignmentRemembered))[AssignmentRememberedCount] = address;
    AssignmentRememberedCount = AssignmentRememberedCount + 1;
}

Trusted Function int* MakeAssignmentAddress()
{
    int[] pair = MakeGcPair();
    RememberAssignmentAddress(&pair[0]);
    Return &pair[0];
}

Trusted Function AssignmentRecord* MakeAssignmentRecord()
{
    AssignmentRecord record;
    record.Value = 19;
    record.Tail = 23;
    AssignmentRecord[] records = {record};
    RememberAssignmentAddress(&records[0].Value);
    Return &records[0];
}

Trusted Function int CollectAndReplaceAssignment()
{
    int* target = ([int**](AssignmentRemembered))[AssignmentRememberedCount - 1];
    target[0] = 7;
    CollectCallArgument();
    Return 5;
}

Trusted Function bool CheckAssignmentAddressRoots()
{
    // Only the evaluated lvalue address retains these blocks while the RHS
    // collects. A scalar/Struct value copy does not retain its original storage.
    AssignmentRemembered = IO.Kinal.Runtime.Native.HeapAllocate([u64](32));
    AssignmentRememberedCount = 0;
    If (AssignmentRemembered == null) Return false;
    *MakeAssignmentAddress() = CollectCallArgument();
    *MakeAssignmentAddress() += CollectAndReplaceAssignment();
    (*MakeAssignmentRecord()).Value = CollectCallArgument();
    (*MakeAssignmentRecord()).Value += CollectAndReplaceAssignment();
    int** addresses = [int**](AssignmentRemembered);
    bool correct = AssignmentRememberedCount == 4 &&
        addresses[0][0] == 0 && addresses[1][0] == 24 &&
        addresses[2][0] == 0 && addresses[3][0] == 24;
    IO.Kinal.Runtime.Native.HeapFree(AssignmentRemembered);
    AssignmentRemembered = null;
    Return correct;
}

Unit Tests.GcFrames;

Get IO.Console;
Get IO.Target;
Get IO.Kinal.Runtime;
Get IO.Kinal.Runtime.GarbageCollector;
Get IO.Kinal.Runtime.Native;

Trusted Static Function bool CheckNativeMemoryLeaves()
{
    byte* left = IO.Kinal.Runtime.Native.HeapAllocate([u64](8));
    byte* right = IO.Kinal.Runtime.Native.HeapAllocate([u64](8));
    If (left == null || right == null)
    {
        IO.Kinal.Runtime.Native.HeapFree(left);
        IO.Kinal.Runtime.Native.HeapFree(right);
        Return false;
    }
    IO.Kinal.Runtime.Native.MemoryFill(left, [byte](66), [u64](8));
    IO.Kinal.Runtime.Native.MemoryCopy(right, left, [u64](8));
    bool copied = IO.Kinal.Runtime.Native.MemoryCompare(left, right, [u64](8)) == [i32](0);
    right[1] = [byte](67);
    bool ordered = IO.Kinal.Runtime.Native.MemoryCompare(left, right, [u64](8)) < [i32](0);
    IO.Kinal.Runtime.Native.HeapFree(left);
    IO.Kinal.Runtime.Native.HeapFree(right);
    Return copied && ordered;
}

// A lexical slot must register once, not once per loop iteration. The C
// reference uses its own collector, so CurrentFrame may be null there.
Trusted Static Function bool CheckLoopRoots()
{
    byte* frame = IO.Kinal.Runtime.GarbageCollector.CurrentFrame();
    u64 before = frame == null ? [u64](0) : ([u64*](frame))[1];
    int index = 0;
    While (index < 128)
    {
        string text = IO.Kinal.Runtime.Int64ToString([i64](index));
        If (text == null || text == "") Return false;
        Foreach (string item Is {text, "tail"})
        {
            string copy = item;
            If (copy == null) Return false;
        }
        If (text Is string bound)
        {
            string shadow = bound;
            If (shadow != text) Return false;
        }
        {
            string shadow = "separate lexical slot";
            If (shadow == text) Return false;
        }
        Try
        {
            Throw "loop error";
        }
        Catch (string message)
        {
            If (message != "loop error") Return false;
        }
        index = index + 1;
    }
    u64 after = frame == null ? [u64](0) : ([u64*](frame))[1];
    Return before == after;
}

// Native-owned root slots deliberately do not belong to the managed heap.
// Only the frame registrations keep their strings alive during collection.
Trusted Static Function int Main()
{
    If (!CheckNativeMemoryLeaves()) Return 10;
    If (!CheckLoopRoots()) Return 9;
    If (!CheckConvertedArguments()) Return 11;
    If (!CheckBuiltinConvertedArguments()) Return 12;
    If (!CheckAssignmentAddressRoots()) Return 13;
    usize pointerBytes = [usize](IO.Target.PointerBits / 8);
    int count = 257;
    char** slots = [char**](IO.Kinal.Runtime.Native.HeapAllocate(
        [u64]([usize](count) * pointerBytes)));
    If (slots == null) Return 1;
    IO.Kinal.Runtime.Native.MemoryFill([byte*](slots), [byte](0),
        [u64]([usize](count) * pointerBytes));

    byte* previous = IO.Kinal.Runtime.GarbageCollector.CurrentFrame();
    byte* outer = IO.Kinal.Runtime.GarbageCollector.PushFrame();
    If (outer == null) Return 2;
    int index = 0;
    While (index < count)
    {
        IO.Kinal.Runtime.GarbageCollector.AddRoot(outer,
            [byte*](&slots[index]), pointerBytes);
        // Call the Kinal allocation policy explicitly: a C-built reference
        // program otherwise creates its strings in the legacy stage0 heap.
        slots[index] = [char*](IO.Kinal.Runtime.StringConcat("frame-root-",
            IO.Kinal.Runtime.Int64ToString([i64](index))));
        index = index + 1;
    }
    u64* words = [u64*](outer);
    If (words[1] != [u64](count) || words[2] < [u64](count) || words[3] == [u64](0))
        Return 3;

    byte* inner = IO.Kinal.Runtime.GarbageCollector.PushFrame();
    If (inner == null || IO.Kinal.Runtime.GarbageCollector.CurrentFrame() != inner)
        Return 4;
    If (([u64*](inner))[0] != [u64]([usize](outer))) Return 5;
    IO.Kinal.Runtime.GarbageCollector.AddRoot(inner, [byte*](&slots[0]), pointerBytes);
    IO.Kinal.Runtime.GarbageCollector.Collect();
    IO.Kinal.Runtime.GarbageCollector.PopFrame(inner);
    If (IO.Kinal.Runtime.GarbageCollector.CurrentFrame() != outer) Return 6;
    IO.Kinal.Runtime.GarbageCollector.Collect();

    index = 0;
    While (index < count)
    {
        If ([string](slots[index]) != "frame-root-" + [string](index)) Return 7;
        index = index + 1;
    }
    IO.Kinal.Runtime.GarbageCollector.PopFrame(outer);
    If (IO.Kinal.Runtime.GarbageCollector.CurrentFrame() != previous) Return 8;
    IO.Kinal.Runtime.Native.HeapFree([byte*](slots));
    IO.Console.PrintLine("gc-frames-ok");
    Return 0;
}

Unit Tests.Selfhost.ExpressionOps;

Get IO.Console;

Class Box
{
    Public int Value;

    Public Function Box(int value)
    {
        Value = value;
    }
}

Static Function int Main()
{
    int x = 1;
    int postfix = x++;
    int prefix = ++x;
    x += 5;
    x -= 2;
    x *= 3;
    x /= 2;
    int selected = If (postfix > prefix) { postfix; } Else { prefix; };
    int values[] = {1, 2};
    int indexPostfix = values[0]++;
    int indexPrefix = ++values[1];
    Box box = New Box(10);
    int fieldPostfix = box.Value++;
    int fieldPrefix = ++box.Value;
    IO.Console.PrintLine(postfix);
    IO.Console.PrintLine(prefix);
    IO.Console.PrintLine(x);
    IO.Console.PrintLine(selected);
    IO.Console.PrintLine(indexPostfix);
    IO.Console.PrintLine(indexPrefix);
    IO.Console.PrintLine(fieldPostfix);
    IO.Console.PrintLine(fieldPrefix);
    Return 0;
}

Unit Tests.Selfhost.ExpressionOps;

Get IO.Console;

Class Box
{
    Public int Value;

    Public Function Box(int value = 10)
    {
        Value = value;
    }
}

Static Function int Add(int left = 1, int right = 2)
{
    Return left + right;
}

Static Function int Main()
{
    int x = 1;
    int postfix = x++;
    int prefix = ++x;
    x += 5;
    x -= 2;
    x *= 3;
    x /= 2;
    int selected = If (postfix > prefix) { postfix; } Else { prefix; };
    int values[] = {1, 2};
    int indexPostfix = values[0]++;
    int indexPrefix = ++values[1];
    Box box = New Box();
    int fieldPostfix = box.Value++;
    int fieldPrefix = ++box.Value;
    int defaultDirect = Add();
    int defaultNamed = Add(right = 5, left = default);
    Var callable = Add;
    int defaultDynamic = [int](callable(default, 5));
    IO.Console.PrintLine(postfix);
    IO.Console.PrintLine(prefix);
    IO.Console.PrintLine(x);
    IO.Console.PrintLine(selected);
    IO.Console.PrintLine(indexPostfix);
    IO.Console.PrintLine(indexPrefix);
    IO.Console.PrintLine(fieldPostfix);
    IO.Console.PrintLine(fieldPrefix);
    IO.Console.PrintLine(defaultDirect);
    IO.Console.PrintLine(defaultNamed);
    IO.Console.PrintLine(defaultDynamic);
    If (IO.Target.OS == IO.Target.OS.Windows)
    {
        IO.Console.PrintLine("windows");
    }
    Else
    {
        UnsupportedTargetBranch();
    }
    Return 0;
}

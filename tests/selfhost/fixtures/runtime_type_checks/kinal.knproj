Project SelfhostRuntimeTypeChecks
{
    DefaultProfile = "test";

    SourceSet "main"
    {
        Roots = ["src"];
        Include = ["**/*.kn"];
        RequireUnit = true;
    }

    Profile "test"
    {
        Source
        {
            Entry = "src/Main.kn";
            Sets = ["main"];
            Mode = ReachableUnits;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/runtime-type-checks.exe";
        }
    }

    Profile "callable"
    {
        Source
        {
            Entry = "src/CallableIdentity.kn";
            Sets = ["main"];
            Mode = ReachableUnits;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/callable-identity.exe";
        }
    }
}

Unit Tests.Selfhost.GenericFunctions;

Get IO.Console;
Get Tests.Selfhost.GenericLibrary;

Trusted Static Function int Main()
{
    int number = Tests.Selfhost.GenericLibrary.Forward< int>(42);
    string text = Tests.Selfhost.GenericLibrary.Forward< string>("nest");
    int first = Tests.Selfhost.GenericLibrary.First< int, string>(3, "ignored");
    IO.Console.PrintLine(number);
    IO.Console.PrintLine(text);
    IO.Console.PrintLine(first);
    Return number == 42 && text == "nest" && first == 3 ? 0 : 1;
}

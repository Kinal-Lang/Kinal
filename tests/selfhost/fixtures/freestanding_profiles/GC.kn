Unit Tests.FreestandingOptional;
Get IO.Target;
Get IO.GC;
Class Item { Public int Value; Safe Constructor(int value) { This.Value = value; } }
int First = 5;
int Second = First;
string GlobalText = "global" + " value";
Safe Function void Raise() { Throw "custom error"; }
Trusted Static Function void KMain(int* result)
{
    int caught = 0;
    Try { Raise(); }
    Catch (string error) { If (error == "custom error") caught = 1; }
    list values = list.Create();
    values.Add(42);
    Item item = New Item(9);
    IO.GC.Collect();
    string value = "heap " + [string](33);
    int[3] local = {1, 2};
    If (caught == 1 && values.Count() == 1 && values.Contains(42) && item.Value == 9 && value == "heap 33" && GlobalText == "global value" &&
        Second == 5 && local.Length() == 3 && local[2] == 0 &&
        IO.Target.Env == IO.Target.Env.Freestanding) *result = 42;
    Else *result = -1;
}

Project SelfhostPhase5Semantics
{
    DefaultProfile = "custom_cast";

    SourceSet "custom_cast"
    {
        Roots = ["../../../common"];
        Include = ["custom_cast_simple.kn"];
        RequireUnit = true;
    }

    SourceSet "package_expression"
    {
        Roots = ["../../../common"];
        Include = ["package_expression_depth.kn"];
        RequireUnit = true;
    }

    SourceSet "package_contextual_default"
    {
        Roots = ["../../../common"];
        Include = ["package_contextual_default.kn"];
        RequireUnit = true;
    }

    SourceSet "package_const_index"
    {
        Roots = ["../../../common"];
        Include = ["package_const_index.kn"];
        RequireUnit = true;
    }

    SourceSet "literal_ids"
    {
        Roots = ["src"];
        Include = ["LiteralIds.kn"];
        RequireUnit = true;
    }

    Profile "custom_cast"
    {
        Source
        {
            Entry = "../../../common/custom_cast_simple.kn";
            Sets = ["custom_cast"];
            Mode = AllSources;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/custom-cast-simple.exe";
        }
    }

    Profile "package_expression"
    {
        Source
        {
            Entry = "../../../common/package_expression_depth.kn";
            Sets = ["package_expression"];
            Mode = AllSources;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/package-expression-depth.exe";
        }
    }

    Profile "package_contextual_default"
    {
        Source
        {
            Entry = "../../../common/package_contextual_default.kn";
            Sets = ["package_contextual_default"];
            Mode = AllSources;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/package-contextual-default.exe";
        }
    }

    Profile "package_const_index"
    {
        Source
        {
            Entry = "../../../common/package_const_index.kn";
            Sets = ["package_const_index"];
            Mode = AllSources;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/package-const-index.exe";
        }
    }

    Profile "literal_ids"
    {
        Source
        {
            Entry = "src/LiteralIds.kn";
            Sets = ["literal_ids"];
            Mode = AllSources;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/literal-ids.exe";
        }
    }
}

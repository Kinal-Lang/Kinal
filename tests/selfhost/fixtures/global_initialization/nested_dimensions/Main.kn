Unit Tests.NestedDimensions;
Get IO.Console;
Get IO.GC;

Struct Row { int[3] Cells; }
Struct Page { Row[2][4] Rows; }
Struct Tree { Tree[][2] Children; Tree[0][2] Empty; }
Class BaseSheet { Public int[2][4] Values; }
Class Sheet By BaseSheet
{
    Public Page Data;
    Public Static Row[2][4] Saved;
    Public Static int[2][3] Preset = {{7}, {}};
}

int Initialized = Seed();
int[2][4] Later;
Row InitialRow = default;

Function int Seed()
{
    If (Later.Length() != 4 || Later[3].Length() != 2) Return 1;
    If (Sheet.Saved.Length() != 4 || Sheet.Saved[3].Length() != 2 ||
        Sheet.Saved[3][1].Cells.Length() != 3) Return 2;
    Later[3][1] = 11;
    Sheet.Saved[3][1].Cells[2] = 17;
    IO.GC.Collect();
    Return 42;
}

Function int[2][4] ReturnLiteral() { Return {{3}, {5, 7}}; }
Function Row DefaultRow() { Return default; }

Function int CheckArgument(int[2][4] grid)
{
    Return grid.Length() == 1 && grid[0].Length() == 1 ? 0 : 1;
}

Static Function int Main()
{
    If (Initialized != 42 || Later[3][1] != 11 || Later[2][1] != 0 ||

    cube[3][2][1] = 13;
    If (cube[0][0][0] != 9 || cube[0][0][1] != 0 || cube[1][0][1] != 6 ||
        cube[2][2][1] != 0 || cube[3][1][1] != 0) Return 5;

    int[2] first = {3, 5};
    int[2][4] withAlias = {first};
    withAlias[0][1] = 19;
    If (first[1] != 19 || withAlias[1].Length() != 2 || withAlias[1][1] != 0) Return 6;

    int[][3] dynamicRows;
    int[0][3] emptyRows;
    int[2][0] emptyOuter;
    int[][] ragged = {{1, 2, 3}, {4}};
    If (dynamicRows[0].Length() != 0 || dynamicRows[2].Length() != 0 ||
        emptyRows[1].Length() != 0 || emptyOuter.Length() != 0 ||
        ragged[0].Length() != 3 || ragged[1].Length() != 1) Return 7;
    dynamicRows[0] = {23};
    If (dynamicRows[0][0] != 23 || dynamicRows[1].Length() != 0) Return 8;

    Sheet sheet = New Sheet();
    Page other;
    If (sheet.Values[0].Length() != 2 || sheet.Data.Rows[3][1].Cells.Length() != 3 ||
        other.Rows[3][1].Cells.Length() != 3) Return 9;
    sheet.Data.Rows[3][1].Cells[2] = 29;
    IO.GC.Collect();
    If (other.Rows[3][1].Cells[2] != 0 || sheet.Data.Rows[3][1].Cells[2] != 29 ||
        cube[3][2][1] != 13 || rows[0][1].Cells[2] != 7) Return 10;
    If (Sheet.Preset.Length() != 3 || Sheet.Preset[0].Length() != 2 || Sheet.Preset[0][1] != 0 ||
        Sheet.Preset[1].Length() != 2 || Sheet.Preset[2].Length() != 2) Return 11;

    int[2][4] returned = ReturnLiteral();
    int[2][4] assigned;
    assigned = {{13}};
    If (returned.Length() != 2 || returned[0].Length() != 1 || returned[1].Length() != 2 ||
        assigned.Length() != 1 || assigned[0].Length() != 1 || CheckArgument({{17}}) != 0) Return 12;
    Tree[2][2] forest;
    If (forest[1][0].Children.Length() != 2 || forest[0][1].Children[0].Length() != 0 ||
        forest[1][1].Empty[1].Length() != 0) Return 13;

    int[2][4] fresh = default;
    Row[3] samples = {default, DefaultRow()};
    If (fresh.Length() != 4 || fresh[3].Length() != 2 || InitialRow.Cells.Length() != 3 ||
        samples[0].Cells.Length() != 3 || samples[1].Cells.Length() != 3 ||
        samples[2].Cells.Length() != 3) Return 14;
    fresh[3][1] = 37;
    int[2][4] previous = fresh;
    fresh = default;
    samples[0].Cells[2] = 41;
    Row oldRow = samples[0];
    samples[0] = default;
    IO.GC.Collect();
    If (previous[3][1] != 37 || fresh[3][1] != 0 || fresh[0][1] != 0 ||
        oldRow.Cells[2] != 41 || samples[0].Cells[2] != 0 || samples[1].Cells[2] != 0) Return 15;

    <int[2], int>[2] pairs = {<first, 43>, <first, 47>};
    If (pairs.Length() != 2 || pairs[1][0].Length() != 2 || pairs[0][1] != 43 ||

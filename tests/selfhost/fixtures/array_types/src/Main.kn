Unit Tests.Selfhost.ArrayTypes;

Trusted Static Function int Main(string[] args)
{
    char[] chars = "ok".ToChars();
    int fixed[5] = {1, 2};
    int inferred[] = {10, 20, 30};
    int scalar = 0;
    int* pointer = &scalar;
    fixed[4] = inferred.Index(1);
    If (args.Length() != 2 || chars.Length() != 2 ||
        fixed.Length() != 5 || fixed[2] != 0 || fixed[4] != 20 ||
        inferred.Length() != 3 || scalar.TypeOf() != "int" ||
        fixed.TypeOf() != "int[]" || pointer.TypeOf() != "int*")
    {
        Return 1;
    }
    Return 0;
}

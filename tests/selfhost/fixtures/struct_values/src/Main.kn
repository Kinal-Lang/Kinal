Unit Tests.Selfhost.StructValues;

Get IO.Console;

Enum State By u8
{
    Empty = 0,
    Ready = 7
}

Struct Pair
{
    int Left;
    int Right;
}

Struct Nested
{
    Pair Value;
    string Label;
}

Struct PackedPair By Packed
{
    byte Tag;
    int Value;
}

Struct AlignedPair By Align(32)
{
    byte Tag;
    int Value;
}

Class Container
{
    Public Pair Value;
}

Pair GlobalPair;
State GlobalState = State.Ready;

Safe Function Pair MakePair(int left, int right)
{
    Pair value;
    value.Left = left;
    value.Right = right;
    Return value;
}

Safe Function Pair ChangeCopy(Pair value)
{
    value.Right = 77;
    Return value;
}

Safe Function int Sum(Pair value)
{
    Return value.Left + value.Right;
}

Safe Function <Pair, int> PackagePair(Pair value)
{
    Return <value, 1>;
}

Static Safe Function int Main()
{
    Pair defaults;
    IO.Console.PrintLine(defaults.Left);
    IO.Console.PrintLine(defaults.Right);
    IO.Console.PrintLine(GlobalPair.Left);

    Pair original = MakePair(10, 20);
    Pair copy = original;
    copy.Left = 99;
    IO.Console.PrintLine(original.Left);
    IO.Console.PrintLine(copy.Left);

    Pair changed = ChangeCopy(original);
    IO.Console.PrintLine(original.Right);
    IO.Console.PrintLine(changed.Right);
    IO.Console.PrintLine(Sum(changed));

    Nested nested;
    nested.Value = original;
    nested.Value.Right = 55;
    nested.Label = "nested";
    IO.Console.PrintLine(nested.Value.Left);
    IO.Console.PrintLine(nested.Value.Right);
    IO.Console.PrintLine(nested.Label);
    IO.Console.PrintLine(original.Right);

    Pair returned = MakePair(3, 4);
    IO.Console.PrintLine(returned.Left);
    IO.Console.PrintLine(returned.Right);

    Pair[] values = { original, copy, returned };
    values[0].Left = 11;
    IO.Console.PrintLine(values[0].Left);
    IO.Console.PrintLine(original.Left);

    Container container = New Container();
    container.Value = original;
    container.Value.Left = 44;
    IO.Console.PrintLine(container.Value.Left);
    IO.Console.PrintLine(original.Left);

    State state = State.Ready;
    IO.Console.PrintLine([int](state));
    IO.Console.PrintLine(state == State.Ready);
    IO.Console.PrintLine([int](GlobalState));

    PackedPair packed;
    packed.Tag = 2;
    packed.Value = 31;
    PackedPair packedCopy = packed;
    packedCopy.Value = 41;
    IO.Console.PrintLine([int](packed.Tag));
    IO.Console.PrintLine(packed.Value);
    IO.Console.PrintLine(packedCopy.Value);

    AlignedPair aligned;
    aligned.Tag = 3;
    aligned.Value = 32;
    IO.Console.PrintLine([int](aligned.Tag));
    IO.Console.PrintLine(aligned.Value);

    <Pair, int> packaged = PackagePair(original);
    Pair unboxed = packaged[0];
    unboxed.Left = 88;
    IO.Console.PrintLine(unboxed.Left);
    IO.Console.PrintLine(unboxed.Right);
    IO.Console.PrintLine(original.Left);
    Return 0;
}

Project SelfhostStructValues
{
    DefaultProfile = "test";

    SourceSet "main"
    {
        Roots = ["src"];
        Include = ["Main.kn"];
        RequireUnit = true;
    }

    Profile "test"
    {
        Source
        {
            Entry = "src/Main.kn";
            Sets = ["main"];
            Mode = ReachableUnits;
        }

        Build
        {
            Backend = Native;
            Environment = Hosted;
            Output = "../../../../out/selfhost/tests/struct-values.exe";
        }
    }
}

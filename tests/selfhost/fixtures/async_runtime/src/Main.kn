Unit Tests.Selfhost.AsyncRuntime;

Get IO.Async;
Get IO.Console;

Static Async Function int Step(int value)
{
    Await IO.Async.Yield();
    Await IO.Async.Sleep(1);
    Return value + 1;
}

Static Async Function int Compute()
{
    IO.Async.Task pending = Step(40);
    int first = Await pending;
    Return Await Step(first);
}

Static Async Function int Failing()
{
    Throw "async-error";
}

Static Function int Main()
{
    IO.Console.PrintLine(IO.Async.Run(Compute()));
    Try
    {
        int unused = IO.Async.Run(Failing());
        IO.Console.PrintLine(unused);
    }
    Catch (string message)
    {
        IO.Console.PrintLine(message);
    }
    Return 0;
}

Unit Benchmarks.NestedArrays;

Get IO.Console;
Get IO.GC;
Get IO.Time;

Class Tile
{
    Public Tile Next;
    Public int[3][128] Rows;
}

Static Function int Main()
{
    int count = [int](IO.Console.ReadLine());
    If (count < 0 || count > 1000000) Return 2;
    Tile head = null;
    u64 start = IO.Time.GetNanoTick();

    For (int first = 0; first < count; first += 128)
    {
        Tile tile = New Tile();
        tile.Next = head;
        head = tile;
        If (tile.Rows.Length() != 128) Return 1;
        For (int row = 0; row < 128 && first + row < count; row++)
        {
            If (tile.Rows[row].Length() != 3) Return 1;
            int value = first + row + 1;
            tile.Rows[row][0] = value;
            tile.Rows[row][2] = -value;
        }
    }

    IO.GC.Collect();
    int remaining = count;
    While (head != null)
    {
        int last = (remaining - 1) % 128;
        For (int row = last; row >= 0; row--)
        {
            If (head.Rows[row][0] != remaining || head.Rows[row][1] != 0 ||
                head.Rows[row][2] != -remaining) Return 1;
            remaining--;
        }
        head = head.Next;
    }
    If (remaining != 0) Return 1;
    IO.Console.PrintLine([string](count) + " " + [string](IO.Time.GetNanoTick() - start));
    Return 0;
}

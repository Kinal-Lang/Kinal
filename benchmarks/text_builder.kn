Unit Benchmarks.TextBuilder;

Get IO.Console;
Get IO.Text;
Get IO.Time;

Static Function int Main(string[] args)
{
    If (args.Length() != 2) Return 2;
    int count = [int](args[0]);
    string mode = args[1];
    If (count < 1 || count > 1000000) Return 2;
    string piece = "id=雪山|";
    string actual = "";
    int start = IO.Time.GetNanoTick();
    If (mode == "concat")
    {
        For (int i = 0; i < count; i++) actual += piece;
    }
    ElseIf (mode == "builder" || mode == "reserved")
    {
        IO.Text.Builder output = New IO.Text.Builder();
        If (mode == "reserved") output.EnsureCapacity(count * IO.Text.Length(piece));
        For (int i = 0; i < count; i++) output.Append(piece);
        actual = output.Build();
    }
    Else Return 2;
    int elapsed = IO.Time.GetNanoTick() - start;

    string expected = "";
    While (count > 0)
    {
        If ((count & 1) != 0) expected += piece;
        count /= 2;
        If (count > 0) piece += piece;
    }
    If (actual != expected) Return 1;
    IO.Console.PrintLine(elapsed);
    Return 0;
}

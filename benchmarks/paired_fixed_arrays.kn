Unit Benchmarks.PairedFixedArrays;

Get IO.Console;
Get IO.Time;

Function int Temporary(int seed)
{
    int[4096] left;
    int[8192] right;
    If (left[4095] != 0 || right[8191] != 0) Return -1;
    left[4095] = seed;
    right[8191] = seed + 1;
    Return left[4095] + right[8191];
}

Static Function int Main()
{
    int count = [int](IO.Console.ReadLine());
    If (count < 0 || count > 1000000) Return 2;
    u64 start = IO.Time.GetNanoTick();
    int checksum = 0;
    For (int i = 0; i < count; i++) checksum += Temporary(i);
    If (checksum != count * count) Return 1;
    IO.Console.PrintLine([string](count) + " " + [string](IO.Time.GetNanoTick() - start));
    Return 0;
}
